def instalar_limpeza_home_b33():
    """Ativa somente na Home V9 sem alterar a lógica das demais telas."""
    from ui import home_r4h_canvas as home
    classe = getattr(home, "_TelaAnimadaR4H", None)
    if classe is None:
        return False
    if getattr(classe, "_b33_remocao_habilitada", False):
        return True

    # Recursos conserva seu acesso na sidebar, mas não fica clicável
    # no ponto do GIF onde a esfera foi retirada.
    home.AREAS = tuple(
        (nome, area) for nome, area in home.AREAS
        if nome.strip().lower() != "recursos"
    )
    iniciar_original = classe.__init__
    pintar_original = classe.paintEvent

    def iniciar_com_limpeza(self, *args, **kwargs):
        iniciar_original(self, *args, **kwargs)
        patches = []
        for nome, x, y, largura, altura, b64 in _CORRECOES:
            dados = base64.b64decode("".join(b64), validate=True)
            imagem = QImage.fromData(dados)
            if (imagem.isNull() or imagem.width() != largura or
                    imagem.height() != altura):
                raise ValueError("Patch B33 inválido: " + nome)
            patches.append((x, y, largura, altura, imagem))
        self._b33_patches = tuple(patches)
        # Protege também builds cujo construtor pré-crie os botões.
        botoes = getattr(self, "_botoes", ())
        if botoes:
            restantes = []
            for botao, area in botoes:
                if "recursos" in botao.accessibleName().casefold():
                    botao.setEnabled(False)
                    botao.hide()
                else:
                    restantes.append((botao, area))
            self._botoes = restantes

    def pintar_com_limpeza(self, evento):
        pintar_original(self, evento)
        patches = getattr(self, "_b33_patches", ())
        if not patches:
            return
        # Posiciona as correções após o frame original, em coordenadas da arte
        # e usando o MESMO frame_rect/escala da Home aprovada.
        quadro = self.frame_rect()
        sx = quadro.width() / TAMANHO_ART[0]
        sy = quadro.height() / TAMANHO_ART[1]
        pintor = QPainter(self)
        pintor.setRenderHint(QPainter.SmoothPixmapTransform, True)
        for x, y, largura, altura, imagem in patches:
            destino = QRectF(quadro.x() + x*sx, quadro.y() + y*sy,
                            largura*sx, altura*sy)
            pintor.drawImage(destino, imagem,
                             QRectF(0.0, 0.0, float(largura), float(altura)))
        pintor.end()

    classe.__init__ = iniciar_com_limpeza
    classe.paintEvent = pintar_com_limpeza
    classe._b33_remocao_habilitada = True
    return True
