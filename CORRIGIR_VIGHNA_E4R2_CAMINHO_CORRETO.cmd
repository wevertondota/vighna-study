@echo off
setlocal EnableExtensions DisableDelayedExpansion
title VighnaStudy - Recuperar inicializacao E4R2
cls
echo ==========================================================
echo   VighnaStudy - Recuperar inicializacao apos E4
 echo ==========================================================
echo.
set "ROOT=%~dp0"
if not exist "%ROOT%main.py" (
  echo Este arquivo precisa ficar na pasta principal do VighnaStudy.
  echo Se ele estiver em Downloads, informe o caminho completo da pasta do sistema.
  set /p "ROOT=Digite a pasta que contem main.py: "
)
if not exist "%ROOT%\main.py" (
  echo.
  echo Pasta invalida. Nenhuma alteracao foi feita.
  pause
  exit /b 1
)
if not exist "%ROOT%\.venv\Scripts\python.exe" (
  echo.
  echo Python do VighnaStudy nao encontrado. Nenhuma alteracao foi feita.
  pause
  exit /b 1
)
echo Conferindo seguranca na pasta: %ROOT%
echo Iniciando mecanismo original com caminho normalizado...
echo.
"%ROOT%\.venv\Scripts\python.exe" -c "import pathlib,sys; t=pathlib.Path(sys.argv[1]).read_text(encoding='ascii'); exec(t.rsplit(chr(10)+'::PYCODE'+chr(10),1)[1].split(chr(10)+'::B64DATA'+chr(10),1)[0])" "%~f0" "%ROOT%."
set "RC=%ERRORLEVEL%"
echo.
if "%RC%"=="0" (
  echo CONCLUIDO - Abra o VighnaStudy pelo atalho normal.
) else (
  echo NAO CONCLUIDO - Envie a mensagem de erro exibida acima.
)
echo.
pause
exit /b %RC%
::PYCODE
from __future__ import annotations
import base64
import hashlib
import os
import subprocess
import sys
import tempfile
from pathlib import Path

expected_main_sha = "b79dcb8cf4b8787260e3fcd64aea616e30c309320f3c4a00246283a08393bf76"
expected_pkg_sha = "363837e76ec71553298cf4dd9bad04a017a31dc40164d99e65a9815fed93343b"
package_name = "VighnaStudy_0.29.59_Foco_Premium_E4R2_Correcao_QSize.zip"


def main():
    print("=== VighnaStudy - Recuperacao E4R2 ===", flush=True)
    cmd_path=Path(sys.argv[1]).resolve()
    root=Path(sys.argv[2]).resolve()
    print("Pasta:",root,flush=True)
    required = [root/'main.py', root/'versao.py', root/'estudos.db',
                root/'VighnaStudy.spec', root/'vighna_update_engine.py',
                root/'.venv'/'Scripts'/'python.exe',
                root/'dist'/'SistemaEstudos'/'VighnaStudy.exe']
    missing=[p for p in required if not p.is_file()]
    if missing:
        raise RuntimeError("Pasta incorreta ou instalacao incompleta. Ausentes: " + ", ".join(str(p) for p in missing))
    if os.name!='nt':
        raise RuntimeError("Este reparo deve ser executado no Windows.")
    if Path(sys.executable).resolve()!= (root/'.venv'/'Scripts'/'python.exe').resolve():
        raise RuntimeError("A recuperacao precisa usar o Python da .venv do VighnaStudy.")
    result=subprocess.run(['tasklist','/FI','IMAGENAME eq VighnaStudy.exe','/NH'],
        stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,errors='replace',
        timeout=20,creationflags=getattr(subprocess,'CREATE_NO_WINDOW',0))
    if result.returncode!=0:
        raise RuntimeError("Nao foi possivel verificar se o programa esta fechado.")
    if any(line.strip().lower().startswith('vighnastudy.exe ') for line in result.stdout.splitlines()):
        raise RuntimeError("Feche completamente o VighnaStudy antes de executar.")
    if hashlib.sha256((root/'main.py').read_bytes()).hexdigest()!=expected_main_sha:
        raise RuntimeError("O main.py nao corresponde a E4 instalada. Nada foi alterado. Envie o erro exibido.")
    try:
        import PyInstaller
    except ImportError as exc:
        raise RuntimeError("PyInstaller nao encontrado na .venv. Nada foi alterado.") from exc

    content=cmd_path.read_text(encoding='ascii')
    encoded=content.rsplit(chr(10)+'::B64DATA'+chr(10),1)[1]
    payload=base64.b64decode(''.join(encoded.split()),validate=True)
    if hashlib.sha256(payload).hexdigest()!=expected_pkg_sha:
        raise RuntimeError("O arquivo de recuperacao falhou na verificacao de integridade.")

    sys.path.insert(0,str(root))
    from vighna_update_engine import (inspect_package, check_database,
        recover_incomplete_updates, install_package)
    with tempfile.TemporaryDirectory(prefix='vighna_e4r2_') as temporary:
        zip_path=Path(temporary)/package_name
        zip_path.write_bytes(payload)
        print("[1/4] Checando versao, arquivos e banco de estudos...",flush=True)
        inspected=inspect_package(zip_path,root)
        if not inspected['target_build'].endswith('-focus-e4r2-fix-qsize-local-scope-v1'):
            raise RuntimeError('Pacote incorreto. Nada foi alterado.')
        check_database(root/'estudos.db')
        print("[2/4] Checando atualizacoes interrompidas...",flush=True)
        recovered=recover_incomplete_updates(root)
        if recovered:
            print('Transacoes recuperadas:',', '.join(recovered),flush=True)
            inspect_package(zip_path,root)
        print("[3/4] Preparando backup e reconstruindo o aplicativo...",flush=True)
        result=install_package(zip_path,root,python_exe=sys.executable,
            report=lambda pct,msg: print(f'   [{pct}%] {msg}',flush=True))
        print("[4/4] Atualizacao concluida, sem alterar estudos.db.",flush=True)
        print("Backup:",result.get('backup','registrado pelo atualizador'),flush=True)
    return 0


try:
    raise SystemExit(main())
except Exception as exc:
    print("\nRECUPERACAO INTERROMPIDA:",str(exc),file=sys.stderr,flush=True)
    print("Nao substitua arquivos manualmente. Envie esta mensagem para revisao.",file=sys.stderr,flush=True)
    raise SystemExit(1)

