        )
        aplicar_estilo_cabecalho_dashboard(self.dashboard_quick_nav, self.tema_atual)
        layout.addWidget(self.dashboard_quick_nav)
        # Futurista: a navegacao lateral ja oferece acesso as telas e a
        # busca global permanece no Ctrl+K. Esconder este widget faz o
        # QVBoxLayout recolher automaticamente a altura da faixa superior.
        self.dashboard_quick_nav.setVisible(
            normalizar_tema(self.tema_atual) != "futurista"
        )

        # ====================================================
        # FOCO — gestão do tempo de concentração
        # ====================================================

        # O antigo bloco "Hoje" foi substituído por um módulo de Foco.
        # A recomendação de conteúdo permanece no card próprio do algoritmo;
        # aqui a responsabilidade é exclusivamente organizar o tempo de estudo.
        self.dashboard_hoje_painel = QFrame()
        self.dashboard_hoje_painel.setObjectName(
            "dashboardFocusPanel"
        )
        # O painel externo é apenas estrutura: não deve desenhar a faixa
        # escura em volta dos cards Recomendação e Foco no tema Futurista.
        # A pintura própria, a borda ciano e os fundos dos cards filhos
        # permanecem intocados.
        if normalizar_tema(self.tema_atual) == "futurista":
            self.dashboard_hoje_painel.setStyleSheet(
                "QFrame#dashboardFocusPanel {"
                "background-color: transparent;"
                "border: none; border-radius: 0px; }"
            )

        foco_painel_layout = QVBoxLayout(
            self.dashboard_hoje_painel
        )
        # A linha superior e a inferior devem começar/terminar nas
        # mesmas colunas. O wrapper estrutural não deve adicionar bordas.
        foco_painel_layout.setContentsMargins(0, 0, 0, 0)
        foco_painel_layout.setSpacing(0)
        self._dashboard_foco_painel_layout = foco_painel_layout

        # O cabeçalho externo "Foco" foi removido para eliminar redundância
        # visual. O próprio card esquerdo passa a ser a identidade do módulo.
        # Mantemos estes objetos ocultos apenas para compatibilidade com rotinas
        # antigas de atualização/configuração.
        self.dashboard_toggle_hoje = QPushButton("Foco")
        self.dashboard_toggle_hoje.setVisible(False)
        self.dashboard_foco_subtitulo = QLabel("")
        self.dashboard_foco_subtitulo.setVisible(False)
        self.dashboard_hoje_data = QLabel("—")
        self.dashboard_hoje_data.setVisible(False)
        self.dashboard_hoje_status = QLabel("", self.dashboard_hoje_painel)
        self.dashboard_hoje_status.setVisible(False)

        self.dashboard_hoje_conteudo = QWidget()
        self.dashboard_hoje_conteudo.setObjectName(
            "dashboardCollapsibleContent"
        )
        dashboard_hoje_conteudo_layout = QVBoxLayout(
            self.dashboard_hoje_conteudo
        )
        dashboard_hoje_conteudo_layout.setContentsMargins(
            0, 0, 0, 0
        )
        dashboard_hoje_conteudo_layout.setSpacing(6)

        # Resumo do foco mantido apenas para compatibilidade com a rotina de
        # atualização, mas removido do topo do módulo para reduzir redundância
        # visual e permitir que os cards subam no layout.
        self.dashboard_focus_metric_today = QLabel(
            "0 min de foco hoje"
        )
        self.dashboard_focus_metric_today.setObjectName(
            "focusDashboardMetricText"
        )
        self.dashboard_focus_metric_today.setProperty(
            "metricKind", "time"
        )
        self.dashboard_focus_metric_today.setVisible(False)

        self.dashboard_focus_metric_sessions = QLabel(
            "0 sessões hoje"
        )
        self.dashboard_focus_metric_sessions.setObjectName(
            "focusDashboardMetricText"
        )
        self.dashboard_focus_metric_sessions.setProperty(
            "metricKind", "sessions"
        )
        self.dashboard_focus_metric_sessions.setVisible(False)

        self.dashboard_focus_metric_goal = QLabel(
            "Meta semanal desativada"
        )
        self.dashboard_focus_metric_goal.setObjectName(
            "focusDashboardMetricText"
        )
        self.dashboard_focus_metric_goal.setProperty(
            "metricKind", "goal"
        )
        self.dashboard_focus_metric_goal.setVisible(False)

        # Os ícones da referência são pictogramas ciano em pastilhas iguais.
        # Recolorir somente os ícones do Dashboard impede que o branco do
        # pacote FontAwesome contraste com os outros títulos no Futurista.
        def _icone_card_dashboard(rotulo, identificador, tamanho=22):
            icone = criar_icone(
                identificador, tema=self.tema_atual, papel="destaque"
            )
            if icone.isNull():
                return
            pixmap = icone.pixmap(QSize(tamanho, tamanho))
            if pixmap.isNull():
                return
            if normalizar_tema(self.tema_atual) in ("futurista", "escuro"):
                resultado = QPixmap(pixmap.size())
                resultado.fill(Qt.transparent)
                pintor = QPainter(resultado)
                pintor.drawPixmap(0, 0, pixmap)
                pintor.setCompositionMode(QPainter.CompositionMode_SourceIn)
                pintor.fillRect(resultado.rect(), QColor("#00CDEA"))
                pintor.end()
                pixmap = resultado
            rotulo.setText("")
            rotulo.setPixmap(pixmap)

        foco_cards = QHBoxLayout()
        foco_cards.setContentsMargins(0, 0, 0, 0)
        foco_cards.setSpacing(14)
        self._dashboard_primeira_linha = foco_cards

        # ----------------------------------------------------
        # Modo Foco — protagonista
        # ----------------------------------------------------
        # Foco Premium E6: fundo atmosférico isolado no próprio card.
        # A pintura é decorativa e não modifica os controles nem a Home.
        class _FocusCinematicCard(QFrame):
            def __init__(self):
                super().__init__()
                self._hourglass_overlay = None
                self._focus_progress_widget = None

            def attach_hourglass(self, artwork):
                self._hourglass_overlay = artwork
                self._place_hourglass()
                artwork.raise_()

            def bind_focus_progress(self, progress):
                # Usar a posição real da barra quando o Qt concluir o layout.
                self._focus_progress_widget = progress
                QTimer.singleShot(0, self._place_hourglass)

            def _place_hourglass(self):
                artwork = self._hourglass_overlay
                if artwork is None:
                    return
                x = max(0, self.width() - artwork.width() - 12)
                # A ampulheta é decorativa e não deve cobrir a barra.
                y = max(38, min(54, round(self.height() * 0.14)))
                progress = self._focus_progress_widget
                if progress is not None and progress.y() > 100:
                    y = max(28, min(y, progress.y() - artwork.height() - 6))
                artwork.move(x, y)

            def resizeEvent(self, event):
                super().resizeEvent(event)
                QTimer.singleShot(0, self._place_hourglass)

            def paintEvent(self, event):
                super().paintEvent(event)
                w, h = self.width(), self.height()
                if w <= 0 or h <= 0:
                    return
                painter = QPainter(self)
                painter.setRenderHint(QPainter.Antialiasing, True)
                painter.setClipRect(self.rect().adjusted(2, 2, -2, -2))
                # Halo radial sem borda retangular. Transparência total
                # na periferia para integrar a arte ao fundo da interface.
                glow_center = QPointF(w * 0.85, h * 0.42)
                glow = QRadialGradient(glow_center, max(1.0, w * 0.31))
                glow.setColorAt(0.0, QColor(10, 113, 205, 25))
                glow.setColorAt(0.45, QColor(7, 74, 148, 13))
                glow.setColorAt(1.0, QColor(7, 55, 112, 0))
                painter.setPen(Qt.NoPen)
                painter.setBrush(QBrush(glow))
                painter.drawEllipse(glow_center, w * 0.29, h * 0.46)
                # Textura diagonal sutil, como na referência futurista.
                painter.setPen(QPen(QColor(43, 132, 208, 14), 1))
                for dx in (0, 32, 64, 96, 128):
                    painter.drawLine(
                        QPointF(w * 0.65 + dx, h * 0.09),
                        QPointF(w * 0.82 + dx, h * 0.59),
                    )
                for xr, yr, alpha in ((0.78, 0.19, 34), (0.90, 0.33, 29),
                                      (0.70, 0.52, 20), (0.93, 0.63, 28)):
                    painter.setPen(Qt.NoPen)
                    painter.setBrush(QColor(87, 198, 255, alpha))
                    painter.drawEllipse(QPointF(w * xr, h * yr), 1.7, 1.7)
                painter.end()

        foco_hoje = _FocusCinematicCard()
