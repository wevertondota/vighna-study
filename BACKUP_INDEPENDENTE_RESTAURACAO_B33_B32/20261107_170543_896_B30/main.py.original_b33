        def criar_comparador(
            titulo_indicador
        ):
            quadro = QFrame()
            quadro.setObjectName(
                "comparisonMetric"
            )

            quadro_layout = QVBoxLayout(
                quadro
            )
            quadro_layout.setContentsMargins(
                12,
                7,
                12,
                8
            )
            quadro_layout.setSpacing(
                1
            )

            rotulo = QLabel(
