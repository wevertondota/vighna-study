            8,
            8
        )

        self.tabela_sessoes = QTableWidget()
        self.tabela_sessoes.setObjectName(
            "effectivenessTable"
        )
        self.tabela_sessoes.setColumnCount(
            8
        )
        self.tabela_sessoes.setHorizontalHeaderLabels([
            "Data",
            "Modo",
            "Escopo",
            "Q",
