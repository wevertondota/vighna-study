        self.disciplina.currentIndexChanged.connect(
            self.carregar_topicos
        )
        self.disciplina.currentIndexChanged.connect(
            self.atualizar_disponibilidade
        )
        self.topico.currentIndexChanged.connect(
            self.atualizar_disponibilidade
        )
        self.modo.currentTextChanged.connect(
            self.atualizar_disponibilidade
        )
        self.formato.currentIndexChanged.connect(
            self.atualizar_disponibilidade
        )

        self.carregar_topicos()
        self.atualizar_disponibilidade()

    def carregar_topicos(self):
        disciplina_id = (
            self.disciplina.currentData()
        )

        self.topico.blockSignals(
            True
        )
        self.topico.clear()
        self.topico.addItem(
            "Todos os tópicos",
            None
        )

        if disciplina_id is not None:
            disciplina_nome = (
                self.disciplina.currentText()
            )

            for topico in listar_topicos(
                disciplina_nome,
                self.concurso[0]
            ):
                self.topico.addItem(
                    topico[1],
                    topico[0]
                )

        self.topico.blockSignals(
            False
        )

        self.atualizar_disponibilidade()

    def atualizar_disponibilidade(self):
        modo = self.modo.currentText()

        disponiveis = (
            contar_questoes_disponiveis_por_modo(
                self.concurso[0],
                disciplina_id=self.disciplina.currentData(),
                topico_id=self.topico.currentData(),
                modo=modo,
                tipo_questao=self.formato.currentData()
            )
        )

        perfil = (
            obter_perfil_selecao_inteligente_questoes(
                self.concurso[0],
                disciplina_id=self.disciplina.currentData(),
                topico_id=self.topico.currentData(),
                tipo_questao=self.formato.currentData()
            )
        )

        if disponiveis <= 0:
            self.quantidade.setRange(
                1,
                1
            )
            self.quantidade.setValue(
                1
            )
            self.quantidade.setEnabled(
                False
            )
            self.botao_iniciar.setEnabled(
                False
            )

            if modo == "Apenas inéditas":
                texto = (
                    "Nenhuma questão inédita está disponível "
                    "com os filtros selecionados."
                )
            elif modo == "Revisar erros":
                texto = (
                    "Nenhuma questão com erro histórico está disponível "
                    "com os filtros selecionados."
                )
            else:
                texto = (
                    "Nenhuma questão está disponível "
                    "com os filtros selecionados."
                )

            self.disponibilidade.setText(
                texto
            )
            self.disponibilidade.setProperty(
                "availabilityState",
                "empty"
            )

        else:
            valor_atual = (
                self.quantidade.value()
            )

            self.quantidade.setEnabled(
                True
            )
            self.quantidade.setRange(
                1,
                disponiveis
            )
            self.quantidade.setValue(
                min(
                    max(
                        1,
                        valor_atual
                    ),
                    disponiveis
                )
            )
            self.botao_iniciar.setEnabled(
                True
            )

            self.disponibilidade.setText(
                (
                    f"{disponiveis} questão(ões) disponível(is) "
                    f"para o modo {modo}."
                )
            )
            self.disponibilidade.setProperty(
                "availabilityState",
                "ok"
            )

        contagens = perfil[
            "contagens"
        ]

        partes = []

        mapa = [
            (
                "inedita",
                "inéditas"
            ),
            (
                "recorrente",
                "erros recorrentes"
            ),
            (
                "recuperacao",
                "em recuperação"
            ),
            (
                "erro",
                "erros anteriores"
            ),
            (
                "controle",
                "controle"
            ),
            (
                "dominada",
                "dominadas"
            ),
        ]

        for chave, rotulo in mapa:
            quantidade = int(
                contagens.get(
                    chave,
                    0
                )
            )

            if quantidade > 0:
                partes.append(
                    f"{quantidade} {rotulo}"
                )

        if modo == "Sessão inteligente":
            cabecalho = (
                f"Perfil atual: {perfil['perfil_rotulo']}."
            )
            complemento = (
                " O VighnaStudy ajustará a composição automaticamente."
            )
        elif modo == "Revisar erros":
            cabecalho = (
                "Prioridade: recorrentes → recuperação → erros anteriores."
            )
            complemento = ""
        elif modo == "Apenas inéditas":
            cabecalho = (
                "Somente questões nunca respondidas neste perfil."
            )
            complemento = ""
        else:
            cabecalho = (
                "Seleção aleatória dentro dos filtros atuais."
            )
            complemento = ""

        self.estrategia_inteligente.setText(
            cabecalho
            + (
                "\n"
                + " • ".join(
                    partes
                )
                if partes
                else ""
            )
            + complemento
        )

        self.disponibilidade.style().unpolish(
            self.disponibilidade
        )
        self.disponibilidade.style().polish(
            self.disponibilidade
        )

    def confirmar(self):
        quantidade = (
            self.quantidade.value()
        )

        modo = (
            self.modo.currentText()
        )

        selecao = selecionar_questoes_por_modo(
            self.concurso[0],
            disciplina_id=self.disciplina.currentData(),
            topico_id=self.topico.currentData(),
            quantidade=quantidade,
            modo=modo,
            tipo_questao=self.formato.currentData()
        )

        fila = selecao[
            "fila"
        ]

        if not fila:
            QMessageBox.information(
                self,
                "Resolver questões",
                "Nenhuma questão está disponível para iniciar a sessão."
            )
            self.atualizar_disponibilidade()
            return

        self.configuracao = {
            "concurso_id": self.concurso[0],
            "concurso_nome": self.concurso[1],
            "disciplina_id": self.disciplina.currentData(),
            "disciplina_nome": self.disciplina.currentText(),
            "topico_id": self.topico.currentData(),
            "topico_nome": self.topico.currentText(),
            "modo": modo,
            "tipo_questao": self.formato.currentData(),
            "formato_nome": self.formato.currentText(),
            "origem_sessao": "manual",
            "quantidade": len(
                fila
            ),
            "fila": fila,
            "composicao_inteligente": selecao.get(
                "composicao",
                {}
            ),
            "perfil_inteligente": selecao.get(
                "perfil_rotulo",
                ""
            ),
        }

        self.accept()



class JanelaRevisaoBateria(QDialog):
    """Permite revisar toda a bateria já encerrada sem gerar novas tentativas."""

    def __init__(self, fila, registros, parent=None):
        super().__init__(parent)
        self.setWindowModality(Qt.WindowModal)
        self.fila = list(fila or [])
        self.registros = list(registros or [])
        self.questoes = []

        self.setWindowTitle("Revisar bateria")
        self.resize(980, 700)
        self.setMinimumSize(780, 560)
        self.setWindowFlag(Qt.WindowMaximizeButtonHint, True)

        registro_por_id = {
            int(item.get("questao_id")): item
            for item in self.registros
            if item.get("questao_id") is not None
        }

        for resumo_item in self.fila:
            questao_id = resumo_item.get("id")
            if questao_id is None:
                continue
            dados = obter_questao(questao_id)
            if dados is None:
                continue
            registro = registro_por_id.get(int(questao_id), {})
            self.questoes.append({
                **resumo_item,
                **dados,
                "status_bateria": registro.get("status", "Não respondida"),
                "marcada_bateria": registro.get("marcada"),
                "gabarito_bateria": registro.get("gabarito"),
                "duvida_bateria": bool(registro.get("duvida", False)),
            })

        layout = QVBoxLayout(self)
        layout.setContentsMargins(18, 16, 18, 16)
        layout.setSpacing(10)

        titulo = QLabel("Revisar toda a bateria")
        titulo.setObjectName("pageTitle")
        subtitulo = QLabel(
            "Consulte enunciado, alternativas, resposta marcada, gabarito e explicação sem alterar o histórico da sessão."
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        layout.addWidget(titulo)
        layout.addWidget(subtitulo)

        corpo = QHBoxLayout()
        corpo.setSpacing(12)

        self.tabela = QTableWidget()
        self.tabela.setColumnCount(4)
        self.tabela.setHorizontalHeaderLabels([
            "#", "Resultado", "Disciplina", "Tópico"
        ])
        self.tabela.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.tabela.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.tabela.setSelectionMode(QAbstractItemView.SingleSelection)
        self.tabela.setAlternatingRowColors(True)
        self.tabela.setShowGrid(False)
        self.tabela.verticalHeader().setVisible(False)
        self.tabela.setRowCount(len(self.questoes))
        header = self.tabela.horizontalHeader()
        header.setSectionResizeMode(0, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(1, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(2, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(3, QHeaderView.Stretch)

        for linha, questao in enumerate(self.questoes):
            valores = [
                str(linha + 1),
                questao.get("status_bateria", "Não respondida"),
                questao.get("disciplina", "—"),
                questao.get("topico", "—"),
            ]
            for coluna, valor in enumerate(valores):
                item = QTableWidgetItem(str(valor))
                if coluna in (0, 1):
                    item.setTextAlignment(Qt.AlignCenter)
                if coluna == 1:
                    if valor == "Correta":
                        aplicar_destaque_tabela(item, "sucesso", True)
                    elif valor == "Errada":
                        aplicar_destaque_tabela(item, "perigo", True)
                    elif valor in ("Pulada", "Não respondida"):
                        aplicar_destaque_tabela(item, "atencao", True)
                self.tabela.setItem(linha, coluna, item)
            self.tabela.setRowHeight(linha, 30)

        self.detalhes = QTextEdit()
        self.detalhes.setReadOnly(True)
        self.detalhes.setObjectName("detailsReadOnly")
        self.detalhes.setPlaceholderText("Selecione uma questão para revisar.")

        corpo.addWidget(self.tabela, 2)
        corpo.addWidget(self.detalhes, 3)
        layout.addLayout(corpo, 1)

        fechar = QDialogButtonBox(QDialogButtonBox.Close)
        fechar.button(QDialogButtonBox.Close).setText("Fechar")
        fechar.rejected.connect(self.reject)
        layout.addWidget(fechar)

        self.tabela.itemSelectionChanged.connect(self.mostrar_questao)
        if self.questoes:
            self.tabela.selectRow(0)

    def mostrar_questao(self):
        linha = self.tabela.currentRow()
        if linha < 0 or linha >= len(self.questoes):
            self.detalhes.clear()
            return

        questao = self.questoes[linha]
        marcada = questao.get("marcada_bateria") or "—"
        gabarito = questao.get("gabarito_bateria")
        if not gabarito:
            gabarito = next(
                (
                    alt.get("letra")
                    for alt in questao.get("alternativas", [])
                    if alt.get("correta")
                ),
                "—",
            )

        linhas = [
            f"QUESTÃO {linha + 1}",
            "",
            str(questao.get("enunciado") or ""),
            "",
        ]
        tipo_questao = _questao_tipo(questao)
        for alternativa in questao.get("alternativas", []):
            letra = str(alternativa.get("letra") or "").strip().upper()
            texto_alt = str(alternativa.get("texto") or "")
            marcadores = []
            if letra == gabarito:
                marcadores.append("GABARITO")
            if letra == marcada:
                marcadores.append("MARCADA POR VOCÊ" if letra != gabarito else "SUA RESPOSTA")
            sufixo = f"  [{' • '.join(marcadores)}]" if marcadores else ""
            if tipo_questao == "CERTO_ERRADO":
                linhas.append(f"{_rotulo_resposta_questao(letra, tipo_questao)}{sufixo}")
            else:
                linhas.append(f"{letra}) {texto_alt}{sufixo}")

        linhas.extend([
            "",
            f"Resultado na bateria: {questao.get('status_bateria', 'Não respondida')}",
            f"Resposta marcada: {_rotulo_resposta_questao(marcada, tipo_questao)}",
            f"Gabarito: {_rotulo_resposta_questao(gabarito, tipo_questao)}",
        ])
        explicacao = explicacao_texto_simples(questao.get("explicacao")).strip()
        linhas.extend([
            "",
            "EXPLICAÇÃO",
            explicacao if explicacao else "Esta questão não possui explicação cadastrada.",
        ])
        self.detalhes.setPlainText("\n".join(linhas))


def _b21_texto_duracao_pausa(segundos):
    """Representacao exata de tempo efetivo, incluindo pausas acima de 1h."""
    total = max(0, int(float(segundos or 0)))
    horas, restante = divmod(total, 3600)
    minutos, segundos = divmod(restante, 60)
    return (f"{horas:02d}:{minutos:02d}:{segundos:02d}"
            if horas else f"{minutos:02d}:{segundos:02d}")


class JanelaResumoResolucaoQuestoes(QDialog):
    def __init__(
        self,
        resumo,
        registros,
        motivo,
        integracao=None,
        parent=None,
        estrategia=None,
        efetividade=None,
        simulado=None,
        fila_original=None,
        configuracao_original=None,
        permitir_acoes_pos_bateria=True,
        pausas_sessao=None
    ):
        super().__init__(
            parent
        )
        self.setObjectName("questionSessionSummaryDialog")
        self.setWindowModality(Qt.WindowModal)

        # Janela operacional ampla: permite maximizar/restaurar
        # pelo botão nativo do Windows e por duplo clique na barra.
        self.setWindowFlag(
            Qt.WindowMaximizeButtonHint,
            True
        )

        self.setWindowTitle(
            "Resumo da sessão de questões"
        )
        self.resize(
            820,
            570
        )
        self.setMinimumSize(
            700,
            500
        )

        if estrategia:
            self.resize(
                880,
                700
            )

        self.registros_bateria = list(registros or [])
        self.fila_original = list(fila_original or [])
        self.configuracao_original = dict(configuracao_original or {})
        self.permitir_acoes_pos_bateria = bool(permitir_acoes_pos_bateria)
        self.proxima_acao = None
        self.pausas_sessao = [dict(p) for p in (pausas_sessao or [])]

        origem_fluxo = str(
            self.configuracao_original.get("origem_sessao")
            or resumo.get("origem")
            or ""
        ).strip().lower()
        modo_fluxo = unicodedata.normalize(
            "NFKD",
            str(self.configuracao_original.get("modo") or resumo.get("modo") or ""),
        ).encode("ascii", "ignore").decode("ascii").lower()
        self.fluxo_algoritmo = (
            origem_fluxo == "algoritmo_v5"
            or "motor v5" in modo_fluxo
        )
        self.integracao_dados = list(integracao or [])
        self.efetividade_dados = dict(efetividade or {})

        simulado = dict(
            simulado
            or {}
        )

        if simulado:
            self.fluxo_algoritmo = False
            self.resize(
                1040,
                780
            )
            self.setWindowTitle(
                "Resultado do simulado"
            )

        layout = QVBoxLayout(
            self
        )
        layout.setContentsMargins(
            18,
            16,
            18,
            16
        )
        layout.setSpacing(
            10
        )

        reforco_sem_impacto = (resumo.get("origem") == "reforco_pos_bateria")
        banco_erros_sem_impacto = (resumo.get("origem") == "banco_erros")
        if banco_erros_sem_impacto:
            self.setWindowTitle("Banco de Erros — resumo operacional")

        titulo = QLabel(
            (
                "Banco de Erros"
                if banco_erros_sem_impacto
                else "Resumo do reforço imediato"
                if reforco_sem_impacto
                else (
                    "Resultado do simulado"
                    if simulado
                    else (
                        "Sessão concluída"
                        if self.fluxo_algoritmo and resumo.get("concluida")
                        else (
                            "Sessão encerrada"
                            if self.fluxo_algoritmo
                            else "Resumo da sessão"
                        )
                    )
                )
            )
        )
        titulo.setObjectName(
            "pageTitle"
        )

        if self.fluxo_algoritmo:
            disciplina_resumo = str(
                self.configuracao_original.get("disciplina_nome")
                or (self.registros_bateria[0].get("disciplina") if self.registros_bateria else "")
                or ""
            ).strip()
            topico_resumo = str(
                self.configuracao_original.get("topico_nome")
                or (self.registros_bateria[0].get("topico") if self.registros_bateria else "")
                or ""
            ).strip()
            partes_resumo = [parte for parte in (disciplina_resumo, topico_resumo) if parte]
            descricao_texto = "\n".join(partes_resumo) or str(resumo.get("modo") or "Sessão recomendada")
        elif banco_erros_sem_impacto:
            descricao_texto = (
                f"{resumo['concurso']} • {motivo} • treino sem impacto na inteligência"
            )
        else:
            descricao_texto = f"{resumo['concurso']} • {resumo['modo']} • {motivo}"

        descricao = QLabel(
            descricao_texto
        )
        descricao.setObjectName(
            "pageSubtitle"
        )
        descricao.setWordWrap(
            True
        )

        layout.addWidget(
            titulo
        )
        layout.addWidget(
            descricao
        )

        cards = QGridLayout()
        cards.setHorizontalSpacing(
            8
        )
        cards.setVerticalSpacing(
            8
        )

        for coluna in range(
            3
        ):
            cards.setColumnStretch(
                coluna,
                1
            )

        def criar_card(
            rotulo_texto,
            valor_texto
        ):
            card = QFrame()
            card.setObjectName(
                "questionSessionSummaryCard"
            )

            card_layout = QVBoxLayout(
                card
            )
            card_layout.setContentsMargins(
                12,
                9,
                12,
                9
            )
            card_layout.setSpacing(
                2
            )

            rotulo = QLabel(
                rotulo_texto
            )
            rotulo.setObjectName(
                "miniStatLabel"
            )

            valor = QLabel(
                str(
                    valor_texto
                )
            )
            valor.setObjectName(
                "miniStatValue"
            )

            card_layout.addWidget(
                rotulo
            )
            card_layout.addWidget(
                valor
            )

            return card

        desempenho = (
            (
                f"{resumo['desempenho']:.1f}%"
            )
            if resumo[
                "desempenho"
            ] is not None
            else "—"
        )

        pontuacao_simulado = None
        regra_pontuacao_simulado = str(
            simulado.get("regra_pontuacao") or "NORMAL"
        ).upper()
        if simulado:
            valor_acerto = float(simulado.get("pontos_acerto", 1) or 0)
            valor_erro = float(
                simulado.get(
                    "pontos_erro",
                    -1 if regra_pontuacao_simulado == "CEBRASPE" else 0
                )
            )
            valor_branco = float(simulado.get("pontos_branco", 0) or 0)
            pontuacao_simulado = sum(
                valor_acerto if registro.get("status") == "Correta"
                else valor_erro if registro.get("status") == "Errada"
                else valor_branco
                for registro in registros
            )

        ineditas_respondidas = sum(
            1
            for registro in registros
            if (
                registro.get(
                    "inedita"
                )
                and registro.get(
                    "status"
                )
                in (
                    "Correta",
                    "Errada"
                )
            )
        )

        def _formatar_duracao_resumo():
            inicio = resumo.get("iniciado_em")
            fim = resumo.get("encerrado_em")
            if not inicio or not fim:
                return "—"
            try:
                dt_inicio = datetime.fromisoformat(str(inicio).replace("Z", "+00:00"))
                dt_fim = datetime.fromisoformat(str(fim).replace("Z", "+00:00"))
                segundos = max(0, int((dt_fim - dt_inicio).total_seconds()))
            except Exception:
                return "—"
            if segundos < 60:
                return f"{segundos} s"
            minutos, resto = divmod(segundos, 60)
            if minutos < 60:
                return f"{minutos} min" if resto < 30 else f"{minutos + 1} min"
            horas, minutos = divmod(minutos, 60)
            return f"{horas}h {minutos:02d}min"

        tempo_medio = self.efetividade_dados.get("tempo_medio_questao")
        if tempo_medio is None:
            tempo_medio_texto = "—"
        else:
            tempo_medio = float(tempo_medio)
            tempo_medio_texto = (
                f"{tempo_medio:.0f} s"
                if tempo_medio < 60
                else f"{tempo_medio / 60.0:.1f} min"
            )

        if self.fluxo_algoritmo:
            valores = [
                ("Questões", int(resumo.get("objetivo") or resumo.get("processadas") or 0)),
                ("Acertos", int(resumo.get("acertos") or 0)),
                ("Erros", int(resumo.get("erros") or 0)),
                ("Aproveitamento", desempenho),
                ("Tempo total", _formatar_duracao_resumo()),
                ("Tempo médio", tempo_medio_texto),
            ]
        elif banco_erros_sem_impacto:
            valores = [
                ("Praticadas", int(resumo.get("praticadas") or 0)),
                ("Removidas da fila", int(resumo.get("removidas_fila") or 0)),
                ("Ainda pendentes", int(resumo.get("ainda_pendentes") or 0)),
            ]
        else:
            valores = [
                (
                    "Respondidas",
                    resumo[
                        "respondidas"
                    ]
                ),
                (
                    "Acertos",
                    resumo[
                        "acertos"
                    ]
                ),
                (
                    "Erros",
                    resumo[
                        "erros"
                    ]
                ),
                (
                    "Desempenho",
                    desempenho
                ),
                (
                    "Puladas",
                    resumo[
                        "puladas"
                    ]
                ),
                (
                    "Dúvidas",
                    resumo[
                        "duvidas"
                    ]
                ),
            ]
            if simulado and pontuacao_simulado is not None:
                pontuacao_texto = (
                    str(int(pontuacao_simulado))
                    if float(pontuacao_simulado).is_integer()
                    else f"{pontuacao_simulado:.1f}"
                )
                valores.append(("Pontuação", pontuacao_texto))

        for indice, (
            rotulo,
            valor
        ) in enumerate(
            valores
        ):
            cards.addWidget(
                criar_card(
                    rotulo,
                    valor
                ),
                indice // 3,
                indice % 3
            )

        layout.addLayout(
            cards
        )

        # B21: painel resumido de pausas reais da bateria, separado das
        # estatisticas academicas. Lista integral com rolagem se necessario.
        if self.pausas_sessao:
            pausas_total = sum(
                max(0, int(p.get("duracao_segundos") or 0))
                for p in self.pausas_sessao
            )
            painel_pausas = QFrame()
            painel_pausas.setObjectName("questionReviewIntegrationCard")
            painel_layout = QVBoxLayout(painel_pausas)
            painel_layout.setContentsMargins(12, 9, 12, 9)
            painel_layout.setSpacing(4)
            resumo_pausas = QLabel(
                f"Pausas da sessão: {len(self.pausas_sessao)}  •  "
                f"Tempo total: {_b21_texto_duracao_pausa(pausas_total)}"
            )
            resumo_pausas.setObjectName("questionReviewIntegrationTitle")
            painel_layout.addWidget(resumo_pausas)
            texto_pausas = QTextEdit()
            texto_pausas.setObjectName("questionPauseHistoryB21")
            texto_pausas.setReadOnly(True)
            texto_pausas.setFocusPolicy(Qt.NoFocus)
            texto_pausas.setMinimumHeight(56)
            texto_pausas.setMaximumHeight(86)
            texto_pausas.setPlainText("\n".join(
                f"{int(p.get('numero', i))}ª pausa · "
                f"{p.get('horario_inicio', '—')} · "
                f"real: {_b21_texto_duracao_pausa(p.get('duracao_segundos', 0))} · "
                f"prevista: {_b21_texto_duracao_pausa(p.get('programado_segundos', 0))}"
                for i, p in enumerate(self.pausas_sessao, 1)
            ))
            painel_layout.addWidget(texto_pausas)
            layout.addWidget(painel_pausas)

        detalhe = QLabel(
            (
                "Treino sem impacto na inteligência. Nenhuma resposta desta rodada foi gravada como tentativa acadêmica."
                if banco_erros_sem_impacto
                else "Reforço isolado: nenhuma resposta desta rodada foi gravada no histórico ou usada pela inteligência do Vighna."
                if reforco_sem_impacto
                else (
                    (
                        f"Puladas: {int(resumo.get('puladas') or 0)} • "
                        f"Dúvidas: {int(resumo.get('duvidas') or 0)} • "
                        f"Inéditas respondidas: {ineditas_respondidas}"
                    )
                    if self.fluxo_algoritmo
                    else (
                        f"Questões inéditas respondidas nesta sessão: "
                        f"{ineditas_respondidas}"
                    )
                )
            )
        )
        detalhe.setObjectName(
            "questionSessionSummaryDetail"
        )

        layout.addWidget(
            detalhe
        )

        desempenho_por_formato = {}
        for registro in registros:
            tipo = str(registro.get("tipo_questao") or "MULTIPLA_ESCOLHA")
            dados_formato = desempenho_por_formato.setdefault(
                tipo,
                {"respondidas": 0, "acertos": 0, "erros": 0}
            )
            if registro.get("status") in ("Correta", "Errada"):
                dados_formato["respondidas"] += 1
                if registro.get("status") == "Correta":
                    dados_formato["acertos"] += 1
                else:
                    dados_formato["erros"] += 1

        if desempenho_por_formato and (
            "CERTO_ERRADO" in desempenho_por_formato
            or len(desempenho_por_formato) > 1
        ):
            partes_formato = []
            for tipo, rotulo in (
                ("MULTIPLA_ESCOLHA", "Múltipla escolha"),
                ("CERTO_ERRADO", "Certo / Errado"),
            ):
                dados_formato = desempenho_por_formato.get(tipo)
                if not dados_formato or not dados_formato["respondidas"]:
                    continue
                taxa = 100.0 * dados_formato["acertos"] / dados_formato["respondidas"]
                partes_formato.append(
                    f"{rotulo}: {taxa:.1f}% "
                    f"({dados_formato['acertos']}/{dados_formato['respondidas']})"
                )
            if partes_formato:
                desempenho_formato_label = QLabel(
                    "Desempenho por formato • " + "   •   ".join(partes_formato)
                )
                desempenho_formato_label.setObjectName(
                    "questionSessionSummaryDetail"
                )
                desempenho_formato_label.setWordWrap(True)
                layout.addWidget(desempenho_formato_label)

        if simulado and pontuacao_simulado is not None:
            regra_texto = (
                "Cebraspe: +1 acerto, -1 erro, 0 em branco"
                if regra_pontuacao_simulado == "CEBRASPE"
                else "Normal: +1 acerto, 0 erro, 0 em branco"
            )
            regra_label = QLabel(
                f"Regra de pontuação do simulado • {regra_texto}. "
                "Esta nota não altera a inteligência acadêmica."
            )
            regra_label.setObjectName("questionSessionSummaryDetail")
            regra_label.setWordWrap(True)
            layout.addWidget(regra_label)

        if self.fluxo_algoritmo:
            integracao_alvo = None
            topico_id_fluxo = self.configuracao_original.get("topico_id")
            for item_integracao in self.integracao_dados:
                if (
                    topico_id_fluxo is not None
                    and item_integracao.get("topico_id") is not None
                    and int(item_integracao.get("topico_id")) == int(topico_id_fluxo)
                ):
                    integracao_alvo = item_integracao
                    break
            if integracao_alvo is None and self.integracao_dados:
                integracao_alvo = self.integracao_dados[0]
            integracao_alvo = dict(integracao_alvo or {})
            cobertura = dict(integracao_alvo.get("cobertura_revisao") or {})

            cobertura_card = QFrame()
            cobertura_card.setObjectName("questionReviewIntegrationCard")
            cobertura_layout = QVBoxLayout(cobertura_card)
            cobertura_layout.setContentsMargins(12, 10, 12, 10)
            cobertura_layout.setSpacing(7)

            cobertura_titulo = QLabel("Cobertura e revisão")
            cobertura_titulo.setObjectName("questionReviewIntegrationTitle")
            cobertura_layout.addWidget(cobertura_titulo)

            cobertura_grid = QGridLayout()
            cobertura_grid.setHorizontalSpacing(16)
            cobertura_grid.setVerticalSpacing(5)
            cobertura_grid.setColumnStretch(1, 1)

            total_cobertura = int(cobertura.get("total") or 0)
            cobertas_cobertura = int(cobertura.get("cobertas") or 0)
            restantes_cobertura = int(cobertura.get("restantes") or 0)
            percentual_cobertura = cobertura.get("percentual")

            if total_cobertura > 0:
                rodada_texto = f"{cobertas_cobertura}/{total_cobertura}"
                percentual_texto = (
                    f"{float(percentual_cobertura):.0f}%"
                    if percentual_cobertura is not None
                    else "—"
                )
                restantes_texto = str(restantes_cobertura)
                if restantes_cobertura > 0:
                    status_revisao = "Revisão em andamento"
                    proxima_revisao_texto = "Ainda não reagendada"
                else:
                    status_revisao = "Revisão concluída"
                    proxima_revisao = integracao_alvo.get("proxima_revisao")
                    proxima_revisao_texto = (
                        formatar_data(proxima_revisao)
                        if proxima_revisao
                        else "Concluída"
                    )
            else:
                rodada_texto = str(int(resumo.get("processadas") or 0))
                percentual_texto = "—"
                restantes_texto = "—"
                if integracao_alvo.get("revisao_registrada"):
                    status_revisao = "Revisão registrada"
                elif integracao_alvo:
                    status_revisao = "Atividade registrada"
                else:
                    status_revisao = "Sem alteração de agenda"
                proxima_revisao = integracao_alvo.get("proxima_revisao")
                proxima_revisao_texto = (
                    formatar_data(proxima_revisao)
                    if proxima_revisao
                    else "—"
                )

            dados_cobertura = [
                ("Questões desta rodada", rodada_texto),
                ("Cobertura", percentual_texto),
                ("Restantes", restantes_texto),
                ("Status", status_revisao),
                ("Próxima revisão", proxima_revisao_texto),
            ]
            for linha_cobertura, (rotulo_cobertura, valor_cobertura) in enumerate(dados_cobertura):
                rotulo_widget = QLabel(rotulo_cobertura)
                rotulo_widget.setObjectName("miniStatLabel")
                valor_widget = QLabel(str(valor_cobertura))
                valor_widget.setObjectName("questionReviewIntegrationText")
                valor_widget.setWordWrap(True)
                cobertura_grid.addWidget(rotulo_widget, linha_cobertura, 0)
                cobertura_grid.addWidget(valor_widget, linha_cobertura, 1)

            cobertura_layout.addLayout(cobertura_grid)
            layout.addWidget(cobertura_card)

            aviso_proxima = QLabel(
                "A próxima sessão será recalculada com os resultados desta bateria."
            )
            aviso_proxima.setObjectName("questionSessionSummaryDetail")
            aviso_proxima.setAlignment(Qt.AlignCenter)
            aviso_proxima.setWordWrap(True)
            layout.addWidget(aviso_proxima)

            continuar_algoritmo = QPushButton("▶  CONTINUAR PELO ALGORITMO")
            continuar_algoritmo.setObjectName("primaryButton")
            continuar_algoritmo.setMinimumHeight(46)
            continuar_algoritmo.setMinimumWidth(320)
            continuar_algoritmo.clicked.connect(self.continuar_pelo_algoritmo)
            layout.addWidget(continuar_algoritmo, 0, Qt.AlignHCenter)

            if self.permitir_acoes_pos_bateria and self.fila_original:
                reforco_botoes = QHBoxLayout()
                reforco_botoes.setSpacing(8)

                revisar_bateria = QPushButton("Revisar toda a bateria")
                revisar_bateria.setObjectName("subtleButton")
                revisar_bateria.setMinimumHeight(36)
                revisar_bateria.clicked.connect(self.revisar_toda_bateria)

                self.refazer_erradas_btn = QPushButton("Rever erradas")
                self.refazer_erradas_btn.setObjectName("subtleButton")
                self.refazer_erradas_btn.setMinimumHeight(36)
                quantidade_erradas = sum(
                    1 for item in self.registros_bateria
                    if item.get("status") == "Errada"
                )
                self.refazer_erradas_btn.setEnabled(quantidade_erradas > 0)
                self.refazer_erradas_btn.setText(
                    f"Rever erradas ({quantidade_erradas})"
                    if quantidade_erradas > 0
                    else "Nenhuma questão errada"
                )
                self.refazer_erradas_btn.clicked.connect(self.refazer_questoes_erradas)

                reforco_botoes.addStretch(1)
                reforco_botoes.addWidget(revisar_bateria)
                reforco_botoes.addWidget(self.refazer_erradas_btn)
                reforco_botoes.addStretch(1)
                layout.addLayout(reforco_botoes)

            navegacao_botoes = QHBoxLayout()
            navegacao_botoes.setSpacing(8)
            navegacao_botoes.addStretch(1)

            voltar_dashboard = QPushButton("Voltar ao Dashboard")
            voltar_dashboard.setObjectName("subtleButton")
            voltar_dashboard.setMinimumHeight(34)
            voltar_dashboard.clicked.connect(self.voltar_ao_dashboard)

            abrir_banco = QPushButton("Banco de questões")
            abrir_banco.setObjectName("subtleButton")
            abrir_banco.setMinimumHeight(34)
            abrir_banco.clicked.connect(self.ir_para_banco_questoes)

            navegacao_botoes.addWidget(voltar_dashboard)
            navegacao_botoes.addWidget(abrir_banco)
            navegacao_botoes.addStretch(1)
            layout.addLayout(navegacao_botoes)

        if (
            not self.fluxo_algoritmo
            and self.permitir_acoes_pos_bateria
            and self.fila_original
        ):
            pos_card = QFrame()
            pos_card.setObjectName("questionReviewIntegrationCard")
            pos_layout = QVBoxLayout(pos_card)
            pos_layout.setContentsMargins(12, 10, 12, 10)
            pos_layout.setSpacing(8)

            pos_titulo = QLabel("Depois da bateria")
            pos_titulo.setObjectName("questionReviewIntegrationTitle")
            pos_texto = QLabel(
                "Revise a bateria completa ou refaça somente as questões erradas. "
                "O reforço imediato das erradas é isolado: as novas respostas não entram "
                "no histórico, nas revisões, no Domínio ou na inteligência do Vighna."
            )
            pos_texto.setObjectName("questionReviewIntegrationText")
            pos_texto.setWordWrap(True)

            pos_botoes = QHBoxLayout()
            pos_botoes.setSpacing(8)

            revisar_bateria = QPushButton("Revisar toda a bateria")
            revisar_bateria.setObjectName("subtleButton")
            revisar_bateria.setMinimumHeight(38)
            revisar_bateria.clicked.connect(self.revisar_toda_bateria)

            self.refazer_erradas_btn = QPushButton("Resolver somente as erradas")
            self.refazer_erradas_btn.setObjectName("primaryButton")
            self.refazer_erradas_btn.setMinimumHeight(38)
            quantidade_erradas = sum(
                1 for item in self.registros_bateria
                if item.get("status") == "Errada"
            )
            self.refazer_erradas_btn.setEnabled(quantidade_erradas > 0)
            self.refazer_erradas_btn.setText(
                f"Resolver somente as erradas ({quantidade_erradas})"
                if quantidade_erradas > 0
                else "Nenhuma questão errada"
            )
            self.refazer_erradas_btn.clicked.connect(self.refazer_questoes_erradas)

            pos_botoes.addWidget(revisar_bateria)
            pos_botoes.addWidget(self.refazer_erradas_btn)
            pos_botoes.addStretch(1)

            pos_layout.addWidget(pos_titulo)
            pos_layout.addWidget(pos_texto)
            pos_layout.addLayout(pos_botoes)
            layout.addWidget(pos_card)

        efetividade = dict(
            efetividade
            or {}
        )

        if efetividade and not self.fluxo_algoritmo:
            impacto_card = QFrame()
            impacto_card.setObjectName(
                "effectivenessImpactCard"
            )

            impacto_layout = QVBoxLayout(
                impacto_card
            )
            impacto_layout.setContentsMargins(
                12,
                9,
                12,
                9
            )
            impacto_layout.setSpacing(
                5
            )

            impacto_titulo = QLabel(
                "Impacto medido da sessão"
            )
            impacto_titulo.setObjectName(
                "effectivenessImpactTitle"
            )

            impacto_metricas = QHBoxLayout()
            impacto_metricas.setSpacing(
                8
            )

            def criar_impacto(
                rotulo,
                antes,
                depois,
                sufixo=""
            ):
                frame = QFrame()
                frame.setObjectName(
                    "effectivenessImpactMetric"
                )

                frame_layout = QVBoxLayout(
                    frame
                )
                frame_layout.setContentsMargins(
                    9,
                    5,
                    9,
                    5
                )
                frame_layout.setSpacing(
                    1
                )

                label = QLabel(
                    rotulo
                )
                label.setObjectName(
                    "effectivenessImpactLabel"
                )

                if (
                    antes is None
                    or depois is None
                ):
                    texto = "—"
                else:
                    delta = (
                        float(
                            depois
                        )
                        - float(
                            antes
                        )
                    )
                    sinal = (
                        "+"
                        if delta > 0
                        else ""
                    )
                    texto = (
                        f"{float(antes):.1f} → "
                        f"{float(depois):.1f} "
                        f"({sinal}{delta:.1f}{sufixo})"
                    )

                valor = QLabel(
                    texto
                )
                valor.setObjectName(
                    "effectivenessImpactValue"
                )

                frame_layout.addWidget(
                    label
                )
                frame_layout.addWidget(
                    valor
                )

                return frame

            impacto_metricas.addWidget(
                criar_impacto(
                    "Domínio médio",
                    efetividade.get(
                        "dominio_antes"
                    ),
                    efetividade.get(
                        "dominio_depois"
                    )
                ),
                1
            )

            impacto_metricas.addWidget(
                criar_impacto(
                    "Cobertura média",
                    efetividade.get(
                        "cobertura_antes"
                    ),
                    efetividade.get(
                        "cobertura_depois"
                    ),
                    " p.p."
                ),
                1
            )

            recorrentes_antes = int(
                efetividade.get(
                    "recorrentes_antes",
                    0
                )
                or 0
            )
            recorrentes_depois = int(
                efetividade.get(
                    "recorrentes_depois",
                    0
                )
                or 0
            )

            erros_frame = QFrame()
            erros_frame.setObjectName(
                "effectivenessImpactMetric"
            )

            erros_layout = QVBoxLayout(
                erros_frame
            )
            erros_layout.setContentsMargins(
                9,
                5,
                9,
                5
            )
            erros_layout.setSpacing(
                1
            )

            erros_label = QLabel(
                "Erros recorrentes"
            )
            erros_label.setObjectName(
                "effectivenessImpactLabel"
            )

            erros_valor = QLabel(
                (
                    f"{recorrentes_antes} → "
                    f"{recorrentes_depois}"
                )
            )
            erros_valor.setObjectName(
                "effectivenessImpactValue"
            )

            erros_layout.addWidget(
                erros_label
            )
            erros_layout.addWidget(
                erros_valor
            )

            impacto_metricas.addWidget(
                erros_frame,
                1
            )

            tempo = efetividade.get(
                "tempo_medio_questao"
            )

            impacto_rodape = QLabel(
                (
                    "Ritmo nesta sessão: "
                    + (
                        (
                            f"{tempo:.0f} s por questão"
                            if tempo < 60
                            else f"{tempo / 60.0:.1f} min por questão"
                        )
                        if tempo is not None
                        else "tempo insuficiente"
                    )
                )
            )
            impacto_rodape.setObjectName(
                "effectivenessImpactFooter"
            )

            impacto_layout.addWidget(
                impacto_titulo
            )
            impacto_layout.addLayout(
                impacto_metricas
            )
            impacto_layout.addWidget(
                impacto_rodape
            )

            layout.addWidget(
                impacto_card
            )

        estrategia = dict(
            estrategia
            or {}
        )

        if estrategia and not self.fluxo_algoritmo:
            plano = dict(
                estrategia.get(
                    "plano",
                    {}
                )
                or {}
            )

            adaptativo_card = QFrame()
            adaptativo_card.setObjectName(
                "adaptiveSummaryCard"
            )

            adaptativo_layout = QVBoxLayout(
                adaptativo_card
            )
            adaptativo_layout.setContentsMargins(
                12,
                9,
                12,
                9
            )
            adaptativo_layout.setSpacing(
                4
            )

            adaptativo_titulo = QLabel(
                "Estratégia adaptativa da sessão"
            )
            adaptativo_titulo.setObjectName(
                "adaptiveSummaryTitle"
            )

            composicao_topicos = estrategia.get(
                "composicao_topicos",
                {}
            )

            linhas_topicos = [
                (
                    f"{rotulo}: {quantidade} questão(ões)"
                )
                for rotulo, quantidade
                in composicao_topicos.items()
            ]

            resumo_motivos = estrategia.get(
                "resumo_motivos",
                {}
            )

            linhas_motivos = [
                (
                    f"{motivo_rotulo}: "
                    f"{quantidade_motivo}"
                )
                for motivo_rotulo, quantidade_motivo
                in resumo_motivos.items()
            ]

            adaptativo_texto = QLabel(
                (
                    f"Escopo: {estrategia.get('escopo', '—')} • "
                    f"{plano.get('topicos_utilizados', 0)} tópico(s) • "
                    f"estimativa inicial ≈ "
                    f"{plano.get('tempo_estimado_minutos', 0)} min\n"
                    + (
                        "Distribuição: "
                        + " • ".join(
                            linhas_topicos
                        )
                        if linhas_topicos
                        else "Distribuição: —"
                    )
                    + (
                        "\nMotivos: "
                        + " • ".join(
                            linhas_motivos
                        )
                        if linhas_motivos
                        else ""
                    )
                )
            )
            adaptativo_texto.setObjectName(
                "adaptiveSummaryText"
            )
            adaptativo_texto.setWordWrap(
                True
            )

            adaptativo_layout.addWidget(
                adaptativo_titulo
            )
            adaptativo_layout.addWidget(
                adaptativo_texto
            )

            layout.addWidget(
                adaptativo_card
            )

        integracao = list(
            integracao
            or []
        )

        if integracao and not self.fluxo_algoritmo:
            integracao_card = QFrame()
            integracao_card.setObjectName(
                "questionReviewIntegrationCard"
            )

            integracao_layout = QVBoxLayout(
                integracao_card
            )
            integracao_layout.setContentsMargins(
                12,
                9,
                12,
                9
            )
            integracao_layout.setSpacing(
                4
            )

            integracao_titulo = QLabel(
                "Integração com as revisões"
            )
            integracao_titulo.setObjectName(
                "questionReviewIntegrationTitle"
            )

            integracao_layout.addWidget(
                integracao_titulo
            )

            for item_integracao in integracao:
                percentual = item_integracao.get(
                    "percentual"
                )

                percentual_texto = (
                    f"{percentual:.1f}%"
                    if percentual is not None
                    else "—"
                )

                texto_integracao = QLabel(
                    (
                        f"{item_integracao['disciplina']} › "
                        f"{item_integracao['topico']} • "
                        f"{item_integracao['questoes']} questões • "
                        f"{percentual_texto}\n"
                        f"{item_integracao['descricao']}"
                    )
                )
                texto_integracao.setObjectName(
                    "questionReviewIntegrationText"
                )
                texto_integracao.setWordWrap(
                    True
                )

                integracao_layout.addWidget(
                    texto_integracao
                )

            layout.addWidget(
                integracao_card
            )

        if simulado:
            agrupado_materias = {}

            for registro in registros:
                materia = registro.get(
                    "disciplina",
                    "—"
                )

                dados_materia = (
                    agrupado_materias.setdefault(
                        materia,
                        {
                            "respondidas": 0,
                            "acertos": 0,
                            "erros": 0,
                            "puladas": 0,
                        }
                    )
                )

                status_registro = registro.get(
                    "status"
                )

                if status_registro in (
                    "Correta",
                    "Errada"
                ):
                    dados_materia[
                        "respondidas"
                    ] += 1

                if status_registro == "Correta":
                    dados_materia[
                        "acertos"
                    ] += 1
                elif status_registro == "Errada":
                    dados_materia[
                        "erros"
                    ] += 1
                elif status_registro == "Pulada":
                    dados_materia[
                        "puladas"
                    ] += 1

            materias_titulo = QLabel(
                "Desempenho por matéria"
            )
            materias_titulo.setObjectName(
                "mockExamResultSectionTitle"
            )

            tabela_materias = QTableWidget()
            tabela_materias.setObjectName(
                "mockExamResultByDiscipline"
            )
            tabela_materias.setColumnCount(
                6
            )
            tabela_materias.setHorizontalHeaderLabels([
                "Matéria",
                "Respondidas",
                "Acertos",
                "Erros",
                "Puladas",
                "Desempenho"
            ])
            tabela_materias.setEditTriggers(
                QAbstractItemView.NoEditTriggers
            )
            tabela_materias.setSelectionMode(
                QAbstractItemView.NoSelection
            )
            tabela_materias.setShowGrid(
                False
            )
            tabela_materias.verticalHeader().setVisible(
                False
            )
            tabela_materias.setHorizontalScrollBarPolicy(
                Qt.ScrollBarAlwaysOff
            )

            materias_ordenadas = sorted(
                agrupado_materias.items(),
                key=lambda par: (
                    par[0].lower()
                )
            )

            tabela_materias.setRowCount(
                len(
                    materias_ordenadas
                )
            )

            header_materias = (
                tabela_materias.horizontalHeader()
            )
            header_materias.setSectionResizeMode(
                0,
                QHeaderView.Stretch
            )

            for coluna in range(
                1,
                6
            ):
                header_materias.setSectionResizeMode(
                    coluna,
                    QHeaderView.ResizeToContents
                )

            for linha, (
                materia,
                dados_materia
            ) in enumerate(
                materias_ordenadas
            ):
                respondidas = dados_materia[
                    "respondidas"
                ]
                acertos_materia = dados_materia[
                    "acertos"
                ]

                desempenho_materia = (
                    100.0
                    * acertos_materia
                    / respondidas
                    if respondidas > 0
                    else None
                )

                valores_materia = [
                    materia,
                    str(
                        respondidas
                    ),
                    str(
                        acertos_materia
                    ),
                    str(
                        dados_materia[
                            "erros"
                        ]
                    ),
                    str(
                        dados_materia[
                            "puladas"
                        ]
                    ),
                    (
                        f"{desempenho_materia:.1f}%"
                        if desempenho_materia
                        is not None
                        else "—"
                    ),
                ]

                for coluna, valor in enumerate(
                    valores_materia
                ):
                    celula = QTableWidgetItem(
                        valor
                    )

                    if coluna > 0:
                        celula.setTextAlignment(
                            Qt.AlignCenter
                        )

                    tabela_materias.setItem(
                        linha,
                        coluna,
                        celula
                    )

                tabela_materias.setRowHeight(
                    linha,
                    29
                )

            tabela_materias.setFixedHeight(
                min(
                    190,
                    max(
                        82,
                        34
                        + len(
                            materias_ordenadas
                        )
                        * 30
                    )
                )
            )

            layout.addWidget(
                materias_titulo
            )
            layout.addWidget(
                tabela_materias
            )

        if simulado and simulado.get("analise_v2"):
            analise_v2 = dict(simulado.get("analise_v2") or {})

            estrategia_rotulo = {
                "prova_real": "Prova real",
                "equilibrado": "Equilibrado",
                "estrategico": "Estratégico",
            }.get(
                simulado.get("estrategia_simulado"),
                simulado.get("tipo_simulado", "Simulado")
            )

            estrategia_info = QLabel(
                f"Simulado Inteligente V2 • modo {estrategia_rotulo}"
            )
            estrategia_info.setObjectName("mockExamResultSectionTitle")
            layout.addWidget(estrategia_info)

            # Desempenho por dificuldade.
            dificuldade_titulo = QLabel("Desempenho por dificuldade")
            dificuldade_titulo.setObjectName("mockExamResultSectionTitle")
            tabela_dificuldade = QTableWidget()
            tabela_dificuldade.setObjectName("mockExamResultByDiscipline")
            tabela_dificuldade.setColumnCount(6)
            tabela_dificuldade.setHorizontalHeaderLabels([
                "Dificuldade", "Respondidas", "Acertos", "Erros", "Puladas", "Desempenho"
            ])
            tabela_dificuldade.setEditTriggers(QAbstractItemView.NoEditTriggers)
            tabela_dificuldade.setSelectionMode(QAbstractItemView.NoSelection)
            tabela_dificuldade.setShowGrid(False)
            tabela_dificuldade.verticalHeader().setVisible(False)
            tabela_dificuldade.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)

            dados_dificuldade = analise_v2.get("por_dificuldade", {})
            linhas_dificuldade = [
                (rotulo, dados_dificuldade.get(rotulo, {}))
                for rotulo in ("Fácil", "Média", "Difícil", "Não informada")
                if int(dados_dificuldade.get(rotulo, {}).get("total", 0) or 0) > 0
            ]
            tabela_dificuldade.setRowCount(len(linhas_dificuldade))
            hd = tabela_dificuldade.horizontalHeader()
            hd.setSectionResizeMode(0, QHeaderView.Stretch)
            for coluna in range(1, 6):
                hd.setSectionResizeMode(coluna, QHeaderView.ResizeToContents)

            for linha, (rotulo, dados) in enumerate(linhas_dificuldade):
                percentual = dados.get("desempenho")
                valores = [
                    rotulo,
                    str(int(dados.get("respondidas", 0) or 0)),
                    str(int(dados.get("acertos", 0) or 0)),
                    str(int(dados.get("erros", 0) or 0)),
                    str(int(dados.get("puladas", 0) or 0)),
                    f"{float(percentual):.1f}%" if percentual is not None else "—",
                ]
                for coluna, valor in enumerate(valores):
                    item = QTableWidgetItem(valor)
                    if coluna > 0:
                        item.setTextAlignment(Qt.AlignCenter)
                    tabela_dificuldade.setItem(linha, coluna, item)
                tabela_dificuldade.setRowHeight(linha, 29)

            tabela_dificuldade.setFixedHeight(
                min(168, max(70, 34 + len(linhas_dificuldade) * 30))
            )
            layout.addWidget(dificuldade_titulo)
            layout.addWidget(tabela_dificuldade)

            # Erros novos x recorrentes x recuperados.
            erros_analise = dict(analise_v2.get("erros", {}) or {})
            erros_card = QFrame()
            erros_card.setObjectName("effectivenessImpactCard")
            erros_layout = QVBoxLayout(erros_card)
            erros_layout.setContentsMargins(12, 9, 12, 9)
            erros_layout.setSpacing(6)
            erros_titulo = QLabel("Leitura dos erros")
            erros_titulo.setObjectName("effectivenessImpactTitle")
            erros_metricas = QHBoxLayout()
            erros_metricas.setSpacing(8)

            for rotulo, chave in (
                ("Erros novos", "novos"),
                ("Erros recorrentes", "recorrentes"),
                ("Erros recuperados", "recuperados"),
            ):
                frame = QFrame()
                frame.setObjectName("effectivenessImpactMetric")
                fl = QVBoxLayout(frame)
                fl.setContentsMargins(9, 5, 9, 5)
                fl.setSpacing(1)
                lab = QLabel(rotulo)
                lab.setObjectName("effectivenessImpactLabel")
                val = QLabel(str(int(erros_analise.get(chave, 0) or 0)))
                val.setObjectName("effectivenessImpactValue")
                fl.addWidget(lab)
                fl.addWidget(val)
                erros_metricas.addWidget(frame, 1)

            erros_layout.addWidget(erros_titulo)
            erros_layout.addLayout(erros_metricas)
            layout.addWidget(erros_card)

            # Validação do Índice de Domínio.
            validacao = dict(analise_v2.get("validacao_dominio", {}) or {})
            validacao_card = QFrame()
            validacao_card.setObjectName("adaptiveSummaryCard")
            validacao_layout = QVBoxLayout(validacao_card)
            validacao_layout.setContentsMargins(12, 9, 12, 9)
            validacao_layout.setSpacing(5)
            validacao_titulo = QLabel("Validação do domínio pelo simulado")
            validacao_titulo.setObjectName("adaptiveSummaryTitle")
            validacao_resumo = QLabel(
                " • ".join([
                    f"Confirmados: {int(validacao.get('confirmado', 0) or 0)}",
                    f"Superestimados: {int(validacao.get('superestimado', 0) or 0)}",
                    f"Em recuperação: {int(validacao.get('recuperacao', 0) or 0)}",
                    f"Pioraram: {int(validacao.get('piorou', 0) or 0)}",
                    f"Amostra insuficiente: {int(validacao.get('insuficiente', 0) or 0)}",
                ])
            )
            validacao_resumo.setObjectName("adaptiveSummaryText")
            validacao_resumo.setWordWrap(True)
            validacao_layout.addWidget(validacao_titulo)
            validacao_layout.addWidget(validacao_resumo)

            topicos_analise = list(analise_v2.get("topicos", []) or [])
            destaques = []
            rotulos_categoria = {
                "confirmado": "confirmou domínio",
                "superestimado": "domínio possivelmente superestimado",
                "recuperacao": "em recuperação",
                "piorou": "ponto de atenção",
            }
            for item in topicos_analise:
                categoria = item.get("categoria")
                if categoria not in rotulos_categoria:
                    continue
                desempenho_topico = item.get("desempenho")
                desempenho_texto = (
                    f"{float(desempenho_topico):.0f}%"
                    if desempenho_topico is not None else "—"
                )
                destaques.append(
                    f"{item.get('disciplina', '—')} › {item.get('topico', '—')}: "
                    f"{rotulos_categoria[categoria]} • {desempenho_texto} no simulado • "
                    f"domínio {float(item.get('dominio_antes', 0.0)):.0f} → "
                    f"{float(item.get('dominio_depois', 0.0)):.0f}"
                )

            if destaques:
                detalhe_validacao = QLabel("\n".join(destaques[:8]))
                detalhe_validacao.setObjectName("adaptiveSummaryText")
                detalhe_validacao.setWordWrap(True)
                validacao_layout.addWidget(detalhe_validacao)

            nota_validacao = QLabel(
                "A validação por tópico exige pelo menos 3 respostas no tópico; "
                "amostras menores ficam como evidência insuficiente."
            )
            nota_validacao.setObjectName("questionSessionSummaryDetail")
            nota_validacao.setWordWrap(True)
            validacao_layout.addWidget(nota_validacao)
            layout.addWidget(validacao_card)

        if simulado:
            correcao_aviso = QLabel(
                (
                    "Correção do simulado • o gabarito foi ocultado durante "
                    "a prova e liberado somente após a entrega. "
                    "Os resultados alimentam Histórico, Caderno de Erros, "
                    "Índice de Domínio e Efetividade; a agenda de revisões "
                    "não foi alterada automaticamente."
                )
            )
            correcao_aviso.setObjectName(
                "mockExamCorrectionNotice"
            )
            correcao_aviso.setWordWrap(
                True
            )
            layout.addWidget(
                correcao_aviso
            )

        tabela = QTableWidget()
        tabela.setObjectName(
            "questionSessionSummaryTable"
        )
        tabela.setColumnCount(
            7
            if simulado
            else 5
        )
        tabela.setHorizontalHeaderLabels(
            (
                [
                    "#",
                    "Resultado",
                    "Disciplina",
                    "Tópico",
                    "Marcada",
                    "Gabarito",
                    "Dúvida"
                ]
                if simulado
                else [
                    "#",
                    "Resultado",
                    "Disciplina",
                    "Tópico",
                    "Dúvida"
                ]
            )
        )
        tabela.setEditTriggers(
            QAbstractItemView.NoEditTriggers
        )
        tabela.setSelectionMode(
            QAbstractItemView.NoSelection
        )
        tabela.verticalHeader().setVisible(
            False
        )
        tabela.setShowGrid(
            False
        )
        tabela.setRowCount(
            len(
                registros
            )
        )

        header = tabela.horizontalHeader()
        header.setSectionResizeMode(
            0,
            QHeaderView.ResizeToContents
        )
        header.setSectionResizeMode(
            1,
            QHeaderView.ResizeToContents
        )
        header.setSectionResizeMode(
            2,
            QHeaderView.ResizeToContents
        )
        header.setSectionResizeMode(
            3,
            QHeaderView.Stretch
        )
        header.setSectionResizeMode(
            4,
            QHeaderView.ResizeToContents
        )

        if simulado:
            header.setSectionResizeMode(
                5,
                QHeaderView.ResizeToContents
            )
            header.setSectionResizeMode(
                6,
                QHeaderView.ResizeToContents
            )

        for linha, registro in enumerate(
            registros
        ):
            if simulado:
                valores_linha = [
                    str(
                        linha + 1
                    ),
                    registro.get(
                        "status",
                        "—"
                    ),
                    registro.get(
                        "disciplina",
                        "—"
                    ),
                    registro.get(
                        "topico",
                        "—"
                    ),
                    (
                        registro.get(
                            "marcada"
                        )
                        or "—"
                    ),
                    (
                        registro.get(
                            "gabarito"
                        )
                        or "—"
                    ),
                    (
                        "Sim"
                        if registro.get(
                            "duvida"
                        )
                        else "Não"
                    ),
                ]
            else:
                valores_linha = [
                    str(
                        linha + 1
                    ),
                    registro.get(
                        "status",
                        "—"
                    ),
                    registro.get(
                        "disciplina",
                        "—"
                    ),
                    registro.get(
                        "topico",
                        "—"
                    ),
                    (
                        "Sim"
                        if registro.get(
                            "duvida"
                        )
                        else "Não"
                    ),
                ]

            for coluna, valor in enumerate(
                valores_linha
            ):
                item = QTableWidgetItem(
                    valor
                )

                if coluna in (
                    (
                        0,
                        1,
                        4,
                        5,
                        6
                    )
                    if simulado
                    else (
                        0,
                        1,
                        4
                    )
                ):
                    item.setTextAlignment(
                        Qt.AlignCenter
                    )

                if coluna == 1:
                    if valor == "Correta":
                        aplicar_destaque_tabela(
                            item,
                            "sucesso",
                            True
                        )
                    elif valor == "Errada":
                        aplicar_destaque_tabela(
                            item,
                            "perigo",
                            True
                        )
                    elif valor == "Pulada":
                        aplicar_destaque_tabela(
                            item,
                            "atencao",
                            True
                        )

                tabela.setItem(
                    linha,
                    coluna,
                    item
                )

            tabela.setRowHeight(
                linha,
                31
            )

        tabela.setVisible(
            not self.fluxo_algoritmo
            and not banco_erros_sem_impacto
        )
        layout.addWidget(
            tabela,
            1
        )

        if not self.fluxo_algoritmo:
            fechar = QDialogButtonBox(
                QDialogButtonBox.Close
            )
            fechar.button(
                QDialogButtonBox.Close
            ).setText(
                "Voltar ao Banco de Erros"
                if banco_erros_sem_impacto
                else "Voltar ao resumo da bateria"
                if reforco_sem_impacto
                else "Voltar ao banco de questões"
            )
            fechar.rejected.connect(
                self.reject
            )
            fechar.clicked.connect(
                self.accept
            )

            layout.addWidget(
                fechar
            )


    def continuar_pelo_algoritmo(self):
        self.proxima_acao = "continuar_algoritmo"
        self.accept()

    def voltar_ao_dashboard(self):
        self.proxima_acao = "dashboard"
        self.accept()

    def ir_para_banco_questoes(self):
        self.proxima_acao = "banco_questoes"
        self.accept()

    def revisar_toda_bateria(self):
        if not self.fila_original:
            QMessageBox.information(
                self,
                "Revisar bateria",
                "Não há questões disponíveis para revisão nesta sessão.",
            )
            return
        JanelaRevisaoBateria(
            self.fila_original,
            self.registros_bateria,
            self,
        ).exec()

    def refazer_questoes_erradas(self):
        ids_erradas = {
            int(item.get("questao_id"))
            for item in self.registros_bateria
            if item.get("status") == "Errada" and item.get("questao_id") is not None
        }
        fila_erros = [
            item
            for item in self.fila_original
            if item.get("id") is not None and int(item.get("id")) in ids_erradas
        ]
        if not fila_erros:
            QMessageBox.information(
                self,
                "Reforço imediato",
                "Não há questões erradas para refazer nesta bateria.",
            )
            return

        configuracao = dict(self.configuracao_original or {})
        configuracao.update({
            "fila": fila_erros,
            "modo": "Reforço imediato — questões erradas",
            "origem_sessao": "reforco_pos_bateria",
            "sem_impacto_inteligencia": True,
            "modo_simulado": False,
            "feedback_imediato": True,
            "integrar_revisoes": False,
            "tempo_limite_minutos": 0,
            "estrategia_adaptativa": None,
        })
        if not configuracao.get("concurso_id"):
            configuracao["concurso_id"] = self.configuracao_original.get("concurso_id")
        if not configuracao.get("concurso_nome"):
            configuracao["concurso_nome"] = self.configuracao_original.get("concurso_nome", "VighnaStudy")

        janela = JanelaResolverQuestoes(configuracao, self)
        janela.exec_nao_modal()


def _origem_sessao_unificada(configuracao):
    """Converte os modos visuais em códigos estáveis para a telemetria."""
    configuracao = dict(configuracao or {})
    explicita = str(configuracao.get("origem_sessao") or "").strip().lower()
    if explicita:
        return explicita

    modo = str(configuracao.get("modo") or "").strip()
    chave = unicodedata.normalize("NFKD", modo).encode("ascii", "ignore").decode("ascii").lower()

    if configuracao.get("modo_simulado") or "simulado" in chave:
        return "simulado"
    if configuracao.get("estrategia_adaptativa") or "treino adaptativo" in chave:
        return "treino_adaptativo"
    if "motor v5" in chave:
        return "algoritmo_v5"
    if "revisao inteligente" in chave:
        return "revisao_inteligente"
    if chave.startswith("foco") or chave.startswith("pos-foco"):
        return "foco"
    if "historico" in chave:
        return "historico"
    if chave == "sessao inteligente":
        return "topico"
    return "manual"


def _contexto_sessao_unificada(configuracao):
    """Extrai apenas metadados de montagem; a fila é congelada em tabela própria."""
    configuracao = dict(configuracao or {})
    chaves = (
        "concurso_nome", "disciplina_id", "disciplina_nome",
        "topico_id", "topico_nome", "modo", "quantidade",
        "perfil_inteligente", "composicao_inteligente",
        "estrategia_adaptativa", "modo_simulado", "tipo_simulado",
        "versao_simulado", "estrategia_simulado", "tempo_limite_minutos",
        "preferir_ineditas",
        "ciclo_questoes_id", "ciclo_questoes_modo",
    )
    return {chave: configuracao.get(chave) for chave in chaves if chave in configuracao}


class JanelaBancoErros(QDialog):
    """Seletor da fila operacional de erros do perfil ativo."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.janela_principal = parent
        self.concurso = obter_concurso_ativo()
        self.itens = []
        self.itens_filtrados = []

        self.setWindowTitle("Banco de Erros")
        self.resize(900, 650)
        self.setMinimumSize(760, 560)

        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(18, 16, 18, 16)
        raiz.setSpacing(10)

        cabecalho = QHBoxLayout()
        titulos = QVBoxLayout()
        titulos.setSpacing(2)
        titulo = QLabel("BANCO DE ERROS")
        titulo.setObjectName("pageTitle")
        subtitulo = QLabel(
            "Treino livre — não altera Domínio, revisões ou recomendações"
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        titulos.addWidget(titulo)
        titulos.addWidget(subtitulo)
        perfil = QLabel(f"Perfil: {self.concurso[1]}")
        perfil.setObjectName("profileBadge")
        cabecalho.addLayout(titulos, 1)
        cabecalho.addWidget(perfil, 0, Qt.AlignVCenter)
        raiz.addLayout(cabecalho)

        self.contador = QLabel("0 questões pendentes")
        self.contador.setObjectName("filterCount")
        raiz.addWidget(self.contador)

        filtros_card = QFrame()
        filtros_card.setObjectName("questionHistoryFilterCard")
        filtros = QGridLayout(filtros_card)
        filtros.setContentsMargins(12, 10, 12, 10)
        filtros.setHorizontalSpacing(8)
        filtros.setVerticalSpacing(5)

        self.filtro_disciplina = QComboBox()
        self.filtro_titulo = QComboBox()
        self.filtro_capitulo = QComboBox()
        self.filtro_formato = QComboBox()
        self.filtro_quantidade = QComboBox()
        self.filtro_formato.addItem("Todos", None)
        self.filtro_formato.addItem("Múltipla escolha", "MULTIPLA_ESCOLHA")
        self.filtro_formato.addItem("Certo / Errado", "CERTO_ERRADO")
        for texto, valor in (("10", 10), ("20", 20), ("30", 30), ("50", 50), ("Todas", None)):
            self.filtro_quantidade.addItem(texto, valor)

        campos = (
            ("Disciplina", self.filtro_disciplina),
            ("Título / tópico", self.filtro_titulo),
            ("Capítulo", self.filtro_capitulo),
            ("Formato da questão", self.filtro_formato),
            ("Quantidade", self.filtro_quantidade),
        )
        for indice, (rotulo_texto, campo) in enumerate(campos):
            rotulo = QLabel(rotulo_texto)
            rotulo.setObjectName("miniStatLabel")
            campo.setMinimumHeight(34)
            filtros.addWidget(rotulo, 0, indice)
            filtros.addWidget(campo, 1, indice)
            filtros.setColumnStretch(indice, 1)
        raiz.addWidget(filtros_card)

        distribuicao_card = QFrame()
        distribuicao_card.setObjectName("errorBankDistributionCard")
        distribuicao_layout = QVBoxLayout(distribuicao_card)
        distribuicao_layout.setContentsMargins(12, 9, 12, 9)
        distribuicao_layout.setSpacing(4)
        distribuicao_titulo = QLabel("Pendências por disciplina")
        distribuicao_titulo.setObjectName("miniStatLabel")
        self.distribuicao = QLabel("—")
        self.distribuicao.setObjectName("errorBankDistributionDetail")
        self.distribuicao.setWordWrap(True)
        distribuicao_layout.addWidget(distribuicao_titulo)
        distribuicao_layout.addWidget(self.distribuicao)
        raiz.addWidget(distribuicao_card)

        explicacao = QLabel(
            "Acertou: sai da fila. Errou ou não respondeu: permanece pendente. "
            "As respostas desta tela não entram no histórico acadêmico."
        )
        explicacao.setObjectName("errorBankExplanation")
        explicacao.setWordWrap(True)
        raiz.addWidget(explicacao)
        raiz.addStretch(1)

        botoes = QHBoxLayout()
        fechar = QPushButton("Fechar")
        fechar.setObjectName("subtleButton")
        fechar.setMinimumHeight(40)
        fechar.clicked.connect(self.reject)
        self.botao_praticar = QPushButton("↻  PRATICAR ERROS")
        self.botao_praticar.setObjectName("primaryButton")
        self.botao_praticar.setMinimumHeight(42)
        self.botao_praticar.setMinimumWidth(220)
        self.botao_praticar.clicked.connect(self.praticar)
        botoes.addStretch(1)
        botoes.addWidget(fechar)
        botoes.addWidget(self.botao_praticar)
        raiz.addLayout(botoes)

        self.filtro_disciplina.currentIndexChanged.connect(
            self.atualizar_titulos
        )
        self.filtro_titulo.currentIndexChanged.connect(
            self.atualizar_capitulos
        )
        self.filtro_capitulo.currentIndexChanged.connect(self.aplicar_filtros)
        self.filtro_formato.currentIndexChanged.connect(self.aplicar_filtros)
        self.filtro_quantidade.currentIndexChanged.connect(self.aplicar_filtros)

        self.carregar_dados()

    def carregar_dados(self):
        self.itens = listar_banco_erros_pendentes(self.concurso[0])
        self.filtro_disciplina.blockSignals(True)
        self.filtro_disciplina.clear()
        self.filtro_disciplina.addItem("Todas as disciplinas", None)
        disciplinas = sorted(
            {(item["disciplina_id"], item["disciplina"]) for item in self.itens},
            key=lambda item: item[1].lower(),
        )
        for disciplina_id, nome in disciplinas:
            self.filtro_disciplina.addItem(nome, disciplina_id)
        self.filtro_disciplina.blockSignals(False)
        self.atualizar_titulos()

    def atualizar_titulos(self):
        disciplina_id = self.filtro_disciplina.currentData()
        candidatos = [
            item for item in self.itens
            if disciplina_id is None or item["disciplina_id"] == disciplina_id
        ]
        self.filtro_titulo.blockSignals(True)
        self.filtro_titulo.clear()
        self.filtro_titulo.addItem("Todos os títulos / tópicos", None)
        titulos = sorted(
            {(item["topico_id"], item["titulo"]) for item in candidatos},
            key=lambda item: item[1].lower(),
        )
        for topico_id, nome in titulos:
            self.filtro_titulo.addItem(nome, topico_id)
        self.filtro_titulo.blockSignals(False)
        self.atualizar_capitulos()

    def atualizar_capitulos(self):
        disciplina_id = self.filtro_disciplina.currentData()
        topico_id = self.filtro_titulo.currentData()
        candidatos = [
            item for item in self.itens
            if (disciplina_id is None or item["disciplina_id"] == disciplina_id)
            and (topico_id is None or item["topico_id"] == topico_id)
        ]
        self.filtro_capitulo.blockSignals(True)
        self.filtro_capitulo.clear()
        self.filtro_capitulo.addItem("Todos os capítulos", None)
        capitulos = sorted(
            {
                (item["capitulo_id"], item["capitulo"])
                for item in candidatos
                if item.get("capitulo_id") is not None and item.get("capitulo")
            },
            key=lambda item: item[1].lower(),
        )
        for capitulo_id, nome in capitulos:
            self.filtro_capitulo.addItem(nome, capitulo_id)
        self.filtro_capitulo.setEnabled(bool(capitulos))
        self.filtro_capitulo.blockSignals(False)
        self.aplicar_filtros()

    def aplicar_filtros(self):
        disciplina_id = self.filtro_disciplina.currentData()
        topico_id = self.filtro_titulo.currentData()
        capitulo_id = self.filtro_capitulo.currentData()
        formato = self.filtro_formato.currentData()
        self.itens_filtrados = [
            item for item in self.itens
            if (disciplina_id is None or item["disciplina_id"] == disciplina_id)
            and (topico_id is None or item["topico_id"] == topico_id)
            and (capitulo_id is None or item.get("capitulo_id") == capitulo_id)
            and (formato is None or item.get("tipo_questao") == formato)
        ]
        total = len(self.itens_filtrados)
        self.contador.setText(
            "1 questão pendente" if total == 1 else f"{total} questões pendentes"
        )
        por_disciplina = {}
        for item in self.itens_filtrados:
            nome = item["disciplina"]
            por_disciplina[nome] = por_disciplina.get(nome, 0) + 1
        linhas = [
            f"{nome}   {quantidade}"
            for nome, quantidade in sorted(
                por_disciplina.items(), key=lambda item: (-item[1], item[0].lower())
            )
        ]
        self.distribuicao.setText("\n".join(linhas) if linhas else "Nenhuma pendência compatível")
        self.botao_praticar.setEnabled(total > 0)

    def praticar(self):
        if not self.itens_filtrados:
            return
        limite = self.filtro_quantidade.currentData()
        fila = list(self.itens_filtrados)
        if limite is not None:
            fila = fila[:int(limite)]
        configuracao = {
            "concurso_id": self.concurso[0],
            "concurso_nome": self.concurso[1],
            "modo": "Banco de Erros",
            "origem_sessao": "banco_erros",
            "quantidade": len(fila),
            "fila": fila,
            "sem_impacto_inteligencia": True,
            "modo_banco_erros": True,
            "modo_simulado": False,
            "feedback_imediato": True,
            "integrar_revisoes": False,
            "tempo_limite_minutos": 0,
            "estrategia_adaptativa": None,
        }
        janela = JanelaResolverQuestoes(configuracao, self)
        janela.exec_nao_modal()
        self.carregar_dados()
        if (
            self.janela_principal is not None
            and hasattr(self.janela_principal, "atualizar_dashboard")
        ):
            self.janela_principal.atualizar_dashboard()


def _notificar_dados_alterados_raiz(widget, escopo="all"):
    """Propaga uma invalidação de dados até a janela principal do Vighna.

    Diálogos operacionais podem estar aninhados (ex.: Tópico -> Resolver).
    Este helper garante que caches de telas já pré-carregadas sejam invalidados
    antes de o controle voltar ao chamador, evitando listas visualmente antigas.
    """
    atual = widget.parentWidget() if widget is not None else None
    while atual is not None:
        metodo = getattr(atual, "notificar_dados_alterados", None)
        if callable(metodo):
            metodo(escopo)
            return True
        atual = atual.parentWidget()

    app = QApplication.instance()
    if app is not None:
        for janela in app.topLevelWidgets():
            metodo = getattr(janela, "notificar_dados_alterados", None)
            if callable(metodo):
                metodo(escopo)
                return True
    return False


class _RotuloContextoB11(QLabel):
    """Uma linha com reticências; conserva o texto original no histórico.

    A leitura de .text() e a restauração dos tooltips continuam devolvendo os
    valores integrais, enquanto a renderização se adapta à largura do Qt.
    """
    def __init__(self, texto="", parent=None):
        super().__init__("", parent)
        self._texto_original_b11 = ""
        self._tooltip_original_b11 = ""
        self.setMinimumWidth(0)
        self.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Preferred)
        self.setWordWrap(False)
        self.setText(texto)

    def text(self):
        return self._texto_original_b11

    def setText(self, texto):
        self._texto_original_b11 = str(texto or "")
        self._atualizar_elipse_b11()
        self._atualizar_tooltip_b11()

    def setToolTip(self, texto):
        self._tooltip_original_b11 = str(texto or "")
        self._atualizar_tooltip_b11()

    def toolTip(self):
        return self._tooltip_original_b11

    def _atualizar_elipse_b11(self):
        largura = max(12, self.contentsRect().width() - 3)
        visivel = self.fontMetrics().elidedText(
            self._texto_original_b11, Qt.ElideRight, largura
        )
        if QLabel.text(self) != visivel:
            QLabel.setText(self, visivel)

    def _atualizar_tooltip_b11(self):
        # O tooltip visual inclui nome integral + metadados prévios; o método
        # toolTip() continua devolvendo os metadados para o histórico existente.
        partes = [self._texto_original_b11]
        if self._tooltip_original_b11:
            partes.append(self._tooltip_original_b11)
        QLabel.setToolTip(self, "\n".join(p for p in partes if p))

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._atualizar_elipse_b11()


class _HaloCursorLeituraNeuralB15(QWidget):
    """Halo local e passivo: nunca recebe mouse, foco ou teclado.

    Renderiza 58x58 px apenas quando a ponta do cursor se move sobre
    rotulos de leitura; nao usa timer nem altera as cores de anotacao.
    """

    def __init__(self, parent):
        super().__init__(parent)
        self.setObjectName("questionReadingCursorHaloB15")
        self._b17_intensidade = 100
        self.setFixedSize(58, 58)
        self.setFocusPolicy(Qt.NoFocus)
        self.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        self.setAttribute(Qt.WA_TranslucentBackground, True)
        self.setAutoFillBackground(False)
        self.hide()

    def seguir(self, posicao):
        destino = posicao - QPoint(self.width() // 2, self.height() // 2)
        if self.pos() != destino:
            self.move(destino)
        if not self.isVisible():
            self.show()
        self.raise_()

    def configurar_b17(self, tamanho, intensidade):
        """Reaproveita o widget e evita pintura quando nada mudou."""
        tamanho = max(32, min(96, int(tamanho)))
        intensidade = max(25, min(150, int(intensidade)))
        diferente = (self.width() != tamanho or
                     self._b17_intensidade != intensidade)
        if not diferente:
            return
        self._b17_intensidade = intensidade
        if self.width() != tamanho:
            # Mantem o centro do halo ao alterar o diametro.
            centro = self.pos() + QPoint(self.width() // 2, self.height() // 2)
            self.setFixedSize(tamanho, tamanho)
            self.move(centro - QPoint(tamanho // 2, tamanho // 2))
        if self.isVisible():
            self.update()

    def paintEvent(self, evento):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing, True)
        # Branco neutro, sem pulso e sem transicao de quadros.
        centro = self.width() / 2.0
        raio = max(1.0, (self.width() - 4) / 2.0)
        escala = self._b17_intensidade / 100.0
        alpha = lambda base: max(0, min(255, round(base * escala)))
        degrad = QRadialGradient(QPointF(centro, centro), raio)
        degrad.setColorAt(0.0, QColor(245, 247, 249, alpha(58)))
        degrad.setColorAt(0.35, QColor(245, 247, 249, alpha(31)))
        degrad.setColorAt(0.72, QColor(245, 247, 249, alpha(9)))
        degrad.setColorAt(1.0, QColor(245, 247, 249, 0))
        painter.setPen(Qt.NoPen)
        painter.setBrush(QBrush(degrad))
        painter.drawEllipse(QRectF(2, 2, self.width() - 4, self.height() - 4))
        # Marca pequena na ponta; dimensao fixa mesmo com halo maior.
        painter.setBrush(Qt.NoBrush)
        painter.setPen(QPen(QColor(247, 249, 251, alpha(120)), 0.9))
        painter.drawEllipse(QRectF(centro - 3, centro - 3, 6, 6))
        painter.end()


class _FaixaLeituraNeuralB16(QWidget):
    """Realce discreto e passivo para a linha sob o cursor.

    Fica sobre a linha com alpha baixo e nao recebe mouse/teclado.
    Sem animacao, sem QTimer, sem alteracao do texto original.
    """

    def __init__(self, parent):
        super().__init__(parent)
        self.setObjectName("questionReadingLineHighlightB16")
        self._b17_intensidade = 100
        self.setFocusPolicy(Qt.NoFocus)
        self.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        self.setAttribute(Qt.WA_TranslucentBackground, True)
        self.setAutoFillBackground(False)
        self.hide()

    def configurar_b17(self, intensidade):
        intensidade = max(25, min(175, int(intensidade)))
        if self._b17_intensidade == intensidade:
            return
        self._b17_intensidade = intensidade
        if self.isVisible():
            self.update()

    def paintEvent(self, evento):
        pintor = QPainter(self)
        pintor.setRenderHint(QPainter.Antialiasing, True)
        gradiente = QLinearGradient(0, 0, max(1, self.width()), 0)
        escala = self._b17_intensidade / 100.0
        alpha = lambda base: max(0, min(255, round(base * escala)))
        gradiente.setColorAt(0.00, QColor(246, 248, 250, alpha(3)))
        gradiente.setColorAt(0.06, QColor(246, 248, 250, alpha(24)))
        gradiente.setColorAt(0.77, QColor(246, 248, 250, alpha(19)))
        gradiente.setColorAt(1.00, QColor(246, 248, 250, alpha(2)))
        pintor.setPen(Qt.NoPen)
        pintor.setBrush(QBrush(gradiente))
        pintor.drawRoundedRect(QRectF(0, 0, self.width(), self.height()), 3, 3)
        pintor.end()


class _NavegacaoNeuralB26(QWidget):
    """B26 R1: fluxo direcional entre cartoes e ativacao breve do destino.

    Toda a animacao e desenhada numa camada transparente ao mouse. A marcação
    real/Enter e o QSS de foco persistente nunca são modificados pelo efeito.
    """

    def __init__(self, parent):
        super().__init__(parent)
        self.setObjectName("questionKeyboardSweepB26")
        self.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        self.setAttribute(Qt.WA_TranslucentBackground, True)
        self.setAttribute(Qt.WA_NoSystemBackground, True)
        self.setFocusPolicy(Qt.NoFocus)
        self._frame = None
        self._anterior = None
        self._direcao = 1
        self._intensidade = 55
        self._progresso = 0.0
        self._monocromatico = False
        self.hide()

    def definir_monocromatico(self, ativo):
        self._monocromatico = bool(ativo)
        if self.isVisible():
            self.update()

    def configurar(self, frame, direcao, intensidade, anterior=None):
        self._frame = frame
        self._anterior = anterior if anterior is not frame else None
        self._direcao = 1 if direcao >= 0 else -1
        self._intensidade = max(0, min(100, int(intensidade)))
        self._progresso = 0.0
        self.setGeometry(self.parentWidget().rect())
        if self._frame is not None and self._intensidade > 0:
            self.raise_()
            self.show()
            self.update()
        else:
            self.limpar()

    def progresso(self, valor):
        self._progresso = max(0.0, min(1.0, float(valor)))
        if self.isVisible():
            self.update()

    def limpar(self):
        self.hide()
        self._frame = None
        self._anterior = None
        self._progresso = 0.0

    def _mapear(self, widget):
        try:
            if widget is None or not widget.isVisible():
                return None
            top = self.mapFromGlobal(widget.mapToGlobal(QPoint(0, 0)))
            bottom = self.mapFromGlobal(widget.mapToGlobal(QPoint(
                max(0, widget.width()-1), max(0, widget.height()-1))))
        except RuntimeError:
            return None
        return QRectF(float(top.x()), float(top.y()),
                      float(bottom.x()-top.x()+1), float(bottom.y()-top.y()+1))

    @staticmethod
    def _b26r1_suavizar(valor):
        t = max(0.0, min(1.0, float(valor)))
        return t*t*(3.0-2.0*t)

    def paintEvent(self, evento):
        frame = self._frame
        if frame is None or self._intensidade <= 0:
            return
        try:
            if not frame.isVisible() or not frame.isEnabled():
                return
        except RuntimeError:
            return
        rect = self._mapear(frame)
        if rect is None or rect.width() < 60 or rect.height() < 23:
            return
        if not rect.intersects(QRectF(self.rect())):
            return

        t = self._progresso
        avancar = self._b26r1_suavizar(t)
        # Luminosidade que cresce rapidamente e se dissolve sem flash seco.
        energia = min(1.0, t/0.17) * max(0.0, (1.0-t)**0.44)
        ganho = 0.32 + 0.68 * (self._intensidade/100.0)
        cinza = self._monocromatico
        cor = (211, 223, 231) if cinza else (69, 221, 245)
        cor_clara = (245, 245, 245) if cinza else (210, 250, 255)
        ouro = (220, 220, 220) if cinza else (177, 232, 244)
        r = rect.adjusted(2.0, 1.9, -2.0, -1.9)
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing, True)

        # 1. Uma passagem estreita de luz acompanha a mudanca de cartao.
        # Limita-se a borda e a zona do marcador, nunca lava o texto inteiro.
        recorte = QPainterPath()
        recorte.addRoundedRect(r, 7.0, 7.0)
        painter.save()
        painter.setClipPath(recorte)
        luz = QLinearGradient(r.left(), r.top(), r.left()+126.0, r.top())
        luz.setColorAt(0.0, QColor(*cor, round(28*ganho*energia)))
        luz.setColorAt(0.35, QColor(*cor, round(16*ganho*energia)))
        luz.setColorAt(1.0, QColor(*cor, 0))
        painter.setPen(Qt.NoPen)
        painter.setBrush(QBrush(luz))
        painter.drawPath(recorte)
        painter.restore()

        # 2. Borda do destino acende e estabiliza; o QSS mantém a selecao
        # depois que este QWidget temporario desaparece.
        painter.setBrush(Qt.NoBrush)
        painter.setPen(QPen(QColor(*cor, round(136*ganho*energia)),
                            1.5+0.85*ganho, Qt.SolidLine, Qt.RoundCap))
        painter.drawRoundedRect(r, 7.0, 7.0)
        painter.setPen(QPen(QColor(*cor, round(47*ganho*energia)), 4.6,
                            Qt.SolidLine, Qt.RoundCap))
        trecho_topo = min(132.0, r.width()*0.27)
        # Asa energetica direcional junto a borda superior/inferior.
        y_asa = r.top()+0.6 if self._direcao > 0 else r.bottom()-0.6
        painter.drawLine(QPointF(r.left()+8.0, y_asa),
                         QPointF(r.left()+trecho_topo, y_asa))
        painter.setPen(QPen(QColor(*cor_clara, round(149*ganho*energia)), 1.05,
                            Qt.SolidLine, Qt.RoundCap))
        painter.drawLine(QPointF(r.left()+8.0, y_asa),
                         QPointF(r.left()+trecho_topo*0.80, y_asa))

        # 3. Pequeno filamento vertical viaja na direcao da seta.
        y_foco = (r.top()+3.0+(r.height()-6.0)*avancar if self._direcao > 0
                  else r.bottom()-3.0-(r.height()-6.0)*avancar)
        comprimento = min(12.5, r.height()*0.30)
        y1 = max(r.top()+2.0, y_foco-comprimento)
        y2 = min(r.bottom()-2.0, y_foco+comprimento)
        x = r.left()+2.0
        if y2 > y1:
            painter.setPen(QPen(QColor(*cor, round(104*ganho*energia)), 7.2,
                                Qt.SolidLine, Qt.RoundCap))
            painter.drawLine(QPointF(x,y1), QPointF(x,y2))
            painter.setPen(QPen(QColor(*cor_clara, round(220*ganho*energia)), 2.25,
                                Qt.SolidLine, Qt.RoundCap))
            painter.drawLine(QPointF(x,y1), QPointF(x,y2))
            painter.setPen(Qt.NoPen)
            painter.setBrush(QColor(*cor_clara, round(207*ganho*energia)))
            painter.drawEllipse(QPointF(x,y_foco), 2.8, 2.8)

        # 4. Quando dois cartoes são adjacentes, uma linha minúscula pula
        # entre as alternativas na margem esquerda (nunca no texto). Para
        # saltos E->A / A->E e scrolls longos, omite a ponte.
        anterior = self._mapear(self._anterior)
        if anterior is not None:
            dy = abs(anterior.center().y()-r.center().y())
            if (dy > r.height()*0.65 and dy < r.height()*2.6
                    and abs(anterior.left()-rect.left()) < 25.0):
                ponte_x = r.left()+2.0
                yi = (anterior.bottom()-2.5 if self._direcao > 0
                      else anterior.top()+2.5)
                yf = (r.top()+2.5 if self._direcao > 0
                      else r.bottom()-2.5)
                y_progresso = yi + (yf-yi)*avancar
                painter.setPen(QPen(QColor(*cor, round(66*ganho*energia)), 5.8,
                                    Qt.SolidLine, Qt.RoundCap))
                painter.drawLine(QPointF(ponte_x, yi), QPointF(ponte_x,y_progresso))
                painter.setPen(QPen(QColor(*cor_clara, round(179*ganho*energia)), 1.45,
                                    Qt.SolidLine, Qt.RoundCap))
                painter.drawLine(QPointF(ponte_x, yi), QPointF(ponte_x,y_progresso))
                painter.setPen(Qt.NoPen)
                painter.setBrush(QColor(*ouro, round(196*ganho*energia)))
                painter.drawEllipse(QPointF(ponte_x,y_progresso), 2.2, 2.2)

        painter.end()

class _FundoIntegralBateriaB26R7(QWidget):
