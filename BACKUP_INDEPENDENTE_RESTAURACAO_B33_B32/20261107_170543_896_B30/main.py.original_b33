        self.carregar()

    def carregar(self):
        dados = listar_conteudos_concurso(
            self.concurso_id
        )

        self.atualizando_arvore = True
        self.arvore.clear()

        for disciplina in dados:
            item_disciplina = QTreeWidgetItem(
                self.arvore
            )

            item_disciplina.setText(
                0,
                disciplina[
                    "disciplina"
                ]
            )

            item_disciplina.setData(
                0,
                Qt.UserRole,
                (
                    "disciplina",
                    disciplina[
                        "disciplina_id"
                    ]
                )
            )

            item_disciplina.setFlags(
                item_disciplina.flags()
                | Qt.ItemIsUserCheckable
            )

            item_disciplina.setCheckState(
                0,
                (
                    Qt.Checked
                    if disciplina[
                        "incluida"
                    ]
                    else Qt.Unchecked
                )
            )

            item_disciplina.setText(
                1,
                "—"
            )

            for topico in disciplina[
                "topicos"
            ]:
                item_topico = QTreeWidgetItem(
                    item_disciplina
                )

                item_topico.setText(
                    0,
                    topico[
                        "topico"
                    ]
                )

                item_topico.setData(
                    0,
                    Qt.UserRole,
                    (
                        "topico",
                        topico[
                            "topico_id"
                        ]
                    )
                )

                item_topico.setFlags(
                    item_topico.flags()
                    | Qt.ItemIsUserCheckable
                )

                item_topico.setCheckState(
                    0,
                    (
                        Qt.Checked
                        if topico[
                            "incluido"
                        ]
                        else Qt.Unchecked
                    )
                )

                importancia = int(
                    topico[
                        "importancia"
                    ]
                )

                item_topico.setData(
                    1,
                    Qt.UserRole,
                    importancia
                )

                item_topico.setText(
                    1,
                    f"{importancia}/5"
                )

                for capitulo in listar_capitulos_topico(
                    topico[
                        "topico_id"
                    ]
                ):
                    item_capitulo = QTreeWidgetItem(
                        item_topico
                    )

                    item_capitulo.setText(
                        0,
                        f"Capítulo: {capitulo[1]}"
                    )
                    item_capitulo.setData(
                        0,
                        Qt.UserRole,
                        (
                            "capitulo",
                            capitulo[0]
                        )
                    )
                    item_capitulo.setText(
                        1,
                        ""
                    )

        self.atualizando_arvore = False
        self.arvore.expandToDepth(
            0
        )
        self.filtrar_conteudos(
            self.busca_conteudos.text()
        )

    @staticmethod
    def normalizar_busca(texto):
        texto = unicodedata.normalize(
            "NFD",
            str(texto or "")
        )
        return "".join(
            caractere
            for caractere in texto
            if unicodedata.category(caractere) != "Mn"
        ).casefold()

    def filtrar_conteudos(
        self,
        texto
    ):
        termo = self.normalizar_busca(
            texto
        )
        possui_filtro = bool(
            termo
        )

        self.atualizando_arvore = True

        try:
            for indice in range(
                self.arvore.topLevelItemCount()
            ):
                disciplina = self.arvore.topLevelItem(
                    indice
                )
                disciplina_corresponde = (
                    termo in self.normalizar_busca(
                        disciplina.text(0)
                    )
                )
                possui_resultado = disciplina_corresponde

                for indice_topico in range(
                    disciplina.childCount()
                ):
                    topico = disciplina.child(
                        indice_topico
                    )
                    topico_corresponde = (
                        termo in self.normalizar_busca(
                            topico.text(0)
                        )
                    )
                    capitulo_corresponde = False

                    for indice_capitulo in range(
                        topico.childCount()
                    ):
                        capitulo = topico.child(
                            indice_capitulo
                        )
                        encontrado = (
                            termo in self.normalizar_busca(
                                capitulo.text(0)
                            )
                        )
                        capitulo_corresponde = (
                            capitulo_corresponde
                            or encontrado
                        )
                        capitulo.setHidden(
                            possui_filtro
                            and not (
                                disciplina_corresponde
                                or topico_corresponde
                                or encontrado
                            )
                        )

                    exibir_topico = (
                        not possui_filtro
                        or disciplina_corresponde
                        or topico_corresponde
                        or capitulo_corresponde
                    )
                    topico.setHidden(
                        not exibir_topico
                    )
                    possui_resultado = (
                        possui_resultado
                        or exibir_topico
                    )

                    if (
                        possui_filtro
                        and (
                            topico_corresponde
                            or capitulo_corresponde
                        )
                    ):
                        topico.setExpanded(
                            True
                        )

                disciplina.setHidden(
                    possui_filtro
                    and not possui_resultado
                )

                if possui_filtro and possui_resultado:
                    disciplina.setExpanded(
                        True
                    )

        finally:
            self.atualizando_arvore = False

    def item_alterado(
        self,
        item,
        coluna
    ):
        if (
            self.atualizando_arvore
            or coluna != 0
        ):
            return

        dados = item.data(
            0,
            Qt.UserRole
        )

        if not dados:
            return

        tipo = dados[0]

        self.atualizando_arvore = True

        try:
            if tipo == "disciplina":
                estado = item.checkState(
                    0
                )

                # Facilita o uso:
                # marcar a matéria inclui todos os seus tópicos;
                # desmarcar retira todos.
                for indice in range(
                    item.childCount()
                ):
                    item.child(
                        indice
                    ).setCheckState(
                        0,
                        estado
                    )

            elif tipo == "topico":
                # Se um tópico for marcado manualmente,
                # garante que a matéria também fique incluída.
                if (
                    item.checkState(0)
                    == Qt.Checked
                    and item.parent() is not None
                    and item.parent().checkState(0)
                    != Qt.Checked
                ):
                    item.parent().setCheckState(
                        0,
                        Qt.Checked
                    )

        finally:
            self.atualizando_arvore = False

    def editar_importancia(
        self,
        item,
        coluna
    ):
        dados = item.data(
            0,
            Qt.UserRole
        )

        if (
            not dados
            or dados[0] != "topico"
        ):
            return

        atual = item.data(
            1,
            Qt.UserRole
        )

        atual = int(
            atual or 3
        )

        opcoes = [
            "1 — Baixa",
            "2 — Menor",
            "3 — Normal",
            "4 — Alta",
            "5 — Muito alta"
        ]

        escolha, confirmou = QInputDialog.getItem(
            self,
            "Importância no concurso",
            (
                f"{item.text(0)}\n\n"
                f"Perfil: {self.concurso_nome}"
            ),
            opcoes,
            atual - 1,
            False
        )

        if not confirmou:
            return

        importancia = int(
            escolha.split(
                "—"
            )[0].strip()
        )

        item.setData(
            1,
            Qt.UserRole,
            importancia
        )

        item.setText(
            1,
            f"{importancia}/5"
        )

    def definir_todos(
        self,
        estado
    ):
        self.atualizando_arvore = True

        try:
            for indice in range(
                self.arvore.topLevelItemCount()
            ):
                disciplina = (
                    self.arvore.topLevelItem(
                        indice
                    )
                )

                disciplina.setCheckState(
                    0,
                    estado
                )

                for filho in range(
                    disciplina.childCount()
                ):
                    disciplina.child(
                        filho
                    ).setCheckState(
                        0,
                        estado
                    )

        finally:
            self.atualizando_arvore = False

    def salvar(self):
        disciplinas = []
        topicos = []

        for indice in range(
            self.arvore.topLevelItemCount()
        ):
            disciplina = (
                self.arvore.topLevelItem(
                    indice
                )
            )

            dados_disciplina = (
                disciplina.data(
                    0,
                    Qt.UserRole
                )
            )

            disciplina_id = (
                dados_disciplina[1]
            )

            incluida = (
                disciplina.checkState(0)
                == Qt.Checked
            )

            disciplinas.append(
                (
                    disciplina_id,
                    incluida
                )
            )

            for filho in range(
                disciplina.childCount()
            ):
                topico = disciplina.child(
                    filho
                )

                dados_topico = topico.data(
                    0,
                    Qt.UserRole
                )

                topico_id = (
                    dados_topico[1]
                )

                incluido = (
                    topico.checkState(0)
                    == Qt.Checked
                )

                importancia = int(
                    topico.data(
                        1,
                        Qt.UserRole
                    )
                    or 3
                )

                topicos.append(
                    (
                        topico_id,
                        incluido,
                        importancia
                    )
                )

        if salvar_conteudos_concurso(
            self.concurso_id,
            disciplinas,
            topicos
        ):
            self.accept()
        else:
            QMessageBox.critical(
                self,
                "Falha ao salvar",
                "Não foi possível salvar as associações deste perfil."
            )


class JanelaConcursos(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)

        self.setWindowTitle(
            "Perfis de concurso"
        )
        self.resize(
            680,
            480
        )

        layout = QVBoxLayout(
            self
        )

        titulo = QLabel(
            "Perfis de concurso"
        )
        titulo.setObjectName(
            "pageTitle"
        )
        layout.addWidget(
            titulo
        )

        explicacao = QLabel(
            "Cada perfil controla quais matérias e tópicos pertencem "
            "ao concurso e também a importância 1–5 de cada tópico. "
            "O perfil Padrão preserva o conteúdo que já existia."
        )
        explicacao.setWordWrap(
            True
        )
        layout.addWidget(
            explicacao
        )

        self.tabela = QTableWidget()
        self.tabela.setColumnCount(
            3
        )
        self.tabela.setHorizontalHeaderLabels([
            "Perfil",
            "Situação",
            "Conteúdo incluído"
        ])

        self.tabela.setSelectionBehavior(
            QAbstractItemView.SelectRows
        )
        self.tabela.setSelectionMode(
            QAbstractItemView.SingleSelection
        )
        self.tabela.setEditTriggers(
            QAbstractItemView.NoEditTriggers
        )

        self.tabela.horizontalHeader().setSectionResizeMode(
            0,
            QHeaderView.Stretch
        )
        self.tabela.horizontalHeader().setSectionResizeMode(
            1,
            QHeaderView.ResizeToContents
        )
        self.tabela.horizontalHeader().setSectionResizeMode(
            2,
            QHeaderView.ResizeToContents
        )

        layout.addWidget(
            self.tabela,
            1
        )

        botoes = QHBoxLayout()

        novo = QPushButton(
            "+ Novo perfil"
        )
        novo.clicked.connect(
            self.novo_perfil
        )

        duplicar = QPushButton(
            "Duplicar selecionado"
        )
        duplicar.clicked.connect(
            self.duplicar_perfil
        )

        conteudos = QPushButton(
            "Conteúdos do perfil"
        )
        conteudos.clicked.connect(
            self.editar_conteudos
        )

        renomear = QPushButton(
            "Renomear"
        )
        renomear.clicked.connect(
            self.renomear_perfil
        )

        excluir = QPushButton(
            "Excluir"
        )
        excluir.clicked.connect(
            self.excluir_perfil
        )

        usar = QPushButton(
            "Usar selecionado"
        )
        usar.clicked.connect(
            self.usar_perfil
        )

        fechar = QPushButton(
            "Fechar"
        )
        fechar.clicked.connect(
            self.accept
        )

        botoes.addWidget(
            novo
        )
        botoes.addWidget(
            duplicar
        )
        botoes.addWidget(
            conteudos
        )
        botoes.addWidget(
            renomear
        )
        botoes.addWidget(
            excluir
        )
        botoes.addStretch()
        botoes.addWidget(
            usar
        )
        botoes.addWidget(
            fechar
        )

        layout.addLayout(
            botoes
        )

        self.carregar()

    def carregar(self):
        concursos = listar_concursos()
        ativo_id = obter_concurso_ativo()[0]

        self.tabela.setRowCount(
            len(concursos)
        )

        for linha, concurso in enumerate(
            concursos
        ):
            concurso_id = concurso[0]
            nome = concurso[1]
            e_padrao = bool(
                concurso[2]
            )

            situacoes = []

            if concurso_id == ativo_id:
                situacoes.append(
                    "ATIVO"
                )

            if e_padrao:
                situacoes.append(
                    "PADRÃO"
                )

            situacao = (
                " • ".join(
                    situacoes
                )
                if situacoes
                else "—"
            )

            item_nome = QTableWidgetItem(
                nome
            )
            item_nome.setData(
                Qt.UserRole,
                concurso_id
            )
            item_nome.setData(
                Qt.UserRole + 1,
                e_padrao
            )

            self.tabela.setItem(
                linha,
                0,
                item_nome
            )

            self.tabela.setItem(
                linha,
                1,
                QTableWidgetItem(
                    situacao
                )
            )

            qtd_disciplinas, qtd_topicos = (
                contar_conteudos_concurso(
                    concurso_id
                )
            )

            self.tabela.setItem(
                linha,
                2,
                QTableWidgetItem(
                    (
                        f"{qtd_disciplinas} matéria(s) • "
                        f"{qtd_topicos} tópico(s)"
                    )
                )
            )

    def selecionado(self):
        linha = self.tabela.currentRow()

        if linha < 0:
            return (
                None,
                None,
                False
            )

        item = self.tabela.item(
            linha,
            0
        )

        if item is None:
            return (
                None,
                None,
                False
            )

        return (
            item.data(
                Qt.UserRole
            ),
            item.text(),
            bool(
                item.data(
                    Qt.UserRole + 1
                )
            )
        )

    def novo_perfil(self):
        nome, confirmou = (
            QInputDialog.getText(
                self,
                "Novo perfil de concurso",
                (
                    "Nome do concurso ou perfil:\n"
                    "Ex.: GCM Toledo"
                )
            )
        )

        if not confirmou:
            return

        nome = nome.strip()

        if not nome:
            return

        novo_id = adicionar_concurso(
            nome
        )

        if novo_id is None:
            QMessageBox.information(
                self,
                "Perfil não criado",
                (
                    "Já existe um perfil com esse nome "
                    "ou o nome informado é inválido."
                )
            )
            return

        self.carregar()

        janela = JanelaConteudosConcurso(
            novo_id,
            nome,
            self
        )
        janela.exec()

        self.carregar()

    def duplicar_perfil(self):
        concurso_id, nome, _ = (
            self.selecionado()
        )

        if concurso_id is None:
            QMessageBox.information(
                self,
                "Selecione um perfil",
                "Selecione primeiro o perfil que deseja duplicar."
            )
            return

        novo_nome, confirmou = (
            QInputDialog.getText(
                self,
                "Duplicar perfil",
                (
                    f"Copiar conteúdos e pesos de:\n"
                    f"{nome}\n\n"
                    "Nome do novo perfil:"
                ),
                text=f"{nome} - cópia"
            )
        )

        if not confirmou:
            return

        novo_nome = (
            novo_nome.strip()
        )

        if not novo_nome:
            return

        novo_id = duplicar_concurso(
            concurso_id,
            novo_nome
        )

        if novo_id is None:
            QMessageBox.information(
                self,
                "Perfil não duplicado",
                "Já existe um perfil com esse nome."
            )
            return

        self.carregar()

    def editar_conteudos(self):
        concurso_id, nome, _ = (
            self.selecionado()
        )

        if concurso_id is None:
            QMessageBox.information(
                self,
                "Selecione um perfil",
                (
                    "Selecione primeiro o perfil "
                    "que deseja configurar."
                )
            )
            return

        janela = JanelaConteudosConcurso(
            concurso_id,
            nome,
            self
        )

        janela.exec()
        self.carregar()

    def renomear_perfil(self):
        concurso_id, nome, e_padrao = (
            self.selecionado()
        )

        if concurso_id is None:
            QMessageBox.information(
                self,
                "Selecione um perfil",
                "Selecione primeiro o perfil que deseja renomear."
            )
            return

        if e_padrao:
            QMessageBox.information(
                self,
                "Perfil Padrão",
                (
                    "O perfil Padrão é reservado pelo sistema "
                    "e não pode ser renomeado."
                )
            )
            return

        novo_nome, confirmou = (
            QInputDialog.getText(
                self,
                "Renomear perfil",
                "Novo nome:",
                text=nome
            )
        )

        if not confirmou:
            return

        if not renomear_concurso(
            concurso_id,
            novo_nome
        ):
            QMessageBox.information(
                self,
                "Não foi possível renomear",
                (
                    "Verifique se o nome está preenchido "
                    "e se não existe outro perfil igual."
                )
            )
            return

        self.carregar()

    def excluir_perfil(self):
        concurso_id, nome, e_padrao = (
            self.selecionado()
        )

        if concurso_id is None:
            QMessageBox.information(
                self,
                "Selecione um perfil",
                "Selecione primeiro o perfil que deseja excluir."
            )
            return

        if e_padrao:
            QMessageBox.information(
                self,
                "Perfil Padrão",
                (
                    "O perfil Padrão não pode ser excluído. "
                    "Ele funciona como perfil de segurança."
                )
            )
            return

        resposta = QMessageBox.question(
            self,
            "Excluir perfil",
            (
                f"Excluir o perfil '{nome}'?\n\n"
                "Os tópicos e revisões NÃO serão excluídos. "
                "Serão removidos apenas as associações e os "
                "pesos específicos desse perfil."
            ),
            QMessageBox.Yes |
            QMessageBox.No,
            QMessageBox.No
        )

        if resposta != QMessageBox.Yes:
            return

        excluir_concurso(
            concurso_id
        )

        self.carregar()

    def usar_perfil(self):
        concurso_id, _, _ = (
            self.selecionado()
        )

        if concurso_id is None:
            QMessageBox.information(
                self,
                "Selecione um perfil",
                "Selecione primeiro o perfil que deseja usar."
            )
            return

        definir_concurso_ativo(
            concurso_id
        )

        self.carregar()


class JanelaBackups(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)

        self.setWindowTitle(
            "Backups — VighnaStudy"
        )
        self.resize(820, 520)

        layout = QVBoxLayout(self)

        titulo = QLabel(
            "Backups disponíveis"
        )
        titulo.setObjectName(
            "pageTitle"
        )
        layout.addWidget(titulo)

        explicacao = QLabel(
            "Selecione um backup para retornar o banco de dados "
            "ao estado daquele momento. Antes da restauração, "
            "o estado atual será salvo automaticamente."
        )
        explicacao.setWordWrap(True)
        layout.addWidget(explicacao)

        self.tabela = QTableWidget()
        self.tabela.setColumnCount(4)

        self.tabela.setHorizontalHeaderLabels([
            "Data e hora",
            "Motivo",
            "Tamanho",
            "Arquivo"
        ])

        self.tabela.setSelectionBehavior(
            QAbstractItemView.SelectRows
        )
        self.tabela.setSelectionMode(
            QAbstractItemView.SingleSelection
        )
        self.tabela.setEditTriggers(
            QAbstractItemView.NoEditTriggers
        )

        self.tabela.horizontalHeader().setSectionResizeMode(
            0,
            QHeaderView.ResizeToContents
        )
        self.tabela.horizontalHeader().setSectionResizeMode(
            1,
            QHeaderView.ResizeToContents
        )
        self.tabela.horizontalHeader().setSectionResizeMode(
            2,
            QHeaderView.ResizeToContents
        )
        self.tabela.horizontalHeader().setSectionResizeMode(
            3,
            QHeaderView.Stretch
        )

        self.tabela.itemSelectionChanged.connect(
            self.atualizar_estado_botao
        )

        layout.addWidget(
            self.tabela,
            1
        )

        info = QLabel(
            f"Pasta utilizada: {PASTA_BACKUPS}"
        )
        info.setWordWrap(True)
        layout.addWidget(info)

        botoes = QHBoxLayout()

        atualizar = QPushButton(
            "Atualizar lista"
        )
        atualizar.clicked.connect(
            self.carregar_backups
        )

        self.restaurar = QPushButton(
            "Restaurar backup selecionado"
        )
        self.restaurar.setEnabled(False)
        self.restaurar.clicked.connect(
            self.restaurar_selecionado
        )

        fechar = QPushButton(
            "Fechar"
        )
        fechar.clicked.connect(
            self.reject
        )

        botoes.addWidget(
            atualizar
        )
        botoes.addStretch()
        botoes.addWidget(
            self.restaurar
        )
        botoes.addWidget(
            fechar
        )

        layout.addLayout(
            botoes
        )

        self.carregar_backups()
        # Mostra o resultado do último pedido ao abrir a janela após o restart.
        try:
            import json as _json
            resultado_arquivo = PASTA_BACKUPS / "restauracoes_offline" / "ultimo_resultado.json"
            if resultado_arquivo.is_file():
                ultimo = _json.loads(resultado_arquivo.read_text(encoding="utf-8"))
                if ultimo.get("situacao") == "concluida":
                    QMessageBox.information(
                        self, "Restauração offline concluída",
                        "O backup foi restaurado com o aplicativo fechado.\n\n"
                        "Estado anterior preservado em:\n" + str(ultimo.get("salvaguarda", ""))
                    )
                else:
                    QMessageBox.warning(
                        self, "Restauração offline não concluída",
                        "O procedimento foi interrompido. Consulte o registro "
                        "em backups/restauracoes_offline.\n\n"
                        + str(ultimo.get("erro", "Erro não detalhado."))
                    )
                resultado_arquivo.unlink()
        except Exception:
            pass

    def formatar_tamanho(self, bytes_total):
        valor = float(bytes_total)

        if valor < 1024:
            return f"{valor:.0f} B"

        valor /= 1024

        if valor < 1024:
            return f"{valor:.1f} KB"

        valor /= 1024
        return f"{valor:.1f} MB"

    def carregar_backups(self):
        backups = listar_backups()

        self.tabela.setRowCount(
            len(backups)
        )

        for linha, backup in enumerate(
            backups
        ):
            data_texto = datetime.fromtimestamp(
                backup["data_modificacao"]
            ).strftime(
                "%d/%m/%Y %H:%M:%S"
            )

            valores = [
                data_texto,
                backup["motivo"],
                self.formatar_tamanho(
                    backup["tamanho"]
                ),
                backup["nome"]
            ]

            for coluna, valor in enumerate(
                valores
            ):
                item = QTableWidgetItem(
                    str(valor)
                )

                if coluna == 0:
                    item.setData(
                        Qt.UserRole,
                        str(backup["caminho"])
                    )

                self.tabela.setItem(
                    linha,
                    coluna,
                    item
                )

        self.atualizar_estado_botao()

    def atualizar_estado_botao(self):
        self.restaurar.setEnabled(
            self.tabela.currentRow() >= 0
        )

    def restaurar_selecionado(self):
        linha = self.tabela.currentRow()
        if linha < 0:
            return
        item = self.tabela.item(linha, 0)
        if item is None:
            return
        caminho = item.data(Qt.UserRole)
        valido, mensagem = validar_backup(caminho)
        if not valido:
            QMessageBox.critical(self, "Backup inválido", mensagem)
            return
        data_backup = self.tabela.item(linha, 0).text()
        arquivo_backup = self.tabela.item(linha, 3).text()
        resposta = QMessageBox.warning(
            self, "Restauração offline — confirmar",
            "O Vighna precisa estar completamente fechado antes de restaurar.\n\n"
            f"Backup selecionado: {data_backup} — {arquivo_backup}\n\n"
            "Ao confirmar, será iniciado um processo externo que aguardará "
            "o fechamento do programa, criará uma salvaguarda do estado atual "
            "e só então substituirá o banco.\n\n"
            "A restauração pode levar algum tempo. Não reinicie o Vighna até "
            "a operação terminar. O resultado estará disponível ao retornar "
            "à janela de Backups.\n\n"
            "Deseja encerrar o Vighna e iniciar a restauração offline?",
            QMessageBox.Yes | QMessageBox.No, QMessageBox.No,
        )
        if resposta != QMessageBox.Yes:
            return
        if self.parentWidget() is None:
            QMessageBox.critical(self, "Restauração não iniciada",
                                 "A janela principal do Vighna não foi encontrada.")
            return
        try:
            iniciar_restauracao_offline(caminho)
        except Exception as erro:
            QMessageBox.critical(
                self, "Restauração não iniciada",
                f"O banco não foi alterado.\n\n{erro}"
            )
            return
        self.restaurar.setEnabled(False)
        # Acione o fechamento NORMAL do SistemaEstudos (cache, backup e
        # verificações de sessões). QApplication.quit() pula esse fluxo.
        # Se o fechamento for cancelado, o worker espera 90 s e abandona o
        # pedido SEM substituir o banco de dados.
        principal = self.parentWidget()
        self.accept()
        if principal is not None:
            QTimer.singleShot(0, principal.close)


class JanelaMatrizEspacamento(QDialog):
    def __init__(
        self,
        parent=None
    ):
        super().__init__(
            parent
        )

        self.setWindowTitle(
            "Matriz de espaçamento"
        )
        self.resize(
            940,
            650
        )

        layout = QVBoxLayout(
            self
        )

        titulo = QLabel(
            "Matriz de espaçamento das revisões"
        )
        titulo.setObjectName(
            "pageTitle"
        )
        layout.addWidget(
            titulo
        )

        explicacao = QLabel(
            "Cada célula representa um intervalo MÍNIMO–MÁXIMO "
            "em dias. Exemplo: 12–16. A sugestão exata é interpolada "
            "dentro do intervalo conforme o percentual obtido."
        )
        explicacao.setWordWrap(
            True
        )
        layout.addWidget(
            explicacao
        )

        self.tabela = QTableWidget()
        self.tabela.setRowCount(
            len(
                FAIXAS_PERCENTUAIS
            )
        )
        self.tabela.setColumnCount(
            5
        )

        self.tabela.setHorizontalHeaderLabels([
            "1ª revisão",
            "2ª revisão",
            "3ª revisão",
            "4ª revisão",
            "5ª ou mais"
        ])

        self.tabela.setVerticalHeaderLabels([
            "< 50%",
            "50–59%",
            "60–69%",
            "70–79%",
            "80–89%",
            "90–94%",
            "95–100%"
        ])

        self.tabela.horizontalHeader().setSectionResizeMode(
            QHeaderView.Stretch
        )

        self.tabela.verticalHeader().setSectionResizeMode(
            QHeaderView.ResizeToContents
        )

        layout.addWidget(
            self.tabela,
            1
        )

        queda_box = QFrame()
        queda_box.setFrameShape(
            QFrame.StyledPanel
        )

        queda_layout = QFormLayout(
            queda_box
        )

        self.limite_moderada = QSpinBox()
        self.limite_moderada.setRange(
            1,
            99
        )
        self.limite_moderada.setSuffix(
            " p.p."
        )

        self.penalizacao_moderada = QSpinBox()
        self.penalizacao_moderada.setRange(
            0,
            90
        )
        self.penalizacao_moderada.setSuffix(
            "%"
        )

        self.limite_forte = QSpinBox()
        self.limite_forte.setRange(
            2,
            100
        )
        self.limite_forte.setSuffix(
            " p.p."
        )

        self.penalizacao_forte = QSpinBox()
        self.penalizacao_forte.setRange(
            0,
            90
        )
        self.penalizacao_forte.setSuffix(
            "%"
        )

        queda_layout.addRow(
            "Queda moderada a partir de:",
            self.limite_moderada
        )
        queda_layout.addRow(
            "Redução do intervalo:",
            self.penalizacao_moderada
        )
        queda_layout.addRow(
            "Queda forte a partir de:",
            self.limite_forte
        )
        queda_layout.addRow(
            "Redução do intervalo:",
            self.penalizacao_forte
        )

        layout.addWidget(
            QLabel(
                "Ajustes por queda de desempenho"
            )
        )
        layout.addWidget(
            queda_box
        )

        dica = QLabel(
            "Proteções: o programa não aceita mínimo maior que máximo, "
            "intervalos regressivos entre revisões, nem uma faixa de "
            "desempenho superior com intervalo menor que a anterior."
        )
        dica.setWordWrap(
            True
        )
        layout.addWidget(
            dica
        )

        botoes_linha = QHBoxLayout()

        restaurar = QPushButton(
            "Restaurar padrões"
        )
        restaurar.clicked.connect(
            self.restaurar_padroes
        )

        botoes_linha.addWidget(
            restaurar
        )
        botoes_linha.addStretch()

        botoes = QDialogButtonBox(
            QDialogButtonBox.Save |
            QDialogButtonBox.Cancel
        )

        botoes.button(
            QDialogButtonBox.Save
        ).setText(
            "Salvar matriz"
        )

        botoes.button(
            QDialogButtonBox.Cancel
        ).setText(
            "Cancelar"
        )

        botoes.accepted.connect(
            self.salvar
        )
        botoes.rejected.connect(
            self.reject
        )

        botoes_linha.addWidget(
            botoes
        )

        layout.addLayout(
            botoes_linha
        )

        self.carregar()

    def preencher_tabela(
        self,
        tabela
    ):
        for coluna in range(
            5
        ):
            revisao = coluna + 1

            for linha, faixa in enumerate(
                FAIXAS_PERCENTUAIS
            ):
                minimo, maximo = tabela[
                    revisao
                ][faixa]

                item = QTableWidgetItem(
                    f"{minimo}–{maximo}"
                )

                item.setTextAlignment(
                    Qt.AlignCenter
                )

                self.tabela.setItem(
                    linha,
                    coluna,
                    item
                )

    def carregar(self):
        config = (
            carregar_configuracao_espacamento()
        )

        self.preencher_tabela(
            config[
                "tabela"
            ]
        )

        self.limite_moderada.setValue(
            config[
                "limite_moderada"
            ]
        )

        self.limite_forte.setValue(
            config[
                "limite_forte"
            ]
        )

        self.penalizacao_moderada.setValue(
            config[
                "penalizacao_moderada"
            ]
        )

        self.penalizacao_forte.setValue(
            config[
                "penalizacao_forte"
            ]
        )

    def restaurar_padroes(self):
        resposta = QMessageBox.question(
            self,
            "Restaurar padrões",
            (
                "Voltar a matriz e os ajustes por queda "
                "aos valores originais?\n\n"
                "A alteração só será gravada quando você "
                "clicar em “Salvar matriz”."
            ),
            QMessageBox.Yes |
            QMessageBox.No,
            QMessageBox.No
        )

        if resposta != QMessageBox.Yes:
            return

        tabela = obter_tabela_padrao()
        queda = (
            obter_configuracao_queda_padrao()
        )

        self.preencher_tabela(
            tabela
        )

        self.limite_moderada.setValue(
            queda[
                "limite_moderada"
            ]
        )
        self.limite_forte.setValue(
            queda[
                "limite_forte"
            ]
        )
        self.penalizacao_moderada.setValue(
            queda[
                "penalizacao_moderada"
            ]
        )
        self.penalizacao_forte.setValue(
            queda[
                "penalizacao_forte"
            ]
        )

    def ler_intervalo(
        self,
        texto,
        faixa,
        revisao
    ):
        texto = str(
            texto
        ).strip()

        texto = texto.replace(
            "—",
            "-"
        ).replace(
            "–",
            "-"
        )

        partes = [
            parte.strip()
            for parte in texto.split(
                "-"
            )
            if parte.strip()
        ]

        if len(partes) != 2:
            raise ValueError(
                f"Use o formato mínimo–máximo na faixa "
                f"{faixa}, {revisao}ª revisão."
            )

        try:
            minimo = int(
                partes[0]
            )
            maximo = int(
                partes[1]
            )
        except ValueError:
            raise ValueError(
                f"Use números inteiros na faixa "
                f"{faixa}, {revisao}ª revisão."
            )

        return (
            minimo,
            maximo
        )

    def obter_tabela_digitada(self):
        tabela = {}

        for coluna in range(
            5
        ):
            revisao = coluna + 1
            tabela[
                revisao
            ] = {}

            for linha, faixa in enumerate(
                FAIXAS_PERCENTUAIS
            ):
                item = self.tabela.item(
                    linha,
                    coluna
                )

                if item is None:
                    raise ValueError(
                        f"Há uma célula vazia em {faixa}, "
                        f"{revisao}ª revisão."
                    )

                tabela[
                    revisao
                ][faixa] = (
                    self.ler_intervalo(
                        item.text(),
                        faixa,
                        revisao
                    )
                )

        validar_tabela_espacamento(
            tabela
        )

        return tabela

    def salvar(self):
        try:
            tabela = (
                self.obter_tabela_digitada()
            )

            salvar_configuracao_espacamento(
                tabela,
                self.limite_moderada.value(),
                self.limite_forte.value(),
                self.penalizacao_moderada.value(),
                self.penalizacao_forte.value()
            )

        except ValueError as erro:
            QMessageBox.warning(
                self,
                "Configuração inválida",
                str(
                    erro
                )
            )
            return

        QMessageBox.information(
            self,
            "Matriz salva",
            (
                "As novas regras já serão usadas nas "
                "próximas sugestões de revisão."
            )
        )

        self.accept()


# M03 — detalhe estático do cabeçalho da Central de Controle Vighna.
# Recorte da composição visual aprovada, sem texto incorporado à imagem.
# Mantido neste módulo porque o atualizador nativo permite código-fonte,
# e não arquivos de mídia soltos. Decodificado somente na criação da janela.
_ART_HEADER_CONFIG_M03_JPEG_B64 = (
    ""
)

class JanelaConfiguracoes(QDialog):
    def __init__(self, parent=None):
        super().__init__(
            parent
        )

        self.setWindowTitle(
            "Configurações — VighnaStudy"
        )

        # Conserva os controles nativos da janela, inclusive restaurar/maximizar.
        # A abertura maximizada é feita no controlador, sem esconder a barra de tarefas.
        self.setWindowFlag(Qt.WindowMaximizeButtonHint, True)
        self.setWindowFlag(Qt.WindowMinimizeButtonHint, True)
        self.resize(900, 700)
        self.setMinimumSize(720, 560)

        self.opcoes_pesquisa = []
        self.secoes_pesquisa = []
        # M04: rótulos visuais; não interferem nos valores persistentes.
        self._contadores_secao_config_m04 = {}
        # M01: navegação estrutural, mantendo os widgets e as ações originais.
        self._navegacao_config_links = []
        self._navegacao_config_atualizando = False

        layout = QVBoxLayout(
            self
        )

        layout.setContentsMargins(
            18,
            16,
            18,
            14
        )

        layout.setSpacing(
            12
        )

        # ====================================================
        # M03 — CABEÇALHO VIGHNA COM ARTE ESTÁTICA E TEXTO NATIVO
        # ====================================================
        cabecalho_config = QFrame()
        cabecalho_config.setObjectName("settingsHeaderM01")
        cabecalho_layout = QHBoxLayout(cabecalho_config)
        # V2/M06: cabeçalho e busca agora são uma só região compacta.
        cabecalho_layout.setContentsMargins(16, 7, 12, 7)
        cabecalho_layout.setSpacing(10)

        coluna_texto_cabecalho = QVBoxLayout()
        coluna_texto_cabecalho.setContentsMargins(0, 0, 0, 0)
        coluna_texto_cabecalho.setSpacing(2)

        rotulo_central = QLabel("CENTRAL DE CONTROLE VIGHNA")
        rotulo_central.setObjectName("settingsHeaderEyebrowM03")
        coluna_texto_cabecalho.addWidget(rotulo_central)

        titulo = QLabel("Configurações")
        titulo.setObjectName("pageTitle")
        coluna_texto_cabecalho.addWidget(titulo)

        explicacao = QLabel(
