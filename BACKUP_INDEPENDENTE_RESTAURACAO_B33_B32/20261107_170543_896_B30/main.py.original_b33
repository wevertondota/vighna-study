            self.sugerir_redistribuicao
        )
        redistribuicao_layout.addLayout(
            grade_redistribuicao
        )

        conteudo_layout.addWidget(
            card_redistribuicao
        )

        conteudo_layout.addStretch()

        # ====================================================
        # RODAPÉ
        # ====================================================

        botoes = QDialogButtonBox(
            QDialogButtonBox.Save |
            QDialogButtonBox.Cancel
        )

        salvar = botoes.button(
            QDialogButtonBox.Save
        )
        salvar.setText(
            "Salvar planejamento"
        )
        salvar.setObjectName(
            "primaryButton"
        )

        cancelar = botoes.button(
            QDialogButtonBox.Cancel
        )
        cancelar.setText(
            "Cancelar"
        )
        cancelar.setObjectName(
            "subtleButton"
        )

        botoes.accepted.connect(
            self.salvar
        )
        botoes.rejected.connect(
            self.reject
        )

        layout.addWidget(
            botoes
        )

    def salvar(self):
        limite_leve = (
            self.limite_leve.value()
        )
        limite_moderada = (
            self.limite_moderada.value()
        )

        if limite_moderada <= limite_leve:
            QMessageBox.warning(
                self,
                "Limites inválidos",
                (
                    "O limite de carga moderada precisa ser "
                    "maior que o limite de carga leve."
                )
            )
            return

        carga_desejada = (
            self.redistribuicao_carga_desejada.value()
        )
        carga_maxima = (
            self.redistribuicao_carga_maxima.value()
        )

        if carga_maxima < carga_desejada:
            QMessageBox.warning(
                self,
                "Redistribuição inválida",
                (
                    "O máximo tolerado não pode ser menor "
                    "que a carga diária desejada."
                )
            )
            return

        definir_configuracao_int(
            "meta_questoes_diaria",
            self.meta_questoes.value()
        )

        definir_configuracao_int(
            "meta_questoes_semanal",
            self.meta_questoes_semanal.value()
        )

        definir_configuracao_int(
            "meta_revisoes_semanal",
            self.meta_revisoes_semanal.value()
        )

        definir_configuracao_int(
            "meta_dias_estudo_semanal",
            self.meta_dias_estudo_semanal.value()
        )

        definir_configuracao_int(
            "meta_foco_semanal_horas",
            self.meta_foco_semanal_horas.value()
        )

        definir_configuracao_int(
            "planejamento_limite_leve",
            limite_leve
        )

        definir_configuracao_int(
            "planejamento_limite_moderada",
            limite_moderada
        )

        definir_configuracao_bool(
            "redistribuicao_sugerir_automaticamente",
            self.sugerir_redistribuicao.isChecked()
        )

        definir_configuracao_int(
            "redistribuicao_carga_desejada",
            carga_desejada
        )

        definir_configuracao_int(
            "redistribuicao_carga_maxima",
            carga_maxima
        )

        definir_configuracao_int(
            "redistribuicao_antecipar_dias",
            self.redistribuicao_antecipar.value()
        )

        definir_configuracao_int(
            "redistribuicao_adiar_dias",
            self.redistribuicao_adiar.value()
        )

        self.accept()



class JanelaFechamentoSemanal(QDialog):
    def __init__(self, dados, parent=None):
        super().__init__(parent)
        self.dados = dict(dados or {})
        self.setWindowTitle("Fechamento semanal — VighnaStudy")
        self.resize(820, 650)
        self.setMinimumSize(700, 540)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(22, 18, 22, 18)
        layout.setSpacing(11)

        titulo = QLabel("Fechamento semanal")
        titulo.setObjectName("pageTitle")
        inicio = QDate.fromString(str(self.dados.get("inicio") or ""), "yyyy-MM-dd")
        fim = QDate.fromString(str(self.dados.get("fim") or ""), "yyyy-MM-dd")
        periodo = (
            f"{inicio.toString('dd/MM')} a {fim.toString('dd/MM/yyyy')}"
            if inicio.isValid() and fim.isValid() else "Semana atual"
        )
        subtitulo = QLabel(
            f"{periodo} • tempo real, questões, revisões e sinais para a próxima semana."
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        layout.addWidget(titulo)
        layout.addWidget(subtitulo)

        grid = QGridLayout()
        grid.setHorizontalSpacing(8)
        grid.setVerticalSpacing(8)
        desempenho = self.dados.get("desempenho")
        valores = [
            ("Foco efetivo", formatar_tempo_foco_resumido(self.dados.get("foco_segundos", 0))),
            ("Sessões", str(self.dados.get("sessoes", 0))),
            ("Dias com foco", str(self.dados.get("dias_com_foco", 0))),
            ("Questões", str(self.dados.get("questoes", 0))),
            ("Desempenho", f"{float(desempenho):.0f}%" if desempenho is not None else "—"),
            ("Revisões", str(self.dados.get("revisoes", 0))),
        ]
        for i, (rotulo, valor) in enumerate(valores):
            card = QFrame()
            card.setObjectName("miniStat")
            box = QVBoxLayout(card)
            box.setContentsMargins(11, 8, 11, 8)
            box.setSpacing(2)
            lab = QLabel(rotulo); lab.setObjectName("miniStatLabel")
            val = QLabel(valor); val.setObjectName("miniStatValue")
            box.addWidget(lab); box.addWidget(val)
            grid.addWidget(card, i // 3, i % 3)
            grid.setColumnStretch(i % 3, 1)
        layout.addLayout(grid)

        meta_horas = int(self.dados.get("meta_foco_horas") or 0)
        if meta_horas > 0:
            pct = float(self.dados.get("meta_foco_percentual") or 0.0)
            meta = QLabel(
                f"Meta semanal de foco: {formatar_tempo_foco_resumido(self.dados.get('foco_segundos', 0))} / {meta_horas}h • {pct:.0f}%"
            )
            meta.setObjectName("dashboardActionDescription")
            meta.setWordWrap(True)
            layout.addWidget(meta)

        corpo = QHBoxLayout()
        corpo.setSpacing(10)

        foco_card = QFrame(); foco_card.setObjectName("studyActionCard")
        foco_box = QVBoxLayout(foco_card); foco_box.setContentsMargins(14, 12, 14, 12); foco_box.setSpacing(5)
        t = QLabel("Distribuição do foco"); t.setObjectName("studyColumnTitle"); foco_box.addWidget(t)
        dist = list(self.dados.get("distribuicao_foco") or [])[:5]
        if dist:
            for item in dist:
                linha = QLabel(
                    f"{item.get('disciplina') or 'Livre / outros'}  •  "
                    f"{formatar_tempo_foco_resumido(item.get('segundos', 0))}  •  {float(item.get('percentual') or 0):.0f}%"
                )
                linha.setObjectName("dashboardActionDescription"); linha.setWordWrap(True)
                foco_box.addWidget(linha)
        else:
            vazio = QLabel("Ainda não há foco efetivo registrado nesta semana.")
            vazio.setObjectName("mutedLabel"); vazio.setWordWrap(True); foco_box.addWidget(vazio)
        foco_box.addStretch(1)
        corpo.addWidget(foco_card, 1)

        evol_card = QFrame(); evol_card.setObjectName("studyActionCard")
        evol_box = QVBoxLayout(evol_card); evol_box.setContentsMargins(14, 12, 14, 12); evol_box.setSpacing(5)
        t = QLabel("Leitura da semana"); t.setObjectName("studyColumnTitle"); evol_box.addWidget(t)
        delta = self.dados.get("delta_desempenho")
        if delta is not None:
            txt = f"Desempenho em questões: {float(delta):+.1f} p.p. em relação à semana anterior."
        else:
            txt = "Ainda não há base suficiente para comparar o desempenho com a semana anterior."
        l = QLabel(txt); l.setObjectName("dashboardActionDescription"); l.setWordWrap(True); evol_box.addWidget(l)
        melhor = self.dados.get("maior_evolucao") or {}
        if melhor:
            l = QLabel(
                f"Maior evolução: {melhor.get('disciplina')} • {float(melhor.get('delta') or 0):+.1f} p.p. "
                f"em {int(melhor.get('questoes') or 0)} questões."
            )
            l.setObjectName("dashboardActionDescription"); l.setWordWrap(True); evol_box.addWidget(l)
        evol_box.addStretch(1)
        corpo.addWidget(evol_card, 1)
        layout.addLayout(corpo)

        prioridade_card = QFrame(); prioridade_card.setObjectName("studyActionCard")
        pb = QVBoxLayout(prioridade_card); pb.setContentsMargins(14, 12, 14, 12); pb.setSpacing(4)
        t = QLabel("Atenção para a próxima semana"); t.setObjectName("studyColumnTitle"); pb.addWidget(t)
        prioridades = list(self.dados.get("prioridades") or [])[:3]
        if prioridades:
            for item in prioridades:
                texto = f"• {item.get('disciplina') or '—'} › {item.get('topico') or '—'}"
                motivo = str(item.get("motivo_principal") or "").strip()
                if motivo:
                    texto += f" — {motivo}"
                l = QLabel(texto); l.setObjectName("dashboardActionDescription"); l.setWordWrap(True); pb.addWidget(l)
        else:
            l = QLabel("Nenhum sinal estratégico relevante disponível no momento.")
            l.setObjectName("mutedLabel"); l.setWordWrap(True); pb.addWidget(l)
        layout.addWidget(prioridade_card)

        acoes = QHBoxLayout(); acoes.addStretch(1)
        continuar = QPushButton("Continuar estudando"); continuar.setObjectName("studyManualButton")
        fechar = QPushButton("Fechar"); fechar.setObjectName("subtleButton")
        janela_principal = parent
        continuar.clicked.connect(self.accept)
        fechar.clicked.connect(self.reject)
        acoes.addWidget(fechar); acoes.addWidget(continuar)
        layout.addLayout(acoes)
        self.continuar = False
        continuar.clicked.connect(lambda: setattr(self, "continuar", True))


class JanelaJornadaDia(QDialog):
    """Fila operacional adaptativa para o restante do dia."""

    def __init__(self, jornada, parent=None):
        super().__init__(parent)
        self.jornada = dict(jornada or {})
        self.setWindowTitle("Jornada do Dia — VighnaStudy")
        self.resize(980, 660)
        self.setMinimumSize(820, 540)

        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(22, 18, 22, 18)
        raiz.setSpacing(11)

        cabecalho = QHBoxLayout()
        textos = QVBoxLayout()
        titulo = QLabel("Jornada do Dia")
        titulo.setObjectName("pageTitle")
        subtitulo = QLabel(
            "Uma sequência flexível para estudar sem voltar ao Dashboard entre cada sessão. "
            "Você pode pular, pausar ou recalcular o restante a qualquer momento."
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        textos.addWidget(titulo)
        textos.addWidget(subtitulo)
        cabecalho.addLayout(textos, 1)
        self.status_badge = QLabel("ATIVA")
        self.status_badge.setObjectName("journeyStatusBadge")
        self.status_badge.setAlignment(Qt.AlignCenter)
        cabecalho.addWidget(self.status_badge, 0, Qt.AlignTop)
        raiz.addLayout(cabecalho)

        resumo_card = QFrame()
        resumo_card.setObjectName("journeySummaryCard")
        resumo_layout = QGridLayout(resumo_card)
        resumo_layout.setContentsMargins(15, 12, 15, 12)
        resumo_layout.setHorizontalSpacing(16)
        self.valor_foco = QLabel("0 min")
        self.valor_restante = QLabel("0 min")
        self.valor_concluidas = QLabel("0")
        self.valor_pendentes = QLabel("0")
        for col, (rotulo, widget) in enumerate([
            ("Foco hoje", self.valor_foco),
            ("Restante operacional", self.valor_restante),
            ("Concluídas", self.valor_concluidas),
            ("Na fila", self.valor_pendentes),
        ]):
            box = QVBoxLayout()
            r = QLabel(rotulo)
            r.setObjectName("journeyStatLabel")
            widget.setObjectName("journeyStatValue")
            box.addWidget(r)
            box.addWidget(widget)
            resumo_layout.addLayout(box, 0, col)
            resumo_layout.setColumnStretch(col, 1)
        raiz.addWidget(resumo_card)

        meta_linha = QHBoxLayout()
        self.meta_texto = QLabel("")
        self.meta_texto.setObjectName("journeyMetaText")
        self.meta_texto.setWordWrap(True)
        meta_linha.addWidget(self.meta_texto, 1)
        raiz.addLayout(meta_linha)

        self.progresso = QProgressBar()
        self.progresso.setObjectName("journeyProgress")
        self.progresso.setRange(0, 100)
        self.progresso.setTextVisible(False)
        raiz.addWidget(self.progresso)

        self.tabela = QTableWidget(0, 6)
        self.tabela.setObjectName("journeyTable")
        self.tabela.setHorizontalHeaderLabels([
            "Estado", "Conteúdo", "Atividade", "Tempo", "Por quê", "Origem"
        ])
        self.tabela.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.tabela.setSelectionMode(QAbstractItemView.SingleSelection)
        self.tabela.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.tabela.verticalHeader().setVisible(False)
        self.tabela.setShowGrid(False)
        header = self.tabela.horizontalHeader()
        header.setSectionResizeMode(0, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(1, QHeaderView.Stretch)
        header.setSectionResizeMode(2, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(3, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(4, QHeaderView.Stretch)
        header.setSectionResizeMode(5, QHeaderView.ResizeToContents)
        self.tabela.doubleClicked.connect(self.iniciar_selecionada)
        raiz.addWidget(self.tabela, 1)

        dica = QLabel(
            "Concluir uma sessão atualiza a fila automaticamente. Uma sessão interrompida volta para a fila; "
            "pular uma atividade não apaga o conteúdo e o próximo recálculo pode escolher outra prioridade."
        )
        dica.setObjectName("journeyHint")
        dica.setWordWrap(True)
        raiz.addWidget(dica)

        acoes = QHBoxLayout()
        self.btn_pular = QPushButton("Pular selecionada")
        self.btn_pular.setObjectName("subtleButton")
        self.btn_pular.clicked.connect(self.pular_selecionada)
        self.btn_recalcular = QPushButton("Recalcular restante")
        self.btn_recalcular.setObjectName("subtleButton")
        self.btn_recalcular.clicked.connect(self.recalcular)
        self.btn_pausar = QPushButton("Pausar jornada")
        self.btn_pausar.setObjectName("subtleButton")
        self.btn_pausar.clicked.connect(self.alternar_pausa)
        self.btn_encerrar = QPushButton("Encerrar por hoje")
        self.btn_encerrar.setObjectName("subtleButton")
        self.btn_encerrar.clicked.connect(self.encerrar_jornada)
        acoes.addWidget(self.btn_pular)
        acoes.addWidget(self.btn_recalcular)
        acoes.addWidget(self.btn_pausar)
        acoes.addWidget(self.btn_encerrar)
        acoes.addStretch(1)
        fechar = QPushButton("Fechar")
        fechar.setObjectName("subtleButton")
        fechar.clicked.connect(self.reject)
        self.btn_iniciar = QPushButton("▶ Iniciar próxima")
        self.btn_iniciar.setObjectName("journeyPrimaryButton")
        self.btn_iniciar.setMinimumSize(155, 38)
        self.btn_iniciar.clicked.connect(self.iniciar_selecionada)
        acoes.addWidget(fechar)
        acoes.addWidget(self.btn_iniciar)
        raiz.addLayout(acoes)

        self.atualizar()

    def _item_selecionado(self):
        linha = self.tabela.currentRow()
        itens = list(self.jornada.get("itens") or [])
        if 0 <= linha < len(itens):
            item = itens[linha]
            if item.get("status") in {"pendente", "interrompida", "em_andamento"}:
                return item
        return proximo_item_jornada(self.jornada)

    def atualizar(self):
        self.jornada = atualizar_resumo_jornada(self.jornada)
        resumo = self.jornada.get("resumo") or {}
        status = str(self.jornada.get("status") or "ativa").lower()
        mapa_status = {"ativa": "ATIVA", "pausada": "PAUSADA", "encerrada": "ENCERRADA"}
        self.status_badge.setText(mapa_status.get(status, status.upper()))
        self.status_badge.setProperty("journeyState", status)
        self.status_badge.style().unpolish(self.status_badge)
        self.status_badge.style().polish(self.status_badge)

        foco = int(resumo.get("foco_hoje_minutos") or 0)
        restante = int(resumo.get("restante_minutos") or 0)
        meta = int(resumo.get("meta_minutos") or 0)
        self.valor_foco.setText(f"{foco} min")
        self.valor_restante.setText("Meta atingida" if resumo.get("meta_atingida") else f"{restante} min")
        self.valor_concluidas.setText(str(int(resumo.get("concluidas") or 0)))
        self.valor_pendentes.setText(str(int(resumo.get("pendentes") or 0)))
        origem = self.jornada.get("meta_origem")
        if origem == "meta_semanal":
            self.meta_texto.setText(
                f"Referência do dia: {meta} min, derivada da sua meta semanal de foco. "
                "O Vighna usa o tempo efetivamente medido para calcular o restante."
            )
        else:
            self.meta_texto.setText(
                f"Carga operacional de referência: {meta} min. Como a meta semanal de foco está desativada, "
                "este valor vem das atividades relevantes do dia e não é tratado como uma meta pessoal."
            )
        percentual = 100 if meta <= 0 else min(100, int(round(100 * foco / max(1, meta))))
        self.progresso.setValue(percentual)

        itens = list(self.jornada.get("itens") or [])
        self.tabela.setRowCount(len(itens))
        status_txt = {
            "concluida": "✓ Concluída",
            "pendente": "○ Pendente",
            "interrompida": "↺ Parcial",
            "em_andamento": "▶ Em foco",
            "pulada": "— Pulada",
        }
        origem_txt = {
            "recomendacao_v5": "Motor V5",
            "recomendacao_v4": "Motor V4 (legado)",
            "fila_revisoes": "Revisões",
            "plano_automatico": "Plano",
            "fallback": "Livre",
        }
        primeira_pendente = None
        for linha, item in enumerate(itens):
            estado = str(item.get("status") or "pendente")
            estado_item = QTableWidgetItem(status_txt.get(estado, estado))
            estado_item.setData(Qt.UserRole, item.get("id"))
            conteudo = str(item.get("disciplina") or "—")
            if str(item.get("topico") or "").strip():
                conteudo += f" › {item.get('topico')}"
            if item.get("opcional"):
                conteudo += "  • extra"
            c = QTableWidgetItem(conteudo)
            a = QTableWidgetItem(str(item.get("atividade") or "Estudo livre"))
            t = QTableWidgetItem(f"~{int(item.get('minutos') or 0)} min")
            m = QTableWidgetItem(str(item.get("motivo") or ""))
            o = QTableWidgetItem(origem_txt.get(item.get("origem_item"), str(item.get("origem_item") or "—")))
            for coluna, celula in enumerate([estado_item, c, a, t, m, o]):
                self.tabela.setItem(linha, coluna, celula)
            if primeira_pendente is None and estado in {"pendente", "interrompida"}:
                primeira_pendente = linha
        self.tabela.resizeRowsToContents()
        if primeira_pendente is not None and self.tabela.currentRow() < 0:
            self.tabela.selectRow(primeira_pendente)

        pode_operar = status != "encerrada"
        self.btn_iniciar.setEnabled(pode_operar and bool(proximo_item_jornada(self.jornada)))
        self.btn_pular.setEnabled(pode_operar and bool(proximo_item_jornada(self.jornada)))
        self.btn_recalcular.setEnabled(pode_operar)
        self.btn_pausar.setEnabled(status != "encerrada")
        self.btn_pausar.setText("Retomar jornada" if status == "pausada" else "Pausar jornada")
        if resumo.get("meta_atingida") and proximo_item_jornada(self.jornada):
            self.btn_iniciar.setText("▶ Fazer atividade extra")
        else:
            self.btn_iniciar.setText("▶ Iniciar próxima")

    def iniciar_selecionada(self, *args):
        if str(self.jornada.get("status") or "ativa") == "pausada":
            QMessageBox.information(self, "Jornada pausada", "Retome a Jornada antes de iniciar uma nova atividade.")
            return
        item = self._item_selecionado()
        if not item:
            QMessageBox.information(self, "Jornada do Dia", "Não há atividade pendente nesta Jornada.")
            return
        principal = self.parent()
        if principal is None or not hasattr(principal, "iniciar_item_jornada"):
            return
        principal.iniciar_item_jornada(item)
        self.accept()

    def pular_selecionada(self):
        item = self._item_selecionado()
        if not item:
            return
        principal = self.parent()
        self.jornada = principal.pular_item_jornada(item) if principal is not None else self.jornada
        self.atualizar()

    def recalcular(self):
        principal = self.parent()
        if principal is None:
            return
        self.jornada = principal.recalcular_jornada_do_dia()
        self.atualizar()

    def alternar_pausa(self):
        principal = self.parent()
        if principal is None:
            return
        self.jornada = principal.alternar_pausa_jornada()
        self.atualizar()

    def encerrar_jornada(self):
        if QMessageBox.question(
            self,
            "Encerrar Jornada",
            "Encerrar a Jornada de hoje? As sessões já registradas permanecem no histórico.",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No,
        ) != QMessageBox.Yes:
            return
        principal = self.parent()
        if principal is not None:
            self.jornada = principal.encerrar_jornada_do_dia()
        self.accept()


class JanelaPlanoAcaoAutomatico(QDialog):
    def __init__(self, concurso_id, parent=None):
        super().__init__(parent)
        self.concurso_id = int(concurso_id)
        self.variacao = 0
        salvo = obter_plano_acao_automatico(self.concurso_id)
        carga_inicial = (salvo or {}).get("carga", "moderada")
        self.plano = None

        self.setWindowTitle("Plano Automático V2 — VighnaStudy")
        self.resize(1120, 700)
        self.setMinimumSize(900, 580)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(22, 18, 22, 18)
        layout.setSpacing(11)

        cabecalho = QHBoxLayout()
        textos = QVBoxLayout()
        textos.setSpacing(2)
        titulo = QLabel("Plano Automático V2 — próximos 7 dias")
        titulo.setObjectName("pageTitle")
        subtitulo = QLabel(
            "Revisões, Domínio V2, prioridades adaptativas e o tempo real do Modo Foco "
            "formam uma agenda que se recalibra conforme você estuda."
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        textos.addWidget(titulo)
        textos.addWidget(subtitulo)
        cabecalho.addLayout(textos, 1)

        carga_box = QVBoxLayout()
        carga_label = QLabel("Carga")
        carga_label.setObjectName("mutedLabel")
        self.carga = QComboBox()
        self.carga.addItem("Leve", "leve")
        self.carga.addItem("Moderada", "moderada")
        self.carga.addItem("Intensa", "intensa")
        idx = self.carga.findData(str(carga_inicial).lower())
        self.carga.setCurrentIndex(idx if idx >= 0 else 1)
        self.carga.setMinimumWidth(145)
        carga_box.addWidget(carga_label)
        carga_box.addWidget(self.carga)
        cabecalho.addLayout(carga_box)
        layout.addLayout(cabecalho)

        self.aviso_salvo = QLabel("")
        self.aviso_salvo.setObjectName("autoPlanSavedNotice")
        self.aviso_salvo.setWordWrap(True)
        if salvo and salvo.get("itens"):
            res = salvo.get("resumo") or {}
            self.aviso_salvo.setText(
                f"Plano ativo: {res.get('acoes', 0)} ações • "
                f"{res.get('questoes', 0)} questões previstas • aceito em "
                f"{str(salvo.get('aceito_em') or '')[:16].replace('T', ' ')}. "
                "Gerar um novo plano não substitui o atual até você aceitar."
            )
            self.aviso_salvo.setVisible(True)
        else:
            self.aviso_salvo.setVisible(False)
        layout.addWidget(self.aviso_salvo)

        indicadores = QGridLayout()
        indicadores.setHorizontalSpacing(8)
        self.indicadores = {}
        for col, (chave, rotulo) in enumerate([
            ("acoes", "Ações"),
            ("questoes", "Questões previstas"),
            ("revisoes", "Revisões"),
            ("dias_com_acao", "Dias ativos"),
            ("foco_min", "Foco estimado"),
        ]):
            card = QFrame()
            card.setObjectName("autoPlanStat")
            box = QVBoxLayout(card)
            box.setContentsMargins(11, 8, 11, 8)
            box.setSpacing(1)
            l = QLabel(rotulo)
            l.setObjectName("miniStatLabel")
            v = QLabel("—")
            v.setObjectName("miniStatValue")
            box.addWidget(l)
            box.addWidget(v)
            self.indicadores[chave] = v
            indicadores.addWidget(card, 0, col)
            indicadores.setColumnStretch(col, 1)
        layout.addLayout(indicadores)

        self.contexto = QLabel("")
        self.contexto.setObjectName("autoPlanContext")
        self.contexto.setWordWrap(True)
        layout.addWidget(self.contexto)

        self.tabela = QTableWidget()
        self.tabela.setObjectName("autoPlanTable")
        self.tabela.setColumnCount(7)
        self.tabela.setHorizontalHeaderLabels([
            "Incluir", "Dia", "Tipo", "Atividade", "Carga", "Por quê", "Foco"
        ])
        self.tabela.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.tabela.setSelectionMode(QAbstractItemView.SingleSelection)
        self.tabela.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.tabela.verticalHeader().setVisible(False)
        self.tabela.setShowGrid(False)
        header = self.tabela.horizontalHeader()
        header.setSectionResizeMode(0, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(1, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(2, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(3, QHeaderView.Stretch)
        header.setSectionResizeMode(4, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(5, QHeaderView.Stretch)
        header.setSectionResizeMode(6, QHeaderView.ResizeToContents)
        layout.addWidget(self.tabela, 1)

        acoes = QHBoxLayout()
        self.botao_regenerar = QPushButton("Regenerar")
        self.botao_regenerar.setObjectName("subtleButton")
        self.botao_regenerar.setToolTip("Gerar outra combinação usando os mesmos critérios e a mesma carga.")
        self.botao_regenerar.clicked.connect(self.regenerar)

        self.botao_substituir = QPushButton("Substituir atividade")
        self.botao_substituir.setObjectName("subtleButton")
        self.botao_substituir.setToolTip("Trocar a linha selecionada por outra prioridade relevante.")
        self.botao_substituir.clicked.connect(self.substituir)

        self.botao_redistribuir = QPushButton("Redistribuir")
        self.botao_redistribuir.setObjectName("subtleButton")
        self.botao_redistribuir.setToolTip("Balancear as ações flexíveis entre os dias sem mover revisões fixas.")
        self.botao_redistribuir.clicked.connect(self.redistribuir)

        self.botao_iniciar_proxima = QPushButton("▶ Iniciar próxima de hoje")
        self.botao_iniciar_proxima.setObjectName("autoPlanAcceptButton")
        self.botao_iniciar_proxima.setToolTip(
            "Preparar no Modo Foco a primeira atividade marcada para hoje. Se não houver, usa a próxima atividade marcada."
        )
        self.botao_iniciar_proxima.clicked.connect(self.iniciar_proxima_atividade)

        acoes.addWidget(self.botao_regenerar)
        acoes.addWidget(self.botao_substituir)
        acoes.addWidget(self.botao_redistribuir)
        acoes.addWidget(self.botao_iniciar_proxima)
        acoes.addStretch()

        cancelar = QPushButton("Fechar")
        cancelar.setObjectName("subtleButton")
        cancelar.clicked.connect(self.reject)
        aceitar = QPushButton("Aceitar selecionadas")
        aceitar.setObjectName("autoPlanAcceptButton")
        aceitar.setMinimumWidth(155)
        aceitar.clicked.connect(self.aceitar_plano)
        acoes.addWidget(cancelar)
        acoes.addWidget(aceitar)
        layout.addLayout(acoes)

        self.carga.currentIndexChanged.connect(self.mudar_carga)
        self.gerar_plano()

    def gerar_plano(self):
        try:
            self.plano = gerar_plano_acao_automatico(
                self.concurso_id,
                QDate.currentDate().toString("yyyy-MM-dd"),
                self.carga.currentData() or "moderada",
                7,
                self.variacao,
            )
        except Exception as erro:
            QMessageBox.critical(self, "Plano de ação", f"Não foi possível gerar o plano.\n\n{erro}")
            self.plano = {"itens": [], "resumo": {}}
        self.atualizar_tela()

    def mudar_carga(self):
        self.variacao = 0
        self.gerar_plano()

    def regenerar(self):
        self.variacao += 1
        self.gerar_plano()

    def redistribuir(self):
        if not self.plano:
            return
        self.plano = redistribuir_plano_acao_automatico(self.plano)
        self.atualizar_tela(preservar_checks=True)

    def substituir(self):
        linha = self.tabela.currentRow()
        if linha < 0:
            QMessageBox.information(self, "Substituir atividade", "Selecione uma atividade na tabela.")
            return
        try:
            self.plano = substituir_atividade_plano_acao_automatico(self.plano, linha)
        except ValueError as erro:
            QMessageBox.information(self, "Substituir atividade", str(erro))
            return
        except Exception as erro:
            QMessageBox.warning(self, "Substituir atividade", f"Não foi possível substituir a atividade.\n\n{erro}")
            return
        self.atualizar_tela()

    def checks_atuais(self):
        return [
            self.tabela.item(i, 0).checkState() == Qt.Checked
            for i in range(self.tabela.rowCount())
            if self.tabela.item(i, 0) is not None
        ]

    def atualizar_tela(self, preservar_checks=False):
        checks = self.checks_atuais() if preservar_checks else []
        plano = self.plano or {}
        resumo = plano.get("resumo") or {}
        itens = list(plano.get("itens") or [])
        foco_minutos = sum(estimar_minutos_plano_foco(item) for item in itens)
        for chave, widget in self.indicadores.items():
            if chave == "foco_min":
                widget.setText(formatar_tempo_foco_resumido(foco_minutos * 60))
            else:
                widget.setText(str(resumo.get(chave, 0)))

        preparacao = plano.get("preparacao") or "Sem classificação suficiente"
        self.contexto.setText(
            f"Preparação: {preparacao} • carga {str(plano.get('carga') or 'moderada').capitalize()} • "
            f"alvo aproximado: {plano.get('alvo_questoes_dia', 0)} questões/dia de estudo • "
            f"{plano.get('dias_estudo_alvo', 0)} dia(s) planejados. "
            "Revisões vinculadas à agenda permanecem fixas; ações flexíveis consideram também o ritmo real do Modo Foco."
        )

        self.tabela.setRowCount(len(itens))
        dias_semana = {1:"Seg",2:"Ter",3:"Qua",4:"Qui",5:"Sex",6:"Sáb",7:"Dom"}
        hoje = QDate.currentDate().toString("yyyy-MM-dd")

        for linha, item in enumerate(itens):
            check = QTableWidgetItem()
            check.setFlags((check.flags() | Qt.ItemIsUserCheckable) & ~Qt.ItemIsEditable)
            marcado = checks[linha] if linha < len(checks) else True
            check.setCheckState(Qt.Checked if marcado else Qt.Unchecked)
            check.setTextAlignment(Qt.AlignCenter)

            qd = QDate.fromString(str(item.get("data") or ""), "yyyy-MM-dd")
            if qd.isValid():
                nome = "Hoje" if item.get("data") == hoje else dias_semana.get(qd.dayOfWeek(), "")
                dia_txt = f"{nome} {qd.toString('dd/MM')}".strip()
            else:
                dia_txt = str(item.get("data") or "—")
            dia = QTableWidgetItem(dia_txt)
            tipo = QTableWidgetItem(str(item.get("tipo") or "—"))
            titulo = QTableWidgetItem(str(item.get("titulo") or "—"))
            titulo.setToolTip(str(item.get("acao") or ""))

            qtd = int(item.get("questoes") or 0)
            revs = int(item.get("quantidade_revisoes") or 0)
            minutos_foco = estimar_minutos_plano_foco(item)
            if qtd > 0 and revs > 0:
                carga_txt = f"{qtd} q. • {revs} rev. • ~{minutos_foco} min"
            elif qtd > 0:
                carga_txt = f"{qtd} questões • ~{minutos_foco} min"
            elif revs > 0:
                revisao_txt = f"{revs} revisão" if revs == 1 else f"{revs} revisões"
                carga_txt = f"{revisao_txt} • ~{minutos_foco} min"
            else:
                carga_txt = f"~{minutos_foco} min"
            carga = QTableWidgetItem(carga_txt)
            motivo = QTableWidgetItem(str(item.get("detalhe") or "—"))
            motivo.setToolTip(str(item.get("acao") or ""))

            if item.get("fixa"):
                tipo.setToolTip("Data preservada porque esta atividade vem da agenda de revisões.")

            self.tabela.setItem(linha, 0, check)
            self.tabela.setItem(linha, 1, dia)
            self.tabela.setItem(linha, 2, tipo)
            self.tabela.setItem(linha, 3, titulo)
            self.tabela.setItem(linha, 4, carga)
            self.tabela.setItem(linha, 5, motivo)

            foco_btn = QPushButton(f"▶ {minutos_foco} min")
            foco_btn.setObjectName("subtleButton")
            foco_btn.setMinimumWidth(86)
            foco_btn.setToolTip(
                "Abrir o Modo Foco já preparado para esta atividade. "
                "O cronômetro não começa automaticamente."
            )
            foco_btn.clicked.connect(
                lambda _=False, indice=linha: self.abrir_foco_linha(indice)
            )
            self.tabela.setCellWidget(linha, 6, foco_btn)

        self.tabela.resizeRowsToContents()

    def iniciar_proxima_atividade(self):
        itens = list((self.plano or {}).get("itens") or [])
        if not itens:
            return
        hoje = QDate.currentDate().toString("yyyy-MM-dd")
        marcadas = []
        for i, item in enumerate(itens):
            celula = self.tabela.item(i, 0)
            if celula is not None and celula.checkState() == Qt.Checked:
                marcadas.append((i, item))
        if not marcadas:
            QMessageBox.information(self, "Plano Automático V2", "Marque ao menos uma atividade para iniciar.")
            return
        hoje_itens = [(i, item) for i, item in marcadas if str(item.get("data") or "") == hoje]
        indice = (hoje_itens or marcadas)[0][0]
        self.abrir_foco_linha(indice)

    def abrir_foco_linha(self, linha):
        itens = list((self.plano or {}).get("itens") or [])
        try:
            item = itens[int(linha)]
        except (IndexError, TypeError, ValueError):
            return

        minutos = estimar_minutos_plano_foco(item)
        titulo = str(item.get("titulo") or item.get("tipo") or "Atividade")
        observacao = f"Plano Automático • {titulo}"

        atividade_foco = atividade_foco_para_item_plano(item)
        questoes_alvo = max(0, int(item.get("questoes") or 0))
        topico_id = item.get("topico_id")
        preparacao = {
            "minutos": minutos,
            "atividade": atividade_foco,
            "disciplina": item.get("disciplina"),
            "topico_id": topico_id,
            "topico": item.get("topico"),
            "observacao": observacao,
            "questoes_alvo": questoes_alvo if topico_id not in (None, "") else 0,
            "origem": "Plano Automático V2",
            "plano_chave": (
                f"{item.get('data') or ''}|{topico_id or ''}|{item.get('tipo') or ''}|{item.get('ordem') or linha}"
            ),
            "abrir_questoes_ao_iniciar": bool(
                questoes_alvo > 0
                and topico_id not in (None, "")
                and atividade_foco in {"Questões", "Treino adaptativo", "Teste de retenção"}
            ),
        }

        janela_principal = self.parent()
        if janela_principal is None or not hasattr(
            janela_principal,
            "abrir_modo_foco"
        ):
            QMessageBox.warning(
                self,
                "Modo Foco",
                "Não foi possível localizar a janela principal para abrir o Modo Foco."
            )
            return

        # Fecha o Plano primeiro. A estimativa é só preparação: o usuário
        # ainda precisa clicar em Iniciar foco, evitando registros acidentais.
        self.accept()
        QTimer.singleShot(
            0,
            lambda p=janela_principal, dados=preparacao: p.abrir_modo_foco(dados)
        )

    def aceitar_plano(self):
        indices = [
            i for i in range(self.tabela.rowCount())
            if self.tabela.item(i, 0) is not None
            and self.tabela.item(i, 0).checkState() == Qt.Checked
        ]
        if not indices:
            QMessageBox.information(self, "Plano de ação", "Selecione ao menos uma atividade para aceitar.")
            return
        try:
            salvo = salvar_plano_acao_automatico(self.plano, indices, self.concurso_id)
        except Exception as erro:
            QMessageBox.critical(self, "Plano de ação", f"Não foi possível salvar o plano.\n\n{erro}")
            return
        resumo = salvo.get("resumo") or {}
        QMessageBox.information(
            self,
            "Plano aceito",
            f"Plano salvo com {resumo.get('acoes', 0)} ações para os próximos dias.\n\n"
            "O plano orienta o estudo, mas não executa sessões nem altera datas de revisão automaticamente."
        )
        self.accept()


class JanelaRedistribuicao(QDialog):
    def __init__(
        self,
        concurso_id,
        parent=None
    ):
        super().__init__(
            parent
        )

        self.concurso_id = concurso_id
        self.resultado = (
            gerar_sugestoes_redistribuicao(
                concurso_id
            )
        )
        self.sugestoes = (
            self.resultado[
                "sugestoes"
            ]
        )

        self.setWindowTitle(
            "Redistribuição de carga — VighnaStudy"
        )

        self.resize(
            980,
            640
        )

        self.setMinimumSize(
            850,
            560
        )

        layout = QVBoxLayout(
            self
        )
        layout.setContentsMargins(
            22,
            18,
            22,
            18
        )
        layout.setSpacing(
            12
        )

        # ====================================================
        # CABEÇALHO
        # ====================================================

        titulo = QLabel(
            "Redistribuição inteligente de carga"
        )
        titulo.setObjectName(
            "pageTitle"
        )

        subtitulo = QLabel(
            (
                "Sugestões para os próximos 7 dias. "
                "O VighnaStudy prioriza antecipações e só propõe adiamento "
                "para tópicos considerados seguros."
            )
        )
        subtitulo.setObjectName(
            "pageSubtitle"
        )
        subtitulo.setWordWrap(
            True
        )

        layout.addWidget(
            titulo
        )
        layout.addWidget(
            subtitulo
        )

        # ====================================================
        # INDICADORES
        # ====================================================

        indicadores = QGridLayout()
        indicadores.setHorizontalSpacing(
            10
        )

        def criar_indicador(
            rotulo,
            valor
        ):
            card = QFrame()
            card.setObjectName(
                "redistributionStat"
            )

            card_layout = QVBoxLayout(
                card
            )
            card_layout.setContentsMargins(
                12,
                8,
                12,
                8
            )
            card_layout.setSpacing(
                2
            )

            label = QLabel(
                rotulo
            )
            label.setObjectName(
                "miniStatLabel"
            )

            valor_label = QLabel(
                str(
                    valor
                )
            )
            valor_label.setObjectName(
                "miniStatValue"
            )

            card_layout.addWidget(
                label
            )
            card_layout.addWidget(
                valor_label
            )

            return card

        indicadores.addWidget(
            criar_indicador(
                "Dias sobrecarregados",
                len(
                    self.resultado[
                        "sobrecargas_antes"
                    ]
                )
            ),
            0,
            0
        )

        indicadores.addWidget(
            criar_indicador(
                "Sugestões",
                len(
                    self.sugestoes
                )
            ),
            0,
            1
        )

        indicadores.addWidget(
            criar_indicador(
                "Ainda acima do máximo",
                len(
                    self.resultado[
                        "sobrecargas_depois"
                    ]
                )
            ),
            0,
            2
        )

        indicadores.addWidget(
            criar_indicador(
                "Carga desejada",
                self.resultado[
                    "carga_desejada"
                ]
            ),
            0,
            3
        )

        for coluna in range(
            4
        ):
            indicadores.setColumnStretch(
                coluna,
                1
            )

        layout.addLayout(
            indicadores
        )

        # ====================================================
        # RESUMO DA REGRA
        # ====================================================

        regra = QLabel(
            (
                f"Carga desejada: {self.resultado['carga_desejada']} • "
                f"máximo tolerado: {self.resultado['carga_maxima']} • "
                f"antecipação: até {self.resultado['antecipar_max']} dia(s) • "
                f"adiamento: até {self.resultado['adiar_max']} dia(s). "
                "Revisões de hoje não são redistribuídas."
            )
        )
        regra.setObjectName(
            "redistributionNotice"
        )
        regra.setWordWrap(
            True
        )

        layout.addWidget(
            regra
        )

        # ====================================================
        # TABELA DE SUGESTÕES
        # ====================================================

        self.tabela = QTableWidget()
        self.tabela.setObjectName(
            "redistributionTable"
        )
        self.tabela.setColumnCount(
            8
        )
        self.tabela.setHorizontalHeaderLabels([
            "Aplicar",
            "Disciplina",
            "Tópico",
            "De",
            "Para",
            "Ajuste",
            "Imp.",
            "% atual"
        ])
        self.tabela.setSelectionBehavior(
            QAbstractItemView.SelectRows
        )
        self.tabela.setSelectionMode(
            QAbstractItemView.SingleSelection
        )
        self.tabela.setEditTriggers(
            QAbstractItemView.NoEditTriggers
        )
        self.tabela.verticalHeader().setVisible(
            False
        )
        self.tabela.setAlternatingRowColors(
            False
        )
        self.tabela.setShowGrid(
            False
        )

        header = (
            self.tabela.horizontalHeader()
        )
        header.setSectionResizeMode(
            0,
            QHeaderView.ResizeToContents
        )
        header.setSectionResizeMode(
            1,
            QHeaderView.ResizeToContents
        )
        header.setSectionResizeMode(
            2,
            QHeaderView.Stretch
        )
        header.setSectionResizeMode(
            3,
            QHeaderView.ResizeToContents
        )
        header.setSectionResizeMode(
            4,
            QHeaderView.ResizeToContents
        )
        header.setSectionResizeMode(
            5,
            QHeaderView.ResizeToContents
        )
        header.setSectionResizeMode(
            6,
            QHeaderView.ResizeToContents
        )
        header.setSectionResizeMode(
            7,
            QHeaderView.ResizeToContents
        )

        self.tabela.setRowCount(
            len(
                self.sugestoes
            )
        )

        for linha, sugestao in enumerate(
            self.sugestoes
        ):
            aplicar = QTableWidgetItem()
            aplicar.setFlags(
                (
                    aplicar.flags()
                    | Qt.ItemIsUserCheckable
                )
                & ~Qt.ItemIsEditable
            )
            aplicar.setCheckState(
                Qt.Checked
            )
            aplicar.setTextAlignment(
                Qt.AlignCenter
            )

            disciplina = QTableWidgetItem(
                sugestao["disciplina"]
            )

            topico = QTableWidgetItem(
                sugestao["topico"]
            )
            topico.setToolTip(
                sugestao["motivo"]
            )

            origem = QTableWidgetItem(
                formatar_data(
                    sugestao["data_origem"]
                )
            )
            origem.setTextAlignment(
                Qt.AlignCenter
            )

            destino = QTableWidgetItem(
                formatar_data(
                    sugestao["data_destino"]
                )
            )
            destino.setTextAlignment(
                Qt.AlignCenter
            )

            tipo = QTableWidgetItem(
                sugestao["tipo"]
            )
            tipo.setTextAlignment(
                Qt.AlignCenter
            )

            if sugestao["tipo"] == "Antecipar":
                aplicar_destaque_tabela(
                    tipo,
                    "sucesso",
                    False
                )
            else:
                aplicar_destaque_tabela(
                    tipo,
                    "atencao",
                    False
                )

            importancia = QTableWidgetItem(
                str(
                    sugestao[
                        "importancia"
                    ]
                )
            )
            importancia.setTextAlignment(
                Qt.AlignCenter
            )

            percentual = QTableWidgetItem(
                formatar_percentual(
                    sugestao[
                        "percentual"
                    ]
                )
            )
            percentual.setTextAlignment(
                Qt.AlignCenter
            )

            self.tabela.setItem(
                linha,
                0,
                aplicar
            )
            self.tabela.setItem(
                linha,
                1,
                disciplina
            )
            self.tabela.setItem(
                linha,
                2,
                topico
            )
            self.tabela.setItem(
                linha,
                3,
                origem
            )
            self.tabela.setItem(
                linha,
                4,
                destino
            )
            self.tabela.setItem(
                linha,
                5,
                tipo
            )
            self.tabela.setItem(
                linha,
                6,
                importancia
            )
            self.tabela.setItem(
                linha,
                7,
                percentual
            )

            self.tabela.setRowHeight(
                linha,
                32
            )

        layout.addWidget(
            self.tabela,
            1
        )

        # ====================================================
        # ESTADO SEM SUGESTÕES
        # ====================================================

        if not self.sugestoes:
            if self.resultado[
                "sobrecargas_antes"
            ]:
                texto = (
                    "Há sobrecarga, mas nenhuma movimentação segura foi "
                    "encontrada com os limites atuais. Aumente a janela de "
                    "antecipação/adiamento ou o máximo tolerado."
                )
            else:
                texto = (
                    "Nenhum dia futuro ultrapassa o máximo tolerado. "
                    "Não há redistribuição necessária."
                )

            vazio = QLabel(
                texto
            )
            vazio.setObjectName(
                "redistributionEmpty"
            )
            vazio.setWordWrap(
                True
            )
            vazio.setAlignment(
                Qt.AlignCenter
            )

            layout.addWidget(
                vazio
            )

        # ====================================================
        # RODAPÉ
        # ====================================================

        rodape = QHBoxLayout()
        rodape.setSpacing(
            8
        )

        aviso = QLabel(
            "Passe o mouse sobre o tópico para ver o motivo da sugestão."
        )
        aviso.setObjectName(
            "mutedLabel"
        )

        rodape.addWidget(
            aviso,
            1
        )

        fechar = QPushButton(
            "Fechar"
        )
        fechar.setObjectName(
            "subtleButton"
        )
        fechar.clicked.connect(
            self.reject
        )

        self.aplicar_botao = QPushButton(
            "Aplicar selecionadas"
        )
        self.aplicar_botao.setObjectName(
            "primaryButton"
        )
        self.aplicar_botao.setMinimumWidth(
            155
        )
        self.aplicar_botao.setEnabled(
            bool(
                self.sugestoes
            )
        )
        self.aplicar_botao.clicked.connect(
            self.aplicar_sugestoes
        )

        rodape.addWidget(
            fechar
        )
        rodape.addWidget(
            self.aplicar_botao
        )

        layout.addLayout(
            rodape
        )

    def aplicar_sugestoes(self):
        selecionadas = []

        for linha, sugestao in enumerate(
            self.sugestoes
        ):
            item = self.tabela.item(
                linha,
                0
            )

            if (
                item is not None
                and item.checkState()
                == Qt.Checked
            ):
                selecionadas.append(
                    sugestao
                )

        if not selecionadas:
            QMessageBox.information(
                self,
                "Nenhuma sugestão selecionada",
                "Marque pelo menos uma sugestão para aplicar."
            )
            return

        resposta = QMessageBox.question(
            self,
            "Aplicar redistribuição",
            (
                f"Aplicar {len(selecionadas)} alteração(ões) de data?\\n\\n"
                "Um backup será criado antes da mudança."
            ),
            QMessageBox.Yes |
            QMessageBox.No,
            QMessageBox.No
        )

        if resposta != QMessageBox.Yes:
            return

        try:
            fazer_backup(
                "antes_redistribuicao"
            )
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Backup não realizado",
                (
                    "A redistribuição foi cancelada porque o backup "
                    "de segurança não pôde ser criado.\\n\\n"
                    f"Detalhes: {erro}"
                )
            )
            return

        try:
            for sugestao in selecionadas:
                atualizar_proxima_revisao(
                    sugestao[
                        "topico_id"
                    ],
                    sugestao[
                        "data_destino"
                    ]
                )
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Erro ao redistribuir",
                (
                    "Ocorreu um erro ao alterar as datas. "
                    "Use o backup criado antes da operação se necessário.\\n\\n"
                    f"Detalhes: {erro}"
                )
            )
            return

        QMessageBox.information(
            self,
            "Redistribuição aplicada",
            (
                f"{len(selecionadas)} revisão(ões) tiveram "
                "a próxima data ajustada."
            )
        )

        self.accept()


class SidebarNavigationDots(QWidget):
    """Três pontos discretos para a rolagem da navegação lateral Futurista.

    Usa a QScrollBar verdadeira como fonte de posição. Não substitui sua
    lógica, nem remove a rolagem por roda, touchpad ou teclado. O indicador
    fica sobreposto à margem da navegação para não estreitar os ícones.
    """

    def __init__(self, barra, viewport):
        super().__init__(viewport)
        self._barra = barra
        self.setFixedSize(11, 76)
        self.setAttribute(Qt.WA_TranslucentBackground, True)
        self.setCursor(Qt.PointingHandCursor)
        self.setAccessibleName("Posição da rolagem da barra lateral")
        viewport.installEventFilter(self)
        barra.valueChanged.connect(self._atualizar)
        barra.rangeChanged.connect(self._atualizar)
        self._reposicionar()
        self._atualizar()

    def eventFilter(self, obj, evento):
        if obj is self.parentWidget() and evento.type() in (QEvent.Resize, QEvent.Show):
            self._reposicionar()
        return super().eventFilter(obj, evento)

    def _reposicionar(self):
        viewport = self.parentWidget()
        if viewport is None:
            return
        x = max(0, viewport.width() - self.width())
        y = max(0, (viewport.height() - self.height()) // 2)
        self.move(x, y)
        self.raise_()

    def _atualizar(self, *_args):
        minimo, maximo = self._barra.minimum(), self._barra.maximum()
        # Não sugerir conteúdo oculto se a navegação inteira já é visível.
        disponivel = maximo > minimo
        if self.isVisible() != disponivel:
            self.setVisible(disponivel)
        if disponivel:
            self.setToolTip(
                "Mais opções abaixo — role ou selecione um ponto"
                if self._barra.value() < maximo else
                "Fim das opções — role para cima"
            )
        self.update()

    def _indice_ativo(self):
        faixa = self._barra.maximum() - self._barra.minimum()
        if faixa <= 0:
            return 0
        proporcao = (self._barra.value() - self._barra.minimum()) / faixa
        return 0 if proporcao < 1 / 3 else (1 if proporcao < 2 / 3 else 2)

    def paintEvent(self, _evento):
        if self._barra.maximum() <= self._barra.minimum():
            return
        pintor = QPainter(self)
        pintor.setRenderHint(QPainter.Antialiasing, True)
        pintor.setPen(Qt.NoPen)
        cor_primaria = QColor(qcolor("futurista", "dashboard.nav_border"))
        indice_ativo = self._indice_ativo()
        cx = self.width() / 2.0
        # O tamanho é fixo e discreto; apenas o ponto da posição atual acende.
        for indice, cy in enumerate((20.0, 38.0, 56.0)):
            selecionado = indice == indice_ativo
            cor = QColor(cor_primaria)
            cor.setAlpha(240 if selecionado else 75)
            raio = 3.2 if selecionado else 2.35
            pintor.setBrush(cor)
            pintor.drawEllipse(QPointF(cx, cy), raio, raio)
        pintor.end()

    def mousePressEvent(self, evento):
        if evento.button() != Qt.LeftButton:
            return super().mousePressEvent(evento)
        # Clique direto: início, meio ou fim, sem restringir o scroll manual.
        y = evento.position().y()
        indice = min(range(3), key=lambda i: abs(y - (20.0 + i * 18.0)))
        minimo = self._barra.minimum()
        faixa = self._barra.maximum() - minimo
        self._barra.setValue(minimo + round(faixa * indice / 2))
        evento.accept()

    def wheelEvent(self, evento):
        pixel = evento.pixelDelta().y()
        angulo = evento.angleDelta().y()
        if pixel:
            passo = pixel
        elif angulo:
            passo = round(angulo / 120 * max(1, self._barra.singleStep()) * 3)
        else:
            evento.ignore()
            return
        self._barra.setValue(self._barra.value() - passo)
        evento.accept()


class DashboardRecommendationHeroFrame(QFrame):
    """Card convencional fora do Futurista; arte integrada e sem vidro simulado
    quando ele é a coluna protagonista do Dashboard.
    """
    def __init__(self, parent=None):
        super().__init__(parent)
        self._hero_enabled = False
        self._hero_pixmap = QPixmap()

    def set_hero_enabled(self, enabled):
        self._hero_enabled = bool(enabled)
        if enabled and self._hero_pixmap.isNull():
            self._hero_vighna_fullframe = False
            try:
                from ui.dashboard_recommendation_new_art import (
                    imagem_recomendacao_vighna_bytes,
                )
                if self._hero_pixmap.loadFromData(
                    imagem_recomendacao_vighna_bytes(), "PNG"
                ):
                    self._hero_vighna_fullframe = True
            except (ImportError, OSError, ValueError):
                pass
            if self._hero_pixmap.isNull():
                # Fallback para o banner original se o PNG não for decodificado.
                try:
                    from ui.dashboard_hero_art import imagem_recomendacao_bytes
                    self._hero_pixmap.loadFromData(imagem_recomendacao_bytes(), "JPG")
                except (ImportError, OSError, ValueError):
                    pass
        self.update()

    def paintEvent(self, event):
        if not self._hero_enabled:
            return super().paintEvent(event)
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing, True)
        rect = QRectF(self.rect()).adjusted(0.6, 0.6, -0.6, -0.6)
        path = QPainterPath()
        path.addRoundedRect(rect, 16, 16)
        painter.setClipPath(path)
        painter.fillRect(self.rect(), QColor(3, 18, 32, 248))
        if (getattr(self, "_hero_vighna_fullframe", False)
                and not self._hero_pixmap.isNull()
                and self.width() > 0 and self.height() > 0):
            # A nova arte 1956x804 tem quase a mesma proporção do card
            # 665x273: renderizar a imagem INTEIRA, sem crop vertical do legado.
            painter.setRenderHint(QPainter.SmoothPixmapTransform, True)
            painter.drawPixmap(
                rect, self._hero_pixmap,
                QRectF(self._hero_pixmap.rect()),
            )
            # Transparência gradual apenas no rodapé para dar contraste
            # ao botão 'Começar agora', ao status e ao link dinâmicos.
            rodape_y = rect.top() + rect.height() * 0.63
            rodape_gradiente = QLinearGradient(0, rodape_y, 0, rect.bottom())
            rodape_gradiente.setColorAt(0.0, QColor(3, 12, 23, 0))
            rodape_gradiente.setColorAt(0.55, QColor(3, 12, 23, 102))
            rodape_gradiente.setColorAt(1.0, QColor(3, 12, 23, 205))
            painter.fillRect(
                QRectF(rect.left(), rodape_y, rect.width(),
                       rect.bottom() - rodape_y), QBrush(rodape_gradiente)
            )
            painter.setClipping(False)
            painter.setPen(QPen(QColor(0, 181, 220, 220), 1.4))
            painter.setBrush(Qt.NoBrush)
            painter.drawRoundedRect(rect, 16, 16)
            painter.end()
            return
        if not self._hero_pixmap.isNull() and self.width() > 0 and self.height() > 0:
            compacto = rect.height() <= 325.0
            if compacto:
                # Arte original tem texto embutido. A janela vertical foi
                # recalibrada para nao cortar o subtitulo ao reduzir o Hero.
                top_h = min(192.0, rect.height() * 0.62)
            else:
                top_h = max(rect.height() * 0.50, min(rect.height() * 0.58, rect.height() - 165.0))
            top_rect = QRectF(rect.left(), rect.top(), rect.width(), top_h)
            pix_w = float(self._hero_pixmap.width())
            pix_h = float(self._hero_pixmap.height())
            target_ratio = top_rect.width() / max(top_rect.height(), 1.0)
            source_ratio = pix_w / max(pix_h, 1.0)
            if compacto:
                # Recorta apenas as bordas verticais do JPEG fornecido pelo
                # projeto: titulo, subtitulo e cerebro ficam visiveis.
                crop_h = min(pix_h, pix_w / max(target_ratio, 0.001))
                source_y = min(max(0.0, 175.0), max(0.0, pix_h - crop_h))
                src = QRectF(0.0, source_y, pix_w, crop_h)
            elif source_ratio > target_ratio:
                crop_w = pix_h * target_ratio
                src = QRectF(0.0, 0.0, crop_w, pix_h)
            else:
                crop_h = pix_w / target_ratio
                src = QRectF(0.0, max(0.0, (pix_h - crop_h) / 2.0), pix_w, crop_h)
            painter.drawPixmap(top_rect, self._hero_pixmap, src)
            painter.fillRect(top_rect, QColor(3, 12, 22, 8))
            fade_top = top_rect.bottom() - 42.0
            fade = QLinearGradient(0, fade_top, 0, rect.bottom())
            fade.setColorAt(0.0, QColor(3, 14, 26, 0))
            fade.setColorAt(0.34, QColor(3, 14, 26, 172))
            fade.setColorAt(1.0, QColor(3, 14, 26, 244))
            painter.fillRect(QRectF(rect.left(), fade_top, rect.width(), rect.bottom() - fade_top), QBrush(fade))
        painter.fillRect(QRectF(rect.left(), rect.bottom() - min(135.0, rect.height()*0.45), rect.width(), min(135.0, rect.height()*0.45)), QColor(3, 14, 26, 96))
        painter.setClipping(False)
        painter.setPen(QPen(QColor(0, 181, 220, 220), 1.4))
        painter.setBrush(Qt.NoBrush)
        painter.drawRoundedRect(rect, 16, 16)
        painter.end()


class DashboardAmbientCanvas(QWidget):
    """Ornamentos estaticos e nao interativos nas margens do Dashboard.

    Desenha apenas quando o tema Futurista esta ativo. Sem timers, sem efeitos
    graficos nos cards e sem novas cores literais: reutiliza tokens existentes.
    O QSS continua sendo responsavel pelo canvas e pela superficie dos cards.
    """

    def sincronizar_gif_dashboard(self, visivel, tema):
        """Inicialização sob demanda, fora da Home e sem afetar os cards."""
        if self.objectName() != "dashboardRoot":
            return
        controlador = getattr(self, "_dashboard_gif_animado", None)
        if controlador is None and visivel and tema in ("futurista", "escuro"):
            try:
                from ui.dashboard_gif_background import FundoGifDashboard
                controlador = FundoGifDashboard(self)
                self._dashboard_gif_animado = controlador
            except Exception:
                return
        if controlador is not None:
            controlador.sincronizar(visivel, tema)

    def paintEvent(self, event):
        # A pintura do fundo pelo QStyle preserva o contrato QSS em subclasses.
        painter = QPainter(self)
        option = QStyleOption()
        option.initFrom(self)
        self.style().drawPrimitive(QStyle.PE_Widget, option, painter, self)

        _tema = normalizar_tema(getattr(self.window(), "tema_atual", "claro"))
        if self.objectName() == "dashboardRoot" and _tema in ("futurista", "escuro"):
            # Fundo animado em memoria. Só este DashboardAmbientCanvas recebe
            # o QMovie; Home/Simulados/Meu Edital não recriam animações.
            painter.fillRect(self.rect(), QColor(3, 9, 18))
            controlador = getattr(self, "_dashboard_gif_animado", None)
            _quadro = controlador.quadro() if controlador is not None else None
            _animado = _quadro is not None
            if not _animado:
                # Fallback seguro: preserva a imagem estática já homologada.
                if getattr(self, "_dashboard_fundo_original", None) is None:
                    _original = QPixmap()
                    if _original.loadFromData(dashboard_fundo_bytes(), "JPG"):
                        self._dashboard_fundo_original = _original
                _quadro = getattr(self, "_dashboard_fundo_original", None)
            if _quadro is not None and self.width() > 0 and self.height() > 0:
                _altura_painel = min(self.height(), max(690, int(self.width() * 0.55)))
                _pix_w = max(1, _quadro.width())
                _pix_h = max(1, _quadro.height())
                _destino = QRectF(0, 0, self.width(), _altura_painel)
                # 'Cover' com corte central; não distorce a proporção do GIF.
                _ratio_destino = self.width() / max(1, _altura_painel)
                _ratio_origem = _pix_w / _pix_h
                if _ratio_origem > _ratio_destino:
                    _cw = _pix_h * _ratio_destino
                    _recorte = QRectF((_pix_w - _cw) / 2.0, 0, _cw, _pix_h)
                else:
                    _ch = _pix_w / _ratio_destino
                    _recorte = QRectF(0, (_pix_h - _ch) / 2.0, _pix_w, _ch)
                painter.save()
                painter.setClipRect(_destino)
                painter.setRenderHint(QPainter.SmoothPixmapTransform, True)
                painter.drawPixmap(_destino, _quadro, _recorte)
                # Legibilidade dos widgets com brilho preservado na arte.
                painter.fillRect(_destino, QColor(2, 8, 18, 55 if _animado else 111))
                if self.height() > _altura_painel + 60 or not _animado:
                    # Gradiente só para páginas longas ou fallback legado.
                    _inicio = 0.81 if _animado else 0.68
                    gradiente = QLinearGradient(0, _altura_painel * _inicio,
                                                 0, _altura_painel)
                    gradiente.setColorAt(0.0, QColor(3, 9, 18, 0))
                    gradiente.setColorAt(1.0, QColor(3, 9, 18, 255))
                    painter.fillRect(
                        QRectF(0, _altura_painel * _inicio, self.width(),
                               _altura_painel * (1 - _inicio)), QBrush(gradiente)
                    )
                painter.restore()

        if _tema != "futurista":
            painter.end()
            return

        width = float(self.width())
        height = float(self.height())
        if width < 300 or height < 200:
            painter.end()
            return

        painter.setRenderHint(QPainter.Antialiasing, True)
        painter.setClipRect(self.rect())
        self._paint_card_ambient_halos(painter)
        violet = qcolor("futurista", "dashboard.nav_border")
        soft = qcolor("futurista", "dashboard.topbar_border")
        # Nenhum estado animado: a ornamentacao e calculada so nos repaints.
        for side in (0, 1):
            sign = 1 if side == 0 else -1
            edge = 0.0 if side == 0 else width
            path = QPainterPath(QPointF(edge, 24.0))
            path.cubicTo(QPointF(edge + sign * 51, 112),
                         QPointF(edge + sign * 42, 222),
                         QPointF(edge + sign * 12, min(height * 0.56, 460.0)))
            path.cubicTo(QPointF(edge - sign * 25, min(height * 0.75, 650.0)),
                         QPointF(edge + sign * 67, max(height - 90.0, 200.0)),
                         QPointF(edge + sign * 4, height - 12.0))
            for alpha, thickness in ((18, 2.1), (60, 0.75)):
                color = QColor(violet)
                color.setAlpha(alpha)
                pen = QPen(color)
                pen.setWidthF(thickness)
                painter.setPen(pen)
                painter.setBrush(Qt.NoBrush)
                painter.drawPath(path)

            # Trilhas verticais segmentadas ocupam as margens, sem encobrir texto.
            color = QColor(soft)
            color.setAlpha(78)
            pen = QPen(color)
            pen.setWidthF(0.8)
            painter.setPen(pen)
            x = edge + sign * 16.0
            painter.drawLine(QPointF(x, 18), QPointF(x, 83))
            painter.drawLine(QPointF(x, min(height * 0.59, 510.0)),
                             QPointF(x, min(height * 0.68, 590.0)))
            painter.drawLine(QPointF(x, max(height - 85.0, 150.0)),
                             QPointF(x, height - 17.0))

        # Pontos e pequenas cruzes discretas. Posicoes deterministicas.
        points = (
            (14, 102, True), (22, 278, False), (12, 448, True),
            (26, 584, False), (18, height - 60, True),
            (width - 14, 116, True), (width - 24, 260, False),
            (width - 14, 436, True), (width - 20, 612, False),
            (width - 12, height - 48, True),
        )
        for x, y, cross in points:
            if not 10 < y < height - 10:
                continue
            color = QColor(violet if cross else soft)
            color.setAlpha(122 if cross else 83)
            pen = QPen(color)
            pen.setWidthF(0.95)
            painter.setPen(pen)
            if cross:
                painter.drawLine(QPointF(x - 3.5, y), QPointF(x + 3.5, y))
                painter.drawLine(QPointF(x, y - 3.5), QPointF(x, y + 3.5))
            else:
                painter.drawPoint(QPointF(x, y))
        painter.end()

    def _paint_card_ambient_halos(self, painter):
        """Realce passivo atras dos cards, somente no Futurista.

        Pintura leve: 4 molduras x 3 linhas por repaint, sem animacoes e
        sem QGraphicsEffect. Os widgets filhos permanecem acima do halo.
        """
        roles = (
            ("focusDashboardMainCard", "dashboard.focus_card_border"),
            ("dashboardInsightSummary", "dashboard.planning_card_border"),
            ("dashboardTodayAction", "dashboard.recommendation_card_border"),
            ("focusQuickCard", "dashboard.progress_card_border"),
        )
        painter.setBrush(Qt.NoBrush)
        for name, color_role in roles:
            card = self.findChild(QFrame, name)
            if card is None or not card.isVisible() or card.width() < 40 or card.height() < 40:
                continue
            top_left = card.mapTo(self, card.rect().topLeft())
            rect = QRectF(
                float(top_left.x()), float(top_left.y()),
                float(card.width()), float(card.height()),
            )
            # Uma borda luminosa suave fora do card. Bordas reais e
            # conteudo continuam controlados pelo QSS e por seus widgets.
            for expansion, thickness, opacity in ((8.0, 9.0, 9), (4.5, 5.0, 15), (1.5, 2.0, 24)):
                glow = QColor(qcolor("futurista", color_role))
                glow.setAlpha(opacity)
                pen = QPen(glow)
                pen.setWidthF(thickness)
                painter.setPen(pen)
                outer = rect.adjusted(-expansion, -expansion, expansion, expansion)
                painter.drawRoundedRect(outer, 15.0 + expansion, 15.0 + expansion)


class DashboardLevelArcWidget(QLabel):
    """Anel circular de progresso do nível, alinhado à referência visual.

    O texto permanece no próprio QLabel para manter os métodos externos de
    atualização. O anel usa o mesmo percentual já calculado para a barra XP.
    """

    def __init__(self, texto="1", parent=None):
        super().__init__(texto, parent)
        self._percentual = 0
        self.setAlignment(Qt.AlignCenter)
        self.setFixedSize(52, 52)

    def setProgress(self, percentual):
        try:
            self._percentual = max(0.0, min(100.0, float(percentual)))
        except (TypeError, ValueError):
            self._percentual = 0.0
        self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing, True)
        tema = normalizar_tema(getattr(self.window(), "tema_atual", "claro"))
        claro = tema == "claro"
        if (tema == "futurista"
                and bool(self.property("dashboard_reference_ring"))):
            # Apenas a circunferencia do resumo do Dashboard. A versao
            # original continua intacta para o indicador do card legado.
            # Bicolor de referencia: metade azul, metade ciano, com pequenas
            # divisorias nas posicoes das 12h e 6h. XP real fica na barra.
            circulo = QRectF(5.0, 5.0, self.width() - 10.0, self.height() - 10.0)
            trilha = QPen(QColor("#11315A"), 7.0)
            trilha.setCapStyle(Qt.FlatCap)
            painter.setPen(trilha)
            painter.drawEllipse(circulo)
            metade_direita = QPen(QColor("#00D9F1"), 7.0)
            metade_direita.setCapStyle(Qt.FlatCap)
            painter.setPen(metade_direita)
            painter.drawArc(circulo, 89 * 16, -178 * 16)
            metade_esquerda = QPen(QColor("#126DFF"), 7.0)
            metade_esquerda.setCapStyle(Qt.FlatCap)
            painter.setPen(metade_esquerda)
            painter.drawArc(circulo, 269 * 16, -178 * 16)
            fonte = QFont("Segoe UI")
            fonte.setPointSize(18)
            fonte.setBold(True)
            painter.setFont(fonte)
            painter.setPen(QColor("#FFFFFF"))
            painter.drawText(self.rect(), Qt.AlignCenter, self.text())
            painter.end()
            return
        borda = QRectF(4.5, 4.5, self.width() - 9, self.height() - 9)
        trilha = QPen(QColor("#BCCBDD" if claro else "#285070"), 4.2)
        trilha.setCapStyle(Qt.RoundCap)
        painter.setPen(trilha)
        painter.drawArc(borda, 90 * 16, -360 * 16)
        if self._percentual > 0:
            progresso = QPen(QColor("#087DB4" if claro else "#00C9EE"), 4.2)
            progresso.setCapStyle(Qt.RoundCap)
            painter.setPen(progresso)
            painter.drawArc(
                borda, 90 * 16, int(-360 * 16 * (self._percentual / 100))
            )
        fonte = QFont("Segoe UI")
        fonte.setPointSize(17)
        fonte.setBold(True)
        painter.setFont(fonte)
        painter.setPen(QColor("#1C2C3C" if claro else "#F3F7FF"))
        painter.drawText(self.rect(), Qt.AlignCenter, self.text())
        painter.end()


def _estilo_metricas_rapidas_planejamento(tema):
    """Estilo local dos dois indicadores operacionais; funciona nos três temas."""
    tema = normalizar_tema(tema)
    if tema == "claro":
        fundo = "rgba(239, 247, 253, 245)"
        borda = "rgba(69, 119, 160, 140)"
        titulo = "#2C5872"
        valor = "#142D45"
        detalhe = "#516A80"
        acento = "#087FB4"
    else:
        fundo = "rgba(3, 21, 38, 210)" if tema == "futurista" else "rgba(10, 27, 44, 226)"
        borda = "rgba(53, 142, 180, 128)" if tema == "futurista" else "rgba(83, 131, 164, 115)"
        titulo = "#BCDDEE"
        valor = "#F3FAFF"
        detalhe = "#AFC8DD"
        acento = "#00C6E5" if tema == "futurista" else "#2CA4D5"
    return f"""
    QWidget#dashboardRoot QFrame#dashboardPlanningMetricTile {{
        background-color: {fundo};
        border: 1px solid {borda};
        border-radius: 9px;
    }}
    QWidget#dashboardRoot QFrame#dashboardPlanningMetricAccent {{
        background-color: {acento}; border: none; border-radius: 1px;
    }}
    QWidget#dashboardRoot QLabel#dashboardPlanningMetricHeading {{
        color: {titulo}; background: transparent; border: none;
        font-size: 7.5pt; font-weight: 700;
    }}
    QWidget#dashboardRoot QLabel#dashboardPlanningMetricValue,
    QWidget#dashboardRoot QLabel#dashboardPlanningRemainingValue {{
        color: {valor}; background: transparent; border: none;
        font-size: 13pt; font-weight: 750;
    }}
    QWidget#dashboardRoot QLabel#dashboardPlanningRemainingValue {{
        font-size: 10pt; font-weight: 700;
    }}
    QWidget#dashboardRoot QLabel#dashboardPlanningMetricDetail {{
        color: {detalhe}; background: transparent; border: none;
        font-size: 8pt;
    }}
    """


class DashboardPlanningArcWidget(QWidget):
    """Semicírculo do Planejamento, na proporção da referência visual.

    Mantém a interface de dados setProgress(atual, meta) já existente e
    desenha a meta real + o percentual sem adicionar campos editáveis.
    """

    def __init__(self, parent=None):
        super().__init__(parent)
        self._atual = 0
        self._meta = 0
        self.setFixedSize(202, 99)
        self.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Fixed)
        self.setAccessibleName("Indicador semicircular da meta diária")

    def setProgress(self, atual, meta):
        try:
            self._atual = max(0, int(atual or 0))
        except (TypeError, ValueError):
            self._atual = 0
        try:
            self._meta = max(0, int(meta or 0))
        except (TypeError, ValueError):
            self._meta = 0
        self.setToolTip(
            f"Meta diária: {self._atual} de {self._meta} questões"
            if self._meta > 0 else f"{self._atual} questões hoje; meta desativada"
        )
        self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing, True)
        tema = normalizar_tema(getattr(self.window(), "tema_atual", "claro"))
        proporcao = (
            max(0.0, min(1.0, self._atual / float(self._meta)))
            if self._meta > 0 else 0.0
        )
        # Elipse intencionalmente mais alta que o widget: só a metade
        # superior aparece, com extremidades na base do velocímetro.
        raio = QRectF(14, 8, self.width() - 28, 160)
        trilha = QPen(qcolor(tema, "dashboard.planning_arc_track"), 7)
        trilha.setCapStyle(Qt.RoundCap)
        painter.setPen(trilha)
        painter.drawArc(raio, 0, 180 * 16)
        if proporcao > 0:
            progresso = QPen(qcolor(tema, "dashboard.planning_arc_fill"), 7)
            progresso.setCapStyle(Qt.RoundCap)
            painter.setPen(progresso)
            # Inicia à esquerda e avança em direção à direita pelo topo.
            painter.drawArc(raio, 180 * 16, -int(180 * 16 * proporcao))

        fonte = QFont("Segoe UI")
        fonte.setPointSize(14)
        fonte.setBold(True)
        painter.setFont(fonte)
        painter.setPen(qcolor(tema, "dashboard.planning_arc_text"))
        titulo = (
            f"{self._atual} / {self._meta}"
            if self._meta > 0 else f"{self._atual} hoje"
        )
        painter.drawText(QRectF(13, 35, self.width()-26, 28), Qt.AlignCenter, titulo)

        fonte.setPointSize(11)
        fonte.setBold(True)
        painter.setFont(fonte)
        painter.setPen(qcolor(tema, "dashboard.planning_arc_fill"))
        detalhe = f"{int(round(proporcao*100))}%" if self._meta > 0 else "Sem meta"
        painter.drawText(QRectF(13, 64, self.width()-26, 23), Qt.AlignCenter, detalhe)
        painter.end()


class DashboardDonutWidget(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self._valor = 0.0
        self._texto = "0,0%"
        self.setMinimumSize(128, 128)
        self.setMaximumSize(150, 150)
        self.setSizePolicy(
            QSizePolicy.Preferred,
            QSizePolicy.Preferred
        )

    def setText(self, texto):
        texto = str(texto or "0,0%")
        self._texto = texto

        try:
            numero = (
                texto
                .replace("%", "")
                .replace(",", ".")
                .strip()
            )
            self._valor = max(
                0.0,
                min(100.0, float(numero))
            )
        except Exception:
            self._valor = 0.0

        self.update()

    def text(self):
        return self._texto

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(
            QPainter.Antialiasing
        )

        lado = min(
            self.width(),
            self.height()
        )
        margem = 16

        retangulo = QRectF(
            (self.width() - lado) / 2 + margem,
            (self.height() - lado) / 2 + margem,
            lado - margem * 2,
            lado - margem * 2
        )

        cor_texto = self.palette().color(
            self.foregroundRole()
        )

        tema_atual = normalizar_tema(
            getattr(self.window(), "tema_atual", "claro")
        )

        cor_trilha = qcolor(
            tema_atual,
            "dashboard.quality_donut_track_dark"
            if cor_texto.lightness() > 150
            else "dashboard.quality_donut_track_light"
        )

        caneta_trilha = QPen(
            cor_trilha,
            11
        )
        caneta_trilha.setCapStyle(
            Qt.RoundCap
        )
        painter.setPen(
            caneta_trilha
        )
        painter.drawArc(
            retangulo,
            0,
            360 * 16
        )

        # Cor principal do gráfico levemente mais azulada para conversar melhor
        # com os botões e com a barra de progresso do dashboard.
        caneta_valor = QPen(
            qcolor(tema_atual, "dashboard.quality_donut_fill"),
            11
        )
        caneta_valor.setCapStyle(
            Qt.RoundCap
        )
        painter.setPen(
            caneta_valor
        )
        painter.drawArc(
            retangulo,
            90 * 16,
            int(
                -360
                * 16
                * (
                    self._valor
                    / 100.0
                )
            )
        )

        fonte = QFont("Segoe UI")
        fonte.setPointSize(16)
        fonte.setBold(True)
        painter.setFont(fonte)
        painter.setPen(cor_texto)
        painter.drawText(
            self.rect(),
            Qt.AlignCenter,
            self._texto
        )


class JanelaInicializacao(QDialog):
    """Fallback local caso o splash em processo independente não possa abrir."""

    def __init__(self):
        super().__init__(None)
        self.setWindowTitle("VighnaStudy")
        self.setModal(False)
        self.setWindowFlags(
            Qt.FramelessWindowHint
            | Qt.Dialog
            | Qt.WindowStaysOnTopHint
        )
        self.setFixedSize(620, 318)
        tela = QApplication.primaryScreen()
        if tela is not None:
            area = tela.availableGeometry()
            self.move(
                area.center().x() - self.width() // 2,
                area.center().y() - self.height() // 2,
            )

        self._frame = 0
        self._status_base = "Inicializando o VighnaStudy"

        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(34, 20, 32, 18)
        raiz.setSpacing(0)
        raiz.addStretch(1)

        conteudo_wrap = QHBoxLayout()
        conteudo_wrap.setContentsMargins(0, 0, 0, 0)
        conteudo_wrap.setSpacing(0)
        conteudo_wrap.addStretch(1)

        conteudo = QWidget()
        conteudo.setObjectName("startupFallbackContent")
        conteudo.setFixedWidth(470)
        conteudo_layout = QVBoxLayout(conteudo)
        conteudo_layout.setContentsMargins(0, 0, 0, 0)
        conteudo_layout.setSpacing(0)

        topo = QHBoxLayout()
        topo.setContentsMargins(0, 0, 0, 0)
        topo.setSpacing(14)

        logo_box = QFrame()
        logo_box.setObjectName("startupFallbackLogoBox")
        logo_box.setFixedSize(54, 54)
        logo_layout = QVBoxLayout(logo_box)
        logo_layout.setContentsMargins(5, 5, 5, 5)
        logo = QLabel()
        logo.setAlignment(Qt.AlignCenter)
        pixmap_logo = carregar_logo_vighnastudy()
        if not pixmap_logo.isNull():
            logo.setPixmap(
                pixmap_logo.scaled(
                    42,
                    42,
                    Qt.KeepAspectRatio,
                    Qt.SmoothTransformation,
                )
            )
        else:
            logo.setText("V")
            logo.setStyleSheet(
                "font-size: 25px; font-weight: 800; "
                f"color: {fixed_qss_color('startup.logo_fallback')};"
            )
        logo_layout.addWidget(logo)
        topo.addWidget(logo_box, 0, Qt.AlignVCenter)

        textos = QVBoxLayout()
        textos.setSpacing(1)
        titulo = QLabel("VighnaStudy")
        titulo.setObjectName("startupFallbackTitle")
        subtitulo = QLabel("Preparando seu ambiente de estudo")
        subtitulo.setObjectName("startupFallbackSubtitle")
        textos.addWidget(titulo)
        textos.addWidget(subtitulo)
        topo.addLayout(textos, 1)
        conteudo_layout.addLayout(topo)

        conteudo_layout.addSpacing(20)

        painel = QFrame()
        painel.setObjectName("startupFallbackPanel")
        painel_layout = QVBoxLayout(painel)
        painel_layout.setContentsMargins(18, 14, 18, 14)
        painel_layout.setSpacing(6)

        linha_status = QHBoxLayout()
        linha_status.setSpacing(12)
        self.status = QLabel("Inicializando o VighnaStudy...")
        self.status.setObjectName("startupFallbackStatus")
        self.status.setWordWrap(False)
        self.percentual = QLabel("2%")
        self.percentual.setObjectName("startupFallbackPercent")
        self.percentual.setAlignment(Qt.AlignRight | Qt.AlignVCenter)
        self.percentual.setFixedWidth(56)
        linha_status.addWidget(self.status, 1)
        linha_status.addWidget(self.percentual, 0)
        painel_layout.addLayout(linha_status)

        self.detalhe = QLabel(
            "Preparando os componentes essenciais do aplicativo."
        )
        self.detalhe.setObjectName("startupFallbackDetail")
        self.detalhe.setWordWrap(True)
        painel_layout.addWidget(self.detalhe)
        painel_layout.addSpacing(4)

        self.progresso = QProgressBar()
        self.progresso.setRange(0, 100)
        self.progresso.setValue(2)
        self.progresso.setTextVisible(False)
        self.progresso.setFixedHeight(18)
        painel_layout.addWidget(self.progresso)

        conteudo_layout.addWidget(painel)

        conteudo_layout.addSpacing(24)

        rodape = QHBoxLayout()
        rodape.setContentsMargins(0, 0, 0, 0)
        rodape.setSpacing(0)
        rodape.addStretch(1)
        rodape_texto = QLabel("motor de inteligência Vighna")
        rodape_texto.setObjectName("startupFallbackFooter")
        rodape.addWidget(rodape_texto, 0, Qt.AlignCenter)
        rodape.addStretch(1)
        conteudo_layout.addLayout(rodape)

        conteudo_wrap.addWidget(conteudo, 0, Qt.AlignHCenter)
        conteudo_wrap.addStretch(1)
        raiz.addLayout(conteudo_wrap)
        raiz.addStretch(1)

        self.setStyleSheet(
            "QDialog {"
            f" background: {fixed_qss_color('system_status.canvas')};"
            f" border: 1px solid {fixed_qss_color('system_status.border')}; border-radius: 17px;"
            "}"
            "QFrame#startupFallbackLogoBox {"
            f" background: {fixed_qss_color('startup.logo_surface')};"
            f" border: 1px solid {fixed_qss_color('startup.logo_border')}; border-radius: 13px;"
            "}"
            "QLabel#startupFallbackTitle {"
            f" color: {fixed_qss_color('system_status.text_primary')};"
            " font-family: 'Segoe UI'; font-size: 23px; font-weight: 800;"
            "}"
            "QLabel#startupFallbackSubtitle {"
            f" color: {fixed_qss_color('startup.subtitle_text')};"
            " font-family: 'Segoe UI'; font-size: 12px;"
            "}"
            "QFrame#startupFallbackPanel {"
            f" background: {fixed_qss_color('system_status.surface')};"
            f" border: 1px solid {fixed_qss_color('system_status.surface_border')}; border-radius: 13px;"
            "}"
            "QLabel#startupFallbackStatus {"
            f" color: {fixed_qss_color('system_status.text_status')};"
            " font-family: 'Segoe UI'; font-size: 13px; font-weight: 650;"
            "}"
            "QLabel#startupFallbackPercent {"
            f" color: {fixed_qss_color('system_status.text_accent')};"
            " font-family: 'Segoe UI'; font-size: 13px; font-weight: 800;"
            "}"
            "QLabel#startupFallbackDetail {"
            f" color: {fixed_qss_color('system_status.text_secondary')};"
            " font-family: 'Segoe UI'; font-size: 11px;"
            "}"
            "QLabel#startupFallbackFooter {"
            f" color: {fixed_qss_color('startup.footer_text')};"
            " font-family: 'Segoe UI'; font-size: 9px; letter-spacing: 0.35px;"
            "}"
            "QProgressBar {"
            f" border: 1px solid {fixed_qss_color('system_status.progress_border')};"
            f" border-radius: 8px; background: {fixed_qss_color('system_status.progress_track')};"
            "}"
            "QProgressBar::chunk {"
            f" border-radius: 7px; background: {fixed_qss_color('system_status.progress_fill')};"
            "}"
        )

        self._timer_animacao = QTimer(self)
        self._timer_animacao.setInterval(320)
        self._timer_animacao.timeout.connect(self._animar)
        self._timer_animacao.start()

    def _animar(self):
        self._frame = (self._frame + 1) % 4
        self.status.setText(
            self._status_base + ("." * self._frame)
        )

    def atualizar(self, texto, percentual=None, detalhe=None):
        self._status_base = str(texto).rstrip(". …")
        self._frame = 3
        self.status.setText(self._status_base + "...")
        if detalhe is not None:
            self.detalhe.setText(str(detalhe))
        if percentual is not None:
            valor = max(0, min(100, int(percentual)))
            self.progresso.setValue(valor)
            self.percentual.setText(f"{valor}%")
        QApplication.processEvents(QEventLoop.AllEvents, 80)

    def finalizar(self):
        self.atualizar(
            "Tudo pronto. Abrindo o VighnaStudy...",
            100,
            "Dashboard, Central, Estatísticas e Relatórios já estão preparados.",
        )
        QApplication.processEvents(QEventLoop.AllEvents, 120)


# MERITO M04: imagens de referencia embutidas para a interface de desenvolvimento.
# Sao 12 PNGs originais V4/M01 em 160px, sem titulo, numero ou quadrante.
# NAO representam conquistas atribuidas ate a integracao com o banco real.
_PERFIL_BRASOES_M04 = {
    500: "",
    1000: "",
    1500: "",
    2500: "",
    4000: "",
    6000: "",
    8500: "",
    11500: "",
    15000: "",
    20000: "",
    27500: "",
    35000: "",
}

_PERFIL_NOMES_M04 = {
    500: 'Escudeiro do Mérito',
    1000: 'Guardião do Mérito',
    1500: 'Veterano do Mérito',
    2500: 'Comendador Vighna',
    4000: 'Preceptor Neural',
    6000: 'Magistrado da Disciplina',
    8500: 'Arquiteto da Maestria',
    11500: 'Soberano do Mérito',
    15000: 'Ascendente Vighna',
    20000: 'Mestre da Consistência',
    27500: 'Engenheiro da Aprendizagem',
    35000: 'Apoteose do Estudo',
}

class SistemaEstudos(QMainWindow):
    dados_alterados = Signal(str)
    estado_foco_alterado = Signal()

    def __init__(self, pre_carregar_startup=False):
        super().__init__()

        self._pre_carregar_startup = bool(pre_carregar_startup)
        self._startup_precarregado = False
        self._topicos_precarregados = {}
        self._topicos_precarregados_data = None
        self._resumo_dia_precarregado = False
        self._resumo_dia_data_referencia = None
        self._calendario_precarregado = False
        self._calendario_data_referencia = None
        self._previsao_semana_suja = True
        self._previsao_semana_data_referencia = None

        # Cache curto + barramento de atualização: evita recalcular o mesmo
        # conjunto analítico várias vezes durante uma única sequência de ações.
        self.cache_analitico = CacheAnalitico(ttl_padrao=12.0)
        self._estado_estatisticas = EstadoEstatisticasLazy()
        self._estado_relatorios = EstadoRelatoriosLazy()
        self._estatisticas_refresh_agendado = False
        self._estatisticas_refresh_em_andamento = False
        self._estatisticas_data_referencia = None

        # Navegação responsiva: Dashboard e Central de Questões mantêm estado
        # de invalidação próprio. Voltar para uma tela já atualizada não deve
        # disparar novamente consultas e montagem de tabelas pesadas.
        self._dashboard_sujo = True
        self._dashboard_refresh_agendado = False
        self._dashboard_data_referencia = None
        self._central_questoes_suja = True
        self._central_questoes_refresh_agendado = False
        self._central_questoes_concurso_id = None
        # Quando a Central é aberta a partir de um tópico, este contexto fica
        # pendente até o carregamento da grade terminar. Isso evita a disputa
        # entre a navegação lazy da Central e a aplicação dos filtros.
        self._central_questoes_contexto_pendente = None
        self._central_questoes_contexto_ativo = None
        self._relatorios_refresh_agendado = False
        self._relatorios_refresh_em_andamento = False

        self._escopos_atualizacao = set()
        self._timer_atualizacao = QTimer(self)
        self._timer_atualizacao.setSingleShot(True)
        self._timer_atualizacao.setInterval(90)
        self._timer_atualizacao.timeout.connect(self._processar_atualizacao_pendente)
        self.dados_alterados.connect(self._receber_alteracao_dados)

        # Tarefas pesadas pós-alteração rodam fora da thread da interface.
        # O debounce evita recomputar várias vezes em uma sequência curta e o
        # warm cache persistente deixa Dashboard/Estatísticas/Relatórios prontos
        # sem empurrar a espera para o primeiro clique.
        self.coordenador_tarefas = CoordenadorTarefas(self)
        self.indicador_tarefa = IndicadorTarefa(self)
        self._tarefa_visual_ativa = None
        self._recalculo_dados_ativo = False
        self._recalculo_dados_reexecutar = False
        self._escopos_recalculo_pendentes = set()
        self._timer_recalculo_dados = QTimer(self)
        self._timer_recalculo_dados.setSingleShot(True)
        self._timer_recalculo_dados.setInterval(450)
        self._timer_recalculo_dados.timeout.connect(self._iniciar_recalculo_dados)
        self._fechamento_solicitado = False
        self._fechamento_em_andamento = False
        self._fechamento_autorizado = False
        # Referência funcional da bateria de questões top-level mais recente.
        # Não há parent Qt entre ela e a principal; esta referência serve só
        # para restauração/atalhos e é limpa ao terminar a sessão.
        self._janela_resolvedor_questoes = None

        self.coordenador_tarefas.iniciada.connect(self._ao_tarefa_iniciada)
        self.coordenador_tarefas.progresso.connect(self._ao_tarefa_progresso)
        self.coordenador_tarefas.concluida.connect(self._ao_tarefa_concluida)
        self.coordenador_tarefas.falhou.connect(self._ao_tarefa_falhou)

        # Proteção preventiva: um banco SQLite corrompido não deve continuar
        # recebendo escritas ou novos backups. A recuperação é feita por uma
        # ferramenta separada, que preserva o arquivo danificado antes de restaurar.
        from backup import ARQUIVO_BANCO
        if ARQUIVO_BANCO.exists():
            banco_ok, banco_msg = verificar_integridade_banco(ARQUIVO_BANCO, completo=False)
            if not banco_ok:
                QMessageBox.critical(
                    self,
                    "Banco de dados precisa de recuperação",
                    (
                        "O Vighna detectou que o estudos.db não está íntegro e bloqueou a abertura para evitar novas gravações.\n\n"
                        f"Arquivo: {ARQUIVO_BANCO}\n\n"
                        f"Diagnóstico: {banco_msg}\n\n"
                        "Feche esta mensagem e execute recuperar_banco.bat na pasta C:\\SistemaEstudos."
                    )
                )
                raise SystemExit(2)

        criar_banco()
        # Compatibilidade 0.29.8: se a versão anterior reagendou uma revisão
        # deliberada recente antes de percorrer todo o banco do tópico,
        # reabre apenas essa rodada. As tentativas permanecem intactas.
        try:
            reabrir_revisoes_parciais_recentes(dias=2)
        except Exception:
            pass

        self.tema_atual = normalizar_tema(
            obter_configuracao_texto(
                "tema_interface",
                "claro"
            )
        )

        # O stylesheet global é aplicado somente depois que a primeira tela
        # estiver montada. Criar centenas de widgets sob um QSS grande faz o
        # Qt recalcular estilo repetidamente e aumenta perceptivelmente o tempo
        # de abertura, sobretudo no executável Windows.

        self.disciplina_atual = None

        self.setWindowTitle(
            f"VighnaStudy {VIGHNA_VERSION}"
        )
        self.resize(1260, 720)
        self.setMinimumSize(
            980,
            620
        )

        self.telas = QStackedWidget()

        # Startup enxuto: somente o Dashboard é construído antes da primeira
        # exibição. As telas secundárias são criadas no primeiro acesso e então
        # permanecem vivas no QStackedWidget pelo restante da execução.
        self.tela_inicial = self.criar_tela_inicial()
        self.telas.addWidget(self.tela_inicial)
        # O03: regiões transparentes sobre as esferas já presentes no GIF.
        # Mantém cards e motores; a abertura dos painéis começa no O04.
        from ui.dashboard_orb_overlay import DashboardOrbOverlay
        self._dashboard_orb_overlay = DashboardOrbOverlay(
            self, self.dashboard_visual_root, self.dashboard_scroll
        )
        self._dashboard_orb_overlay.orbActivated.connect(
            self._dashboard_orb_activated_o03
        )
        # O04: painel flutuante de apresentação, independente dos cards.
        from ui.dashboard_orb_panels import DashboardOrbPanels
        self._dashboard_orb_panels = DashboardOrbPanels(
            self, self.dashboard_visual_root, self.dashboard_scroll
        )
        # L05d: transfere o cabeçalho ORIGINAL (perfil, gerir, central e ajustes)
        # para o Início. Não duplica QComboBox nem seus sinais/conexões.
        # Dashboard histórico conserva os mesmos cards e fica sem cabeçalho.
        self._dashboard_root_layout.removeWidget(self._dashboard_top_container)
        # B33 R1: removes only 3 ET figures and the Recursos sphere in Home V9.
        # Preserve V9 frames, timing, navigation and all study engines.
        from ui.home_b33_cleanup import instalar_limpeza_home_b33
        instalar_limpeza_home_b33()
        self.tela_portal_inicio = criar_portal_inicio(
            self.voltar_inicio, self.abrir_busca_global, self.abrir_questoes,
            self.abrir_portal_treinos, self.abrir_portal_recursos,
            cabecalho_compartilhado=self._dashboard_top_container,
            abrir_edital=self.abrir_portal_edital,
        )
        self.telas.addWidget(self.tela_portal_inicio)
        aplicar_estilo_portal(self.tela_portal_inicio, self.tema_atual)
        # A Central do Edital pertence sempre ao perfil ativo. A estrutura
        # inicial disponibiliza atalhos reais e não presume dados de edital.
        self.tela_portal_edital = criar_portal_edital(
            voltar_inicio=self.abrir_portal_inicio,
            abrir_progresso=self.abrir_progresso_edital,
            abrir_disciplinas=self.abrir_disciplinas_topicos_perfil,
        )
        self.telas.addWidget(self.tela_portal_edital)
        aplicar_estilo_portal_edital(self.tela_portal_edital, self.tema_atual)
        # Migra os três cards executivos originais para Meu Edital.
        # O Planejamento compacto do topo do Dashboard NÃO faz parte.
        self._transferir_cards_dashboard_para_portal_edital()
        # L03: pagina separada, sem modificar o Dashboard ou os motores.
        self.tela_portal_treinos = criar_portal_treinos(
            abrir_inicio=self.abrir_portal_inicio,
            abrir_dashboard=self.voltar_inicio,
            abrir_simulado=lambda: self._abrir_treino_pelo_portal("simulado"),
            abrir_adaptativo=lambda: self._abrir_treino_pelo_portal("adaptativo"),
            abrir_bateria=lambda: self._abrir_treino_pelo_portal("bateria"),
            abrir_revisao=lambda: self._abrir_treino_pelo_portal("revisao"),
            abrir_erros=self.abrir_banco_erros,
            abrir_historico=self.abrir_historico_questoes,
            retomar_sessao=self.abrir_ou_trazer_resolvedor_questoes,
        )
        self.telas.addWidget(self.tela_portal_treinos)
        aplicar_estilo_treinos(self.tela_portal_treinos, self.tema_atual)
        # Transferência real do quadro-mãe; NÃO cria uma segunda instância.
        # A Home e os seis acessos já existentes do portal permanecem intactos.
        self._transferir_quadro_estudo_questoes_para_simulados()
        # L05: catálogo de destinos reais, totalmente independente do banco.
        self.tela_portal_recursos = criar_portal_recursos(
            abrir_inicio=self.abrir_portal_inicio,
            abrir_dashboard=self.voltar_inicio,
            abrir_destinos=self._destinos_portal_recursos(),
        )
        self.telas.addWidget(self.tela_portal_recursos)
        aplicar_estilo_recursos(self.tela_portal_recursos, self.tema_atual)
        # L05h: tela exclusiva de disciplinas, sem replicar o editor de tópicos.
        self.tela_portal_disciplinas = criar_portal_disciplinas(
            listar_disciplinas=listar_disciplinas_gerenciamento,
            listar_topicos=listar_topicos_gerenciamento,
            abrir_disciplina=self.abrir_disciplina,
            editar_disciplinas=self.abrir_disciplinas,
            voltar_inicio=self.abrir_portal_inicio,
        )
        self.telas.addWidget(self.tela_portal_disciplinas)
        aplicar_estilo_portal_disciplinas(self.tela_portal_disciplinas, self.tema_atual)
        self._origem_tela_disciplina = None
        self.telas.setCurrentWidget(self.tela_portal_inicio)
        self.combo_concurso.currentIndexChanged.connect(self._atualizar_perfil_portal)
        self._atualizar_perfil_portal()

        # Shell de navegacao: preserva o QStackedWidget e seus controladores.
        # A barra lateral aparece somente no Futurista; Claro/Escuro seguem
        # visualmente como antes. A estrutura e reversivel por build.
        # O shell passa a compartilhar a mesma ambientação do Dashboard para que
        # as trilhas/ornamentos do tema Futurista também apareçam por trás da
        # barra lateral translúcida.
        self.dashboard_shell = DashboardAmbientCanvas()
        self.dashboard_shell.setObjectName("dashboardAppShell")
        shell_layout = QHBoxLayout(self.dashboard_shell)
        shell_layout.setContentsMargins(0, 0, 0, 0)
        shell_layout.setSpacing(0)
        self.dashboard_sidebar = self._criar_sidebar_dashboard()
        shell_layout.addWidget(self.dashboard_sidebar, 0)
        shell_layout.addWidget(self.telas, 1)
        self.setCentralWidget(self.dashboard_shell)
        self.telas.currentChanged.connect(self._atualizar_selecao_sidebar)
        # GIF do Dashboard avança apenas com a página visível, sem CPU na Home.
        self.telas.currentChanged.connect(self._sincronizar_animacao_dashboard)
        self.combo_concurso.currentIndexChanged.connect(
            self._atualizar_perfil_sidebar
        )
        self._atualizar_perfil_sidebar()
        self._atualizar_layout_sidebar()

        # Aplicar o tema uma única vez sobre a árvore inicial pronta é mais
        # barato do que manter o QSS ativo enquanto milhares de widgets das
        # telas secundárias ainda estão sendo construídos. Telas criadas depois
        # herdam automaticamente o stylesheet da aplicação.
        aplicar_tema(
            QApplication.instance(),
            self.tema_atual
        )

        self.configurar_atalhos_globais()
        self.restaurar_estado_sessao()

        # M25: habilitação assíncrona após montar o Qt; sem apuração na GUI.
        # O worker M09/M10 inicia por QTimer e só publica após COMMIT.
        QTimer.singleShot(0, self._m25_habilitar_merito_producao)

        if not self._pre_carregar_startup:
            # Modo legado/rápido: mostra o Dashboard e atualiza no event loop.
            self._agendar_atualizacao_dashboard(forcar=True)
            self._agendar_backup_abertura()

    # DASHBOARD ALVO — NAVEGACAO LATERAL, LOTE ESTRUTURAL B1
    def _criar_sidebar_dashboard(self):
        """Menu persistente que reutiliza os destinos existentes.

        Inicia recolhido no Futurista e permite expansão manual pelo botão.
        """
        lateral = QFrame()
        lateral.setObjectName("dashboardSidebar")
        lateral.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Expanding)
        coluna = QVBoxLayout(lateral)
        coluna.setContentsMargins(9, 13, 9, 13)
        coluna.setSpacing(5)

        topo = QHBoxLayout()
        self.dashboard_sidebar_marca = QLabel("VighnaStudy")
        self.dashboard_sidebar_marca.setObjectName("dashboardSidebarBrand")
        topo.addWidget(self.dashboard_sidebar_marca, 1)
        self.dashboard_sidebar_toggle = QPushButton("☰")
        self.dashboard_sidebar_toggle.setObjectName("dashboardSidebarToggle")
        self.dashboard_sidebar_toggle.setFixedSize(34, 34)
        self.dashboard_sidebar_toggle.setToolTip("Recolher ou expandir a navegacao lateral")
        self.dashboard_sidebar_toggle.clicked.connect(self._alternar_sidebar_dashboard)
        topo.addWidget(self.dashboard_sidebar_toggle, 0, Qt.AlignRight)
        coluna.addLayout(topo)

        self.dashboard_sidebar_perfil = QLabel("Perfil ativo")
        self.dashboard_sidebar_perfil.setObjectName("dashboardSidebarProfile")
        self.dashboard_sidebar_perfil.setWordWrap(True)
        coluna.addWidget(self.dashboard_sidebar_perfil)

        separador = QFrame()
        separador.setObjectName("dashboardSidebarDivider")
        separador.setFixedHeight(1)
        coluna.addWidget(separador)
        coluna.addSpacing(9)

        # Navegacao consolidada L05f: quatro destinos principais e cinco
        # ferramentas de estudo. As rotas secundarias continuam nas centrais.
        # Icones usam o recurso existente; caracteres sao fallback.
        grupos_navegacao = (
            ("ÁREAS PRINCIPAIS", (
                ("inicio", "Início", "fa6s.house", "⌂", self.abrir_portal_inicio),
                ("dashboard", "Dashboard", "fa6s.chart-column", "▥", self.voltar_inicio),
                ("simulados", "Simulados e Treinos", "fa6s.clipboard-check", "▣", self.abrir_portal_treinos),
                ("recursos", "Central de Recursos", "fa6s.grip", "▦", self.abrir_portal_recursos),
            )),
            ("FERRAMENTAS DE ESTUDO", (
                ("disciplinas", "Disciplinas", "fa6s.book-open", "▣", self.abrir_disciplinas_topicos_perfil),
                ("planejamento", "Planejamento", "fa6s.calendar-days", "▦", self.abrir_calendario),
                ("estatisticas", "Estatísticas", "fa6s.chart-column", "▥", self.abrir_estatisticas),
                ("relatorios", "Relatórios", "fa6s.chart-pie", "▥", self.abrir_relatorios),
                ("pausa", "Pausa e Desafios", "fa6s.trophy", "☆", self.abrir_pausa_desafios),
            )),
        )
        # Os atalhos centrais rolam apenas quando a altura e pequena (980x620).
        # Configurações continua ancorado ao rodape e acessivel em toda altura.
        nav_scroll = QScrollArea()
        nav_scroll.setObjectName("dashboardSidebarNavigationScroll")
        nav_scroll.setFrameShape(QFrame.NoFrame)
        nav_scroll.setWidgetResizable(True)
        nav_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        # Preserva a rolagem por mouse/touchpad e os tres pontos indicadores.
        nav_scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        nav_scroll.setStyleSheet(
            "QScrollArea#dashboardSidebarNavigationScroll { background: transparent; border: none; }"
            "QWidget#dashboardSidebarNavigationContent { background: transparent; }"
        )
        nav_content = QWidget()
        nav_content.setObjectName("dashboardSidebarNavigationContent")
        nav_layout = QVBoxLayout(nav_content)
        nav_layout.setContentsMargins(0, 0, 0, 0)
        nav_layout.setSpacing(5)
        self._sidebar_botoes = {}
        self._sidebar_rotulos = {}
        self._sidebar_icones = {}
        self._sidebar_grupos_rotulos = []
        for indice_grupo, (titulo_grupo, itens) in enumerate(grupos_navegacao):
            if indice_grupo:
                divisoria = QFrame()
                divisoria.setObjectName("dashboardSidebarDivider")
                divisoria.setFixedHeight(1)
                nav_layout.addSpacing(6)
                nav_layout.addWidget(divisoria)
                nav_layout.addSpacing(4)
            rotulo_grupo = QLabel(titulo_grupo)
            rotulo_grupo.setObjectName("dashboardSidebarGroupLabel")
            rotulo_grupo.setFixedHeight(19)
            rotulo_grupo.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
            rotulo_grupo.setStyleSheet(
                "background: transparent; border: none; padding-left: 4px; "
                "font-size: 8pt; font-weight: 600; "
                f"color: {qss_color('futurista', 'dashboard.subtitle_text')};"
            )
            nav_layout.addWidget(rotulo_grupo)
            self._sidebar_grupos_rotulos.append(rotulo_grupo)
            for chave, rotulo, icone, fallback, acao in itens:
                botao = QPushButton(rotulo)
                botao.setObjectName("dashboardSidebarNavButton")
                botao.setProperty("navSelected", chave == "inicio")
                botao.setFixedHeight(43)
                botao.setCursor(Qt.PointingHandCursor)
                botao.setToolTip(rotulo)
                botao.clicked.connect(lambda _checked=False, fn=acao: fn())
                nav_layout.addWidget(botao)
                self._sidebar_botoes[chave] = botao
                self._sidebar_rotulos[chave] = rotulo
                self._sidebar_icones[chave] = (icone, fallback)
        nav_layout.addStretch(1)
        nav_scroll.setWidget(nav_content)
        self.dashboard_sidebar_nav_scroll = nav_scroll
        self.dashboard_sidebar_scroll_dots = SidebarNavigationDots(
            nav_scroll.verticalScrollBar(), nav_scroll.viewport()
        )
        coluna.addWidget(nav_scroll, 1)

        # PERFIL CANDIDATO P01: acesso global, independente do perfil de edital.
        # Fica no rodape para continuar acessivel com a navegacao recolhida.
        botao_perfil_candidato = QPushButton("Perfil do Candidato")
        botao_perfil_candidato.setObjectName("dashboardSidebarNavButton")
        botao_perfil_candidato.setProperty("navSelected", False)
        botao_perfil_candidato.setFixedHeight(43)
        botao_perfil_candidato.setCursor(Qt.PointingHandCursor)
        botao_perfil_candidato.setToolTip("Abrir Perfil do Candidato")
        botao_perfil_candidato.setAccessibleName("Abrir Perfil do Candidato")
        botao_perfil_candidato.clicked.connect(self.abrir_perfil_candidato)
        coluna.addWidget(botao_perfil_candidato)
        self._sidebar_botoes["perfil_candidato"] = botao_perfil_candidato
        self._sidebar_rotulos["perfil_candidato"] = "Perfil do Candidato"
        self._sidebar_icones["perfil_candidato"] = ("fa6s.id-card", "◉")

        # Busca global fixa no rodape, acima das configuracoes.
        # Compartilha o mesmo controlador de pesquisa do atalho Ctrl+K
        # e acompanha o estado expandido/recolhido da barra lateral.
        botao_pesquisa = QPushButton("Pesquisar")
        botao_pesquisa.setObjectName("dashboardSidebarNavButton")
        botao_pesquisa.setProperty("navSelected", False)
        botao_pesquisa.setFixedHeight(43)
        botao_pesquisa.setCursor(Qt.PointingHandCursor)
        botao_pesquisa.setToolTip("Pesquisar (Ctrl+K)")
        botao_pesquisa.setAccessibleName("Abrir busca global (Ctrl+K)")
        botao_pesquisa.clicked.connect(self.abrir_busca_global)
        coluna.addWidget(botao_pesquisa)
        self._sidebar_botoes["pesquisa"] = botao_pesquisa
        self._sidebar_rotulos["pesquisa"] = "Pesquisar"
        self._sidebar_icones["pesquisa"] = ("fa5s.search", "⌕")

        botao_config = QPushButton("Configurações")
        botao_config.setObjectName("dashboardSidebarNavButton")
        botao_config.setProperty("navSelected", False)
        botao_config.setFixedHeight(43)
        botao_config.setCursor(Qt.PointingHandCursor)
        botao_config.setToolTip("Configurações")
        botao_config.clicked.connect(self.abrir_configuracoes)
        coluna.addWidget(botao_config)
        self._sidebar_botoes["configuracoes"] = botao_config
        self._sidebar_rotulos["configuracoes"] = "Configurações"
        self._sidebar_icones["configuracoes"] = ("fa6s.gear", "⚙")
        # A navegação Futurista inicia recolhida a cada abertura. O botão
        # continua permitindo alternar entre os estados durante a sessão.
        self._sidebar_expandida_manual = False
        self._sidebar_expandida_efetiva = None
        return lateral

    # PERFIL CANDIDATO M04: estrutura visual, sem vinculo academico nesta fase.
    # O brasao principal permanece ausente ate existir meritacao global validada.
    def _perfil_m04_pixmap(self, marco, tamanho):
        tabela = getattr(self, "_perfil_m04_cache_png", None)
        if tabela is None:
            tabela = {}
            self._perfil_m04_cache_png = tabela
        marco = int(marco)
        if marco not in tabela:
            brutos = base64.b64decode(_PERFIL_BRASOES_M04[marco])
            imagem = QPixmap()
            if not imagem.loadFromData(brutos, "PNG"):
                raise ValueError("Imagem do brasao nao pode ser carregada")
            tabela[marco] = imagem
        return tabela[marco].scaled(
            tamanho, tamanho, Qt.KeepAspectRatio, Qt.SmoothTransformation
        )

    def _perfil_m04_nome_atual(self):
        # Identidade de exibicao separada do perfil de concurso/edital.
        return str(QSettings("VighnaStudy", "PerfilCandidato").value(
            "nome_exibicao", "Candidato"
        ) or "Candidato").strip()[:60] or "Candidato"

    def _perfil_m04_salvar_nome(self):
        campo = getattr(self, "_perfil_m04_campo_nome", None)
        if campo is None:
            return
        nome = campo.text().strip()[:60] or "Candidato"
        campo.setText(nome)
        QSettings("VighnaStudy", "PerfilCandidato").setValue(
            "nome_exibicao", nome
        )

    def abrir_perfil_candidato(self):
        pagina = getattr(self, "tela_perfil_candidato", None)
        if pagina is None:
            pagina = QWidget()
            pagina.setObjectName("perfilCandidatoPagina")
            raiz = QVBoxLayout(pagina)
            raiz.setContentsMargins(30, 25, 30, 25)
            raiz.setSpacing(15)
            linha_titulo = QHBoxLayout()
            titulo = QLabel("Perfil do Candidato")
            titulo.setObjectName("perfilCandidatoTitulo")
            linha_titulo.addWidget(titulo, 1)
            voltar = QPushButton("Voltar ao Início")
            voltar.setObjectName("perfilCandidatoVoltar")
            voltar.setCursor(Qt.PointingHandCursor)
            voltar.clicked.connect(self.abrir_portal_inicio)
            linha_titulo.addWidget(voltar)
            raiz.addLayout(linha_titulo)

            painel = QFrame()
            painel.setObjectName("perfilCandidatoPainel")
            cabecalho = QHBoxLayout(painel)
            cabecalho.setContentsMargins(24, 18, 24, 18)
            cabecalho.setSpacing(20)
            icone = QLabel("◇")
            icone.setObjectName("perfilCandidatoBrasao")
            icone.setFixedSize(122, 122)
            icone.setAlignment(Qt.AlignCenter)
            icone.setToolTip("Brasao de merito: aguardando apuracao do historico global")
            icone.setAccessibleName("Brasao de merito ainda nao atribuido")
            cabecalho.addWidget(icone)
            self._perfil_m04_icone_atual = icone

            identidade = QVBoxLayout()
            identidade.setSpacing(8)
            legenda = QLabel("IDENTIDADE DO CANDIDATO")
            legenda.setObjectName("perfilCandidatoChamada")
            identidade.addWidget(legenda)
            nome = QLineEdit(self._perfil_m04_nome_atual())
            nome.setObjectName("perfilCandidatoNome")
            nome.setMaxLength(60)
            nome.setPlaceholderText("Nome de exibicao")
            nome.setToolTip("Nome para exibir no perfil; nao altera concursos")
            nome.editingFinished.connect(self._perfil_m04_salvar_nome)
            self._perfil_m04_campo_nome = nome
            identidade.addWidget(nome)
            estado = QLabel("Brasao e saldo: aguardando validacao do historico global")
            estado.setObjectName("perfilCandidatoSubtitulo")
            estado.setWordWrap(True)
            identidade.addWidget(estado)
            self._perfil_m04_estado = estado
            cabecalho.addLayout(identidade, 1)
            raiz.addWidget(painel)

            # Indicadores ficam abaixo do cabeçalho, nunca sob a insígnia.
            faixa_merito = QFrame()
            faixa_merito.setObjectName("perfilCandidatoFaixaMeritoM05")
            faixa_layout = QVBoxLayout(faixa_merito)
            faixa_layout.setSpacing(7)
            dados_global = QLabel("Saldo global: ainda não apurado")
            dados_global.setObjectName("perfilCandidatoDadosM05")
            self._perfil_m05_dados_global = dados_global
            faixa_layout.addWidget(dados_global)
            proximo = QLabel("Próximo marco: aguardando apuração")
            proximo.setObjectName("perfilCandidatoProximoM05")
            self._perfil_m05_proximo_marco = proximo
            faixa_layout.addWidget(proximo)
            barra = QProgressBar()
            barra.setObjectName("perfilCandidatoProgressoM05")
            barra.setRange(0, 100)
            barra.setTextVisible(False)
            barra.setFixedHeight(9)
            barra.hide()
            self._perfil_m05_barra_progresso = barra
            faixa_layout.addWidget(barra)
            raiz.addWidget(faixa_merito)

            botoes = QHBoxLayout()
            botoes.setSpacing(12)
            ver = QPushButton("Ver catálogo de brasões")
            ver.setObjectName("perfilCandidatoCatalogo")
            ver.setCursor(Qt.PointingHandCursor)
            ver.clicked.connect(self._perfil_m04_abrir_catalogo)
            botoes.addWidget(ver)
            botoes.addStretch(1)
            raiz.addLayout(botoes)
            informativo = QLabel(
                "O catálogo apresenta as 12 conquistas e seus requisitos. "
                "Nenhum marco será considerado desbloqueado antes da auditoria acadêmica."
            )
            informativo.setObjectName("perfilCandidatoSubtitulo")
            informativo.setWordWrap(True)
            raiz.addWidget(informativo)
            raiz.addStretch(1)

            self.tela_perfil_candidato = pagina
            self.telas.addWidget(pagina)
        self._perfil_m04_campo_nome.setText(self._perfil_m04_nome_atual())
        self._perfil_m05_atualizar_painel()
        self._estilizar_perfil_candidato()
        self.telas.setCurrentWidget(pagina)

    # MÉRITO M08 — fonte única para Perfil, catálogo e Bateria de Questões.
    # O adaptador acadêmico real ainda não está conectado (banco.py pendente).
    def _m08_coordenador_atual(self):
        coordenador = getattr(self, "_m08_coordenador", None)
        if coordenador is None:
            from ui.merito.sincronizacao_merito_m08 import CoordenadorMeritoM08
            coordenador = CoordenadorMeritoM08()
            self._m08_coordenador = coordenador
        return coordenador

    def _m08_estado_atual(self):
        return self._m08_coordenador_atual().snapshot()

    def _m08_distribuir_estado(self, estado):
        """Entrega snapshot imutável a uma eventual bateria já aberta."""
        self._perfil_m05_atualizar_painel()
        janela = self.obter_janela_resolvedor_questoes()
        receber = getattr(janela, "_m08_receber_estado_sincronizado", None)
        if callable(receber):
            receber(estado)

    def _m08_publicar_integracao_auditada(self, resultado):
        """Publicação explícita: apenas ResultadoIntegracao M03 validado.

        Não busca histórico, não executa polling nem toca no banco.
        """
        estado, mudou = self._m08_coordenador_atual().publicar(resultado)
        if mudou:
            self._m08_distribuir_estado(estado)
        return estado

    def _m08_invalidar_merito_global(self, motivo):
        """Revoga exibição quando o snapshot deixa de ser confiável."""
        estado, mudou = self._m08_coordenador_atual().invalidar(motivo)
        if mudou:
            self._m08_distribuir_estado(estado)
        return estado

    # M25 — ativação estrita com banco acadêmico oficial e perfil durável.
    # Nunca aceita override de estudos.db ou identidade por variável de ambiente.
    def _m25_habilitar_merito_producao(self):
        if getattr(self, "_m13_ponte_qt", None) is not None:
            return False
        try:
            from ui.merito.ativacao_producao_m25 import preparar_escopo_producao_m25
            from ui.merito.ponte_qt_merito_m15 import PonteMeritoQtM15
            escopo = preparar_escopo_producao_m25()
            ponte = PonteMeritoQtM15(self, escopo, clone_autorizado=False)
            self._m13_ponte_qt = ponte
            return True
        except Exception:
            # Falha fechada: sem insígnia até a próxima inicialização auditada.
            # Não interferir nas questões nem no backup acadêmico existente.
            try:
                self._m08_invalidar_merito_global("Mérito: origem não validada")
            except Exception:
                pass
            return False

    # MÉRITO M13 — ponte Qt OBRIGATORIAMENTE DESATIVADA por padrão.
    # Não há import PySide6 adicional, banco de mérito ou tarefa ao iniciar o app.
    def _m13_habilitar_clone_laboratorio(self, escopo, *,
                                        pasta_identidade, banco_py_clone,
                                        banco_py_referencia, autorizado_clone=False):
        """Habilitação manual EXCLUSIVAMENTE em clone isolado e auditado.

        Chamada proibida na distribuição final até revisão do esquema e build
        Windows. É preciso definir VIGHNA_M13_CLONE_LAB=CONFIRMADO e fornecer
        confirmação expressa, identidade existente e fonte banco.py idêntica
        à referência. Nunca criar automaticamente uma identidade nova.
        """
        if os.environ.get("VIGHNA_M13_CLONE_LAB") != "CONFIRMADO" or autorizado_clone is not True:
            raise RuntimeError("M13 bloqueado: somente clone autorizado")
        from ui.merito.integracao_merito_m11 import EscopoM11
        from ui.merito.identidade_candidato_m12 import obter_identidade
        if not isinstance(escopo, EscopoM11) or escopo.modo != "laboratorio":
            raise RuntimeError("Escopo M13 não é laboratório")
        from backup import ARQUIVO_BANCO
        copia = Path(escopo.banco_academico).resolve(strict=True)
        original = Path(ARQUIVO_BANCO).resolve(strict=False)
        if copia == original or (original.exists() and copia.samefile(original)):
            raise RuntimeError("M13 nunca pode abrir o banco acadêmico da instalação")
        diretorio_clone = Path(escopo.banco_merito).parent.resolve(strict=False)
        if not diretorio_clone.is_dir():
            raise RuntimeError("Pasta lateral de mérito do clone precisa existir")
        if Path(pasta_identidade).resolve(strict=False) != diretorio_clone:
            raise RuntimeError("Identidade deve residir na pasta lateral do próprio clone")
        if Path(__file__).resolve().parent in diretorio_clone.parents or diretorio_clone == Path(__file__).resolve().parent:
            raise RuntimeError("Não gravar mérito sob a instalação do aplicativo")
        identidade = obter_identidade(pasta_identidade)
        if identidade.perfil_id != escopo.perfil_id:
            raise RuntimeError("Identidade persistente não corresponde ao escopo")
        from hashlib import sha256
        fonte_atual = Path(banco_py_clone).resolve(strict=True)
        fonte_ref = Path(banco_py_referencia).resolve(strict=True)
        if fonte_atual == Path(__file__).with_name("banco.py").resolve(strict=False):
            raise RuntimeError("Fonte indicada é o banco.py da instalação, não o clone")
        digest_conhecido = "3f32c1b291ca9781c8572baaaa21f90eb64095d21e2cb4e17c17c3ddb53ae0f8"
        if (sha256(fonte_atual.read_bytes()).hexdigest() != digest_conhecido or
                sha256(fonte_ref.read_bytes()).hexdigest() != digest_conhecido):
            raise RuntimeError("banco.py divergente do SHA-256 homologado para o laboratório")
        from ui.merito.inspecao_schema_m12 import inspecionar_schema
        diagnostico_schema = inspecionar_schema(copia)
        if not diagnostico_schema.compativel:
            raise RuntimeError("Esquema acadêmico do clone incompatível: integração bloqueada")
        if getattr(self, "_m13_ponte_qt", None) is not None:
            raise RuntimeError("Ponte M13 já habilitada")
        # M15 — pool de apuração dedicado e encerramento seguro no clone.
        from ui.merito.ponte_qt_merito_m15 import PonteMeritoQtM15
        ponte = PonteMeritoQtM15(self, escopo, clone_autorizado=True)
        self._m13_ponte_qt = ponte
        return ponte

    def _m15_aguardar_merito_antes_fechamento(self):
        """Não iniciar backup final enquanto apuração lateral estiver em curso.

        Não lê nem grava SQLite; consulta apenas o pool Qt dedicado.
        """
        ponte = getattr(self, "_m13_ponte_qt", None)
        if ponte is None:
            return True
        preparar = getattr(ponte, "iniciar_encerramento", None)
        if not callable(preparar):
            raise RuntimeError("Ponte sem protocolo M15: fechamento seguro bloqueado")
        if not getattr(self, "_m15_sinal_encerramento_conectado", False):
            ponte.encerramento_pronto.connect(self._m15_retomar_fechamento, Qt.QueuedConnection)
            self._m15_sinal_encerramento_conectado = True
        return preparar()

    def _m15_retomar_fechamento(self):
        """Sinal Qt em GUI: retoma fechamento legado uma vez confirmado o pool."""
        if (getattr(self, "_fechamento_solicitado", False)
                and not getattr(self, "_fechamento_em_andamento", False)
                and not getattr(self, "_fechamento_autorizado", False)):
            self._executar_tarefa_fechamento()

    def _m13_registrar_tentativa_academica(self, tentativa_id, *, simulado_aberto):
        ponte = getattr(self, "_m13_ponte_qt", None)
        if ponte is not None:
            try:
                return ponte.registrar_tentativa(tentativa_id, simulado_aberto=simulado_aberto)
            except Exception:
                self._m13_revogar_em_falha("Falha ao registrar evento de mérito")
        return False

    def _m13_simulado_entregue(self):
        ponte = getattr(self, "_m13_ponte_qt", None)
        if ponte is not None:
            try:
                return ponte.simulado_entregue(concluida=True, commit_ok=True)
            except Exception:
                self._m13_revogar_em_falha("Falha ao publicar entrega do simulado")
        return False

    def _m13_revogar_em_falha(self, motivo):
        ponte = getattr(self, "_m13_ponte_qt", None)
        if ponte is not None:
            try:
                ponte.revogar(motivo)
            except Exception:
                self._m08_invalidar_merito_global(motivo)

    # Entrada legada M05 agora encaminha obrigatoriamente ao M08.
    def _perfil_m05_receber_integracao_auditada(self, resultado):
        return self._m08_publicar_integracao_auditada(resultado)

    def _perfil_m05_visao_atual(self):
        return self._m08_estado_atual().visao

    def _perfil_m05_atualizar_painel(self):
        if not hasattr(self, "_perfil_m04_icone_atual"):
            return
        visao = self._perfil_m05_visao_atual()
        icone = self._perfil_m04_icone_atual
        progresso = getattr(self, "_perfil_m05_barra_progresso", None)
        dados = getattr(self, "_perfil_m05_dados_global", None)
        seguinte = getattr(self, "_perfil_m05_proximo_marco", None)
        if not visao.apurado:
            icone.clear()
            icone.setText("◇")
            icone.setToolTip("Brasão ainda não atribuído: aguardando histórico global auditado")
            icone.setAccessibleName("Brasão de mérito ainda não atribuído")
            self._perfil_m04_estado.setText("Mérito global: aguardando apuração do histórico completo")
            if dados is not None:
                dados.setText("Saldo global: ainda não apurado")
            if seguinte is not None:
                seguinte.setText("Próximo marco: aguardando apuração")
            if progresso is not None:
                progresso.setVisible(False)
            return
        if visao.brasao_atual:
            icone.setText("")
            icone.setPixmap(self._perfil_m04_pixmap(visao.brasao_atual, 116))
            icone.setToolTip("Brasão de mérito conquistado")
            icone.setAccessibleName("Brasão conquistado do candidato")
        else:
            icone.clear()
            icone.setText("◇")
            icone.setToolTip("Nenhum brasão conquistado até o momento")
        self._perfil_m04_estado.setText("Mérito baseado no histórico acadêmico global auditado")
        if dados is not None:
            dados.setText("Saldo global: {:+,}   |   Recorde: {:+,}".format(
                visao.saldo, visao.recorde).replace(",", "."))
        if seguinte is not None:
            if visao.proximo_marco is None:
                seguinte.setText("Todos os 12 brasões conquistados")
            else:
                seguinte.setText("Próximo marco: +{:,.0f}   •   Faltam {:,} pontos".format(
                    visao.proximo_marco, visao.faltam).replace(",", "."))
        if progresso is not None:
            progresso.setVisible(visao.proximo_marco is not None)
            progresso.setValue(int(round(visao.progresso_pct or 0)))

    def _perfil_m04_abrir_catalogo(self):
        janela = QDialog(self)
        janela.setWindowTitle("Catálogo de Brasões de Mérito")
        janela.resize(980, 655)
        janela.setMinimumSize(720, 490)
        raiz = QVBoxLayout(janela)
        titulo = QLabel("CATÁLOGO DE BRASÕES")
        titulo.setObjectName("catalogoTituloM04")
        raiz.addWidget(titulo)
        visao = self._perfil_m05_visao_atual()
        if visao.apurado:
            descricao = "Conquistas globais auditadas • os marcos conquistados são permanentes"
        else:
            descricao = "Prévia visual • requisitos oficiais • desbloqueios ainda não apurados"
        nota = QLabel(descricao)
        nota.setWordWrap(True)
        nota.setObjectName("catalogoNotaM04")
        raiz.addWidget(nota)
        rolagem = QScrollArea()
        rolagem.setWidgetResizable(True)
        rolagem.setFrameShape(QFrame.NoFrame)
        rolagem.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        conteudo = QWidget()
        grade = QGridLayout(conteudo)
        grade.setContentsMargins(7, 7, 7, 7)
        grade.setSpacing(12)
        for indice, cartao in enumerate(visao.cartoes):
            marco = cartao.marco
            bloco = QFrame()
            bloco.setObjectName("catalogoBrasaoCardM04")
            coluna = QVBoxLayout(bloco)
            coluna.setContentsMargins(8, 12, 8, 12)
            coluna.setSpacing(6)
            figura = QLabel()
            figura.setAlignment(Qt.AlignCenter)
            figura.setMinimumHeight(137)
            figura.setPixmap(self._perfil_m04_pixmap(marco, 134))
            if cartao.estado == "bloqueado":
                from PySide6.QtWidgets import QGraphicsOpacityEffect
                filtro = QGraphicsOpacityEffect(figura)
                filtro.setOpacity(0.42)
                figura.setGraphicsEffect(filtro)
            coluna.addWidget(figura)
            nome = QLabel(_PERFIL_NOMES_M04[marco])
            nome.setAlignment(Qt.AlignCenter)
            nome.setWordWrap(True)
            nome.setObjectName("catalogoNomeM04")
            coluna.addWidget(nome)
            meta = QLabel(f"Marco: +{marco:,}".replace(",", "."))
            meta.setAlignment(Qt.AlignCenter)
            meta.setObjectName("catalogoMarcoM04")
            coluna.addWidget(meta)
            if cartao.estado == "conquistado":
                situacao = "Conquistado" + (" • Brasão atual" if cartao.destaque_atual else "")
            elif cartao.estado == "bloqueado":
                situacao = "Bloqueado"
            else:
                situacao = "Aguardando apuração"
            status = QLabel(situacao)
            status.setAlignment(Qt.AlignCenter)
            status.setObjectName("catalogoEstadoM04")
            coluna.addWidget(status)
            grade.addWidget(bloco, indice // 3, indice % 3)
        rolagem.setWidget(conteudo)
        raiz.addWidget(rolagem, 1)
        fechar = QPushButton("Fechar")
        fechar.setCursor(Qt.PointingHandCursor)
        fechar.clicked.connect(janela.accept)
        raiz.addWidget(fechar, 0, Qt.AlignRight)

        tema = normalizar_tema(getattr(self, "tema_atual", "claro"))
        if tema == "claro":
            fundo, cartao, borda = "#F1F5F9", "#FFFFFF", "#B4C7DA"
            texto, secundario, acento = "#18324B", "#62778B", "#1D74A3"
        elif tema == "futurista":
            fundo, cartao, borda = "#07142A", "#10243B", "#2C7799"
            texto, secundario, acento = "#E8F4FC", "#A7C1D1", "#6DDDF4"
        else:
            fundo, cartao, borda = "#101924", "#1E2C3B", "#416079"
            texto, secundario, acento = "#E7F1FA", "#ACBDCD", "#72CBE9"
        janela.setStyleSheet(f"""
            QDialog {{ background: {fundo}; }}
            QLabel {{ color: {texto}; background: transparent; }}
            QLabel#catalogoTituloM04 {{ font-size: 17pt; font-weight: 700; color: {acento}; }}
            QLabel#catalogoNotaM04 {{ color: {secundario}; font-size: 10pt; }}
            QScrollArea {{ background: transparent; border: none; }}
            QScrollArea > QWidget > QWidget {{ background: transparent; }}
            QFrame#catalogoBrasaoCardM04 {{ background: {cartao}; border: 1px solid {borda}; border-radius: 11px; }}
            QFrame#catalogoBrasaoCardM04 QLabel {{ border: none; background: transparent; }}
            QLabel#catalogoNomeM04 {{ font-weight: 600; font-size: 10pt; }}
            QLabel#catalogoMarcoM04 {{ color: {acento}; font-weight: 600; }}
            QLabel#catalogoEstadoM04 {{ color: {secundario}; font-size: 9pt; }}
            QPushButton {{ background: {cartao}; color: {texto}; border: 1px solid {borda}; border-radius: 8px; padding: 9px 14px; }}
            QPushButton:hover {{ border-color: {acento}; }}
        """)
        janela.exec()

    def _estilizar_perfil_candidato(self):
        pagina = getattr(self, "tela_perfil_candidato", None)
        if pagina is None:
            return
        tema = normalizar_tema(getattr(self, "tema_atual", "claro"))
        if getattr(self, "_perfil_candidato_tema", None) == tema:
            return
        if tema == "claro":
            fundo, cartao, borda = "#F4F7FB", "#FFFFFF", "#C9D7E6"
            texto, secundario, acento = "#14283D", "#52667A", "#176D9D"
        elif tema == "futurista":
            fundo, cartao, borda = "transparent", "rgba(7,22,44,0.91)", "#2C7799"
            texto, secundario, acento = "#E8F5FC", "#A8C5D8", "#6DDDF4"
        else:
            fundo, cartao, borda = "#111925", "#1B2837", "#38516B"
            texto, secundario, acento = "#EAF3FA", "#ACBECD", "#72CBE9"
        pagina.setStyleSheet(f"""
            QWidget#perfilCandidatoPagina {{ background: {fundo}; }}
            QLabel#perfilCandidatoTitulo {{ color: {texto}; font-size: 21pt; font-weight: 700; }}
            QFrame#perfilCandidatoPainel {{ background: {cartao}; border: 1px solid {borda}; border-radius: 14px; }}
            QLabel#perfilCandidatoBrasao {{ color: {acento}; background: transparent; font-size: 32pt; border: none; }}
            QLabel#perfilCandidatoChamada {{ color: {acento}; font-weight: 700; font-size: 10pt; background: transparent; }}
            QLabel#perfilCandidatoSubtitulo {{ color: {secundario}; font-size: 10pt; background: transparent; }}
            QFrame#perfilCandidatoFaixaMeritoM05 {{ background: {cartao}; border: 1px solid {borda}; border-radius: 10px; }}
            QLabel#perfilCandidatoDadosM05, QLabel#perfilCandidatoProximoM05 {{ color: {texto}; background: transparent; border: none; font-size: 10pt; }}
            QProgressBar#perfilCandidatoProgressoM05 {{ border: none; border-radius: 4px; background: {borda}; }}
            QProgressBar#perfilCandidatoProgressoM05::chunk {{ border-radius: 4px; background: {acento}; }}
            QLineEdit#perfilCandidatoNome {{ color: {texto}; background: {cartao}; border: 1px solid {borda}; border-radius: 8px; font-size: 15pt; font-weight: 700; padding: 5px 12px; }}
            QPushButton#perfilCandidatoVoltar, QPushButton#perfilCandidatoCatalogo {{ color: {texto}; background: {cartao}; border: 1px solid {borda}; border-radius: 9px; padding: 9px 14px; }}
            QPushButton#perfilCandidatoCatalogo:hover, QPushButton#perfilCandidatoVoltar:hover {{ border-color: {acento}; }}
        """)
        self._perfil_candidato_tema = tema

    def _atualizar_perfil_portal(self, _indice=None):
        pagina = getattr(self, "tela_portal_inicio", None)
        if pagina is None:
            return
        rotulo = getattr(pagina, "portal_perfil_label", None)
        if rotulo is not None:
            rotulo.setText("Perfil ativo: " + (self.combo_concurso.currentText().strip() or "—"))
        atualizar_perfil_mini_edital(pagina, self.combo_concurso.currentText())
        edital = getattr(self, "tela_portal_edital", None)
        if edital is not None:
            atualizar_perfil_portal_edital(edital, self.combo_concurso.currentText())

    def abrir_portal_edital(self):
        """Abre o setor relacionado ao concurso atualmente selecionado."""
        self._atualizar_perfil_portal()
        self.telas.setCurrentWidget(self.tela_portal_edital)

    def abrir_portal_inicio(self):
        """Abre somente o portal, sem atualizar ou interromper sessoes existentes."""
        self.telas.setCurrentWidget(self.tela_portal_inicio)
        self._atualizar_perfil_portal()

    def _atualizar_retomada_no_portal_treinos(self):
        """Atualiza o acesso somente para uma bateria ainda aberta e ativa."""
        portal = getattr(self, "tela_portal_treinos", None)
        if portal is None:
            return
        janela = self.obter_janela_resolvedor_questoes()
        existe_sessao = janela is not None and not bool(getattr(janela, "finalizada", False))
        detalhes = ""
        if existe_sessao:
            configuracao = getattr(janela, "configuracao", {}) or {}
            modalidade = str(configuracao.get("modo") or janela.windowTitle()).strip()
            indice = max(0, int(getattr(janela, "indice", 0)))
            quantidade = len(getattr(janela, "fila", []) or [])
            if quantidade:
                detalhes = f"{modalidade}  •  Questão {min(indice + 1, quantidade)} de {quantidade}"
            else:
                detalhes = modalidade
        atualizar_retomada_treinos(portal, existe_sessao, detalhes)

    def _transferir_quadro_estudo_questoes_para_simulados(self):
        """Move o QFrame original e os quatro subcards do Dashboard ao portal.

        O próprio QWidget, os layouts e os sinais dos botões são reaproveitados.
        O wrapper visual mantém o seletor #dashboardRoot para que os tokens
        originais do quadro permaneçam idênticos à origem, sem clonar widgets.
        """
        painel = self.dashboard_estudo_questoes_painel
        origem = self.dashboard_estrategias_slot
        destino = self.tela_portal_treinos.portal_treinos_conteudo_layout
        assert origem.indexOf(painel) >= 0, "Quadro original fora do Dashboard"
        assert destino is not None, "Portal de Simulados sem layout de destino"

        # Retirar também o layout vazio do Dashboard: sem quadro residual,
        # placeholder ou espaçamento extra entre as outras seções.
        origem.removeWidget(painel)
        self._dashboard_root_layout.removeItem(origem)

        raiz_visual = QWidget(self.tela_portal_treinos)
        raiz_visual.setObjectName("dashboardRoot")
        raiz_visual.setAttribute(Qt.WA_StyledBackground, True)
        raiz_visual.setStyleSheet(self.dashboard_visual_root.styleSheet())
        raiz_visual.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
        coluna = QVBoxLayout(raiz_visual)
        coluna.setContentsMargins(0, 0, 0, 0)
        coluna.setSpacing(0)
        coluna.addWidget(painel)
        # Logo após o cabeçalho; nenhuma modalidade pré-existente é removida.
        destino.insertWidget(1, raiz_visual)
        self._portal_estudo_questoes_raiz = raiz_visual

        # A seção veio recolhida do Dashboard Executivo? Exibir os quatro
        # cards na Central sem sobrescrever a preferência salva do Dashboard.
        self.definir_estado_secao_dashboard("estudar", True, salvar=False)

    def _transferir_cards_dashboard_para_portal_edital(self):
        """Move os widgets reais do Dashboard para Meu Edital, sem copiá-los.

        Só procede se os três painéis e o layout de destino existirem. Em
        caso de incompatibilidade, mantém os cards no Dashboard em vez de
        inserir em um layout aleatório ou interromper a inicialização.
        """
        if getattr(self, "_portal_edital_dashboard_raiz", None) is not None:
            return True
        portal = getattr(self, "tela_portal_edital", None)
        origem = getattr(self, "_dashboard_root_layout", None)
        destino = getattr(portal, "portal_edital_conteudo_layout", None)
        ancora = getattr(portal, "portal_edital_cards_anchor", None)
        cards = [
            getattr(self, "dashboard_resumo_painel", None),
            getattr(self, "dashboard_notificacoes_painel", None),
            getattr(self, "dashboard_planejamento_painel", None),
        ]
        if (origem is None or destino is None or ancora is None
                or any(card is None or origem.indexOf(card) < 0 for card in cards)
                or destino.indexOf(ancora) < 0):
            return False

        raiz = QWidget(portal)
        raiz.setObjectName("dashboardRoot")
        raiz.setAttribute(Qt.WA_StyledBackground, True)
        raiz.setStyleSheet(self.dashboard_visual_root.styleSheet())
        raiz.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
        coluna = QVBoxLayout(raiz)
        coluna.setContentsMargins(0, 0, 0, 0)
        coluna.setSpacing(14)

        for card in cards:
            origem.removeWidget(card)
            coluna.addWidget(card)
        destino.insertWidget(destino.indexOf(ancora), raiz)
        self._portal_edital_dashboard_raiz = raiz

        # Apenas os painéis transferidos: o Planejamento do topo conserva
        # seus widgets e sua posição no Dashboard.
        for chave in ("resumo", "notificacoes", "planejamento"):
            self.definir_estado_secao_dashboard(chave, True, salvar=False)
        return True

    def abrir_portal_treinos(self):
        """Mostra a Central imediatamente; sincroniza retomada no próximo ciclo."""
        # Monitor leve, temporário: quando o Windows deixa de receber eventos,
        # registra a pilha Python sem consultar nem alterar o banco de estudos.
        from ui.diagnostico_treinos import MonitorNavegacaoTreinos
        anterior = getattr(self, "_monitor_navegacao_treinos", None)
        if anterior is not None:
            anterior.encerrar()
        monitor = MonitorNavegacaoTreinos()
        self._monitor_navegacao_treinos = monitor
        monitor.marcar("antes_de_abrir_pagina")
        self.telas.setCurrentWidget(self.tela_portal_treinos)
        monitor.marcar("pagina_aberta")

        def primeiro_ciclo():
            if getattr(self, "_monitor_navegacao_treinos", None) is not monitor:
                return
            monitor.marcar("antes_de_atualizar_retomada")
            self._atualizar_retomada_no_portal_treinos()
            monitor.marcar("retomada_atualizada")

        def pulso_gui():
            if getattr(self, "_monitor_navegacao_treinos", None) is not monitor:
                return
            if not monitor.ativo:
                return
            monitor.pulso()
            QTimer.singleShot(250, pulso_gui)

        QTimer.singleShot(0, primeiro_ciclo)
        QTimer.singleShot(0, pulso_gui)

    def abrir_portal_recursos(self):
        """Mostra o catálogo sem destruir nem recarregar sessões existentes."""
        self.telas.setCurrentWidget(self.tela_portal_recursos)

    def abrir_disciplinas_topicos_perfil(self):
        """Abre a tela exclusiva do perfil com acesso à edição dos tópicos."""
        pagina = self.tela_portal_disciplinas
        pagina.atualizar(self.combo_concurso.currentText().strip())
        self.telas.setCurrentWidget(pagina)

    def _voltar_da_disciplina(self):
        """Retorna à lista exclusiva se a disciplina foi aberta por ela."""
        if self._origem_tela_disciplina is getattr(self, "tela_portal_disciplinas", None):
            self.abrir_disciplinas_topicos_perfil()
        else:
            self.voltar_inicio()

    def _destinos_portal_recursos(self):
        """Mapeia cada item para um controlador já existente, sem novos motores."""
        return {
            "inicio": self.abrir_portal_inicio,
            "dashboard": self.voltar_inicio,
            "simulados_treinos": self.abrir_portal_treinos,
            "foco": self.abrir_modo_foco,
            "disciplinas": self.abrir_disciplinas_topicos_perfil,
            "algoritmo": lambda: self.ir_para_secao_dashboard(
                widget=getattr(self, "dashboard_hoje_acao", None)),
            "jornada": self.abrir_jornada_do_dia,
            "questoes": self.abrir_questoes,
            "bateria": lambda: self._abrir_treino_pelo_portal("bateria"),
            "simulado": lambda: self._abrir_treino_pelo_portal("simulado"),
            "adaptativo": lambda: self._abrir_treino_pelo_portal("adaptativo"),
            "revisao": lambda: self._abrir_treino_pelo_portal("revisao"),
            "banco_erros": self.abrir_banco_erros,
            "historico": self.abrir_historico_questoes,
            "calendario": self.abrir_calendario,
            "plano_acao": self.abrir_plano_acao_automatico,
            "config_planejamento": self.abrir_configuracao_planejamento,
            "fechamento": self.abrir_fechamento_semanal,
            "estatisticas": self.abrir_estatisticas,
            "relatorios": self.abrir_relatorios,
            "progresso_edital": self.abrir_progresso_edital,
            "previsao_edital": self.abrir_previsao_edital,
            "alertas": self.abrir_alertas_conteudo,
            "pausa": self.abrir_pausa_desafios,
            "perfis": self.abrir_concursos,
            "configuracoes": self.abrir_configuracoes,
            "diagnostico": self.abrir_diagnostico_vighna,
        }

    def _abrir_treino_pelo_portal(self, modalidade):
        """Reutiliza a logica original e evita uma segunda bateria paralela."""
        if self.obter_janela_resolvedor_questoes() is not None:
            self.abrir_ou_trazer_resolvedor_questoes()
            return
        destinos = {
            "simulado": self.abrir_simulado,
            "adaptativo": self.abrir_treino_adaptativo,
            "bateria": self.resolver_questoes,
            "revisao": self.abrir_revisao_inteligente_dashboard,
        }
        destinos[modalidade]()
        self._atualizar_retomada_no_portal_treinos()

    def _atualizar_perfil_sidebar(self, _indice=None):
        if not hasattr(self, "dashboard_sidebar_perfil"):
            return
        nome = self.combo_concurso.currentText().strip()
        self.dashboard_sidebar_perfil.setText(nome or "Perfil ativo")

    def _alternar_sidebar_dashboard(self):
        """Alterna a lateral sem forçar ocultação de rótulos em 1366 px."""
        largura = self.width()
        # Colapso manual continua disponível; expansão manual requer espaço
        # real para duas colunas legíveis e rolagem dos módulos.
        if largura < 1180:
            return
        self._sidebar_expandida_manual = not bool(self._sidebar_expandida_efetiva)
        self._atualizar_layout_sidebar()

    def _ajustar_cabecalho_dashboard(self, compacto):
        """Usa uma linha no Futurista com sidebar, sem perder o fallback.

        A busca permanece oculta na lateral e continua na posição original
        no Claro/Escuro ou quando a janela não comporta a sidebar.
        Não recria widgets nem desconecta os seus sinais.
        """
        grade = getattr(self, "_dashboard_top_grid", None)
        perfil = getattr(self, "_dashboard_top_profile", None)
        busca = getattr(self, "botao_busca_global", None)
        if grade is None or perfil is None or busca is None:
            return
        if getattr(self, "_dashboard_cabecalho_compacto", None) == compacto:
            return
        self._dashboard_cabecalho_compacto = compacto
        grade.removeWidget(busca)
        grade.removeWidget(perfil)
        if compacto:
            # A busca agora esta na sidebar. Perfil e acoes globais
            # dividem uma unica linha, reduzindo a altura do cabecalho.
            grade.addWidget(busca, 1, 1, Qt.AlignVCenter)
            grade.addWidget(perfil, 0, 1, Qt.AlignLeft | Qt.AlignVCenter)
            grade.setVerticalSpacing(0)
        else:
            # Restaurar a distribuicao original dos temas Claro/Escuro
            # e do Futurista em janelas estreitas.
            grade.addWidget(busca, 0, 1, Qt.AlignVCenter)
            grade.addWidget(perfil, 1, 1, Qt.AlignLeft | Qt.AlignVCenter)
            grade.setVerticalSpacing(4)
        grade.invalidate()
        self._dashboard_top_container.updateGeometry()

    def _ajustar_densidade_dashboard_lateral(self, futurista, visivel, expandida):
        """Controla apenas geometria visual, sem alterar dados ou ações.

        Referências à árvore de widgets são guardadas depois da construção
        inicial. Restaurar valores originais protege Claro/Escuro.
        """
        if not hasattr(self, "_dashboard_root_layout"):
            return
        compacto = futurista and visivel and expandida and self.width() < 1600
        assinatura = (futurista, compacto, visivel, expandida, bool(futurista and self.width() >= 1200))
        if getattr(self, "_dashboard_densidade_estado", None) == assinatura:
            return
        self._dashboard_densidade_estado = assinatura
        if compacto:
            self._dashboard_root_layout.setContentsMargins(17, 10, 17, 17)
            self._dashboard_root_layout.setSpacing(12)
            self._dashboard_foco_painel_layout.setContentsMargins(0, 0, 0, 0)
            # Modo compacto: preservar proporções, reduzir apenas respiro.
            self._dashboard_foco_card_layout.setContentsMargins(15, 11, 15, 11)
            self._dashboard_planejamento_layout.setContentsMargins(12, 9, 12, 9)
            self._dashboard_primeira_linha.setSpacing(12)
            self._dashboard_primeira_linha.setStretch(0, 13)
            self._dashboard_primeira_linha.setStretch(1, 12)
            self._dashboard_recomendacao_linha.setSpacing(12)
            self._dashboard_recomendacao_linha.setStretch(0, 17)
            self._dashboard_recomendacao_linha.setStretch(1, 8)
        else:
            # O Futurista com sidebar dispensa parte do respiro antes
            # do cabecalho; os outros temas preservam a geometria.
            self._dashboard_root_layout.setContentsMargins(
                28, 10 if futurista and visivel else 16, 28, 20
            )
            self._dashboard_root_layout.setSpacing(14)
            self._dashboard_foco_painel_layout.setContentsMargins(0, 0, 0, 0)
            self._dashboard_foco_card_layout.setContentsMargins(22, 17, 22, 17)
            self._dashboard_planejamento_layout.setContentsMargins(18, 13, 18, 13)
            self._dashboard_primeira_linha.setSpacing(14)
            self._dashboard_primeira_linha.setStretch(0, 13)
            self._dashboard_primeira_linha.setStretch(1, 12)
            self._dashboard_recomendacao_linha.setSpacing(14)
            self._dashboard_recomendacao_linha.setStretch(0, 17)
            self._dashboard_recomendacao_linha.setStretch(1, 8)

        self._ajustar_composicao_dashboard_futurista(futurista)
        self._ajustar_altura_independente_recomendacao(futurista)

    def _ajustar_composicao_dashboard_futurista(self, futurista):
        """R7: hero da Recomendação à esquerda; à direita Foco/XP/Plano.

        Move as MESMAS instâncias Qt e preserva todos os sinais, cálculos,
        acessos ao banco e ações. Restaura integralmente o layout histórico
        nos outros temas e em larguras inferiores a 1200px.
        """
        # M2-D1C: geometria externa do Futurista pertence ao controlador Qt.
        # Os layouts legados continuam disponíveis exclusivamente para rollback
        # e mudança de tema, até a unificação visual definitiva.
        # Se o tema sair do Futurista, devolver o widget ativo ao seu
        # layout antes do controlador Qt restaurar a composicao anterior.
        if not futurista:
            orb_panels = getattr(self, "_dashboard_orb_panels", None)
            if orb_panels is not None:
                orb_panels.close()
        controller = getattr(self, "_dashboard_m2d1c_controller", None)
        if controller is not None and controller.active:
            if futurista:
                controller.request_update()
                return
            controller.deactivate()
        refs = getattr(self, "_dashboard_modelo_refs", None)
        if not refs:
            return
        usar = bool(futurista and self.width() >= 1200)
        if usar == getattr(self, "_dashboard_hero_reordenado", False):
            return
        raiz = refs["raiz"]
        topo = refs["topo"]
        antiga_inferior = refs["inferior"]
        foco = refs["foco"]
        plano = refs["planejamento_container"]
        plano_card = self.dashboard_resumo_ia
        recomendacao = self.dashboard_hoje_acao
        progresso = refs["progresso"]
        progresso_layout = refs["progresso_layout"]
        plan_layout = self._dashboard_planejamento_layout
        corpo_metas = refs["operacao"]
        acao_layout = recomendacao.layout()

        if usar:
            # Guardar as margens uma única vez para reversão segura de tema.
            if not hasattr(self, "_dashboard_hero_original_foco"):
                l = self._dashboard_foco_card_layout
                m = l.contentsMargins()
                self._dashboard_hero_original_foco = (
                    (m.left(), m.top(), m.right(), m.bottom()), l.spacing()
                )

            # Novo arranjo em duas colunas inspirado no esquema simplificado:
            # recomendação em destaque à esquerda, foco no topo direito e,
            # abaixo, progresso e planejamento lado a lado.
            topo.removeWidget(plano)
            topo.removeWidget(foco)
            antiga_inferior.removeWidget(recomendacao)
            antiga_inferior.removeWidget(progresso)
            if not hasattr(self, "_dashboard_hero_direita"):
                direita = QWidget(self.dashboard_hoje_painel)
                direita.setObjectName("dashboardHeroRightColumn")
                coluna = QVBoxLayout(direita)
                coluna.setContentsMargins(0, 0, 0, 0)
                coluna.setSpacing(8)
                self._dashboard_hero_direita = direita
                self._dashboard_hero_coluna = coluna
            if not hasattr(self, "_dashboard_hero_bottom_row"):
                faixa = QWidget(self.dashboard_hoje_painel)
                faixa.setObjectName("dashboardHeroBottomRow")
                linha = QHBoxLayout(faixa)
                linha.setContentsMargins(0, 0, 0, 0)
                linha.setSpacing(8)
                self._dashboard_hero_bottom_row = faixa
                self._dashboard_hero_bottom_layout = linha
            direita = self._dashboard_hero_direita
            coluna = self._dashboard_hero_coluna
            faixa = self._dashboard_hero_bottom_row
            linha = self._dashboard_hero_bottom_layout
            coluna.addWidget(foco)
            coluna.addWidget(faixa)
            # Mantém a dupla de baixo logo após o Foco. Sem este alinhamento,
            # a coluna distribui o excesso de altura em um vazio central.
            coluna.setAlignment(Qt.AlignTop)
            direita.setFixedHeight(382)
            linha.addWidget(progresso, 1)
            linha.addWidget(plano, 1)
            topo.addWidget(recomendacao, 56)
            topo.addWidget(direita, 44)
            topo.setAlignment(recomendacao, Qt.AlignTop)
            topo.setAlignment(direita, Qt.AlignTop)
            topo.setStretch(0, 56)
            topo.setStretch(1, 44)
            topo.setSpacing(12)
            raiz.setSpacing(0)
            direita.show()
            faixa.show()

            # Hero: a arte recebe o conteúdo, não substitui widgets funcionais.
            recomendacao.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
            recomendacao.setMinimumHeight(382)
            recomendacao.setMaximumHeight(382)
            recomendacao.set_hero_enabled(True)
            if getattr(self, "_dashboard_hero_cabecalho", None) is not None:
                self._dashboard_hero_cabecalho.hide()
            for widget in self._dashboard_algo_header_widgets:
                widget.hide()
            acao_layout.setContentsMargins(20, 8, 20, 10)
            acao_layout.setSpacing(1)
            # Sem cabeçalho adicional: a faixa superior já vem pronta na arte.
            # O bloco funcional permanece na metade inferior do card.
            acao_layout.setStretch(1, 1)
            acao_layout.setStretch(3, 0)
            corpo = recomendacao.findChild(QFrame, "algorithmRecommendationBody")
            if corpo is not None:
                corpo.setStyleSheet(
                    "QFrame#algorithmRecommendationBody {background:transparent;"
                    "border:none;border-radius:0px;}"
                )
                corpo.setMaximumHeight(92)
                corpo.setMinimumHeight(84)
                corpo.layout().setContentsMargins(0, 0, 0, 0)
                corpo.layout().setVerticalSpacing(2)
            self.dashboard_algoritmo_pronto.setStyleSheet(
                "font-size:13px;font-weight:700;color:#F2F9FF;"
                "background:transparent;border:none;"
            )
            self.dashboard_hoje_um_clique.setMinimumWidth(0)
            self.dashboard_hoje_um_clique.setMaximumWidth(16777215)
            self.dashboard_hoje_um_clique.setFixedHeight(35)
            self.dashboard_hoje_um_clique.setStyleSheet(
                "QPushButton#dashboardTodayPrimaryButton {"
                "color:#FFFFFF;font-size:14px;font-weight:700;"
                "background:qlineargradient(x1:0,y1:0,x2:1,y2:0,"
                "stop:0 #048cc6,stop:0.5 #04aff4,stop:1 #088ac6);"
                "border:2px solid #00DDF5;border-radius:11px;padding:3px 11px;}"
                "QPushButton#dashboardTodayPrimaryButton:hover {"
                "background:#15B5E7;border-color:#61EDFF;}"
            )
            self.dashboard_hoje_botao.setStyleSheet(
                "QPushButton#dashboardTodayButton {background:transparent;"
                "border:none;color:#DBEAF9;font-size:11px;text-decoration:underline;}"
            )

            # Coluna Foco: eliminar duplicações visuais, sem eliminar registros.
            foco.setMinimumHeight(158)
            foco.setMaximumHeight(170)
            self._dashboard_foco_card_layout.setContentsMargins(14, 9, 14, 9)
            self._dashboard_foco_card_layout.setSpacing(3)
            self._dashboard_foco_descricao_widget.hide()
            self.dashboard_focus_last_session.hide()
            self.dashboard_focus_best_week.hide()
            self.dashboard_iniciar_foco.setFixedHeight(48)
            # Progresso conserva o layout vertical e XP/conquistas dinamicos.
            progresso.setMinimumHeight(186)
            progresso.setMaximumHeight(198)
            progresso_layout.setDirection(QBoxLayout.TopToBottom)
            progresso_layout.setContentsMargins(13, 9, 13, 9)
            progresso_layout.setSpacing(4)
            refs["progresso_botao"].setMinimumWidth(0)
            refs["progresso_botao"].setMaximumWidth(16777215)
            refs["progresso_botao"].setFixedHeight(34)

            # Planejamento: meta acima dos indicadores, não estreitada em coluna.
            if not hasattr(self, "_dashboard_planejamento_compacto_widget"):
                wrapper = QWidget(plano_card)
                wrapper.setObjectName("dashboardPlanningCompactBody")
                h = QHBoxLayout(wrapper)
                h.setContentsMargins(0, 0, 0, 0)
                h.setSpacing(6)
                compat = self._dashboard_planejamento_compat
                compat.setObjectName("dashboardPlanningInlineMetric")
                cv = QVBoxLayout(compat)
                cv.setContentsMargins(0, 0, 0, 0)
                cv.setSpacing(3)
                subt = QLabel("META DE QUESTÕES", compat)
                subt.setStyleSheet("color:#00CDEA;font-size:11px;")
                self.dashboard_planejamento_resumo_meta_diaria.setStyleSheet(
                    "color:#F3FAFF;font-size:19px;font-weight:700;"
                )
                self.dashboard_resumo_meta_barra.setFixedHeight(7)
                cv.addWidget(subt)
                cv.addWidget(self.dashboard_planejamento_resumo_meta_diaria)
                cv.addWidget(self.dashboard_resumo_meta_barra)
                cv.addWidget(self.dashboard_planejamento_resumo_meta_diaria_detalhe)
                h.addWidget(compat, 1)
                self._dashboard_planejamento_compacto_widget = wrapper
                self._dashboard_planejamento_compacto_layout = h
            wrapper = self._dashboard_planejamento_compacto_widget
            plan_layout.removeWidget(corpo_metas)
            self._dashboard_planejamento_compacto_layout.addWidget(corpo_metas, 2)
            self._dashboard_planejamento_compacto_layout.setDirection(QBoxLayout.TopToBottom)
            plan_layout.insertWidget(2, wrapper)
            self._dashboard_planejamento_meta_titulo.hide()
            self.dashboard_planejamento_meta_gauge.hide()
            self._dashboard_planejamento_compat.show()
            wrapper.show()
            plan_layout.setContentsMargins(12, 8, 12, 8)
            plan_layout.setSpacing(2)
            plano.setMinimumHeight(186)
            plano.setMaximumHeight(198)
            plano_card.setMinimumHeight(186)
            plano_card.setMaximumHeight(198)
            self.dashboard_planejamento_resumo_botao.setFixedHeight(31)
            self.dashboard_planejamento_resumo_botao.setMaximumWidth(16777215)

            # O portal inicial continua com o proprio cabeçalho. No Dashboard,
            # a referencia R7 inclui a faixa discreta e a busca.
            self.dashboard_quick_nav.setVisible(True)
        else:
            # Reversão para Claro/Escuro ou largura estreita sem recriar cards.
            topo.removeWidget(recomendacao)
            topo.removeWidget(self._dashboard_hero_direita)
            coluna = self._dashboard_hero_coluna
            coluna.removeWidget(foco)
            if hasattr(self, "_dashboard_hero_bottom_layout"):
                self._dashboard_hero_bottom_layout.removeWidget(progresso)
                self._dashboard_hero_bottom_layout.removeWidget(plano)
            if hasattr(self, "_dashboard_hero_bottom_row"):
                coluna.removeWidget(self._dashboard_hero_bottom_row)
                self._dashboard_hero_bottom_row.hide()
            self._dashboard_hero_direita.setMinimumHeight(0)
            self._dashboard_hero_direita.setMaximumHeight(16777215)
            self._dashboard_hero_direita.hide()
            topo.addWidget(foco, 13)
            topo.addWidget(plano, 12)
            topo.setStretch(0, 13)
            topo.setStretch(1, 12)
            topo.setSpacing(14)
            antiga_inferior.addWidget(recomendacao, 17)
            antiga_inferior.addWidget(progresso, 8)
            antiga_inferior.setStretch(0, 17)
            antiga_inferior.setStretch(1, 8)
            raiz.setSpacing(6)
            recomendacao.set_hero_enabled(False)
            if getattr(self, "_dashboard_hero_cabecalho", None) is not None:
                self._dashboard_hero_cabecalho.hide()
            for widget in self._dashboard_algo_header_widgets:
                widget.show()
            acao_layout.setContentsMargins(17, 13, 17, 13)
            acao_layout.setSpacing(6)
            acao_layout.setStretch(1, 1)
            acao_layout.setStretch(3, 1)
            self.dashboard_algoritmo_pronto.setStyleSheet("")
            self.dashboard_hoje_um_clique.setStyleSheet("")
            self.dashboard_hoje_botao.setStyleSheet("")
            corpo = recomendacao.findChild(QFrame, "algorithmRecommendationBody")
            if corpo is not None:
                corpo.setMinimumHeight(96)
                corpo.setMaximumHeight(16777215)
                corpo.layout().setContentsMargins(12, 7, 12, 7)
                corpo.layout().setVerticalSpacing(4)
            foco.setMinimumHeight(320)
            foco.setMaximumHeight(16777215)
            margens, spacing = self._dashboard_hero_original_foco
            self._dashboard_foco_card_layout.setContentsMargins(*margens)
            self._dashboard_foco_card_layout.setSpacing(spacing)
            self._dashboard_foco_descricao_widget.show()
            self.dashboard_focus_last_session.show()
            self.dashboard_focus_best_week.show()
            progresso_layout.setDirection(QBoxLayout.TopToBottom)
            progresso_layout.setContentsMargins(14, 11, 14, 10)
            progresso_layout.setSpacing(7)
            progresso.setMinimumHeight(211)
            progresso.setMaximumHeight(16777215)
            refs["progresso_botao"].setMinimumWidth(0)
            refs["progresso_botao"].setMaximumWidth(16777215)
            refs["progresso_botao"].setFixedHeight(37 if futurista else 32)
            plan_layout.removeWidget(wrapper)
            self._dashboard_planejamento_compacto_layout.removeWidget(corpo_metas)
            plan_layout.insertWidget(2, corpo_metas)
            wrapper.hide()
            self._dashboard_planejamento_compat.hide()
            self._dashboard_planejamento_meta_titulo.show()
            self.dashboard_planejamento_meta_gauge.show()
            plan_layout.setContentsMargins(18, 13, 18, 13)
            plan_layout.setSpacing(5)
            plano.setMinimumHeight(320)
            plano.setMaximumHeight(16777215)
            plano_card.setMinimumHeight(320)
            plano_card.setMaximumHeight(16777215)
            self.dashboard_quick_nav.setVisible(not futurista)

        self._dashboard_modelo_reordenado = usar
        self._dashboard_hero_reordenado = usar
        # Ao retornar ao Futurista, o legado apenas restaura a preparacao
        # interna do Hero; o controlador reassume os quatro widgets.
        if usar and getattr(self, "_dashboard_m2d1c_initialized", False):
            if controller is None:
                from ui.dashboard_layout_m2d1c import DashboardQtLayoutController
                controller = DashboardQtLayoutController(self)
                self._dashboard_m2d1c_controller = controller
            controller.activate()
        raiz.invalidate()
        topo.invalidate()
        antiga_inferior.invalidate()
        progresso_layout.invalidate()
        plan_layout.invalidate()

    def _ajustar_altura_independente_recomendacao(self, futurista):
        """Encurta somente a Recomendação; preserva geometria do Progresso.

        Os cards continuam irmãos da mesma linha. O Progresso define a altura
        da linha e a Recomendação ocupa apenas a faixa superior dela. O ajuste
        compacto aplica-se ao Futurista com largura >= 1200 px; em janelas
        menores e nos demais temas restauramos os parâmetros de origem.
        """
        # O Hero tem altura independente definida em _ajustar_composicao_
        # dashboard_futurista(). A antiga regra abaixo força 640 px e
        # desfaz a compactação, gerando uma faixa vazia à direita.
        if getattr(self, "_dashboard_hero_reordenado", False):
            return
        card = getattr(self, "dashboard_hoje_acao", None)
        linha = getattr(self, "_dashboard_recomendacao_linha", None)
        if card is None or linha is None:
            return
        corpo = card.findChild(QFrame, "algorithmRecommendationBody")
        if corpo is None:
            return
        externo = card.layout()
        interno = corpo.layout()
        if externo is None or interno is None:
            return

        def margens(layout):
            m = layout.contentsMargins()
            return (m.left(), m.top(), m.right(), m.bottom())

        if not hasattr(self, "_dashboard_recomendacao_altura_base"):
            self._dashboard_recomendacao_altura_base = {
                "margens_externas": margens(externo),
                "espacamento_externo": externo.spacing(),
                "margens_internas": margens(interno),
                "espacamento_interno": interno.spacing(),
                "min_corpo": corpo.minimumHeight(),
                "min_card": card.minimumHeight(),
                "min_link": self.dashboard_hoje_botao.minimumHeight(),
                "altura_cta": self.dashboard_hoje_um_clique.minimumHeight(),
                "min_largura_cta": self.dashboard_hoje_um_clique.minimumWidth(),
                "max_largura_cta": self.dashboard_hoje_um_clique.maximumWidth(),
                "max_corpo": corpo.maximumHeight(),
                "max_largura_corpo": corpo.maximumWidth(),
                "estilo_corpo": corpo.styleSheet(),
                "alinhamento_pronto": self.dashboard_algoritmo_pronto.alignment(),
            }
        reduzida = bool(futurista and self.width() >= 1200 and not getattr(
            self, "_dashboard_modelo_reordenado", False
        ))
        pronto = self.dashboard_algoritmo_pronto
        link = self.dashboard_hoje_botao
        cta = self.dashboard_hoje_um_clique
        grade = self._dashboard_recomendacao_grade
        # A troca de posicoes ocorre so quando muda o modo. Nao recria
        # botoes, nao altera sinais e nao toca no card "Seu progresso".
        if reduzida != self._dashboard_recomendacao_horizontal:
            for item in (pronto, link, cta):
                grade.removeWidget(item)
            if reduzida:
                # Esquerda: indicacao e link. Direita: acao principal.
                grade.addWidget(pronto, 0, 0, 1, 1, Qt.AlignLeft | Qt.AlignVCenter)
                grade.addWidget(link, 1, 0, 1, 1, Qt.AlignLeft | Qt.AlignVCenter)
                grade.addWidget(cta, 0, 1, 2, 1, Qt.AlignRight | Qt.AlignVCenter)
            else:
                grade.addWidget(pronto, 0, 0, 1, 2, Qt.AlignCenter)
                grade.addWidget(cta, 1, 0, 1, 2, Qt.AlignHCenter)
                grade.addWidget(link, 2, 0, 1, 2, Qt.AlignCenter)
            self._dashboard_recomendacao_horizontal = reduzida

        if reduzida:
            externo.setContentsMargins(14, 9, 14, 9)
            externo.setSpacing(3)
            grade.setContentsMargins(6, 0, 6, 0)
            grade.setHorizontalSpacing(12)
            grade.setVerticalSpacing(2)
            corpo.setMinimumHeight(0)
            corpo.setMaximumHeight(78)
            corpo.setMaximumWidth(16777215)
            # O QFrame continua existindo para o layout, mas sem quadrante
            # visivel. Textos e CTA ficam diretamente sobre o card externo.
            corpo.setStyleSheet(
                "QFrame#algorithmRecommendationBody {"
                "background: transparent; border: none; border-radius: 0px; }"
            )
            externo.setAlignment(corpo, Qt.AlignmentFlag(0))
            pronto.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
            link.setMinimumHeight(22)
            cta.setMinimumWidth(220)
            cta.setMaximumWidth(250)
            cta.setFixedHeight(42)
            card.setFixedHeight(185)
            linha.setAlignment(card, Qt.AlignTop)
        else:
            base = self._dashboard_recomendacao_altura_base
            externo.setContentsMargins(*base["margens_externas"])
            externo.setSpacing(base["espacamento_externo"])
            grade.setContentsMargins(*base["margens_internas"])
            grade.setSpacing(base["espacamento_interno"])
            corpo.setMinimumHeight(base["min_corpo"])
            corpo.setMaximumHeight(base["max_corpo"])
            corpo.setMaximumWidth(base["max_largura_corpo"])
            corpo.setStyleSheet(base["estilo_corpo"])
            externo.setAlignment(corpo, Qt.AlignmentFlag(0))
            pronto.setAlignment(base["alinhamento_pronto"])
            link.setMinimumHeight(base["min_link"])
            cta.setMinimumWidth(base["min_largura_cta"])
            cta.setMaximumWidth(base["max_largura_cta"])
            cta.setFixedHeight(base["altura_cta"])
            card.setMinimumHeight(base["min_card"])
            card.setMaximumHeight(16777215)
            card.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
            linha.setAlignment(card, Qt.AlignmentFlag(0))
        if getattr(self, "_dashboard_modelo_reordenado", False):
            # Hero R7: tamanho responsivo ao cartão alto, sem comprometer o
            # Foco e sem recriar a instância conectada ao algoritmo.
            if getattr(self, "_dashboard_hero_reordenado", False):
                grade.removeWidget(cta)
                grade.addWidget(cta, 1, 0, 1, 2, Qt.AlignVCenter)
                externo.setContentsMargins(35, 29, 35, 32)
                externo.setSpacing(8)
                interno.setContentsMargins(0, 0, 0, 0)
                interno.setVerticalSpacing(11)
                corpo.setStyleSheet(
                    "QFrame#algorithmRecommendationBody {background:transparent;"
                    "border:none;border-radius:0px;}"
                )
                corpo.setMinimumHeight(136)
                corpo.setMaximumHeight(166)
                cta.setMinimumWidth(0)
                cta.setMaximumWidth(16777215)
                cta.setFixedHeight(50)
                card.setMinimumHeight(640)
                card.setMaximumHeight(16777215)
                externo.invalidate()
                grade.invalidate()
                return
            # Modelo novo: botão largo no rodapé interno, como Iniciar Foco.
            if self._dashboard_recomendacao_horizontal:
                raise RuntimeError("O Dashboard reordenado deve estar em modo vertical")
            grade.removeWidget(cta)
            grade.addWidget(cta, 1, 0, 1, 2, Qt.AlignVCenter)
            cta.setMinimumWidth(0)
            cta.setMaximumWidth(16777215)
            cta.setFixedHeight(42)
            card.setMinimumHeight(285)
            card.setMaximumHeight(16777215)
        externo.invalidate()
        grade.invalidate()
        linha.invalidate()

    def _estilizar_cabecalho_premium(self, tema):
        """Acabamento do cabeçalho do portal Início, sem QSS global.

        Três paletas independentes, pois a barra é transferida do Dashboard
        para a página Início. Estilos ancorados nos objectNames reais.
        """
        painel = getattr(self, "_dashboard_top_container", None)
        if painel is None:
            return
        tema = normalizar_tema(tema)
        if getattr(self, "_premium_tema_aplicado", None) == tema:
            return
        self._premium_tema_aplicado = tema
        cores = {
            "futurista": dict(
                # H04: tinta com alfa SOMENTE nas superfícies. Tipografia,
                # pictogramas, marca e controles preservam opacidade integral.
                base="rgba(3, 13, 27, 222)",
                centro="rgba(6, 30, 56, 188)",
                fim="rgba(3, 15, 33, 210)",
                borda="rgba(13, 181, 228, 195)",
                marca="#f0f7ff", acento="#27c8ff",
                texto="#eaf5ff", secundario="#c7d8e7",
                perfil="rgba(7, 30, 55, 212)",
                perfil_borda="rgba(54, 172, 228, 178)",
                campo="rgba(8, 31, 56, 200)",
                foco="#32cfff",
                gerenciar="rgba(10, 41, 72, 196)",
                busca="rgba(7, 29, 53, 190)",
                atalho="rgba(29, 67, 96, 207)",
                divisao="rgba(58, 136, 174, 127)",
                hover="rgba(17, 67, 105, 228)",
            ),
            "escuro": dict(
                base="#151e2b", centro="#202f42", fim="#111b29", borda="#49647e",
                marca="#f3f6fc", acento="#64bde9", texto="#e8f0fa", secundario="#adbbca",
                perfil="#233448", perfil_borda="#506980", campo="#233548",
                foco="#75c3ed", gerenciar="#22384e", busca="#213347",
                atalho="#3a4c60", divisao="#496077", hover="#2a455d",
            ),
            "claro": dict(
                base="#f2f7fe", centro="#e4effb", fim="#eef5ff", borda="#9bbbd9",
                marca="#122e4b", acento="#1777ae", texto="#143655", secundario="#56718b",
                perfil="#ffffff", perfil_borda="#a8c5df", campo="#ffffff",
                foco="#2379ae", gerenciar="#d7eafd", busca="#ffffff",
                atalho="#e4eef8", divisao="#bfd2e5", hover="#d1e8fa",
            ),
        }[tema]
        self._premium_titulo.setText(
            f'<span style="color:{cores["marca"]};">Vighna</span>'
            f'<span style="color:{cores["acento"]};">Study</span>'
        )
        # A aplicação pode alternar o tema sem recriar os widgets.
        gerenciar = getattr(self, "_premium_gerenciar", None)
        if gerenciar is not None:
            icone = criar_icone("fa5s.cog", tema=tema, papel="destaque")
            if not icone.isNull():
                gerenciar.setIcon(icone)
                gerenciar.setText("Gerenciar")
            else:
                gerenciar.setText("⚙  Gerenciar")
        escudo = criar_icone("fa5s.shield-alt", tema=tema, papel="destaque")
        if escudo.isNull():
            escudo = criar_icone("fa5s.shield", tema=tema, papel="destaque")
        if not escudo.isNull():
            self._premium_icone_perfil.setPixmap(escudo.pixmap(25, 25))
            self._premium_icone_perfil.setText("")
