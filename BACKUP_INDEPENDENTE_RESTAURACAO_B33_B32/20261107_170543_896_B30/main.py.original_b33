        self.busca_questoes.setClearButtonEnabled(True)
        self.busca_questoes.textChanged.connect(self.preencher_tabela)
        filtros.addWidget(self.busca_questoes, 1)
        self.status_filtro = QComboBox()
        self.status_filtro.addItems(["Todas", "Ativas", "Desativadas"])
        self.status_filtro.currentTextChanged.connect(self.preencher_tabela)
        filtros.addWidget(self.status_filtro)

        self.capitulo_filtro = QComboBox()
        self.capitulo_filtro.addItem("Todos os capítulos", None)
        self.capitulo_filtro.setEnabled(False)
        self.capitulo_filtro.setMinimumWidth(190)
        self.capitulo_filtro.currentIndexChanged.connect(self.preencher_tabela)
        filtros.addWidget(self.capitulo_filtro)
        dl.addLayout(filtros)

        acoes = QHBoxLayout()
        self.marcar_todas_questoes = QCheckBox("Selecionar todas")
        self.marcar_todas_questoes.stateChanged.connect(self.alternar_marcacao_todas_questoes)
        acoes.addWidget(self.marcar_todas_questoes)

        self.botao_importar = QPushButton("+ Importar para este tópico")
        self.botao_importar.setObjectName("questionsNewHeroButton")
        self.botao_importar.setToolTip(
            "Abrir a Central de importação já usando este tópico como destino inicial."
        )
        self.botao_importar.clicked.connect(self.importar_questoes_topico)
        acoes.addWidget(self.botao_importar)

        self.botao_nova = QPushButton("+ Nova manualmente")
        self.botao_nova.setObjectName("studyManualButton")
        self.botao_nova.setToolTip(
            "Cadastrar uma nova questão manualmente já vinculada a este tópico."
        )
        self.botao_nova.clicked.connect(self.nova_questao)
        acoes.addWidget(self.botao_nova)
        acoes.addStretch()

        visualizar = QPushButton("Visualizar")
        visualizar.setObjectName("subtleButton")
        visualizar.clicked.connect(self.visualizar_questao)
        editar = QPushButton("Editar")
        editar.setObjectName("studyManualButton")
        editar.clicked.connect(self.editar_questao)
        self.botao_status = QPushButton("Desativar")
        self.botao_status.setObjectName("subtleButton")
        self.botao_status.setToolTip(
            "Desativar temporariamente a questão selecionada. Ela fica fora das novas sessões, sem ser apagada."
        )
        self.botao_status.clicked.connect(self.alterar_status_questao)
        self.botao_excluir = QPushButton("Excluir")
        self.botao_excluir.setObjectName("dangerButton")
        self.botao_excluir.setToolTip(
            "Enviar a questão para a lixeira. Depois, você poderá restaurar ou excluir permanentemente."
        )
        self.botao_excluir.clicked.connect(self.enviar_questao_para_lixeira)
        atualizar = QPushButton("Atualizar")
        atualizar.setObjectName("subtleButton")
        atualizar.clicked.connect(self.recarregar)
        acoes.addWidget(visualizar)
        acoes.addWidget(editar)
        acoes.addWidget(self.botao_status)
        acoes.addWidget(self.botao_excluir)
        acoes.addWidget(atualizar)
        dl.addLayout(acoes)

        self.tabela = QTableWidget()
        self.tabela.setObjectName("questionsTable")
        self.tabela.setColumnCount(9)
        self.tabela.setHorizontalHeaderLabels([
            "", "#", "Questão", "Capítulo", "Banca", "Ano", "Dificuldade", "Gabarito", "Status"
        ])
        self.tabela.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.tabela.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.tabela.setSelectionMode(QAbstractItemView.SingleSelection)
        self.tabela.setAlternatingRowColors(True)
        self.tabela.setShowGrid(False)
        self.tabela.verticalHeader().setVisible(False)
        self.tabela.itemSelectionChanged.connect(self.atualizar_acoes)
        self.tabela.cellDoubleClicked.connect(lambda *_: self.editar_questao())
        h = self.tabela.horizontalHeader()
        h.setSectionResizeMode(0, QHeaderView.ResizeToContents)
        h.setSectionResizeMode(1, QHeaderView.ResizeToContents)
        h.setSectionResizeMode(2, QHeaderView.Stretch)
        h.setSectionResizeMode(3, QHeaderView.Interactive)
        self.tabela.setColumnWidth(3, 220)
        for c in range(4, 9):
            h.setSectionResizeMode(c, QHeaderView.ResizeToContents)
        dl.addWidget(self.tabela, 1)
        corpo.addWidget(direita, 1)
        raiz.addLayout(corpo, 1)

        fechar = QDialogButtonBox(QDialogButtonBox.Close)
        fechar.button(QDialogButtonBox.Close).setText("Fechar")
        fechar.rejected.connect(self.reject)
        fechar.clicked.connect(self.accept)
        raiz.addWidget(fechar)

        self.recarregar()

    @staticmethod
    def _normalizar(texto):
        texto = str(texto or "").lower().strip()
        texto = unicodedata.normalize("NFD", texto)
        texto = "".join(c for c in texto if unicodedata.category(c) != "Mn")
        return " ".join(texto.split())

    def abrir_pagina_topico(self, item, _coluna=0):
        if item is None:
            return
        topico_id = item.data(0, Qt.UserRole)
        topico_nome = str(item.data(0, Qt.UserRole + 2) or "")
        if topico_id is None or not topico_nome:
            return
        JanelaTopico(int(topico_id), topico_nome, self).exec()
        self.recarregar()

    def mostrar_ajuda(self):
        QMessageBox.information(
            self,
            "Como funciona — Gerenciar e Editar",
            (
                "A coluna da esquerda agrupa o banco por disciplina e tópico. O botão Questões desativadas, no cabeçalho, abre a lista completa de itens desligados.\n\n"
                "Ao selecionar um tópico, a tabela da direita mostra todas as questões "
                "desse tópico, incluindo as desativadas quando o filtro estiver em Todas.\n\n"
                "Você pode visualizar ou editar qualquer questão, importar novas pelo fluxo PDF/TXT/texto/CSV, "
                "cadastrar uma nova manualmente já vinculada ao tópico selecionado e desativar/reativar sem perder o histórico.\n\n"
                "Um duplo clique em uma questão abre diretamente a edição."
            )
        )

    def abrir_questoes_desativadas(self):
        janela = JanelaItensDesativados(aba=1, parent=self)
        janela.exec()
        self.recarregar()

    def abrir_lixeira_questoes(self):
        janela = JanelaLixeiraQuestoes(parent=self)
        janela.exec()
        self.recarregar()

    def recarregar(self):
        selecao_topico = self.topico_id_atual
        selecao_disciplina = self.disciplina_atual
        self.dados = listar_questoes(
            self.concurso[0],
            incluir_inativas=True,
            incluir_topicos_pausados=True,
            incluir_disciplinas_pausadas=True
        )

        grupos = {}
        for item in self.dados:
            disciplina = str(item.get("disciplina") or "—")
            topico = str(item.get("topico") or "—")
            topico_id = item.get("topico_id")
            chave = (topico_id, topico)
            grupos.setdefault(disciplina, {}).setdefault(chave, []).append(item)

        # Quando a janela é aberta a partir da página de um tópico sem
        # questões, preserva esse contexto em vez de saltar para o primeiro
        # tópico que possuir itens no banco.
        if selecao_topico is not None:
            encontrou = any(
                any(chave[0] == selecao_topico for chave in topicos)
                for topicos in grupos.values()
            )
            if not encontrou:
                contexto = obter_contexto_topico(selecao_topico)
                if contexto:
                    disciplina = contexto["disciplina_nome"]
                    topico = contexto["topico_nome"]
                    grupos.setdefault(disciplina, {}).setdefault(
                        (selecao_topico, topico),
                        []
                    )

        self.arvore.blockSignals(True)
        self.arvore.clear()
        item_para_selecionar = None
        primeiro_topico = None
        tema_arvore = normalizar_tema(
            obter_configuracao_texto("tema_interface", "claro")
        )
        for disciplina in sorted(grupos, key=str.lower):
            topicos = grupos[disciplina]
            total_disciplina = sum(len(v) for v in topicos.values())
            disciplina_pausada = any(
                bool(q.get("disciplina_pausada"))
                for qs in topicos.values()
                for q in qs
            )
            rotulo_disciplina = (
                f"{disciplina}  • desligada" if disciplina_pausada else disciplina
            )
            pai = QTreeWidgetItem([rotulo_disciplina, str(total_disciplina)])
            pai.setData(0, Qt.UserRole, None)
            pai.setData(0, Qt.UserRole + 1, disciplina)
            pai.setData(0, Qt.UserRole + 4, disciplina_pausada)
            if disciplina_pausada:
                pai.setForeground(
                    0, QBrush(qcolor(tema_arvore, "questions_center.tree_disabled_discipline_text"))
                )
                pai.setToolTip(0, "Disciplina desligada no perfil atual.")
            self.arvore.addTopLevelItem(pai)
            for (topico_id, topico), questoes in sorted(
                topicos.items(), key=lambda par: par[0][1].lower()
            ):
                desativadas = sum(1 for q in questoes if not q.get("ativa", True))
                topico_pausado = any(bool(q.get("topico_pausado")) for q in questoes)
                contagem = str(len(questoes))
                if desativadas:
                    contagem += f" ({desativadas} off)"
                rotulo_topico = f"{topico}  • desligado" if topico_pausado else topico
                filho = QTreeWidgetItem([rotulo_topico, contagem])
                filho.setData(0, Qt.UserRole, topico_id)
                filho.setData(0, Qt.UserRole + 1, disciplina)
                filho.setData(0, Qt.UserRole + 2, topico)
                filho.setData(0, Qt.UserRole + 3, bool(topico_pausado))
                if topico_pausado:
                    filho.setToolTip(0, "Tópico desligado no perfil atual. As questões permanecem armazenadas, mas ficam fora das novas sessões.")
                pai.addChild(filho)
                if primeiro_topico is None:
                    primeiro_topico = filho
                if selecao_topico is not None and topico_id == selecao_topico:
                    item_para_selecionar = filho
            pai.setExpanded(True)
            if item_para_selecionar is None and selecao_topico is None and disciplina == selecao_disciplina:
                item_para_selecionar = pai

        self.arvore.blockSignals(False)
        self.filtrar_arvore()
        alvo = item_para_selecionar or primeiro_topico
        if alvo is not None:
            self.arvore.setCurrentItem(alvo)
        else:
            self.topico_id_atual = None
            self.disciplina_atual = ""
            self.topico_atual = ""
            self.atualizar_lista()

    def filtrar_arvore(self, *args):
        termo = self._normalizar(self.busca_topicos.text())
        for i in range(self.arvore.topLevelItemCount()):
            pai = self.arvore.topLevelItem(i)
            disciplina = self._normalizar(pai.text(0))
            algum_filho = False
            for j in range(pai.childCount()):
                filho = pai.child(j)
                alvo = self._normalizar(f"{pai.text(0)} {filho.text(0)}")
                visivel = not termo or termo in alvo
                filho.setHidden(not visivel)
                algum_filho = algum_filho or visivel
            pai_visivel = not termo or termo in disciplina or algum_filho
            pai.setHidden(not pai_visivel)
            if termo and pai_visivel:
                pai.setExpanded(True)

    def carregar_filtro_capitulos(self):
        self.capitulo_filtro.blockSignals(True)
        self.capitulo_filtro.clear()
        self.capitulo_filtro.addItem("Todos os capítulos", None)

        capitulos = []
        if self.topico_id_atual is not None:
            capitulos = listar_capitulos_topico(int(self.topico_id_atual))
            for capitulo_id, nome, _ordem, _dificuldade, _pausado in capitulos:
                self.capitulo_filtro.addItem(str(nome), int(capitulo_id))
            if capitulos:
                self.capitulo_filtro.addItem("Sem capítulo", -1)

        self.capitulo_filtro.setEnabled(bool(capitulos))
        self.capitulo_filtro.blockSignals(False)

    def atualizar_lista(self):
        selecionados = self.arvore.selectedItems()
        if not selecionados:
            self.topico_id_atual = None
            self.disciplina_atual = ""
            self.topico_atual = ""
            self.contexto_titulo.setText("Selecione um tópico")
            self.contexto_subtitulo.setText("—")
            self.botao_importar.setEnabled(False)
            self.botao_nova.setEnabled(False)
            self.carregar_filtro_capitulos()
            self.preencher_tabela()
            return

        item = selecionados[0]
        self.topico_id_atual = item.data(0, Qt.UserRole)
        self.disciplina_atual = str(item.data(0, Qt.UserRole + 1) or item.text(0) or "")
        self.topico_atual = str(item.data(0, Qt.UserRole + 2) or "")
        if self.topico_id_atual is None:
            self.contexto_titulo.setText(self.disciplina_atual or "Disciplina")
            disciplina_pausada = bool(item.data(0, Qt.UserRole + 4))
            self.contexto_subtitulo.setText(
                "Todas as questões da disciplina. • disciplina desligada no perfil"
                if disciplina_pausada
                else "Todas as questões da disciplina."
            )
            self.botao_importar.setEnabled(False)
            self.botao_nova.setEnabled(False)
        else:
            self.contexto_titulo.setText(self.topico_atual or "Tópico")
            pausado = bool(item.data(0, Qt.UserRole + 3))
            if pausado:
                self.contexto_subtitulo.setText(
                    f"{self.disciplina_atual} › {self.topico_atual} • tópico desligado no perfil"
                )
            else:
                capitulos = listar_capitulos_topico(int(self.topico_id_atual))
                complemento = (
                    f" • {len(capitulos)} capítulo(s) incluído(s)"
                    if capitulos
                    else ""
                )
                self.contexto_subtitulo.setText(
                    f"{self.disciplina_atual} › {self.topico_atual}{complemento}"
                )
            self.botao_importar.setEnabled(True)
            self.botao_nova.setEnabled(True)
        self.carregar_filtro_capitulos()
        self.preencher_tabela()

    def questoes_contexto(self):
        itens = list(self.dados)
        if self.topico_id_atual is not None:
            itens = [q for q in itens if q.get("topico_id") == self.topico_id_atual]
        elif self.disciplina_atual:
            itens = [q for q in itens if q.get("disciplina") == self.disciplina_atual]
        else:
            itens = []

        status = self.status_filtro.currentText() if hasattr(self, "status_filtro") else "Todas"
        if status == "Ativas":
            itens = [q for q in itens if q.get("ativa", True)]
        elif status == "Desativadas":
            itens = [q for q in itens if not q.get("ativa", True)]

        capitulo_id = (
            self.capitulo_filtro.currentData()
            if hasattr(self, "capitulo_filtro")
            else None
        )
        if capitulo_id == -1:
            itens = [q for q in itens if q.get("capitulo_id") is None]
        elif capitulo_id is not None:
            itens = [
                q
                for q in itens
                if q.get("capitulo_id") is not None
                and int(q.get("capitulo_id")) == int(capitulo_id)
            ]

        busca = self._normalizar(self.busca_questoes.text()) if hasattr(self, "busca_questoes") else ""
        if busca:
            filtrados = []
            termos = [t for t in busca.split() if t]
            for q in itens:
                alvo = self._normalizar(
                    f"{q.get('id')} {q.get('enunciado')} {q.get('capitulo')} "
                    f"{q.get('banca')} {q.get('fonte')} {q.get('dificuldade')}"
                )
                if all(t in alvo for t in termos):
                    filtrados.append(q)
            itens = filtrados
        return itens

    def preencher_tabela(self, *args):
        itens = self.questoes_contexto()
        desativadas = sum(1 for q in itens if not q.get("ativa", True))
        texto = "1 questão" if len(itens) == 1 else f"{len(itens)} questões"
        if desativadas:
            texto += f" • {desativadas} desativada(s)"
        self.contagem.setText(texto)
        self.tabela.blockSignals(True)
        self.tabela.setRowCount(len(itens))
        for linha, q in enumerate(itens):
            marca = QTableWidgetItem("")
            marca.setFlags(Qt.ItemIsEnabled | Qt.ItemIsUserCheckable | Qt.ItemIsSelectable)
            marca.setCheckState(Qt.Unchecked)
            marca.setData(Qt.UserRole, q.get("id"))
            self.tabela.setItem(linha, 0, marca)

            enunciado = " ".join(str(q.get("enunciado") or "").split())
            status = "Ativa" if q.get("ativa", True) else "Desativada"
            vals = [
                str(q.get("id") or "—"),
                enunciado,
                str(q.get("capitulo") or "—"),
                str(q.get("banca") or "—"),
                str(q.get("ano") or "—"),
                str(q.get("dificuldade") or "Não informada"),
                str(q.get("gabarito") or "—"),
                status,
            ]
            for deslocamento, valor in enumerate(vals, start=1):
                celula = QTableWidgetItem(valor)
                if deslocamento == 2:
                    celula.setData(Qt.UserRole, q.get("id"))
                    celula.setToolTip(enunciado)
                if deslocamento in (1, 5, 6, 7, 8):
                    celula.setTextAlignment(Qt.AlignCenter)
                if not q.get("ativa", True):
                    aplicar_destaque_tabela(celula, "inativo", True)
                    aplicar_destaque_tabela(marca, "inativo", True)
                self.tabela.setItem(linha, deslocamento, celula)
            self.tabela.setRowHeight(linha, 34)
        self.tabela.blockSignals(False)
        if hasattr(self, "marcar_todas_questoes"):
            self.marcar_todas_questoes.blockSignals(True)
            self.marcar_todas_questoes.setChecked(False)
            self.marcar_todas_questoes.blockSignals(False)
        self.atualizar_acoes()

    def obter_ids_questoes_marcadas(self):
        ids = []
        for linha in range(self.tabela.rowCount()):
            item = self.tabela.item(linha, 0)
            if item is not None and item.checkState() == Qt.Checked:
                questao_id = item.data(Qt.UserRole)
                if questao_id is not None:
                    ids.append(int(questao_id))
        return ids

    def alternar_marcacao_todas_questoes(self, estado):
        marcado = estado == Qt.Checked
        self.tabela.blockSignals(True)
        for linha in range(self.tabela.rowCount()):
            item = self.tabela.item(linha, 0)
            if item is not None:
                item.setCheckState(Qt.Checked if marcado else Qt.Unchecked)
        self.tabela.blockSignals(False)

    def questao_id_selecionada(self, avisar=True):
        ids_marcados = self.obter_ids_questoes_marcadas()
        if len(ids_marcados) == 1:
            return ids_marcados[0]
        linha = self.tabela.currentRow()
        if linha < 0:
            if avisar:
                QMessageBox.information(self, "Questões por tópico", "Selecione uma questão na tabela.")
            return None
        item = self.tabela.item(linha, 2)
        return item.data(Qt.UserRole) if item is not None else None

    def atualizar_acoes(self):
        ids_marcados = self.obter_ids_questoes_marcadas()
        questao_id = self.questao_id_selecionada(avisar=False)
        referencia_id = ids_marcados[0] if ids_marcados else questao_id
        if referencia_id is None:
            self.botao_status.setEnabled(False)
            self.botao_status.setText("Desativar")
            self.botao_excluir.setEnabled(False)
            return
        integridade = obter_integridade_questao(referencia_id)
        if integridade is None:
            self.botao_status.setEnabled(False)
            self.botao_excluir.setEnabled(False)
            return
        self.botao_status.setEnabled(True)
        self.botao_excluir.setEnabled(True)
        if ids_marcados and len(ids_marcados) > 1:
            self.botao_status.setText("Desativar / Reativar")
        else:
            self.botao_status.setText("Desativar" if integridade.get("ativa") else "Reativar")

    def visualizar_questao(self):
        questao_id = self.questao_id_selecionada()
        if questao_id is None:
            return
        JanelaVisualizarQuestao(questao_id, self).exec()

    def editar_questao(self):
        questao_id = self.questao_id_selecionada()
        if questao_id is None:
            return
        janela = JanelaQuestaoEditor(questao_id, self)
        if janela.exec() == QDialog.Accepted:
            self.recarregar()

    def importar_questoes_topico(self):
        if self.topico_id_atual is None:
            QMessageBox.information(
                self,
                "Importar questões",
                "Selecione um tópico específico antes de iniciar a importação."
            )
            return

        # Reaproveita a Central de importação da janela principal para manter
        # PDF, TXT, texto colado e CSV em um único fluxo. O tópico aberto é
        # encaminhado como destino inicial, sem impedir ajustes na conferência.
        alvo = self.parentWidget()
        while alvo is not None:
            metodo = getattr(alvo, "abrir_central_importacao_questoes", None)
            if callable(metodo):
                metodo(topico_id_padrao=self.topico_id_atual)
                self.recarregar()
                return
            alvo = alvo.parentWidget()

        app = QApplication.instance()
        if app is not None:
            for janela in app.topLevelWidgets():
                metodo = getattr(janela, "abrir_central_importacao_questoes", None)
                if callable(metodo):
                    metodo(topico_id_padrao=self.topico_id_atual)
                    self.recarregar()
                    return

        QMessageBox.warning(
            self,
            "Importar questões",
            "A Central de importação não pôde ser localizada nesta janela."
        )

    def nova_questao(self):
        if self.topico_id_atual is None:
            QMessageBox.information(
                self,
                "Nova questão",
                "Selecione um tópico específico na árvore antes de cadastrar a questão."
            )
            return
        janela = JanelaQuestaoEditor(parent=self)
        indice_disc = janela.questao_disciplina.findText(self.disciplina_atual, Qt.MatchFixedString)
        if indice_disc >= 0:
            janela.questao_disciplina.setCurrentIndex(indice_disc)
            janela.carregar_topicos()
        indice_top = janela.questao_topico.findData(self.topico_id_atual)
        if indice_top >= 0:
            janela.questao_topico.setCurrentIndex(indice_top)
            janela.carregar_capitulos()
        if janela.exec() == QDialog.Accepted:
            self.recarregar()

    def alterar_status_questao(self):
        questao_id = self.questao_id_selecionada()
        if questao_id is None:
            return
        integridade = obter_integridade_questao(questao_id)
        if integridade is None:
            return
        if integridade.get("ativa"):
            resposta = QMessageBox.question(
                self,
                "Desativar questão",
                (
                    f"Desativar temporariamente a questão #{questao_id}?\n\n"
                    "Ela ficará fora de novas sessões e recomendações, mas continuará armazenada "
                    "e poderá ser reativada depois. O histórico permanecerá preservado."
                ),
                QMessageBox.Yes | QMessageBox.No,
                QMessageBox.No
            )
            if resposta != QMessageBox.Yes:
                return
            try:
                fazer_backup("antes_desativar_questao")
            except Exception as erro:
                QMessageBox.critical(self, "Backup", f"A operação foi cancelada porque o backup falhou.\n\n{erro}")
                return
            if not arquivar_questao(questao_id):
                QMessageBox.warning(self, "Desativar questão", "A questão não pôde ser desativada.")
                return
        else:
            if not reativar_questao(questao_id):
                QMessageBox.warning(self, "Reativar questão", "A questão não pôde ser reativada.")
                return
        self.recarregar()


class JanelaItensDesativados(QDialog):
    """Centraliza disciplinas e questões temporariamente desativadas."""

    def __init__(
        self,
        aba=0,
        parent=None,
        disciplina_nome=None,
        somente_questoes=False,
    ):
        super().__init__(parent)
        self.concurso = obter_concurso_ativo()
        self.questoes_desativadas = []
        self.disciplina_nome_filtro = str(disciplina_nome or "").strip()
        self.somente_questoes = bool(somente_questoes)

        self.setWindowTitle(
            f"Questões desativadas — {self.disciplina_nome_filtro}"
            if self.somente_questoes and self.disciplina_nome_filtro
            else "Itens desativados"
        )
        self.setWindowFlag(Qt.WindowMaximizeButtonHint, True)
        self.resize(1040, 680)
        self.setMinimumSize(820, 520)

        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(18, 16, 18, 16)
        raiz.setSpacing(10)

        cab = QHBoxLayout()
        textos = QVBoxLayout()
        textos.setSpacing(1)
        titulo = QLabel(
            f"Questões desativadas — {self.disciplina_nome_filtro}"
            if self.somente_questoes and self.disciplina_nome_filtro
            else "Itens desativados"
        )
        titulo.setObjectName("pageTitle")
        subtitulo = QLabel(
            (
                "Consulte, edite e reative as questões desativadas desta disciplina."
                if self.somente_questoes and self.disciplina_nome_filtro
                else "Consulte e reative conteúdos que o Vighna está ignorando temporariamente."
            )
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        textos.addWidget(titulo)
        textos.addWidget(subtitulo)
        cab.addLayout(textos, 1)
        perfil = QLabel(f"Perfil: {self.concurso[1]}")
        perfil.setObjectName("profileBadge")
        cab.addWidget(perfil, 0, Qt.AlignVCenter)
        raiz.addLayout(cab)

        aviso = QLabel(
            "Desativar não apaga dados. Disciplinas e questões permanecem cadastradas, "
            "mas ficam fora das rotinas automáticas até serem reativadas."
        )
        aviso.setObjectName("mutedLabel")
        aviso.setWordWrap(True)
        raiz.addWidget(aviso)

        self.abas = QTabWidget()
        self.abas.setObjectName("disabledItemsTabs")
        self.abas.addTab(self._criar_aba_disciplinas(), "Disciplinas")
        self.abas.addTab(self._criar_aba_questoes(), "Questões")
        if self.somente_questoes:
            self.abas.setTabVisible(0, False)
        raiz.addWidget(self.abas, 1)

        rodape = QDialogButtonBox(QDialogButtonBox.Close)
        rodape.button(QDialogButtonBox.Close).setText("Fechar")
        rodape.rejected.connect(self.reject)
        rodape.clicked.connect(self.accept)
        raiz.addWidget(rodape)

        self.carregar()
        self.abas.setCurrentIndex(
            1 if self.somente_questoes or int(aba or 0) == 1 else 0
        )

    def _criar_aba_disciplinas(self):
        tela = QWidget()
        layout = QVBoxLayout(tela)
        layout.setContentsMargins(8, 10, 8, 8)
        layout.setSpacing(8)

        linha = QHBoxLayout()
        texto = QLabel(
            "Disciplinas desligadas no perfil atual. Todos os seus tópicos ficam fora "
            "das filas e recomendações enquanto este estado estiver ativo."
        )
        texto.setObjectName("mutedLabel")
        texto.setWordWrap(True)
        linha.addWidget(texto, 1)
        self.contagem_disciplinas_desativadas = QLabel("0 disciplinas")
        self.contagem_disciplinas_desativadas.setObjectName("filterCount")
        linha.addWidget(self.contagem_disciplinas_desativadas, 0, Qt.AlignVCenter)
        layout.addLayout(linha)

        self.tabela_disciplinas_desativadas = QTableWidget()
        self.tabela_disciplinas_desativadas.setColumnCount(4)
        self.tabela_disciplinas_desativadas.setHorizontalHeaderLabels([
            "Disciplina", "Tópicos", "Revisões", "Questões"
        ])
        self.tabela_disciplinas_desativadas.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.tabela_disciplinas_desativadas.setSelectionMode(QAbstractItemView.SingleSelection)
        self.tabela_disciplinas_desativadas.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.tabela_disciplinas_desativadas.setAlternatingRowColors(False)
        self.tabela_disciplinas_desativadas.setShowGrid(False)
        self.tabela_disciplinas_desativadas.verticalHeader().setVisible(False)
        h = self.tabela_disciplinas_desativadas.horizontalHeader()
        h.setSectionResizeMode(0, QHeaderView.Stretch)
        for c in range(1, 4):
            h.setSectionResizeMode(c, QHeaderView.ResizeToContents)
        layout.addWidget(self.tabela_disciplinas_desativadas, 1)

        acoes = QHBoxLayout()
        acoes.addStretch()
        reativar = QPushButton("Reativar disciplina")
        reativar.setObjectName("primaryButton")
        reativar.clicked.connect(self.reativar_disciplina)
        acoes.addWidget(reativar)
        layout.addLayout(acoes)
        return tela

    def _criar_aba_questoes(self):
        tela = QWidget()
        layout = QVBoxLayout(tela)
        layout.setContentsMargins(8, 10, 8, 8)
        layout.setSpacing(8)

        linha = QHBoxLayout()
        self.busca_questoes_desativadas = QLineEdit()
        self.busca_questoes_desativadas.setPlaceholderText(
            "Buscar por disciplina, tópico, enunciado, banca ou ID..."
        )
        self.busca_questoes_desativadas.setClearButtonEnabled(True)
        self.busca_questoes_desativadas.textChanged.connect(
            self.preencher_questoes_desativadas
        )
        linha.addWidget(self.busca_questoes_desativadas, 1)
        self.contagem_questoes_desativadas = QLabel("0 questões")
        self.contagem_questoes_desativadas.setObjectName("filterCount")
        linha.addWidget(self.contagem_questoes_desativadas, 0, Qt.AlignVCenter)
        layout.addLayout(linha)

        self.tabela_questoes_desativadas = QTableWidget()
        self.tabela_questoes_desativadas.setColumnCount(6)
        self.tabela_questoes_desativadas.setHorizontalHeaderLabels([
            "#", "Disciplina", "Tópico", "Questão", "Banca", "Ano"
        ])
        self.tabela_questoes_desativadas.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.tabela_questoes_desativadas.setSelectionMode(QAbstractItemView.SingleSelection)
        self.tabela_questoes_desativadas.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.tabela_questoes_desativadas.setAlternatingRowColors(False)
        self.tabela_questoes_desativadas.setShowGrid(False)
        self.tabela_questoes_desativadas.verticalHeader().setVisible(False)
        self.tabela_questoes_desativadas.cellDoubleClicked.connect(
            lambda *_: self.editar_questao_desativada()
        )
        hq = self.tabela_questoes_desativadas.horizontalHeader()
        hq.setSectionResizeMode(0, QHeaderView.ResizeToContents)
        hq.setSectionResizeMode(1, QHeaderView.ResizeToContents)
        hq.setSectionResizeMode(2, QHeaderView.ResizeToContents)
        hq.setSectionResizeMode(3, QHeaderView.Stretch)
        hq.setSectionResizeMode(4, QHeaderView.ResizeToContents)
        hq.setSectionResizeMode(5, QHeaderView.ResizeToContents)
        layout.addWidget(self.tabela_questoes_desativadas, 1)

        acoes = QHBoxLayout()
        visualizar = QPushButton("Visualizar")
        visualizar.setObjectName("subtleButton")
        visualizar.clicked.connect(self.visualizar_questao_desativada)
        editar = QPushButton("Editar")
        editar.setObjectName("studyManualButton")
        editar.clicked.connect(self.editar_questao_desativada)
        reativar = QPushButton("Reativar questão")
        reativar.setObjectName("primaryButton")
        reativar.clicked.connect(self.reativar_questao_desativada)
        acoes.addStretch()
        acoes.addWidget(visualizar)
        acoes.addWidget(editar)
        acoes.addWidget(reativar)
        layout.addLayout(acoes)
        return tela

    @staticmethod
    def _normalizar(texto):
        texto = str(texto or "").lower().strip()
        texto = unicodedata.normalize("NFD", texto)
        texto = "".join(c for c in texto if unicodedata.category(c) != "Mn")
        return " ".join(texto.split())

    def carregar(self):
        disciplinas = listar_disciplinas_pausadas(self.concurso[0])
        self.tabela_disciplinas_desativadas.setRowCount(len(disciplinas))
        for linha, (disciplina_id, nome, _pausada) in enumerate(disciplinas):
            resumo = obter_resumo_disciplina(disciplina_id)
            valores = [
                nome,
                str(resumo.get("topicos", 0)),
                str(resumo.get("revisoes_totais", 0)),
                str(resumo.get("questoes_programa", 0)),
            ]
            for coluna, valor in enumerate(valores):
                celula = QTableWidgetItem(valor)
                if coluna == 0:
                    celula.setData(Qt.UserRole, disciplina_id)
                    celula.setToolTip(
                        "Disciplina desligada temporariamente no perfil atual."
                    )
                else:
                    celula.setTextAlignment(Qt.AlignCenter)
                aplicar_destaque_tabela(celula, "inativo", True)
                self.tabela_disciplinas_desativadas.setItem(linha, coluna, celula)
            self.tabela_disciplinas_desativadas.setRowHeight(linha, 34)
        qtd = len(disciplinas)
        self.contagem_disciplinas_desativadas.setText(
            "1 disciplina" if qtd == 1 else f"{qtd} disciplinas"
        )

        todas = listar_questoes(
            self.concurso[0],
            incluir_inativas=True,
            incluir_topicos_pausados=True,
            incluir_disciplinas_pausadas=True,
        )
        self.questoes_desativadas = [q for q in todas if not q.get("ativa", True)]
        if self.disciplina_nome_filtro:
            alvo_disciplina = self._normalizar(self.disciplina_nome_filtro)
            self.questoes_desativadas = [
                q for q in self.questoes_desativadas
                if self._normalizar(q.get("disciplina")) == alvo_disciplina
            ]
        self.preencher_questoes_desativadas()

        self.abas.setTabText(0, f"Disciplinas ({len(disciplinas)})")
        self.abas.setTabText(1, f"Questões ({len(self.questoes_desativadas)})")

    def preencher_questoes_desativadas(self, *args):
        termo = self._normalizar(
            self.busca_questoes_desativadas.text()
            if hasattr(self, "busca_questoes_desativadas") else ""
        )
        dados = list(self.questoes_desativadas)
        if termo:
            termos = [x for x in termo.split() if x]
            filtrados = []
            for q in dados:
                alvo = self._normalizar(
                    f"{q.get('id')} {q.get('disciplina')} {q.get('topico')} "
                    f"{q.get('enunciado')} {q.get('banca')} {q.get('ano')}"
                )
                if all(x in alvo for x in termos):
                    filtrados.append(q)
            dados = filtrados
        self.tabela_questoes_desativadas.setRowCount(len(dados))
        for linha, q in enumerate(dados):
            enunciado = " ".join(str(q.get("enunciado") or "").split())
            if len(enunciado) > 130:
                enunciado = enunciado[:127].rstrip() + "..."
            valores = [
                str(q.get("id") or "—"),
                str(q.get("disciplina") or "—"),
                str(q.get("topico") or "—"),
                enunciado,
                str(q.get("banca") or "—"),
                str(q.get("ano") or "—"),
            ]
            for coluna, valor in enumerate(valores):
                celula = QTableWidgetItem(valor)
                if coluna == 3:
                    celula.setData(Qt.UserRole, q.get("id"))
                    celula.setToolTip(str(q.get("enunciado") or ""))
                if coluna in (0, 5):
                    celula.setTextAlignment(Qt.AlignCenter)
                aplicar_destaque_tabela(celula, "inativo", True)
                self.tabela_questoes_desativadas.setItem(linha, coluna, celula)
            self.tabela_questoes_desativadas.setRowHeight(linha, 34)
        qtd = len(dados)
        self.contagem_questoes_desativadas.setText(
            "1 questão" if qtd == 1 else f"{qtd} questões"
        )

    def _disciplina_id_selecionada(self):
        linha = self.tabela_disciplinas_desativadas.currentRow()
        if linha < 0:
            QMessageBox.information(self, "Disciplinas desativadas", "Selecione uma disciplina.")
            return None
        item = self.tabela_disciplinas_desativadas.item(linha, 0)
        return item.data(Qt.UserRole) if item is not None else None

    def reativar_disciplina(self):
        disciplina_id = self._disciplina_id_selecionada()
        if disciplina_id is None:
            return
        if definir_disciplina_pausada(disciplina_id, False, self.concurso[0]):
            self.carregar()
        else:
            QMessageBox.warning(self, "Reativar disciplina", "A disciplina não pôde ser reativada.")

    def _questao_id_selecionada(self):
        linha = self.tabela_questoes_desativadas.currentRow()
        if linha < 0:
            QMessageBox.information(self, "Questões arquivadas", "Selecione uma questão.")
            return None
        item = self.tabela_questoes_desativadas.item(linha, 3)
        return item.data(Qt.UserRole) if item is not None else None

    def visualizar_questao_desativada(self):
        questao_id = self._questao_id_selecionada()
        if questao_id is not None:
            JanelaVisualizarQuestao(questao_id, self).exec()

    def editar_questao_desativada(self):
        questao_id = self._questao_id_selecionada()
        if questao_id is None:
            return
        janela = JanelaQuestaoEditor(questao_id, self)
        if janela.exec() == QDialog.Accepted:
            self.carregar()

    def reativar_questao_desativada(self):
        questao_id = self._questao_id_selecionada()
        if questao_id is None:
            return
        if reativar_questao(questao_id):
            self.carregar()
        else:
            QMessageBox.warning(self, "Reativar questão", "A questão não pôde ser reativada.")


class JanelaLixeiraQuestoes(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.concurso = obter_concurso_ativo()
        self.setWindowTitle("Lixeira de questões")
        self.resize(1120, 660)
        self.setMinimumSize(920, 560)

        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(18, 16, 18, 16)
        raiz.setSpacing(10)

        cab = QHBoxLayout()
        textos = QVBoxLayout()
        textos.setSpacing(1)
        titulo = QLabel("Lixeira de questões")
        titulo.setObjectName("pageTitle")
        subtitulo = QLabel("Questões enviadas para a lixeira ficam fora do Vighna. Você pode restaurá-las ou excluí-las permanentemente.")
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        textos.addWidget(titulo)
        textos.addWidget(subtitulo)
        cab.addLayout(textos, 1)
        perfil = QLabel(f"Perfil: {self.concurso[1]}")
        perfil.setObjectName("profileBadge")
        cab.addWidget(perfil, 0, Qt.AlignVCenter)
        raiz.addLayout(cab)

        aviso = QLabel("Dica: excluir permanentemente remove a questão do banco. Se houver histórico, as tentativas permanecem preservadas via snapshots históricos.")
        aviso.setObjectName("mutedLabel")
        aviso.setWordWrap(True)
        raiz.addWidget(aviso)

        linha = QHBoxLayout()
        self.buscar = QLineEdit()
        self.buscar.setPlaceholderText("Buscar por disciplina, tópico, enunciado, banca ou ID...")
        self.buscar.setClearButtonEnabled(True)
        self.buscar.textChanged.connect(self.preencher_tabela)
        linha.addWidget(self.buscar, 1)
        self.marca_todas = QCheckBox("Selecionar todas")
        self.marca_todas.stateChanged.connect(self.alternar_todas)
        linha.addWidget(self.marca_todas)
        self.contagem = QLabel("0 questões")
        self.contagem.setObjectName("filterCount")
        linha.addWidget(self.contagem, 0, Qt.AlignVCenter)
        raiz.addLayout(linha)

        self.tabela = QTableWidget()
        self.tabela.setObjectName("questionsTable")
        self.tabela.setColumnCount(7)
        self.tabela.setHorizontalHeaderLabels(["", "#", "Disciplina", "Tópico", "Questão", "Banca", "Ano"])
        self.tabela.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.tabela.setSelectionMode(QAbstractItemView.SingleSelection)
        self.tabela.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.tabela.setShowGrid(False)
        self.tabela.verticalHeader().setVisible(False)
        h = self.tabela.horizontalHeader()
        h.setSectionResizeMode(0, QHeaderView.ResizeToContents)
        h.setSectionResizeMode(1, QHeaderView.ResizeToContents)
        h.setSectionResizeMode(2, QHeaderView.ResizeToContents)
        h.setSectionResizeMode(3, QHeaderView.ResizeToContents)
        h.setSectionResizeMode(4, QHeaderView.Stretch)
        h.setSectionResizeMode(5, QHeaderView.ResizeToContents)
        h.setSectionResizeMode(6, QHeaderView.ResizeToContents)
        raiz.addWidget(self.tabela, 1)

        acoes = QHBoxLayout()
        esvaziar = QPushButton("Esvaziar lixeira")
        esvaziar.setObjectName("dangerButton")
        esvaziar.setToolTip(
            "Excluir permanentemente todas as questões atualmente armazenadas na Lixeira deste perfil."
        )
        esvaziar.clicked.connect(self.esvaziar_lixeira)
        visualizar = QPushButton("Visualizar")
        visualizar.setObjectName("subtleButton")
        visualizar.clicked.connect(self.visualizar)
        restaurar = QPushButton("Restaurar")
        restaurar.setObjectName("primaryButton")
        restaurar.clicked.connect(self.restaurar)
        excluir = QPushButton("Excluir permanentemente")
        excluir.setObjectName("dangerButton")
        excluir.clicked.connect(self.excluir_permanente)
        acoes.addWidget(esvaziar)
        acoes.addStretch()
        acoes.addWidget(visualizar)
        acoes.addWidget(restaurar)
        acoes.addWidget(excluir)
        raiz.addLayout(acoes)

        rodape = QDialogButtonBox(QDialogButtonBox.Close)
        rodape.button(QDialogButtonBox.Close).setText("Fechar")
        rodape.rejected.connect(self.reject)
        rodape.clicked.connect(self.accept)
        raiz.addWidget(rodape)

        self.carregar()

    @staticmethod
    def _normalizar(texto):
        texto = str(texto or "").lower().strip()
        texto = unicodedata.normalize("NFD", texto)
        texto = "".join(c for c in texto if unicodedata.category(c) != "Mn")
        return " ".join(texto.split())

    def carregar(self):
        self.dados = listar_questoes_lixeira(self.concurso[0])
        self.preencher_tabela()

    def preencher_tabela(self):
        termo = self._normalizar(self.buscar.text())
        dados = list(self.dados)
        if termo:
            termos = [x for x in termo.split() if x]
            dados = [q for q in dados if all(x in self._normalizar(f"{q.get('id')} {q.get('disciplina')} {q.get('topico')} {q.get('enunciado')} {q.get('banca')} {q.get('ano')}") for x in termos)]
        self.tabela.blockSignals(True)
        self.tabela.setRowCount(len(dados))
        for linha, q in enumerate(dados):
            marca = QTableWidgetItem("")
            marca.setFlags(Qt.ItemIsEnabled | Qt.ItemIsUserCheckable | Qt.ItemIsSelectable)
            marca.setCheckState(Qt.Unchecked)
            marca.setData(Qt.UserRole, q.get("id"))
            aplicar_destaque_tabela(marca, "inativo", True)
            self.tabela.setItem(linha, 0, marca)
            enunciado = " ".join(str(q.get("enunciado") or "").split())
            if len(enunciado) > 140:
                enunciado = enunciado[:137].rstrip() + "..."
            valores = [str(q.get("id") or "—"), str(q.get("disciplina") or "—"), str(q.get("topico") or "—"), enunciado, str(q.get("banca") or "—"), str(q.get("ano") or "—")]
            for deslocamento, valor in enumerate(valores, start=1):
                celula = QTableWidgetItem(valor)
                if deslocamento == 4:
                    celula.setData(Qt.UserRole, q.get("id"))
                    celula.setToolTip(str(q.get("enunciado") or ""))
                if deslocamento in (1, 6):
                    celula.setTextAlignment(Qt.AlignCenter)
                aplicar_destaque_tabela(celula, "inativo", True)
                self.tabela.setItem(linha, deslocamento, celula)
            self.tabela.setRowHeight(linha, 34)
        self.tabela.blockSignals(False)
        self.marca_todas.blockSignals(True)
        self.marca_todas.setChecked(False)
        self.marca_todas.blockSignals(False)
        qtd = len(dados)
        self.contagem.setText("1 questão" if qtd == 1 else f"{qtd} questões")

    def alternar_todas(self, estado):
        marcado = estado == Qt.Checked
        self.tabela.blockSignals(True)
        for linha in range(self.tabela.rowCount()):
            item = self.tabela.item(linha, 0)
            if item is not None:
                item.setCheckState(Qt.Checked if marcado else Qt.Unchecked)
        self.tabela.blockSignals(False)

    def ids_marcados(self):
        ids = []
        for linha in range(self.tabela.rowCount()):
            item = self.tabela.item(linha, 0)
            if item is not None and item.checkState() == Qt.Checked:
                ids.append(int(item.data(Qt.UserRole)))
        return ids

    def id_selecionado(self):
        ids = self.ids_marcados()
        if len(ids) == 1:
            return ids[0]
        linha = self.tabela.currentRow()
        if linha < 0:
            return None
        item = self.tabela.item(linha, 4)
        return item.data(Qt.UserRole) if item is not None else None

    def visualizar(self):
        qid = self.id_selecionado()
        if qid is not None:
            JanelaVisualizarQuestao(qid, self).exec()

    def restaurar(self):
        ids = self.ids_marcados()
        if not ids:
            qid = self.id_selecionado()
            ids = [qid] if qid is not None else []
        if not ids:
            QMessageBox.information(self, "Lixeira", "Selecione pelo menos uma questão.")
            return
        try:
            fazer_backup("antes_restaurar_questoes_lixeira")
        except Exception as erro:
            QMessageBox.critical(self, "Backup", f"A operação foi cancelada porque o backup falhou.\n\n{erro}")
            return
        for qid in ids:
            restaurar_questao_da_lixeira(qid, reativar=True)
        self.carregar()

    def excluir_permanente(self):
        ids = self.ids_marcados()
        if not ids:
            qid = self.id_selecionado()
            ids = [qid] if qid is not None else []
        if not ids:
            QMessageBox.information(self, "Lixeira", "Selecione pelo menos uma questão.")
            return
        resposta = QMessageBox.question(
            self,
            "Excluir permanentemente",
            (
                f"Excluir permanentemente {len(ids)} questão(ões)?\n\n"
                "Essa ação não pode ser desfeita."
            ),
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )
        if resposta != QMessageBox.Yes:
            return
        try:
            fazer_backup("antes_excluir_permanente_lixeira")
        except Exception as erro:
            QMessageBox.critical(self, "Backup", f"A operação foi cancelada porque o backup falhou.\n\n{erro}")
            return
        for qid in ids:
            excluir_questao_permanentemente(qid)
        self.carregar()

    def esvaziar_lixeira(self):
        ids = [int(q.get("id")) for q in listar_questoes_lixeira(self.concurso[0]) if q.get("id") is not None]
        if not ids:
            QMessageBox.information(self, "Lixeira", "A Lixeira já está vazia.")
            return

        resposta = QMessageBox.question(
            self,
            "Esvaziar lixeira",
            (
                f"Excluir permanentemente todas as {len(ids)} questão(ões) da Lixeira?\n\n"
                "Esta ação não pode ser desfeita. O Vighna fará um backup antes de continuar."
            ),
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )
        if resposta != QMessageBox.Yes:
            return

        try:
            fazer_backup("antes_esvaziar_lixeira_questoes")
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Backup",
                f"A operação foi cancelada porque o backup falhou.\n\n{erro}"
            )
            return

        removidas = 0
        for qid in ids:
            if excluir_questao_permanentemente(qid):
                removidas += 1

        self.carregar()
        if removidas != len(ids):
            QMessageBox.warning(
                self,
                "Esvaziar lixeira",
                f"{removidas} de {len(ids)} questão(ões) foram excluídas permanentemente."
            )


class JanelaConfigurarSimulado(QDialog):
    def __init__(
        self,
        parent=None
    ):
        super().__init__(
            parent
        )
        self.setWindowModality(Qt.WindowModal)

        # Janela operacional ampla: permite maximizar/restaurar
        # pelo botão nativo do Windows e por duplo clique na barra.
        self.setWindowFlag(
            Qt.WindowMaximizeButtonHint,
            True
        )

        self.concurso = obter_concurso_ativo()
        self.configuracao = None
        self.disponibilidade = (
            obter_disponibilidade_simulado_disciplinas(
                self.concurso[0]
            )
        )
        self.linhas_personalizadas = {}

        self.setWindowTitle(
            "Simulados"
        )
        self.resize(
            1040,
            760
        )
        self.setMinimumSize(
            900,
            650
        )

        layout = QVBoxLayout(
            self
        )
        layout.setContentsMargins(
            18,
            16,
            18,
            16
        )
        layout.setSpacing(
            10
        )

        # ----------------------------------------------------
        # CABEÇALHO
        # ----------------------------------------------------

        cabecalho = QHBoxLayout()

        titulos = QVBoxLayout()
        titulos.setSpacing(
            1
        )

        titulo = QLabel(
            "Simulados"
        )
        titulo.setObjectName(
            "pageTitle"
        )

        subtitulo = QLabel(
            (
                "Escolha entre prova real, distribuição equilibrada ou um "
                "simulado estratégico com ajuste moderado pelas fragilidades."
            )
        )
        subtitulo.setObjectName(
            "pageSubtitle"
        )
        subtitulo.setWordWrap(
            True
        )

        titulos.addWidget(
            titulo
        )
        titulos.addWidget(
            subtitulo
        )

        perfil = QLabel(
            f"Perfil ativo: {self.concurso[1]}"
        )
        perfil.setObjectName(
            "profileBadge"
        )

        cabecalho.addLayout(
            titulos,
            1
        )
        cabecalho.addWidget(
            perfil,
            0,
            Qt.AlignVCenter
        )

        layout.addLayout(
            cabecalho
        )

        # ----------------------------------------------------
        # TIPO E OPÇÕES GERAIS
        # ----------------------------------------------------

        config_card = QFrame()
        config_card.setObjectName(
            "mockExamConfigCard"
        )

        config_layout = QGridLayout(
            config_card
