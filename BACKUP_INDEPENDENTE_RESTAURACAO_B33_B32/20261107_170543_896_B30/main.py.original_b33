        )

        layout.addWidget(
            filtros
        )

        # ----------------------------------------------------
        # CARDS
        # ----------------------------------------------------

        cards = QGridLayout()
        cards.setHorizontalSpacing(
            8
        )
        cards.setVerticalSpacing(
            8
        )

        for coluna in range(
            3
        ):
            cards.setColumnStretch(
                coluna,
