VIGHNASTUDY_LOGO_BASE64 = """"""

VIGHNASTUDY_LOGO_BATERIA_B20_BASE64 = """"""


def carregar_logo_vighnastudy():
    pixmap = QPixmap()

    try:
        dados = base64.b64decode(
            VIGHNASTUDY_LOGO_BASE64
        )

        pixmap.loadFromData(
            dados,
            "PNG"
        )
    except Exception:
        pass

    return pixmap


