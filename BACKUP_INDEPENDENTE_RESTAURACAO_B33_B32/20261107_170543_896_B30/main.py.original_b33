        # B15: movimentos sem botao pressionado, sem alterar selecao de texto.
        self.questao_enunciado.setMouseTracking(True)

        enunciado_layout.addWidget(
            self.questao_enunciado
        )

        conteudo_layout.addWidget(
            enunciado_card
        )

        self.alternativas_container = QWidget()
        self.alternativas_layout = QVBoxLayout(
