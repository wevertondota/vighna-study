        )

        self.concurso = obter_concurso_ativo()

        self.setWindowTitle(
            "Central de Efetividade e Calibração"
        )
        self.resize(
            1180,
            780
        )
        self.setMinimumSize(
            960,
            660
        )

        layout = QVBoxLayout(
            self
        )
        layout.setContentsMargins(
            18,
            15,
