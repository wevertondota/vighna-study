def aplicar_destaque_tabela(
    item,
    nivel,
    usar_fundo=False
):
    """
    Aplica destaque de tabela adaptado ao tema atual.

    niveis:
    - perigo
    - alerta
    - atencao
    - sucesso
    """
    tema = normalizar_tema(
        obter_configuracao_texto(
            "tema_interface",
            "claro"
        )
    )

    if tema == "futurista":
        paleta = {
            "perigo": (
                "#FF8FA3",
                "#3B1726"
            ),
            "alerta": (
                "#FFC06A",
                "#3A2512"
            ),
            "atencao": (
                "#FFE07A",
                "#332B12"
            ),
            "sucesso": (
                "#69EFC1",
                "#11382F"
            ),
            "inativo": (
                qss_color(tema, "table_highlight.inactive_text"),
                qss_color(tema, "table_highlight.inactive_surface")
            ),
        }
    elif tema == "escuro":
        paleta = {
            "perigo": (
                "#FCA5A5",
                "#3F1D27"
            ),
            "alerta": (
                "#FDBA74",
                "#431D0B"
            ),
            "atencao": (
                "#FDE68A",
                "#3A2E0B"
            ),
            "sucesso": (
                "#86EFAC",
                "#163523"
            ),
            "inativo": (
                qss_color(tema, "table_highlight.inactive_text"),
                qss_color(tema, "table_highlight.inactive_surface")
            ),
        }
    else:
        paleta = {
            "perigo": (
                "#B91C1C",
                "#FEE2E2"
            ),
            "alerta": (
                "#C2410C",
                "#FFEDD5"
            ),
            "atencao": (
                "#92400E",
                "#FEF3C7"
            ),
            "sucesso": (
                "#15803D",
                "#DCFCE7"
            ),
            "inativo": (
                qss_color(tema, "table_highlight.inactive_text"),
                qss_color(tema, "table_highlight.inactive_surface")
            ),
        }

    cor_texto, cor_fundo = paleta.get(
        nivel,
        (
            "#64748B",
            "#F1F5F9"
        )
    )

    item.setForeground(
        QColor(
            cor_texto
        )
    )

    if usar_fundo:
        item.setBackground(
            QColor(
                cor_fundo
            )
        )


def formatar_data(data):
    if not data:
        return "—"

    return datetime.strptime(
        data,
        "%Y-%m-%d"
    ).strftime("%d/%m/%Y")


def formatar_percentual(valor, casas=1):
    if valor is None:
        return "—"

    return f"{valor:.{casas}f}%".replace(".", ",")


def formatar_nome_conteudo_tabela(valor):
    """Converte nomes estruturais em uma linha apenas para exibição na tabela.

    O nome salvo no banco permanece intacto. Isso evita que uma quebra de linha
    entre, por exemplo, "TÍTULO I" e sua descrição faça o Qt aplicar reticências
    cedo demais mesmo quando há largura horizontal disponível.
    """
    bruto = str(valor or "")
    partes = []
    for parte in re.split(r"[\r\n]+", bruto):
        parte = re.sub(r"\s+", " ", parte).strip()
        parte = parte.strip(" -–—")
        if parte:
            partes.append(parte)

    if not partes:
        return ""

    if len(partes) > 1:
        return " — ".join(partes)

    return partes[0]


def formatar_tempo_foco_resumido(segundos):
    segundos = max(0, int(segundos or 0))
    horas, resto = divmod(segundos, 3600)
    minutos = resto // 60
    if horas:
        return f"{horas}h {minutos:02d}min"
    return f"{minutos} min"


def estimar_minutos_plano_foco(item):
    """Estimativa operacional do Plano Automático para preparar o Foco.

    A estimativa nunca entra nas métricas de estudo; o banco continua
    contabilizando exclusivamente ``duracao_efetiva`` medida pelo cronômetro.
    """
    item = item or {}
    questoes = max(0, int(item.get("questoes") or 0))
    revisoes = max(0, int(item.get("quantidade_revisoes") or 0))
    tipo = str(item.get("tipo") or "").strip().lower()

    minutos = 0
    if questoes > 0:
        # Regra simples e transparente: ~2 minutos por questão.
        minutos += questoes * 2
    if revisoes > 0:
        # Revisões planejadas recebem ~15 minutos por tópico/revisão.
        minutos += revisoes * 15

    if minutos <= 0:
        if "simulado" in tipo:
            minutos = 60
        elif "revis" in tipo:
            minutos = 15
        else:
            minutos = 30

    # Facilita o uso dos presets: arredonda para blocos de 5 minutos.
    minutos = int(((minutos + 4) // 5) * 5)
    return max(5, min(240, minutos))


def atividade_foco_para_item_plano(item):
    tipo = str((item or {}).get("tipo") or "").strip()
    validos = {
        "Treino adaptativo",
        "Teste de retenção",
        "Revisão",
        "Sessão de controle",
        "Simulado",
        "Questões",
    }
    if tipo in validos:
        return tipo
    if int((item or {}).get("questoes") or 0) > 0:
        return "Questões"
    return "Estudo livre"


def carregar_configuracao_espacamento():
    tabela = obter_tabela_padrao()

    texto_matriz = obter_configuracao_texto(
        "matriz_espacamento_json",
        None
    )

    if texto_matriz:
        try:
            tabela = normalizar_tabela_espacamento(
                json.loads(
                    texto_matriz
                )
            )
        except (
            ValueError,
            TypeError,
            json.JSONDecodeError
        ):
            tabela = obter_tabela_padrao()

    padrao_queda = (
        obter_configuracao_queda_padrao()
    )

    limite_moderada = obter_configuracao_int(
        "queda_limite_moderada",
        padrao_queda[
            "limite_moderada"
        ]
    )

    limite_forte = obter_configuracao_int(
        "queda_limite_forte",
        padrao_queda[
            "limite_forte"
        ]
    )

    penalizacao_moderada = obter_configuracao_int(
        "queda_penalizacao_moderada",
        padrao_queda[
            "penalizacao_moderada"
        ]
    )

    penalizacao_forte = obter_configuracao_int(
        "queda_penalizacao_forte",
        padrao_queda[
            "penalizacao_forte"
        ]
    )

    if (
        limite_forte
        <= limite_moderada
    ):
        limite_moderada = padrao_queda[
            "limite_moderada"
        ]
        limite_forte = padrao_queda[
            "limite_forte"
        ]

    return {
        "tabela": tabela,
        "limite_moderada": limite_moderada,
        "limite_forte": limite_forte,
        "penalizacao_moderada": max(
            0,
            min(
                90,
                penalizacao_moderada
            )
        ),
        "penalizacao_forte": max(
            0,
            min(
                90,
                penalizacao_forte
            )
        ),
    }


def salvar_configuracao_espacamento(
    tabela,
    limite_moderada,
    limite_forte,
    penalizacao_moderada,
    penalizacao_forte
):
    tabela = normalizar_tabela_espacamento(
        tabela
    )

    limite_moderada = int(
        limite_moderada
    )
    limite_forte = int(
        limite_forte
    )
    penalizacao_moderada = int(
        penalizacao_moderada
    )
    penalizacao_forte = int(
        penalizacao_forte
    )

    if limite_moderada < 1:
        raise ValueError(
            "O limite de queda moderada deve ser de pelo menos 1 p.p."
        )

    if limite_forte <= limite_moderada:
        raise ValueError(
            "O limite de queda forte precisa ser maior "
            "que o limite de queda moderada."
        )

    if (
        penalizacao_moderada < 0
        or penalizacao_moderada > 90
        or penalizacao_forte < 0
        or penalizacao_forte > 90
    ):
        raise ValueError(
            "As penalizações devem ficar entre 0% e 90%."
        )

    if (
        penalizacao_forte
        < penalizacao_moderada
    ):
        raise ValueError(
            "A penalização da queda forte não pode ser menor "
            "que a penalização da queda moderada."
        )

    # JSON transforma chaves inteiras em texto; a função de
    # normalização sabe reconstruí-las ao carregar.
    definir_configuracao_texto(
        "matriz_espacamento_json",
        json.dumps(
            tabela,
            ensure_ascii=False
        )
    )

    definir_configuracao_int(
        "queda_limite_moderada",
        limite_moderada
    )

    definir_configuracao_int(
        "queda_limite_forte",
        limite_forte
    )

    definir_configuracao_int(
        "queda_penalizacao_moderada",
        penalizacao_moderada
    )

    definir_configuracao_int(
        "queda_penalizacao_forte",
        penalizacao_forte
    )


def calcular_prioridade(
    proxima_revisao,
    percentual,
    revisoes,
    importancia=3,
    usar_importancia=True
):
    importancia = max(
        1,
        min(5, int(importancia or 3))
    )

    hoje = QDate.currentDate()
    data_revisao = QDate.fromString(
        proxima_revisao,
        "yyyy-MM-dd"
    )

    if not data_revisao.isValid():
        return 0, "SEM DATA", "Data inválida"

    atraso = max(
        0,
        data_revisao.daysTo(hoje)
    )

    if atraso == 0:
        score = 45.0
        motivo_data = "vence hoje"
    else:
        score = 50.0 + min(atraso, 20) * 1.5
        motivo_data = f"{atraso}d atrasada"

    if percentual is None:
        score += 10.0
        motivo_desempenho = "sem %"
    else:
        score += max(
            0.0,
            80.0 - percentual
        ) * 0.8
        motivo_desempenho = f"{percentual:.0f}%"

    if revisoes <= 0:
        score += 15.0
    elif revisoes == 1:
        score += 10.0
    elif revisoes == 2:
        score += 5.0

    ajuste_importancia = {
        1: -8.0,
        2: -4.0,
        3: 0.0,
        4: 6.0,
        5: 12.0
    }[importancia]

    if usar_importancia:
        score += ajuste_importancia

    score = max(
        0.0,
        min(
            100.0,
            round(score, 1)
        )
    )

    if score >= 80:
        nivel = "MUITO ALTA"
    elif score >= 60:
        nivel = "ALTA"
    elif score >= 40:
        nivel = "MÉDIA"
    else:
        nivel = "BAIXA"

    if usar_importancia:
        motivo_importancia = (
            f"imp. {importancia}/5"
        )
    else:
        motivo_importancia = (
            f"imp. {importancia}/5 (desligada)"
        )

    motivo = (
        f"{motivo_data} • "
        f"{motivo_desempenho} • "
        f"{revisoes} rev. • "
        f"{motivo_importancia}"
    )

    return score, nivel, motivo


def calcular_criticidade_redistribuicao(
    revisoes,
    percentual,
    importancia
):
    """
    Quanto maior o valor, mais conservador o sistema deve ser
    ao mexer na data do tópico.
    """
    importancia = max(
        1,
        min(
            5,
            int(
                importancia
                or 3
            )
        )
    )

    revisoes = max(
        0,
        int(
            revisoes
            or 0
        )
    )

    if percentual is None:
        componente_desempenho = 30.0
    else:
        componente_desempenho = max(
            0.0,
            85.0
            - float(
                percentual
            )
        ) * 1.4

    componente_revisoes = max(
        0,
        3 - revisoes
    ) * 7.0

    return (
        importancia * 18.0
        + componente_desempenho
        + componente_revisoes
    )


def pode_adiar_redistribuicao(
    revisoes,
    percentual,
    importancia
):
    """
    Adiamento é propositalmente mais restritivo que antecipação.
    Tópicos importantes, fracos, sem histórico suficiente ou ainda
    no início do ciclo ficam protegidos.
    """
    importancia = int(
        importancia
        or 3
    )
    revisoes = int(
        revisoes
        or 0
    )

    if importancia >= 4:
        return False

    if percentual is None:
        return False

    if float(
        percentual
    ) < 75.0:
        return False

    if revisoes < 2:
        return False

    return True


def gerar_sugestoes_redistribuicao(
    concurso_id
):
    hoje = QDate.currentDate()
    fim = hoje.addDays(
        6
    )

    carga_desejada = max(
        1,
        obter_configuracao_int(
            "redistribuicao_carga_desejada",
            5
        )
    )

    carga_maxima = max(
        carga_desejada,
        obter_configuracao_int(
            "redistribuicao_carga_maxima",
            8
        )
    )

    antecipar_max = max(
        0,
        obter_configuracao_int(
            "redistribuicao_antecipar_dias",
            2
        )
    )

    adiar_max = max(
        0,
        obter_configuracao_int(
            "redistribuicao_adiar_dias",
            1
        )
    )

    dados = listar_revisoes_agendadas_periodo(
        hoje.toString(
            "yyyy-MM-dd"
        ),
        fim.toString(
            "yyyy-MM-dd"
        ),
        concurso_id
    )

    datas = [
        hoje.addDays(
            indice
        )
        for indice in range(
            7
        )
    ]

    cargas_antes = {
        data.toString(
            "yyyy-MM-dd"
        ): 0
        for data in datas
    }

    itens_por_data = {
        data.toString(
            "yyyy-MM-dd"
        ): []
        for data in datas
    }

    for dado in dados:
        data_texto = dado[4]

        if data_texto not in cargas_antes:
            continue

        item = {
            "topico_id": dado[0],
            "disciplina": dado[1],
            "topico": dado[2],
            "revisoes": int(
                dado[3]
                or 0
            ),
            "data": data_texto,
            "percentual": dado[5],
            "importancia": int(
                dado[6]
                or 3
            ),
        }

        item["criticidade"] = (
            calcular_criticidade_redistribuicao(
                item["revisoes"],
                item["percentual"],
                item["importancia"]
            )
        )

        itens_por_data[
            data_texto
        ].append(
            item
        )

        cargas_antes[
            data_texto
        ] += 1

    cargas_depois = dict(
        cargas_antes
    )

    sugestoes = []

    # Não redistribui revisões de hoje. O foco desta rotina é
    # equilibrar a carga futura sem empurrar pendências atuais.
    fontes = [
        data
        for data in datas[1:]
        if cargas_antes[
            data.toString(
                "yyyy-MM-dd"
            )
        ] > carga_maxima
    ]

    def encontrar_destino(
        data_origem,
        item
    ):
        candidatos_antecipacao = []

        for deslocamento in range(
            1,
            antecipar_max + 1
        ):
            destino = data_origem.addDays(
                -deslocamento
            )

            if destino < hoje:
                continue

            destino_texto = destino.toString(
                "yyyy-MM-dd"
            )

            if destino_texto not in cargas_depois:
                continue

            carga = cargas_depois[
                destino_texto
            ]

            if carga < carga_desejada:
                faixa = 0
            elif carga < carga_maxima:
                faixa = 1
            else:
                continue

            candidatos_antecipacao.append(
                (
                    faixa,
                    carga,
                    deslocamento,
                    destino
                )
            )

        if candidatos_antecipacao:
            candidatos_antecipacao.sort(
                key=lambda valor: (
                    valor[0],
                    valor[1],
                    valor[2]
                )
            )
            return (
                candidatos_antecipacao[0][3],
                "Antecipar"
            )

        if not pode_adiar_redistribuicao(
            item["revisoes"],
            item["percentual"],
            item["importancia"]
        ):
            return (
                None,
                None
            )

        candidatos_adiamento = []

        for deslocamento in range(
            1,
            adiar_max + 1
        ):
            destino = data_origem.addDays(
                deslocamento
            )

            if destino > fim:
                continue

            destino_texto = destino.toString(
                "yyyy-MM-dd"
            )

            if destino_texto not in cargas_depois:
                continue

            carga = cargas_depois[
                destino_texto
            ]

            if carga < carga_desejada:
                faixa = 0
            elif carga < carga_maxima:
                faixa = 1
            else:
                continue

            candidatos_adiamento.append(
                (
                    faixa,
                    carga,
                    deslocamento,
                    destino
                )
            )

        if candidatos_adiamento:
            candidatos_adiamento.sort(
                key=lambda valor: (
                    valor[0],
                    valor[1],
                    valor[2]
                )
            )
            return (
                candidatos_adiamento[0][3],
                "Adiar"
            )

        return (
            None,
            None
        )

    for data_origem in fontes:
        origem_texto = data_origem.toString(
            "yyyy-MM-dd"
        )

        candidatos = sorted(
            itens_por_data[
                origem_texto
            ],
            key=lambda item: (
                item["criticidade"],
                item["importancia"],
                -(
                    item["percentual"]
                    if item["percentual"] is not None
                    else -1
                ),
                -item["revisoes"],
                item["disciplina"].lower(),
                item["topico"].lower()
            )
        )

        for item in candidatos:
            if cargas_depois[
                origem_texto
            ] <= carga_desejada:
                break

            destino, tipo = encontrar_destino(
                data_origem,
                item
            )

            if destino is None:
                continue

            destino_texto = destino.toString(
                "yyyy-MM-dd"
            )

            cargas_depois[
                origem_texto
            ] -= 1

            cargas_depois[
                destino_texto
            ] += 1

            if tipo == "Antecipar":
                motivo = (
                    "Antecipação conservadora para aliviar "
                    "um dia acima da carga máxima."
                )
            else:
                motivo = (
                    "Adiamento permitido por bom desempenho, "
                    "baixa criticidade e importância moderada/baixa."
                )

            sugestoes.append({
                "topico_id": item["topico_id"],
                "disciplina": item["disciplina"],
                "topico": item["topico"],
                "data_origem": origem_texto,
                "data_destino": destino_texto,
                "tipo": tipo,
                "revisoes": item["revisoes"],
                "percentual": item["percentual"],
                "importancia": item["importancia"],
                "criticidade": item["criticidade"],
                "motivo": motivo,
            })

    sobrecargas_antes = {
        data: carga
        for data, carga in cargas_antes.items()
        if (
            QDate.fromString(
                data,
                "yyyy-MM-dd"
            ) > hoje
            and carga > carga_maxima
        )
    }

    sobrecargas_depois = {
        data: carga
        for data, carga in cargas_depois.items()
        if (
            QDate.fromString(
                data,
                "yyyy-MM-dd"
            ) > hoje
            and carga > carga_maxima
        )
    }

    return {
        "inicio": hoje.toString(
            "yyyy-MM-dd"
        ),
        "fim": fim.toString(
            "yyyy-MM-dd"
        ),
        "carga_desejada": carga_desejada,
        "carga_maxima": carga_maxima,
        "antecipar_max": antecipar_max,
        "adiar_max": adiar_max,
        "cargas_antes": cargas_antes,
        "cargas_depois": cargas_depois,
        "sobrecargas_antes": sobrecargas_antes,
        "sobrecargas_depois": sobrecargas_depois,
        "sugestoes": sugestoes,
    }


class SeletorEstrelas(QWidget):
    """
    Seletor visual de importância de 1 a 5.

    As estrelas são desenhadas diretamente com QPainter,
    evitando diferenças de fonte/renderização entre Windows
    e versões do PySide6.
    """

    def __init__(
        self,
        valor=3,
        ao_alterar=None,
        parent=None
    ):
        super().__init__(
            parent
        )

        self.valor = max(
            1,
            min(
                5,
                int(valor or 3)
            )
        )

        self.ao_alterar = (
            ao_alterar
        )

        self.hover_valor = 0

        self.setFixedSize(
            126,
            28
        )

        self.setCursor(
            Qt.PointingHandCursor
        )

        self.setMouseTracking(
            True
        )

        self.setToolTip(
            "Clique em uma estrela para definir a importância de 1 a 5."
        )

    def _estrela_path(
        self,
        centro_x,
        centro_y,
        raio_externo=8.5,
        raio_interno=3.8
    ):
        import math

        caminho = QPainterPath()

        pontos = []

        for indice in range(
            10
        ):
            angulo = (
                -math.pi / 2
                + indice
                * math.pi
                / 5
            )

            raio = (
                raio_externo
                if indice % 2 == 0
                else raio_interno
            )

            x = (
                centro_x
                + raio
                * math.cos(
                    angulo
                )
            )

            y = (
                centro_y
                + raio
                * math.sin(
                    angulo
                )
            )

            pontos.append(
                QPointF(
                    x,
                    y
                )
            )

        caminho.moveTo(
            pontos[0]
        )

        for ponto in pontos[1:]:
            caminho.lineTo(
                ponto
            )

        caminho.closeSubpath()

        return caminho

    def _valor_por_x(
        self,
        x
    ):
        largura_util = 120.0
        inicio = 3.0

        relativo = max(
            0.0,
            min(
                largura_util - 0.01,
                float(x)
                - inicio
            )
        )

        valor = int(
            relativo
            / (
                largura_util
                / 5.0
            )
        ) + 1

        return max(
            1,
            min(
                5,
                valor
            )
        )

    def mouseMoveEvent(
        self,
        evento
    ):
        self.hover_valor = (
            self._valor_por_x(
                evento.position().x()
            )
        )

        self.update()

        super().mouseMoveEvent(
            evento
        )

    def leaveEvent(
        self,
        evento
    ):
        self.hover_valor = 0
        self.update()

        super().leaveEvent(
            evento
        )

    def mousePressEvent(
        self,
        evento
    ):
        if (
            evento.button()
            == Qt.LeftButton
        ):
            novo_valor = (
                self._valor_por_x(
                    evento.position().x()
                )
            )

            self.definir_valor(
                novo_valor
            )

        super().mousePressEvent(
            evento
        )

    def definir_valor(
        self,
        valor
    ):
        valor = max(
            1,
            min(
                5,
                int(valor)
            )
        )

        if valor == self.valor:
            return

        self.valor = valor

        self.update()

        if self.ao_alterar is not None:
            self.ao_alterar(
                valor
            )

    def paintEvent(
        self,
        evento
    ):
        painter = QPainter(
            self
        )

        painter.setRenderHint(
            QPainter.Antialiasing,
            True
        )

        preenchidas = (
            self.hover_valor
            if self.hover_valor > 0
            else self.valor
        )

        cor_ativa = fixed_qcolor(
            "task_indicator.rating_star_active"
        )

        cor_vazia = fixed_qcolor(
            "task_indicator.rating_star_empty"
        )

        centro_y = (
            self.height()
            / 2.0
        )

        for indice in range(
            5
        ):
            centro_x = (
                13.0
                + indice
                * 24.0
            )

            estrela = (
                self._estrela_path(
                    centro_x,
                    centro_y
                )
            )

            ativa = (
                indice
                < preenchidas
            )

            if ativa:
                painter.setPen(
                    QPen(
                        cor_ativa,
                        1.0
                    )
                )

                painter.setBrush(
                    QBrush(
                        cor_ativa
                    )
                )

            else:
                painter.setPen(
                    QPen(
                        cor_vazia,
                        1.35
                    )
                )

                painter.setBrush(
                    Qt.NoBrush
                )

            painter.drawPath(
                estrela
            )


class IndicadorEstrelasFila(SeletorEstrelas):
    """
    Versão compacta e somente leitura das estrelas,
    usada na fila inteligente do Dashboard.
    """

    def __init__(
        self,
        valor=3,
        parent=None
    ):
        super().__init__(
            valor=valor,
            ao_alterar=None,
            parent=parent
        )

        self.hover_valor = 0

        self.setFixedSize(
            98,
            22
        )

        self.setCursor(
            Qt.ArrowCursor
        )

        self.setAttribute(
            Qt.WA_TransparentForMouseEvents,
            True
        )

        self.setToolTip(
            f"Importância: {self.valor}/5"
        )

    def paintEvent(
        self,
        evento
    ):
        painter = QPainter(
            self
        )

        painter.setRenderHint(
            QPainter.Antialiasing,
            True
        )

        cor_ativa = fixed_qcolor(
            "task_indicator.rating_star_active"
        )

        cor_vazia = fixed_qcolor(
            "task_indicator.rating_star_empty"
        )

        centro_y = (
            self.height()
            / 2.0
        )

        for indice in range(
            5
        ):
            centro_x = (
                10.0
                + indice
                * 19.0
            )

            estrela = self._estrela_path(
                centro_x,
                centro_y,
                raio_externo=6.6,
                raio_interno=3.0
            )

            ativa = (
                indice
                < self.valor
            )

            if ativa:
                painter.setPen(
                    QPen(
                        cor_ativa,
                        1.0
                    )
                )
                painter.setBrush(
                    QBrush(
                        cor_ativa
                    )
                )
            else:
                painter.setPen(
                    QPen(
                        cor_vazia,
                        1.1
                    )
                )
                painter.setBrush(
                    Qt.NoBrush
                )

            painter.drawPath(
                estrela
            )


class IndicadorChamasPrioridade(QWidget):
    """
    Indicador compacto e somente leitura da prioridade da fila.

    BAIXA       -> 1 chama
    MÉDIA       -> 2 chamas
    ALTA        -> 3 chamas
    MUITO ALTA  -> 4 chamas
    """

    MAPA = {
        "BAIXA": 1,
        "MÉDIA": 2,
        "MEDIA": 2,
        "ALTA": 3,
        "MUITO ALTA": 4,
    }

    def __init__(
        self,
        nivel="BAIXA",
        parent=None
    ):
        super().__init__(
            parent
        )

        self.nivel = str(
            nivel or "BAIXA"
        ).upper()

        self.quantidade = self.MAPA.get(
            self.nivel,
            1
        )

        self.setFixedSize(
            76,
            24
        )

        nome_tooltip = {
            "BAIXA": "Baixa",
            "MÉDIA": "Média",
            "MEDIA": "Média",
            "ALTA": "Alta",
            "MUITO ALTA": "Muito alta",
        }.get(
            self.nivel,
            self.nivel.title()
        )

        self.setToolTip(
            f"Prioridade: {nome_tooltip}"
        )

        self.setAttribute(
            Qt.WA_TransparentForMouseEvents,
            True
        )

    def _chama_path(
        self,
        centro_x,
        base_y,
        escala=1.0
    ):
        caminho = QPainterPath()

        caminho.moveTo(
            centro_x,
            base_y
        )

        caminho.cubicTo(
            centro_x - 5.5 * escala,
            base_y - 2.5 * escala,
            centro_x - 6.2 * escala,
            base_y - 7.2 * escala,
            centro_x - 2.5 * escala,
            base_y - 10.8 * escala
        )

        caminho.cubicTo(
            centro_x - 0.6 * escala,
            base_y - 12.7 * escala,
            centro_x - 1.0 * escala,
            base_y - 15.1 * escala,
            centro_x + 0.5 * escala,
            base_y - 17.0 * escala
        )

        caminho.cubicTo(
            centro_x + 1.7 * escala,
            base_y - 13.8 * escala,
            centro_x + 5.3 * escala,
            base_y - 12.2 * escala,
            centro_x + 5.0 * escala,
            base_y - 7.8 * escala
        )

        caminho.cubicTo(
            centro_x + 4.8 * escala,
            base_y - 3.4 * escala,
            centro_x + 2.5 * escala,
            base_y - 0.8 * escala,
            centro_x,
            base_y
        )

        caminho.closeSubpath()

        return caminho

    def paintEvent(
        self,
        evento
    ):
        painter = QPainter(
            self
        )

        painter.setRenderHint(
            QPainter.Antialiasing,
            True
        )

        cor_externa = fixed_qcolor(
            "task_indicator.streak_flame_outer"
        )

        cor_interna = fixed_qcolor(
            "task_indicator.streak_flame_inner"
        )

        espacamento = 16
        largura_total = (
            (self.quantidade - 1)
            * espacamento
            + 12
        )

        inicio_x = (
            self.width()
            - largura_total
        ) / 2.0 + 6.0

        base_y = (
            self.height()
            - 2.8
        )

        for indice in range(
            self.quantidade
        ):
            centro_x = (
                inicio_x
                + indice
                * espacamento
            )

            chama = self._chama_path(
                centro_x,
                base_y,
                0.72
            )

            painter.setPen(
                QPen(
                    cor_externa,
                    0.8
                )
            )

            painter.setBrush(
                QBrush(
                    cor_externa
                )
            )

            painter.drawPath(
                chama
            )

            nucleo = QPainterPath()

            nucleo.moveTo(
                centro_x,
                base_y - 1.0
            )

            nucleo.cubicTo(
                centro_x - 2.0,
                base_y - 2.8,
                centro_x - 1.6,
                base_y - 6.1,
                centro_x + 0.1,
                base_y - 8.0
            )

            nucleo.cubicTo(
                centro_x + 0.8,
                base_y - 5.8,
                centro_x + 1.9,
                base_y - 3.9,
                centro_x,
                base_y - 1.0
            )

            nucleo.closeSubpath()

            painter.setPen(
                Qt.NoPen
            )

            painter.setBrush(
                QBrush(
                    cor_interna
                )
            )

            painter.drawPath(
                nucleo
            )


class GraficoEvolucao(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)

        self.percentuais = []
        self.rotulos = []

        self.setMinimumHeight(190)

        self.setSizePolicy(
            QSizePolicy.Expanding,
            QSizePolicy.Fixed
        )

    def definir_dados(
        self,
        percentuais,
        rotulos=None
    ):
        self.percentuais = [
            float(valor)
            for valor in percentuais
        ]

        if rotulos is None:
            self.rotulos = [
                f"R{i + 1}"
                for i in range(
                    len(self.percentuais)
                )
            ]
        else:
            self.rotulos = list(rotulos)

        self.update()

    def paintEvent(self, evento):
        painter = QPainter(self)

        painter.setRenderHint(
            QPainter.Antialiasing
        )

        area = self.rect()

        painter.fillRect(
            area,
            self.palette().base()
        )

        margem_esquerda = 52
        margem_direita = 24
        margem_topo = 24
        margem_baixo = 42

        largura = (
            area.width()
            - margem_esquerda
            - margem_direita
        )

        altura = (
            area.height()
            - margem_topo
            - margem_baixo
        )

        if largura <= 0 or altura <= 0:
            return

        fonte = QFont(
            painter.font()
        )
        fonte.setPointSize(8)

        painter.setFont(fonte)

        # Linhas de referência de 0% a 100%.
        for valor in [0, 25, 50, 75, 100]:
            y = (
                margem_topo
                + altura
                - (
                    valor / 100.0
                ) * altura
            )

            painter.setPen(
                QPen(
                    self.palette().mid().color(),
                    1
                )
            )

            painter.drawLine(
                margem_esquerda,
                int(y),
                margem_esquerda + largura,
                int(y)
            )

            painter.setPen(
                self.palette().text().color()
            )

            painter.drawText(
                QRectF(
                    4,
                    y - 10,
                    margem_esquerda - 10,
                    20
                ),
                Qt.AlignRight |
                Qt.AlignVCenter,
                f"{valor}%"
            )

        if not self.percentuais:
            painter.setPen(
                self.palette().text().color()
            )

            painter.drawText(
                QRectF(
                    margem_esquerda,
                    margem_topo,
                    largura,
                    altura
                ),
                Qt.AlignCenter,
                "Ainda não há revisões detalhadas "
                "registradas no programa."
            )
            return

        if len(self.percentuais) == 1:
            xs = [
                margem_esquerda
                + largura / 2
            ]
        else:
            passo = (
                largura /
                (
                    len(self.percentuais) - 1
                )
            )

            xs = [
                margem_esquerda
                + indice * passo
                for indice in range(
                    len(self.percentuais)
                )
            ]

        pontos = []

        for indice, percentual in enumerate(
            self.percentuais
        ):
            percentual = max(
                0.0,
                min(
                    100.0,
                    percentual
                )
            )

            y = (
                margem_topo
                + altura
                - (
                    percentual / 100.0
                ) * altura
            )

            pontos.append(
                QPointF(
                    xs[indice],
                    y
                )
            )

        # Linha de evolução.
        painter.setPen(
            QPen(
                self.palette().highlight().color(),
                2
            )
        )

        for indice in range(
            len(pontos) - 1
        ):
            painter.drawLine(
                pontos[indice],
                pontos[indice + 1]
            )

        # Pontos e rótulos.
        for indice, ponto in enumerate(
            pontos
        ):
            painter.setBrush(
                self.palette().highlight()
            )

            painter.setPen(
                QPen(
                    self.palette().highlight().color(),
                    1
                )
            )

            painter.drawEllipse(
                ponto,
                4,
                4
            )

            painter.setPen(
                self.palette().text().color()
            )

            painter.drawText(
                QRectF(
                    ponto.x() - 28,
                    ponto.y() - 27,
                    56,
                    20
                ),
                Qt.AlignCenter,
                formatar_percentual(
                    self.percentuais[indice],
                    1
                )
            )

            rotulo = (
                self.rotulos[indice]
                if indice < len(self.rotulos)
                else f"R{indice + 1}"
            )

            painter.drawText(
                QRectF(
                    ponto.x() - 35,
                    margem_topo + altura + 8,
                    70,
                    22
                ),
                Qt.AlignCenter,
                rotulo
            )


class GraficoSerieTemporal(QWidget):
    def __init__(
        self,
        titulo="",
        percentual=False,
        barras=False,
        parent=None
    ):
        super().__init__(
            parent
        )

        self.titulo = titulo
        self.percentual = percentual
        self.barras = barras
        self.valores = []
        self.rotulos = []

        self.setMinimumHeight(
            190
        )
        self.setSizePolicy(
            QSizePolicy.Expanding,
            QSizePolicy.Fixed
        )

    def definir_dados(
        self,
        valores,
        rotulos
    ):
        self.valores = list(
            valores
        )
        self.rotulos = list(
            rotulos
        )
        self.update()

    def paintEvent(
        self,
        evento
    ):
        painter = QPainter(
            self
        )
        painter.setRenderHint(
            QPainter.Antialiasing
        )

        area = self.rect()

        painter.fillRect(
            area,
            self.palette().base()
        )

        margem_esquerda = 54
        margem_direita = 20
        margem_topo = 18
        margem_baixo = 34

        largura = (
            area.width()
            - margem_esquerda
            - margem_direita
        )
        altura = (
            area.height()
            - margem_topo
            - margem_baixo
        )

        if (
            largura <= 0
            or altura <= 0
        ):
            return

        fonte = QFont(
            painter.font()
        )
        fonte.setPointSize(
            8
        )
        painter.setFont(
            fonte
        )

        validos = [
            float(valor)
            for valor in self.valores
            if valor is not None
        ]

        if self.percentual:
            maximo = 100.0
            marcas = [
                0,
                25,
                50,
                75,
                100
            ]
        else:
            maximo_real = max(
                validos,
                default=0.0
            )

            maximo = max(
                1.0,
                maximo_real
            )

            # Folga visual no topo.
            maximo *= 1.12

            marcas = [
                0,
                maximo * 0.25,
                maximo * 0.50,
                maximo * 0.75,
                maximo
            ]

        # Grade horizontal e escala Y.
        for valor in marcas:
            y = (
                margem_topo
                + altura
                - (
                    float(
                        valor
                    )
                    / maximo
                )
                * altura
            )

            painter.setPen(
                QPen(
                    self.palette().mid().color(),
                    1
                )
            )
            painter.drawLine(
                margem_esquerda,
                int(
                    y
                ),
                margem_esquerda + largura,
                int(
                    y
                )
            )

            painter.setPen(
                self.palette().text().color()
            )

            if self.percentual:
                texto = (
                    f"{int(round(valor))}%"
                )
            else:
                if valor >= 100:
                    texto = (
                        f"{valor:.0f}"
                    )
                elif valor >= 10:
                    texto = (
                        f"{valor:.0f}"
                    )
                else:
                    texto = (
                        f"{valor:.1f}"
                    )

            painter.drawText(
                QRectF(
                    3,
                    y - 10,
                    margem_esquerda - 10,
                    20
                ),
                Qt.AlignRight
                | Qt.AlignVCenter,
                texto
            )

        if not self.valores:
            painter.setPen(
                self.palette().text().color()
            )
            painter.drawText(
                QRectF(
                    margem_esquerda,
                    margem_topo,
                    largura,
                    altura
                ),
                Qt.AlignCenter,
                "Ainda não há dados no período selecionado."
            )
            return

        quantidade = len(
            self.valores
        )

        passo = (
            largura
            / max(
                1,
                quantidade
            )
        )

        destaque = (
            self.palette()
            .highlight()
            .color()
        )

        if self.barras:
            largura_barra = max(
                2.0,
                min(
                    22.0,
                    passo * 0.62
                )
            )

            painter.setPen(
                Qt.NoPen
            )
            painter.setBrush(
                destaque
            )

            for indice, valor in enumerate(
                self.valores
            ):
                valor_numerico = (
                    float(
                        valor
                    )
                    if valor is not None
                    else 0.0
                )

                x_centro = (
                    margem_esquerda
                    + (
                        indice
                        + 0.5
                    )
                    * passo
                )

                altura_barra = (
                    max(
                        0.0,
                        valor_numerico
                    )
                    / maximo
                ) * altura

                painter.drawRoundedRect(
                    QRectF(
                        x_centro
                        - largura_barra / 2,
                        margem_topo
                        + altura
                        - altura_barra,
                        largura_barra,
                        altura_barra
                    ),
                    2,
                    2
                )

        else:
            pontos = []

            for indice, valor in enumerate(
                self.valores
            ):
                if valor is None:
                    continue

                valor_numerico = max(
                    0.0,
                    min(
                        maximo,
                        float(
                            valor
                        )
                    )
                )

                x = (
                    margem_esquerda
                    + (
                        indice
                        + 0.5
                    )
                    * passo
                )
                y = (
                    margem_topo
                    + altura
                    - (
                        valor_numerico
                        / maximo
                    )
                    * altura
                )

                pontos.append(
                    (
                        indice,
                        QPointF(
                            x,
                            y
                        )
                    )
                )

            painter.setPen(
                QPen(
                    destaque,
                    2
                )
            )

            for posicao in range(
                len(
                    pontos
                )
                - 1
            ):
                indice_a, ponto_a = (
                    pontos[
                        posicao
                    ]
                )
                indice_b, ponto_b = (
                    pontos[
                        posicao
                        + 1
                    ]
                )

                # Não conecta por cima de dias sem resultado.
                if (
                    indice_b
                    - indice_a
                    == 1
                ):
                    painter.drawLine(
                        ponto_a,
                        ponto_b
                    )

            painter.setBrush(
                destaque
            )

            for _, ponto in pontos:
                painter.drawEllipse(
                    ponto,
                    3.5,
                    3.5
                )

        # Rótulos do eixo X: no máximo 6 posições.
        if quantidade > 0:
            max_rotulos = 6

            if quantidade <= max_rotulos:
                indices_rotulo = list(
                    range(
                        quantidade
                    )
                )
            else:
                indices_rotulo = sorted(
                    {
                        round(
                            indice
                            * (
                                quantidade
                                - 1
                            )
                            / (
                                max_rotulos
                                - 1
                            )
                        )
                        for indice in range(
                            max_rotulos
                        )
                    }
                )

            painter.setPen(
                self.palette().text().color()
            )

            for indice in indices_rotulo:
                x = (
                    margem_esquerda
                    + (
                        indice
                        + 0.5
                    )
                    * passo
                )

                rotulo = (
                    self.rotulos[
                        indice
                    ]
                    if indice
                    < len(
                        self.rotulos
                    )
                    else ""
                )

                painter.drawText(
                    QRectF(
                        x - 34,
                        margem_topo
                        + altura
                        + 7,
                        68,
                        20
                    ),
                    Qt.AlignCenter,
                    rotulo
                )


VPQ_1_1_PROMPT = """VIGHNA PDF — VPQ 1.1
DISCIPLINA: Direito Penal
TÍTULO: Título I: Dos crimes contra a pessoa
CAPÍTULO: Capítulo I: Dos crimes contra a vida
FONTE: Simulado próprio — setembro/2026
QUANTIDADE: 2
FORMATO: MULTIPLA-ESCOLHA
ALTERNATIVAS: A-E

QUESTÃO 1
Enunciado completo da questão 1.

A) Texto da alternativa A
B) Texto da alternativa B
C) Texto da alternativa C
D) Texto da alternativa D
GABARITO: B
EXPLICAÇÃO: Comentário opcional da questão.

QUESTÃO 2
Enunciado completo da questão 2.

A) Texto da alternativa A
B) Texto da alternativa B
C) Texto da alternativa C
D) Texto da alternativa D
GABARITO: A

REGRAS DO PROTOCOLO
1. Use exatamente a primeira linha: VIGHNA PDF — VPQ 1.1.
2. DISCIPLINA é recomendada para a identificação precisa.
3. Preencha TÍTULO, CAPÍTULO ou ambos. Pelo menos um deles é suficiente.
4. Quando ambos forem usados, o capítulo deve pertencer ao título informado.
5. Para Código de Trânsito Brasileiro (CTB), use CAPÍTULO como classificação
   principal e omita TÍTULO, pois o CTB é organizado diretamente em capítulos.
6. Use os nomes cadastrados no perfil ativo; maiúsculas, acentos e os
   separadores ":", "-" e "–" são aceitos como equivalentes.
7. GABARITO deve apontar para uma alternativa existente em cada questão.
8. Para itens CESPE/Cebraspe, use FORMATO: CERTO-ERRADO e não crie
   alternativas artificiais. Use apenas GABARITO: CERTO ou GABARITO: ERRADO.

MODELO CERTO/ERRADO
VIGHNA PDF — VPQ 1.1
DISCIPLINA: Direito Constitucional
TÍTULO: Direitos e Garantias Fundamentais
FONTE: Simulado próprio
QUANTIDADE: 1
FORMATO: CERTO-ERRADO

QUESTÃO 1
Julgue o item conforme o conteúdo estudado.
GABARITO: CERTO
EXPLICAÇÃO: Comentário da questão.
"""


