        QPushButton#subtleButton[sessionNavigation="true"]:focus,
        QPushButton#questionSessionFocusButton:focus,
        QPushButton#questionSessionPauseButton:focus,
        QPushButton#questionSessionEndButton:focus {
            border: 2px solid #B49269;
