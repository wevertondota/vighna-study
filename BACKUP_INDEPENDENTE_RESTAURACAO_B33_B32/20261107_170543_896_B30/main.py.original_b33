        )

        self.registrar_opcao_pesquisa(
            secao_espacamento,
            opcao_matriz,
            "Matriz de espaçamento",
            (
                "matriz espacamento espaçamento intervalo intervalos "
                "dias prazo prazos revisão revisao desempenho percentual "
                "faixa faixas calendário calendario sugestao sugestão "
                "queda penalizacao penalização configurar"
            )
        )

        # ====================================================
        # EFICIÊNCIA E AUTOMAÇÃO
        # ====================================================

        secao_eficiencia, layout_eficiencia = (
            self.criar_secao_configuracao(
                "Eficiência e automação",
                "Preferências de estudo e diagnóstico técnico em controles separados."
            )
        )

        opcao_fluxo = QFrame()
        opcao_fluxo.setObjectName("settingsOption")
        fluxo_layout = QVBoxLayout(opcao_fluxo)
        fluxo_layout.setContentsMargins(14, 11, 14, 12)
        fluxo_layout.setSpacing(8)

        fluxo_titulo = QLabel("Fluxo rápido de estudo")
        fluxo_titulo.setObjectName("configOptionTitle")
        fluxo_desc = QLabel(
            "O modo de 1 clique prepara a recomendação atual diretamente no Modo Foco. "
            "Ele nunca inicia o cronômetro sozinho."
        )
        fluxo_desc.setObjectName("mutedLabel")
        fluxo_desc.setWordWrap(True)
        fluxo_layout.addWidget(fluxo_titulo)
        fluxo_layout.addWidget(fluxo_desc)

        self.mostrar_modo_um_clique = QCheckBox("Mostrar ▶ Começar agora no Dashboard")
        self.mostrar_modo_um_clique.setChecked(
            obter_configuracao_bool("mostrar_modo_um_clique", True)
        )
        self.calibracao_automatica_foco = QCheckBox(
            "Calibrar duração sugerida pelo tempo real das minhas sessões"
        )
        self.calibracao_automatica_foco.setChecked(
            obter_configuracao_bool("calibracao_automatica_foco", True)
        )
        self.aprender_decisoes_estudar_agora = QCheckBox(
            "Aprender com recomendações aceitas ou ignoradas"
        )
        self.aprender_decisoes_estudar_agora.setChecked(
            obter_configuracao_bool("aprender_decisoes_estudar_agora", True)
        )
        fluxo_layout.addWidget(self.mostrar_modo_um_clique)
        fluxo_layout.addWidget(self.calibracao_automatica_foco)
        fluxo_layout.addWidget(self.aprender_decisoes_estudar_agora)

        atalhos_info = QLabel(
            "Atalhos: Ctrl+K busca rápida • Ctrl+F Foco • Ctrl+Q Questões • "
            "Ctrl+Shift+C checkpoint rápido • Ctrl+H Dashboard"
        )
        atalhos_info.setObjectName("mutedLabel")
        atalhos_info.setWordWrap(True)
        fluxo_layout.addWidget(atalhos_info)
        layout_eficiencia.addWidget(opcao_fluxo)
        self.registrar_opcao_pesquisa(
            secao_eficiencia,
            opcao_fluxo,
            "Fluxo rápido e calibração",
            "eficiencia eficiência rápido rapido um clique começar agora calibracao calibração histórico historico decisões decisoes atalhos ctrl busca foco questões",
        )

        opcao_diagnostico = QFrame()
        opcao_diagnostico.setObjectName("settingsOption")
        diagnostico_layout = QVBoxLayout(opcao_diagnostico)
        diagnostico_layout.setContentsMargins(14, 11, 14, 12)
        diagnostico_layout.setSpacing(12)
        diagnostico_textos = QVBoxLayout()
        diagnostico_titulo = QLabel(f"Diagnóstico técnico • VighnaStudy {VIGHNA_VERSION}")
        diagnostico_titulo.setObjectName("configOptionTitle")
        diagnostico_desc = QLabel(
            "Confira o banco ativo, integridade SQLite, índices, versão do Python "
            "e último checkpoint. Inclui PRAGMA optimize seguro."
        )
        diagnostico_desc.setObjectName("mutedLabel")
        diagnostico_desc.setWordWrap(True)
        diagnostico_textos.addWidget(diagnostico_titulo)
        diagnostico_textos.addWidget(diagnostico_desc)
        abrir_diagnostico = QPushButton("Executar diagnóstico")
        abrir_diagnostico.setObjectName("toolbarButton")
        abrir_diagnostico.clicked.connect(self.abrir_diagnostico)
        diagnostico_layout.addLayout(diagnostico_textos)
        diagnostico_layout.addWidget(abrir_diagnostico, 0, Qt.AlignLeft)
        layout_eficiencia.addWidget(opcao_diagnostico)
        self.registrar_opcao_pesquisa(
            secao_eficiencia,
            opcao_diagnostico,
            "Diagnóstico técnico",
            "diagnostico diagnóstico integridade sqlite banco versão versao python indice índices performance desempenho optimize",
        )

        # ====================================================
