        explicacao.setWordWrap(True)
        coluna_texto_cabecalho.addWidget(explicacao)

        cabecalho_layout.addLayout(coluna_texto_cabecalho, 1)

        # A imagem não contém textos nem controles. QPixmap é carregado apenas
        # uma vez e não há timer, processamento de GIF ou repaint periódico.
        self._arte_header_config_original = QPixmap()
        self._arte_header_config_original.loadFromData(
            base64.b64decode(_ART_HEADER_CONFIG_M03_JPEG_B64)
        )
        self._arte_header_config = QLabel()
        self._arte_header_config.setObjectName("settingsHeaderArtworkM03")
        self._arte_header_config.setAlignment(Qt.AlignCenter)
        self._arte_header_config.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        self._arte_header_config.setSizePolicy(
            QSizePolicy.Fixed, QSizePolicy.Fixed
        )
        self._arte_header_config.setFixedSize(340, 72)
        cabecalho_layout.addWidget(self._arte_header_config, 0, Qt.AlignVCenter)
        # O cabeçalho será anexado ao layout principal após a criação da
        # busca. Isso mantém as conexões Qt já existentes, sem mover widgets
        # ativos ou duplicar campos.

        # ====================================================
        # PESQUISA
        # ====================================================

        barra_busca = QFrame()
