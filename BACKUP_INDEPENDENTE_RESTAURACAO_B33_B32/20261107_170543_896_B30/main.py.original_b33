            )

        def criar_card(
            titulo_texto
        ):
            card = QFrame()
            card.setObjectName(
                "effectivenessStatCard"
            )

            card_layout = QVBoxLayout(
                card
            )
            card_layout.setContentsMargins(
                11,
                8,
                11,
                8
            )
            card_layout.setSpacing(
                2
            )

