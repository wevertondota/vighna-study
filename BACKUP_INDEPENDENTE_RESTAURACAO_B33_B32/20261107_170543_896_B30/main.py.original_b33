        )
        self.aplicar_penalizacao.setObjectName(
            "configMainCheck"
        )
        self.aplicar_penalizacao.setChecked(
            obter_configuracao_bool(
                "aplicar_penalizacao_queda",
                True
            )
        )

        self.descricao_penalizacao = QLabel()
        self.descricao_penalizacao.setWordWrap(
            True
        )
        self.descricao_penalizacao.setObjectName(
            "mutedLabel"
        )

        queda_layout.addWidget(
            self.aplicar_penalizacao
        )
        queda_layout.addWidget(
            self.descricao_penalizacao
        )

        self.atualizar_descricao_penalizacao()

        layout_espacamento.addWidget(
            opcao_queda
