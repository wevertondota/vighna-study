    def carregar_disciplinas(self):
        concurso_id = (
            obter_concurso_ativo()[0]
        )

        self.questao_disciplina.blockSignals(
            True
        )
        self.questao_disciplina.clear()

        for disciplina_id, nome in listar_disciplinas(
            concurso_id,
            incluir_pausadas=True
        ):
            self.questao_disciplina.addItem(
                nome,
                disciplina_id
            )

        self.questao_disciplina.blockSignals(
            False
        )

        self.carregar_topicos()

    def carregar_topicos(self):
        disciplina = (
            self.questao_disciplina.currentText()
        )

        self.questao_topico.blockSignals(True)
        self.questao_topico.clear()
        self.questao_topico.addItem(
            "Não informado",
            None
        )

        if not disciplina:
            self.questao_topico.blockSignals(False)
            self.carregar_capitulos()
            return

        concurso_id = (
            obter_concurso_ativo()[0]
        )

        for topico in listar_topicos_gerenciamento(
            disciplina,
            concurso_id
        ):
            self.questao_topico.addItem(
                topico[1],
                topico[0]
            )

        self.questao_topico.blockSignals(False)
        self.carregar_capitulos()

    def carregar_capitulos(self):
        disciplina = self.questao_disciplina.currentText()
        topico_id = self.questao_topico.currentData()

        self.questao_capitulo.blockSignals(True)
        self.questao_capitulo.clear()
        self.questao_capitulo.addItem(
            "Não informado",
            None
        )

        if topico_id is not None:
            capitulos = listar_capitulos_topico(topico_id)
            for capitulo_id, nome, _ordem, _dificuldade, _pausado in capitulos:
                self.questao_capitulo.addItem(nome, capitulo_id)
        elif disciplina:
            capitulos = listar_capitulos_perfil(disciplina)
            for capitulo_id, nome, _topico_id, titulo, _disciplina in capitulos:
                self.questao_capitulo.addItem(
                    f"{titulo} — {nome}",
                    capitulo_id
                )

        self.questao_capitulo.blockSignals(False)

    def atualizar_tipo_questao_editor(self):
        tipo = self.questao_tipo.currentData() or "MULTIPLA_ESCOLHA"
        multipla = tipo == "MULTIPLA_ESCOLHA"
        self.alternativas_card.setVisible(multipla)
        self.certo_errado_card.setVisible(not multipla)

    def carregar_questao_existente(self):
        dados = obter_questao(
            self.questao_id
        )

        if dados is None:
            QMessageBox.warning(
                self,
                "Questão",
                "A questão não foi encontrada."
            )
            self.reject()
            return

        self.questao_ativa_atual = bool(
            dados.get(
                "ativa",
                True
            )
        )

        integridade = obter_integridade_questao(
            self.questao_id
        )

        if integridade is not None:
            self.questao_tentativas_existentes = int(
                integridade[
                    "tentativas"
                ]
            )

        if self.questao_tentativas_existentes > 0:
            self.questao_integridade_aviso.setText(
                (
                    f"Esta questão possui "
                    f"{self.questao_tentativas_existentes} tentativa(s) "
                    "registrada(s). Alterações feitas agora afetarão apenas "
                    "respostas futuras; o conteúdo das tentativas anteriores "
                    "permanece congelado no histórico."
                )
            )
            self.questao_integridade_aviso.show()

        indice_disciplina = (
            self.questao_disciplina.findText(
                dados[
                    "disciplina"
                ]
            )
        )

        if indice_disciplina >= 0:
            self.questao_disciplina.setCurrentIndex(
                indice_disciplina
            )

        self.carregar_topicos()

        indice_topico = (
            self.questao_topico.findData(
                dados[
                    "topico_id"
                ]
            )
        )

        if indice_topico >= 0:
            self.questao_topico.setCurrentIndex(
                indice_topico
            )

        self.carregar_capitulos()

        indice_capitulo = self.questao_capitulo.findData(
            dados.get("capitulo_id")
        )

        if indice_capitulo >= 0:
            self.questao_capitulo.setCurrentIndex(
                indice_capitulo
            )

        tipo_questao = _questao_tipo(dados)
        indice_tipo = self.questao_tipo.findData(tipo_questao)
        if indice_tipo >= 0:
            self.questao_tipo.setCurrentIndex(indice_tipo)
        self.atualizar_tipo_questao_editor()

        self.questao_enunciado.setPlainText(
            dados[
                "enunciado"
            ]
        )
        self._questao_explicacao_rica = explicacao_eh_rica(dados["explicacao"])
        if self._questao_explicacao_rica:
            self.questao_explicacao.setHtml(explicacao_html(dados["explicacao"]))
        else:
            self.questao_explicacao.setPlainText(dados["explicacao"])
        self.questao_banca.setText(
            dados[
                "banca"
            ]
        )
        self.questao_fonte.setText(
            dados[
                "fonte"
            ]
        )
        self.questao_ano.setValue(
            int(
                dados[
                    "ano"
                ]
                or 0
            )
        )

        indice_dificuldade = (
            self.questao_dificuldade.findText(
                dados[
                    "dificuldade"
                ]
            )
        )

        if indice_dificuldade >= 0:
            self.questao_dificuldade.setCurrentIndex(
                indice_dificuldade
            )

        for alternativa in dados[
            "alternativas"
        ]:
            letra = alternativa[
                "letra"
            ]

            if letra in self.alternativas_campos:
                self.alternativas_campos[
                    letra
                ].setText(
                    alternativa[
                        "texto"
                    ]
                )

            if alternativa[
                "correta"
            ]:
                if tipo_questao == "CERTO_ERRADO":
                    indice_gabarito = self.questao_gabarito_ce.findData(letra)
                    if indice_gabarito >= 0:
                        self.questao_gabarito_ce.setCurrentIndex(indice_gabarito)
                else:
                    indice_gabarito = (
                        self.questao_gabarito.findText(
                            letra
                        )
                    )
                    if indice_gabarito >= 0:
                        self.questao_gabarito.setCurrentIndex(
                            indice_gabarito
                        )

    def salvar_questao(self):
        topico_id = (
            self.questao_topico.currentData()
        )
        capitulo_id = (
            self.questao_capitulo.currentData()
        )

        if topico_id is None and capitulo_id is None:
            QMessageBox.warning(
                self,
                "Questão",
                "Informe um título ou um capítulo."
            )
            return

        enunciado = (
            self.questao_enunciado
            .toPlainText()
            .strip()
        )

        if not enunciado:
            QMessageBox.warning(
                self,
                "Questão",
                "Informe o enunciado da questão."
            )
            return

        tipo_questao = (
            self.questao_tipo.currentData()
            or "MULTIPLA_ESCOLHA"
        )
        alternativas = []

        if tipo_questao == "CERTO_ERRADO":
            gabarito = self.questao_gabarito_ce.currentData()
            alternativas = [
                {"letra": "C", "texto": "Certo", "correta": gabarito == "C"},
                {"letra": "E", "texto": "Errado", "correta": gabarito == "E"},
            ]
        else:
            gabarito = self.questao_gabarito.currentText()
            for letra in "ABCDE":
                texto = self.alternativas_campos[letra].text().strip()
                if not texto:
                    continue
                alternativas.append({
                    "letra": letra,
                    "texto": texto,
                    "correta": letra == gabarito,
                })

            if len(alternativas) < 2:
                QMessageBox.warning(
                    self,
                    "Questão",
                    "Informe pelo menos duas alternativas."
                )
                return

            if not any(item["letra"] == gabarito for item in alternativas):
                QMessageBox.warning(
                    self,
                    "Questão",
                    (
                        f"O gabarito {gabarito} não possui texto. "
                        "Preencha essa alternativa ou escolha outro gabarito."
                    )
                )
                return

        topico_id_duplicidade = topico_id
        if topico_id_duplicidade is None and capitulo_id is not None:
            for capitulo in listar_capitulos_perfil(
                self.questao_disciplina.currentText()
            ):
                if capitulo[0] == capitulo_id:
                    topico_id_duplicidade = capitulo[2]
                    break

        if (
            topico_id_duplicidade is not None
            and questao_existe(
                topico_id_duplicidade,
                enunciado,
                ignorar_id=self.questao_id,
                alternativas=alternativas,
                gabarito=gabarito
            )
        ):
            resposta = QMessageBox.question(
                self,
                "Possível duplicidade",
                (
                    "Já existe uma questão com este mesmo enunciado "
                    "no tópico selecionado.\n\n"
                    "Deseja salvar mesmo assim?"
                ),
                QMessageBox.Yes
                | QMessageBox.No,
                QMessageBox.No
            )

            if resposta != QMessageBox.Yes:
                return

        if (
            self.questao_id is not None
            and self.questao_tentativas_existentes > 0
        ):
            confirmar_edicao = QMessageBox.question(
                self,
                "Editar questão com histórico",
                (
                    f"Esta questão possui "
                    f"{self.questao_tentativas_existentes} tentativa(s).\n\n"
                    "A nova versão será usada somente nas próximas respostas. "
                    "As tentativas anteriores continuarão mostrando a versão "
                    "que estava vigente quando foram respondidas.\n\n"
                    "Deseja salvar a nova versão?"
                ),
                QMessageBox.Yes
                | QMessageBox.No,
                QMessageBox.Yes
            )

            if confirmar_edicao != QMessageBox.Yes:
                return

        try:
            if self.questao_id is None:
                criar_questao(
                    topico_id,
                    enunciado,
                    alternativas,
                    explicacao_serializada(
                        self.questao_explicacao,
                        formatada=self._questao_explicacao_rica,
                    ),
                    self.questao_banca
                    .text()
                    .strip(),
                    self.questao_ano.value(),
                    self.questao_fonte
                    .text()
                    .strip(),
                    self.questao_dificuldade
                    .currentText(),
                    True,
                    capitulo_id=capitulo_id,
                    tipo_questao=tipo_questao
                )
            else:
                atualizar_questao(
                    self.questao_id,
                    topico_id,
                    enunciado,
                    alternativas,
                    explicacao_serializada(
                        self.questao_explicacao,
                        formatada=self._questao_explicacao_rica,
                    ),
                    self.questao_banca
                    .text()
                    .strip(),
                    self.questao_ano.value(),
                    self.questao_fonte
                    .text()
                    .strip(),
                    self.questao_dificuldade
                    .currentText(),
                    self.questao_ativa_atual,
                    capitulo_id=capitulo_id,
                    tipo_questao=tipo_questao
                )

        except Exception as erro:
            QMessageBox.critical(
                self,
                "Questão",
                (
                    "Não foi possível salvar a questão.\n\n"
                    f"{erro}"
                )
            )
            return

        self.accept()


class JanelaVisualizarQuestao(QDialog):
    def __init__(
        self,
        questao_id=None,
        parent=None,
        tentativa_id=None
    ):
        super().__init__(
            parent
        )

        visualizacao_historica = (
            tentativa_id is not None
        )

        if visualizacao_historica:
            dados = obter_tentativa_questao_snapshot(
                tentativa_id
            )
        else:
            dados = obter_questao(
                questao_id
            )

        if dados is None:
            self.setWindowTitle(
                "Questão"
            )

            layout = QVBoxLayout(
                self
            )
            layout.addWidget(
                QLabel(
                    "Questão não encontrada."
                )
            )
            return

        identificador_questao = (
            dados.get(
                "id"
            )
            or dados.get(
                "questao_id"
            )
            or "—"
        )

        self.setWindowTitle(
            (
                f"Tentativa #{dados['tentativa_id']} • "
                f"Questão #{identificador_questao}"
                if visualizacao_historica
                else f"Questão #{identificador_questao}"
            )
        )
        self.resize(
            780,
            620
        )
        self.setMinimumSize(
            660,
            520
        )

        layout = QVBoxLayout(
            self
        )
        layout.setContentsMargins(
            18,
            16,
            18,
            16
        )
        layout.setSpacing(
            10
        )

        cabecalho = QHBoxLayout()

        titulo = QLabel(
            (
                f"Tentativa #{dados['tentativa_id']} • "
                f"Questão #{identificador_questao}"
                if visualizacao_historica
                else f"Questão #{identificador_questao}"
            )
        )
        titulo.setObjectName(
            "pageTitle"
        )

        metadata = []

        if dados[
            "banca"
        ]:
            metadata.append(
                dados[
                    "banca"
                ]
            )

        if dados[
            "ano"
        ]:
            metadata.append(
                str(
                    dados[
                        "ano"
                    ]
                )
            )

        metadata.append(
            dados[
                "dificuldade"
            ]
        )
        tipo_questao = _questao_tipo(dados)
        if tipo_questao == "CERTO_ERRADO":
            metadata.append("Certo / Errado")

        meta = QLabel(
            " • ".join(
                metadata
            )
        )
        meta.setObjectName(
            "questionViewerMeta"
        )

        cabecalho.addWidget(
            titulo
        )
        cabecalho.addStretch()
        cabecalho.addWidget(
            meta,
            0,
            Qt.AlignVCenter
        )

        layout.addLayout(
            cabecalho
        )

        if visualizacao_historica:
            if dados.get(
                "snapshot_preservado"
            ):
                texto_integridade = (
                    "Versão histórica preservada no momento da resposta. "
                    "Edições posteriores da questão não alteram esta tentativa."
                )
                estado_integridade = "preservado"
            elif dados.get(
                "snapshot_legado"
            ):
                texto_integridade = (
                    "Tentativa anterior à Integridade Histórica V1. "
                    "O snapshot foi criado na migração usando a versão da "
                    "questão existente naquele momento."
                )
                estado_integridade = "legado"
            else:
                texto_integridade = (
                    "Tentativa histórica sem snapshot original completo; "
                    "a melhor versão disponível está sendo exibida."
                )
                estado_integridade = "legado"

            aviso_snapshot = QLabel(
                texto_integridade
            )
            aviso_snapshot.setObjectName(
                "questionSnapshotNotice"
            )
            aviso_snapshot.setProperty(
                "snapshotState",
                estado_integridade
            )
            aviso_snapshot.setWordWrap(
                True
            )

            layout.addWidget(
                aviso_snapshot
            )

        elif not dados.get(
            "ativa",
            True
        ):
            aviso_arquivada = QLabel(
                (
                    "Questão desativada. Ela permanece disponível para "
                    "histórico e auditoria, mas não entra em novas sessões."
                )
            )
            aviso_arquivada.setObjectName(
                "questionArchivedNotice"
            )
            aviso_arquivada.setWordWrap(
                True
            )
            layout.addWidget(
                aviso_arquivada
            )

        caminho = QLabel(
            (
                f"{dados['disciplina']}  ›  "
                f"{dados['topico']}"
            )
        )
        caminho.setObjectName(
            "questionViewerPath"
        )

        layout.addWidget(
            caminho
        )

        scroll = QScrollArea()
        scroll.setObjectName(
            "questionViewerScroll"
        )
        scroll.setWidgetResizable(
            True
        )
        scroll.setFrameShape(
            QFrame.NoFrame
        )
        scroll.setHorizontalScrollBarPolicy(
            Qt.ScrollBarAlwaysOff
        )

        conteudo = QWidget()
        conteudo.setSizePolicy(
            QSizePolicy.Expanding,
            QSizePolicy.Preferred
        )
        conteudo_layout = QVBoxLayout(
            conteudo
        )
        conteudo_layout.setContentsMargins(
            0,
            0,
            8,
            0
        )
        conteudo_layout.setSpacing(
            9
        )

        enunciado_card = QFrame()
        enunciado_card.setObjectName(
            "questionViewerCard"
        )

        enunciado_layout = QVBoxLayout(
            enunciado_card
        )
        enunciado_layout.setContentsMargins(
            14,
            12,
            14,
            12
        )

        enunciado = QLabel(
            dados[
                "enunciado"
            ]
        )
        enunciado.setObjectName(
            "questionViewerStatement"
        )
        enunciado.setWordWrap(
            True
        )
        enunciado.setTextInteractionFlags(
            Qt.TextSelectableByMouse
        )

        enunciado_layout.addWidget(
            enunciado
        )
        conteudo_layout.addWidget(
            enunciado_card
        )

        for alternativa in dados[
            "alternativas"
        ]:
            card = QFrame()
            card.setObjectName(
                (
                    "questionCorrectAlternative"
                    if alternativa[
                        "correta"
                    ]
                    else "questionAlternative"
                )
            )

            linha = QHBoxLayout(
                card
            )
            linha.setContentsMargins(
                12,
                9,
                12,
                9
            )
            linha.setSpacing(
                8
            )

            letra = QLabel(
                _rotulo_resposta_questao(
                    alternativa["letra"],
                    tipo_questao,
                )
                if tipo_questao == "CERTO_ERRADO"
                else f"{alternativa['letra']})"
            )
            letra.setObjectName(
                "questionAlternativeLetter"
            )
            letra.setFixedWidth(
                28
            )

            linha.addWidget(
                letra,
                0,
                Qt.AlignTop
            )

            # Em múltipla escolha, a alternativa textual já nasce com o card
            # como parent. Evita um QLabel top-level transitório quando sua
            # visibilidade é configurada antes de entrar no layout (origem do
            # antigo "quadrado fantasma" em alguns diálogos do Windows).
            if tipo_questao != "CERTO_ERRADO":
                texto = QLabel(
                    alternativa[
                        "texto"
                    ],
                    card,
                )
                texto.setObjectName(
                    "questionAlternativeText"
                )
                texto.setWordWrap(
                    True
                )
                texto.setTextInteractionFlags(
                    Qt.TextSelectableByMouse
                )
                texto.setSizePolicy(
                    QSizePolicy.Expanding,
                    QSizePolicy.Preferred
                )
                texto.setAlignment(
                    Qt.AlignLeft | Qt.AlignTop
                )
                linha.addWidget(
                    texto,
                    1
                )
            else:
                linha.addStretch(
                    1
                )

            if alternativa[
                "correta"
            ]:
                correto = QLabel(
                    "Gabarito",
                    card,
                )
                correto.setObjectName(
                    "questionCorrectBadge"
                )
                correto.setSizePolicy(
                    QSizePolicy.Fixed,
                    QSizePolicy.Preferred
                )
                linha.addWidget(
                    correto,
                    0,
                    Qt.AlignTop
                )

            conteudo_layout.addWidget(
                card
            )

        if dados[
            "explicacao"
        ]:
            explicacao_card = QFrame()
            explicacao_card.setObjectName(
                "questionExplanationCard"
            )

            explicacao_layout = QVBoxLayout(
                explicacao_card
            )
            explicacao_layout.setContentsMargins(
                13,
                10,
                13,
                10
            )
            explicacao_layout.setSpacing(
                4
            )

            explicacao_titulo = QLabel(
                "Explicação"
            )
            explicacao_titulo.setObjectName(
                "questionEditorSectionTitle"
            )

            explicacao = QLabel()
            valor_explicacao = dados["explicacao"]
            if explicacao_eh_rica(valor_explicacao):
                explicacao.setTextFormat(Qt.RichText)
                explicacao.setText(explicacao_html(valor_explicacao))
            else:
                explicacao.setTextFormat(Qt.PlainText)
                explicacao.setText(str(valor_explicacao))
            explicacao.setWordWrap(
                True
            )
            explicacao.setTextInteractionFlags(
                Qt.TextSelectableByMouse
            )

            explicacao_layout.addWidget(
                explicacao_titulo
            )
            explicacao_layout.addWidget(
                explicacao
            )

            conteudo_layout.addWidget(
                explicacao_card
            )

        if dados[
            "fonte"
        ]:
            fonte = QLabel(
                f"Fonte: {dados['fonte']}"
            )
            fonte.setObjectName(
                "questionViewerSource"
            )
            fonte.setWordWrap(
                True
            )
            fonte.setTextInteractionFlags(
                Qt.TextSelectableByMouse
            )
            conteudo_layout.addWidget(
                fonte
            )

        conteudo_layout.addStretch()

        scroll.setWidget(
            conteudo
        )
        layout.addWidget(
            scroll,
            1
        )

        fechar = QDialogButtonBox(
            QDialogButtonBox.Close
        )
        fechar.button(
            QDialogButtonBox.Close
        ).setText(
            "Fechar"
        )
        fechar.rejected.connect(
            self.reject
        )
        fechar.clicked.connect(
            self.accept
        )

        layout.addWidget(
            fechar
        )


def integrar_sessao_questoes_com_revisoes(sessao_id):
    """Delega a integração acadêmica ao núcleo puro e testável."""
    return integrar_sessao_questoes_com_revisoes_core(sessao_id)



class JanelaGerenciarQuestoesTopico(QDialog):
    """Visão administrativa das questões agrupadas por disciplina e tópico."""

    def __init__(self, parent=None, topico_id_inicial=None):
        super().__init__(parent)
        self.concurso = obter_concurso_ativo()
        self.dados = []
        self.topico_id_atual = (
            int(topico_id_inicial)
            if topico_id_inicial is not None
            else None
        )
        self.disciplina_atual = ""
        self.topico_atual = ""
        self.aberto_em_topico = topico_id_inicial is not None

        self.setWindowTitle(
            "Questões do tópico"
            if self.aberto_em_topico
            else "Gerenciar e Editar questões"
