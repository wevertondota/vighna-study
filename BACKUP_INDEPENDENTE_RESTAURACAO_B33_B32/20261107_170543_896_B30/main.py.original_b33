# B26 R4: imagem de referência da progressão da Constelação Sináptica.
# Fica embutida no build para que o clique na constelação funcione mesmo em
# instalações incrementais do atualizador interno, sem arquivos extras.
_B26R4_PROGRESSAO_CONSTELACAO_PNG_B64 = """'+img_b64+'"""


def _b26r4_pixmap_progressao_constelacao():
    pixmap = QPixmap()
    try:
        dados = base64.b64decode(_B26R4_PROGRESSAO_CONSTELACAO_PNG_B64)
    except Exception:
        return pixmap
    pixmap.loadFromData(dados, "PNG")
    return pixmap

