        QFrame#questionSolverFeedback[resultState="correta"] { border-color: __correct_border__; }
        QFrame#questionSolverFeedback[resultState="errada"] { border-color: __incorrect_border__; }
        """

        # B04: as regras adicionais só entram no Futurista. Os estilos
        # Claro/Escuro permanecem idênticos aos do B03, byte por byte.
        if tema == "futurista":
            qss += r"""
        /* B04 / cabeçalho: os quatro controles continuam QPushButton reais. */
        QPushButton#subtleButton[sessionNavigation="true"],
        QPushButton#questionSessionFocusButton,
        QPushButton#questionSessionPauseButton {
            background-color: rgba(20, 40, 62, 242);
            color: #E4F2FA; border: 1px solid #41556F;
