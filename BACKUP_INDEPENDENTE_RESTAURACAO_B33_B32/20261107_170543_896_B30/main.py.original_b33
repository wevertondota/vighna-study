        def criar_indicador_evolucao(
            titulo_texto
        ):
            card = QFrame()
            card.setObjectName(
                "evolutionStat"
            )

            card_layout = QVBoxLayout(
                card
            )
            card_layout.setContentsMargins(
                12,
                8,
                12,
                8
            )
            card_layout.setSpacing(
                2
            )

            rotulo = QLabel(
                titulo_texto
            )
            rotulo.setObjectName(
                "miniStatLabel"
            )

            valor = QLabel(
                "—"
            )
            valor.setObjectName(
                "miniStatValue"
            )

            tendencia = QLabel(
                "—"
            )
            tendencia.setObjectName(
                "evolutionTrend"
            )

            card_layout.addWidget(
                rotulo
            )
            card_layout.addWidget(
                valor
            )
            card_layout.addWidget(
                tendencia
            )

            return (
                card,
                valor,
                tendencia
            )

        (
            card,
            self.evolucao_desempenho,
            self.evolucao_desempenho_tendencia
        ) = criar_indicador_evolucao(
            "Desempenho atual"
        )
        indicadores_evolucao.addWidget(
            card,
            0,
            0
        )

        (
            card,
            self.evolucao_questoes_dia,
            self.evolucao_questoes_tendencia
        ) = criar_indicador_evolucao(
            "Comparação equivalente"
        )
        indicadores_evolucao.addWidget(
            card,
            0,
            1
        )

        (
            card,
            self.evolucao_revisoes_dia,
            self.evolucao_revisoes_tendencia
        ) = criar_indicador_evolucao(
            "Tendência oficial"
        )
        indicadores_evolucao.addWidget(
            card,
            0,
            2
        )

        (
            card,
            self.evolucao_dias_estudados,
            self.evolucao_dias_tendencia
        ) = criar_indicador_evolucao(
            "Base estatística"
        )
        indicadores_evolucao.addWidget(
            card,
            0,
            3
        )

        lay_evolucao.addLayout(
            indicadores_evolucao
        )

        self.evolucao_estado_comparacao = QLabel(
            "Dados insuficientes para comparação"
        )
        self.evolucao_estado_comparacao.setObjectName("infoNotice")
        self.evolucao_estado_comparacao.setWordWrap(True)
        lay_evolucao.addWidget(self.evolucao_estado_comparacao)

        # Gráficos.
        def criar_card_grafico(
            titulo_texto,
            descricao_texto,
            grafico
        ):
            card = QFrame()
            card.setObjectName(
                "evolutionChartCard"
            )

            card_layout = QVBoxLayout(
                card
            )
            card_layout.setContentsMargins(
                14,
                10,
                14,
                10
            )
            card_layout.setSpacing(
                5
            )

            titulo_grafico = QLabel(
                titulo_texto
            )
            titulo_grafico.setObjectName(
                "evolutionSectionTitle"
            )

            descricao = QLabel(
                descricao_texto
            )
            descricao.setObjectName(
                "mutedLabel"
            )
            descricao.setWordWrap(
                True
            )

            card_layout.addWidget(
                titulo_grafico
            )
            card_layout.addWidget(
                descricao
            )
            card_layout.addWidget(
                grafico
            )

            return card

        self.grafico_evolucao_desempenho = (
            GraficoSerieTemporal(
                percentual=True,
                barras=False
            )
        )

        lay_evolucao.addWidget(
            criar_card_grafico(
                "Desempenho ao longo do tempo",
                (
                    "Percentual diário das sessões registradas. "
                    "Dias sem questões ficam sem ponto no gráfico."
                ),
                self.grafico_evolucao_desempenho
            )
        )

        self.grafico_evolucao_questoes = (
            GraficoSerieTemporal(
                percentual=False,
                barras=True
            )
        )

        lay_evolucao.addWidget(
            criar_card_grafico(
                "Questões por dia",
                "Volume diário de questões registradas no período.",
                self.grafico_evolucao_questoes
            )
        )

        self.grafico_evolucao_revisoes = (
            GraficoSerieTemporal(
                percentual=False,
                barras=True
            )
        )

        lay_evolucao.addWidget(
            criar_card_grafico(
                "Revisões por dia",
                "Revisões qualificadas do concurso; legado sem linhagem é excluído.",
                self.grafico_evolucao_revisoes
            )
        )

