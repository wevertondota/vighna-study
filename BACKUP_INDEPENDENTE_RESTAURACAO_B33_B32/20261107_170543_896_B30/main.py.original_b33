            self.tabela,
            1
        )

        aviso = QLabel(
            "Excluir uma disciplina é diferente de removê-la de um perfil: "
            "a exclusão global apaga permanentemente seus tópicos, revisões "
            "e histórico. Um backup será criado antes da exclusão."
        )
        aviso.setWordWrap(
            True
        )
        aviso.setObjectName(
            "mutedLabel"
        )
        layout.addWidget(
            aviso
        )

        botoes = QHBoxLayout()

        adicionar = QPushButton(
            "+ Adicionar disciplina"
        )
