        )
        divisor_rodape.setFixedHeight(1)
        ritmo_layout.addWidget(divisor_rodape)

        self.status_contexto_dashboard = QLabel(
            "Revisões: nenhuma pendência"
        )
        self.status_contexto_dashboard.setObjectName(
