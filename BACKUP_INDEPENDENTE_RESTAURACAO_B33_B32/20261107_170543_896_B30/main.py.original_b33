        )
        self.meta_questoes_status.setObjectName(
            "planningHint"
        )
        self.meta_questoes_status.setWordWrap(
            True
        )

        meta_contexto = QLabel(
            "Questões resolvidas hoje"
        )
        meta_contexto.setObjectName(
            "planningMicroLabel"
        )

        meta_box_layout.addWidget(
            meta_rotulo
        )
        meta_box_layout.addWidget(
            self.meta_questoes_progresso
        )
        meta_box_layout.addWidget(
            meta_contexto
        )
        meta_box_layout.addSpacing(
            2
        )
        meta_box_layout.addWidget(
            self.meta_questoes_barra
        )
        meta_box_layout.addWidget(
            self.meta_questoes_status
        )
        meta_box_layout.addStretch()

        corpo_planejamento.addWidget(
            meta_box
        )


        # ----------------------------------------------------
        # JORNADA DO DIA
        # ----------------------------------------------------

        if hasattr(self, "jornada_dia_botao"):
            try:
                jornada_atual = carregar_jornada(concurso_id, hoje)
            except Exception:
                jornada_atual = None
            if jornada_atual:
                resumo_jornada = jornada_atual.get("resumo") or {}
                pendentes_jornada = int(resumo_jornada.get("pendentes") or 0)
                status_jornada = str(jornada_atual.get("status") or "ativa").lower()
                if status_jornada == "encerrada":
                    texto_jornada = "Jornada encerrada"
                elif resumo_jornada.get("meta_atingida"):
                    texto_jornada = "Jornada • meta atingida"
                elif pendentes_jornada:
                    texto_jornada = f"Jornada do dia ({pendentes_jornada})"
                else:
                    texto_jornada = "Jornada do dia"
                self.jornada_dia_botao.setText(texto_jornada)
                self.jornada_dia_botao.setProperty("journeyState", status_jornada)
                self.jornada_dia_botao.setToolTip(
                    f"Foco hoje: {int(resumo_jornada.get('foco_hoje_minutos') or 0)} min • "
                    f"restante operacional: {int(resumo_jornada.get('restante_minutos') or 0)} min • "
                    f"{pendentes_jornada} atividade(s) na fila."
                )
            else:
                self.jornada_dia_botao.setText("Jornada do dia")
                self.jornada_dia_botao.setProperty("journeyState", "nova")
                self.jornada_dia_botao.setToolTip(
                    "Montar uma sequência adaptativa para o restante do dia."
                )
            self.jornada_dia_botao.style().unpolish(self.jornada_dia_botao)
            self.jornada_dia_botao.style().polish(self.jornada_dia_botao)

        # ----------------------------------------------------
        # PLANO DE AÇÃO AUTOMÁTICO
        # ----------------------------------------------------

        if hasattr(self, "plano_acao_automatico_botao"):
            plano_ativo = obter_plano_acao_automatico(concurso_id)
            if plano_ativo and plano_ativo.get("itens"):
                resumo_plano = plano_ativo.get("resumo") or {}
                quantidade_acoes = int(resumo_plano.get("acoes") or 0)
                self.plano_acao_automatico_botao.setText(
                    f"Plano automático ({quantidade_acoes})"
                )
                self.plano_acao_automatico_botao.setProperty("hasPlan", True)
                self.plano_acao_automatico_botao.setToolTip(
                    f"Plano ativo: {quantidade_acoes} ações • "
                    f"{int(resumo_plano.get('questoes') or 0)} questões previstas • "
                    f"{int(resumo_plano.get('revisoes') or 0)} revisões. Clique para revisar ou regenerar."
                )
            else:
                self.plano_acao_automatico_botao.setText("Plano automático")
                self.plano_acao_automatico_botao.setProperty("hasPlan", False)
                self.plano_acao_automatico_botao.setToolTip(
                    "Gerar um plano de ação inteligente para os próximos 7 dias."
                )
            self.plano_acao_automatico_botao.style().unpolish(
                self.plano_acao_automatico_botao
            )
            self.plano_acao_automatico_botao.style().polish(
                self.plano_acao_automatico_botao
            )

        # ----------------------------------------------------
        # CARGA DOS PRÓXIMOS 7 DIAS
        # ----------------------------------------------------

        carga_box = QFrame()
        carga_box.setObjectName(
            "weeklyLoadBox"
        )

        carga_box_layout = QVBoxLayout(
            carga_box
        )
        carga_box_layout.setContentsMargins(
            10,
            9,
            10,
            9
        )
        carga_box_layout.setSpacing(
            7
        )

        carga_header = QHBoxLayout()
        carga_header.setSpacing(
            8
        )

        carga_titulo = QLabel(
            "Próximos 7 dias"
        )
        carga_titulo.setObjectName(
            "planningItemTitle"
        )

        self.planejamento_total_7d = QLabel(
            "0 revisões em 7 dias"
        )
        self.planejamento_total_7d.setObjectName(
            "planningTotalBadge"
        )

        carga_header.addWidget(
            carga_titulo
        )
        carga_header.addStretch()
        carga_header.addWidget(
            self.planejamento_total_7d
        )

        carga_box_layout.addLayout(
            carga_header
        )

        carga_dias_widget = QWidget()
        carga_dias_widget.setObjectName(
            "weeklyLoadDays"
        )

        carga_layout = QHBoxLayout(
            carga_dias_widget
        )
        carga_layout.setContentsMargins(
            0,
            0,
            0,
            0
        )
        carga_layout.setSpacing(
            6
        )

        self.carga_semana_cards = []

        for indice in range(
            7
        ):
            dia_box = QFrame()
            dia_box.setObjectName(
                "weekDayLoad"
            )
            dia_box.setSizePolicy(
                QSizePolicy.Expanding,
                QSizePolicy.Preferred
            )

            dia_layout = QVBoxLayout(
                dia_box
            )
            dia_layout.setContentsMargins(
                6,
                6,
                6,
                6
            )
            dia_layout.setSpacing(
                1
            )

            dia_nome = QLabel(
                "—"
            )
            dia_nome.setObjectName(
                "weekDayName"
            )
            dia_nome.setAlignment(
                Qt.AlignCenter
            )

            dia_data = QLabel(
                "—"
            )
            dia_data.setObjectName(
                "weekDayDate"
            )
            dia_data.setAlignment(
                Qt.AlignCenter
            )

            dia_quantidade = QLabel(
                "0"
            )
            dia_quantidade.setObjectName(
                "weekDayCount"
            )
            dia_quantidade.setAlignment(
                Qt.AlignCenter
            )

            dia_layout.addWidget(
                dia_nome
            )
            dia_layout.addWidget(
                dia_data
            )
            dia_layout.addWidget(
                dia_quantidade
            )

            carga_layout.addWidget(
                dia_box,
                1
            )

            self.carga_semana_cards.append({
                "box": dia_box,
                "nome": dia_nome,
                "data": dia_data,
                "quantidade": dia_quantidade,
            })

        carga_box_layout.addWidget(
            carga_dias_widget
        )

        corpo_planejamento.addWidget(
            carga_box,
            1
        )

        dashboard_planejamento_conteudo_layout.addLayout(
            corpo_planejamento
        )

        # Ações relacionadas ao plano imediato.
        acoes_imediatas = QHBoxLayout()
        acoes_imediatas.setSpacing(
            7
        )
        acoes_imediatas.addStretch()

        self.jornada_dia_botao = QPushButton(
            "Jornada do dia"
        )
        self.jornada_dia_botao.setObjectName(
            "planningJourneyButton"
        )
        self.jornada_dia_botao.setMinimumSize(
            128,
            30
        )
        self.jornada_dia_botao.setToolTip(
            "Abrir uma fila adaptativa para o restante do dia, integrada ao Foco e ao Pós-Foco."
        )
        self.jornada_dia_botao.clicked.connect(
            self.abrir_jornada_do_dia
        )

        self.plano_acao_automatico_botao = QPushButton(
            "Plano automático"
        )
        self.plano_acao_automatico_botao.setObjectName(
            "planningAutoPlanButton"
        )
        self.plano_acao_automatico_botao.setMinimumSize(
            132,
            30
        )
        self.plano_acao_automatico_botao.setToolTip(
            "Gerar ou revisar um plano de ação inteligente para os próximos 7 dias."
        )
        self.plano_acao_automatico_botao.clicked.connect(
            self.abrir_plano_acao_automatico
        )

        resumo_dia = QPushButton(
            "Resumo do dia"
        )
        resumo_dia.setObjectName(
            "planningSummaryButton"
        )
        resumo_dia.setMinimumSize(
            110,
            30
        )
        resumo_dia.setToolTip(
            "Ver o fechamento de estudos de hoje."
        )
        resumo_dia.clicked.connect(
            self.abrir_resumo_dia
        )

        fechamento_semana = QPushButton(
            "Fechamento semanal"
        )
        fechamento_semana.setObjectName(
            "planningSummaryButton"
        )
        fechamento_semana.setMinimumSize(
            132,
            30
        )
        fechamento_semana.setToolTip(
            "Consolidar foco, questões, revisões e evolução da semana."
        )
        fechamento_semana.clicked.connect(
            self.abrir_fechamento_semanal
        )

        self.redistribuir_carga_botao = QPushButton(
            "Redistribuir carga"
        )
        self.redistribuir_carga_botao.setObjectName(
            "planningRedistributeButton"
        )
        self.redistribuir_carga_botao.setMinimumSize(
            128,
            30
        )
        self.redistribuir_carga_botao.setToolTip(
            "Analisar a carga futura e sugerir mudanças de data."
        )
        self.redistribuir_carga_botao.clicked.connect(
            self.abrir_redistribuicao_carga
        )

        acoes_imediatas.addWidget(
            self.jornada_dia_botao
        )
        acoes_imediatas.addWidget(
            self.plano_acao_automatico_botao
        )
        acoes_imediatas.addWidget(
            resumo_dia
        )
        acoes_imediatas.addWidget(
            fechamento_semana
        )
        acoes_imediatas.addWidget(
            self.redistribuir_carga_botao
        )

        dashboard_planejamento_conteudo_layout.addLayout(
            acoes_imediatas
        )

        # ====================================================
        # METAS DA SEMANA
        # ====================================================

        meta_semanal_box = QFrame()
        meta_semanal_box.setObjectName(
            "weeklyGoalBox"
        )

        meta_semanal_box_layout = QVBoxLayout(
            meta_semanal_box
        )
        meta_semanal_box_layout.setContentsMargins(
            12,
            10,
            12,
            10
        )
        meta_semanal_box_layout.setSpacing(
            7
        )

        meta_semanal_header = QHBoxLayout()
        meta_semanal_header.setSpacing(
            7
        )

        meta_semanal_titulo = QLabel(
            "Metas da semana"
        )
        meta_semanal_titulo.setObjectName(
            "weeklyGoalTitle"
        )

        self.meta_semanal_periodo = QLabel(
            "Segunda — Domingo"
        )
        self.meta_semanal_periodo.setObjectName(
            "weeklyGoalPeriod"
        )

        self.meta_semanal_situacao = QLabel(
            "Configure suas metas semanais"
        )
        self.meta_semanal_situacao.setObjectName(
            "weeklyGoalStatus"
        )

        meta_semanal_header.addWidget(
            meta_semanal_titulo
        )
        meta_semanal_header.addWidget(
            self.meta_semanal_periodo
        )
        meta_semanal_header.addStretch()
        meta_semanal_header.addWidget(
            self.meta_semanal_situacao
        )

        meta_semanal_box_layout.addLayout(
            meta_semanal_header
        )

        # ----------------------------------------------------
        # ESTADO VAZIO — quando nenhuma meta semanal está ativa
        # ----------------------------------------------------

        self.meta_semanal_vazio = QFrame()
        self.meta_semanal_vazio.setObjectName(
            "weeklyGoalEmptyState"
        )

        meta_vazio_layout = QHBoxLayout(
            self.meta_semanal_vazio
        )
        meta_vazio_layout.setContentsMargins(
            11,
            8,
            11,
            8
        )
        meta_vazio_layout.setSpacing(
            10
        )

        meta_vazio_titulo = QLabel(
            "Nenhuma meta semanal definida  •  Defina metas para questões, revisões e dias de estudo."
        )
        meta_vazio_titulo.setObjectName(
            "weeklyGoalEmptyTitle"
        )
        meta_vazio_titulo.setWordWrap(
            False
        )

        meta_vazio_layout.addWidget(
            meta_vazio_titulo,
            1
        )

        meta_semanal_box_layout.addWidget(
            self.meta_semanal_vazio
        )

        # ----------------------------------------------------
        # MÉTRICAS SEMANAIS — visíveis quando houver meta ativa
        # ----------------------------------------------------

        self.meta_semanal_metricas_container = QWidget()
        self.meta_semanal_metricas_container.setObjectName(
            "weeklyGoalMetricsContainer"
        )

        metas_grade = QGridLayout(
            self.meta_semanal_metricas_container
        )
        metas_grade.setContentsMargins(
            0,
            0,
            0,
            0
        )
        metas_grade.setHorizontalSpacing(
            8
        )
        metas_grade.setVerticalSpacing(
            0
        )

        self.metas_semanais_widgets = {}

        def criar_metrica_semanal(
            chave,
            titulo_texto
        ):
            card = QFrame()
            card.setObjectName(
                "weeklyGoalMetric"
            )

            card_layout = QVBoxLayout(
                card
            )
            card_layout.setContentsMargins(
                10,
                7,
                10,
                7
            )
            card_layout.setSpacing(
                3
            )

            titulo_label = QLabel(
                titulo_texto
            )
            titulo_label.setObjectName(
                "weeklyGoalMetricTitle"
            )

            valor_label = QLabel(
                "—"
            )
            valor_label.setObjectName(
                "weeklyGoalValue"
            )

            barra = QProgressBar()
            barra.setObjectName(
                "weeklyGoalProgress"
            )
            barra.setRange(
                0,
                100
            )
            barra.setValue(
                0
            )
            barra.setTextVisible(
                False
            )
            barra.setFixedHeight(
                6
            )

            dica = QLabel(
                "Meta desativada"
            )
            dica.setObjectName(
                "weeklyGoalHint"
            )

            card_layout.addWidget(
                titulo_label
            )
            card_layout.addWidget(
                valor_label
            )
            card_layout.addWidget(
                barra
            )
            card_layout.addWidget(
                dica
            )

            self.metas_semanais_widgets[
                chave
            ] = {
                "card": card,
                "valor": valor_label,
                "barra": barra,
                "dica": dica,
            }

            return card

        metas_grade.addWidget(
            criar_metrica_semanal(
                "questoes",
                "Questões"
            ),
            0,
            0
        )
        metas_grade.addWidget(
            criar_metrica_semanal(
                "revisoes",
                "Revisões"
            ),
            0,
            1
        )
        metas_grade.addWidget(
            criar_metrica_semanal(
                "dias",
                "Dias de estudo"
            ),
            0,
            2
        )

        for coluna in range(
            3
        ):
            metas_grade.setColumnStretch(
                coluna,
                1
            )

        meta_semanal_box_layout.addWidget(
            self.meta_semanal_metricas_container
        )

        dashboard_planejamento_conteudo_layout.addWidget(
            meta_semanal_box
        )

        planejamento_layout.addWidget(
            self.dashboard_planejamento_conteudo
        )

        layout.addWidget(
            planejamento
        )

        # ====================================================
        # ESTUDO POR QUESTÕES — modos de prática
        # ====================================================

        estudar_painel = QFrame()
        estudar_painel.setObjectName("studyNowPanel")
        self.dashboard_estudo_questoes_painel = estudar_painel

        estudar_layout = QVBoxLayout(estudar_painel)
        estudar_layout.setContentsMargins(16, 12, 16, 12)
        estudar_layout.setSpacing(8)

        # Cabeçalho: este setor é deliberadamente secundário ao Começar agora.
        estudar_header = QHBoxLayout()
        estudar_header.setSpacing(10)

        estudar_icone = QLabel("◇")
        estudar_icone.setObjectName("studyNowIcon")
        estudar_icone.setAlignment(Qt.AlignCenter)
        estudar_icone.setFixedSize(36, 36)

        estudar_titulos = QVBoxLayout()
        estudar_titulos.setSpacing(1)

        self.dashboard_toggle_estudar = QPushButton(
            "▸  Estudo por questões"
        )
        self.dashboard_toggle_estudar.setObjectName(
            "dashboardSectionToggle"
        )
        self.dashboard_toggle_estudar.setCursor(Qt.PointingHandCursor)
        self.dashboard_toggle_estudar.clicked.connect(
            lambda: self.alternar_secao_dashboard("estudar")
        )

        self.estudar_agora_subtitulo = QLabel(
            "Escolha como deseja praticar: revisar, treinar, simular ou recuperar pendências."
        )
        self.estudar_agora_subtitulo.setObjectName(
            "dashboardActionSectionSubtitle"
        )
        self.estudar_agora_subtitulo.setWordWrap(True)

        estudar_titulos.addWidget(self.dashboard_toggle_estudar)
        estudar_titulos.addWidget(self.estudar_agora_subtitulo)
        estudar_header.addWidget(estudar_icone, 0, Qt.AlignVCenter)
        estudar_header.addLayout(estudar_titulos, 1)
        estudar_layout.addLayout(estudar_header)

        # Mantido apenas como referência interna para compatibilidade com a
        # atualização do Dashboard. Não é exibido: Começar agora já é a ação
        # guiada principal do sistema.
        self.botao_estudar_agora = QPushButton()
        self.botao_estudar_agora.setVisible(False)

        self.dashboard_estudar_conteudo = QWidget()
        self.dashboard_estudar_conteudo.setObjectName(
            "dashboardCollapsibleContent"
        )
        dashboard_estudar_conteudo_layout = QVBoxLayout(
            self.dashboard_estudar_conteudo
        )
        dashboard_estudar_conteudo_layout.setContentsMargins(0, 0, 0, 0)
        dashboard_estudar_conteudo_layout.setSpacing(8)

        # Resumo do banco de questões.
        nucleo_metricas = QHBoxLayout()
        nucleo_metricas.setSpacing(12)

        self.dashboard_nucleo_questoes_total = QLabel("— questões")
        self.dashboard_nucleo_questoes_total.setObjectName(
            "questionsFoundationText"
        )
        self.dashboard_nucleo_questoes_desempenho = QLabel("Desempenho —")
        self.dashboard_nucleo_questoes_desempenho.setObjectName(
            "questionsFoundationText"
        )
        self.dashboard_nucleo_questoes_erros = QLabel("— erros")
        self.dashboard_nucleo_questoes_erros.setObjectName(
            "questionsFoundationText"
        )
        self.dashboard_nucleo_questoes_topicos = QLabel("— tópicos")
        self.dashboard_nucleo_questoes_topicos.setObjectName(
            "questionsFoundationText"
        )
        for metrica in (
            self.dashboard_nucleo_questoes_total,
            self.dashboard_nucleo_questoes_desempenho,
            self.dashboard_nucleo_questoes_erros,
            self.dashboard_nucleo_questoes_topicos,
        ):
            nucleo_metricas.addWidget(metrica)
        nucleo_metricas.addStretch(1)
        dashboard_estudar_conteudo_layout.addLayout(nucleo_metricas)

        # ----------------------------------------------------
        # Quatro modos principais — mesma hierarquia visual
        # ----------------------------------------------------
        modos_layout = QGridLayout()
        modos_layout.setSpacing(8)
        modos_layout.setColumnStretch(0, 1)
        modos_layout.setColumnStretch(1, 1)

        # Revisão Inteligente
        revisao_card = QFrame()
        revisao_card.setObjectName("studyActionCard")
        revisao_card.setProperty("actionRole", "review")
        revisao_card.setMinimumHeight(198)
        revisao_card.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        revisao_layout = QVBoxLayout(revisao_card)
        revisao_layout.setContentsMargins(13, 12, 13, 12)
        revisao_layout.setSpacing(6)

        revisao_topo = QHBoxLayout()
        revisao_topo.setSpacing(8)
        revisao_icone = QLabel("↻")
        revisao_icone.setObjectName("studyCardIcon")
        revisao_icone.setAlignment(Qt.AlignCenter)
        revisao_icone.setFixedSize(34, 34)
        revisao_titulos = QVBoxLayout()
        revisao_titulos.setSpacing(1)
        revisao_titulo = QLabel("Revisão Inteligente")
        revisao_titulo.setObjectName("studyActionTitle")
        self.revisao_inteligente_resumo = QLabel(
            "Carregando revisões prioritárias…"
        )
        self.revisao_inteligente_resumo.setObjectName("studyReviewCount")
        revisao_titulos.addWidget(revisao_titulo)
        revisao_titulos.addWidget(self.revisao_inteligente_resumo)
        revisao_topo.addWidget(revisao_icone)
        revisao_topo.addLayout(revisao_titulos, 1)

        revisao_intro = QLabel(
            "Revise primeiro o conteúdo mais urgente da sua fila."
        )
        revisao_intro.setObjectName("studyActionDescription")
        revisao_intro.setWordWrap(True)

        self.revisao_inteligente_detalhe = QLabel("")
        self.revisao_inteligente_detalhe.setObjectName("studyReviewDetail")
        self.revisao_inteligente_detalhe.setWordWrap(True)

        self.botao_revisao_inteligente = QPushButton("Revisar")
        self.botao_revisao_inteligente.setObjectName("subtleButton")
        self.botao_revisao_inteligente.setMinimumHeight(38)
        self.botao_revisao_inteligente.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self.botao_revisao_inteligente.setToolTip(
            "Usa o conteúdo prioritário da fila de revisões e abre uma bateria direcionada."
        )
        self.botao_revisao_inteligente.clicked.connect(
            self.abrir_revisao_inteligente_dashboard
        )

        revisao_layout.addLayout(revisao_topo)
        revisao_layout.addWidget(revisao_intro)
        revisao_layout.addWidget(self.revisao_inteligente_detalhe)
        revisao_layout.addStretch(1)
        revisao_layout.addWidget(self.botao_revisao_inteligente)

        # Treino Adaptativo
        adaptativo_card = QFrame()
