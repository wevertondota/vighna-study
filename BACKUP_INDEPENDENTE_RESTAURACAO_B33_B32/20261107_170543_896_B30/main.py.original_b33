        )

        def criar_metrica_projecao(
            titulo_texto,
            role
        ):
            frame = QFrame()
            frame.setObjectName(
                "dashboardProjectionMetric"
            )
            frame.setProperty(
                "metricRole",
                role
            )

            frame_layout = QHBoxLayout(
                frame
            )
            frame_layout.setContentsMargins(
                8,
                6,
                8,
                6
            )
            frame_layout.setSpacing(
                5
            )

            titulo_label = QLabel(
                titulo_texto
            )
            titulo_label.setObjectName(
                "dashboardProjectionMetricLabel"
            )

            valor = QLabel(
                "0"
            )
            valor.setObjectName(
                "dashboardProjectionMetricValue"
            )

            frame_layout.addWidget(
                titulo_label
            )
            frame_layout.addStretch()
            frame_layout.addWidget(
                valor
            )

            return (
                frame,
                valor
            )

        (
            nao_iniciado_metric,
            self.dashboard_progresso_nao_iniciado
        ) = criar_metrica_projecao(
            "Cobertura questões",
            "notStarted"
        )

        (
            consolidando_metric,
            self.dashboard_progresso_consolidando
        ) = criar_metrica_projecao(
            "Evidência suficiente",
            "consolidating"
        )

        (
            consolidado_metric,
            self.dashboard_progresso_consolidado
        ) = criar_metrica_projecao(
            "Consolidados",
            "consolidated"
        )

