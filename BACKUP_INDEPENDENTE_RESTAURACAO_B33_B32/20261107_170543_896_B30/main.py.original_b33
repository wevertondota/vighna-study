        )
        self.tabela_pdf.setHorizontalScrollBarPolicy(
            Qt.ScrollBarAlwaysOff
        )
        self.tabela_pdf.setTextElideMode(
            Qt.ElideRight
        )
        self.tabela_pdf.setRowCount(
            len(
                self.questoes
            )
        )
        self.tabela_pdf.itemChanged.connect(
            lambda _item:
                self.atualizar_contagem()
        )

        header = (
            self.tabela_pdf
            .horizontalHeader()
        )

        for coluna, largura in (
            (0, 72),
            (1, 52),
            (2, 52),
            (4, 50),
            (5, 90),
            (8, 115),
        ):
            header.setSectionResizeMode(
                coluna,
                QHeaderView.Fixed
            )
            self.tabela_pdf.setColumnWidth(
                coluna,
                largura
            )

        header.setSectionResizeMode(
            3,
            QHeaderView.Stretch
        )
        header.setSectionResizeMode(
            6,
            QHeaderView.Fixed
        )
        self.tabela_pdf.setColumnWidth(
            6,
            320 if self.importacao_ctb else 220
        )
        header.setSectionResizeMode(
            7,
            QHeaderView.Fixed
        )
        self.tabela_pdf.setColumnWidth(
            7,
            245
        )

        layout.addWidget(
            self.tabela_pdf,
            1
        )

        # Rodapé.
        self.botoes_importacao_pdf = QDialogButtonBox(
            QDialogButtonBox.Cancel
        )

        self.pdf_importar = self.botoes_importacao_pdf.addButton(
            "Importar questões selecionadas",
            QDialogButtonBox.AcceptRole
        )
        self.pdf_importar.setObjectName(
            "primaryButton"
        )
        self.pdf_importar.setDefault(
            True
        )
        self.botoes_importacao_pdf.accepted.connect(
