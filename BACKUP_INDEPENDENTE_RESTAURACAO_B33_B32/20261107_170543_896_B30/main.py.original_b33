            "específicos. Dê duplo clique em um tópico para alterar "
            "também sua importância de 1 a 5."
        )
        explicacao.setWordWrap(
            True
        )
        layout.addWidget(
            explicacao
        )

        self.busca_conteudos = QLineEdit()
        self.busca_conteudos.setPlaceholderText(
            "Pesquisar matéria, tópico ou capítulo..."
        )
        self.busca_conteudos.setClearButtonEnabled(
            True
        )
        self.busca_conteudos.textChanged.connect(
            self.filtrar_conteudos
        )
        layout.addWidget(
            self.busca_conteudos
        )

        self.arvore = QTreeWidget()
        self.arvore.setColumnCount(
            2
        )
        self.arvore.setHeaderLabels([
            "Matéria / tópico",
            "Importância"
        ])
        self.arvore.header().setSectionResizeMode(
            0,
            QHeaderView.Stretch
        )
        self.arvore.header().setSectionResizeMode(
            1,
            QHeaderView.ResizeToContents
        )
        self.arvore.itemChanged.connect(
            self.item_alterado
        )
        self.arvore.itemDoubleClicked.connect(
