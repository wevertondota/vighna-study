        )
        self.separador_menu_topico_1 = self.menu_mais_topico.addSeparator()
        self.acao_renomear_topico = self.menu_mais_topico.addAction(
            "Renomear tópico"
        )
        self.acao_renomear_topico.triggered.connect(
