            self.reject
        )

        layout.addWidget(
            self.botoes_importacao_pdf
        )

        self.pdf_topico_padrao.currentIndexChanged.connect(
            self.aplicar_topico_padrao
        )
        if not self.importacao_ctb:
            self.pdf_capitulo_padrao.currentIndexChanged.connect(
                self.aplicar_capitulo_padrao
            )

        self.preencher_tabela()

    def normalizar_rotulo_vpq(
        self,
        texto
    ):
        texto = str(
            texto
            or ""
        ).lower().strip()

        texto = unicodedata.normalize(
            "NFD",
            texto
        )

        texto = "".join(
            caractere
            for caractere in texto
            if unicodedata.category(
                caractere
            ) != "Mn"
        )

        # Cabeçalhos legais costumam alternar entre ":", "-" e "–"
        # (por exemplo, "Título II: ..." e "TÍTULO II - ..."). Esses
        # sinais não devem tornar a classificação diferente.
        texto = re.sub(
            r"[\W_]+",
            " ",
            texto,
            flags=re.UNICODE
        )

        return " ".join(
            texto.split()
        )

    def localizar_topico_vpq(
        self
    ):
        disciplina_texto = str(
            self.vpq_metadados.get("disciplina", "") or ""
        ).strip()

        if self.importacao_ctb:
            # No CTB o capítulo legal é o próprio tópico estrutural. O
            # metadado CAPÍTULO é, portanto, a classificação principal.
            # TÍTULO fica apenas como fallback para VPQs antigos.
            topico_texto = str(
                self.vpq_metadados.get("capitulo", "")
                or self.vpq_metadados.get("topico", "")
                or ""
            ).strip()
        else:
            topico_texto = str(
                self.vpq_metadados.get("topico", "") or ""
            ).strip()

        if self.normalizar_rotulo_vpq(topico_texto) in (
            "",
            "nao informado",
            "nao informada",
        ):
            return None

        topico_id = resolver_topico_id_estrutural(
            disciplina_texto or None,
            topico_texto,
        )
        if topico_id is None:
            return None

        # O importador só pode classificar em conteúdos disponíveis no perfil
        # atual. A identidade estrutural resolve aliases, mas não ignora a
        # configuração do concurso selecionado.
        correspondencia = next(
            (
                item
                for item in self.topicos_importacao
                if int(item["topico_id"]) == int(topico_id)
            ),
            None,
        )
        if correspondencia is None:
            return None

        self.vpq_topico_rotulo = correspondencia["rotulo"]
        return int(topico_id)

    def localizar_capitulo_vpq(self):
        if self.importacao_ctb:
            # No CTB não existe o segundo nível Título > Capítulo: os
            # capítulos legais já são tópicos estruturais.
            return None

        capitulo_texto = str(
            self.vpq_metadados.get("capitulo", "") or ""
        ).strip()
        if not capitulo_texto:
            return None

        topico_id = self.localizar_topico_vpq()
        if topico_id is None:
            # VPQ 1.1 permite capítulo sem título em alguns fluxos; nesse
            # caso só aceitamos a resolução se ela for inequivocamente única
            # entre os capítulos disponíveis no perfil.
            candidatos = []
            chave = self.normalizar_rotulo_vpq(capitulo_texto)
            for item in self.capitulos:
                if self.normalizar_rotulo_vpq(item["capitulo"]) == chave:
                    candidatos.append(item)
            if len(candidatos) != 1:
                return None
            return int(candidatos[0]["capitulo_id"])

        capitulo_id = resolver_capitulo_id_estrutural(
            int(topico_id),
            capitulo_texto,
        )
        if capitulo_id is None:
            return None

        if not any(
            int(item["capitulo_id"]) == int(capitulo_id)
            for item in self.capitulos
        ):
            return None
        return int(capitulo_id)

    def indice_topico_combo(
        self,
        combo,
        topico_id
    ):
        if topico_id is None:
            return 0

        for indice in range(
            combo.count()
        ):
            if combo.itemData(
                indice
            ) == topico_id:
                return indice

        return 0

    def criar_combo_topico(
        self,
        questao
    ):
        combo = QComboBox()
        combo.setObjectName(
            "pdfTopicCombo"
        )
        combo.addItem(
            (
                "Selecione o capítulo..."
                if self.importacao_ctb
                else "Selecione o título..."
            ),
            None
        )

        for topico in self.topicos_importacao:
            combo.addItem(
                topico[
                    "rotulo"
                ],
                topico[
                    "topico_id"
                ]
            )

        if self.topico_id_inicial_importacao is not None:
            indice = self.indice_topico_combo(
                combo,
                self.topico_id_inicial_importacao
            )

            if indice >= 0:
                combo.setCurrentIndex(
                    indice
                )
                if self.contexto_topico_importacao:
                    combo.setToolTip(
                        "Destino inicial definido pelo tópico aberto."
                    )
                else:
                    combo.setToolTip(
                        (
                            "Capítulo identificado pelo cabeçalho do arquivo: "
                            if self.importacao_ctb
                            else "Título identificado pelo cabeçalho do arquivo: "
                        )
                        + f"{self.vpq_topico_rotulo}."
                    )

        else:
            sugestao = sugerir_topico_pdf(
                questao,
                self.topicos_importacao
            )

            if sugestao is not None:
                indice = self.indice_topico_combo(
                    combo,
                    sugestao[
                        "topico_id"
                    ]
                )

                if indice >= 0:
                    combo.setCurrentIndex(
                        indice
                    )
                    combo.setToolTip(
                        (
                            f"Sugestão automática: "
                            f"{sugestao['rotulo']} "
                            f"({sugestao['score']:.0f}%)."
                        )
                    )

        return combo

    def criar_combo_gabarito(
        self,
        questao
    ):
        combo = QComboBox()
        combo.setObjectName(
            "pdfAnswerCombo"
        )
        combo.addItem(
            "—",
            None
        )

        tipo_questao = _questao_tipo(questao)
        for alternativa in questao[
            "alternativas"
        ]:
            letra = alternativa["letra"]
            combo.addItem(
                _rotulo_resposta_questao(letra, tipo_questao),
                letra
            )

        if questao.get(
            "gabarito"
        ):
            indice = combo.findData(
                questao[
                    "gabarito"
                ]
            )

            if indice >= 0:
                combo.setCurrentIndex(
                    indice
                )

        return combo

    def criar_combo_capitulo(self):
        combo = QComboBox()
        combo.setObjectName("pdfChapterCombo")
        combo.addItem("Selecione o capítulo...", None)

        for capitulo in self.capitulos:
            combo.addItem(
                capitulo["rotulo"],
                capitulo["capitulo_id"]
            )

        if self.vpq_capitulo_id is not None:
            indice = combo.findData(self.vpq_capitulo_id)
            if indice >= 0:
                combo.setCurrentIndex(indice)
                combo.setToolTip(
                    "Capítulo identificado no cabeçalho do arquivo."
                )

        return combo

    def preencher_tabela(self):
        for linha, questao in enumerate(
            self.questoes
        ):
            importar_item = QTableWidgetItem()
            importar_item.setFlags(
                Qt.ItemIsEnabled
                | Qt.ItemIsUserCheckable
                | Qt.ItemIsSelectable
            )
            importar_item.setCheckState(
                Qt.Checked
            )
            importar_item.setTextAlignment(
                Qt.AlignCenter
            )

            numero_item = QTableWidgetItem(
                str(
                    questao[
                        "numero_pdf"
                    ]
                )
            )
            numero_item.setTextAlignment(
                Qt.AlignCenter
            )

            pagina_item = QTableWidgetItem(
                (
                    str(
                        questao[
                            "pagina"
                        ]
                    )
                    if questao.get(
                        "pagina"
                    )
                    else "—"
                )
            )
            pagina_item.setTextAlignment(
                Qt.AlignCenter
            )

            resumo = " ".join(
                questao[
                    "enunciado"
                ].split()
            )

            if len(
                resumo
            ) > 180:
                resumo = (
                    resumo[
                        :177
                    ]
                    + "..."
                )

            questao_item = QTableWidgetItem(
                resumo
            )
            questao_item.setToolTip(
                (
                    questao[
                        "enunciado"
                    ]
                    + "\n\n"
                    + "\n".join(
                        (
                            (
                                _rotulo_resposta_questao(alt['letra'], _questao_tipo(questao))
                                if _questao_tipo(questao) == "CERTO_ERRADO"
                                else f"{alt['letra']}) {alt['texto']}"
                            )
                        )
                        for alt in questao[
                            "alternativas"
                        ]
                    )
                )
            )

            alt_item = QTableWidgetItem(
                str(
                    len(
                        questao[
                            "alternativas"
                        ]
                    )
                )
            )
            alt_item.setTextAlignment(
                Qt.AlignCenter
            )

            gabarito_combo = (
                self.criar_combo_gabarito(
                    questao
                )
            )
            topico_combo = (
                self.criar_combo_topico(
                    questao
                )
            )
            capitulo_combo = self.criar_combo_capitulo()

            status_item = QTableWidgetItem(
                ""
            )
            status_item.setTextAlignment(
                Qt.AlignCenter
            )

            self.tabela_pdf.setItem(
                linha,
                0,
                importar_item
            )
            self.tabela_pdf.setItem(
                linha,
                1,
                numero_item
            )
            self.tabela_pdf.setItem(
                linha,
                2,
                pagina_item
            )
            self.tabela_pdf.setItem(
                linha,
                3,
                questao_item
            )
            self.tabela_pdf.setItem(
                linha,
                4,
                alt_item
            )
            self.tabela_pdf.setCellWidget(
                linha,
                5,
                gabarito_combo
            )
            self.tabela_pdf.setCellWidget(
                linha,
                6,
                topico_combo
            )
            self.tabela_pdf.setCellWidget(
                linha,
                7,
                capitulo_combo
            )
            self.tabela_pdf.setItem(
                linha,
                8,
                status_item
            )

            gabarito_combo.currentIndexChanged.connect(
                lambda _=None, l=linha:
                    self.atualizar_status_linha(
                        l
                    )
            )
            topico_combo.currentIndexChanged.connect(
                lambda _=None, l=linha:
                    self.atualizar_status_linha(
                        l
                    )
            )
            capitulo_combo.currentIndexChanged.connect(
                lambda _=None, l=linha:
                    self.atualizar_status_linha(l)
            )

            self.tabela_pdf.setRowHeight(
                linha,
                34
            )

            self.atualizar_status_linha(
                linha
            )

        self.atualizar_contagem()

    def atualizar_status_linha(
        self,
        linha
    ):
        if (
            linha < 0
            or linha >= len(
                self.questoes
            )
        ):
            return

        questao = self.questoes[
            linha
        ]
        importar_item = self.tabela_pdf.item(
            linha,
            0
        )
        status_item = self.tabela_pdf.item(
            linha,
            8
        )
        gabarito_combo = (
            self.tabela_pdf.cellWidget(
                linha,
                5
            )
        )
        topico_combo = (
            self.tabela_pdf.cellWidget(
                linha,
                6
            )
        )
        capitulo_combo = self.tabela_pdf.cellWidget(linha, 7)

        gabarito = (
            gabarito_combo.currentData()
            if gabarito_combo
            else None
        )
        topico_id = (
            topico_combo.currentData()
            if topico_combo
            else None
        )
        capitulo_id = (
            None
            if self.importacao_ctb
            else (
                capitulo_combo.currentData()
                if capitulo_combo
                else None
            )
        )

        topico_capitulo_id = None
        if capitulo_id is not None:
            for capitulo in self.capitulos:
                if capitulo["capitulo_id"] == capitulo_id:
                    topico_capitulo_id = capitulo["topico_id"]
                    break

        nivel = None

        if not gabarito:
            status = "Sem gabarito"
            nivel = "atencao"

        elif self.importacao_ctb and topico_id is None:
            status = "Sem capítulo"
            nivel = "atencao"

        elif (
            not self.importacao_ctb
            and topico_id is None
            and capitulo_id is None
        ):
            status = "Sem título/capítulo"
            nivel = "atencao"

        elif (
            not self.importacao_ctb
            and topico_id is not None
            and topico_capitulo_id is not None
            and topico_id != topico_capitulo_id
        ):
            status = "Título/capítulo divergentes"
            nivel = "atencao"

        elif questao_existe(
            topico_id or topico_capitulo_id,
            questao[
                "enunciado"
            ],
            alternativas=questao.get(
                "alternativas",
                []
            ),
            gabarito=gabarito
        ):
            status = "Duplicada"
            nivel = "alerta"

        else:
            status = "Pronta"
            nivel = "sucesso"

        status_item.setText(
            status
        )

        aplicar_destaque_tabela(
            status_item,
            nivel,
            True
        )

        if status == "Duplicada":
            importar_item.setCheckState(
                Qt.Unchecked
            )

        self.atualizar_contagem()

    def aplicar_topico_padrao(self):
        topico_id = (
            self.pdf_topico_padrao.currentData()
        )

        for linha, questao in enumerate(
            self.questoes
        ):
            combo = self.tabela_pdf.cellWidget(
                linha,
                6
            )

            if combo is None:
                continue

            if topico_id is not None:
                indice = self.indice_topico_combo(
                    combo,
                    topico_id
                )
                combo.setCurrentIndex(
                    indice
                )
            else:
                if self.topico_id_inicial_importacao is not None:
                    indice = self.indice_topico_combo(
                        combo,
                        self.topico_id_inicial_importacao
                    )
                else:
                    sugestao = sugerir_topico_pdf(
                        questao,
                        self.topicos_importacao
                    )

                    indice = self.indice_topico_combo(
                        combo,
                        (
                            sugestao[
                                "topico_id"
                            ]
                            if sugestao
                            else None
                        )
                    )

                combo.setCurrentIndex(
                    indice
                )

            self.atualizar_status_linha(
                linha
            )


    def aplicar_capitulo_padrao(self):
        if self.importacao_ctb:
            return

        capitulo_id = self.pdf_capitulo_padrao.currentData()
        topico_pai_id = None
        if capitulo_id is not None:
            for capitulo in self.capitulos:
                if int(capitulo["capitulo_id"]) == int(capitulo_id):
                    topico_pai_id = int(capitulo["topico_id"])
                    break

        # Um capítulo escolhido como padrão determina seu título pai. Mantém
        # cabeçalho e linhas coerentes e evita status de divergência.
        if topico_pai_id is not None:
            self.pdf_topico_padrao.blockSignals(True)
            indice_topico = self.pdf_topico_padrao.findData(topico_pai_id)
            if indice_topico >= 0:
                self.pdf_topico_padrao.setCurrentIndex(indice_topico)
            self.pdf_topico_padrao.blockSignals(False)

        for linha in range(self.tabela_pdf.rowCount()):
            topico_combo = self.tabela_pdf.cellWidget(linha, 6)
            capitulo_combo = self.tabela_pdf.cellWidget(linha, 7)
            if capitulo_combo is None:
                continue

            if topico_pai_id is not None and topico_combo is not None:
                indice_topico = self.indice_topico_combo(
                    topico_combo, topico_pai_id
                )
                topico_combo.setCurrentIndex(indice_topico)

            indice_capitulo = capitulo_combo.findData(capitulo_id)
            capitulo_combo.setCurrentIndex(
                indice_capitulo if indice_capitulo >= 0 else 0
            )
            self.atualizar_status_linha(linha)

    def marcar_todas(
        self,
        marcar
    ):
        for linha in range(
            self.tabela_pdf.rowCount()
        ):
            item = self.tabela_pdf.item(
                linha,
                0
            )

            if item is not None:
                item.setCheckState(
                    (
                        Qt.Checked
                        if marcar
                        else Qt.Unchecked
                    )
                )

        self.atualizar_contagem()

    def atualizar_contagem(self):
        if not hasattr(
            self,
            "pdf_contagem"
        ):
            return

        selecionadas = 0
        prontas = 0
        atencao = 0
        duplicadas = 0

        for linha in range(
            self.tabela_pdf.rowCount()
        ):
            item = self.tabela_pdf.item(
                linha,
                0
            )
            status = self.tabela_pdf.item(
                linha,
                8
            )

            status_texto = (
                status.text().strip()
                if status is not None
                else ""
            )

            if status_texto == "Pronta":
                prontas += 1
            elif status_texto == "Duplicada":
                duplicadas += 1
            elif status_texto:
                atencao += 1

            if (
                item is not None
                and item.checkState()
                == Qt.Checked
            ):
                selecionadas += 1

        self.pdf_contagem.setText(
            (
                f"{selecionadas} selecionada(s) • "
                f"{prontas} pronta(s)"
            )
        )

        if hasattr(self, "pdf_resumo_validacao"):
            self.pdf_resumo_validacao.setText(
                f"Prontas: {prontas} • Atenção: {atencao} • Duplicadas: {duplicadas}"
            )

    def ver_texto_extraido(self):
        JanelaTextoExtraidoPDF(
            self.dados_pdf[
                "texto"
            ],
            self,
            origem_tipo=self.origem_tipo
        ).exec()

    def importar(self):
        if self.vpq_bloqueia_importacao:
            motivos = list(
                self.analise.get(
                    "vpq_erros",
                    []
                )
                or []
            )

            if motivos:
                detalhes = "\n".join(
                    f"• {motivo}"
                    for motivo in motivos[:12]
                )

                if len(motivos) > 12:
                    detalhes += (
                        f"\n• ... e mais {len(motivos) - 12} erro(s)."
                    )
            else:
                detalhes = (
                    "• O arquivo possui uma divergência estrutural não "
                    "identificada. Confira a auditoria exibida na tela."
                )

            QMessageBox.warning(
                self,
                "Não foi possível importar o VPQ",
                (
                    "As questões ainda não foram importadas porque o PDF "
                    "possui os seguintes problemas:\n\n"
                    f"{detalhes}\n\n"
                    "Corrija essas informações no PDF e importe o arquivo "
                    "novamente."
                )
            )
            return

        registros = []
        problemas = []
        duplicadas = 0

        for linha, questao in enumerate(
            self.questoes
        ):
            importar_item = self.tabela_pdf.item(
                linha,
                0
            )

            if (
                importar_item is None
                or importar_item.checkState()
                != Qt.Checked
            ):
                continue

            gabarito_combo = (
                self.tabela_pdf.cellWidget(
                    linha,
                    5
                )
            )
            topico_combo = (
                self.tabela_pdf.cellWidget(
                    linha,
                    6
                )
            )
            capitulo_combo = self.tabela_pdf.cellWidget(linha, 7)

            gabarito = (
                gabarito_combo.currentData()
                if gabarito_combo
                else None
            )
            topico_id = (
                topico_combo.currentData()
                if topico_combo
                else None
            )
            capitulo_id = (
                None
                if self.importacao_ctb
                else (
                    capitulo_combo.currentData()
                    if capitulo_combo
                    else None
                )
            )

            topico_capitulo_id = None
            if capitulo_id is not None:
                for capitulo in self.capitulos:
                    if capitulo["capitulo_id"] == capitulo_id:
                        topico_capitulo_id = capitulo["topico_id"]
                        break

            if not gabarito:
                problemas.append(
                    (
                        questao[
                            "numero_pdf"
                        ],
                        "sem gabarito"
                    )
                )
                continue

            if self.importacao_ctb and topico_id is None:
                problemas.append(
                    (
                        questao["numero_pdf"],
                        "sem capítulo"
                    )
                )
                continue

            if (
                not self.importacao_ctb
                and topico_id is None
                and capitulo_id is None
            ):
                problemas.append(
                    (
                        questao[
                            "numero_pdf"
                        ],
                        "sem título/capítulo"
                    )
                )
                continue

            if (
                not self.importacao_ctb
                and topico_id is not None
                and topico_capitulo_id is not None
                and topico_id != topico_capitulo_id
            ):
                problemas.append(
                    (
                        questao["numero_pdf"],
                        "título e capítulo divergentes"
                    )
                )
                continue

            topico_id_efetivo = topico_id or topico_capitulo_id

            alternativas = []

            for alternativa in questao[
                "alternativas"
            ]:
                alternativas.append({
                    "letra": alternativa[
                        "letra"
                    ],
                    "texto": alternativa[
                        "texto"
                    ],
                    "correta": (
                        alternativa[
                            "letra"
                        ]
                        == gabarito
                    ),
                })

            if questao_existe(
                topico_id_efetivo,
                questao[
                    "enunciado"
                ],
                alternativas=alternativas,
                gabarito=gabarito
            ):
                duplicadas += 1
                continue

            ano = (
                self.pdf_ano.value()
                or None
            )

            registros.append({
                "topico_id": topico_id,
                "capitulo_id": capitulo_id,
                "enunciado": questao[
                    "enunciado"
                ],
                "alternativas": alternativas,
                "explicacao": questao.get(
                    "explicacao",
                    ""
                ),
                "banca": self.pdf_banca
                .text()
                .strip(),
                "ano": ano,
                "fonte": self.pdf_fonte
                .text()
                .strip(),
                "dificuldade": (
                    self.pdf_dificuldade
                    .currentText()
                ),
                "tipo_questao": questao.get(
                    "tipo_questao",
                    "MULTIPLA_ESCOLHA"
                ),
            })

        if problemas:
            detalhes = "\n".join(
                (
                    f"Questão {numero}: {motivo}"
                )
                for numero, motivo
                in problemas[
                    :12
                ]
            )

            QMessageBox.warning(
                self,
                self.titulo_operacao,
                (
                    "Há questões selecionadas que ainda precisam "
                    "de conferência.\n\n"
                    f"{detalhes}\n\n"
                    + (
                        "Corrija o gabarito ou capítulo; ou desmarque essas questões."
                        if self.importacao_ctb
                        else "Corrija o gabarito, título ou capítulo; ou desmarque essas questões."
                    )
                )
            )
            return

        if not registros:
            QMessageBox.information(
                self,
                self.titulo_operacao,
                (
                    "Nenhuma questão pronta foi selecionada para importação."
                    + (
                        f"\n\nDuplicadas ignoradas: {duplicadas}"
                        if duplicadas
                        else ""
                    )
                )
            )
            return

        resposta = QMessageBox.question(
            self,
            "Confirmar importação",
            (
                f"Questões que serão importadas: {len(registros)}\n"
                f"Duplicadas ignoradas: {duplicadas}\n\n"
                "Deseja continuar?"
            ),
            QMessageBox.Yes
            | QMessageBox.No,
            QMessageBox.Yes
        )

        if resposta != QMessageBox.Yes:
            return

        try:
            motivo_backup = {
                "texto": "antes_importar_questoes_texto",
                "txt": "antes_importar_questoes_txt",
            }.get(self.origem_tipo, "antes_importar_questoes_pdf")
            fazer_backup(motivo_backup)
        except Exception as erro:
            QMessageBox.critical(
                self,
                self.titulo_operacao,
                (
                    "A importação foi cancelada porque o backup "
                    "de segurança não pôde ser criado.\n\n"
                    f"{erro}"
                )
            )
            return

        try:
            ids_importadas = criar_questoes_lote(
                registros
            )
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Importar PDF",
                (
                    "Não foi possível importar as questões.\n\n"
                    f"{erro}"
                )
            )
            return

        if len(ids_importadas) != len(registros):
            QMessageBox.critical(
                self,
                self.titulo_operacao,
                (
                    "A importação não confirmou todas as questões no banco. "
                    "Nenhuma atualização foi exibida na Central de Questões."
                )
            )
            return

        self.importadas = len(
            ids_importadas
        )

        QMessageBox.information(
            self,
            "Importação concluída",
            (
                f"Questões importadas: {self.importadas}\n"
                f"Duplicadas ignoradas: {duplicadas}"
            )
        )

        self.accept()


class JanelaEdicaoLoteQuestoes(QDialog):
    """Reclassifica ou edita metadados de várias questões de uma vez."""

    def __init__(self, quantidade, modo="editar", parent=None):
        super().__init__(parent)
        self.quantidade = max(1, int(quantidade or 1))
        self.modo = "mover" if str(modo).lower() == "mover" else "editar"
        self.campos = None

        self.setWindowTitle(
            "Mover questões" if self.modo == "mover" else "Editar questões em lote"
        )
        self.resize(620, 430 if self.modo == "editar" else 330)
        self.setMinimumWidth(560)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(18, 16, 18, 16)
        layout.setSpacing(11)

        titulo = QLabel(
            "Mover questões" if self.modo == "mover" else "Editar em lote"
        )
        titulo.setObjectName("pageTitle")
        subtitulo = QLabel(
            (
                f"Reclassifique {self.quantidade} questão(ões) sem alterar enunciado, alternativas ou histórico."
                if self.modo == "mover"
                else f"Altere somente os campos marcados nas {self.quantidade} questão(ões) selecionadas."
            )
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        layout.addWidget(titulo)
        layout.addWidget(subtitulo)

        classificacao = QFrame()
        classificacao.setObjectName("questionEditorCard")
        grade = QGridLayout(classificacao)
        grade.setContentsMargins(13, 11, 13, 11)
        grade.setHorizontalSpacing(9)
        grade.setVerticalSpacing(7)

        self.aplicar_classificacao = QCheckBox("Alterar classificação")
        self.aplicar_classificacao.setChecked(self.modo == "mover")
        self.aplicar_classificacao.setVisible(self.modo != "mover")
        grade.addWidget(self.aplicar_classificacao, 0, 0, 1, 3)

        self.lote_disciplina = QComboBox()
        self.lote_topico = QComboBox()
        self.lote_capitulo = QComboBox()
        for widget in (self.lote_disciplina, self.lote_topico, self.lote_capitulo):
            widget.setMinimumHeight(34)

        grade.addWidget(QLabel("Disciplina"), 1, 0)
        grade.addWidget(QLabel("Título / tópico"), 1, 1)
        grade.addWidget(QLabel("Capítulo"), 1, 2)
        grade.addWidget(self.lote_disciplina, 2, 0)
        grade.addWidget(self.lote_topico, 2, 1)
        grade.addWidget(self.lote_capitulo, 2, 2)
        for coluna in range(3):
            grade.setColumnStretch(coluna, 1)
        layout.addWidget(classificacao)

        self.metadados_card = QFrame()
        self.metadados_card.setObjectName("questionEditorCard")
        meta = QGridLayout(self.metadados_card)
        meta.setContentsMargins(13, 11, 13, 11)
        meta.setHorizontalSpacing(9)
        meta.setVerticalSpacing(7)

        self.aplicar_dificuldade = QCheckBox("Dificuldade")
        self.lote_dificuldade = QComboBox()
        self.lote_dificuldade.addItems(["Não informada", "Fácil", "Média", "Difícil"])

        self.aplicar_banca = QCheckBox("Banca")
        self.lote_banca = QLineEdit()
        self.lote_banca.setPlaceholderText("Vazio limpa a banca")

        self.aplicar_ano = QCheckBox("Ano")
        self.lote_ano = QSpinBox()
        self.lote_ano.setRange(0, 2100)
        self.lote_ano.setSpecialValueText("Não informado")

        self.aplicar_fonte = QCheckBox("Fonte")
        self.lote_fonte = QLineEdit()
        self.lote_fonte.setPlaceholderText("Vazio limpa a fonte")

        meta.addWidget(self.aplicar_dificuldade, 0, 0)
        meta.addWidget(self.lote_dificuldade, 1, 0)
        meta.addWidget(self.aplicar_banca, 0, 1)
        meta.addWidget(self.lote_banca, 1, 1)
        meta.addWidget(self.aplicar_ano, 2, 0)
        meta.addWidget(self.lote_ano, 3, 0)
        meta.addWidget(self.aplicar_fonte, 2, 1)
        meta.addWidget(self.lote_fonte, 3, 1)
        meta.setColumnStretch(0, 1)
        meta.setColumnStretch(1, 1)
        layout.addWidget(self.metadados_card)
        self.metadados_card.setVisible(self.modo == "editar")

        nota = QLabel(
            "O histórico das tentativas permanece preservado. Antes da alteração, o Vighna cria um backup de segurança."
        )
        nota.setObjectName("pdfImportHint")
        nota.setWordWrap(True)
        layout.addWidget(nota)
        layout.addStretch(1)

        botoes = QDialogButtonBox(QDialogButtonBox.Cancel | QDialogButtonBox.Ok)
        botoes.button(QDialogButtonBox.Cancel).setText("Cancelar")
        botoes.button(QDialogButtonBox.Ok).setText(
            "Mover questões" if self.modo == "mover" else "Aplicar alterações"
        )
        botoes.accepted.connect(self.validar_e_aceitar)
        botoes.rejected.connect(self.reject)
        layout.addWidget(botoes)

        self.aplicar_classificacao.toggled.connect(self.atualizar_estado_classificacao)
        self.lote_disciplina.currentTextChanged.connect(self.carregar_topicos)
        self.lote_topico.currentIndexChanged.connect(self.carregar_capitulos)
        self.carregar_disciplinas()
        self.atualizar_estado_classificacao()

    def atualizar_estado_classificacao(self, *args):
        habilitado = self.modo == "mover" or self.aplicar_classificacao.isChecked()
        for widget in (self.lote_disciplina, self.lote_topico, self.lote_capitulo):
            widget.setEnabled(habilitado)

    def carregar_disciplinas(self):
        concurso_id = obter_concurso_ativo()[0]
        self.lote_disciplina.blockSignals(True)
        self.lote_disciplina.clear()
        for _disciplina_id, nome, _pausada in listar_disciplinas_gerenciamento(concurso_id):
            self.lote_disciplina.addItem(nome)
        self.lote_disciplina.blockSignals(False)
        self.carregar_topicos()

    def carregar_topicos(self, *args):
        disciplina = self.lote_disciplina.currentText().strip()
        self.lote_topico.blockSignals(True)
        self.lote_topico.clear()
        if disciplina:
            for topico in listar_topicos_gerenciamento(disciplina):
                self.lote_topico.addItem(str(topico[1]), int(topico[0]))
        self.lote_topico.blockSignals(False)
        self.carregar_capitulos()

    def carregar_capitulos(self, *args):
        topico_id = self.lote_topico.currentData()
        self.lote_capitulo.blockSignals(True)
        self.lote_capitulo.clear()
        self.lote_capitulo.addItem("Sem capítulo", None)
        if topico_id is not None:
            for capitulo in listar_capitulos_topico(int(topico_id)):
                self.lote_capitulo.addItem(str(capitulo[1]), int(capitulo[0]))
        self.lote_capitulo.blockSignals(False)

    def validar_e_aceitar(self):
        campos = {}

        if self.modo == "mover" or self.aplicar_classificacao.isChecked():
            topico_id = self.lote_topico.currentData()
            if topico_id is None:
                QMessageBox.warning(
                    self,
                    "Classificação",
                    "Selecione um título/tópico de destino.",
                )
                return
            campos["topico_id"] = int(topico_id)
            campos["capitulo_id"] = self.lote_capitulo.currentData()

        if self.modo == "editar":
            if self.aplicar_dificuldade.isChecked():
                campos["dificuldade"] = self.lote_dificuldade.currentText()
            if self.aplicar_banca.isChecked():
                campos["banca"] = self.lote_banca.text().strip()
            if self.aplicar_ano.isChecked():
                campos["ano"] = self.lote_ano.value()
            if self.aplicar_fonte.isChecked():
                campos["fonte"] = self.lote_fonte.text().strip()

        if not campos:
            QMessageBox.information(
                self,
                "Editar em lote",
                "Marque pelo menos um campo para alterar.",
            )
            return

        self.campos = campos
        self.accept()


def _questao_tipo(dados):
    tipo = str((dados or {}).get("tipo_questao") or "").strip().upper()
    if tipo == "CERTO_ERRADO":
        return "CERTO_ERRADO"
    alternativas = (dados or {}).get("alternativas") or []
    letras = [str(item.get("letra") or "").strip().upper() for item in alternativas]
    if letras == ["C", "E"] and len(alternativas) == 2:
        textos = [str(item.get("texto") or "").strip().lower() for item in alternativas]
        if textos == ["certo", "errado"]:
            return "CERTO_ERRADO"
    return "MULTIPLA_ESCOLHA"


def _rotulo_resposta_questao(letra, tipo_questao):
    letra = str(letra or "").strip().upper()
    if tipo_questao == "CERTO_ERRADO":
        return {"C": "CERTO", "E": "ERRADO"}.get(letra, letra or "—")
    return letra or "—"


class JanelaQuestaoEditor(QDialog):

    def __init__(
        self,
        questao_id=None,
        parent=None
    ):
        super().__init__(
            parent
        )

        self.questao_id = (
            int(
                questao_id
            )
            if questao_id is not None
            else None
        )
        self.questao_ativa_atual = True
        self.questao_tentativas_existentes = 0

        self.setWindowTitle(
            (
                "Editar questão"
                if self.questao_id
                else "Nova questão"
            )
        )
        self.resize(
            820,
            720
        )
