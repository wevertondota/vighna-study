            lupa = criar_icone("fa5s.search", tema=tema, papel="acao")
            if not lupa.isNull():
                busca.setIcon(lupa)
                busca.setIconSize(QSize(18, 18))
                busca.setText("Buscar no Vighna...")
            else:
                busca.setIcon(QIcon())
                busca.setText("⌕  Buscar no Vighna...")

        qss = """
