        )
        gerenciar_backups.setObjectName(
            "subtleButton"
        )
        gerenciar_backups.clicked.connect(
            self.abrir_backups
        )

        botoes_backup.addWidget(
            fazer_backup_agora
        )
        botoes_backup.addWidget(
            gerenciar_backups
        )
        botoes_backup.addStretch()

        backup_layout.addLayout(
            botoes_backup
        )

        layout_backup.addWidget(
            opcao_backup
        )

        self.registrar_opcao_pesquisa(
            secao_backup,
            opcao_backup,
            "Backups e recuperação",
            (
                "backup backups fazer criar manual agora restaurar restauração restauracao "
                "recuperacao recuperação segurança seguranca copia cópia "
                "banco dados voltar anterior histórico historico"
            )
        )

        # ----------------------------------------------------
        # CHECKPOINT DO SISTEMA
        # ----------------------------------------------------

        opcao_checkpoint = QFrame()
        opcao_checkpoint.setObjectName(
            "settingsOption"
        )

        checkpoint_layout = QVBoxLayout(
            opcao_checkpoint
        )
        checkpoint_layout.setContentsMargins(
            14,
            11,
            14,
            12
        )
        checkpoint_layout.setSpacing(
            8
        )

        checkpoint_titulo = QLabel(
            "Checkpoint do sistema"
        )
        checkpoint_titulo.setObjectName(
            "configOptionTitle"
        )

        descricao_checkpoint = QLabel(
            "Preserva fontes, scripts, recursos e uma cópia consistente do banco ativo. "
            "Ambientes virtuais, builds, caches e backups ou checkpoints anteriores "
            "não são incluídos por serem reconstruíveis ou redundantes."
        )
        descricao_checkpoint.setWordWrap(
            True
        )
        descricao_checkpoint.setObjectName(
            "mutedLabel"
        )

        checkpoint_layout.addWidget(
            checkpoint_titulo
        )
        checkpoint_layout.addWidget(
            descricao_checkpoint
        )

        linha_descricao_checkpoint = QHBoxLayout()
        linha_descricao_checkpoint.setSpacing(
            10
        )

        rotulo_descricao_checkpoint = QLabel(
            "Descrição"
        )
        rotulo_descricao_checkpoint.setMinimumWidth(
            72
        )

        self.descricao_checkpoint = QLineEdit()
        self.descricao_checkpoint.setPlaceholderText(
            "Opcional — ex.: pós-integração Ritmo + Foco"
        )
        self.descricao_checkpoint.setClearButtonEnabled(
            True
        )
        self.descricao_checkpoint.setToolTip(
            "A descrição também é usada no nome do arquivo do checkpoint."
        )

        linha_descricao_checkpoint.addWidget(
            rotulo_descricao_checkpoint
        )
        linha_descricao_checkpoint.addWidget(
            self.descricao_checkpoint,
            1
        )

        checkpoint_layout.addLayout(
            linha_descricao_checkpoint
        )

        self.incluir_banco_checkpoint = QCheckBox(
            "Incluir uma cópia segura do estudos.db neste checkpoint"
        )
        self.incluir_banco_checkpoint.setChecked(
            True
        )
        self.incluir_banco_checkpoint.setToolTip(
            "Marcado por padrão. Para proteção completa, mantenha esta opção ativa: "
            "o Vighna cria um snapshot SQLite consistente e o inclui no mesmo ZIP dos fontes."
        )

        checkpoint_layout.addWidget(
            self.incluir_banco_checkpoint
        )

        # Duas linhas de ações: a seção funciona também ao restaurar a
        # janela, sem forçar uma largura mínima de quatro botões lado a lado.
        linha_checkpoint_acoes = QGridLayout()
        linha_checkpoint_acoes.setHorizontalSpacing(8)
        linha_checkpoint_acoes.setVerticalSpacing(8)

        gerar_checkpoint_agora = QPushButton(
            "Gerar checkpoint completo"
        )
        gerar_checkpoint_agora.setObjectName(
            "toolbarButton"
        )
        gerar_checkpoint_agora.clicked.connect(
            self.gerar_checkpoint_config
        )

        restaurar_checkpoint_botao = QPushButton(
            "Restaurar checkpoint"
        )
        restaurar_checkpoint_botao.setObjectName(
            "subtleButton"
        )
        restaurar_checkpoint_botao.setToolTip(
            "Validar um checkpoint, criar uma cópia de segurança do estado atual e restaurar os fontes selecionados."
        )
        restaurar_checkpoint_botao.clicked.connect(
            self.restaurar_checkpoint_config
        )

        verificar_checkpoint_botao = QPushButton(
            "Verificar proteção"
        )
        verificar_checkpoint_botao.setObjectName(
            "subtleButton"
        )
        verificar_checkpoint_botao.setToolTip(
            "Comparar o checkpoint mais recente com todos os fontes/recursos atuais e confirmar se há snapshot do banco."
        )
        verificar_checkpoint_botao.clicked.connect(
            self.verificar_protecao_checkpoint_config
        )

        abrir_pasta_checkpoint = QPushButton(
            "Abrir pasta de checkpoints"
        )
        abrir_pasta_checkpoint.setObjectName(
            "subtleButton"
        )
        abrir_pasta_checkpoint.clicked.connect(
            self.abrir_pasta_checkpoints_config
        )

        for botao_checkpoint in (
            gerar_checkpoint_agora,
            restaurar_checkpoint_botao,
            verificar_checkpoint_botao,
            abrir_pasta_checkpoint,
        ):
            botao_checkpoint.setSizePolicy(
                QSizePolicy.Maximum, QSizePolicy.Fixed
            )
        linha_checkpoint_acoes.addWidget(
            gerar_checkpoint_agora, 0, 0, Qt.AlignLeft
        )
        linha_checkpoint_acoes.addWidget(
            restaurar_checkpoint_botao, 0, 1, Qt.AlignLeft
        )
        linha_checkpoint_acoes.addWidget(
            verificar_checkpoint_botao, 1, 0, Qt.AlignLeft
        )
        linha_checkpoint_acoes.addWidget(
            abrir_pasta_checkpoint, 1, 1, Qt.AlignLeft
        )
        linha_checkpoint_acoes.setColumnStretch(2, 1)

        checkpoint_layout.addLayout(
            linha_checkpoint_acoes
        )

        self.status_ultimo_checkpoint = QLabel()
        self.status_ultimo_checkpoint.setObjectName(
            "mutedLabel"
        )
        self.status_ultimo_checkpoint.setWordWrap(
            True
        )

        checkpoint_layout.addWidget(
            self.status_ultimo_checkpoint
        )

        layout_backup.addWidget(
            opcao_checkpoint
        )

        self.registrar_opcao_pesquisa(
            secao_backup,
            opcao_checkpoint,
            "Checkpoint do sistema",
            (
                "checkpoint sistema codigo código fonte fontes zip estado editavel editável "
                "versao versão snapshot preservar desenvolvimento recuperar projeto main tema foco banco "
                "manifesto hash sha256 enviar chat compartilhar pasta restaurar restauração voltar versão anterior rollback"
            )
        )

        self.atualizar_status_checkpoint()

        # ====================================================
        # CENTRAL DE ATUALIZAÇÕES E SEGURANÇA (AUTORIZAÇÃO OBRIGATÓRIA)
        # ====================================================
        secao_atualizacao, layout_atualizacao = self.criar_secao_configuracao(
            "Atualizações e segurança",
            "Verifique e instale manualmente pacotes de atualização compatíveis.",
        )
        opcao_atualizacao = QFrame()
        opcao_atualizacao.setObjectName("settingsOption")
        conteudo_atualizacao = QVBoxLayout(opcao_atualizacao)
        conteudo_atualizacao.setContentsMargins(14, 11, 14, 12)
        conteudo_atualizacao.setSpacing(8)
        # Não incluir o identificador longo no título: isso força a largura
        # mínima do conteúdo do QScrollArea e estica os botões da seção.
        titulo_atualizacao = QLabel(f"Versão instalada • {VIGHNA_VERSION}")
        titulo_atualizacao.setObjectName("configOptionTitle")
        identificador_resumido = (
            VIGHNA_BUILD if len(VIGHNA_BUILD) <= 58
            else VIGHNA_BUILD[:38] + "…" + VIGHNA_BUILD[-16:]
        )
        rotulo_build = QLabel("Build: " + identificador_resumido)
        rotulo_build.setObjectName("mutedLabel")
        rotulo_build.setWordWrap(True)
        rotulo_build.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Preferred)
        rotulo_build.setTextInteractionFlags(Qt.TextSelectableByMouse)
        rotulo_build.setToolTip("Identificador completo: " + VIGHNA_BUILD)
        copiar_build = QPushButton("Copiar build")
        copiar_build.setObjectName("subtleButton")
        copiar_build.setToolTip("Copiar o identificador completo da versão")
        copiar_build.setSizePolicy(QSizePolicy.Maximum, QSizePolicy.Fixed)
        copiar_build.clicked.connect(
            lambda: QApplication.clipboard().setText(VIGHNA_BUILD)
        )
        linha_build = QHBoxLayout()
        linha_build.setSpacing(8)
        linha_build.addWidget(rotulo_build, 1)
        linha_build.addWidget(copiar_build, 0, Qt.AlignRight)
        texto_atualizacao = QLabel(
            "Nenhuma atualização é automática. Antes de instalar, o Vighna "
            "confere o pacote, faz backup consistente e bloqueia alterações "
            "não suportadas no banco de dados. A janela de instalação "
            "é independente e pode ser minimizada."
        )
        texto_atualizacao.setObjectName("mutedLabel")
        texto_atualizacao.setWordWrap(True)
        botao_importar_atualizacao = QPushButton("Selecionar pacote ZIP e verificar")
        botao_importar_atualizacao.setObjectName("toolbarButton")
        botao_importar_atualizacao.setSizePolicy(
            QSizePolicy.Maximum, QSizePolicy.Fixed
        )
        botao_importar_atualizacao.clicked.connect(self.iniciar_atualizacao_segura)
        conteudo_atualizacao.addWidget(titulo_atualizacao)
        conteudo_atualizacao.addLayout(linha_build)
        conteudo_atualizacao.addWidget(texto_atualizacao)
        conteudo_atualizacao.addWidget(
            botao_importar_atualizacao, 0, Qt.AlignLeft
        )
        self.status_verificacao_zip = QLabel(
            "ZIP: nenhum pacote selecionado nesta sessão.\n"
            "O Vighna avisará se o arquivo ou build já tiver sido instalado."
        )
        self.status_verificacao_zip.setObjectName("mutedLabel")
        self.status_verificacao_zip.setWordWrap(True)
        conteudo_atualizacao.addWidget(self.status_verificacao_zip)
        botao_historico = QPushButton("Consultar histórico de atualizações")
        botao_historico.setObjectName("subtleButton")
        botao_historico.setSizePolicy(
            QSizePolicy.Maximum, QSizePolicy.Fixed
        )
        botao_historico.clicked.connect(self.abrir_historico_atualizacoes)
        conteudo_atualizacao.addWidget(botao_historico, 0, Qt.AlignLeft)
        layout_atualizacao.addWidget(opcao_atualizacao)
        self.registrar_opcao_pesquisa(
            secao_atualizacao, opcao_atualizacao,
            "Atualizações e segurança",
            "atualizar pacote zip instalação instalar build versão segurança "
            "backup preservar histórico respostas progresso minimizar",
        )

        # V2/M05: diferencia preferências (dependem de Salvar) de ações
        # imediatas (diagnóstico, cópias, checkpoints e atualização).
        # Apenas rótulos e propriedades Qt, sem substituir métodos de negócio.
        self._etiquetar_operacao_config_v2_m05(
            opcao_fluxo, fluxo_layout, "PREFERÊNCIAS · SALVAR", "preference"
        )
        self._etiquetar_operacao_config_v2_m05(
            opcao_diagnostico, diagnostico_layout,
            "FERRAMENTA · EXECUÇÃO DIRETA", "action"
        )
        self._etiquetar_operacao_config_v2_m05(
            opcao_backup, backup_layout, "CÓPIA DE DADOS · AÇÃO DIRETA", "action"
        )
        self._etiquetar_operacao_config_v2_m05(
            opcao_checkpoint, checkpoint_layout,
            "RECUPERAÇÃO COMPLETA · AÇÃO DIRETA", "action"
        )
        self._etiquetar_operacao_config_v2_m05(
            opcao_atualizacao, conteudo_atualizacao,
            "MANUTENÇÃO · INSTALAÇÃO MANUAL", "maintenance"
        )

        # V2/M04 — Reorganização visual de quatro páginas de preferências.
        # O mesmo widget (inclusive sinais, valores e foco) passa a ser exibido
        # em uma grade adaptativa; não existe cópia nem formulário paralelo.
        self._grades_preferencias_v2_m04 = []
        self._colunas_preferencias_v2_m04 = None
        self._montar_grade_preferencias_v2_m04(
            layout_aparencia, (opcao_tema, opcao_animacao_home)
        )
        self._montar_grade_preferencias_v2_m04(
            layout_espacamento, (opcao_queda, opcao_matriz)
        )
        self._montar_grade_preferencias_v2_m04(
            layout_eficiencia, (opcao_fluxo, opcao_diagnostico)
        )
        # As páginas com preferência única usam um cartão de leitura compacto.
        opcao_importancia.setMaximumWidth(860)
        layout_fila.setAlignment(opcao_importancia, Qt.AlignTop | Qt.AlignHCenter)
        self._ajustar_grades_preferencias_v2_m04()

        # Seleciona a primeira das seis páginas, sem modificar valores.
        if self._navegacao_config_links:
            primeira_secao = self._navegacao_config_links[0][1]
            self._mostrar_pagina_config_v2(primeira_secao)
        layout.addLayout(area_principal_config, 1)

        # ====================================================
        # ESTADO SEM RESULTADOS
        # ====================================================

        self.aviso_sem_resultado = QLabel(
            "Nenhuma configuração encontrada."
        )
        self.aviso_sem_resultado.setAlignment(
            Qt.AlignCenter
        )
        self.aviso_sem_resultado.setObjectName(
            "settingsEmptyState"
        )
        self.aviso_sem_resultado.setWordWrap(
            True
        )
        self.aviso_sem_resultado.setVisible(
            False
        )

        layout.addWidget(
            self.aviso_sem_resultado
        )

        # ====================================================
        # RODAPÉ
        # ====================================================

        rodape = QFrame()
        rodape.setObjectName(
            "settingsFooter"
        )

        rodape_layout = QHBoxLayout(
            rodape
        )
        rodape_layout.setContentsMargins(
            12,
            9,
            12,
            9
        )
        rodape_layout.setSpacing(
            10
        )

        # M05: estado das preferências persistentes, separado das operações
        # que executam ações imediatamente (matriz, backups e atualizações).
        estado_rodape_layout = QVBoxLayout()
        estado_rodape_layout.setContentsMargins(0, 0, 0, 0)
        estado_rodape_layout.setSpacing(3)
        self._estado_edicao_config_m05 = QLabel("Nenhuma alteração pendente")
        self._estado_edicao_config_m05.setObjectName("settingsEditStateM05")
        self._estado_edicao_config_m05.setProperty("pendente", False)
        self._estado_edicao_config_m05.setWordWrap(True)
        estado_rodape_layout.addWidget(self._estado_edicao_config_m05)

        dica_rodape = QLabel(
            "Somente as preferências dependem de Salvar. "
            "Operações de manutenção são executadas separadamente."
        )
        dica_rodape.setObjectName("settingsFooterHintM05")
        dica_rodape.setWordWrap(True)
        # V2/M07: reaproveita o rótulo do M05 para mostrar o contexto real.
        self._dica_rodape_config_v2_m07 = dica_rodape
        estado_rodape_layout.addWidget(dica_rodape)

        botoes = QDialogButtonBox(
            QDialogButtonBox.Save |
            QDialogButtonBox.Cancel
        )

        botao_salvar = botoes.button(
            QDialogButtonBox.Save
        )
        botao_salvar.setText(
            "Salvar configurações"
        )
        botao_salvar.setObjectName(
            "primaryButton"
        )
        botao_salvar.setMinimumWidth(
            160
        )
        self._botao_salvar_config_m05 = botao_salvar
        self._botao_salvar_config_m05.setToolTip(
            "Salva tema, fila inteligente, automação e animação da Home."
        )

        botao_cancelar = botoes.button(
            QDialogButtonBox.Cancel
        )
        botao_cancelar.setText(
            "Cancelar"
        )
        botao_cancelar.setObjectName(
            "subtleButton"
        )

        botoes.accepted.connect(
            self.salvar
        )
        botoes.rejected.connect(
            self.reject
        )

        rodape_layout.addLayout(
            estado_rodape_layout,
            1
        )
        rodape_layout.addWidget(
            botoes
        )

        layout.addWidget(
            rodape
        )

        self.filtrar_configuracoes(
            ""
        )
        if self._navegacao_config_links:
            self._navegacao_config_links[0][0].setChecked(True)
        # Só capturar o estado inicial depois de carregar todas as preferências.
        self._configurar_estado_edicao_m05()
        self._ajustar_contadores_config_m06()

    def _valores_preferencias_config_m05(self):
        # Exclui filtros de pesquisa, texto do checkpoint e opções do executor
        # de backup. Esses campos não pertencem ao Salvar da janela.
        return (
            self.combo_tema.currentData(),
            self.pausar_animacao_home.isChecked(),
            self.usar_importancia.isChecked(),
            self.aplicar_penalizacao.isChecked(),
            self.mostrar_modo_um_clique.isChecked(),
            self.calibracao_automatica_foco.isChecked(),
            self.aprender_decisoes_estudar_agora.isChecked(),
        )

    def _configurar_estado_edicao_m05(self):
        # Não conecta sinais durante a criação dos formulários: isso evitaria
        # detectar inicialização dos controles como alterações do usuário.
        self._estado_inicial_config_m05 = self._valores_preferencias_config_m05()
        self._estado_pendente_config_m05 = False
        self.combo_tema.currentIndexChanged.connect(self._atualizar_estado_config_m05)
        for controle in (
            self.pausar_animacao_home,
            self.usar_importancia,
            self.aplicar_penalizacao,
            self.mostrar_modo_um_clique,
            self.calibracao_automatica_foco,
            self.aprender_decisoes_estudar_agora,
        ):
            controle.toggled.connect(self._atualizar_estado_config_m05)
        # Guarda os textos originais antes de anexar avisos contextuais.
        self._tooltips_navegacao_config_v2_m07 = {
            botao: botao.toolTip() for botao, _ in self._navegacao_config_links
        }
        self._atualizar_estado_config_m05()

    def _atualizar_resumo_edicao_v2_m07(self, valores_atuais):
        """Indica a origem das pendências sem alterar os valores dos widgets."""
        valores_iniciais = self._estado_inicial_config_m05
        diferencas = [
            indice for indice, (antes, depois) in enumerate(
                zip(valores_iniciais, valores_atuais)
            ) if antes != depois
        ]
        # Ordem das 7 preferências desta janela nas 6 categorias visíveis.
        # Meta diária fica exclusivamente em Planejamento; não entra nas pendências.
        # Backups e Sistema continuam sem preferências persistentes neste diálogo.
        categoria_por_preferencia = (0, 0, 1, 2, 3, 3, 3)
        contagens = [0] * len(self._navegacao_config_links)
        for indice in diferencas:
            contagens[categoria_por_preferencia[indice]] += 1
        numero_pendencias = len(diferencas)
        numero_categorias = sum(contagem > 0 for contagem in contagens)

        if numero_pendencias:
            texto = (
                f"{numero_pendencias} preferência{'s' if numero_pendencias != 1 else ''} "
                f"alterada{'s' if numero_pendencias != 1 else ''} em "
                f"{numero_categorias} categoria{'s' if numero_categorias != 1 else ''}"
            )
            dica = "As categorias marcadas na lateral têm alterações não salvas."
        else:
            texto = "Nenhuma alteração pendente"
            dica = (
                "Somente preferências dependem de Salvar. "
                "Operações de manutenção são executadas separadamente."
            )
        self._estado_edicao_config_m05.setText(texto)
        self._dica_rodape_config_v2_m07.setText(dica)

        for indice, (botao, _secao) in enumerate(self._navegacao_config_links):
            quantidade = contagens[indice]
            possui_pendencia = bool(quantidade)
            if botao.property("alteracoesPendentesV2M07") != possui_pendencia:
                botao.setProperty("alteracoesPendentesV2M07", possui_pendencia)
                estilo = botao.style()
                estilo.unpolish(botao)
                estilo.polish(botao)
                botao.update()
            dica_original = self._tooltips_navegacao_config_v2_m07[botao]
            if quantidade:
                dica_original += (
                    f"\n{quantidade} preferência"
                    f"{'s' if quantidade != 1 else ''} não salva"
                    f"{'s' if quantidade != 1 else ''} nesta categoria"
                )
            if botao.toolTip() != dica_original:
                botao.setToolTip(dica_original)

    def _atualizar_estado_config_m05(self, *_args):
        valores_atuais = self._valores_preferencias_config_m05()
        pendente = valores_atuais != self._estado_inicial_config_m05
        if getattr(self, "_estado_pendente_config_m05", None) != pendente:
            self._estado_pendente_config_m05 = pendente
            rotulo = self._estado_edicao_config_m05
            rotulo.setProperty("pendente", pendente)
            # QSS dinâmico: forçar a atualização somente do indicador.
            estilo = rotulo.style()
            estilo.unpolish(rotulo)
            estilo.polish(rotulo)
            rotulo.update()
        self._atualizar_resumo_edicao_v2_m07(valores_atuais)
        self._botao_salvar_config_m05.setEnabled(pendente)

    def reject(self):
        # Esc, X e Cancelar seguem o mesmo fluxo. Ações imediatas já
        # realizadas NÃO podem ser revertidas pelo cancelamento do formulário.
        if getattr(self, "_estado_pendente_config_m05", False):
            caixa = QMessageBox(self)
            caixa.setWindowTitle("Descartar alterações?")
            caixa.setIcon(QMessageBox.Warning)
            caixa.setText("Há preferências ainda não salvas.")
            caixa.setInformativeText(
                "Descartar essas alterações e fechar Configurações? "
                "Backups, checkpoints e outras ações já executadas não serão desfeitos."
            )
            caixa.setStandardButtons(QMessageBox.Discard | QMessageBox.Cancel)
            caixa.setDefaultButton(QMessageBox.Cancel)
            if caixa.exec() != QMessageBox.Discard:
                return
        super().reject()

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._atualizar_arte_cabecalho_config()
        # Em janelas menores a navegação conserva espaço para os formulários.
        if hasattr(self, "_painel_navegacao_config"):
            largura = 158 if self.width() < 1000 else 202
            if self._painel_navegacao_config.width() != largura:
                self._painel_navegacao_config.setFixedWidth(largura)
        self._ajustar_contadores_config_m06()
        self._ajustar_grades_preferencias_v2_m04()

    def _etiquetar_operacao_config_v2_m05(self, card, layout, titulo, tipo):
        """Only Qt decoration: no persistent inputs and no action callbacks."""
        assert tipo in ("preference", "action", "maintenance")
        card.setProperty("operationKindV2M05", tipo)
        etiqueta = QLabel(titulo, card)
        etiqueta.setObjectName("settingsOperationTagV2M05")
        etiqueta.setProperty("operationKindV2M05", tipo)
        etiqueta.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
        etiqueta.setSizePolicy(QSizePolicy.Maximum, QSizePolicy.Fixed)
        etiqueta.setFocusPolicy(Qt.NoFocus)
        layout.insertWidget(0, etiqueta)

    def _montar_grade_preferencias_v2_m04(self, secao_layout, opcoes):
        """Move existing options into a grid without rebuilding Qt controls."""
        container = QWidget()
        container.setObjectName("settingsPreferenceGridV2M04")
        grade = QGridLayout(container)
        grade.setContentsMargins(0, 0, 0, 0)
        grade.setHorizontalSpacing(12)
        grade.setVerticalSpacing(12)
        for opcao in opcoes:
            secao_layout.removeWidget(opcao)
            opcao.setProperty("preferenceCardV2M04", True)
            opcao.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
            grade.addWidget(opcao, 0, grade.count())
        secao_layout.addWidget(container)
        self._grades_preferencias_v2_m04.append((grade, tuple(opcoes)))

    def _ajustar_grades_preferencias_v2_m04(self):
        """Two columns on wide screens; one while filtering or when narrow."""
        grades = getattr(self, "_grades_preferencias_v2_m04", ())
        if not grades:
            return
        busca = getattr(self, "campo_busca_config", None)
        filtrando = bool(busca and busca.text().strip())
        colunas = 2 if self.width() >= 1180 and not filtrando else 1
        if self._colunas_preferencias_v2_m04 == colunas:
            return
        for grade, opcoes in grades:
            for opcao in opcoes:
                grade.removeWidget(opcao)
            for indice, opcao in enumerate(opcoes):
                grade.addWidget(opcao, indice // colunas, indice % colunas)
            grade.setColumnStretch(0, 1)
            grade.setColumnStretch(1, 1 if colunas == 2 else 0)
        self._colunas_preferencias_v2_m04 = colunas

    def _ajustar_contadores_config_m06(self):
        """Evita cabeçalhos apertados em janelas compactas; sem alterar dados."""
        contadores = getattr(self, "_contadores_secao_config_m04", None)
        if contadores:
            mostrar = self.width() >= 1000
            for contador in contadores.values():
                # isVisible() e False antes de o dialogo ser exibido; usar
                # setVisible incondicionalmente evita iniciar contadores ativos
                # em telas compactas por uma verificacao enganosa do parent.
                contador.setVisible(mostrar)

    def _atualizar_arte_cabecalho_config(self):
        arte_label = getattr(self, "_arte_header_config", None)
        if arte_label is None:
            return
        imagem = self._arte_header_config_original
        # Claro e Escuro continuam usando a superfície QSS nativa.
        tema_atual = normalizar_tema(
            obter_configuracao_texto("tema_interface", "futurista")
        )
        # A arte estática ganha espaço somente em telas largas; caso contrário,
        # toda a largura fica disponível ao título e à pesquisa.
        visivel = (
            tema_atual == "futurista" and self.width() >= 1030
            and not imagem.isNull()
        )
        if getattr(self, "_arte_header_config_visivel", None) != visivel:
            arte_label.setVisible(visivel)
            self._arte_header_config_visivel = visivel
        if not visivel:
            return
        largura = 340 if self.width() >= 1280 else 210
        altura = 72
        if getattr(self, "_arte_header_config_dimensoes", None) != (largura, altura):
            arte_label.setFixedSize(largura, altura)
            imagem_escalada = imagem.scaled(
                largura, altura, Qt.KeepAspectRatioByExpanding,
                Qt.SmoothTransformation
            )
            # O modo Expand pode gerar largura maior: faz um corte central
            # para manter exatamente o tamanho do QLabel.
            if (imagem_escalada.width() != largura or
                    imagem_escalada.height() != altura):
                imagem_escalada = imagem_escalada.copy(
                    max(0, (imagem_escalada.width() - largura) // 2),
                    max(0, (imagem_escalada.height() - altura) // 2),
                    largura, altura
                )
            # H03: degradê alfa suaviza o recorte esquerdo da arte espacial.
            # Nenhum timer ou repintura recorrente, apenas quando a dimensão muda.
            arte_suave = QPixmap(largura, altura)
            arte_suave.fill(Qt.transparent)
            pintor = QPainter(arte_suave)
            pintor.drawPixmap(0, 0, imagem_escalada)
            pintor.setCompositionMode(QPainter.CompositionMode_DestinationIn)
            transicao = QLinearGradient(0, 0, min(72, largura // 3), 0)
            transicao.setColorAt(0, QColor(255, 255, 255, 0))
            transicao.setColorAt(1, QColor(255, 255, 255, 255))
            pintor.fillRect(0, 0, min(72, largura // 3), altura,
                            QBrush(transicao))
            pintor.end()
            arte_label.setPixmap(arte_suave)
            self._arte_header_config_dimensoes = (largura, altura)

    def _mostrar_pagina_config_v2(self, secao, reiniciar_rolagem=True):
        """Exibe a página sem recriar widgets nem modificar configurações."""
        pagina = self._paginas_config_v2.get(secao)
        if pagina is None:
            return
        self._pilha_paginas_config_v2.setCurrentWidget(pagina)
        self._scroll_config = pagina
        self._atualizar_estado_navegacao_config_v2()
        if reiniciar_rolagem:
            pagina.verticalScrollBar().setValue(0)

    def _atualizar_estado_navegacao_config_v2(self):
        """Sincroniza destaque, posição e contagem com a página ativa."""
        pagina = self._pilha_paginas_config_v2.currentWidget()
        total = len(self._navegacao_config_links)
        for indice, (botao, secao) in enumerate(self._navegacao_config_links, 1):
            if self._paginas_config_v2.get(secao) is pagina:
                if not botao.isChecked():
                    botao.setChecked(True)
                self._indicador_navegacao_config_v2.setText(
                    f"PÁGINA {indice:02d} DE {total:02d}"
                )
                self._indicador_navegacao_config_v2.setToolTip(
                    f"Categoria ativa: {botao.text()}"
                )
                # Mantém o item selecionado visível quando a janela é compacta.
                self._scroll_navegacao_config_v2.ensureWidgetVisible(botao, 4, 4)
                return

    def _abrir_secao_config(self, secao):
        # Clique na lateral abre a página INTEIRA, mesmo após uma pesquisa.
        if self.campo_busca_config.text():
            self.campo_busca_config.clear()
        self._mostrar_pagina_config_v2(secao)

    def _sincronizar_navegacao_config(self, _valor=None):
        # V2/M02: página e destaque são sempre derivados de uma única fonte.
        self._atualizar_estado_navegacao_config_v2()

    def iniciar_atualizacao_segura(self):
        from vighna_update_ui import selecionar_e_autorizar
        selecionar_e_autorizar(self)

    def abrir_historico_atualizacoes(self):
        from caminhos import PASTA_DADOS
        historico = PASTA_DADOS / "backups" / "atualizacoes" / "historico.jsonl"
        janela = QDialog(self)
        janela.setWindowTitle("Histórico de atualizações — VighnaStudy")
        janela.resize(660, 410)
        layout = QVBoxLayout(janela)
        titulo = QLabel("Histórico de instalações e recuperações")
        titulo.setObjectName("pageTitle")
        layout.addWidget(titulo)
        registros = QTextEdit()
        registros.setReadOnly(True)
        if historico.is_file():
            linhas = historico.read_text(encoding="utf-8").splitlines()[-80:]
            resumo = []
            for linha in reversed(linhas):
                try:
                    item = json.loads(linha)
                    resumo.append(
                        f"{item.get('date', '—')}  •  {item.get('status', '—')}  •  "
                        f"{item.get('from', '—')} → {item.get('to', '—')}"
                    )
                    if item.get('package'):
                        resumo.append("  ZIP: " + str(item['package']))
                    if item.get('sha256'):
                        resumo.append("  SHA-256: " + str(item['sha256'])[:20] + "…")
                    if item.get("error"):
                        resumo.append("  Motivo: " + str(item["error"]))
                except (TypeError, ValueError):
                    continue
            registros.setPlainText("\n".join(resumo) or "Sem registros válidos.")
        else:
            registros.setPlainText("Nenhuma atualização foi executada por esta Central.")
        layout.addWidget(registros)
        botao = QPushButton("Fechar")
        botao.clicked.connect(janela.accept)
        layout.addWidget(botao)
        janela.exec()

    def criar_secao_configuracao(
        self,
        titulo,
        descricao=""
    ):
        # M04: cabeçalho de seção em widgets Qt reais. Nenhum controle original
        # é movido, substituído ou clonado; a seção permanece a mesma QFrame.
        secao = QFrame()
        secao.setObjectName("settingsSection")
        secao_layout = QVBoxLayout(secao)
        secao_layout.setContentsMargins(13, 11, 13, 13)
        secao_layout.setSpacing(9)

        cabecalho = QFrame()
        cabecalho.setObjectName("settingsSectionHeaderM04")
        linha_cabecalho = QHBoxLayout(cabecalho)
        linha_cabecalho.setContentsMargins(0, 0, 0, 0)
        linha_cabecalho.setSpacing(10)

        numero = QLabel(f"{len(self.secoes_pesquisa) + 1:02d}")
        numero.setObjectName("settingsSectionIndexM04")
        numero.setAlignment(Qt.AlignCenter)
        numero.setFixedSize(34, 32)
        linha_cabecalho.addWidget(numero, 0, Qt.AlignVCenter)

        textos = QVBoxLayout()
        textos.setContentsMargins(0, 0, 0, 0)
        textos.setSpacing(2)
        rotulo = QLabel(titulo)
        rotulo.setObjectName("settingsSectionTitle")
        rotulo.setWordWrap(True)
        textos.addWidget(rotulo)
        if descricao:
            subtitulo = QLabel(descricao)
            subtitulo.setObjectName("settingsSectionDescription")
            subtitulo.setWordWrap(True)
            textos.addWidget(subtitulo)
        linha_cabecalho.addLayout(textos, 1)

        contador = QLabel("0 OPÇÕES")
        contador.setObjectName("settingsSectionCountM04")
        contador.setAlignment(Qt.AlignCenter)
        contador.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Fixed)
        linha_cabecalho.addWidget(contador, 0, Qt.AlignVCenter)
        self._contadores_secao_config_m04[secao] = contador
        secao_layout.addWidget(cabecalho)

        separador = QFrame()
        separador.setObjectName("settingsSectionSeparatorM04")
        separador.setFixedHeight(1)
        secao_layout.addWidget(separador)
        # V2/M01: a seção e seus controles originais são filhos de uma
        # página individual. A área de rolagem não afeta outras categorias.
        pagina_scroll = QScrollArea()
        pagina_scroll.setObjectName("settingsPageScrollV2")
        pagina_scroll.setWidgetResizable(True)
        pagina_scroll.setFrameShape(QFrame.NoFrame)
        pagina_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        pagina_scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        pagina_conteudo = QWidget()
        pagina_conteudo.setObjectName("settingsPageContentV2")
        pagina_layout = QVBoxLayout(pagina_conteudo)
        pagina_layout.setContentsMargins(2, 2, 8, 4)
        pagina_layout.setSpacing(12)
        pagina_layout.addWidget(secao)
        pagina_layout.addStretch(1)
        pagina_scroll.setWidget(pagina_conteudo)
        self._pilha_paginas_config_v2.addWidget(pagina_scroll)
        self._paginas_config_v2[secao] = pagina_scroll

        self.secoes_pesquisa.append({
            "widget": secao,
            "titulo": titulo,
            "opcoes": []
        })

        # Navegação V2: corresponde às seis seções visíveis.
        titulos_curtos = {
            "Fila inteligente": "Fila inteligente",
            "Espaçamento das revisões": "Revisões",
            "Eficiência e automação": "Automação",
            "Backups e recuperação": "Backups",
            "Atualizações e segurança": "Sistema",
        }
        icones_nav = {
            "Aparência": "fa5s.palette",
            "Fila inteligente": "fa5s.brain",
            "Espaçamento das revisões": "fa5s.calendar-alt",
            "Eficiência e automação": "fa5s.bolt",
            "Backups e recuperação": "fa5s.database",
            "Atualizações e segurança": "fa5s.shield-alt",
        }
        nav = QPushButton(titulos_curtos.get(titulo, titulo))
        nav.setToolTip(f"Abrir categoria: {titulo}")
        nav.setAccessibleName(f"Abrir configurações: {titulo}")
        nav.setObjectName("settingsNavigationButtonM01")
        # Ícones QtAwesome nativos (com fallback sem ícone se QtAwesome faltar).
        tema_nav = normalizar_tema(
            obter_configuracao_texto("tema_interface", "futurista")
        )
        nav.setIcon(criar_icone(icones_nav[titulo], tema=tema_nav, papel="destaque"))
        nav.setIconSize(QSize(17, 17))
        nav.setCheckable(True)
        nav.setMinimumHeight(33)
        nav.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        nav.setFocusPolicy(Qt.StrongFocus)
        nav.clicked.connect(lambda _=False, alvo=secao: self._abrir_secao_config(alvo))
        self._grupo_navegacao_config.addButton(nav)
        self._lista_navegacao_config.insertWidget(
            self._lista_navegacao_config.count() - 1, nav
        )
        self._navegacao_config_links.append((nav, secao))

        return (
            secao,
            secao_layout
        )

    def registrar_opcao_pesquisa(
        self,
        secao,
        widget,
        titulo,
        palavras_chave
    ):
        registro = {
            "secao": secao,
            "widget": widget,
            "titulo": titulo,
            "palavras": (
                f"{titulo} {palavras_chave}"
            )
        }

        self.opcoes_pesquisa.append(
            registro
        )

        for registro_secao in self.secoes_pesquisa:
            if (
                registro_secao[
                    "widget"
                ]
                is secao
            ):
                registro_secao[
                    "opcoes"
                ].append(
                    registro
                )
                # Contagem informativa, derivada das opções já registradas.
                contador = self._contadores_secao_config_m04.get(secao)
                if contador is not None:
                    quantidade = len(registro_secao["opcoes"])
                    contador.setText(
                        f"{quantidade} OPÇÃO" if quantidade == 1
                        else f"{quantidade} OPÇÕES"
                    )
                break

    def normalizar_busca(
        self,
        texto
    ):
        texto = str(
            texto or ""
        ).lower().strip()

        texto = unicodedata.normalize(
            "NFD",
            texto
        )

        texto = "".join(
            caractere
            for caractere in texto
            if unicodedata.category(
                caractere
            )
            != "Mn"
        )

        return " ".join(
            texto.split()
        )

    def _destacar_resultado_config_v2(self, registro):
        """Muda somente aparência visual do resultado; nenhum valor é alterado."""
        anterior = getattr(self, "_resultado_ativo_config_v2", None)
        if anterior is registro:
            return
        for item, ativo in ((anterior, False), (registro, True)):
            if item is None:
                continue
            widget = item["widget"]
            widget.setProperty("configSearchActiveV2", ativo)
            estilo = widget.style()
            estilo.unpolish(widget)
            estilo.polish(widget)
            widget.update()
        self._resultado_ativo_config_v2 = registro

    def _posicionar_resultado_config_v2(self, registro):
        """Executado após o layout ser exibido, sem depender de geometria fixa."""
        if registro is not self._resultado_ativo_config_v2:
            return
        if not self.campo_busca_config.text().strip():
            return
        secao = registro["secao"]
        pagina = self._paginas_config_v2.get(secao)
        if pagina is not None and self._pilha_paginas_config_v2.currentWidget() is pagina:
            pagina.ensureWidgetVisible(registro["widget"], 12, 12)

    def _abrir_resultado_config_v2(self, registro):
        """Abre a categoria correspondente e posiciona o item sem editar dados."""
        if registro not in self._resultados_filtrados_config_v2:
            return
        self._mostrar_pagina_config_v2(registro["secao"], reiniciar_rolagem=False)
        self._destacar_resultado_config_v2(registro)
        QTimer.singleShot(0, lambda item=registro: self._posicionar_resultado_config_v2(item))

    def _selecionar_resultado_config_v2(self, indice):
        """A opção zero é um indicador, não um registro de configuração."""
        if indice <= 0 or indice > len(self._resultados_filtrados_config_v2):
            return
        self._abrir_resultado_config_v2(self._resultados_filtrados_config_v2[indice - 1])

    def _abrir_primeiro_resultado_config_v2(self):
        """Enter no campo de pesquisa abre o resultado selecionado ou primeiro."""
        encontrados = self._resultados_filtrados_config_v2
        if not encontrados or not self.campo_busca_config.text().strip():
            return
        indice = self._lista_resultados_config_v2.currentIndex()
        if 1 <= indice <= len(encontrados):
            registro = encontrados[indice - 1]
        else:
            registro = encontrados[0]
        self._abrir_resultado_config_v2(registro)

    def filtrar_configuracoes(self, texto):
        """Busca todas as seis páginas e permite selecionar cada resultado."""
        busca = self.normalizar_busca(texto)
        termos = [termo for termo in busca.split(" ") if termo]
        encontrados = []
        resultados = {}

        for registro in self.opcoes_pesquisa:
            alvo = self.normalizar_busca(registro["palavras"])
            corresponde = not termos or all(termo in alvo for termo in termos)
            resultados[id(registro)] = corresponde
            registro["widget"].setVisible(corresponde)
            if corresponde:
                encontrados.append(registro)

        for registro_secao in self.secoes_pesquisa:
            registro_secao["widget"].setVisible(any(
                resultados.get(id(opcao), False)
                for opcao in registro_secao["opcoes"]
            ))

        quantidade = len(encontrados)
        if termos:
            self.resultado_busca_config.setText(
                "1 opção encontrada" if quantidade == 1
                else f"{quantidade} opções encontradas"
            )
        else:
            self.resultado_busca_config.setText(
                f"{len(self.opcoes_pesquisa)} opções disponíveis"
            )

        self.aviso_sem_resultado.setVisible(quantidade == 0)
        self._pilha_paginas_config_v2.setVisible(quantidade > 0)
        self._resultados_filtrados_config_v2 = encontrados if termos else []
        self._lista_resultados_config_v2.blockSignals(True)
        try:
            self._lista_resultados_config_v2.clear()
            if termos and quantidade:
                self._lista_resultados_config_v2.addItem("Selecionar resultado…")
                for item in encontrados:
                    nome_secao = next(
                        (secao["titulo"] for secao in self.secoes_pesquisa
                         if secao["widget"] is item["secao"]), "Configurações"
                    )
                    self._lista_resultados_config_v2.addItem(
                        f"{nome_secao} · {item['titulo']}"
                    )
            self._lista_resultados_config_v2.setVisible(bool(termos and quantidade > 1))
        finally:
            self._lista_resultados_config_v2.blockSignals(False)

        if not termos:
            self._destacar_resultado_config_v2(None)
            self._sincronizar_navegacao_config()
        elif quantidade:
            # Prefere resultado da página atual, para não interromper o estudo.
            pagina_atual = self._pilha_paginas_config_v2.currentWidget()
            escolhido = next(
                (item for item in encontrados
                 if self._paginas_config_v2.get(item["secao"]) is pagina_atual),
                encontrados[0]
            )
            if quantidade > 1:
                self._lista_resultados_config_v2.blockSignals(True)
                try:
                    self._lista_resultados_config_v2.setCurrentIndex(
                        encontrados.index(escolhido) + 1
                    )
                finally:
                    self._lista_resultados_config_v2.blockSignals(False)
            self._abrir_resultado_config_v2(escolhido)
        else:
            self._destacar_resultado_config_v2(None)
            self.aviso_sem_resultado.setText(
                f"Nenhuma configuração encontrada para “{texto.strip()}”."
            )
        # Ao pesquisar, um resultado isolado deve ocupar a coluna inteira.
        self._ajustar_grades_preferencias_v2_m04()

    def atualizar_descricao_penalizacao(self):
        config = (
            carregar_configuracao_espacamento()
        )

        self.descricao_penalizacao.setText(
            (
                "Quando ativado, quedas a partir de "
                f"{config['limite_moderada']} p.p. reduzem o "
                f"intervalo em {config['penalizacao_moderada']}%, "
                "e quedas a partir de "
                f"{config['limite_forte']} p.p. reduzem em "
                f"{config['penalizacao_forte']}%. Quando "
                "desativado, a queda não encurta o intervalo."
            )
        )

    def abrir_matriz_espacamento(self):
        janela = JanelaMatrizEspacamento(
            self
        )

        janela.exec()

        self.atualizar_descricao_penalizacao()

    def fazer_backup_manual_config(self):
        pai = self.parent()

        if (
            pai is not None
            and hasattr(
                pai,
                "backup_manual"
            )
        ):
            pai.backup_manual()
            return

        try:
            destino = fazer_backup(
                "manual"
            )

            if destino is None:
                QMessageBox.warning(
                    self,
                    "Backup",
                    "O arquivo estudos.db ainda não existe."
                )
                return

            QMessageBox.information(
                self,
                "Backup concluído",
                (
                    "Backup criado com sucesso em:\n\n"
                    f"{destino}"
                )
            )
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Falha no backup",
                str(
                    erro
                )
            )

    def abrir_backups(self):
        janela = JanelaBackups(
            self
        )
        janela.exec()

    def abrir_diagnostico(self):
        from diagnostico import JanelaDiagnosticoVighna
        JanelaDiagnosticoVighna(self).exec()

    def atualizar_status_checkpoint(self):
        try:
            auditoria = auditar_protecao_checkpoint()
            if not auditoria.get("existe"):
                self.status_ultimo_checkpoint.setText(
                    "Proteção: nenhum checkpoint nativo gerado ainda."
                )
                self.status_ultimo_checkpoint.setToolTip("")
                return

            ultimo = obter_ultimo_checkpoint()
            data = ultimo["data_modificacao"].strftime("%d/%m/%Y às %H:%M")
            tamanho_mb = ultimo["tamanho_bytes"] / (1024 * 1024)

            if auditoria.get("completo"):
                prefixo = "Proteção completa"
            elif auditoria.get("banco_incluido"):
                prefixo = "Proteção desatualizada"
            else:
                prefixo = "Proteção parcial — banco fora do checkpoint"

            self.status_ultimo_checkpoint.setText(
                f"{prefixo}: {data} • {tamanho_mb:.1f} MB • "
                f"{auditoria.get('quantidade_protegida', 0)} arquivos do projeto"
            )

            detalhes = [
                str(auditoria.get("motivo") or ""),
                f"Checkpoint: {auditoria.get('nome', '')}",
                f"Banco incluído: {'sim' if auditoria.get('banco_incluido') else 'não'}",
                f"Arquivos faltantes: {len(auditoria.get('faltantes') or [])}",
                f"Arquivos alterados depois do checkpoint: {len(auditoria.get('alterados') or [])}",
            ]
            self.status_ultimo_checkpoint.setToolTip("\n".join(detalhes))

        except Exception as erro:
            self.status_ultimo_checkpoint.setText(
                "Proteção: não foi possível auditar o checkpoint atual."
            )
            self.status_ultimo_checkpoint.setToolTip(str(erro))

    def verificar_protecao_checkpoint_config(self):
        try:
            auditoria = auditar_protecao_checkpoint()
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Falha na verificação",
                str(erro),
            )
            return

        if not auditoria.get("existe"):
            QMessageBox.warning(
                self,
                "Proteção não configurada",
                "Ainda não existe checkpoint nativo. Gere um checkpoint completo agora.",
            )
            return

        faltantes = auditoria.get("faltantes") or []
        alterados = auditoria.get("alterados") or []
        linhas = [
            "Estado: " + ("PROTEÇÃO COMPLETA" if auditoria.get("completo") else "PROTEÇÃO INCOMPLETA/DESATUALIZADA"),
            f"Versão do checkpoint: {auditoria.get('versao_checkpoint') or '—'}",
            f"Versão atual: {auditoria.get('versao_atual') or '—'}",
            f"Fontes/recursos atuais: {auditoria.get('quantidade_atual', 0)}",
            f"Fontes/recursos protegidos: {auditoria.get('quantidade_protegida', 0)}",
            f"Banco incluído: {'sim' if auditoria.get('banco_incluido') else 'não'}",
            f"Arquivos faltantes: {len(faltantes)}",
            f"Arquivos alterados desde o checkpoint: {len(alterados)}",
        ]
        if faltantes:
            linhas.append("\nFaltantes:\n• " + "\n• ".join(faltantes[:12]))
        if alterados:
            linhas.append("\nAlterados:\n• " + "\n• ".join(alterados[:12]))
        linhas.append("\n" + str(auditoria.get("motivo") or ""))

        func = QMessageBox.information if auditoria.get("completo") else QMessageBox.warning
        func(
            self,
            "Verificação de proteção",
            "\n".join(linhas),
        )

    def gerar_checkpoint_config(self):
        descricao = self.descricao_checkpoint.text().strip()
        incluir_banco = self.incluir_banco_checkpoint.isChecked()

        QApplication.setOverrideCursor(
            Qt.WaitCursor
        )

        try:
            resultado = (
                gerar_checkpoint_completo(descricao=descricao)
                if incluir_banco
                else gerar_checkpoint(
                    descricao=descricao,
                    incluir_banco=False,
                )
            )
            auditoria = auditar_protecao_checkpoint(resultado.get("caminho"))
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Falha ao gerar checkpoint",
                str(
                    erro
                )
            )
            return
        finally:
            QApplication.restoreOverrideCursor()

        self.atualizar_status_checkpoint()

        tamanho_mb = (
            resultado[
                "tamanho_bytes"
            ] / (1024 * 1024)
        )

        banco_texto = (
            "incluído"
            if resultado[
                "banco_incluido"
            ]
            else "não incluído"
        )
        protecao_texto = (
            "COMPLETA" if auditoria.get("completo")
            else "PARCIAL — gere novamente com o banco incluído"
        )

        QMessageBox.information(
            self,
            "Checkpoint concluído",
            (
                "Checkpoint criado com sucesso.\n\n"
                f"Arquivo: {resultado['nome']}\n"
                f"Arquivos preservados: {resultado['quantidade_arquivos']}\n"
                f"Banco de dados: {banco_texto}\n"
                f"Proteção verificada: {protecao_texto}\n"
                f"Tamanho: {tamanho_mb:.1f} MB\n\n"
                f"Pasta: {resultado['caminho'].parent}"
            )
        )

    def restaurar_checkpoint_config(self):
        try:
            checkpoints = listar_checkpoints()
            pasta_inicial = str(checkpoints[0]["caminho"].parent) if checkpoints else str(Path.cwd())
        except Exception:
            pasta_inicial = str(Path.cwd())

        caminho, _ = QFileDialog.getOpenFileName(
            self,
            "Selecionar checkpoint do VighnaStudy",
            pasta_inicial,
            "Checkpoint VighnaStudy (*.zip);;Arquivos ZIP (*.zip)"
        )
        if not caminho:
            return

        try:
            diagnostico = inspecionar_checkpoint(caminho)
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Checkpoint inválido",
                f"O checkpoint não passou pela verificação de integridade.\n\n{erro}",
            )
            return

        manifesto = diagnostico.get("manifesto") or {}
        criado = str(diagnostico.get("criado_em") or "").replace("T", " ")[:19] or "não informado"
        descricao = str(diagnostico.get("descricao") or "").strip() or "Sem descrição"

        caixa = QMessageBox(self)
        caixa.setIcon(QMessageBox.Warning)
        caixa.setWindowTitle("Restaurar checkpoint")
        caixa.setText("Restaurar esta versão do VighnaStudy?")
        caixa.setInformativeText(
            f"Arquivo: {diagnostico['nome']}\n"
            f"Criado em: {criado}\n"
            f"Descrição: {descricao}\n"
            f"Arquivos validados: {diagnostico['quantidade_arquivos']}\n\n"
            "Antes de restaurar, o Vighna criará automaticamente um checkpoint de segurança completo do estado atual, incluindo o banco quando ele existir. "
            "Após a operação, reinicie o programa para carregar os fontes restaurados."
        )
        caixa.setStandardButtons(QMessageBox.Yes | QMessageBox.Cancel)
        caixa.setDefaultButton(QMessageBox.Cancel)

        incluir_banco = QCheckBox(
            "Banco de dados: restauração segura somente com o Vighna fechado"
        )
        incluir_banco.setChecked(False)
        incluir_banco.setEnabled(False)
        if diagnostico.get("banco_incluido"):
            incluir_banco.setToolTip(
                "Feche o VighnaStudy e execute recuperar_banco.bat para restaurar "
                "um banco de checkpoint com tratamento seguro de WAL/SHM."
            )
        else:
            incluir_banco.setText("Este checkpoint não contém estudos.db")
        caixa.setCheckBox(incluir_banco)

        if caixa.exec() != QMessageBox.Yes:
            return

        QApplication.setOverrideCursor(Qt.WaitCursor)
        try:
            resultado = restaurar_checkpoint(
                caminho,
                restaurar_banco=bool(incluir_banco.isChecked()),
            )
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Falha ao restaurar checkpoint",
                str(erro),
            )
            return
        finally:
            QApplication.restoreOverrideCursor()

        seguranca = resultado.get("checkpoint_seguranca") or {}
        seguranca_nome = seguranca.get("nome", "checkpoint de segurança")
        orientacao = (
            "Os fontes foram restaurados. Como esta execução é o Vighna compilado, execute atualizar_exe.bat antes de abrir novamente pelo EXE."
            if getattr(sys, "frozen", False)
            else "Feche e abra o VighnaStudy novamente para carregar a versão restaurada."
        )
        QMessageBox.information(
            self,
            "Checkpoint restaurado",
            (
                f"Arquivos restaurados: {len(resultado.get('arquivos_restaurados') or [])}\n"
                f"Banco restaurado: {'sim' if resultado.get('banco_restaurado') else 'não'}\n"
                f"Segurança criada: {seguranca_nome}\n\n"
                + orientacao
            ),
        )
        self.atualizar_status_checkpoint()

    def abrir_pasta_checkpoints_config(self):
        try:
            abrir_pasta_checkpoints()
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Não foi possível abrir a pasta",
                str(
                    erro
                )
            )

    def salvar(self):
        # A preferência somente é persistida quando o usuário clica em Salvar.
        if not self._pausa_animacao_home_bloqueada:
            self._preferencias_animacao_home.setValue(
                "acessibilidade/reduzir_movimento",
                self.pausar_animacao_home.isChecked(),
            )
            self._preferencias_animacao_home.sync()

        tema_escolhido = normalizar_tema(
            self.combo_tema.currentData()
        )

        definir_configuracao_texto(
            "tema_interface",
            tema_escolhido
        )

        aplicar_tema(
            QApplication.instance(),
            tema_escolhido
        )

        definir_configuracao_bool(
            "usar_importancia_fila",
            self.usar_importancia.isChecked()
        )

        definir_configuracao_bool(
            "aplicar_penalizacao_queda",
            self.aplicar_penalizacao.isChecked()
        )

        definir_configuracao_bool(
            "mostrar_modo_um_clique",
            self.mostrar_modo_um_clique.isChecked()
        )
        definir_configuracao_bool(
            "calibracao_automatica_foco",
            self.calibracao_automatica_foco.isChecked()
        )
        definir_configuracao_bool(
            "aprender_decisoes_estudar_agora",
            self.aprender_decisoes_estudar_agora.isChecked()
        )

        self.accept()


