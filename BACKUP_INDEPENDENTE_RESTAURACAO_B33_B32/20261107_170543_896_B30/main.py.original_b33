        }
        QPushButton#questionSessionEndButton {
            background-color: rgba(20, 40, 62, 242);
            color: #E4F2FA; border: 1px solid #B49269;
            border-radius: 9px; padding: 0px 11px;
            font-weight: 700;
        }
        QPushButton#questionSessionEndButton:hover {
            background-color: rgba(46, 55, 70, 250);
            border-color: #E4F2FA;
        }
        QPushButton#questionSessionEndButton:pressed {
