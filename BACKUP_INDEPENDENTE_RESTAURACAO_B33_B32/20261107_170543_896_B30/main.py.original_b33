        )

        layout.addLayout(
            cabecalho
        )

        # ----------------------------------------------------
        # FILTROS
        # ----------------------------------------------------

        filtros = QFrame()
        filtros.setObjectName(
            "effectivenessFilterBar"
        )

        filtros_layout = QHBoxLayout(
            filtros
        )
        filtros_layout.setContentsMargins(
            10,
            7,
            10,
            7
        )
        filtros_layout.setSpacing(
            8
        )

        filtros_layout.addWidget(
