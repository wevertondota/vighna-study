            )
        )
        historico_indicadores.addWidget(card, 0, 3)

        minha_layout.addLayout(
            historico_indicadores
        )

        prazo_card = QFrame()
        prazo_card.setObjectName("myEvolutionPanel")
        prazo_layout = QVBoxLayout(prazo_card)
        prazo_layout.setContentsMargins(14, 10, 14, 12)
        prazo_layout.setSpacing(7)
        prazo_titulo = QLabel("Pontualidade das revisões")
        prazo_titulo.setObjectName("myEvolutionSectionTitle")
        prazo_layout.addWidget(prazo_titulo)
        prazo_grade = QGridLayout(); prazo_grade.setHorizontalSpacing(8)
        for coluna in range(4): prazo_grade.setColumnStretch(coluna, 1)
        for coluna, (rotulo, attr) in enumerate((("No prazo", "minha_prazo_pct"),("Prazo conhecido", "minha_prazo_total"),("Atraso médio", "minha_prazo_atraso"),("Concluídas atrasadas", "minha_prazo_atrasadas"))):
            f, valor, detalhe = criar_card_minha_evolucao(rotulo)
            setattr(self, attr, valor)
            setattr(self, attr + "_detalhe", detalhe)
            if attr == "minha_prazo_total": self.minha_prazo_amostra = detalhe
            prazo_grade.addWidget(f, 0, coluna)
        prazo_layout.addLayout(prazo_grade)
        self.minha_prazo_nota = QLabel("O histórico de prazo começa nesta versão. Registros antigos não são inferidos.")
        self.minha_prazo_nota.setObjectName("mutedLabel"); self.minha_prazo_nota.setWordWrap(True)
        prazo_layout.addWidget(self.minha_prazo_nota)
        minha_layout.addWidget(prazo_card)

        # Ganhos e pontos de atenção.
        insights_card = QFrame()
