        # ====================================================

        secao_backup, layout_backup = (
            self.criar_secao_configuracao(
                "Backups e recuperação",
                "Cópias de dados e checkpoints completos, com recuperação sob demanda."
            )
        )

        opcao_backup = QFrame()
        opcao_backup.setObjectName(
            "settingsOption"
        )

        backup_layout = QVBoxLayout(
            opcao_backup
        )
        backup_layout.setContentsMargins(
            14,
            11,
            14,
            12
        )
        backup_layout.setSpacing(
            8
        )

        backup_titulo = QLabel(
            "Segurança dos dados"
        )
        backup_titulo.setObjectName(
            "configOptionTitle"
        )

        descricao_backup = QLabel(
            "Crie uma cópia manual agora ou consulte as cópias "
            "automáticas e manuais disponíveis para restauração."
        )
        descricao_backup.setWordWrap(
            True
        )
        descricao_backup.setObjectName(
            "mutedLabel"
        )

        backup_layout.addWidget(
            backup_titulo
        )
        backup_layout.addWidget(
            descricao_backup
        )

        botoes_backup = QHBoxLayout()
        botoes_backup.setSpacing(
            8
        )

        fazer_backup_agora = QPushButton(
            "Fazer backup agora"
        )
        fazer_backup_agora.setObjectName(
            "toolbarButton"
        )
        fazer_backup_agora.clicked.connect(
            self.fazer_backup_manual_config
        )

        gerenciar_backups = QPushButton(
