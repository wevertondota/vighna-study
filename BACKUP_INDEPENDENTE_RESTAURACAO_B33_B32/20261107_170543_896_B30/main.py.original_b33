        AAAASUVORK5CYII=
    """

    def __init__(self, parent):
        super().__init__(parent)
        self.setObjectName("questionCosmicFullBackgroundB26R7")
        self.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        self.setAttribute(Qt.WA_NoSystemBackground, True)
        self.setFocusPolicy(Qt.NoFocus)
        self._monocromatico = False
        self._pixmaps = []
        for conteudo in (self._COR, self._PB):
            pixmap = QPixmap()
            try:
                pixmap.loadFromData(base64.b64decode(conteudo))
            except (ValueError, TypeError):
                pass
            self._pixmaps.append(pixmap)
        self.hide()

    def definir_monocromatico(self, ativo):
        valor = bool(ativo)
        if self._monocromatico != valor:
            self._monocromatico = valor
            self.update()

    def paintEvent(self, evento):
        if self.width() < 30 or self.height() < 30:
            return
        pixmap = self._pixmaps[1 if self._monocromatico else 0]
        if pixmap.isNull():
            return
        largura, altura = self.width(), self.height()
        proporcao = max(largura / max(1, pixmap.width()),
                        altura / max(1, pixmap.height()))
        alvo_w = max(largura, round(pixmap.width() * proporcao))
        alvo_h = max(altura, round(pixmap.height() * proporcao))
        alvo = QRect((largura-alvo_w)//2, (altura-alvo_h)//2, alvo_w, alvo_h)
        pintor = QPainter(self)
        pintor.setRenderHint(QPainter.SmoothPixmapTransform, True)
        pintor.drawPixmap(alvo, pixmap)
        pintor.end()


class _ConstelacaoSinapticaB26(QWidget):
    clicked = Signal()

    """Pentagrama ×5, cinco formas clássicas e seis formas lendárias.

    Emblemas reais por QPainter. Eventos de combo e persistência são mantidos
    na camada da bateria, separados deste widget de apresentação.
