            "Dificuldade",
            "Gabarito",
            "Análise",
            "Estado",
        ])
        self.tabela_questoes.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.tabela_questoes.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.tabela_questoes.setSelectionMode(QAbstractItemView.ExtendedSelection)
        self.tabela_questoes.verticalHeader().setVisible(False)
        self.tabela_questoes.setShowGrid(False)
        self.tabela_questoes.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.tabela_questoes.setTextElideMode(Qt.ElideRight)
        self.tabela_questoes.setWordWrap(False)
        self.tabela_questoes.cellDoubleClicked.connect(self.visualizar_questao_linha)

        header = self.tabela_questoes.horizontalHeader()
        header.setStretchLastSection(False)

        # Checkbox de seleção global no cabeçalho da primeira coluna. A tabela
        # carrega todo o resultado filtrado; portanto, este controle seleciona
