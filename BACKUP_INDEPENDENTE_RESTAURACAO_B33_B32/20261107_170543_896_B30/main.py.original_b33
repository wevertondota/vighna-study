        )

        self.questoes_estado = QPushButton("Arquivar")
        self.questoes_estado.setObjectName("subtleButton")
        self.questoes_estado.setToolTip(
            "Arquivar preserva a questão e seu histórico; reativar devolve a questão às sessões."
        )
        self.questoes_estado.clicked.connect(self.alternar_estado_questoes_central)
        acoes.addWidget(self.questoes_estado)

        self.questoes_remover = QPushButton("Excluir")
        self.questoes_remover.setObjectName("dangerButton")
        self.questoes_remover.setToolTip(
            "Envia a questão selecionada para a Lixeira. A exclusão permanente fica disponível somente dentro da Lixeira."
        )
        self.questoes_remover.clicked.connect(self.excluir_questao_selecionada)
        acoes.addWidget(self.questoes_remover)

        area_trabalho_layout.addLayout(
            acoes
        )

        # ====================================================
        # TABELA DO BANCO
        # ====================================================
        self.tabela_questoes = QTableWidget()
        self.tabela_questoes.setObjectName("questionsTable")
        self.tabela_questoes.setColumnCount(11)
        self.tabela_questoes.setHorizontalHeaderLabels([
            "",
            "#",
            "Disciplina",
            "Título / tópico",
            "Questão",
            "Banca",
