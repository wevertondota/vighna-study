                background: transparent; border: none;
                color: %(ciano)s; font-size: 10px;
            }
            QProgressBar#neuralArchiveCoverageProgress {
                background: %(campo)s;
                border: none; border-radius: 2px;
            }
            QProgressBar#neuralArchiveCoverageProgress::chunk {
                background: %(ciano)s; border-radius: 2px;
            }
            QPushButton#neuralArchiveStudyAction {
                color: #ffffff; font-weight: 700;
                background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
                    stop:0 %(prim_esq)s, stop:1 %(prim_dir)s);
                border: 1px solid %(borda_forte)s;
                border-radius: 8px; padding: 5px 12px;
            }
            QPushButton#neuralArchiveStudyAction:hover {
                border-color: %(ciano)s; background: %(prim_hover)s;
            }
            QPushButton#neuralArchiveStudyAction:disabled {
                background: %(campo)s; color: %(secundario)s;
                border-color: %(borda)s;
            }
            QPushButton#neuralArchiveQuestionsAction {
                background: %(campo)s; color: %(texto)s;
                border: 1px solid %(borda_forte)s;
                border-radius: 8px; padding: 5px 9px;
            }
            QPushButton#neuralArchiveQuestionsAction:hover {
                background: %(campo_foco)s; border-color: %(ciano)s;
            }
            QPushButton#neuralArchiveQuestionsAction:disabled {
                color: %(secundario)s; border-color: %(borda)s;
            }
            QPushButton#neuralArchiveMoreAction {
                background: %(superficie)s; color: %(secundario)s;
                border: 1px solid %(borda)s;
                border-radius: 8px; padding: 5px 8px;
            }
            QPushButton#neuralArchiveMoreAction:hover {
                background: %(campo_foco)s; color: %(texto)s;
                border-color: %(borda_forte)s;
            }
            QPushButton#neuralArchiveMoreAction:disabled {
                color: %(secundario)s;
            }
            QFrame#filterBar {
                background: %(superficie)s;
                border: 1px solid %(borda)s;
                border-radius: 11px;
            }
            QFrame#filterBar QLineEdit,
            QFrame#filterBar QComboBox {
                background: %(campo)s; color: %(texto)s;
                border: 1px solid %(borda)s;
                border-radius: 7px; padding: 6px 8px;
                selection-background-color: %(selecao)s;
            }
            QFrame#filterBar QLineEdit:focus,
            QFrame#filterBar QComboBox:focus {
                border: 1px solid %(ciano)s;
                background: %(campo_foco)s;
            }
            QFrame#dialogCard {
                background: %(superficie2)s;
                border: 1px solid %(borda)s;
                border-radius: 11px;
            }
            QLabel#metricLabel {
                background: transparent; border: none;
                color: %(ouro)s;
            }
            QLabel#sectionTitle {
                background: transparent; border: none;
                color: %(texto)s;
            }
            QPushButton#neuralArchiveBackButton {
                background: %(superficie)s; color: %(texto)s;
                border: 1px solid %(borda)s;
                border-radius: 8px; padding: 7px 10px;
            }
            QPushButton#neuralArchiveBackButton:hover {
                border: 1px solid %(ciano)s;
                background: %(campo_foco)s;
            }
            QPushButton#neuralArchiveAddButton {
                color: #ffffff;
                background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
                    stop:0 %(prim_esq)s, stop:1 %(prim_dir)s);
                border: 1px solid %(borda_forte)s;
                border-radius: 9px;
                font-weight: 700; padding: 7px 12px;
            }
            QPushButton#neuralArchiveAddButton:hover {
                background: %(prim_hover)s;
                border: 1px solid %(ciano)s;
            }
            QPushButton#neuralArchiveAddButton:disabled {
                background: %(superficie)s; color: %(secundario)s;
            }
            /* E04: Biblioteca Neural — tabela legível, sem canvas/arte decorativa. */
            QTableWidget#disciplineTopicsTable {
                background: %(superficie)s;
                alternate-background-color: %(linha)s;
                color: %(texto)s;
                gridline-color: %(borda)s;
                border: 1px solid %(borda)s;
                border-radius: 10px;
                selection-background-color: %(selecao)s;
                selection-color: %(texto)s;
            }
            /* E05: estado de foco teclado legível, sem pulsos ou animação. */
            QTableWidget#disciplineTopicsTable:focus {
                border: 1px solid %(ciano)s;
            }
            QTableWidget#disciplineTopicsTable::item {
                padding: 2px 5px;
                border-bottom: 1px solid %(borda)s;
            }
            QTableWidget#disciplineTopicsTable::item:hover:!selected {
                background: %(campo_foco)s;
            }
            QTableWidget#disciplineTopicsTable::item:selected {
                background: %(selecao)s;
                color: %(texto)s;
                border-bottom: 1px solid %(borda_forte)s;
            }
            QTableWidget#disciplineTopicsTable QHeaderView::section {
                background: %(superficie2)s;
                color: %(texto)s;
                border: none;
                border-bottom: 1px solid %(borda_forte)s;
                border-right: 1px solid %(borda)s;
                padding: 6px 5px;
                font-weight: 700;
            }
            QWidget#disciplineTopicCell {
                background: transparent; border: none;
            }
            QLabel#disciplineTopicCellLabel {
                background: transparent; border: none;
                color: %(texto)s;
                font-weight: 650;
            }
            QWidget#disciplineTopicCell[inactive="true"] QLabel#disciplineTopicCellLabel {
                color: %(secundario)s;
            }
            QToolButton#neuralArchiveTreeToggle {
                color: %(ciano)s;
                background: %(campo)s;
                border: 1px solid %(borda_forte)s;
                border-radius: 5px;
                font-size: 13px; font-weight: 700;
                padding: 0;
            }
            QToolButton#neuralArchiveTreeToggle:hover {
                color: %(texto)s;
                background: %(campo_foco)s;
                border: 1px solid %(ciano)s;
            }
            QToolButton#neuralArchiveTreeToggle:disabled {
                color: %(secundario)s;
                border: 1px solid %(borda)s;
            }
            /* E06 R1: contêiner preenche somente a célula; botão compacto
               permanece centralizado sem encostar na linha ou coluna vizinha. */
            QWidget#neuralArchiveRefreshCell {
                background: transparent;
                border: none;
            }
            QPushButton#neuralArchiveRowRefresh {
                color: %(secundario)s;
                background: %(campo)s;
                border: 1px solid %(borda)s;
                border-radius: 5px;
                padding: 0px 2px;
                margin: 0px;
                font-size: 10px; font-weight: 600;
            }
            QPushButton#neuralArchiveRowRefresh:hover {
                color: %(texto)s;
                background: %(campo_foco)s;
                border: 1px solid %(ciano)s;
            }
            QPushButton#neuralArchiveRowRefresh:disabled {
                color: %(secundario)s;
                background: %(superficie)s;
                border-color: %(borda)s;
            }
            /* E05: contraste uniforme para controles acessados via Tab. */
            QPushButton#neuralArchiveBackButton:focus,
            QPushButton#neuralArchiveAddButton:focus,
            QPushButton#neuralArchiveStudyAction:focus,
            QPushButton#neuralArchiveQuestionsAction:focus,
            QPushButton#neuralArchiveMoreAction:focus,
            QToolButton#neuralArchiveTreeToggle:focus,
            QPushButton#neuralArchiveRowRefresh:focus {
                border: 1px solid %(ciano)s;
                background: %(campo_foco)s;
            }
            QPushButton#neuralArchiveStudyAction:disabled:focus,
            QPushButton#neuralArchiveQuestionsAction:disabled:focus,
            QPushButton#neuralArchiveRowRefresh:disabled:focus {
                background: %(campo)s;
                border-color: %(borda)s;
            }
        """ % cores
        if tela.styleSheet() != qss:
            tela.setStyleSheet(qss)

    def criar_tela_disciplina(self):
        tela = QWidget()
        tela.setObjectName("neuralArchivePage")
        tela.setAttribute(Qt.WA_StyledBackground, True)

        layout = QVBoxLayout(tela)
        layout.setContentsMargins(24, 14, 24, 16)
        layout.setSpacing(10)

        # ====================================================
        # CABEÇALHO
        # ====================================================

        painel_cabecalho = QFrame(tela)
        painel_cabecalho.setObjectName("neuralArchiveHeader")
        cabecalho = QHBoxLayout(painel_cabecalho)
        cabecalho.setContentsMargins(14, 8, 14, 8)
        cabecalho.setSpacing(11)

        voltar = QPushButton(
            "← Voltar"
        )
        voltar.setObjectName("neuralArchiveBackButton")
        voltar.setProperty(
            "navigationBack",
            True
        )
        voltar.setFixedWidth(
            88
        )
        voltar.clicked.connect(
            self._voltar_da_disciplina
        )

        cabecalho.addWidget(voltar)

        # Marca dourada discreta identifica este setor do Oráculo.
        filete = QFrame(painel_cabecalho)
        filete.setObjectName("neuralArchiveAccent")
        filete.setFixedSize(3, 44)
        cabecalho.addWidget(filete)

        bloco_titulo = QVBoxLayout()
        bloco_titulo.setSpacing(0)
        marca = QLabel("ARQUIVO NEURAL  /  DISCIPLINA", painel_cabecalho)
        marca.setObjectName("neuralArchiveEyebrow")
        bloco_titulo.addWidget(marca)

        self.titulo_disciplina = QLabel()
        self.titulo_disciplina.setObjectName(
            "pageTitle"
        )

        subtitulo_disciplina = QLabel(
            "Organize os tópicos e acompanhe o progresso desta disciplina."
        )
        subtitulo_disciplina.setObjectName(
            "pageSubtitle"
        )

        bloco_titulo.addWidget(
            self.titulo_disciplina
        )
        bloco_titulo.addWidget(
            subtitulo_disciplina
        )

        cabecalho.addLayout(
            bloco_titulo
        )
        cabecalho.addStretch()

        # A ação principal da disciplina recebe destaque próprio. Comandos de
        # manutenção menos frequentes ficam concentrados no menu compacto ao lado.
        self.botao_adicionar_topico = QPushButton("Adicionar tópico")
        self.botao_adicionar_topico.setObjectName("neuralArchiveAddButton")
        self.botao_adicionar_topico.setFixedHeight(42)
        self.botao_adicionar_topico.setMinimumWidth(174)
        self.botao_adicionar_topico.setToolTip(
            "Adicionar um novo título/tópico à disciplina atual."
        )
        self.botao_adicionar_topico.clicked.connect(self.novo_topico)

        self.botao_mais_disciplina = QPushButton("⋯")
        self.botao_mais_disciplina.setObjectName("subtleButton")
        self.botao_mais_disciplina.setFixedSize(44, 42)
        self.botao_mais_disciplina.setAccessibleName("Mais ações da disciplina")
        self.botao_mais_disciplina.setToolTip("Mais ações da disciplina")

        self.menu_disciplina = QMenu(self.botao_mais_disciplina)
        self.acao_questoes_arquivadas_disciplina = self.menu_disciplina.addAction(
            "Questões arquivadas"
        )
        self.acao_questoes_arquivadas_disciplina.triggered.connect(
            self.abrir_questoes_desativadas_disciplina_atual
        )
        self.acao_lixeira_disciplina = self.menu_disciplina.addAction("Lixeira")
        self.acao_lixeira_disciplina.triggered.connect(
            lambda: JanelaLixeiraQuestoes(self).exec()
        )
        self.menu_disciplina.addSeparator()
        self.acao_estado_disciplina = self.menu_disciplina.addAction(
            "Desligar disciplina"
        )
        self.acao_estado_disciplina.triggered.connect(
            self.alternar_estado_disciplina_atual
        )
        self.botao_mais_disciplina.setMenu(self.menu_disciplina)

        # Controles mantidos apenas como proxies internos para preservar
        # compatibilidade com rotinas legadas. Eles precisam ter um pai oculto:
        # um QWidget/QPushButton criado sem parent vira uma janela top-level e,
        # se alguma rotina chamar setVisible(True), pode aparecer como uma
        # pequena janela flutuante sobre a disciplina.
        self._proxies_disciplina = QWidget(tela)
        self._proxies_disciplina.setObjectName("disciplineLegacyProxyContainer")
        self._proxies_disciplina.setVisible(False)

        self.botao_estado_disciplina = QPushButton(
            "Desligar disciplina", self._proxies_disciplina
        )
        self.botao_estado_disciplina.setVisible(False)
        self.botao_estado_disciplina.clicked.connect(
            self.alternar_estado_disciplina_atual
        )

        self.botao_capitulos = QPushButton(
            "Capítulos", self._proxies_disciplina
        )
        self.botao_capitulos.setObjectName("toolbarButton")
        self.botao_capitulos.setFixedHeight(34)
        self.botao_capitulos.setEnabled(False)
        self.botao_capitulos.setToolTip(
            "Adicionar, renomear ou desligar capítulos do tópico selecionado."
        )
        self.botao_capitulos.clicked.connect(
            self.abrir_capitulos_topico_selecionado
        )

        renomear = QPushButton("Renomear", self._proxies_disciplina)
        renomear.setObjectName("toolbarButton")
        renomear.setFixedHeight(34)
        renomear.setToolTip("Renomear o tópico selecionado.")
        renomear.clicked.connect(self.renomear_topico_selecionado)

        self.botao_estado_topico = QPushButton(
            "Desligar tópico", self._proxies_disciplina
        )
        self.botao_estado_topico.setObjectName("toolbarButton")
        self.botao_estado_topico.setFixedHeight(34)
        self.botao_estado_topico.setToolTip(
            "Desliga temporariamente o tópico no perfil atual, sem apagar histórico, agenda ou questões."
        )
        self.botao_estado_topico.clicked.connect(
            self.alternar_estado_topico_selecionado
        )

        excluir = QPushButton("Excluir", self._proxies_disciplina)
        excluir.setObjectName("dangerButton")
        excluir.setFixedHeight(34)
        excluir.setToolTip(
            "Excluir permanentemente o título/tópico ou capítulo selecionado."
        )
        excluir.clicked.connect(self.excluir_topico_selecionado)

        cabecalho.addWidget(self.botao_adicionar_topico)
        cabecalho.addWidget(self.botao_mais_disciplina)

        layout.addWidget(painel_cabecalho)

        # ====================================================
        # PERFIL + RESUMO DA DISCIPLINA
        # ====================================================

        faixa_contexto = QHBoxLayout()
        faixa_contexto.setSpacing(10)

        self.perfil_disciplina = QLabel("Perfil: —")
        self.perfil_disciplina.setObjectName("profileBadge")
        faixa_contexto.addWidget(self.perfil_disciplina)
        faixa_contexto.addStretch()

        # Proxies mantidos para chamadas legadas; as ações visíveis agora ficam
        # no menu da disciplina.
        self.botao_questoes_desativadas_disciplina = QPushButton(
            "Questões arquivadas", self._proxies_disciplina
        )
        self.botao_questoes_desativadas_disciplina.setVisible(False)
        self.botao_questoes_desativadas_disciplina.clicked.connect(
            self.abrir_questoes_desativadas_disciplina_atual
        )

        self.botao_lixeira_disciplina = QPushButton(
            "Lixeira", self._proxies_disciplina
        )
        self.botao_lixeira_disciplina.setVisible(False)
        self.botao_lixeira_disciplina.clicked.connect(
            lambda: JanelaLixeiraQuestoes(self).exec()
        )

        layout.addLayout(faixa_contexto)

        self._indicadores_arquivo_neural = {}
        resumo = QGridLayout()
        resumo.setHorizontalSpacing(
            10
        )
        resumo.setVerticalSpacing(
            0
        )

        for coluna in range(
            4
        ):
            resumo.setColumnStretch(
                coluna,
                1
            )

        quadro, self.resumo_disciplina_topicos = (
            self._criar_indicador_arquivo_neural(
                "Tópicos", "topicos"
            )
        )
        resumo.addWidget(
            quadro,
            0,
            0
        )

        quadro, self.resumo_disciplina_hoje = (
            self._criar_indicador_arquivo_neural(
                "Hoje", "hoje"
            )
        )
        resumo.addWidget(
            quadro,
            0,
            1
        )

        quadro, self.resumo_disciplina_atrasados = (
            self._criar_indicador_arquivo_neural(
                "Atrasados", "atrasados"
            )
        )
        resumo.addWidget(
            quadro,
            0,
            2
        )

        quadro, self.resumo_disciplina_media = (
            self._criar_indicador_arquivo_neural(
                "Desempenho", "desempenho"
            )
        )
        resumo.addWidget(
            quadro,
            0,
            3
        )

        layout.addLayout(
            resumo
        )

        # ====================================================
        # BUSCA E FILTROS
        # ====================================================

        barra_filtros = QFrame()
        barra_filtros.setObjectName(
            "filterBar"
        )

        filtros = QHBoxLayout(
            barra_filtros
        )
        filtros.setContentsMargins(
            10,
            8,
            10,
            8
        )
        filtros.setSpacing(
            8
        )

        self.busca_topicos = QLineEdit()
        self.busca_topicos.setPlaceholderText(
            "Buscar tópico..."
        )
        self.busca_topicos.setClearButtonEnabled(
            True
        )
        self.busca_topicos.setAccessibleName("Buscar tópicos da disciplina")
        self.busca_topicos.setAccessibleDescription(
            "Digite parte do nome para filtrar a biblioteca. "
            "Ctrl+F abre a busca; Esc retorna o foco à tabela sem apagar o filtro."
        )
        self.busca_topicos.setToolTip(
            "Ctrl+F: buscar tópico. Esc: voltar à lista sem apagar a busca."
        )
        self.busca_topicos.textChanged.connect(
            self.aplicar_filtros_topicos
        )

        self.filtro_topicos = QComboBox()
        self.filtro_topicos.setMinimumWidth(
            150
        )
        self.filtro_topicos.setAccessibleName("Filtrar tópicos por situação")
        self.filtro_topicos.setToolTip(
            "Escolha o recorte da biblioteca. A seleção preserva o tópico "
            "quando ele continua visível."
        )
        self.filtro_topicos.addItems([
            "Todos",
            "Ativos",
            "Desligados",
            "Pendentes",
            "Atrasados",
            "Hoje",
            "< 70%",
            "< 80%",
            "≥ 90%",
            "Sem revisão",
            "Importância 5",
            "Importância ≥ 4"
        ])
        self.filtro_topicos.currentTextChanged.connect(
            self.aplicar_filtros_topicos
        )

        self.contador_topicos = QLabel(
            "0 tópico(s)"
        )
        self.contador_topicos.setObjectName(
            "filterCount"
        )

        filtros.addWidget(
            self.busca_topicos,
            1
        )
        filtros.addWidget(
            self.filtro_topicos
        )
        filtros.addWidget(
            self.contador_topicos
        )

        layout.addWidget(
            barra_filtros
        )

        # ====================================================
        # AÇÕES DO TÓPICO SELECIONADO
        # ====================================================

        self.painel_acoes_topico = QFrame()
        self.painel_acoes_topico.setObjectName("neuralArchiveSelectionPanel")

        painel_acoes_layout = QHBoxLayout(self.painel_acoes_topico)
        painel_acoes_layout.setContentsMargins(13, 9, 13, 9)
        painel_acoes_layout.setSpacing(12)

        # E03: marca física da seleção, sem arte ou painel sobre o fundo.
        acento_selecao = QFrame(self.painel_acoes_topico)
        acento_selecao.setObjectName("neuralArchiveSelectionAccent")
        acento_selecao.setFixedWidth(3)
        painel_acoes_layout.addWidget(acento_selecao)

        bloco_selecao = QVBoxLayout()
        bloco_selecao.setSpacing(2)

        cabecalho_selecao = QHBoxLayout()
        cabecalho_selecao.setSpacing(7)
        self.rotulo_contexto_topico = QLabel("TÓPICO SELECIONADO")
        self.rotulo_contexto_topico.setObjectName("neuralArchiveSelectionContext")
        cabecalho_selecao.addWidget(self.rotulo_contexto_topico)
        cabecalho_selecao.addStretch(1)
        self.rotulo_estado_topico_disciplina = QLabel("SEM SELEÇÃO")
        self.rotulo_estado_topico_disciplina.setObjectName(
            "neuralArchiveSelectionState"
        )
        self.rotulo_estado_topico_disciplina.setProperty(
            "neuralSelectionState", "none"
        )
        cabecalho_selecao.addWidget(self.rotulo_estado_topico_disciplina)
        bloco_selecao.addLayout(cabecalho_selecao)

        self.rotulo_topico_selecionado = QLabel("Selecione um tópico")
        self.rotulo_topico_selecionado.setObjectName("neuralArchiveSelectionTitle")
        self.rotulo_topico_selecionado.setWordWrap(True)

        self.subtitulo_topico_selecionado = QLabel(
            "Selecione uma linha abaixo para estudar, ver questões ou administrar o conteúdo."
        )
        self.subtitulo_topico_selecionado.setObjectName(
            "neuralArchiveSelectionDetails"
        )
        self.subtitulo_topico_selecionado.setWordWrap(True)

        bloco_selecao.addWidget(self.rotulo_topico_selecionado)
        bloco_selecao.addWidget(self.subtitulo_topico_selecionado)

        # Sem barras fictícias: somente cobertura/ciclo efetivamente ativos.
        self.faixa_andamento_topico = QWidget(self.painel_acoes_topico)
        self.faixa_andamento_topico.setObjectName("neuralArchiveFlowWrap")
        layout_andamento = QVBoxLayout(self.faixa_andamento_topico)
        layout_andamento.setContentsMargins(0, 1, 0, 0)
        layout_andamento.setSpacing(3)
        self.rotulo_andamento_topico = QLabel("")
        self.rotulo_andamento_topico.setObjectName("neuralArchiveFlowLabel")
        self.rotulo_andamento_topico.setWordWrap(True)
        layout_andamento.addWidget(self.rotulo_andamento_topico)
        self.barra_cobertura_topico = QProgressBar(self.faixa_andamento_topico)
        self.barra_cobertura_topico.setObjectName(
            "neuralArchiveCoverageProgress"
        )
        self.barra_cobertura_topico.setTextVisible(False)
        self.barra_cobertura_topico.setFixedHeight(4)
        self.barra_cobertura_topico.setRange(0, 1)
        self.barra_cobertura_topico.setValue(0)
        layout_andamento.addWidget(self.barra_cobertura_topico)
        self.faixa_andamento_topico.setVisible(False)
        bloco_selecao.addWidget(self.faixa_andamento_topico)

        painel_acoes_layout.addLayout(bloco_selecao, 1)

        acoes_selecao = QHBoxLayout()
        acoes_selecao.setSpacing(8)

        self.botao_estudar_topico_disciplina = QPushButton("Estudar")
        self.botao_estudar_topico_disciplina.setObjectName("neuralArchiveStudyAction")
        self.botao_estudar_topico_disciplina.setFixedHeight(38)
        self.botao_estudar_topico_disciplina.setMinimumWidth(104)
