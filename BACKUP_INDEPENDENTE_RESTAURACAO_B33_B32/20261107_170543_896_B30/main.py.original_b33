        self.tabela.itemSelectionChanged.connect(self.mostrar_detalhes)
        self.carregar_historico()

    def carregar_historico(self):
        resumo = obter_resumo_topico(
            self.topico_id
        )

        dominio = obter_indice_dominio_topico(
            self.topico_id,
            resumo[
                "concurso_id"
            ]
        )

        score_dominio = float(
            dominio.get(
                "score",
                0.0
            )
            or 0.0
        )

        self.dominio_valor.setText(
            f"{score_dominio:.0f} / 100"
        )
        self.dominio_barra.setValue(
            int(
                round(
                    score_dominio
                )
            )
        )
        self.dominio_nivel.setText(
            dominio.get(
                "nivel",
                "Sem evidência"
            )
        )

        mapa_nivel_dominio = {
            "Sem evidência": "sem",
            "Crítico": "critico",
            "Frágil": "fragil",
            "Em desenvolvimento": "desenvolvimento",
            "Consolidando": "consolidando",
            "Dominado": "dominado",
            "Domínio forte": "forte",
        }

        self.dominio_nivel.setProperty(
            "domainLevel",
            mapa_nivel_dominio.get(
                dominio.get(
                    "nivel"
                ),
                "sem"
            )
        )
        self.dominio_nivel.style().unpolish(
            self.dominio_nivel
        )
        self.dominio_nivel.style().polish(
            self.dominio_nivel
        )

        self.dominio_desempenho.setText(
            f"{dominio['desempenho']:.0f}"
        )
        self.dominio_variedade.setText(
            f"{dominio['variedade']:.0f}"
        )
        self.dominio_estabilidade.setText(
            f"{dominio['estabilidade']:.0f}"
        )
        self.dominio_recencia.setText(
            f"{dominio['recencia']:.0f}"
        )
        self.dominio_erros.setText(
            f"{dominio['controle_erros']:.0f}"
        )
        self.dominio_evidencia_score.setText(
            f"{dominio['evidencia']:.0f}"
        )

        # Premium view mirrors existing numerical results; no recalculation.
        for campo, barra in self._topic_metric_bars.items():
            try:
                valor_exibido = float(getattr(self, campo).text().replace(",", "."))
            except (TypeError, ValueError):
                valor_exibido = 0.0
            barra.setValue(max(0, min(100, int(round(valor_exibido)))))
        for campo, label in self._topic_evidence_values.items():
            label.setText(str(int(dominio.get(campo, 0) or 0)))

        if dominio[
            "tentativas"
        ] <= 0:
            evidencia_texto = (
                "Evidência: sem respostas internas efetivas. "
                "Revisões manuais ou legadas não substituem questões "
                "para este índice."
            )
        else:
            evidencia_texto = (
                f"Evidência {dominio['qualidade_evidencia']} • "
                f"{dominio['tentativas_historicas']} resposta(s) histórica(s) • "
                f"{dominio['questoes_unicas']} questão(ões) diferente(s) • "
                f"{dominio['dias_ativos_historicos']} dia(s) de prática • "
                f"{dominio['revisoes']} revisão(ões) registrada(s) • "
                f"dúvidas recentes {dominio['taxa_duvida']:.0f}%"
            )

        self.dominio_evidencia.setText(
            evidencia_texto
        )

        pontos_fortes = dominio.get(
            "pontos_fortes",
            []
        )
        self.dominio_pontos_fortes.setText(
            " • ".join(pontos_fortes)
            if pontos_fortes
            else "Ainda sem sinal forte suficiente para destacar."
        )

        motivos_dominio = dominio.get(
            "motivos",
            []
        )
        self.dominio_motivos.setText(
            " • ".join(motivos_dominio)
            if motivos_dominio
            else "Nenhum limitador relevante aberto no momento."
        )

        self.dados_revisoes = (
            listar_revisoes_topico(
                self.topico_id
            )
        )

        self.tabela.setRowCount(
            len(self.dados_revisoes)
        )

        for linha, revisao in enumerate(
            self.dados_revisoes
        ):
            origem = (
                "Questões internas"
                if revisao[8]
                == "questoes_internas"
                else "Manual"
            )

            if (
                revisao[8]
                == "questoes_internas"
            ):
                if revisao[9] == "muito_baixa":
                    origem += " • 1º contato"
                elif revisao[9] == "baixa":
                    origem += " • baixa"

            valores = [
                formatar_data(
                    revisao[1]
                ),
                str(
                    revisao[2]
                ),
                str(
                    revisao[3]
                ),
                formatar_percentual(
                    revisao[4]
                ),
                origem
            ]

            for coluna, valor in enumerate(
                valores
            ):
                item = QTableWidgetItem(
                    valor
                )
                item.setTextAlignment(
                    Qt.AlignCenter
                )

                self.tabela.setItem(
                    linha,
                    coluna,
                    item
                )

            self.tabela.setRowHeight(
                linha,
                30
            )

        # Resumo executivo da página do tópico. Os números usam a mesma
        # telemetria que alimenta o Domínio V2 e o motor de recomendação.
        self.valor_dominio_resumo.setText(
            f"{score_dominio:.0f}%"
        )

        quantidade_questoes = int(
            dominio.get("questoes_ativas", 0) or 0
        )
        self.valor_questoes_topico.setText(
            str(quantidade_questoes)
        )

        erros_em_atencao = sum(
            int(dominio.get(chave, 0) or 0)
            for chave in (
                "criticas",
                "recorrentes",
                "recuperacao",
                "erros_isolados",
            )
        )
        self.valor_erros_topico.setText(
            str(erros_em_atencao)
        )

        ultima_pratica = (
            dominio.get("ultima_resposta")
            or resumo.get("ultima_revisao")
        )
        if ultima_pratica:
            texto_ultima = str(ultima_pratica)
            try:
                momento = datetime.fromisoformat(
                    texto_ultima.replace("Z", "+00:00")
                )
                texto_ultima = momento.strftime("%d/%m/%Y")
            except Exception:
                texto_ultima = formatar_data(
                    texto_ultima[:10]
                )
        else:
            texto_ultima = "—"

        self.valor_ultima_pratica_topico.setText(
            texto_ultima
        )
        self.topic_last_practice.setText("Última prática\n" + texto_ultima)

        self.valor_proxima_topico.setText(
            formatar_data(
                resumo.get("proxima_revisao")
            )
        )

        disciplina_nome = str(
            self.contexto_topico.get(
                "disciplina_nome",
                ""
            )
            or ""
        )
        breadcrumb = []
        if disciplina_nome:
            breadcrumb.append(disciplina_nome)
        breadcrumb.append(f"Perfil {resumo['concurso_nome']}")
        self.topico_breadcrumb.setText("  ›  ".join(breadcrumb))

        revisoes_totais = int(resumo.get("revisoes_totais", 0) or 0)
        revisoes_texto = (
            "1 revisão registrada"
            if revisoes_totais == 1
            else f"{revisoes_totais} revisões registradas"
        )
        self.topico_contexto_label.setText(
            f"Importância {resumo['importancia']}/5 • {revisoes_texto}"
        )

        # Painel de próximo passo: usa a agenda real do tópico e comunica o
        # estado em linguagem direta, sem transformar todos os dados em cards.
        proxima_raw = resumo.get("proxima_revisao")
        proxima_qdate = QDate.fromString(
            str(proxima_raw or "")[:10],
            "yyyy-MM-dd",
        )
        hoje_qdate = QDate.currentDate()
        estado_agenda = "none"
        if proxima_qdate.isValid():
            dias = hoje_qdate.daysTo(proxima_qdate)
            self.proximo_data.setText(proxima_qdate.toString("dd/MM/yyyy"))
            if dias < 0:
                atraso = abs(dias)
                self.proximo_status.setText(
                    "REVISÃO EM ATRASO"
                )
                self.proximo_texto.setText(
                    f"A revisão programada venceu há {atraso} dia(s). Priorize uma revisão curta ou uma bateria dirigida antes de avançar."
                )
                estado_agenda = "overdue"
            elif dias == 0:
                self.proximo_status.setText("REVISÃO HOJE")
                self.proximo_texto.setText(
                    "A revisão deste tópico está prevista para hoje. Uma rodada curta já atualiza a agenda e o domínio."
                )
                estado_agenda = "today"
            elif dias == 1:
                self.proximo_status.setText("REVISÃO AMANHÃ")
                self.proximo_texto.setText(
                    "A próxima revisão está próxima. Você pode antecipá-la agora ou manter a agenda planejada."
                )
                estado_agenda = "soon"
            else:
                self.proximo_status.setText(f"EM {dias} DIAS")
                self.proximo_texto.setText(
                    "A revisão está agendada. Continue estudando normalmente ou antecipe uma sessão se quiser reforçar este conteúdo."
                )
                estado_agenda = "future"
        else:
            self.proximo_status.setText("SEM REVISÃO AGENDADA")
            self.proximo_data.setText("—")
            self.proximo_texto.setText(
                "Ainda não há uma próxima revisão registrada. Estude o tópico ou registre uma revisão para alimentar a agenda."
            )

        self.proximo_status.setProperty("scheduleState", estado_agenda)
        self.proximo_status.style().unpolish(self.proximo_status)
        self.proximo_status.style().polish(self.proximo_status)
        self.proximo_atencao.setText(
            f"{erros_em_atencao} erro(s) em atenção • {quantidade_questoes} questão(ões) ativa(s)"
        )

        iniciais = resumo[
            "revisoes_iniciais"
        ]

        if iniciais > 0:
            self.aviso_legado.setText(
                f"ℹ  {iniciais} revisão(ões) importada(s) do Excel contam no total, "
                "mas não possuem detalhes individuais editáveis."
            )
            self.aviso_legado.setVisible(
                True
            )
        else:
            self.aviso_legado.clear()
            self.aviso_legado.setVisible(
                False
            )

        # Evolução detalhada considera apenas as sessões que
        # possuem data, questões e acertos registrados no programa.
        cronologico = list(
            reversed(
                self.dados_revisoes
            )
        )

        percentuais_grafico = [
            revisao[4]
            for revisao in cronologico
        ]

        rotulos_grafico = [
            f"R{i + 1}"
            for i in range(
                len(cronologico)
            )
        ]

        self.grafico_evolucao.definir_dados(
            percentuais_grafico,
            rotulos_grafico
        )

        sem_evolucao = len(cronologico) == 0
        self.grafico_evolucao.setVisible(not sem_evolucao)
        self.evolucao_vazia.setVisible(sem_evolucao)
        self.resumo_evolucao.setVisible(not sem_evolucao)

        if len(cronologico) == 0:
            self.resumo_evolucao.clear()

        elif len(cronologico) == 1:
            atual = cronologico[0][4]

            self.resumo_evolucao.setText(
                f"1 revisão detalhada • resultado {formatar_percentual(atual)}"
            )

        else:
            primeiro = cronologico[0][4]
            ultimo = cronologico[-1][4]
            melhor = max(
                percentuais_grafico
            )
            pior = min(
                percentuais_grafico
            )
            variacao = (
                ultimo - primeiro
            )

            sinal = (
                "+"
                if variacao > 0
                else ""
            )

            self.resumo_evolucao.setText(
                f"{formatar_percentual(primeiro)} → {formatar_percentual(ultimo)}  •  "
                f"Variação {sinal}{variacao:.1f} p.p.  •  "
                f"Melhor {formatar_percentual(melhor)}  •  "
                f"Pior {formatar_percentual(pior)}"
            )

        self.detalhes.clear()
        self.atualizar_estado_botoes()

    def atualizar_estado_botoes(self):
        tem_selecao = (
            self.tabela.currentRow() >= 0
            and len(self.dados_revisoes) > 0
        )

        automatica = False

        if tem_selecao:
            revisao = self.dados_revisoes[
                self.tabela.currentRow()
            ]
            automatica = (
                len(
                    revisao
                ) > 8
                and revisao[8]
                == "questoes_internas"
            )

        editavel = (
            tem_selecao
            and not automatica
        )

        self.editar_revisao_btn.setEnabled(
            editavel
        )
        self.excluir_revisao_btn.setEnabled(
            editavel
        )

        if automatica:
            texto = (
                "Revisões automáticas são controladas pelas "
                "tentativas das questões internas."
            )
            self.editar_revisao_btn.setToolTip(
                texto
            )
            self.excluir_revisao_btn.setToolTip(
                texto
            )
        else:
            self.editar_revisao_btn.setToolTip(
                "Editar a revisão manual selecionada."
            )
            self.excluir_revisao_btn.setToolTip(
                "Excluir a revisão manual selecionada."
            )

    def exec(self):
        """Mantém a API dos chamadores sem tornar a página do tópico modal."""
        ciclo = QEventLoop()
        encerrada = False

        def encerrar_ciclo(*_args):
            nonlocal encerrada
            encerrada = True
            if ciclo.isRunning():
                ciclo.quit()

        self.finished.connect(encerrar_ciclo)
        self.setWindowModality(Qt.NonModal)
        self.show()
        self.raise_()
        self.activateWindow()

        if not encerrada:
            ciclo.exec()

        try:
            self.finished.disconnect(encerrar_ciclo)
        except (RuntimeError, TypeError):
            pass
        return self.result()

    def estudar_topico(self):
        janela_config = JanelaEstudoTopico(
            self.topico_id,
            self.nome_topico,
            self,
        )
        if janela_config.exec() != QDialog.Accepted:
            return

        configuracao = janela_config.configuracao or {}
        fila = configuracao.get("fila") or []
        if not fila:
            return

        janela = JanelaResolverQuestoes(
            configuracao,
            self,
        )
        janela.exec_nao_modal()
        self.carregar_historico()

    def revisar_topico(self):
        quantidade_revisao = max(
            1,
            obter_configuracao_int(
                "questoes_revisao_min_registro",
                5
            )
        )
        resultado = abrir_resolvedor_topico(
            self.topico_id,
            self.nome_topico,
            self,
            quantidade_padrao=quantidade_revisao,
            modo_nome="Revisão do tópico",
            origem_sessao="topico_revisao",
        )
        if resultado is not None:
            self.carregar_historico()

    def ver_questoes_topico(self):
        # A Central de Questões é a fonte administrativa oficial. Ao sair da
        # página do tópico, fechamos este diálogo modal e abrimos a Central já
        # filtrada no conteúdo atual, onde também ficam Importar e Nova questão.
        alvo = self.parentWidget()
        while alvo is not None:
            metodo = getattr(alvo, "abrir_questoes_topico_contextual", None)
            if callable(metodo):
                topico_id = self.topico_id
                self.accept()
                QTimer.singleShot(0, lambda m=metodo, tid=topico_id: m(tid))
                return
            alvo = alvo.parentWidget()

        app = QApplication.instance()
        if app is not None:
            for janela in app.topLevelWidgets():
                metodo = getattr(janela, "abrir_questoes_topico_contextual", None)
                if callable(metodo):
                    topico_id = self.topico_id
                    self.accept()
                    QTimer.singleShot(0, lambda m=metodo, tid=topico_id: m(tid))
                    return

        QMessageBox.warning(
            self,
            "Ver questões",
            "A Central de Questões não pôde ser localizada."
        )

    def resolver_questoes(self):
        # Compatibilidade com atalhos antigos: "resolver" agora equivale
        # à ação principal Estudar da página do tópico.
        return self.estudar_topico()

    def nova_revisao(self):
        janela = JanelaRevisao(
            self.topico_id,
            self.nome_topico,
            self
        )

        if janela.exec() == QDialog.Accepted:
            _notificar_dados_alterados_raiz(self, "revisoes")
            self.carregar_historico()

    def editar_revisao(self):
        linha = self.tabela.currentRow()

        if linha < 0:
            return

        revisao = self.dados_revisoes[linha]

        janela = JanelaRevisao(
            self.topico_id,
            self.nome_topico,
            self,
            revisao=revisao,
            modo_edicao=True
        )

        if janela.exec() == QDialog.Accepted:
            _notificar_dados_alterados_raiz(self, "revisoes")
            self.carregar_historico()

    def excluir_revisao_selecionada(self):
        linha = self.tabela.currentRow()

        if linha < 0:
            return

        revisao = self.dados_revisoes[linha]

        resposta = QMessageBox.question(
            self,
            "Excluir revisão",
            (
                "Tem certeza que deseja excluir esta revisão?\n\n"
                f"Data: {formatar_data(revisao[1])}\n"
                f"Questões: {revisao[2]}\n"
                f"Acertos: {revisao[3]}\n"
                f"Resultado: {formatar_percentual(revisao[4])}\n\n"
                "Essa ação remove esse registro do histórico."
            ),
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )

        if resposta != QMessageBox.Yes:
            return

        excluir_revisao(
            revisao[0]
        )

        _notificar_dados_alterados_raiz(self, "revisoes")
        self.carregar_historico()

    def alterar_proxima_revisao(self):
        resumo = obter_resumo_topico(
            self.topico_id
        )

        atual = resumo[
            "proxima_revisao"
        ]

        dialogo = QDialog(self)
        dialogo.setWindowTitle(
            "Alterar próxima revisão"
        )

        layout = QVBoxLayout(dialogo)

        texto = QLabel(
            "Escolha a nova data da próxima revisão:"
        )
        layout.addWidget(texto)

        data = QDateEdit()
        data.setCalendarPopup(True)
        data.setDisplayFormat("dd/MM/yyyy")

        if atual:
            data_atual = QDate.fromString(
                atual,
                "yyyy-MM-dd"
            )
            if data_atual.isValid():
                data.setDate(data_atual)
            else:
                data.setDate(QDate.currentDate())
        else:
            data.setDate(QDate.currentDate())

        layout.addWidget(data)

        botoes = QDialogButtonBox(
            QDialogButtonBox.Save |
            QDialogButtonBox.Cancel
        )

        botoes.button(
            QDialogButtonBox.Save
        ).setText("Salvar data")
        botoes.button(
            QDialogButtonBox.Cancel
        ).setText("Cancelar")

        botoes.accepted.connect(
            dialogo.accept
        )
        botoes.rejected.connect(
            dialogo.reject
        )

        layout.addWidget(botoes)

        if dialogo.exec() == QDialog.Accepted:
            atualizar_proxima_revisao(
                self.topico_id,
                data.date().toString(
                    "yyyy-MM-dd"
                )
            )
            _notificar_dados_alterados_raiz(self, "revisoes")
            self.carregar_historico()

    def mostrar_detalhes(self):
        linha = self.tabela.currentRow()

        if linha < 0:
            self.detalhes.clear()
            self.atualizar_estado_botoes()
            return

        revisao = self.dados_revisoes[
            linha
        ]

        observacao = revisao[5] or "—"
        texto_erros = revisao[6] or "—"
        continuacao = revisao[7] or "—"

        origem = (
            revisao[8]
            if len(
                revisao
            ) > 8
            else "manual"
        )

        if origem == "questoes_internas":
            confianca = (
                revisao[9]
                if len(
                    revisao
                ) > 9
                else ""
            )

            if confianca == "muito_baixa":
                confianca_texto = (
                    "Muito baixa • primeiro contato"
                )
            elif confianca == "baixa":
                confianca_texto = (
                    "Baixa confiança"
                )
            else:
                confianca_texto = (
                    "Normal"
                )

            tentativas = (
                listar_tentativas_revisao_automatica(
                    revisao[0]
                )
            )

            linhas_questoes = []

            for tentativa in tentativas:
                linhas_questoes.append(
                    (
                        f"#{tentativa['questao_id']} • "
                        f"{tentativa['status']} • "
                        f"marcada {tentativa['marcada'] or '—'} • "
                        f"gabarito {tentativa['gabarito'] or '—'}"
                        + (
                            " • dúvida"
                            if tentativa[
                                "duvida"
                            ]
                            else ""
                        )
                    )
                )

            bloco_questoes = (
                "\n".join(
                    linhas_questoes
                )
                if linhas_questoes
                else "Nenhuma tentativa vinculada."
            )

            self.detalhes.setPlainText(
                "ORIGEM\n"
                "──────\n"
                "Questões internas\n\n"
                "CONFIANÇA\n"
                "─────────\n"
                f"{confianca_texto}\n\n"
                "QUESTÕES QUE FORMARAM A REVISÃO\n"
                "───────────────────────────────\n"
                f"{bloco_questoes}\n\n"
                "OBSERVAÇÃO\n"
                "──────────\n"
                f"{observacao}"
            )
        else:
            self.detalhes.setPlainText(
                "ORIGEM\n"
                "──────\n"
                "Registro manual\n\n"
                "OBSERVAÇÃO\n"
                "──────────\n"
                f"{observacao}\n\n"
                "TEXTO DE ERROS\n"
                "──────────────\n"
                f"{texto_erros}\n\n"
                "CONTINUAÇÃO\n"
                "───────────\n"
                f"{continuacao}"
            )

        self.atualizar_estado_botoes()




class ConfiguradorEstudoIntegrado(JanelaEstudoTopico):
    """E03: reutiliza o configurador original dentro da aba Estudar.

    `confirmar()` e a montagem da fila são herdados integralmente. A única
    adaptação é a saída da interface: confirmar inicia o resolvedor pelo
    controlador da Central; cancelar volta às escolhas, sem fechar a Central.
    """

    def __init__(self, central):
        self._central_integrada = central
        super().__init__(central.topico_id, central.nome_topico, central)
        # QDialog é usado como QWidget embutido; não cria janela independente.
        self.setWindowFlags(Qt.Widget)
        self.setWindowModality(Qt.NonModal)
        self.setMinimumSize(0, 0)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        self.setObjectName("centralEstudoConfigurador")
        self.setAccessibleName("Configuração de bateria dentro da Central do Tópico")
        cancelar = self.findChild(QDialogButtonBox)
        if cancelar is not None:
            botao = cancelar.button(QDialogButtonBox.Cancel)
            if botao is not None:
                botao.setText("Voltar às modalidades")
                botao.setToolTip("Voltar sem perder o tópico selecionado.")

    def accept(self):
        # super().confirmar() já validou e criou, se necessário, o ciclo.
        # Não aceitar o QDialog (o que fecharia o widget embutido).
        if self.configuracao and self.configuracao.get("fila"):
            self._central_integrada._executar_bateria_estudo_e03(self.configuracao)

    def reject(self):
        self._central_integrada._voltar_modalidades_estudo_e03()


class VisualizadorQuestaoIntegrado(JanelaVisualizarQuestao):
    """E04: mostra a visualização original dentro da aba Questões."""

    def __init__(self, questao_id, central):
        self._central_integrada_e04 = central
        super().__init__(questao_id=questao_id, parent=central)
        self.setWindowFlags(Qt.Widget)
        self.setWindowModality(Qt.NonModal)
        self.setMinimumSize(0, 0)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        self.setObjectName("centralQuestoesVisualizadorE04")
        self.setAccessibleName("Visualização de questão na Central do Tópico")
        # O botão Fechar já existia no visualizador e agora equivale a Voltar.
        for botoes in self.findChildren(QDialogButtonBox):
            botao = botoes.button(QDialogButtonBox.Close)
            if botao is not None:
                botao.setText("Voltar à lista")
                botao.setToolTip("Voltar à lista de questões do tópico.")

    def reject(self):
        self._central_integrada_e04._voltar_lista_questoes_e04()


class FormularioRevisaoIntegrado(JanelaRevisao):
    """E04: formulário original de revisão manual, sem nova janela."""

    def __init__(self, central, revisao=None):
        self._central_integrada_e04 = central
        super().__init__(
            central.topico_id,
            central.nome_topico,
            central,
            revisao=revisao,
            modo_edicao=revisao is not None,
        )
        self.setWindowFlags(Qt.Widget)
        self.setWindowModality(Qt.NonModal)
        self.setMinimumSize(0, 0)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        self.setObjectName("centralFormularioRevisaoE04")
        self.setAccessibleName(
            "Editar registro externo" if revisao is not None
            else "Registrar revisão realizada fora do VighnaStudy"
        )
        for botoes in self.findChildren(QDialogButtonBox):
            cancelar = botoes.button(QDialogButtonBox.Cancel)
            if cancelar is not None:
                cancelar.setText("Voltar ao histórico")
                cancelar.setToolTip("Cancelar sem registrar alterações.")

    def accept(self):
        # JanelaRevisao.salvar() continua responsável por validar e persistir.
        self._central_integrada_e04._revisao_salva_e04()

    def reject(self):
        self._central_integrada_e04._fechar_formulario_revisao_e04()


class CentralIntegradaTopico(JanelaTopico):
    """E04 — central com Questões e Histórico integrados aos fluxos existentes.

    Consultas do banco permanecem em listar_questoes; inclusão/edição oficial
    continua no gestor do banco. Registro externo reutiliza JanelaRevisao.
    """

    _ABAS = {"resumo": 0, "estudar": 1, "questoes": 2, "historico": 3}

    def __init__(
        self, topico_id, nome_topico, parent=None,
        aba_inicial="resumo", capitulo_nome=None, capitulo_id=None,
    ):
        super().__init__(topico_id, nome_topico, parent)
        self._capitulo_id_contexto_e03 = (
            int(capitulo_id) if capitulo_id is not None else None
        )
        self.setObjectName("centralIntegradaTopico")
        self.setWindowTitle(f"Central Integrada — {self.nome_topico}")

        # O painel legado ja possui um QTabWidget com Resumo e Historico.
        # Estender o mesmo widget evita reconstruir diagnostico/revisoes.
        self.topico_tabs.setTabText(0, "Resumo")
        self.topico_tabs.insertTab(
            1,
            self._criar_secao_estudar_e03(),
            "Estudar",
        )
        self.topico_tabs.insertTab(
            2, self._criar_secao_questoes_e04(), "Questões"
        )
        self.topico_tabs.setTabText(3, "Histórico")
        self._preparar_historico_e04()
        self.topico_tabs.currentChanged.connect(self._aba_alterada_e04)
        self.topico_tabs.tabBar().show()
        self.topico_tabs.setDocumentMode(True)

        # Na janela antiga o atalho de Historico apontava para a aba 1.
        # Em E01 Historico passa a ser a aba 3.
        self.proximo_historico_btn.clicked.disconnect()
        self.proximo_historico_btn.clicked.connect(
            lambda: self.selecionar_secao("historico")
        )

        # O cabeçalho usava atalhos que abriam novas janelas. Os metodos
        # agora navegam pelas secoes internas. As acoes ja estao nas abas.
        self.botao_estudar_topico.hide()
        self.botao_ver_questoes_topico.hide()

        if capitulo_nome:
            aviso = QLabel(
                "Capítulo selecionado: " + str(capitulo_nome) + " — "
                "o diagnóstico continua referente ao tópico principal. "
                "Em Estudar, a bateria personalizada usa o capítulo selecionado "
                "quando existem questões vinculadas a ele."
            )
            aviso.setObjectName("centralIntegradaAvisoCapitulo")
            aviso.setWordWrap(True)
            self.layout().insertWidget(1, aviso)

        # E02: Resumo torna-se uma página autocontida. O quadro Domínio/Agenda
        # é MOVIMENTADO, não recriado, preservando todos os sinais e os dados.
        self._organizar_resumo_e02()
        self._aplicar_estilo_navegacao()
        # E05: identidade visual, foco e navegacao; nenhuma regra de estudo.
        self._configurar_ergonomia_e05()
        self.selecionar_secao(aba_inicial)

    @staticmethod
    def _filtrar_dados_questoes_e04(dados, topico_id, busca="", status="Todas",
                                    capitulo_id=None):
        """Filtro apenas em memória, sem gravações ou alterações de questões."""
        texto = unicodedata.normalize("NFKD", str(busca or "")).casefold()
        texto = "".join(c for c in texto if not unicodedata.combining(c))
        termos = texto.split()
        filtrados = []
        for questao in dados:
            if str(questao.get("topico_id")) != str(topico_id):
                continue
            ativa = bool(questao.get("ativa", True))
            if status == "Ativas" and not ativa:
                continue
            if status == "Arquivadas" and ativa:
                continue
            if capitulo_id is not None and str(questao.get("capitulo_id")) != str(capitulo_id):
                continue
            if termos:
                alvo = " ".join(str(questao.get(k) or "") for k in (
                    "id", "enunciado", "capitulo", "banca", "ano", "fonte", "dificuldade",
                ))
                alvo = unicodedata.normalize("NFKD", alvo).casefold()
                alvo = "".join(c for c in alvo if not unicodedata.combining(c))
                if not all(t in alvo for t in termos):
                    continue
            filtrados.append(questao)
        return filtrados

    def _criar_secao_questoes_e04(self):
        pagina = QWidget(self.topico_tabs)
        pagina.setObjectName("centralQuestoesPaginaE04")
        layout = QVBoxLayout(pagina)
        layout.setContentsMargins(12, 12, 12, 12)
        layout.setSpacing(10)
        self._questoes_pilha_e04 = QStackedWidget(pagina)
        layout.addWidget(self._questoes_pilha_e04, 1)
        lista = QWidget(pagina)
        lista.setObjectName("centralQuestoesListaE04")
        interno = QVBoxLayout(lista)
        interno.setContentsMargins(6, 4, 6, 6)
        interno.setSpacing(8)
        titulo = QLabel("QUESTÕES DO TÓPICO")
        titulo.setObjectName("centralIntegradaSecaoTitulo")
        interno.addWidget(titulo)
        descricao = QLabel(
            "Consulte questões, capítulos e gabaritos nesta janela. "
            "Edição, importação e administração avançada continuam no banco oficial."
        )
        descricao.setWordWrap(True)
        descricao.setObjectName("centralIntegradaSecaoDescricao")
        interno.addWidget(descricao)
        filtros = QHBoxLayout()
        filtros.setSpacing(8)
        self._questoes_busca_e04 = QLineEdit(lista)
        self._questoes_busca_e04.setObjectName("centralQuestoesBuscaE04")
        self._questoes_busca_e04.setPlaceholderText("Filtrar por enunciado, ID, banca ou capítulo...")
        self._questoes_busca_e04.setClearButtonEnabled(True)
        self._questoes_busca_e04.textChanged.connect(self._preencher_questoes_e04)
        filtros.addWidget(self._questoes_busca_e04, 1)
        self._questoes_status_e04 = QComboBox(lista)
        self._questoes_status_e04.addItems(["Todas", "Ativas", "Arquivadas"])
        self._questoes_status_e04.currentTextChanged.connect(self._preencher_questoes_e04)
        self._questoes_status_e04.setToolTip("Filtrar questões ativas ou arquivadas.")
        filtros.addWidget(self._questoes_status_e04)
        self._questoes_apenas_capitulo_e04 = QCheckBox("Somente capítulo selecionado", lista)
        self._questoes_apenas_capitulo_e04.setVisible(self._capitulo_id_contexto_e03 is not None)
        self._questoes_apenas_capitulo_e04.setChecked(self._capitulo_id_contexto_e03 is not None)
        self._questoes_apenas_capitulo_e04.toggled.connect(self._preencher_questoes_e04)
        filtros.addWidget(self._questoes_apenas_capitulo_e04)
        interno.addLayout(filtros)
        self._questoes_contador_e04 = QLabel("Questões ainda não consultadas")
        self._questoes_contador_e04.setObjectName("centralQuestoesContadorE04")
        interno.addWidget(self._questoes_contador_e04)
        self._questoes_tabela_e04 = QTableWidget(lista)
        self._questoes_tabela_e04.setObjectName("centralQuestoesTabelaE04")
        self._questoes_tabela_e04.setColumnCount(6)
        self._questoes_tabela_e04.setHorizontalHeaderLabels([
            "ID", "Enunciado", "Capítulo", "Banca", "Ano", "Situação",
        ])
        self._questoes_tabela_e04.setSelectionBehavior(QAbstractItemView.SelectRows)
        self._questoes_tabela_e04.setSelectionMode(QAbstractItemView.SingleSelection)
        self._questoes_tabela_e04.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self._questoes_tabela_e04.setAlternatingRowColors(True)
        self._questoes_tabela_e04.setShowGrid(False)
        self._questoes_tabela_e04.verticalHeader().setVisible(False)
        colunas = self._questoes_tabela_e04.horizontalHeader()
        colunas.setSectionResizeMode(1, QHeaderView.Stretch)
        for col in (0, 2, 3, 4, 5):
            colunas.setSectionResizeMode(col, QHeaderView.ResizeToContents)
        self._questoes_tabela_e04.itemDoubleClicked.connect(self._visualizar_questao_e04)
        interno.addWidget(self._questoes_tabela_e04, 1)
        rodape = QHBoxLayout()
        instrucoes = QLabel("Duplo clique em uma questão para visualizar enunciado e alternativas.")
        instrucoes.setObjectName("centralIntegradaSecaoDescricao")
        rodape.addWidget(instrucoes, 1)
        self._questoes_ver_e04 = QPushButton("Visualizar selecionada")
        self._questoes_ver_e04.setObjectName("centralIntegradaAcaoBotao")
        self._questoes_ver_e04.clicked.connect(self._visualizar_questao_e04)
        rodape.addWidget(self._questoes_ver_e04)
        self._questoes_gerenciar_e04 = QPushButton("Gerenciar no banco")
        self._questoes_gerenciar_e04.setObjectName("centralIntegradaAcaoBotao")
        self._questoes_gerenciar_e04.setToolTip(
            "Abrir a Central de Questões oficial para edição, cadastro e importação."
        )
        self._questoes_gerenciar_e04.clicked.connect(self._abrir_questoes_legadas)
        rodape.addWidget(self._questoes_gerenciar_e04)
        interno.addLayout(rodape)
        self._questoes_pilha_e04.addWidget(lista)
        self._questoes_visualizador_e04 = None
        self._questoes_dados_e04 = []
        self._questoes_dados_filtrados_e04 = []
        self._questoes_carregadas_e04 = False
        return pagina

    def _aba_alterada_e04(self, indice):
        if indice == self._ABAS["questoes"]:
            self._carregar_questoes_e04()
        elif indice == self._ABAS["historico"]:
            self.carregar_historico()

    def _carregar_questoes_e04(self):
        """Catálogo real. Nunca modifica o banco nem o estado das questões."""
        concurso_id = obter_concurso_ativo()[0]
        dados = listar_questoes(
            concurso_id,
            incluir_inativas=True,
            incluir_topicos_pausados=True,
            incluir_disciplinas_pausadas=True,
        )
        self._questoes_dados_e04 = [
            q for q in dados if str(q.get("topico_id")) == str(self.topico_id)
        ]
        self._questoes_carregadas_e04 = True
        self._preencher_questoes_e04()

    def _preencher_questoes_e04(self, *_args):
        if not self._questoes_carregadas_e04:
            return
        cap = (self._capitulo_id_contexto_e03
               if self._questoes_apenas_capitulo_e04.isChecked() else None)
        itens = self._filtrar_dados_questoes_e04(
            self._questoes_dados_e04,
            self.topico_id,
            self._questoes_busca_e04.text(),
            self._questoes_status_e04.currentText(), cap,
        )
        self._questoes_dados_filtrados_e04 = itens
        LIMITE_LINHAS = 250
        visiveis = itens[:LIMITE_LINHAS]
        n = len(itens)
        total = len(self._questoes_dados_e04)
        sufixo = (f" · mostrando {LIMITE_LINHAS} primeiras; refine a busca"
                   if n > LIMITE_LINHAS else "")
        self._questoes_contador_e04.setText(
            f"{n} questão(ões) no filtro · {total} no tópico{sufixo}"
        )
        tabela = self._questoes_tabela_e04
        tabela.setUpdatesEnabled(False)
        try:
            tabela.setRowCount(len(visiveis))
            for linha, questao in enumerate(visiveis):
                enunciado = " ".join(str(questao.get("enunciado") or "").split())
                valores = [
                    str(questao.get("id") or "—"),
                    enunciado,
                    str(questao.get("capitulo") or "—"),
                    str(questao.get("banca") or "—"),
                    str(questao.get("ano") or "—"),
                    "Ativa" if questao.get("ativa", True) else "Arquivada",
                ]
                for coluna, valor in enumerate(valores):
                    item = QTableWidgetItem(valor)
                    item.setFlags(Qt.ItemIsEnabled | Qt.ItemIsSelectable)
                    item.setData(Qt.UserRole, questao.get("id"))
                    if coluna == 1:
                        item.setToolTip(enunciado)
                    if coluna in (0, 4, 5):
                        item.setTextAlignment(Qt.AlignCenter)
                    tabela.setItem(linha, coluna, item)
                tabela.setRowHeight(linha, 33)
        finally:
            tabela.setUpdatesEnabled(True)
        if visiveis:
            tabela.setCurrentCell(0, 0)
        else:
            tabela.clearSelection()
        self._questoes_ver_e04.setEnabled(bool(visiveis))

    def _visualizar_questao_e04(self, *_args):
        linha = self._questoes_tabela_e04.currentRow()
        if linha < 0:
            return
        item = self._questoes_tabela_e04.item(linha, 0)
        if item is None or item.data(Qt.UserRole) is None:
            return
        questao_id = int(item.data(Qt.UserRole))
        if self._questoes_visualizador_e04 is not None:
            anterior = self._questoes_visualizador_e04
            self._questoes_pilha_e04.removeWidget(anterior)
            anterior.deleteLater()
        pagina_visual = QWidget(self._questoes_pilha_e04)
        pagina_visual.setObjectName("centralQuestoesDetalheE04")
        layout = QVBoxLayout(pagina_visual)
        layout.setContentsMargins(5, 5, 5, 5)
        voltar = QPushButton("← Voltar à lista")
        voltar.setObjectName("centralIntegradaAcaoBotao")
        voltar.clicked.connect(self._voltar_lista_questoes_e04)
        layout.addWidget(voltar, 0, Qt.AlignLeft)
        visor = VisualizadorQuestaoIntegrado(questao_id, self)
        # O visor original possui seu botão Fechar. Nesta integração a
        # navegação superior permanece acessível mesmo se a questão sumiu.
        for barra in visor.findChildren(QDialogButtonBox):
            barra.hide()
        layout.addWidget(visor, 1)
        self._questoes_visualizador_e04 = pagina_visual
        self._questoes_pilha_e04.addWidget(pagina_visual)
        self._questoes_pilha_e04.setCurrentWidget(pagina_visual)

    def _voltar_lista_questoes_e04(self):
        self._questoes_pilha_e04.setCurrentIndex(0)
        anterior = self._questoes_visualizador_e04
        self._questoes_visualizador_e04 = None
        if anterior is not None:
            self._questoes_pilha_e04.removeWidget(anterior)
            anterior.deleteLater()

    def _preparar_historico_e04(self):
        """Usa a mesma página/gráfico/tabela do histórico original."""
        existente = self.topico_tabs.widget(self._ABAS["historico"])
        self.topico_tabs.removeTab(self._ABAS["historico"])
        self._historico_pilha_e04 = QStackedWidget(self.topico_tabs)
        self._historico_pagina_original_e04 = existente
        self._historico_pilha_e04.addWidget(existente)
        self.topico_tabs.insertTab(self._ABAS["historico"], self._historico_pilha_e04, "Histórico")
        self._historico_formulario_e04 = None
        # Todos os comandos que já chamavam nova_revisao / editar_revisao
        # passam a abrir o formulário na própria aba, via métodos sobrescritos.
        for botao in existente.findChildren(QPushButton):
            if botao.text() == "Registrar revisão manual":
                botao.setText("Registrar revisão externa")
                botao.setToolTip("Adicionar sessão feita fora do VighnaStudy.")
            elif botao.text() == "Registrar revisão":
                botao.setText("Registrar estudo externo")
        self._historico_pilha_e04.setCurrentIndex(0)

    def _mostrar_formulario_revisao_e04(self, revisao=None):
        if self._historico_formulario_e04 is not None:
            self._fechar_formulario_revisao_e04()
        formulario = FormularioRevisaoIntegrado(self, revisao=revisao)
        self._historico_formulario_e04 = formulario
        self._historico_pilha_e04.addWidget(formulario)
        self.selecionar_secao("historico")
        self._historico_pilha_e04.setCurrentWidget(formulario)

    def nova_revisao(self):
        self._mostrar_formulario_revisao_e04()

    def editar_revisao(self):
        linha = self.tabela.currentRow()
        if linha < 0 or linha >= len(self.dados_revisoes):
            return
        revisao = self.dados_revisoes[linha]
        if len(revisao) > 8 and revisao[8] == "questoes_internas":
            QMessageBox.information(
                self, "Revisão automática",
                "As respostas internas são preservadas no histórico. "
                "Somente registros manuais podem ser editados neste formulário.",
            )
            return
        self._mostrar_formulario_revisao_e04(revisao=revisao)

    def _revisao_salva_e04(self):
        # O persistir real já foi feito em JanelaRevisao.salvar(), sem duplicação.
        _notificar_dados_alterados_raiz(self, "revisoes")
        self.carregar_historico()
        self._fechar_formulario_revisao_e04()

    def _fechar_formulario_revisao_e04(self):
        self._historico_pilha_e04.setCurrentIndex(0)
        anterior = self._historico_formulario_e04
        self._historico_formulario_e04 = None
        if anterior is not None:
            self._historico_pilha_e04.removeWidget(anterior)
            anterior.deleteLater()

    def _criar_secao_estudar_e03(self):
        """E03: hub + configurador nativo, sem duplicar decisões de montagem."""
        pagina = QWidget(self.topico_tabs)
        pagina.setObjectName("centralEstudoPagina")
        layout = QVBoxLayout(pagina)
        layout.setContentsMargins(10, 12, 10, 12)
        layout.setSpacing(9)

        self._estudo_pilha_e03 = QStackedWidget(pagina)
        layout.addWidget(self._estudo_pilha_e03, 1)

        escolhas = QWidget(pagina)
        escolhas.setObjectName("centralEstudoEscolhas")
        escolhas_layout = QVBoxLayout(escolhas)
        escolhas_layout.setContentsMargins(12, 11, 12, 11)
        escolhas_layout.setSpacing(11)

        cabecalho = QLabel("ESCOLHA COMO ESTUDAR")
        cabecalho.setObjectName("centralIntegradaSecaoTitulo")
        escolhas_layout.addWidget(cabecalho)
        explicacao = QLabel(
            "Revisão orientada pela agenda ou montagem de bateria com filtros "
            "e acompanhamento de ciclos, sem sair desta Central."
        )
        explicacao.setWordWrap(True)
        explicacao.setObjectName("centralIntegradaSecaoDescricao")
        escolhas_layout.addWidget(explicacao)

        self._estudo_status_e03 = QLabel("")
        self._estudo_status_e03.setWordWrap(True)
        self._estudo_status_e03.setObjectName("centralEstudoStatus")
        escolhas_layout.addWidget(self._estudo_status_e03)

        def acao(titulo, descricao, callback, nome_objeto):
            quadro = QFrame(escolhas)
            quadro.setObjectName("centralIntegradaAcao")
            horizontal = QHBoxLayout(quadro)
            horizontal.setContentsMargins(15, 12, 15, 12)
            horizontal.setSpacing(13)
            texto = QLabel(descricao)
            texto.setObjectName("centralIntegradaAcaoTexto")
            texto.setWordWrap(True)
            botao = QPushButton(titulo)
            botao.setObjectName("centralIntegradaAcaoBotao")
            botao.setMinimumHeight(36)
            botao.setMinimumWidth(220)
            botao.setAccessibleName(titulo)
            botao.clicked.connect(callback)
            horizontal.addWidget(texto, 1)
            horizontal.addWidget(botao)
            escolhas_layout.addWidget(quadro)
            return botao

        self._estudo_revisao_btn_e03 = acao(
            "Revisão inteligente",
            "Usa a revisão programada e o resolvedor Vighna. "
            "As respostas são registradas pelo aplicativo.",
            self._revisao_inteligente_e03,
            "centralEstudoRevisao",
        )
        self._estudo_personalizar_btn_e03 = acao(
            "Bateria personalizada",
            "Quantidade, capítulo, dificuldade, histórico e seleção manual. "
            "O configurador completo funciona nesta mesma janela.",
            lambda: self._mostrar_configurador_estudo_e03("avulsa"),
            "centralEstudoPersonalizar",
        )
        self._estudo_continuar_btn_e03 = acao(
            "Continuar ciclo",
            "Retoma apenas as questões pendentes do ciclo registrado. "
            "Os filtros originais do ciclo ficam protegidos.",
            lambda: self._mostrar_configurador_estudo_e03("continuar"),
            "centralEstudoContinuar",
        )
        escolhas_layout.addStretch(1)
        self._estudo_pilha_e03.addWidget(escolhas)

        # Área interna com rolagem própria para não ampliar toda a Central.
        self._estudo_scroll_e03 = QScrollArea(pagina)
        self._estudo_scroll_e03.setObjectName("centralEstudoScroll")
        self._estudo_scroll_e03.setWidgetResizable(True)
        self._estudo_scroll_e03.setFrameShape(QFrame.NoFrame)
        self._estudo_pilha_e03.addWidget(self._estudo_scroll_e03)
        self._estudo_configurador_e03 = None
        self._estudo_pilha_e03.setCurrentIndex(0)
        self._atualizar_status_estudo_e03()
        return pagina

    def _atualizar_status_estudo_e03(self):
        """Consulta apenas o estado existente; não inicia nem altera ciclos."""
        pausado = topico_esta_pausado(self.topico_id)
        try:
            ciclo = obter_ciclo_questoes_ativo(
                obter_concurso_ativo()[0], self.topico_id,
            )
        except Exception:
            ciclo = None
        pendentes = int(ciclo.get("pendentes") or 0) if ciclo else 0
        self._estudo_revisao_btn_e03.setEnabled(not pausado)
        self._estudo_personalizar_btn_e03.setEnabled(not pausado)
        self._estudo_continuar_btn_e03.setEnabled(not pausado and pendentes > 0)
        if pausado:
            mensagem = "Tópico desligado. Reative-o para iniciar uma sessão de questões."
        elif pendentes:
            mensagem = f"Ciclo em andamento: {pendentes} questão(ões) pendente(s)."
        else:
            mensagem = "Nenhum ciclo pendente. Uma bateria personalizada pode iniciar um novo ciclo."
        self._estudo_status_e03.setText(mensagem)
        self._estudo_continuar_btn_e03.setToolTip(
            "Continue o ciclo existente com seus filtros congelados."
            if pendentes else "Nenhum ciclo com questões pendentes para este tópico."
        )

    def _mostrar_configurador_estudo_e03(self, preferir="avulsa"):
        if topico_esta_pausado(self.topico_id):
            QMessageBox.information(
                self, "Tópico desligado", "Reative o tópico antes de estudar."
            )
            return
        if self._estudo_configurador_e03 is None:
            self._estudo_configurador_e03 = ConfiguradorEstudoIntegrado(self)
            self._estudo_scroll_e03.setWidget(self._estudo_configurador_e03)
        configurador = self._estudo_configurador_e03
        configurador.recarregar_ciclo_ui(preferir=preferir)
        if preferir == "continuar":
            if configurador.ciclo_modo.currentData() != "continuar":
                self._atualizar_status_estudo_e03()
                QMessageBox.information(
                    self, "Continuar ciclo",
                    "Não existe um ciclo com questões pendentes."
                )
                return
        elif self._capitulo_id_contexto_e03 is not None:
            idx = configurador.capitulo.findData(self._capitulo_id_contexto_e03)
            if idx >= 0:
                configurador.capitulo.setCurrentIndex(idx)
            else:
                QMessageBox.information(
                    self, "Capítulo sem questões",
                    "Este capítulo não possui questões disponíveis para a bateria. "
                    "O filtro permanecerá em todos os capítulos."
                )
        configurador.atualizar_lista()
        self._estudo_pilha_e03.setCurrentIndex(1)
        self._estudo_scroll_e03.verticalScrollBar().setValue(0)

    def _voltar_modalidades_estudo_e03(self):
        self._estudo_pilha_e03.setCurrentIndex(0)
        self._atualizar_status_estudo_e03()

    def _revisao_inteligente_e03(self):
        if topico_esta_pausado(self.topico_id):
            QMessageBox.information(
                self, "Tópico desligado", "Reative o tópico antes de estudar."
            )
            return
        JanelaTopico.revisar_topico(self)
        self._atualizar_status_estudo_e03()

    def _executar_bateria_estudo_e03(self, configuracao):
        """Usa a MESMA configuração/fila do configurador nativo."""
        if topico_esta_pausado(self.topico_id):
            QMessageBox.information(
                self, "Tópico desligado", "Reative o tópico antes de estudar."
            )
            return
        if not configuracao or not configuracao.get("fila"):
            return
        resolvedor = JanelaResolverQuestoes(configuracao, self)
        resolvedor.exec_nao_modal()
        self.carregar_historico()
        # Adiar a destruição do widget emissor até o retorno do slot confirmar.
        QTimer.singleShot(0, self._recarregar_estudo_apos_sessao_e03)

    def _recarregar_estudo_apos_sessao_e03(self):
        widget = self._estudo_scroll_e03.takeWidget()
        self._estudo_configurador_e03 = None
        if widget is not None:
            widget.deleteLater()
        self._voltar_modalidades_estudo_e03()

    def _organizar_resumo_e02(self):
        """E02 — isolamento visual de Domínio, Agenda, Diagnóstico e Evidências.

        Não consulta dados e não reimplementa os cálculos da JanelaTopico.
        Move o MESMO quadro da janela herdada para o scroll Resumo.
        Assim o quadro não ocupa área nas demais abas e nenhuma conexão Qt
        (inclusive Revisar agora) é refeita ou desconectada.
        """
        pagina = self.topico_tabs.widget(self._ABAS["resumo"])
        if not isinstance(pagina, QScrollArea):
            raise RuntimeError("E02: aba Resumo não é uma área de rolagem")
        conteudo = pagina.widget()
        if conteudo is None or conteudo.layout() is None:
            raise RuntimeError("E02: conteúdo da aba Resumo indisponível")
        miolo = conteudo.layout()
        quadro = self.findChild(QFrame, "topicSummaryCard")
        if quadro is None:
            raise RuntimeError("E02: quadro Domínio/Agenda não encontrado")

        # O quadro está originalmente no QVBoxLayout da janela, acima das
        # abas. Reparentar após removê-lo garante um único dono visual.
        self.layout().removeWidget(quadro)
        quadro.setParent(conteudo)

        faixa = QFrame(conteudo)
        faixa.setObjectName("centralResumoIntroducao")
        faixa_layout = QVBoxLayout(faixa)
        faixa_layout.setContentsMargins(13, 9, 13, 9)
        faixa_layout.setSpacing(3)
        titulo = QLabel("RESUMO DO TÓPICO")
        titulo.setObjectName("centralResumoTitulo")
        descricao = QLabel(
            "Domínio, próxima revisão, diagnóstico e evidências reunidos em uma única visão."
        )
        descricao.setObjectName("centralResumoDescricao")
        descricao.setWordWrap(True)
        faixa_layout.addWidget(titulo)
        faixa_layout.addWidget(descricao)
        miolo.insertWidget(0, faixa)
        miolo.insertWidget(1, quadro)

        # Ações já existentes e conectadas pela JanelaTopico.
        self.proximo_revisar_btn.setText("Iniciar revisão por questões")
        self.proximo_revisar_btn.setToolTip(
            "Abre o resolvedor interno para uma revisão do tópico. "
            "As respostas da sessão são registradas conforme as regras do Vighna."
        )
        self.proximo_historico_btn.setText("Histórico e registros  →")
        self.proximo_historico_btn.setToolTip(
            "Ver a evolução e registrar uma revisão realizada fora do aplicativo."
        )

        # Orientação curta para evitar duplicidade de registros; o registro
        # manual continua na seção Histórico (fluxo herdado, sem alterações).
        informativo = QFrame(conteudo)
        informativo.setObjectName("centralResumoInformativo")
        informativo_l = QHBoxLayout(informativo)
        informativo_l.setContentsMargins(14, 9, 14, 9)
        informativo_l.setSpacing(14)
        aviso = QLabel(
            "Respostas feitas pelo resolvedor do Vighna alimentam o histórico. "
            "Para registrar estudos realizados fora do aplicativo, utilize Histórico."
        )
        aviso.setObjectName("centralResumoNota")
        aviso.setWordWrap(True)
        aviso.setAccessibleName("Orientação sobre registros de estudo")
        informativo_l.addWidget(aviso, 1)
        abrir_estudo = QPushButton("Configurar estudo")
        abrir_estudo.setObjectName("centralResumoAbrirEstudo")
        abrir_estudo.setMinimumHeight(33)
        abrir_estudo.setToolTip("Ir à seção Estudar sem abrir outra janela.")
        abrir_estudo.clicked.connect(self.estudar_topico)
        informativo_l.addWidget(abrir_estudo, 0)
        # Inserir antes do stretch final originalmente criado em Resumo.
        miolo.insertWidget(max(0, miolo.count() - 1), informativo)

        pagina.verticalScrollBar().setValue(0)

    def _criar_secao_transicao(self, titulo, descricao, acoes):
        pagina = QWidget(self.topico_tabs)
        pagina.setObjectName("centralIntegradaSecao")
        pagina_layout = QVBoxLayout(pagina)
        pagina_layout.setContentsMargins(22, 24, 22, 20)
        pagina_layout.setSpacing(13)
        titulo_label = QLabel(titulo)
        titulo_label.setObjectName("centralIntegradaSecaoTitulo")
        pagina_layout.addWidget(titulo_label)
        descricao_label = QLabel(descricao)
        descricao_label.setObjectName("centralIntegradaSecaoDescricao")
        descricao_label.setWordWrap(True)
        pagina_layout.addWidget(descricao_label)
        for nome, ajuda, callback in acoes:
            cartao = QFrame(pagina)
            cartao.setObjectName("centralIntegradaAcao")
            cartao_layout = QHBoxLayout(cartao)
            cartao_layout.setContentsMargins(14, 12, 14, 12)
            cartao_layout.setSpacing(14)
            texto = QLabel(ajuda)
            texto.setObjectName("centralIntegradaAcaoTexto")
            texto.setWordWrap(True)
            botao = QPushButton(nome)
            botao.setObjectName("centralIntegradaAcaoBotao")
            botao.setMinimumWidth(230)
            botao.setMinimumHeight(36)
            botao.clicked.connect(callback)
            if nome == "Configurar bateria de questões" and topico_esta_pausado(self.topico_id):
                botao.setEnabled(False)
                botao.setToolTip("Reative o tópico antes de estudar.")
            cartao_layout.addWidget(texto, 1)
            cartao_layout.addWidget(botao, 0)
            pagina_layout.addWidget(cartao)
        pagina_layout.addStretch(1)
        return pagina

    def _configurar_ergonomia_e05(self):
        """E05: somente ergonomia e apresentacao da Central Integrada.

        Atalhos tem escopo da janela e nao alteram a selecao de questoes,
        dados persistentes, sequencia de revisao ou regras do configurador.
        """
        aba = self.topico_tabs.tabBar()
        aba.setAccessibleName("Navegação da Central Integrada do Tópico")
        aba.setFocusPolicy(Qt.StrongFocus)
        aba.setExpanding(True)
        aba.setUsesScrollButtons(False)
        aba.setElideMode(Qt.ElideRight)
        descricoes = {
            "resumo": "Domínio, diagnóstico, agenda e próxima revisão",
            "estudar": "Revisão inteligente, bateria personalizada e ciclos",
            "questoes": "Pesquisa, consulta e visualização de questões",
            "historico": "Evolução, registros e revisões externas",
        }
        self._central_atalhos_e05 = []
        for numero, secao in enumerate(("resumo", "estudar", "questoes", "historico"), 1):
            indice = self._ABAS[secao]
            self.topico_tabs.setTabToolTip(
                indice, f"Alt+{numero} · {descricoes[secao]}"
            )
            atalho = QShortcut(QKeySequence(f"Alt+{numero}"), self)
            atalho.setContext(Qt.WidgetWithChildrenShortcut)
            atalho.activated.connect(
                lambda destino=secao: self.selecionar_secao(destino)
            )
            self._central_atalhos_e05.append(atalho)

        localizar = QShortcut(QKeySequence("Ctrl+F"), self)
        localizar.setContext(Qt.WidgetWithChildrenShortcut)
        localizar.activated.connect(self._focar_busca_questoes_e05)
        self._central_atalhos_e05.append(localizar)

        self._questoes_busca_e04.setMinimumHeight(34)
        self._questoes_busca_e04.setAccessibleName("Pesquisar questões do tópico")
        self._questoes_busca_e04.setAccessibleDescription(
            "Pesquisa pelo enunciado, identificação, banca ou capítulo. "
            "Use Ctrl+F em qualquer aba para acessar este campo."
        )
        self._questoes_status_e04.setMinimumHeight(34)
        self._questoes_status_e04.setAccessibleName("Filtrar situação das questões")
        self._questoes_tabela_e04.setAccessibleName("Questões vinculadas ao tópico")
        self._questoes_tabela_e04.setAlternatingRowColors(True)
        self._questoes_tabela_e04.setHorizontalScrollMode(
            QAbstractItemView.ScrollPerPixel
        )
        self._questoes_tabela_e04.setVerticalScrollMode(
            QAbstractItemView.ScrollPerPixel
        )
        self._questoes_tabela_e04.setTabKeyNavigation(False)
        self._questoes_tabela_e04.setFocusPolicy(Qt.StrongFocus)
        self._questoes_ver_e04.setToolTip(
            "Visualizar a questão selecionada sem sair da Central."
        )
        self._questoes_ver_e04.setAccessibleName("Visualizar questão selecionada")
        self._estudo_pilha_e03.setAccessibleName(
            "Modalidades de estudo e configurador de bateria"
        )
        self._estudo_status_e03.setAccessibleName("Situação do ciclo de estudo")
        self._historico_pilha_e04.setAccessibleName(
            "Histórico de revisões e formulário de registro externo"
        )
        for controle in (
            self._estudo_revisao_btn_e03, self._estudo_personalizar_btn_e03,
            self._estudo_continuar_btn_e03, self._questoes_ver_e04,
            self._questoes_gerenciar_e04,
        ):
            controle.setCursor(Qt.PointingHandCursor)
        self._aplicar_identidade_visual_e05()

    def _focar_busca_questoes_e05(self):
        """Ctrl+F local: filtra as questões sem modificar o estado de estudo."""
        self.selecionar_secao("questoes")
        # Uma visualizacao detalhada nao deve esconder o campo de pesquisa.
        if self._questoes_pilha_e04.currentIndex() != 0:
            self._voltar_lista_questoes_e04()
        self._questoes_busca_e04.setFocus(Qt.ShortcutFocusReason)
        self._questoes_busca_e04.selectAll()

    def _aplicar_identidade_visual_e05(self):
        """Paleta local ciano/dourado com baixo brilho, sem timer ou animacao."""
        raiz = self.parentWidget()
        tema = normalizar_tema(getattr(raiz, "tema_atual", "futurista"))
        paletas = {
            "futurista": {
                "fundo": "#071A2A", "superficie": "#102B40", "cartao": "#12354B",
                "borda": "#244B62", "hover": "#1A4259", "ciano": "#36D5EA",
                "ouro": "#E4B963", "texto": "#EAF6FF", "muted": "#A6C3D4",
                "selecionado": "#17435A", "linha": "#0C2638",
            },
            "escuro": {
                "fundo": "#151F2D", "superficie": "#243346", "cartao": "#2C4055",
                "borda": "#496277", "hover": "#34536B", "ciano": "#8BD9EC",
                "ouro": "#E9C786", "texto": "#F1F5FA", "muted": "#C0CEDD",
                "selecionado": "#31566C", "linha": "#1D2B3C",
            },
            "claro": {
                "fundo": "#F5F9FD", "superficie": "#E9F1F8", "cartao": "#FFFFFF",
                "borda": "#BCD0E1", "hover": "#DAE9F4", "ciano": "#087F9C",
                "ouro": "#976A24", "texto": "#183A50", "muted": "#4E7087",
                "selecionado": "#D4EAF3", "linha": "#F0F6FA",
            },
        }
        c = paletas[tema]
        # A barra possui um estilo legado proprio, portanto sua substituicao
        # acontece nela mesma. Todas as outras regras usam IDs locais da Central.
        abas_qss = f"""
            QTabBar::tab {{
                background: {c['fundo']}; color: {c['muted']};
                border: 1px solid {c['borda']};
                border-top: 2px solid {c['borda']};
                border-bottom: 2px solid {c['borda']};
                border-radius: 7px; padding: 11px 12px;
                margin-right: 5px; min-width: 112px;
                font-weight: 600;
            }}
            QTabBar::tab:selected {{
                background: {c['selecionado']}; color: {c['texto']};
                border-top: 2px solid {c['ouro']};
                border-bottom: 2px solid {c['ciano']};
            }}
            QTabBar::tab:hover:!selected {{
                background: {c['hover']}; color: {c['texto']};
                border-top-color: {c['ciano']};
            }}
            QTabBar::tab:focus {{ border-bottom: 2px solid {c['ciano']}; }}
        """
        self.topico_tabs.tabBar().setStyleSheet(abas_qss)
        qss = f"""
            QDialog#centralIntegradaTopico QFrame#topicHeroCard {{
                background: {c['superficie']}; border: 1px solid {c['borda']};
                border-left: 3px solid {c['ouro']}; border-radius: 10px;
            }}
            QDialog#centralIntegradaTopico QTabWidget::pane {{
                border: 1px solid {c['borda']}; border-radius: 8px;
                background: {c['fundo']};
            }}
            QDialog#centralIntegradaTopico QFrame#centralResumoIntroducao,
            QDialog#centralIntegradaTopico QFrame#centralResumoInformativo {{
                background: {c['superficie']}; border: 1px solid {c['borda']};
                border-radius: 8px;
            }}
            QDialog#centralIntegradaTopico QLabel#centralResumoTitulo,
            QDialog#centralIntegradaTopico QLabel#centralIntegradaSecaoTitulo {{
                background: transparent; border: none; color: {c['ouro']};
                font-weight: 700; font-size: 14px;
            }}
            QDialog#centralIntegradaTopico QLabel#centralResumoDescricao,
            QDialog#centralIntegradaTopico QLabel#centralResumoNota,
            QDialog#centralIntegradaTopico QLabel#centralIntegradaSecaoDescricao,
            QDialog#centralIntegradaTopico QLabel#centralIntegradaAcaoTexto {{
                color: {c['muted']}; background: transparent;
            }}
            QDialog#centralIntegradaTopico QFrame#centralIntegradaAcao {{
                background: {c['cartao']}; border: 1px solid {c['borda']};
                border-radius: 9px;
            }}
            QDialog#centralIntegradaTopico QFrame#centralIntegradaAcao:hover {{
                border-color: {c['ciano']};
            }}
            QDialog#centralIntegradaTopico QLabel#centralEstudoStatus,
            QDialog#centralIntegradaTopico QLabel#centralQuestoesContadorE04 {{
                color: {c['muted']}; background: {c['superficie']};
                border: 1px solid {c['borda']}; border-radius: 6px;
                padding: 8px 10px;
            }}
            QDialog#centralIntegradaTopico QLineEdit#centralQuestoesBuscaE04,
            QDialog#centralIntegradaTopico QComboBox {{
                background: {c['superficie']}; color: {c['texto']};
                border: 1px solid {c['borda']}; border-radius: 6px;
                padding: 5px 10px; selection-background-color: {c['selecionado']};
            }}
            QDialog#centralIntegradaTopico QLineEdit#centralQuestoesBuscaE04:focus,
            QDialog#centralIntegradaTopico QComboBox:focus {{
                border: 2px solid {c['ciano']};
            }}
            QDialog#centralIntegradaTopico QTableWidget#centralQuestoesTabelaE04 {{
                background: {c['fundo']}; alternate-background-color: {c['linha']};
                color: {c['texto']}; gridline-color: {c['borda']};
                border: 1px solid {c['borda']}; border-radius: 5px;
                selection-background-color: {c['selecionado']};
                selection-color: {c['texto']};
            }}
            QDialog#centralIntegradaTopico QTableWidget#centralQuestoesTabelaE04::item:selected {{
                border-bottom: 1px solid {c['ciano']};
            }}
            QDialog#centralIntegradaTopico QTableWidget#centralQuestoesTabelaE04 QHeaderView::section {{
                background: {c['superficie']}; color: {c['muted']};
                border: none; border-bottom: 1px solid {c['borda']};
                padding: 7px 8px; font-weight: 600;
            }}
            QDialog#centralIntegradaTopico QPushButton#centralIntegradaAcaoBotao,
            QDialog#centralIntegradaTopico QPushButton#centralResumoAbrirEstudo {{
                background: {c['superficie']}; color: {c['texto']};
                border: 1px solid {c['borda']}; border-radius: 7px;
                padding: 6px 12px; min-height: 27px;
            }}
            QDialog#centralIntegradaTopico QPushButton#centralIntegradaAcaoBotao:hover,
            QDialog#centralIntegradaTopico QPushButton#centralResumoAbrirEstudo:hover {{
                background: {c['hover']}; border-color: {c['ciano']};
            }}
            QDialog#centralIntegradaTopico QPushButton#centralIntegradaAcaoBotao:focus,
            QDialog#centralIntegradaTopico QPushButton#centralResumoAbrirEstudo:focus {{
                border: 2px solid {c['ciano']};
            }}
            QDialog#centralIntegradaTopico QPushButton#centralIntegradaAcaoBotao:disabled {{
                color: {c['muted']}; background: {c['fundo']};
                border-color: {c['borda']};
            }}
            QDialog#centralIntegradaTopico QLabel#centralIntegradaAvisoCapitulo {{
                background: {c['superficie']}; color: {c['muted']};
                border-left: 2px solid {c['ouro']}; border-radius: 6px;
                padding: 8px 11px;
            }}
        """
        self.setStyleSheet(self.styleSheet() + qss)

    def selecionar_secao(self, secao="resumo"):
        indice = self._ABAS.get(str(secao), 0)
        self.topico_tabs.setCurrentIndex(indice)
        if indice == self._ABAS["questoes"] and not self._questoes_carregadas_e04:
            self._carregar_questoes_e04()

    def estudar_topico(self):
        # A chamada pode vir inclusive de botoes herdados da visao geral.
        self.selecionar_secao("estudar")

    def ver_questoes_topico(self):
        self.selecionar_secao("questoes")

    def _abrir_configurador_legado(self):
        if topico_esta_pausado(self.topico_id):
            QMessageBox.information(
                self, "Tópico desligado", "Reative o tópico antes de estudar."
            )
            return
        JanelaTopico.estudar_topico(self)

    def _abrir_questoes_legadas(self):
        JanelaTopico.ver_questoes_topico(self)

    def _aplicar_estilo_navegacao(self):
        raiz = self.parentWidget()
        tema = normalizar_tema(getattr(raiz, "tema_atual", "futurista"))
        cores = {
            "futurista": ("#071e30", "#10354c", "#28cdee", "#eaf7ff", "#91bcd0"),
            "escuro": ("#1d2c3e", "#29465d", "#71c7e5", "#f2f6fa", "#b6cadb"),
            "claro": ("#f5faff", "#dfedf8", "#137da8", "#183e56", "#54748b"),
        }[tema]
        fundo, superficie, acento, texto, secundario = cores
        qss = """
            QTabBar::tab {
                background: %s; color: %s;
                border: 1px solid %s; border-radius: 6px;
                padding: 10px 20px; margin-right: 6px;
                min-width: 105px;
            }
            QTabBar::tab:selected {
                background: %s; color: %s;
                border-bottom: 2px solid %s;
            }
            QTabBar::tab:focus { border: 1px solid %s; }
            """ % (
                fundo, secundario, superficie,
                superficie, texto, acento, acento,
            )
        self.topico_tabs.tabBar().setStyleSheet(qss)
        self.setStyleSheet(self.styleSheet() + """
            QWidget#centralIntegradaSecao { background: %s; }
            QLabel#centralIntegradaSecaoTitulo {
                color: %s; font-weight: bold; font-size: 15px;
            }
            QLabel#centralIntegradaSecaoDescricao,
            QLabel#centralIntegradaAcaoTexto { color: %s; font-size: 12px; }
            QFrame#centralIntegradaAcao {
                background: %s; border: 1px solid %s; border-radius: 9px;
            }
            QPushButton#centralIntegradaAcaoBotao {
                background: %s; border: 1px solid %s;
                border-radius: 7px; color: %s; padding: 5px 12px;
            }
            QPushButton#centralIntegradaAcaoBotao:hover { border-color: %s; }
            QPushButton#centralIntegradaAcaoBotao:disabled { color: %s; }
            QLabel#centralIntegradaAvisoCapitulo {
                color: %s; background: %s; border-radius: 5px;
                padding: 7px 11px;
            }
            QFrame#centralResumoIntroducao {
                background: %s; border: 1px solid %s; border-radius: 7px;
            }
            QLabel#centralResumoTitulo {
                color: %s; font-size: 13px; font-weight: 700;
                background: transparent; border: none;
            }
            QLabel#centralResumoDescricao {
                color: %s; font-size: 12px; background: transparent;
                border: none;
            }
            QFrame#centralResumoInformativo {
                background: %s; border: 1px solid %s; border-radius: 7px;
            }
            QLabel#centralResumoNota {
                color: %s; font-size: 12px; background: transparent;
                border: none;
            }
            QPushButton#centralResumoAbrirEstudo {
                background: %s; color: %s; border: 1px solid %s;
                border-radius: 6px; padding: 5px 11px;
                min-width: 132px;
            }
            QPushButton#centralResumoAbrirEstudo:hover {
                border-color: %s;
            }
            QPushButton#centralResumoAbrirEstudo:focus {
                border: 2px solid %s;
            }
        """ % (
            fundo, texto, secundario, superficie, acento,
            superficie, acento, texto, acento, secundario,
            texto, superficie,
            fundo, superficie, acento, secundario,
            fundo, superficie, texto,
            superficie, texto, acento, acento, acento,
        ))

class JanelaDisciplinas(QDialog):
    def __init__(
        self,
        parent=None
    ):
        super().__init__(
            parent
        )

        self.setWindowTitle(
            "Gerenciar disciplinas"
        )
        self.resize(
            760,
            520
        )

        layout = QVBoxLayout(
            self
        )

