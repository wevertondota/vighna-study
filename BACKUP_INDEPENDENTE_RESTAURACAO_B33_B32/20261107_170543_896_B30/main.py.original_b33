        )
        self.tabela.verticalHeader().setVisible(
            False
        )

        self.tabela.horizontalHeader().setSectionResizeMode(
            0,
            QHeaderView.Stretch
        )

        for coluna in range(
            1,
            5
        ):
            self.tabela.horizontalHeader().setSectionResizeMode(
                coluna,
                QHeaderView.ResizeToContents
            )

        self.tabela.doubleClicked.connect(
            self.renomear_selecionada
        )

