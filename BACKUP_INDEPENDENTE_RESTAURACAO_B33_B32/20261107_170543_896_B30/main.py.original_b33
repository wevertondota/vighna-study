                cab_esq="#1a2a3d", cab_dir="#233951",
                borda="#3c5870", borda_forte="#6196ae",
                texto="#eaf2fa", secundario="#b6cadb", ciano="#71c7e5",
                ouro="#ddb774", campo="#1b2d40", campo_foco="#2b465e",
                selecao="#2d5470", linha="#233a4e",
                prim_esq="#2b77ae", prim_dir="#365b9f", prim_hover="#438cbd",
