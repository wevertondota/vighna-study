        )

        redistribuicao_layout = QVBoxLayout(
            card_redistribuicao
        )
        redistribuicao_layout.setContentsMargins(
            14,
            12,
            14,
            12
        )
        redistribuicao_layout.setSpacing(
            8
        )

        redistribuicao_titulo = QLabel(
            "Redistribuição inteligente"
        )
        redistribuicao_titulo.setObjectName(
            "planningSettingsTitle"
        )

        redistribuicao_descricao = QLabel(
            "O VighnaStudy pode identificar dias sobrecarregados e sugerir "
            "antecipações ou adiamentos conservadores. Nenhuma data é alterada "
            "sem sua confirmação."
        )
        redistribuicao_descricao.setObjectName(
            "mutedLabel"
        )
        redistribuicao_descricao.setWordWrap(
