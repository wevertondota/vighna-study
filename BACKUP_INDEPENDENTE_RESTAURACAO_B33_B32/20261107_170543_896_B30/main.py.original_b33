    def normalizar_texto(
        self,
        texto
    ):
        texto = str(
            texto
            or ""
        ).lower().strip()

        texto = unicodedata.normalize(
            "NFD",
            texto
        )

        texto = "".join(
            caractere
            for caractere in texto
            if unicodedata.category(
                caractere
            ) != "Mn"
        )

        return " ".join(
            texto.split()
        )

    def atualizar_dados(self):
        self.dados_historico = (
            listar_historico_tentativas_questoes(
                self.concurso_id
            )
        )
        self.dados_caderno = (
            listar_caderno_erros_questoes(
                self.concurso_id
            )
        )

        estatisticas = (
            obter_estatisticas_historico_questoes(
                self.concurso_id
            )
        )

        self.hist_stat_tentativas.setText(
            str(
                estatisticas[
                    "tentativas"
                ]
            )
        )
        self.hist_stat_questoes.setText(
            str(
                estatisticas[
                    "questoes_unicas"
                ]
            )
        )
        self.hist_stat_desempenho.setText(
            (
                f"{estatisticas['desempenho']:.1f}%"
                if estatisticas[
                    "desempenho"
                ] is not None
                else "—"
            )
        )
        self.hist_stat_erros.setText(
            str(
                estatisticas[
                    "erros"
                ]
            )
        )
        self.hist_stat_criticas.setText(
            str(
                estatisticas[
                    "criticas"
                ]
            )
        )

        self.recarregar_filtros()
        self.filtrar_historico()
        self.filtrar_caderno()

    def recarregar_filtros(self):
        disciplinas = sorted({
            item[
                "disciplina"
            ]
            for item in self.dados_historico
        } | {
            item[
                "disciplina"
            ]
            for item in self.dados_caderno
        }, key=str.lower)

        selecao_hist = (
            self.hist_disciplina.currentText()
        )
        self.hist_disciplina.blockSignals(
            True
        )
        self.hist_disciplina.clear()
        self.hist_disciplina.addItem(
            "Todas disciplinas"
        )
        self.hist_disciplina.addItems(
            disciplinas
        )

        if selecao_hist in (
            ["Todas disciplinas"]
            + disciplinas
        ):
            self.hist_disciplina.setCurrentText(
                selecao_hist
            )

        self.hist_disciplina.blockSignals(
            False
        )

        selecao_erros = (
            self.erros_disciplina.currentText()
        )
        self.erros_disciplina.blockSignals(
            True
        )
        self.erros_disciplina.clear()
        self.erros_disciplina.addItem(
            "Todas disciplinas"
        )
        self.erros_disciplina.addItems(
            disciplinas
        )

        if selecao_erros in (
            ["Todas disciplinas"]
            + disciplinas
        ):
            self.erros_disciplina.setCurrentText(
                selecao_erros
            )

        self.erros_disciplina.blockSignals(
            False
        )

        bancas = sorted({
            item[
                "banca"
            ]
            for item in self.dados_historico
            if item[
                "banca"
            ]
        }, key=str.lower)

        selecao_banca = (
            self.hist_banca.currentText()
        )
        self.hist_banca.blockSignals(
            True
        )
        self.hist_banca.clear()
        self.hist_banca.addItem(
            "Todas bancas"
        )
        self.hist_banca.addItems(
            bancas
        )

        if selecao_banca in (
            ["Todas bancas"]
            + bancas
        ):
            self.hist_banca.setCurrentText(
                selecao_banca
            )

        self.hist_banca.blockSignals(
            False
        )

        self.atualizar_filtro_topico_historico()

    def atualizar_filtro_topico_historico(self):
        if not hasattr(
            self,
            "hist_topico"
        ):
            return

        disciplina = (
            self.hist_disciplina.currentText()
        )
        anterior = (
            self.hist_topico.currentText()
        )

        if (
            not disciplina
            or disciplina
            == "Todas disciplinas"
        ):
            topicos = sorted({
                item[
                    "topico"
                ]
                for item in self.dados_historico
            }, key=str.lower)
        else:
            topicos = sorted({
                item[
                    "topico"
                ]
                for item in self.dados_historico
                if item[
                    "disciplina"
                ] == disciplina
            }, key=str.lower)

        self.hist_topico.blockSignals(
            True
        )
        self.hist_topico.clear()
        self.hist_topico.addItem(
            "Todos tópicos"
        )
        self.hist_topico.addItems(
            topicos
        )

        if anterior in (
            ["Todos tópicos"]
            + topicos
        ):
            self.hist_topico.setCurrentText(
                anterior
            )

        self.hist_topico.blockSignals(
            False
        )

    def filtrar_historico(self):
        if not hasattr(
            self,
            "tabela_historico"
        ):
            return

        busca = self.normalizar_texto(
            self.hist_busca.text()
        )
        disciplina = (
            self.hist_disciplina.currentText()
        )
        topico = (
            self.hist_topico.currentText()
        )
        banca = (
            self.hist_banca.currentText()
        )
        dificuldade = (
            self.hist_dificuldade.currentText()
        )
        resultado = (
            self.hist_resultado.currentText()
        )
        duvida = (
            self.hist_duvida.currentText()
        )
        periodo = (
            self.hist_periodo.currentText()
        )

        dias = {
            "7 dias": 7,
            "30 dias": 30,
            "90 dias": 90,
        }.get(
            periodo
        )

        data_minima = (
            QDate.currentDate().addDays(
                -(
                    dias
                    - 1
                )
            )
            if dias
            else None
        )

        filtrados = []

        for item in self.dados_historico:
            if data_minima is not None:
                data = QDate.fromString(
                    str(
                        item[
                            "respondida_em"
                        ]
                    )[:10],
                    "yyyy-MM-dd"
                )

                if (
                    data.isValid()
                    and data < data_minima
                ):
                    continue

            if (
                disciplina
                and disciplina
                != "Todas disciplinas"
                and item[
                    "disciplina"
                ] != disciplina
            ):
                continue

            if (
                topico
                and topico
                != "Todos tópicos"
                and item[
                    "topico"
                ] != topico
            ):
                continue

            if (
                banca
                and banca
                != "Todas bancas"
                and item[
                    "banca"
                ] != banca
            ):
                continue

            if (
                dificuldade
                and dificuldade
                != "Todas dificuldades"
                and item[
                    "dificuldade"
                ] != dificuldade
            ):
                continue

            if (
                resultado
                and resultado
                != "Todos resultados"
                and item[
                    "status"
                ] != resultado
            ):
                continue

            if (
                duvida == "Dúvida: sim"
                and not item[
                    "duvida"
                ]
            ):
                continue

            if (
                duvida == "Dúvida: não"
                and item[
                    "duvida"
                ]
            ):
                continue

            if busca:
                alvo = self.normalizar_texto(
                    (
                        f"{item['disciplina']} "
                        f"{item['topico']} "
                        f"{item['enunciado']} "
                        f"{item['banca']} "
                        f"{item['status']}"
                    )
                )

                termos = [
                    termo
                    for termo in busca.split(
                        " "
                    )
                    if termo
                ]

                if not all(
                    termo in alvo
                    for termo in termos
                ):
                    continue

            filtrados.append(
                item
            )

        self.historico_filtrado = filtrados

        self.hist_contagem.setText(
            (
                "1 registro"
                if len(
                    filtrados
                ) == 1
                else f"{len(filtrados)} registros"
            )
        )

        self.tabela_historico.setRowCount(
            len(
                filtrados
            )
        )

        mapa_status = {
            "Correta": "sucesso",
            "Errada": "perigo",
            "Pulada": "atencao",
        }

        for linha, item in enumerate(
            filtrados
        ):
            data_texto = str(
                item[
                    "respondida_em"
                ]
                or ""
            )

            if len(
                data_texto
            ) >= 16:
                data_exibicao = (
                    f"{data_texto[8:10]}/"
                    f"{data_texto[5:7]}/"
                    f"{data_texto[0:4]} "
                    f"{data_texto[11:16]}"
                )
            else:
                data_exibicao = data_texto or "—"

            valores = [
                data_exibicao,
                str(
                    item[
                        "questao_id"
                    ]
                ),
                item[
                    "disciplina"
                ],
                item[
                    "topico"
                ],
                item[
                    "status"
                ],
                item[
                    "alternativa_marcada"
                ]
                or "—",
                item[
                    "gabarito"
                ]
                or "—",
                (
                    "Sim"
                    if item[
                        "duvida"
                    ]
                    else "Não"
                ),
            ]

            for coluna, valor in enumerate(
                valores
            ):
                celula = QTableWidgetItem(
                    valor
                )

                if coluna == 3:
                    celula.setData(
                        Qt.UserRole,
                        item[
                            "tentativa_id"
                        ]
                    )
                    celula.setData(
                        Qt.UserRole + 1,
                        item[
                            "questao_id"
                        ]
                    )

                    origem_snapshot = item.get(
                        "snapshot_origem",
                        ""
                    )

                    if origem_snapshot == "resposta":
                        integridade_tooltip = (
                            "\n\n✓ Versão preservada no momento da resposta."
                        )
                    elif origem_snapshot == "migrado":
                        integridade_tooltip = (
                            "\n\nSnapshot legado: congelado na migração da "
                            "Integridade Histórica V1."
                        )
                    else:
                        integridade_tooltip = ""

                    celula.setToolTip(
                        item[
                            "enunciado"
                        ]
                        + integridade_tooltip
                    )

                if coluna in (
                    0,
                    1,
                    4,
                    5,
                    6,
                    7
                ):
                    celula.setTextAlignment(
                        Qt.AlignCenter
                    )

                if coluna == 4:
                    aplicar_destaque_tabela(
                        celula,
                        mapa_status[
                            item[
                                "status"
                            ]
                        ],
                        True
                    )

                self.tabela_historico.setItem(
                    linha,
                    coluna,
                    celula
                )

            self.tabela_historico.setRowHeight(
                linha,
                31
            )

    def filtrar_caderno(self):
        if not hasattr(
            self,
            "tabela_caderno"
        ):
            return

        busca = self.normalizar_texto(
            self.erros_busca.text()
        )
        disciplina = (
            self.erros_disciplina.currentText()
        )
        status = (
            self.erros_status.currentText()
        )
        dificuldade = (
            self.erros_dificuldade.currentText()
        )
        duvida = (
            self.erros_duvida.currentText()
        )

        filtrados = []

        for item in self.dados_caderno:
            if (
                disciplina
                and disciplina
                != "Todas disciplinas"
                and item[
                    "disciplina"
                ] != disciplina
            ):
                continue

            if (
                status
                and status
                != "Todos status"
                and item[
                    "status"
                ] != status
            ):
                continue

            if (
                dificuldade
                and dificuldade
                != "Todas dificuldades"
                and item[
                    "dificuldade"
                ] != dificuldade
            ):
                continue

            if (
                duvida == "Com dúvida"
                and not item[
                    "duvida"
                ]
            ):
                continue

            if (
                duvida == "Sem dúvida"
                and item[
                    "duvida"
                ]
            ):
                continue

            if busca:
                alvo = self.normalizar_texto(
                    (
                        f"{item['disciplina']} "
                        f"{item['topico']} "
                        f"{item['enunciado']} "
                        f"{item['banca']} "
                        f"{item['status']}"
                    )
                )

                termos = [
                    termo
                    for termo in busca.split(
                        " "
                    )
                    if termo
                ]

                if not all(
                    termo in alvo
                    for termo in termos
                ):
                    continue

            filtrados.append(
                item
            )

        self.caderno_filtrado = filtrados

        self.erros_contagem.setText(
            (
                "1 questão"
                if len(
                    filtrados
                ) == 1
                else f"{len(filtrados)} questões"
            )
        )

        self.tabela_caderno.setRowCount(
            len(
                filtrados
            )
        )

        mapa_status = {
            "Crítica": "perigo",
            "Recorrente": "alerta",
            "Erro isolado": "atencao",
            "Recuperada": "sucesso",
        }

        for linha, item in enumerate(
            filtrados
        ):
            data_texto = str(
                item[
                    "ultima_tentativa"
                ]
                or ""
            )

            if len(
                data_texto
            ) >= 10:
                data_exibicao = (
                    f"{data_texto[8:10]}/"
                    f"{data_texto[5:7]}/"
                    f"{data_texto[0:4]}"
                )
            else:
                data_exibicao = "—"

            valores = [
                str(
                    item[
                        "questao_id"
                    ]
                ),
                item[
                    "disciplina"
                ],
                item[
                    "topico"
                ],
                str(
                    item[
                        "tentativas"
                    ]
                ),
                str(
                    item[
                        "erros"
                    ]
                ),
                f"{item['taxa_acerto']:.0f}%",
                str(
                    item[
                        "erros_consecutivos"
                    ]
                ),
                data_exibicao,
                item[
                    "status"
                ],
            ]

            for coluna, valor in enumerate(
                valores
            ):
                celula = QTableWidgetItem(
                    valor
                )

                if coluna == 2:
                    celula.setData(
                        Qt.UserRole,
                        item[
                            "questao_id"
                        ]
                    )
                    celula.setToolTip(
                        item[
                            "enunciado"
                        ]
                        + (
                            "\n\nQuestão desativada — histórico preservado."
                            if not item.get(
                                "ativa",
                                True
                            )
                            else ""
                        )
                    )

                if coluna in (
                    0,
                    3,
                    4,
                    5,
                    6,
                    7,
                    8
                ):
                    celula.setTextAlignment(
                        Qt.AlignCenter
                    )

                if coluna == 8:
                    aplicar_destaque_tabela(
                        celula,
                        mapa_status[
                            item[
                                "status"
                            ]
                        ],
                        True
                    )

                if (
                    coluna == 5
                    and item[
                        "taxa_acerto"
                    ] < 50
                ):
                    aplicar_destaque_tabela(
                        celula,
                        "perigo",
                        False
                    )

                self.tabela_caderno.setItem(
                    linha,
                    coluna,
                    celula
                )

            self.tabela_caderno.setRowHeight(
                linha,
                31
            )

    def obter_id_historico_selecionado(self):
        linha = (
            self.tabela_historico.currentRow()
        )

        if linha < 0:
            QMessageBox.information(
                self,
                "Histórico",
                "Selecione uma tentativa na tabela."
            )
            return None

        item = self.tabela_historico.item(
            linha,
            3
        )

        if item is None:
            return None

        return item.data(
            Qt.UserRole + 1
        )

    def obter_tentativa_historico_selecionada_id(
        self
    ):
        linha = (
            self.tabela_historico.currentRow()
        )

        if linha < 0:
            QMessageBox.information(
                self,
                "Histórico",
                "Selecione uma tentativa na tabela."
            )
            return None

        item = self.tabela_historico.item(
            linha,
            3
        )

        if item is None:
            return None

        return item.data(
            Qt.UserRole
        )

    def obter_item_caderno_selecionado(self):
        linha = (
            self.tabela_caderno.currentRow()
        )

        if linha < 0:
            QMessageBox.information(
                self,
                "Caderno de erros",
                "Selecione uma questão na tabela."
            )
            return None

        item_tabela = self.tabela_caderno.item(
            linha,
            2
        )

        if item_tabela is None:
            return None

        questao_id = item_tabela.data(
            Qt.UserRole
        )

        for item in self.caderno_filtrado:
            if item[
                "questao_id"
            ] == questao_id:
                return item

        return None

    def ver_questao_linha_historico(
        self,
        linha,
        coluna
    ):
        item = self.tabela_historico.item(
            linha,
            3
        )

        if item is None:
            return

        tentativa_id = item.data(
            Qt.UserRole
        )

        if tentativa_id is not None:
            JanelaVisualizarQuestao(
                parent=self,
                tentativa_id=tentativa_id
            ).exec()

    def ver_questao_historico(self):
        tentativa_id = (
            self.obter_tentativa_historico_selecionada_id()
        )

        if tentativa_id is None:
            return

        JanelaVisualizarQuestao(
            parent=self,
            tentativa_id=tentativa_id
        ).exec()

    def ver_questao_linha_caderno(
        self,
        linha,
        coluna
    ):
        item = self.tabela_caderno.item(
            linha,
            2
        )

        if item is None:
            return

        questao_id = item.data(
            Qt.UserRole
        )

        if questao_id is not None:
            JanelaVisualizarQuestao(
                questao_id,
                self
            ).exec()

    def ver_questao_caderno(self):
        item = (
            self.obter_item_caderno_selecionado()
        )

        if item is None:
            return

        JanelaVisualizarQuestao(
            item[
                "questao_id"
            ],
            self
        ).exec()

    def editar_questao_caderno(self):
        item = (
            self.obter_item_caderno_selecionado()
        )

        if item is None:
            return

        janela = JanelaQuestaoEditor(
            item[
                "questao_id"
            ],
            self
        )

        if janela.exec() == QDialog.Accepted:
            self.atualizar_dados()

            if (
                self.janela_principal is not None
                and hasattr(
                    self.janela_principal,
                    "carregar_questoes"
                )
            ):
                self.janela_principal.carregar_questoes()

    def montar_item_resolucao(
        self,
        item
    ):
        return {
            "id": item[
                "questao_id"
            ],
            "topico_id": item[
                "topico_id"
            ],
            "disciplina_id": item[
                "disciplina_id"
            ],
            "disciplina": item[
                "disciplina"
            ],
            "topico": item[
                "topico"
            ],
            "enunciado": item[
                "enunciado"
            ],
            "banca": item[
                "banca"
            ],
            "ano": item[
                "ano"
            ],
            "dificuldade": item[
                "dificuldade"
            ],
            "tentativas_anteriores": int(
                item.get(
                    "tentativas_anteriores",
                    item.get(
                        "tentativas",
                        0
                    )
                )
            ),
            "inedita": False,
            "ativa": bool(
                item.get(
                    "ativa",
                    True
                )
            ),
        }

    def executar_fila_personalizada(
        self,
        fila,
        modo
    ):
        if not fila:
            return

        configuracao = {
            "concurso_id": self.concurso_id,
            "concurso_nome": self.concurso[1],
            "modo": modo,
            "quantidade": len(
                fila
            ),
            "fila": fila,
        }

        janela = JanelaResolverQuestoes(
            configuracao,
            self
        )
        janela.exec_nao_modal()

        self.atualizar_dados()

        if (
            self.janela_principal is not None
            and hasattr(
                self.janela_principal,
                "carregar_questoes"
            )
        ):
            self.janela_principal.carregar_questoes()

    def resolver_novamente_historico(self):
        questao_id = (
            self.obter_id_historico_selecionado()
        )

        if questao_id is None:
            return

        item = next(
            (
                registro
                for registro in self.dados_historico
                if registro[
                    "questao_id"
                ] == questao_id
            ),
            None
        )

        if item is None:
            return

        atual = obter_questao(
            questao_id
        )

        if (
            atual is None
            or not atual.get(
                "ativa",
                False
            )
        ):
            QMessageBox.information(
                self,
                "Questão desativada",
                (
                    "Esta questão está desativada e não pode receber novas "
                    "tentativas. O histórico permanece disponível para consulta."
                )
            )
            return

        total_anteriores = sum(
            1
            for registro in self.dados_historico
            if (
                registro[
                    "questao_id"
                ] == questao_id
                and registro[
                    "status"
                ] in (
                    "Correta",
                    "Errada"
                )
            )
        )

        item = {
            **item,
            "tentativas_anteriores": (
                total_anteriores
            ),
        }

        self.executar_fila_personalizada(
            [
                self.montar_item_resolucao(
                    item
                )
            ],
            "Repetição de questão"
        )

    def resolver_novamente_caderno(self):
        item = (
            self.obter_item_caderno_selecionado()
        )

        if item is None:
            return

        if not item.get(
            "ativa",
            True
        ):
            QMessageBox.information(
                self,
                "Questão desativada",
                (
                    "Esta questão está desativada e permanece no Caderno "
                    "de Erros apenas para preservar o histórico."
                )
            )
            return

        self.executar_fila_personalizada(
            [
                self.montar_item_resolucao(
                    item
                )
            ],
            "Repetição de erro"
        )

    def revisar_meus_erros(self):
        itens_visiveis = list(
            self.caderno_filtrado
        )

        itens = [
            item
            for item in itens_visiveis
            if item.get(
                "ativa",
                True
            )
        ]

        arquivadas_ignoradas = (
            len(
                itens_visiveis
            )
            - len(
                itens
            )
        )

        if not itens:
            QMessageBox.information(
                self,
                "Revisar erros",
                (
                    "Não há questões ativas no Caderno de Erros "
                    "com os filtros atuais. Questões desativadas permanecem "
                    "visíveis apenas para histórico."
                )
            )
            return

        maximo = len(
            itens
        )

        quantidade, ok = QInputDialog.getInt(
            self,
            "Revisar meus erros",
            (
                "Quantas questões deseja revisar?\n\n"
                "A fila prioriza Críticas, Recorrentes e menor taxa de acerto."
            ),
            min(
                20,
                maximo
            ),
            1,
            maximo,
            1
        )

        if not ok:
            return

        escolhidas = itens[
            :quantidade
        ]

        fila = [
            self.montar_item_resolucao(
                item
            )
            for item in escolhidas
        ]

        self.executar_fila_personalizada(
            fila,
            "Revisar erros"
        )

    def abrir_banco_erros(self):
        JanelaBancoErros(self).exec()
        self.atualizar_dados()


class JanelaExplicacaoRecomendacao(QDialog):
    """Explica com fatos concretos por que o Motor V5 escolheu a prioridade atual."""

    def __init__(self, recomendacao, parent=None):
        super().__init__(parent)
        self.recomendacao = dict(recomendacao or {})
        self.setWindowTitle("Por que esta recomendação?")
        self.resize(820, 650)
        self.setMinimumSize(700, 560)

        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(18, 16, 18, 16)
        raiz.setSpacing(10)

        titulo = QLabel("Por que esta recomendação?")
        titulo.setObjectName("pageTitle")
        subtitulo = QLabel(
            "O Vighna mostra os sinais concretos que pesaram na escolha desta sessão. "
            "Os valores abaixo são o retrato usado pelo algoritmo neste momento."
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        raiz.addWidget(titulo)
        raiz.addWidget(subtitulo)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        conteudo = QWidget()
        layout = QVBoxLayout(conteudo)
        layout.setContentsMargins(0, 2, 0, 2)
        layout.setSpacing(10)

        alvo = QFrame()
        alvo.setObjectName("studyActionCard")
        alvo.setProperty(
            "actionRole",
            "review" if self.recomendacao.get("origem") == "revisao" else "adaptive",
        )
        alvo_layout = QVBoxLayout(alvo)
        alvo_layout.setContentsMargins(14, 12, 14, 12)
        alvo_layout.setSpacing(4)

        selo = QLabel(str(self.recomendacao.get("selo") or "SESSÃO RECOMENDADA"))
        selo.setObjectName("studyReviewSourceBadge")
        alvo_layout.addWidget(selo, 0, Qt.AlignLeft)

        disciplina = str(self.recomendacao.get("disciplina") or "Estudo livre")
        topico = str(self.recomendacao.get("topico") or "Sem tópico específico")
        nome = QLabel(disciplina)
        nome.setObjectName("studyActionTitle")
        nome.setWordWrap(True)
        alvo_layout.addWidget(nome)
        topico_label = QLabel(topico)
        topico_label.setObjectName("studyActionMetric")
        topico_label.setWordWrap(True)
        alvo_layout.addWidget(topico_label)

        resumo = str(self.recomendacao.get("resumo_decisao") or "").strip()
        if resumo:
            resumo_label = QLabel(resumo)
            resumo_label.setObjectName("studyActionDescription")
            resumo_label.setWordWrap(True)
            alvo_layout.addWidget(resumo_label)
        layout.addWidget(alvo)

        evidencias = list(self.recomendacao.get("evidencias_objetivas") or [])
        if evidencias:
            evid_titulo = QLabel("Evidências objetivas")
            evid_titulo.setObjectName("studyColumnTitle")
            layout.addWidget(evid_titulo)

            grade = QGridLayout()
            grade.setHorizontalSpacing(8)
            grade.setVerticalSpacing(8)
            for indice, item in enumerate(evidencias[:6]):
                caixa = QFrame()
                caixa.setObjectName("myEvolutionStatCard")
                caixa.setProperty("evidenceTone", str(item.get("tom") or "neutral"))
                caixa_layout = QVBoxLayout(caixa)
                caixa_layout.setContentsMargins(11, 8, 11, 8)
                caixa_layout.setSpacing(2)
                rotulo = QLabel(str(item.get("rotulo") or "Sinal"))
                rotulo.setObjectName("myEvolutionStatLabel")
                valor = QLabel(str(item.get("valor") or "—"))
                valor.setObjectName("myEvolutionStatValue")
                detalhe = QLabel(str(item.get("detalhe") or ""))
                detalhe.setObjectName("mutedLabel")
                detalhe.setWordWrap(True)
                caixa_layout.addWidget(rotulo)
                caixa_layout.addWidget(valor)
                if detalhe.text().strip():
                    caixa_layout.addWidget(detalhe)
                grade.addWidget(caixa, indice // 2, indice % 2)
            layout.addLayout(grade)

        componentes_fila = dict(self.recomendacao.get("componentes_fila") or {})
        pesos_fila = dict(self.recomendacao.get("pesos_fila") or {})
        if componentes_fila:
            fila_titulo = QLabel(
                f"Fila Inteligente V3 • score {float(self.recomendacao.get('score_fila') or 0.0):.1f}/100"
            )
            fila_titulo.setObjectName("studyColumnTitle")
            layout.addWidget(fila_titulo)

            fila_grade = QGridLayout()
            fila_grade.setHorizontalSpacing(8)
            fila_grade.setVerticalSpacing(8)
            rotulos_fila = (
                ("atraso", "Atraso"),
                ("dominio", "Domínio"),
                ("erros_recentes", "Erros recentes"),
                ("queda", "Queda"),
                ("importancia", "Importância"),
                ("cobertura", "Cobertura"),
                ("revisoes", "Nº de revisões"),
                ("espacamento", "Espaçamento"),
            )
            for indice, (chave, rotulo) in enumerate(rotulos_fila):
                caixa = QFrame()
                caixa.setObjectName("myEvolutionStatCard")
                caixa_layout = QVBoxLayout(caixa)
                caixa_layout.setContentsMargins(9, 7, 9, 7)
                caixa_layout.setSpacing(1)
                peso = float(pesos_fila.get(chave) or 0.0)
                valor = float(componentes_fila.get(chave) or 0.0)
                l1 = QLabel(f"{rotulo} • {peso:.0f}%")
                l1.setObjectName("myEvolutionStatLabel")
                l2 = QLabel(f"{valor:.0f}/100")
                l2.setObjectName("myEvolutionStatValue")
                caixa_layout.addWidget(l1)
                caixa_layout.addWidget(l2)
                fila_grade.addWidget(caixa, indice // 4, indice % 4)
            layout.addLayout(fila_grade)

        eixos = dict(self.recomendacao.get("eixos_v5") or {})
        pesos = dict(self.recomendacao.get("pesos_v5") or {})
        if eixos:
            eixo_titulo = QLabel("Como o algoritmo ponderou")
            eixo_titulo.setObjectName("studyColumnTitle")
            layout.addWidget(eixo_titulo)
            eixos_linha = QHBoxLayout()
            eixos_linha.setSpacing(8)
            for chave, rotulo in (
                ("urgencia", "Urgência"),
                ("necessidade", "Necessidade"),
                ("momento", "Momento"),
            ):
                caixa = QFrame()
                caixa.setObjectName("myEvolutionStatCard")
                caixa_layout = QVBoxLayout(caixa)
                caixa_layout.setContentsMargins(10, 7, 10, 7)
                caixa_layout.setSpacing(1)
                l1 = QLabel(f"{rotulo} • peso {float(pesos.get(chave, 0)):.0f}%")
                l1.setObjectName("myEvolutionStatLabel")
                l2 = QLabel(f"{float(eixos.get(chave, 0)):.0f}/100")
                l2.setObjectName("myEvolutionStatValue")
                caixa_layout.addWidget(l1)
                caixa_layout.addWidget(l2)
                eixos_linha.addWidget(caixa, 1)
            layout.addLayout(eixos_linha)

        criterio = str(self.recomendacao.get("criterio_selecao_v5") or "").strip()
        if criterio:
            criterio_box = QFrame()
            criterio_box.setObjectName("pdfImportHint")
            criterio_layout = QVBoxLayout(criterio_box)
            criterio_layout.setContentsMargins(12, 9, 12, 9)
            criterio_layout.setSpacing(2)
            ct = QLabel("Critério de seleção")
            ct.setObjectName("studyColumnTitle")
            cv = QLabel(criterio)
            cv.setObjectName("studyActionDescription")
            cv.setWordWrap(True)
            criterio_layout.addWidget(ct)
            criterio_layout.addWidget(cv)
            layout.addWidget(criterio_box)

        ranking = list(self.recomendacao.get("ranking_resumo") or [])
        if ranking:
            ranking_titulo = QLabel("Prioridades consideradas")
            ranking_titulo.setObjectName("studyColumnTitle")
            layout.addWidget(ranking_titulo)
            linhas = []
            for item in ranking[:4]:
                pos = item.get("posicao_global") or "—"
                d = str(item.get("disciplina") or "").strip()
                t = str(item.get("topico") or "").strip()
                score = float(item.get("score_total") or 0.0)
                score_fila = float(item.get("score_fila") or 0.0)
                marca = "  ← selecionado" if item.get("selecionado") else ""
                linhas.append(
                    f"{pos}º  {d} — {t}  • fila {score_fila:.1f} • recomendação {score:.1f}{marca}"
                )
            ranking_label = QLabel("\n".join(linhas))
            ranking_label.setObjectName("studyScoreBreakdown")
            ranking_label.setWordWrap(True)
            layout.addWidget(ranking_label)

        nota = QLabel(
            "A recomendação é recalculada conforme revisões, respostas, tempo sem prática, "
            "importância e demais sinais do perfil mudam."
        )
        nota.setObjectName("mutedLabel")
        nota.setWordWrap(True)
        layout.addWidget(nota)
        layout.addStretch(1)

        scroll.setWidget(conteudo)
        raiz.addWidget(scroll, 1)

        fechar = QPushButton("Fechar")
        fechar.setObjectName("subtleButton")
        fechar.clicked.connect(self.accept)
        linha_fechar = QHBoxLayout()
        linha_fechar.addStretch(1)
        linha_fechar.addWidget(fechar)
        raiz.addLayout(linha_fechar)


class JanelaEstudarAgoraV5(QDialog):
    """Apresenta uma recomendação curta e transforma-a em preparação do Foco.

    A janela não inicia cronômetro nem registra estudo. Ela somente explica a
    recomendação e devolve a configuração escolhida para o Modo Foco.
    """

    def __init__(self, recomendacao, parent=None):
        super().__init__(parent)

        self.recomendacao = dict(recomendacao or {})
        self.preparacao = None
        self.usar_modo_foco = False

        self.setWindowTitle("Recomendado para hoje")
        self.resize(760, 560)
        self.setMinimumSize(640, 500)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 18, 20, 18)
        layout.setSpacing(12)

        cabecalho = QHBoxLayout()
        cabecalho.setSpacing(10)

        icone = QLabel("◇")
        icone.setObjectName("studyNowIcon")
        icone.setAlignment(Qt.AlignCenter)
        icone.setFixedSize(38, 38)
        cabecalho.addWidget(icone, 0, Qt.AlignTop)

        titulos = QVBoxLayout()
        titulos.setSpacing(2)

        titulo = QLabel("Recomendado para hoje")
        titulo.setObjectName("dashboardActionSectionTitle")
        titulos.addWidget(titulo)

        subtitulo = QLabel(
            "Veja o que o Vighna recomenda estudar agora com base nas prioridades do seu dia. Nada será iniciado sem sua confirmação."
        )
        subtitulo.setObjectName("dashboardActionSectionSubtitle")
        subtitulo.setWordWrap(True)
        titulos.addWidget(subtitulo)

        cabecalho.addLayout(titulos, 1)
        layout.addLayout(cabecalho)

        card = QFrame()
        card.setObjectName("studyActionCard")
        card.setProperty(
            "actionRole",
            "review" if self.recomendacao.get("origem") == "revisao" else "adaptive"
        )
        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(16, 14, 16, 14)
        card_layout.setSpacing(7)

        fonte = QLabel(str(self.recomendacao.get("selo", "SESSÃO RECOMENDADA")))
        fonte.setObjectName("studyReviewSourceBadge")
        card_layout.addWidget(fonte, 0, Qt.AlignLeft)

        disciplina = str(self.recomendacao.get("disciplina") or "Estudo livre")
        disciplina_label = QLabel(disciplina)
        disciplina_label.setObjectName("studyActionTitle")
        disciplina_label.setWordWrap(True)
        card_layout.addWidget(disciplina_label)

        topico = str(self.recomendacao.get("topico") or "Sem tópico específico")
        topico_label = QLabel(topico)
        topico_label.setObjectName("studyActionMetric")
        topico_label.setWordWrap(True)
        card_layout.addWidget(topico_label)

        motivo_titulo = QLabel("Por que agora?")
        motivo_titulo.setObjectName("studyColumnTitle")
        card_layout.addWidget(motivo_titulo)

        motivos = self.recomendacao.get("motivos") or []
        if not motivos:
            motivos = ["Sessão livre para manter contato com o estudo."]

        motivo_texto = QLabel(
            "\n".join(f"• {str(motivo)}" for motivo in motivos[:5])
        )
        motivo_texto.setObjectName("studyActionDescription")
        motivo_texto.setWordWrap(True)
        card_layout.addWidget(motivo_texto)

        eixos = dict(self.recomendacao.get("eixos_v5") or {})
        pesos = dict(self.recomendacao.get("pesos_v5") or {})
        if eixos:
            eixos_linha = QHBoxLayout()
            eixos_linha.setSpacing(7)
            for chave, rotulo in (("urgencia", "Urgência"), ("necessidade", "Necessidade"), ("momento", "Momento")):
                eixo_card = QFrame()
                eixo_card.setObjectName("myEvolutionStatCard")
                eixo_layout = QVBoxLayout(eixo_card)
                eixo_layout.setContentsMargins(9, 7, 9, 7)
                eixo_layout.setSpacing(1)
                eixo_rotulo = QLabel(f"{rotulo} • {float(pesos.get(chave, 0)):.0f}%")
                eixo_rotulo.setObjectName("myEvolutionStatLabel")
                eixo_valor = QLabel(f"{float(eixos.get(chave, 0)):.0f}/100")
                eixo_valor.setObjectName("myEvolutionStatValue")
                eixo_layout.addWidget(eixo_rotulo)
                eixo_layout.addWidget(eixo_valor)
                eixos_linha.addWidget(eixo_card, 1)
            card_layout.addLayout(eixos_linha)
            criterio_v5 = QLabel(str(self.recomendacao.get("criterio_selecao_v5") or ""))
            criterio_v5.setObjectName("mutedLabel")
            criterio_v5.setWordWrap(True)
            card_layout.addWidget(criterio_v5)

        score_partes = list(self.recomendacao.get("score_explicado") or [])
        if score_partes:
            score_titulo = QLabel(
                f"Como chegou à prioridade • score {float(self.recomendacao.get('score_total') or 0):.1f}"
            )
            score_titulo.setObjectName("studyColumnTitle")
            card_layout.addWidget(score_titulo)
            linhas_score = []
            for parte in score_partes[:6]:
                pontos = float(parte.get("pontos") or 0.0)
                sinal = "+" if pontos > 0 else ""
                linhas_score.append(f"{parte.get('rotulo', 'sinal')}: {sinal}{pontos:.1f}")
            score_texto = QLabel(" • ".join(linhas_score))
            score_texto.setObjectName("studyScoreBreakdown")
            score_texto.setWordWrap(True)
            score_texto.setToolTip(
                "Pontuação final explicável do Motor V5. Os três eixos podem ser simulados no Laboratório do Algoritmo."
            )
            card_layout.addWidget(score_texto)

        sessao_titulo = QLabel("Sessão sugerida")
        sessao_titulo.setObjectName("studyColumnTitle")
        card_layout.addWidget(sessao_titulo)

        descricao_bruta = str(self.recomendacao.get("descricao_sessao") or "Revisão")
        descricao_limpa = re.sub(r"\s*[•\-]\s*~?\d+\s*min(?:utos)?\s*$", "", descricao_bruta, flags=re.IGNORECASE).strip()
        descricao_limpa = re.sub(r"\s*~?\d+\s*min(?:utos)?\s*$", "", descricao_limpa, flags=re.IGNORECASE).strip()
        if not descricao_limpa:
            descricao_limpa = "Revisão"

        sessao_desc = QLabel(descricao_limpa)
        sessao_desc.setObjectName("studyActionMetric")
        sessao_desc.setWordWrap(True)
        sessao_desc.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(sessao_desc, 0, Qt.AlignHCenter)
        layout.addWidget(card)

        foco_box = QFrame()
        foco_box.setObjectName("questionsHeroActions")
        foco_layout = QVBoxLayout(foco_box)
        foco_layout.setContentsMargins(16, 14, 16, 14)
        foco_layout.setSpacing(8)

        self.opcao_modo_foco = QCheckBox("Ativar Modo Foco para esta sessão")
        self.opcao_modo_foco.setChecked(False)
        foco_layout.addWidget(self.opcao_modo_foco, 0, Qt.AlignHCenter)

        foco_info = QLabel("Se esta opção estiver ativada, o Vighna preparará esta recomendação dentro do Modo Foco.")
        foco_info.setObjectName("dashboardActionSectionSubtitle")
        foco_info.setWordWrap(True)
        foco_info.setAlignment(Qt.AlignCenter)
        foco_layout.addWidget(foco_info)

        principal = QPushButton("Começar")
        principal.setObjectName("studyManualButton")
        principal.setMinimumHeight(42)
        principal.setMinimumWidth(230)
        principal.clicked.connect(self.escolher_principal)
        foco_layout.addWidget(principal, 0, Qt.AlignHCenter)

        layout.addWidget(foco_box)

        aviso = QLabel(
            "Esta tela mostra apenas a recomendação do Vighna para hoje. Nada será iniciado automaticamente."
        )
        aviso.setObjectName("dashboardActionSectionSubtitle")
        aviso.setWordWrap(True)
        aviso.setAlignment(Qt.AlignCenter)
        layout.addWidget(aviso)

        acoes = QHBoxLayout()
        acoes.addStretch()
        cancelar = QPushButton("Cancelar")
        cancelar.setObjectName("subtleButton")
        cancelar.clicked.connect(self.reject)
        acoes.addWidget(cancelar)
        layout.addLayout(acoes)

    def montar_preparacao(self, minutos, atividade, rotulo):
        return montar_preparacao_foco(
            self.recomendacao,
            minutos=minutos,
            atividade=atividade,
            rotulo=rotulo,
        )

    def escolher_principal(self):
        self.usar_modo_foco = bool(self.opcao_modo_foco.isChecked())
        if self.usar_modo_foco:
            self.preparacao = self.montar_preparacao(
                self.recomendacao.get("minutos", 25),
                self.recomendacao.get("atividade", "Estudo livre"),
                self.recomendacao.get("rotulo_sessao", "sessão recomendada"),
            )
        else:
            self.preparacao = None
        self.accept()



class JanelaProximaRecomendacaoAlgoritmo(QDialog):
    """Confirma a próxima prioridade depois de uma bateria guiada pelo Motor V5."""

    def __init__(self, recomendacao, parent=None):
        super().__init__(parent)
        self.recomendacao = dict(recomendacao or {})

        self.setWindowTitle("Próxima recomendação")
        self.resize(660, 390)
        self.setMinimumSize(560, 340)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 18, 20, 18)
        layout.setSpacing(12)

        titulo = QLabel("PRÓXIMA RECOMENDAÇÃO")
        titulo.setObjectName("pageTitle")
        titulo.setAlignment(Qt.AlignCenter)
        layout.addWidget(titulo)

        subtitulo = QLabel(
            "O Vighna recalculou a prioridade usando os resultados da bateria que você acabou de concluir."
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setAlignment(Qt.AlignCenter)
        subtitulo.setWordWrap(True)
        layout.addWidget(subtitulo)

        card = QFrame()
        card.setObjectName("studyActionCard")
        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(16, 14, 16, 14)
        card_layout.setSpacing(6)

        disciplina = QLabel(str(self.recomendacao.get("disciplina") or "Estudo livre"))
        disciplina.setObjectName("studyActionTitle")
        disciplina.setWordWrap(True)
        disciplina.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(disciplina)

        topico = QLabel(str(self.recomendacao.get("topico") or "Sem tópico específico"))
        topico.setObjectName("studyActionMetric")
        topico.setWordWrap(True)
        topico.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(topico)

        motivos = list(self.recomendacao.get("motivos") or [])
        motivo = str(motivos[0] if motivos else self.recomendacao.get("motivo") or "Prioridade atual do Motor V5.")
        motivo_label = QLabel(motivo)
        motivo_label.setObjectName("studyActionDescription")
        motivo_label.setWordWrap(True)
        motivo_label.setAlignment(Qt.AlignCenter)
        card_layout.addWidget(motivo_label)

        layout.addWidget(card)
        layout.addStretch(1)

        acoes = QHBoxLayout()
        acoes.setSpacing(8)
        acoes.addStretch(1)

        dashboard = QPushButton("Voltar ao Dashboard")
        dashboard.setObjectName("subtleButton")
        dashboard.setMinimumHeight(38)
        dashboard.clicked.connect(self.reject)

        comecar = QPushButton("▶  COMEÇAR")
        comecar.setObjectName("primaryButton")
        comecar.setMinimumHeight(42)
        comecar.setMinimumWidth(190)
        comecar.clicked.connect(self.accept)

        acoes.addWidget(dashboard)
        acoes.addWidget(comecar)
        acoes.addStretch(1)
        layout.addLayout(acoes)


class JanelaInicioSessao(QDialog):



    def __init__(
        self,
        total_pendencias,
        meta_diaria,
        questoes_hoje,
        parent=None
    ):
        super().__init__(
            parent
        )

        self.total_pendencias = max(
            1,
            int(
                total_pendencias
                or 1
            )
        )

        self.modo = "pendencias"
        self.meta_topicos = 0
        self.meta_questoes = 0

        self.setWindowTitle(
            "Nova sessão de estudo"
        )
        self.resize(
            540,
            390
        )
        self.setMinimumSize(
            500,
            360
        )

        layout = QVBoxLayout(
            self
        )
        layout.setContentsMargins(
            20,
            18,
            20,
            18
        )
        layout.setSpacing(
            12
        )

        titulo = QLabel(
            "Nova sessão de estudo"
        )
        titulo.setObjectName(
            "pageTitle"
        )

        subtitulo = QLabel(
            (
                f"Há {total_pendencias} revisão(ões) na fila atual. "
                "Defina como esta sessão deve terminar."
            )
        )
        subtitulo.setObjectName(
            "pageSubtitle"
        )
        subtitulo.setWordWrap(
            True
        )

        layout.addWidget(
            titulo
        )
        layout.addWidget(
            subtitulo
        )

        card = QFrame()
        card.setObjectName(
            "studySessionStartCard"
        )

        card_layout = QVBoxLayout(
            card
        )
        card_layout.setContentsMargins(
            16,
            14,
            16,
            14
        )
        card_layout.setSpacing(
            10
        )

        objetivo_label = QLabel(
            "Objetivo da sessão"
        )
        objetivo_label.setObjectName(
            "fieldLabel"
        )

        self.objetivo = QComboBox()
        self.objetivo.addItem(
            "Até concluir as pendências",
            "pendencias"
        )
        self.objetivo.addItem(
            "Quantidade de tópicos",
            "topicos"
        )
        self.objetivo.addItem(
            "Meta de questões",
            "questoes"
        )
        self.objetivo.setMinimumHeight(
            36
        )

        card_layout.addWidget(
            objetivo_label
        )
        card_layout.addWidget(
            self.objetivo
        )

        self.bloco_topicos = QWidget()
        bloco_topicos_layout = QHBoxLayout(
            self.bloco_topicos
        )
        bloco_topicos_layout.setContentsMargins(
            0,
            2,
            0,
            0
        )

        topicos_label = QLabel(
            "Concluir"
        )
        topicos_label.setObjectName(
            "fieldLabel"
        )

        self.quantidade_topicos = QSpinBox()
        self.quantidade_topicos.setRange(
            1,
            self.total_pendencias
        )
        self.quantidade_topicos.setValue(
            min(
                5,
                self.total_pendencias
            )
        )
        self.quantidade_topicos.setSuffix(
            " tópicos"
        )
        self.quantidade_topicos.setFixedWidth(
            150
        )

        bloco_topicos_layout.addWidget(
            topicos_label
        )
        bloco_topicos_layout.addWidget(
            self.quantidade_topicos
        )
        bloco_topicos_layout.addStretch()

        card_layout.addWidget(
            self.bloco_topicos
        )

        self.bloco_questoes = QWidget()
        bloco_questoes_layout = QHBoxLayout(
            self.bloco_questoes
        )
        bloco_questoes_layout.setContentsMargins(
            0,
            2,
            0,
            0
        )

        questoes_label = QLabel(
            "Alcançar"
        )
        questoes_label.setObjectName(
            "fieldLabel"
        )

        restante_meta = max(
            0,
            int(
                meta_diaria
                or 0
            )
            - int(
                questoes_hoje
                or 0
            )
        )

        sugestao_questoes = (
            restante_meta
            if restante_meta > 0
            else 100
        )

        self.quantidade_questoes = QSpinBox()
        self.quantidade_questoes.setRange(
            1,
            10000
        )
        self.quantidade_questoes.setSingleStep(
            10
        )
        self.quantidade_questoes.setValue(
            sugestao_questoes
        )
        self.quantidade_questoes.setSuffix(
            " questões"
        )
        self.quantidade_questoes.setFixedWidth(
            160
        )

        bloco_questoes_layout.addWidget(
            questoes_label
        )
        bloco_questoes_layout.addWidget(
            self.quantidade_questoes
        )
        bloco_questoes_layout.addStretch()

        card_layout.addWidget(
            self.bloco_questoes
        )

        explicacao = QLabel(
            (
                "Você poderá pular um tópico sem alterar seu agendamento, "
                "pausar a sessão e encerrá-la manualmente a qualquer momento."
            )
        )
        explicacao.setObjectName(
            "mutedLabel"
        )
        explicacao.setWordWrap(
            True
        )

        card_layout.addWidget(
            explicacao
        )

        layout.addWidget(
            card
        )
        layout.addStretch()

        botoes = QDialogButtonBox(
            QDialogButtonBox.Ok
            | QDialogButtonBox.Cancel
        )

        iniciar = botoes.button(
            QDialogButtonBox.Ok
        )
        iniciar.setText(
            "Iniciar sessão"
        )
        iniciar.setObjectName(
            "primaryButton"
        )
        iniciar.setMinimumWidth(
            140
        )

        cancelar = botoes.button(
            QDialogButtonBox.Cancel
        )
        cancelar.setText(
            "Cancelar"
        )
        cancelar.setObjectName(
            "subtleButton"
        )

        botoes.accepted.connect(
            self.confirmar
        )
        botoes.rejected.connect(
            self.reject
        )

        layout.addWidget(
            botoes
        )

        self.objetivo.currentIndexChanged.connect(
            self.atualizar_campos
        )

        self.atualizar_campos()

    def atualizar_campos(self):
        modo = self.objetivo.currentData()

        self.bloco_topicos.setVisible(
            modo == "topicos"
        )
        self.bloco_questoes.setVisible(
            modo == "questoes"
        )

    def confirmar(self):
        self.modo = (
            self.objetivo.currentData()
            or "pendencias"
        )

        self.meta_topicos = (
            self.quantidade_topicos.value()
            if self.modo == "topicos"
            else 0
        )

        self.meta_questoes = (
            self.quantidade_questoes.value()
            if self.modo == "questoes"
            else 0
        )

        self.accept()


class JanelaResumoSessao(QDialog):
    def __init__(
        self,
        resumo,
        registros,
        parent=None
    ):
        super().__init__(
            parent
        )

        self.setWindowTitle(
            "Resumo da sessão"
        )
        self.resize(
            800,
            570
        )
        self.setMinimumSize(
            680,
            500
        )

        layout = QVBoxLayout(
            self
        )
        layout.setContentsMargins(
            20,
            18,
            20,
            18
        )
        layout.setSpacing(
            12
        )

        titulo = QLabel(
            "Resumo da sessão"
        )
        titulo.setObjectName(
            "pageTitle"
        )

        subtitulo = QLabel(
            resumo.get(
                "motivo",
                "Sessão encerrada."
            )
        )
        subtitulo.setObjectName(
            "pageSubtitle"
        )
        subtitulo.setWordWrap(
            True
        )

        layout.addWidget(
            titulo
        )
        layout.addWidget(
            subtitulo
        )

        objetivo = QLabel(
            f"Objetivo: {resumo.get('objetivo', '—')}"
        )
        objetivo.setObjectName(
            "sessionSummaryObjective"
        )
        layout.addWidget(
            objetivo
        )

        grade = QGridLayout()
        grade.setHorizontalSpacing(
            9
        )

        for coluna in range(
            5
        ):
            grade.setColumnStretch(
                coluna,
                1
            )

        def criar_card(
            rotulo,
            valor
        ):
            card = QFrame()
            card.setObjectName(
                "sessionSummaryStat"
            )

            card_layout = QVBoxLayout(
                card
            )
            card_layout.setContentsMargins(
                10,
                8,
                10,
                8
            )
            card_layout.setSpacing(
                2
            )

            label = QLabel(
                rotulo
            )
            label.setObjectName(
                "miniStatLabel"
            )

            valor_label = QLabel(
                str(
                    valor
                )
            )
            valor_label.setObjectName(
                "miniStatValue"
            )

            card_layout.addWidget(
                label
            )
            card_layout.addWidget(
                valor_label
            )

            return card

        grade.addWidget(
            criar_card(
                "Concluídos",
                resumo.get(
                    "concluidas",
                    0
                )
            ),
            0,
            0
        )
        grade.addWidget(
            criar_card(
                "Pulados",
                resumo.get(
                    "pulados",
                    0
                )
            ),
            0,
            1
        )
        grade.addWidget(
            criar_card(
                "Restantes",
                resumo.get(
                    "restantes",
                    0
                )
            ),
            0,
            2
        )
        grade.addWidget(
            criar_card(
                "Questões",
                resumo.get(
                    "questoes",
                    0
                )
            ),
            0,
            3
        )
        grade.addWidget(
            criar_card(
                "Desempenho",
                formatar_percentual(
                    resumo.get(
                        "percentual"
                    ),
                    1
                )
            ),
            0,
            4
        )

        layout.addLayout(
            grade
        )

        tabela_titulo = QLabel(
            "Atividade da sessão"
        )
        tabela_titulo.setObjectName(
            "sectionTitle"
        )
        layout.addWidget(
            tabela_titulo
        )

        tabela = QTableWidget()
        tabela.setObjectName(
            "sessionSummaryTable"
        )
        tabela.setColumnCount(
            6
        )
        tabela.setHorizontalHeaderLabels([
            "Status",
            "Disciplina",
            "Tópico",
            "Questões",
            "Acertos",
            "Resultado"
        ])
        tabela.setEditTriggers(
            QAbstractItemView.NoEditTriggers
        )
        tabela.setSelectionBehavior(
            QAbstractItemView.SelectRows
        )
        tabela.verticalHeader().setVisible(
            False
        )
        tabela.setShowGrid(
            False
        )
        tabela.setRowCount(
            len(
                registros
            )
        )

        header = tabela.horizontalHeader()
        header.setSectionResizeMode(
            0,
            QHeaderView.ResizeToContents
        )
        header.setSectionResizeMode(
            1,
            QHeaderView.ResizeToContents
        )
        header.setSectionResizeMode(
            2,
            QHeaderView.Stretch
        )
        for coluna in (
            3,
            4,
            5
        ):
            header.setSectionResizeMode(
                coluna,
                QHeaderView.ResizeToContents
            )

        for linha, registro in enumerate(
            registros
        ):
            questoes = registro.get(
                "questoes"
            )
            acertos = registro.get(
                "acertos"
            )
            percentual = registro.get(
                "percentual"
            )

            valores = [
                registro.get(
                    "status",
                    "—"
                ),
                registro.get(
                    "disciplina",
                    "—"
                ),
                registro.get(
                    "topico",
                    "—"
                ),
                (
                    str(
                        questoes
                    )
                    if questoes is not None
                    else "—"
                ),
                (
                    str(
                        acertos
                    )
                    if acertos is not None
                    else "—"
                ),
                (
                    formatar_percentual(
                        percentual,
                        1
                    )
                    if percentual is not None
                    else "—"
                ),
            ]

            for coluna, valor in enumerate(
                valores
            ):
                item = QTableWidgetItem(
                    valor
                )

                if coluna in (
                    0,
                    3,
                    4,
                    5
                ):
                    item.setTextAlignment(
                        Qt.AlignCenter
                    )

                tabela.setItem(
                    linha,
                    coluna,
                    item
                )

            tabela.setRowHeight(
                linha,
                31
            )

        layout.addWidget(
            tabela,
            1
        )

        botoes = QDialogButtonBox(
            QDialogButtonBox.Close
        )

        fechar = botoes.button(
            QDialogButtonBox.Close
        )
        fechar.setText(
            "Voltar ao Dashboard"
        )
        fechar.setObjectName(
            "primaryButton"
        )
        fechar.setMinimumWidth(
            170
        )

        botoes.rejected.connect(
            self.reject
        )
        botoes.clicked.connect(
            self.accept
        )

        layout.addWidget(
            botoes
        )


class JanelaRevisao(QDialog):


    def __init__(
        self,
        topico_id,
        nome_topico,
        parent=None,
        revisao=None,
        modo_edicao=False,
        concurso_id=None,
    ):
        super().__init__(parent)

        self.topico_id = topico_id
        self.revisao = revisao
        self.modo_edicao = modo_edicao
        self.concurso_id = (
            int(concurso_id)
            if concurso_id not in (None, "")
            else int(obter_concurso_ativo()[0])
        )

        self.sugestao_em_uso = True
        self._atualizando_data_sugerida = False
        self.sugestao_atual = None

        if modo_edicao:
            self.setWindowTitle(
                "Editar revisão"
            )
        else:
            self.setWindowTitle(
                "Registrar revisão manual"
            )

        self.resize(
            760,
            690
        )
        self.setMinimumSize(
            680,
            610
        )

        raiz = QVBoxLayout(
            self
        )
        raiz.setContentsMargins(
            20,
            18,
            20,
            18
        )
        raiz.setSpacing(
            12
        )

        # ====================================================
        # CABEÇALHO
        # ====================================================

        titulo = QLabel(
            nome_topico
        )
        titulo.setObjectName(
            "pageTitle"
        )

        subtitulo = QLabel(
            (
                "Edite os dados desta sessão de revisão."
                if modo_edicao
                else
                "Use este formulário para estudos feitos fora do VighnaStudy. "
                "As questões respondidas internamente são consolidadas automaticamente."
            )
        )
        subtitulo.setObjectName(
            "pageSubtitle"
        )

        raiz.addWidget(
            titulo
        )
        raiz.addWidget(
            subtitulo
        )

        if not modo_edicao:
            resumo_topico = obter_resumo_topico(
                self.topico_id
            )

            self.numero_revisao = (
                resumo_topico[
                    "revisoes_totais"
                ]
                + 1
            )

            self.percentual_anterior = (
                resumo_topico[
                    "percentual_atual"
                ]
            )

            self.aplicar_penalizacao_queda = (
                obter_configuracao_bool(
                    "aplicar_penalizacao_queda",
                    True
                )
            )

            self.config_espacamento = (
                carregar_configuracao_espacamento()
            )

            texto_anterior = (
                "sem resultado anterior"
                if self.percentual_anterior is None
                else
                (
                    "resultado anterior "
                    f"{formatar_percentual(self.percentual_anterior, 1)}"
                )
            )

            self.info_revisao = QLabel(
                f"{self.numero_revisao}ª revisão • "
                f"{texto_anterior}"
            )
            self.info_revisao.setObjectName(
                "sessionBadge"
            )

            raiz.addWidget(
                self.info_revisao,
                0,
                Qt.AlignLeft
            )
        else:
            self.numero_revisao = None
            self.percentual_anterior = None
            self.aplicar_penalizacao_queda = True
            self.config_espacamento = (
                carregar_configuracao_espacamento()
            )

        # ====================================================
        # ÁREA ROLÁVEL
        # ====================================================

        scroll = QScrollArea()
        scroll.setWidgetResizable(
            True
        )
        scroll.setFrameShape(
            QFrame.NoFrame
        )

        conteudo = QWidget()

        layout = QVBoxLayout(
            conteudo
        )
        layout.setContentsMargins(
            2,
            2,
            2,
            2
        )
        layout.setSpacing(
            12
        )

        # ====================================================
        # CARD — DESEMPENHO DA SESSÃO
        # ====================================================

        card_sessao = QFrame()
        card_sessao.setObjectName(
            "dialogCard"
        )

        card_sessao_layout = QVBoxLayout(
            card_sessao
        )
        card_sessao_layout.setContentsMargins(
            16,
            14,
            16,
            16
        )
        card_sessao_layout.setSpacing(
            10
        )

        titulo_sessao = QLabel(
            "Desempenho da sessão"
        )
        titulo_sessao.setObjectName(
            "sectionTitle"
        )

        card_sessao_layout.addWidget(
            titulo_sessao
        )

        grade_sessao = QGridLayout()
        grade_sessao.setHorizontalSpacing(
            12
        )
        grade_sessao.setVerticalSpacing(
            6
        )

        for coluna in range(
            4
        ):
            grade_sessao.setColumnStretch(
                coluna,
                1
            )

        self.data = QDateEdit()
        self.data.setCalendarPopup(
            True
        )
        self.data.setDisplayFormat(
            "dd/MM/yyyy"
        )

        self.questoes = QSpinBox()
        self.questoes.setRange(
            1,
            10000
        )

        self.acertos = QSpinBox()
        self.acertos.setRange(
            0,
            10000
        )

        self.resultado = QLabel(
            "0,00%"
        )
        self.resultado.setObjectName(
            "resultValue"
        )
        self.resultado.setAlignment(
            Qt.AlignCenter
        )
        self.resultado.setMinimumHeight(
            38
        )

        campos = [
            (
                "Data",
                self.data
            ),
            (
                "Questões",
                self.questoes
            ),
            (
                "Acertos",
                self.acertos
            ),
            (
                "Resultado",
                self.resultado
            )
        ]

        for coluna, (
            rotulo,
            campo
        ) in enumerate(
            campos
        ):
            label = QLabel(
                rotulo
            )
            label.setObjectName(
                "fieldLabel"
            )

            grade_sessao.addWidget(
                label,
                0,
                coluna
            )

            grade_sessao.addWidget(
                campo,
                1,
                coluna
            )

        card_sessao_layout.addLayout(
            grade_sessao
        )

        layout.addWidget(
            card_sessao
        )

        # ====================================================
        # CAMPOS DE TEXTO
        # ====================================================

        self.observacao = QTextEdit()
        self.observacao.setMaximumHeight(
            92
        )
        self.observacao.setPlaceholderText(
            "Anotações gerais sobre esta revisão..."
        )

        self.texto_erros = QTextEdit()
        self.texto_erros.setMaximumHeight(
            125
        )
        self.texto_erros.setPlaceholderText(
            "Registre os erros, dúvidas ou pontos que precisam ser revistos..."
        )

        self.continuacao = QTextEdit()
        self.continuacao.setMaximumHeight(
            92
        )
        self.continuacao.setPlaceholderText(
            "O que deve ser continuado ou retomado depois..."
        )

        if modo_edicao and revisao is not None:
            self.data.setDate(
                QDate.fromString(
                    revisao[1],
                    "yyyy-MM-dd"
                )
            )
            self.questoes.setValue(
                revisao[2]
            )
            self.acertos.setValue(
                revisao[3]
            )
            self.observacao.setPlainText(
                revisao[5] or ""
            )
            self.texto_erros.setPlainText(
                revisao[6] or ""
            )
            self.continuacao.setPlainText(
                revisao[7] or ""
            )

        else:
            self.data.setDate(
                QDate.currentDate()
            )
            self.questoes.setValue(
                30
            )
            self.acertos.setValue(
                0
            )

        # ====================================================
        # CARD — AGENDAMENTO E SUGESTÃO
        # ====================================================

        self.agendar = QCheckBox(
            "Agendar próxima revisão"
        )

        self.proxima_revisao = QDateEdit()
        self.proxima_revisao.setCalendarPopup(
            True
        )
        self.proxima_revisao.setDisplayFormat(
            "dd/MM/yyyy"
        )

        if not modo_edicao:
            self.agendar.setChecked(
                True
            )

            self.proxima_revisao.setDate(
                QDate.currentDate().addDays(
                    7
                )
            )

            self.painel_sugestao = QFrame()
            self.painel_sugestao.setObjectName(
                "suggestionCard"
            )

            painel_layout = QVBoxLayout(
                self.painel_sugestao
            )
            painel_layout.setContentsMargins(
                16,
                13,
                16,
                14
            )
            painel_layout.setSpacing(
                7
            )

            cabecalho_agenda = QHBoxLayout()

            self.titulo_sugestao = QLabel(
                "Próxima revisão"
            )
            self.titulo_sugestao.setObjectName(
                "sectionTitle"
            )

            cabecalho_agenda.addWidget(
                self.titulo_sugestao
            )
            cabecalho_agenda.addStretch()
            cabecalho_agenda.addWidget(
                self.agendar
            )

            painel_layout.addLayout(
                cabecalho_agenda
            )

            self.faixa_sugerida = QLabel()
            self.faixa_sugerida.setWordWrap(
                True
            )
            self.faixa_sugerida.setObjectName(
                "mutedLabel"
            )

            self.intervalo_sugerido = QLabel()
            self.intervalo_sugerido.setWordWrap(
                True
            )
            self.intervalo_sugerido.setObjectName(
                "suggestionStrong"
            )

            self.ajuste_sugerido = QLabel()
            self.ajuste_sugerido.setWordWrap(
                True
            )
            self.ajuste_sugerido.setObjectName(
                "mutedLabel"
            )

            painel_layout.addWidget(
                self.faixa_sugerida
            )
            painel_layout.addWidget(
                self.intervalo_sugerido
            )
            painel_layout.addWidget(
                self.ajuste_sugerido
            )

            linha_data = QHBoxLayout()
            linha_data.setSpacing(
                8
            )

            rotulo_data = QLabel(
                "Data escolhida"
            )
            rotulo_data.setObjectName(
                "fieldLabel"
            )

            self.botao_usar_sugestao = QPushButton(
                "Usar sugestão"
            )
            self.botao_usar_sugestao.setObjectName(
                "subtleButton"
            )
            self.botao_usar_sugestao.clicked.connect(
                self.aplicar_sugestao
            )

            linha_data.addWidget(
                rotulo_data
            )
            linha_data.addWidget(
                self.proxima_revisao,
                1
            )
            linha_data.addWidget(
                self.botao_usar_sugestao
            )

            painel_layout.addLayout(
                linha_data
            )

            layout.addWidget(
                self.painel_sugestao
            )

        else:
            self.agendar.setChecked(
                False
            )
            self.agendar.setVisible(
                False
            )
            self.proxima_revisao.setVisible(
                False
            )

        # ====================================================
        # CARD — ANOTAÇÕES
        # ====================================================

        card_anotacoes = QFrame()
        card_anotacoes.setObjectName(
            "dialogCard"
        )

        anotacoes_layout = QVBoxLayout(
            card_anotacoes
        )
        anotacoes_layout.setContentsMargins(
            16,
            14,
            16,
            16
        )
        anotacoes_layout.setSpacing(
            9
        )

        titulo_anotacoes = QLabel(
            "Anotações da revisão"
        )
        titulo_anotacoes.setObjectName(
            "sectionTitle"
        )

        anotacoes_layout.addWidget(
            titulo_anotacoes
        )

        grade_textos = QGridLayout()
        grade_textos.setHorizontalSpacing(
            12
        )
        grade_textos.setVerticalSpacing(
            6
        )

        grade_textos.setColumnStretch(
            0,
            1
        )
        grade_textos.setColumnStretch(
            1,
            1
        )

        label_obs = QLabel(
            "Observação"
        )
        label_obs.setObjectName(
            "fieldLabel"
        )

        label_cont = QLabel(
            "Continuação"
        )
        label_cont.setObjectName(
            "fieldLabel"
        )

        label_erros = QLabel(
            "Texto de erros"
        )
        label_erros.setObjectName(
            "fieldLabel"
        )

        grade_textos.addWidget(
            label_obs,
            0,
            0
        )
        grade_textos.addWidget(
            label_cont,
            0,
            1
        )
        grade_textos.addWidget(
            self.observacao,
            1,
            0
        )
        grade_textos.addWidget(
            self.continuacao,
            1,
            1
        )

        grade_textos.addWidget(
            label_erros,
            2,
            0,
            1,
            2
        )
        grade_textos.addWidget(
            self.texto_erros,
            3,
            0,
            1,
            2
        )

        anotacoes_layout.addLayout(
            grade_textos
        )

        layout.addWidget(
            card_anotacoes
        )

        layout.addStretch()

        scroll.setWidget(
            conteudo
        )

        raiz.addWidget(
            scroll,
            1
        )

        # ====================================================
        # AÇÕES
        # ====================================================

        botoes = QDialogButtonBox(
            QDialogButtonBox.Save |
            QDialogButtonBox.Cancel
        )

        botao_salvar = botoes.button(
            QDialogButtonBox.Save
        )
        botao_cancelar = botoes.button(
            QDialogButtonBox.Cancel
        )

        if modo_edicao:
            botao_salvar.setText(
                "Salvar alterações"
            )
        else:
            botao_salvar.setText(
                "Registrar revisão manual"
            )

        botao_salvar.setObjectName(
            "primaryButton"
        )
        botao_salvar.setMinimumWidth(
            135
        )

        botao_cancelar.setText(
            "Cancelar"
        )
        botao_cancelar.setObjectName(
            "subtleButton"
        )

        botoes.accepted.connect(
            self.salvar
        )
        botoes.rejected.connect(
            self.reject
        )

        raiz.addWidget(
            botoes
        )

        # ====================================================
        # EVENTOS
        # ====================================================

        self.questoes.valueChanged.connect(
            self.atualizar_calculos
        )
        self.acertos.valueChanged.connect(
            self.atualizar_calculos
        )

        if not modo_edicao:
            self.data.dateChanged.connect(
                self.atualizar_sugestao
            )

            self.agendar.toggled.connect(
                self.alternar_agendamento
            )

            self.proxima_revisao.dateChanged.connect(
                self.data_proxima_alterada
            )

        self.atualizar_calculos()

    def atualizar_calculos(self):
        questoes = self.questoes.value()

        self.acertos.setMaximum(
            questoes
        )

        percentual = (
            self.acertos.value() /
            questoes
        ) * 100

        self.resultado.setText(
            formatar_percentual(
                percentual,
                2
            )
        )

        if not self.modo_edicao:
            self.atualizar_sugestao()

    def atualizar_sugestao(self):
        if self.modo_edicao:
            return

        questoes = self.questoes.value()

        if questoes <= 0:
            return

        percentual_atual = (
            self.acertos.value() /
            questoes
        ) * 100

        sugestao = calcular_sugestao_espacamento(
            numero_revisao=self.numero_revisao,
            percentual_atual=percentual_atual,
            percentual_anterior=self.percentual_anterior,
            aplicar_penalizacao=self.aplicar_penalizacao_queda,
            tabela_espacamento=self.config_espacamento[
                "tabela"
            ],
            limite_queda_moderada=self.config_espacamento[
                "limite_moderada"
            ],
            limite_queda_forte=self.config_espacamento[
                "limite_forte"
            ],
            penalizacao_moderada=self.config_espacamento[
                "penalizacao_moderada"
            ],
            penalizacao_forte=self.config_espacamento[
                "penalizacao_forte"
            ]
        )

        self.sugestao_atual = sugestao

        self.faixa_sugerida.setText(
            f"Desempenho: "
            f"{formatar_percentual(percentual_atual, 2)} • "
            f"Faixa da {self.numero_revisao}ª revisão: "
            f"{sugestao['faixa_min']}–"
            f"{sugestao['faixa_max']} dias."
        )

        data_sugerida = (
            self.data.date().addDays(
                sugestao["dias"]
            )
        )

        self.intervalo_sugerido.setText(
            f"Sugestão: {sugestao['dias']} dias → "
            f"{data_sugerida.toString('dd/MM/yyyy')}"
        )

        if not sugestao["penalizacao_ativada"]:
            self.ajuste_sugerido.setText(
                "Penalização por queda acentuada: "
                "desativada nas Configurações."
            )

        elif sugestao["penalizacao_percentual"] > 0:
            self.ajuste_sugerido.setText(
                f"Ajuste por queda de desempenho: "
                f"{sugestao['queda_pontos']:.1f} p.p. • "
                f"intervalo reduzido em "
                f"{sugestao['penalizacao_percentual']}%."
            )
        elif self.percentual_anterior is not None:
            self.ajuste_sugerido.setText(
                f"Resultado anterior: "
                f"{formatar_percentual(self.percentual_anterior, 1)} • "
                "sem penalização por queda acentuada."
            )
        else:
            self.ajuste_sugerido.setText(
                "Sem resultado anterior disponível para comparar."
            )

        if self.sugestao_em_uso:
            self._atualizando_data_sugerida = True
            self.proxima_revisao.setDate(
                data_sugerida
            )
            self._atualizando_data_sugerida = False

            self.botao_usar_sugestao.setText(
                "Sugestão aplicada"
            )
        else:
            self.botao_usar_sugestao.setText(
                "Usar sugestão"
            )

    def data_proxima_alterada(self):
        if self._atualizando_data_sugerida:
            return

        self.sugestao_em_uso = False

        if hasattr(
            self,
            "botao_usar_sugestao"
        ):
            self.botao_usar_sugestao.setText(
                "Usar sugestão"
            )

    def aplicar_sugestao(self):
        if not self.sugestao_atual:
            return

        self.sugestao_em_uso = True

        data_sugerida = (
            self.data.date().addDays(
                self.sugestao_atual["dias"]
            )
        )

        self._atualizando_data_sugerida = True
        self.proxima_revisao.setDate(
            data_sugerida
        )
        self._atualizando_data_sugerida = False

        self.botao_usar_sugestao.setText(
            "Sugestão aplicada"
        )

    def alternar_agendamento(self, marcado):
        self.proxima_revisao.setEnabled(
            marcado
        )
        self.botao_usar_sugestao.setEnabled(
            marcado
        )
        self.painel_sugestao.setEnabled(
            marcado
        )

    def salvar(self):
        if self.modo_edicao:
            atualizar_revisao(
                self.revisao[0],
                self.data.date().toString(
                    "yyyy-MM-dd"
                ),
                self.questoes.value(),
                self.acertos.value(),
                self.observacao.toPlainText(),
                self.texto_erros.toPlainText(),
                self.continuacao.toPlainText()
            )

        else:
            if self.agendar.isChecked():
                proxima = (
                    self.proxima_revisao
                    .date()
                    .toString("yyyy-MM-dd")
                )
            else:
                proxima = None

            registrar_revisao(
                self.topico_id,
                self.data.date().toString(
                    "yyyy-MM-dd"
                ),
                self.questoes.value(),
                self.acertos.value(),
                self.observacao.toPlainText(),
                self.texto_erros.toPlainText(),
                self.continuacao.toPlainText(),
                proxima,
                concurso_id=self.concurso_id,
            )

        self.accept()


class JanelaNovoTopicoEstruturado(QDialog):
    """Cria um tópico/título com um capítulo inicial opcional."""

    def __init__(self, disciplina_nome, parent=None):
        super().__init__(parent)
        self.disciplina_nome = str(disciplina_nome or "").strip()
        self.nome_topico = ""
        self.nome_capitulo = ""
        self.permite_capitulo = not eh_disciplina_ctb(self.disciplina_nome)

        self.setWindowTitle("Adicionar tópico")
        self.resize(760, 235 if self.permite_capitulo else 205)
        self.setMinimumWidth(660)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(22, 18, 22, 18)
        layout.setSpacing(12)

        titulo = QLabel("Adicionar tópico")
        titulo.setObjectName("pageTitle")
        layout.addWidget(titulo)

        if self.permite_capitulo:
            subtitulo = QLabel(
                "Informe o título do tópico e, se desejar, já cadastre o primeiro capítulo. "
                "Quando existir ao menos um capítulo, o Vighna exibirá o botão + ao lado do tópico."
            )
        else:
            subtitulo = QLabel(
                "No CTB, o capítulo legal é cadastrado diretamente como tópico estrutural."
            )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        layout.addWidget(subtitulo)

        campos = QGridLayout()
        campos.setHorizontalSpacing(12)
        campos.setVerticalSpacing(5)

        rotulo_topico = QLabel("Título / tópico")
        rotulo_topico.setObjectName("fieldLabel")
        self.campo_topico = QLineEdit()
        self.campo_topico.setPlaceholderText(
            "Ex.: TÍTULO II — Dos Direitos e Garantias Fundamentais"
        )
        self.campo_topico.setClearButtonEnabled(True)

        campos.addWidget(rotulo_topico, 0, 0)
        campos.addWidget(self.campo_topico, 1, 0)

        if self.permite_capitulo:
            rotulo_capitulo = QLabel("Capítulo inicial (opcional)")
            rotulo_capitulo.setObjectName("fieldLabel")
            self.campo_capitulo = QLineEdit()
            self.campo_capitulo.setPlaceholderText(
                "Ex.: CAPÍTULO I — Dos Direitos e Deveres Individuais e Coletivos"
            )
            self.campo_capitulo.setClearButtonEnabled(True)
            campos.addWidget(rotulo_capitulo, 0, 1)
            campos.addWidget(self.campo_capitulo, 1, 1)
            campos.setColumnStretch(0, 1)
            campos.setColumnStretch(1, 1)
        else:
            self.campo_capitulo = None
            campos.setColumnStretch(0, 1)

        layout.addLayout(campos)

        botoes = QDialogButtonBox(
            QDialogButtonBox.Save | QDialogButtonBox.Cancel
        )
        botao_salvar = botoes.button(QDialogButtonBox.Save)
        if botao_salvar is not None:
            botao_salvar.setText("Adicionar")
            botao_salvar.setObjectName("primaryButton")
        botoes.accepted.connect(self.validar_e_aceitar)
        botoes.rejected.connect(self.reject)
        layout.addWidget(botoes)

        self.campo_topico.setFocus()

    def validar_e_aceitar(self):
        nome_topico = self.campo_topico.text().strip()
        if not nome_topico:
            QMessageBox.information(
                self,
                "Título obrigatório",
                "Informe o título ou nome do tópico."
            )
            self.campo_topico.setFocus()
            return

        self.nome_topico = nome_topico
        self.nome_capitulo = (
            self.campo_capitulo.text().strip()
            if self.campo_capitulo is not None
            else ""
        )
        self.accept()


class JanelaCapitulosTopico(QDialog):
    """Gerencia a divisão interna de um título sem alterar sua agenda."""

    def __init__(self, topico_id, nome_topico, parent=None):
        super().__init__(parent)
        self.topico_id = int(topico_id)
        self.nome_topico = str(nome_topico)
        self.dados_capitulos = []

        self.setWindowTitle(f"Capítulos — {self.nome_topico}")
        self.resize(900, 560)
        self.setMinimumSize(720, 430)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(22, 18, 22, 20)
        layout.setSpacing(12)

        cabecalho = QHBoxLayout()
        titulos = QVBoxLayout()
        titulo = QLabel(self.nome_topico)
        titulo.setObjectName("pageTitle")
        subtitulo = QLabel(
            "Capítulos internos deste título. A dificuldade e o estado são definidos para o perfil atual."
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        titulos.addWidget(titulo)
        titulos.addWidget(subtitulo)
        cabecalho.addLayout(titulos, 1)

        adicionar = QPushButton("+ Adicionar capítulo")
        adicionar.setObjectName("primaryButton")
        adicionar.setFixedHeight(34)
        adicionar.clicked.connect(self.novo_capitulo)
        cabecalho.addWidget(adicionar)

        self.botao_renomear = QPushButton("Renomear")
        self.botao_renomear.setObjectName("toolbarButton")
        self.botao_renomear.setFixedHeight(34)
        self.botao_renomear.clicked.connect(self.renomear_capitulo_selecionado)
        cabecalho.addWidget(self.botao_renomear)

        self.botao_estado = QPushButton("Desligar capítulo")
        self.botao_estado.setObjectName("toolbarButton")
        self.botao_estado.setFixedHeight(34)
        self.botao_estado.clicked.connect(self.alternar_estado_capitulo_selecionado)
        cabecalho.addWidget(self.botao_estado)
        layout.addLayout(cabecalho)

        aviso = QLabel(
            "A desativação preserva o capítulo e sua dificuldade; ele pode ser reativado a qualquer momento."
        )
        aviso.setObjectName("infoNotice")
        aviso.setWordWrap(True)
        layout.addWidget(aviso)

        self.tabela = QTableWidget()
        self.tabela.setColumnCount(3)
        self.tabela.setHorizontalHeaderLabels([
            "Capítulo",
            "Dificuldade",
            "Estado",
        ])
        self.tabela.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.tabela.setSelectionMode(QAbstractItemView.SingleSelection)
        self.tabela.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.tabela.setAlternatingRowColors(True)
        self.tabela.setShowGrid(False)
        self.tabela.verticalHeader().setVisible(False)
        self.tabela.horizontalHeader().setSectionResizeMode(0, QHeaderView.Stretch)
        self.tabela.setColumnWidth(1, 165)
        self.tabela.setColumnWidth(2, 120)
        self.tabela.itemSelectionChanged.connect(self.atualizar_botoes)
        layout.addWidget(self.tabela, 1)

        botoes = QDialogButtonBox(QDialogButtonBox.Close)
        botoes.rejected.connect(self.reject)
        botoes.accepted.connect(self.accept)
        layout.addWidget(botoes)

        self.carregar_capitulos()

    def carregar_capitulos(self):
        self.dados_capitulos = listar_capitulos_topico(self.topico_id)
        self.tabela.setRowCount(len(self.dados_capitulos))

        for linha, dado in enumerate(self.dados_capitulos):
            capitulo_id, nome, _ordem, dificuldade, pausado = dado
            pausado = bool(pausado)

            item_nome = QTableWidgetItem(nome)
            item_nome.setData(Qt.UserRole, capitulo_id)
            item_nome.setData(Qt.UserRole + 1, pausado)
            self.tabela.setItem(linha, 0, item_nome)

            seletor = SeletorEstrelas(
                valor=int(dificuldade),
                ao_alterar=(
                    lambda novo_valor, cid=capitulo_id:
                    self.alterar_dificuldade(cid, novo_valor)
                )
            )
            seletor.setToolTip(
                "Clique em uma estrela para definir a dificuldade deste capítulo."
            )
            seletor.setEnabled(not pausado)
            if pausado:
                seletor.setToolTip(
                    "Capítulo desligado. Reative-o para alterar a dificuldade."
                )
            self.tabela.setCellWidget(linha, 1, seletor)

            item_estado = QTableWidgetItem("Desligado" if pausado else "Ativo")
            item_estado.setTextAlignment(Qt.AlignCenter)
            self.tabela.setItem(linha, 2, item_estado)

            if pausado:
                for coluna in (0, 2):
                    aplicar_destaque_tabela(
                        self.tabela.item(linha, coluna),
                        "inativo",
                        True
                    )

            self.tabela.setRowHeight(linha, 34)

        self.atualizar_botoes()

    def obter_capitulo_selecionado(self):
        linha = self.tabela.currentRow()
        if linha < 0:
            return None, None, False
        item = self.tabela.item(linha, 0)
        if item is None:
            return None, None, False
        return (
            item.data(Qt.UserRole),
            item.text(),
            bool(item.data(Qt.UserRole + 1))
        )

    def atualizar_botoes(self):
        capitulo_id, _nome, pausado = self.obter_capitulo_selecionado()
        habilitado = capitulo_id is not None
        self.botao_renomear.setEnabled(habilitado)
        self.botao_estado.setEnabled(habilitado)
        self.botao_estado.setText(
            "Reativar capítulo" if pausado else "Desligar capítulo"
        )

    def alterar_dificuldade(self, capitulo_id, nova_dificuldade):
        if atualizar_dificuldade_capitulo(capitulo_id, nova_dificuldade):
            QTimer.singleShot(0, self.carregar_capitulos)

    def novo_capitulo(self):
        nome, confirmou = QInputDialog.getText(
            self,
            "Novo capítulo",
            f"Novo capítulo de {self.nome_topico}:"
        )
        if not confirmou or not nome.strip():
            return
        if adicionar_capitulo(self.topico_id, nome):
            self.carregar_capitulos()
        else:
            QMessageBox.information(
                self,
                "Capítulo existente",
                "Esse capítulo já está cadastrado neste título."
            )

    def renomear_capitulo_selecionado(self):
        capitulo_id, nome_atual, _pausado = self.obter_capitulo_selecionado()
        if capitulo_id is None:
            return
        novo_nome, confirmou = QInputDialog.getText(
            self,
            "Renomear capítulo",
            "Novo nome:",
            text=nome_atual
        )
        if not confirmou or not novo_nome.strip() or novo_nome.strip() == nome_atual:
            return
        if renomear_capitulo(capitulo_id, novo_nome):
            self.carregar_capitulos()
        else:
            QMessageBox.information(
                self,
                "Nome já utilizado",
                "Já existe um capítulo com esse nome neste título."
            )

    def alternar_estado_capitulo_selecionado(self):
        capitulo_id, nome, pausado = self.obter_capitulo_selecionado()
        if capitulo_id is None:
            return
        if not pausado:
            resposta = QMessageBox.question(
                self,
                "Desligar capítulo",
                (
                    f"Desligar temporariamente o capítulo:\n\n{nome}\n\n"
                    "A dificuldade continuará registrada para este perfil."
                ),
                QMessageBox.Yes | QMessageBox.No,
                QMessageBox.No
            )
            if resposta != QMessageBox.Yes:
                return
        if definir_capitulo_pausado(capitulo_id, not pausado):
            self.carregar_capitulos()



class JanelaEstudoTopico(QDialog):
    """Configura uma sessão usando exclusivamente questões de um tópico."""

    def __init__(self, topico_id, nome_topico, parent=None):
        super().__init__(parent)
        self.setWindowModality(Qt.WindowModal)
        self.topico_id = int(topico_id)
        self.nome_topico = str(nome_topico or "Tópico")
        self.concurso = obter_concurso_ativo()
        self.configuracao = None
        self.ids_manuais = set()
        self.atualizando_tabela = False

        self.setWindowTitle(f"Estudar tópico — {self.nome_topico}")
        self.resize(1040, 720)
        self.setMinimumSize(860, 620)
        self.setWindowFlag(Qt.WindowMinimizeButtonHint, True)
        self.setWindowFlag(Qt.WindowMaximizeButtonHint, True)

        perfil = obter_perfil_selecao_inteligente_questoes(
            self.concurso[0],
            topico_id=self.topico_id,
        )
        basicas = listar_questoes_resolucao(
            self.concurso[0],
            topico_id=self.topico_id,
            somente_ineditas=False,
            aleatorio=False,
        )
        mapa_basico = {int(item["id"]): item for item in basicas}
        self.candidatos = []
        for item in perfil.get("questoes", []):
            meta = mapa_basico.get(int(item["id"]), {})
            self.candidatos.append({**item, **meta})

        try:
            self.ciclo_atual = obter_ciclo_questoes_ativo(
                self.concurso[0],
                self.topico_id,
            )
        except Exception:
            self.ciclo_atual = None

        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 18, 20, 18)
        layout.setSpacing(12)

        topo = QFrame()
        topo.setObjectName("dialogCard")
        topo_layout = QVBoxLayout(topo)
        topo_layout.setContentsMargins(16, 14, 16, 14)
        topo_layout.setSpacing(4)

        eyebrow = QLabel("ESTUDAR TÓPICO")
        eyebrow.setObjectName("metricLabel")
        titulo = QLabel(self.nome_topico)
        titulo.setObjectName("pageTitle")
        titulo.setWordWrap(True)
        subtitulo = QLabel(
            "Monte uma bateria somente com questões deste tópico. "
            "Você pode ajustar quantidade, capítulo, dificuldade e forma de seleção antes de começar."
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        topo_layout.addWidget(eyebrow)
        topo_layout.addWidget(titulo)
        topo_layout.addWidget(subtitulo)
        layout.addWidget(topo)

        resumo = QHBoxLayout()
        resumo.setSpacing(10)

        def card_resumo(rotulo, valor):
            card = QFrame()
            card.setObjectName("metricCard")
            card_l = QVBoxLayout(card)
            card_l.setContentsMargins(12, 9, 12, 9)
            card_l.setSpacing(1)
            lab = QLabel(rotulo)
            lab.setObjectName("metricLabel")
            val = QLabel(str(valor))
            val.setObjectName("metricValue")
            card_l.addWidget(lab)
            card_l.addWidget(val)
            return card

        total = len(self.candidatos)
        ineditas = sum(1 for item in self.candidatos if item.get("inedita"))
        com_erro = sum(1 for item in self.candidatos if item.get("teve_erro"))
        resumo.addWidget(card_resumo("Questões disponíveis", total), 1)
        resumo.addWidget(card_resumo("Inéditas", ineditas), 1)
        resumo.addWidget(card_resumo("Com erro anterior", com_erro), 1)
        layout.addLayout(resumo)

        ciclo_card = QFrame()
        ciclo_card.setObjectName("dialogCard")
        ciclo_layout = QVBoxLayout(ciclo_card)
        ciclo_layout.setContentsMargins(16, 12, 16, 12)
        ciclo_layout.setSpacing(7)

        ciclo_topo = QHBoxLayout()
        ciclo_titulos = QVBoxLayout()
        ciclo_titulos.setSpacing(2)
        ciclo_titulo = QLabel("Ciclo de questões")
        ciclo_titulo.setObjectName("sectionTitle")
        self.ciclo_status = QLabel("")
        self.ciclo_status.setObjectName("mutedLabel")
        self.ciclo_status.setWordWrap(True)
        ciclo_titulos.addWidget(ciclo_titulo)
        ciclo_titulos.addWidget(self.ciclo_status)
        ciclo_topo.addLayout(ciclo_titulos, 1)

        self.ciclo_modo = QComboBox()
        self.ciclo_modo.setMinimumHeight(34)
        self.ciclo_modo.setMinimumWidth(300)
        ciclo_topo.addWidget(self.ciclo_modo, 0, Qt.AlignVCenter)

        self.ciclo_encerrar = QPushButton("Encerrar ciclo")
        self.ciclo_encerrar.setObjectName("subtleButton")
        self.ciclo_encerrar.setMinimumHeight(34)
        self.ciclo_encerrar.clicked.connect(self.encerrar_ciclo_atual)
        ciclo_topo.addWidget(self.ciclo_encerrar, 0, Qt.AlignVCenter)
        ciclo_layout.addLayout(ciclo_topo)

        self.ciclo_progresso = QProgressBar()
        self.ciclo_progresso.setRange(0, 100)
        self.ciclo_progresso.setTextVisible(True)
        self.ciclo_progresso.setMinimumHeight(16)
        ciclo_layout.addWidget(self.ciclo_progresso)
        layout.addWidget(ciclo_card)

        config_card = QFrame()
        config_card.setObjectName("dialogCard")
        config_layout = QGridLayout(config_card)
        config_layout.setContentsMargins(16, 13, 16, 13)
        config_layout.setHorizontalSpacing(12)
        config_layout.setVerticalSpacing(7)

        self.quantidade = QSpinBox()
        self.quantidade.setRange(1, max(1, total))
        self.quantidade.setValue(min(10, max(1, total)))
        self.quantidade.setSuffix(" questões")
        self.quantidade.setMinimumHeight(34)

        self.montagem = QComboBox()
        self.montagem.addItem("Prioridade Vighna", "inteligente")
        self.montagem.addItem("Aleatória", "aleatoria")
        self.montagem.addItem("Ordem do banco", "ordem")
        self.montagem.addItem("Selecionar manualmente", "manual")
        self.montagem.setMinimumHeight(34)

        self.estado = QComboBox()
        self.estado.addItem("Todas as questões", "todas")
        self.estado.addItem("Somente inéditas", "ineditas")
        self.estado.addItem("Já respondidas", "respondidas")
        self.estado.addItem("Com erro anterior", "erros")
        self.estado.setMinimumHeight(34)

        self.capitulo = QComboBox()
        self.capitulo.addItem("Todos os capítulos", None)
        capitulos = {}
        for item in self.candidatos:
            cap_id = item.get("capitulo_id")
            cap_nome = str(item.get("capitulo") or "").strip()
            if cap_id is not None and cap_nome:
                capitulos[int(cap_id)] = cap_nome
        for cap_id, cap_nome in sorted(capitulos.items(), key=lambda x: x[1].casefold()):
            self.capitulo.addItem(cap_nome, cap_id)
        self.capitulo.setEnabled(bool(capitulos))
        self.capitulo.setMinimumHeight(34)

        self.dificuldade = QComboBox()
        self.dificuldade.addItem("Todas as dificuldades", "todas")
        dificuldades = sorted({str(item.get("dificuldade") or "Não informada") for item in self.candidatos})
        for dificuldade in dificuldades:
            self.dificuldade.addItem(dificuldade, dificuldade)
        self.dificuldade.setMinimumHeight(34)

        campos = [
            ("Quantidade", self.quantidade),
            ("Montagem", self.montagem),
            ("Histórico", self.estado),
            ("Capítulo", self.capitulo),
            ("Dificuldade", self.dificuldade),
        ]
        for coluna, (rotulo, widget) in enumerate(campos):
            lab = QLabel(rotulo)
            lab.setObjectName("fieldLabel")
            config_layout.addWidget(lab, 0, coluna)
            config_layout.addWidget(widget, 1, coluna)
            config_layout.setColumnStretch(coluna, 1)
        layout.addWidget(config_card)

        lista_card = QFrame()
        lista_card.setObjectName("dialogCard")
        lista_layout = QVBoxLayout(lista_card)
        lista_layout.setContentsMargins(14, 12, 14, 12)
        lista_layout.setSpacing(8)

        cab_lista = QHBoxLayout()
        titulo_lista = QLabel("Questões do tópico")
        titulo_lista.setObjectName("sectionTitle")
        self.resumo_filtro = QLabel("")
        self.resumo_filtro.setObjectName("mutedLabel")
        cab_lista.addWidget(titulo_lista)
        cab_lista.addStretch(1)
        cab_lista.addWidget(self.resumo_filtro)
        lista_layout.addLayout(cab_lista)

        self.acoes_manuais = QWidget()
        acoes_manuais_layout = QHBoxLayout(self.acoes_manuais)
        acoes_manuais_layout.setContentsMargins(0, 0, 0, 0)
        acoes_manuais_layout.setSpacing(8)
        selecionar_todas = QPushButton("Selecionar visíveis")
        selecionar_todas.setObjectName("subtleButton")
        selecionar_todas.clicked.connect(self.selecionar_visiveis)
        limpar = QPushButton("Limpar seleção")
        limpar.setObjectName("subtleButton")
        limpar.clicked.connect(self.limpar_selecao)
        self.resumo_manual = QLabel("")
        self.resumo_manual.setObjectName("mutedLabel")
        acoes_manuais_layout.addWidget(selecionar_todas)
        acoes_manuais_layout.addWidget(limpar)
        acoes_manuais_layout.addWidget(self.resumo_manual)
        acoes_manuais_layout.addStretch(1)
        lista_layout.addWidget(self.acoes_manuais)

        self.tabela = QTableWidget()
        self.tabela.setColumnCount(6)
        self.tabela.setHorizontalHeaderLabels([
            "Usar", "ID", "Questão", "Capítulo", "Dificuldade", "Histórico"
        ])
        self.tabela.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.tabela.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.tabela.setSelectionMode(QAbstractItemView.SingleSelection)
        self.tabela.setAlternatingRowColors(True)
        self.tabela.setShowGrid(False)
        self.tabela.verticalHeader().setVisible(False)
        header = self.tabela.horizontalHeader()
        header.setSectionResizeMode(0, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(1, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(2, QHeaderView.Stretch)
        header.setSectionResizeMode(3, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(4, QHeaderView.ResizeToContents)
        header.setSectionResizeMode(5, QHeaderView.ResizeToContents)
        self.tabela.itemChanged.connect(self.alterar_check_manual)
        lista_layout.addWidget(self.tabela, 1)
        layout.addWidget(lista_card, 1)

        rodape_nota = QLabel(
            "Esta é uma sessão normal de estudo: respostas registradas aqui alimentam histórico, domínio, erros e revisões do Vighna."
        )
        rodape_nota.setObjectName("mutedLabel")
        rodape_nota.setWordWrap(True)
        layout.addWidget(rodape_nota)

        botoes = QDialogButtonBox(QDialogButtonBox.Cancel)
        self.iniciar = botoes.addButton("▶  Resolver questões", QDialogButtonBox.AcceptRole)
        self.iniciar.setObjectName("primaryButton")
        cancelar = botoes.button(QDialogButtonBox.Cancel)
        cancelar.setText("Cancelar")
        cancelar.setObjectName("subtleButton")
        self.iniciar.clicked.connect(self.confirmar)
        botoes.rejected.connect(self.reject)
        layout.addWidget(botoes)

        for widget in (self.montagem, self.estado, self.capitulo, self.dificuldade):
            widget.currentIndexChanged.connect(self.atualizar_lista)
        self.quantidade.valueChanged.connect(self.atualizar_resumo_inicio)
        self.ciclo_modo.currentIndexChanged.connect(self.alterar_modo_ciclo)

        self.recarregar_ciclo_ui()
        self.atualizar_lista()

    def recarregar_ciclo_ui(self, preferir=None):
        try:
            self.ciclo_atual = obter_ciclo_questoes_ativo(
                self.concurso[0],
                self.topico_id,
            )
        except Exception:
            self.ciclo_atual = None

        self.ciclo_modo.blockSignals(True)
        self.ciclo_modo.clear()
        if self.ciclo_atual and int(self.ciclo_atual.get("pendentes") or 0) > 0:
            pendentes = int(self.ciclo_atual.get("pendentes") or 0)
            self.ciclo_modo.addItem(
                f"Continuar ciclo atual ({pendentes} pendentes)",
                "continuar",
            )
            self.ciclo_modo.addItem("Bateria avulsa", "avulsa")
            alvo = preferir if preferir in {"continuar", "avulsa"} else "continuar"
        else:
            self.ciclo_modo.addItem("Bateria avulsa", "avulsa")
            self.ciclo_modo.addItem(
                "Iniciar novo ciclo com o conjunto filtrado",
                "novo",
            )
            alvo = preferir if preferir in {"avulsa", "novo"} else "avulsa"

        indice = self.ciclo_modo.findData(alvo)
        if indice >= 0:
            self.ciclo_modo.setCurrentIndex(indice)
        self.ciclo_modo.blockSignals(False)

        if self.ciclo_atual and self.ciclo_atual.get("status") == "ativo":
            total = int(self.ciclo_atual.get("total") or 0)
            respondidas = int(self.ciclo_atual.get("respondidas") or 0)
            pendentes = int(self.ciclo_atual.get("pendentes") or 0)
            indisponiveis = int(self.ciclo_atual.get("indisponiveis") or 0)
            detalhe_indisponiveis = (
                f" • {indisponiveis} indisponível(is)"
                if indisponiveis
                else ""
            )
            self.ciclo_status.setText(
                f"Ciclo em andamento: {respondidas}/{total} respondidas • "
                f"{pendentes} pendentes{detalhe_indisponiveis}. "
                "Questões novas importadas depois do início ficam para o próximo ciclo."
            )
            percentual = int(round(float(self.ciclo_atual.get("percentual") or 0.0)))
            self.ciclo_progresso.setValue(max(0, min(100, percentual)))
            self.ciclo_progresso.setFormat(f"{respondidas}/{total} • %p%")
            self.ciclo_progresso.setVisible(True)
            self.ciclo_encerrar.setVisible(True)
        else:
            self.ciclo_status.setText(
                "Sem ciclo em andamento. Você pode iniciar uma rodada persistente "
                "com o conjunto filtrado e continuar em outro dia apenas com as pendentes."
            )
            self.ciclo_progresso.setVisible(False)
            self.ciclo_encerrar.setVisible(False)

        self.atualizar_estado_filtros_ciclo()

    def alterar_modo_ciclo(self):
        self.ids_manuais.clear()
        self.atualizar_estado_filtros_ciclo()
        self.atualizar_lista()

    def atualizar_estado_filtros_ciclo(self):
        continuar = (
            hasattr(self, "ciclo_modo")
            and self.ciclo_modo.currentData() == "continuar"
            and self.ciclo_atual is not None
        )
        self.estado.setEnabled(not continuar)
        self.capitulo.setEnabled(not continuar and self.capitulo.count() > 1)
        self.dificuldade.setEnabled(not continuar)
        if continuar:
            self.estado.setToolTip(
                "No ciclo atual, o conjunto já está congelado; são exibidas apenas as pendentes."
            )
            self.capitulo.setToolTip(
                "O capítulo foi congelado quando o ciclo foi criado."
            )
            self.dificuldade.setToolTip(
                "A dificuldade foi congelada quando o ciclo foi criado."
            )
        else:
            self.estado.setToolTip("")
            self.capitulo.setToolTip("")
            self.dificuldade.setToolTip("")

    def encerrar_ciclo_atual(self):
        if not self.ciclo_atual:
            return
        resposta = QMessageBox.question(
            self,
            "Encerrar ciclo",
            (
                "Encerrar o ciclo atual?\n\n"
                "O histórico e as respostas já registradas serão preservados. "
                "Depois você poderá iniciar um novo ciclo com outro conjunto de questões."
            ),
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No,
        )
        if resposta != QMessageBox.Yes:
            return
        try:
            encerrar_ciclo_questoes(
                self.ciclo_atual["id"],
                motivo="encerrado_manual_interface",
            )
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Encerrar ciclo",
                "Não foi possível encerrar o ciclo.\n\n" + str(erro),
            )
            return
        self.recarregar_ciclo_ui(preferir="avulsa")
        self.atualizar_lista()

    def candidatos_filtrados(self):
        if (
            hasattr(self, "ciclo_modo")
            and self.ciclo_modo.currentData() == "continuar"
            and self.ciclo_atual is not None
        ):
            pendentes = {
                int(qid)
                for qid in self.ciclo_atual.get("ids_pendentes", [])
            }
            return [
                item
                for item in self.candidatos
                if int(item.get("id") or -1) in pendentes
            ]

        estado = self.estado.currentData()
        capitulo_id = self.capitulo.currentData()
        dificuldade = self.dificuldade.currentData()
        resultado = []
        for item in self.candidatos:
            if estado == "ineditas" and not item.get("inedita"):
                continue
            if estado == "respondidas" and item.get("inedita"):
                continue
            if estado == "erros" and not item.get("teve_erro"):
                continue
            if capitulo_id is not None and int(item.get("capitulo_id") or -1) != int(capitulo_id):
                continue
            if dificuldade != "todas" and str(item.get("dificuldade") or "Não informada") != str(dificuldade):
                continue
            resultado.append(item)
        return resultado

    def atualizar_lista(self):
        candidatos = self.candidatos_filtrados()
        ids_visiveis = {int(item["id"]) for item in candidatos}
        self.ids_manuais.intersection_update(ids_visiveis)
        maximo = max(1, len(candidatos))
        self.quantidade.setMaximum(maximo)
        if candidatos and self.quantidade.value() > len(candidatos):
            self.quantidade.setValue(len(candidatos))

        manual = self.montagem.currentData() == "manual"
        self.quantidade.setEnabled(not manual and bool(candidatos))
        self.acoes_manuais.setVisible(manual)
        self.tabela.setColumnHidden(0, not manual)

        self.atualizando_tabela = True
        self.tabela.setRowCount(len(candidatos))
        for linha, item in enumerate(candidatos):
            marcar = QTableWidgetItem("")
            marcar.setFlags(Qt.ItemIsEnabled | Qt.ItemIsUserCheckable)
            marcar.setCheckState(Qt.Checked if int(item["id"]) in self.ids_manuais else Qt.Unchecked)
            self.tabela.setItem(linha, 0, marcar)

            valores = [
                str(item.get("id") or "—"),
                str(item.get("enunciado") or "—"),
                str(item.get("capitulo") or "—"),
                str(item.get("dificuldade") or "Não informada"),
                self.rotulo_historico(item),
            ]
            for coluna, valor in enumerate(valores, start=1):
                celula = QTableWidgetItem(valor)
                if coluna == 1:
                    celula.setTextAlignment(Qt.AlignCenter)
                self.tabela.setItem(linha, coluna, celula)
            self.tabela.setRowHeight(linha, 34)
        self.atualizando_tabela = False

        ineditas = sum(1 for item in candidatos if item.get("inedita"))
        erros = sum(1 for item in candidatos if item.get("teve_erro"))
        if (
            hasattr(self, "ciclo_modo")
            and self.ciclo_modo.currentData() == "continuar"
        ):
            self.resumo_filtro.setText(
                f"{len(candidatos)} pendentes do ciclo • {ineditas} inéditas no histórico • {erros} com erro"
            )
        else:
            self.resumo_filtro.setText(
                f"{len(candidatos)} disponíveis • {ineditas} inéditas • {erros} com erro"
            )
        self.atualizar_resumo_inicio()

    @staticmethod
    def rotulo_historico(item):
        if item.get("inedita"):
            return "Inédita"
        categoria = str(item.get("categoria_rotulo") or "Já respondida")
        tentativas = int(item.get("tentativas_anteriores") or item.get("tentativas") or 0)
        return f"{categoria} • {tentativas}x" if tentativas else categoria

    def alterar_check_manual(self, item):
        if self.atualizando_tabela or item.column() != 0:
            return
        linha = item.row()
        candidatos = self.candidatos_filtrados()
        if linha < 0 or linha >= len(candidatos):
            return
        questao_id = int(candidatos[linha]["id"])
        if item.checkState() == Qt.Checked:
            self.ids_manuais.add(questao_id)
        else:
            self.ids_manuais.discard(questao_id)
        self.atualizar_resumo_inicio()

    def selecionar_visiveis(self):
        self.ids_manuais = {int(item["id"]) for item in self.candidatos_filtrados()}
        self.atualizar_lista()

    def limpar_selecao(self):
        self.ids_manuais.clear()
        self.atualizar_lista()

    def atualizar_resumo_inicio(self):
        candidatos = self.candidatos_filtrados()
        manual = self.montagem.currentData() == "manual"
        quantidade = len(self.ids_manuais) if manual else min(self.quantidade.value(), len(candidatos))
        self.resumo_manual.setText(f"{len(self.ids_manuais)} selecionada(s)")
        self.iniciar.setEnabled(quantidade > 0)
        prefixo = (
            "▶  Continuar ciclo • "
            if hasattr(self, "ciclo_modo") and self.ciclo_modo.currentData() == "continuar"
            else "▶  Resolver "
        )
        self.iniciar.setText(
            prefixo + f"{quantidade} questão" + ("" if quantidade == 1 else "ões")
        )

    def montar_fila(self):
        candidatos = self.candidatos_filtrados()
        if not candidatos:
            return []
        modo = self.montagem.currentData()
        if modo == "manual":
            return [item for item in candidatos if int(item["id"]) in self.ids_manuais]

        quantidade = min(self.quantidade.value(), len(candidatos))
        if modo == "aleatoria":
            return random.sample(candidatos, quantidade)
        if modo == "ordem":
            return sorted(candidatos, key=lambda item: int(item["id"]))[:quantidade]

        selecao = selecionar_questoes_inteligentes(
            self.concurso[0],
            topico_id=self.topico_id,
            quantidade=max(1, len(self.candidatos)),
        )
        ordem = [int(item["id"]) for item in selecao.get("fila", [])]
        por_id = {int(item["id"]): item for item in candidatos}
        fila = [por_id[qid] for qid in ordem if qid in por_id]
        faltantes = [
            item for item in candidatos
            if int(item["id"]) not in {int(q["id"]) for q in fila}
        ]
        faltantes.sort(key=lambda item: float(item.get("prioridade_base") or 0.0), reverse=True)
        fila.extend(faltantes)
        return fila[:quantidade]

    def confirmar(self):
        modo_ciclo = str(self.ciclo_modo.currentData() or "avulsa")
        fila = self.montar_fila()
        if not fila:
            titulo = "Continuar ciclo" if modo_ciclo == "continuar" else "Estudar tópico"
            mensagem = (
                "Não há questões pendentes disponíveis neste ciclo."
                if modo_ciclo == "continuar"
                else "Nenhuma questão foi selecionada para esta bateria."
            )
            QMessageBox.information(self, titulo, mensagem)
            return

        montagem = str(self.montagem.currentData() or "inteligente")
        ciclo_id = None

        if modo_ciclo == "continuar":
            if not self.ciclo_atual:
                QMessageBox.information(
                    self,
                    "Continuar ciclo",
                    "O ciclo não está mais disponível. Reabra esta janela para atualizar o estado.",
                )
                return
            ciclo_id = int(self.ciclo_atual["id"])

        elif modo_ciclo == "novo":
            candidatos_ciclo = self.candidatos_filtrados()
            if montagem == "manual":
                ids_ciclo = [
                    int(item["id"])
                    for item in candidatos_ciclo
                    if int(item["id"]) in self.ids_manuais
                ]
            else:
                ids_ciclo = [int(item["id"]) for item in candidatos_ciclo]

            if not ids_ciclo:
                QMessageBox.information(
                    self,
                    "Iniciar ciclo",
                    "O conjunto filtrado não possui questões para formar um ciclo.",
                )
                return

            try:
                ciclo = criar_ciclo_questoes(
                    self.concurso[0],
                    self.topico_id,
                    ids_ciclo,
                    origem="topico_estudo",
                    filtros={
                        "montagem": montagem,
                        "estado": self.estado.currentData(),
                        "capitulo_id": self.capitulo.currentData(),
                        "dificuldade": self.dificuldade.currentData(),
                        "quantidade_primeira_bateria": len(fila),
                    },
                )
                ciclo_id = int(ciclo["id"])
                self.ciclo_atual = ciclo
            except Exception as erro:
                QMessageBox.critical(
                    self,
                    "Iniciar ciclo",
                    "Não foi possível criar o ciclo de questões.\n\n" + str(erro),
                )
                return

        primeiro = fila[0]
        rotulo_montagem = {
            "inteligente": "Prioridade Vighna",
            "aleatoria": "Aleatória",
            "ordem": "Ordem do banco",
            "manual": "Seleção manual",
        }.get(montagem, "Prioridade Vighna")
        rotulo_ciclo = (
            " • Ciclo"
            if ciclo_id is not None
            else ""
        )

        self.configuracao = {
            "concurso_id": self.concurso[0],
            "concurso_nome": self.concurso[1],
            "disciplina_id": primeiro.get("disciplina_id"),
            "disciplina_nome": primeiro.get("disciplina"),
            "topico_id": self.topico_id,
            "topico_nome": self.nome_topico,
            "modo": f"Estudo do tópico{rotulo_ciclo} • {rotulo_montagem}",
            "origem_sessao": "topico_estudo",
            "quantidade": len(fila),
            "fila": fila,
            "feedback_imediato": True,
            "integrar_revisoes": True,
            "ciclo_questoes_id": ciclo_id,
            "ciclo_questoes_modo": modo_ciclo,
            "filtros_estudo_topico": {
                "montagem": montagem,
                "estado": self.estado.currentData(),
                "capitulo_id": self.capitulo.currentData(),
                "dificuldade": self.dificuldade.currentData(),
                "ciclo": modo_ciclo,
            },
        }
        self.accept()



class JanelaTopico(QDialog):
    def __init__(
        self,
        topico_id,
        nome_topico,
        parent=None
    ):
        super().__init__(
            parent
        )

        # A página do tópico funciona como uma janela operacional independente:
        # ela pode permanecer aberta enquanto o usuário navega pelo restante do
        # Vighna e usa os controles nativos do Windows para minimizar/maximizar.
        self.setWindowFlag(
            Qt.WindowMinimizeButtonHint,
            True
        )
        self.setWindowFlag(
            Qt.WindowMaximizeButtonHint,
            True
        )
        self.setWindowModality(Qt.NonModal)
        self.setObjectName("topicDetailsDialog")

        self.topico_id = int(topico_id)
        self.nome_topico = nome_topico
        self.dados_revisoes = []
        self.contexto_topico = obter_contexto_topico(self.topico_id) or {}

        self.setWindowTitle(
            f"Tópico — {nome_topico}"
        )
        self.resize(1120, 720)
        self.setMinimumSize(900, 620)

        # Topic Premium: header independent from the analysis and operational metrics.
        # All source data and actions retain their original contracts.
        layout = QVBoxLayout(self)
        layout.setContentsMargins(17, 13, 17, 13)
        layout.setSpacing(8)

        hero_card = QFrame(self)
        hero_card.setObjectName("topicHeroCard")
        hero_layout = QVBoxLayout(hero_card)
        hero_layout.setContentsMargins(9, 6, 9, 8)
        hero_layout.setSpacing(3)
        hero_topo = QHBoxLayout()
        hero_topo.setSpacing(12)
        bloco_titulo = QVBoxLayout()
        bloco_titulo.setSpacing(2)
        self.topico_breadcrumb = QLabel("Conteúdo de estudo")
        self.topico_breadcrumb.setObjectName("topicBreadcrumb")
        self.topico_breadcrumb.setWordWrap(True)
        titulo = QLabel(nome_topico)
        titulo.setObjectName("topicHeroTitle")
        titulo.setWordWrap(True)
        self.topico_contexto_label = QLabel("Importância e revisões registradas")
        self.topico_contexto_label.setObjectName("topicHeroSubtitle")
        self.topico_contexto_label.setWordWrap(True)
        bloco_titulo.addWidget(self.topico_breadcrumb)
        bloco_titulo.addWidget(titulo)
        bloco_titulo.addWidget(self.topico_contexto_label)
        hero_topo.addLayout(bloco_titulo, 1)
        acoes_topo = QHBoxLayout()
        acoes_topo.setSpacing(7)
        self.botao_ver_questoes_topico = QPushButton("Ver questões")
        self.botao_ver_questoes_topico.setObjectName("topicQuestionsButton")
        self.botao_ver_questoes_topico.setFixedHeight(36)
        self.botao_ver_questoes_topico.setMinimumWidth(106)
        self.botao_ver_questoes_topico.clicked.connect(self.ver_questoes_topico)
        self.botao_ver_questoes_topico.setToolTip("Abrir o banco filtrado neste tópico.")
