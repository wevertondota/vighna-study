        QPushButton#subtleButton[sessionNavigation="true"]:disabled,
        QPushButton#questionSessionFocusButton:disabled,
        QPushButton#questionSessionPauseButton:disabled,
        QPushButton#questionSessionEndButton:disabled {
            background-color: #2E3746; color: #B5C0C3;
            border-color: #41556F;
        }
        /* B04 / navegação, eliminação, acesso ao mapa da sessão. */
        QToolButton#questionSolverHistoryPrevButton:focus,
        QToolButton#questionSolverHistoryMapButton:focus,
        QToolButton#questionSolverHistoryNextButton:focus,
        QToolButton#questionSolverEliminateButton:focus,
        QPushButton#questionSolverReturnCurrentButton:focus {
            border: 2px solid #B49269;
        }
        QToolButton#questionSolverEliminateButton:pressed,
        QToolButton#questionSolverHistoryPrevButton:pressed,
        QToolButton#questionSolverHistoryMapButton:pressed,
        QToolButton#questionSolverHistoryNextButton:pressed {
            background-color: #14283E;
        }
        /* B04 / rodapé: hierarquia clara sem redesenhar os controles. */
        QPushButton#questionSessionSkipButton {
            background-color: rgba(20, 40, 62, 242);
            color: #E4F2FA; border-color: #41556F;
        }
        QPushButton#questionSessionSkipButton:hover {
            background-color: #24435B; border-color: #4FB2E5;
        }
        QPushButton#questionSessionSkipButton:pressed {
            background-color: #14283E;
        }
        QPushButton#primaryButton {
            background-color: #3179BF; color: #E4F2FA;
            border-color: #4FB2E5;
        }
        QPushButton#primaryButton:hover {
            background-color: #3B8ACD; color: #FFFFFF;
        }
        QPushButton#primaryButton:pressed {
            background-color: #275F91;
        }
        QPushButton#primaryButton:focus,
        QPushButton#questionSessionSkipButton:focus {
            border: 2px solid #B49269;
        }
        QPushButton#primaryButton:disabled,
        QPushButton#questionSessionSkipButton:disabled {
            background-color: #2E3746; border-color: #41556F;
            color: #B5C0C3;
        }
        QCheckBox#questionSessionDoubt { color: #E4F2FA; }
        """
        # B05: tipografia de leitura (somente Futurista). Não altera fontes
        # dos botões, editor, feedback semântico ou ferramentas da caneta.
        if tema == "futurista":
            qss += r"""
        QLabel#questionSolverStatement { font-size: 15px; }
        QLabel#questionSolverAlternativeText { font-size: 14px; }
        QLabel#questionSolverDiscipline { font-size: 10px; font-weight: 800; }
        QLabel#questionSolverMeta { font-size: 11px; }
        QLabel#questionSolverQuestionIndex { font-size: 12px; }
        /* B12: acabamento da linha única, sem estilos em outras telas. */
        QFrame#questionSessionModernHeader {
            background-color: rgba(4, 9, 17, 231);
            border: none; border-bottom: 1px solid #41556F;
        }
        QFrame#questionSessionOverviewCard {
            background-color: rgba(14, 25, 38, 244);
            border: 1px solid #41556F; border-radius: 9px;
        }
        QFrame#questionSessionMiniStat { background: transparent; border: none; }
        QLabel#questionSolverDiscipline {
            color: #4FB2E5; font-size: 12px; font-weight: 800;
        }
        QLabel#questionSolverMeta { font-size: 11px; color: #B5C0C3; }
        QScrollArea#questionSolverScroll QScrollBar:vertical {
            background-color: rgba(14, 25, 38, 180);
            width: 9px; margin: 0px;
        }
        QScrollArea#questionSolverScroll QScrollBar::handle:vertical {
            background-color: #41556F; border-radius: 4px;
            min-height: 30px;
        }
        QScrollArea#questionSolverScroll QScrollBar::handle:vertical:hover {
            background-color: #4FB2E5;
        }
        QScrollArea#questionSolverScroll QScrollBar::add-line:vertical,
        QScrollArea#questionSolverScroll QScrollBar::sub-line:vertical {
            height: 0px; border: none; background: transparent;
        }
            """
        for chave, valor in c.items():
            qss = qss.replace("__" + chave + "__", valor)
        if getattr(self, "_b14_modo_pb", False):
            qss = self._b14_converter_qss_para_pb(qss)
            if (getattr(self, "_b18_cor_alternativas_ativa", False)
                    and getattr(self, "_b18_cor_intensidade", 0) > 0):
                # Somente 3 seletores de fundo; nenhuma recolorizacao global.
                qss += self._b18_css_tinta_alternativas(
                    tema, c, self._b18_cor_intensidade)
        self.setStyleSheet(qss)
        if tema == "futurista":
            # A faixa possui QSS local próprio. Aplicar o acabamento diretamente
            # nela, após sua construção, garante a precedência correta.
            # Os callbacks, ícones vetoriais e quatro tintas não são alterados.
            faixa = getattr(self, "faixa_caneta", None)
            if faixa is not None:
                estilo_caneta = r"""
                QFrame#questionStudyInkRibbon {
                    background: transparent; border: none;
                }
                QScrollArea#questionStudyInkRibbonContent {
                    background: transparent; border: 0;
                }
                QFrame#questionStudyInkFloatingTools {
                    background-color: rgba(14, 25, 38, 242);
                    border: 1px solid #41556F; border-radius: 9px;
                }
                QToolButton#questionStudyInkReadMode,
                QToolButton#questionStudyInkTool,
                QToolButton#questionStudyInkColor,
                QToolButton#questionStudyInkWidth {
                    border: 1px solid transparent; border-radius: 7px;
                    background: transparent; padding: 0;
                }
                QToolButton#questionStudyInkReadMode {
                    border-color: #41556F; background: #14283E;
                }
                QToolButton#questionStudyInkReadMode:hover,
                QToolButton#questionStudyInkTool:hover,
                QToolButton#questionStudyInkColor:hover,
                QToolButton#questionStudyInkWidth:hover {
                    background: #24435B;
                }
                QToolButton#questionStudyInkReadMode:checked {
                    background: #14283E; border: 2px solid #4FB2E5;
                }
                QToolButton#questionStudyInkTool:checked {
                    background: #14283E; border: 1px solid #4FB2E5;
                }
                QToolButton#questionStudyInkColor:checked,
                QToolButton#questionStudyInkWidth:checked {
                    background: #2E3746; border: 1px solid #B49269;
                }
                QToolButton#questionStudyInkReadMode:focus,
                QToolButton#questionStudyInkTool:focus,
                QToolButton#questionStudyInkColor:focus,
                QToolButton#questionStudyInkWidth:focus,
                QToolButton#questionStudyInkUndo:focus,
                QToolButton#questionStudyInkClear:focus {
                    border: 2px solid #B49269;
                }
                QToolButton#questionStudyInkUndo,
                QToolButton#questionStudyInkClear {
                    background: #14283E; border: 1px solid #41556F;
                    border-radius: 7px; padding: 0;
                }
                QToolButton#questionStudyInkUndo:hover,
                QToolButton#questionStudyInkClear:hover {
                    background: #24435B; border-color: #4FB2E5;
                }
                QToolButton#questionStudyInkUndo:pressed,
                QToolButton#questionStudyInkClear:pressed {
                    background: #0E1926;
                }
                QToolButton#questionStudyInkUndo:disabled,
                QToolButton#questionStudyInkClear:disabled {
                    background: #2E3746; border-color: #41556F;
                }
                QScrollBar:horizontal { max-height: 6px; background: transparent; }
                QScrollBar::handle:horizontal {
                    background: #41556F; border-radius: 3px; min-width: 28px;
                }
                """
                if getattr(self, "_b14_modo_pb", False):
                    estilo_caneta = self._b14_converter_qss_para_pb(estilo_caneta)
                faixa.setStyleSheet(estilo_caneta)

    def _localizar_janela_principal(self):
        """Localiza a janela principal sem recriar vínculo Qt de propriedade."""
        candidatos = []
        origem = getattr(self, "controlador_origem", None)
        if origem is not None:
            candidatos.append(origem)
            try:
                principal_declarada = getattr(origem, "janela_principal", None)
            except RuntimeError:
                principal_declarada = None
            if principal_declarada is not None:
                candidatos.append(principal_declarada)

        visitados = set()
        for candidato in candidatos:
            atual = candidato
            while atual is not None and id(atual) not in visitados:
                visitados.add(id(atual))
                if (
                    callable(getattr(atual, "voltar_inicio", None))
                    and callable(getattr(atual, "abrir_ou_trazer_modo_foco", None))
                ):
                    return atual
                try:
                    atual = atual.parentWidget()
                except (RuntimeError, AttributeError):
                    atual = None

        app = QApplication.instance()
        if app is not None:
            for janela in app.topLevelWidgets():
                if (
                    callable(getattr(janela, "voltar_inicio", None))
                    and callable(getattr(janela, "abrir_ou_trazer_modo_foco", None))
                ):
                    return janela
        return None

    def _registrar_no_controlador_principal(self):
        principal = self._localizar_janela_principal()
        if principal is None:
            return
        registrar = getattr(principal, "registrar_janela_resolvedor_questoes", None)
        if callable(registrar):
            registrar(self)

    def ir_ao_dashboard(self):
        """Mantém a bateria viva, minimiza-a e devolve o foco ao Dashboard."""
        if not self.modo_simulado:
            self.pausar_cronometro_questao()
        self.showMinimized()

        principal = self._localizar_janela_principal()
        if principal is None:
            return
        principal.voltar_inicio()
        if principal.isMinimized():
            principal.showNormal()
        elif not principal.isVisible():
            principal.show()
        principal.raise_()
        principal.activateWindow()

    def _b21_iniciar_registro_pausa(self, minutos):
        """Conta uma pausa apenas depois do relógio de pausa ser criado."""
        if self._b21_pausa_ativa is not None:
            return
        entrada = {
            "numero": len(self._b21_historico_pausas) + 1,
            "horario_inicio": datetime.now().strftime("%H:%M"),
            "programado_segundos": max(0, int(minutos)) * 60,
            "inicio_monotonic": time.monotonic(),
            "duracao_segundos": 0,
        }
        self._b21_historico_pausas.append(entrada)
        self._b21_pausa_ativa = entrada

    def _b21_finalizar_registro_pausa(self):
        """Fecha uma única vez, inclusive quando a bateria é finalizada."""
        entrada = self._b21_pausa_ativa
        if entrada is None:
            return
        entrada["duracao_segundos"] = max(
            0, int(time.monotonic() - entrada["inicio_monotonic"])
        )
        entrada["horario_fim"] = datetime.now().strftime("%H:%M")
        self._b21_pausa_ativa = None

    def _b21_fotografia_pausas(self):
        """Histórico da sessão; tempo de pausa em andamento é atualizado."""
        agora = time.monotonic()
        lista = []
        for entrada in self._b21_historico_pausas:
            copia = {
                chave: valor for chave, valor in entrada.items()
                if chave != "inicio_monotonic"
            }
            if entrada is self._b21_pausa_ativa:
                copia["duracao_segundos"] = max(
                    0, int(agora - entrada["inicio_monotonic"])
                )
                copia["em_andamento"] = True
            lista.append(copia)
        return lista

    def abrir_pausa_programada(self):
        """Configura ou administra uma pausa sem sair da bateria atual."""
        self._t01_evento('pausa_abrir_configuracao')
        if self.finalizada:
            return
        if self._pausa_relogio is None and (
            self._editando_alternativas or self._editando_explicacao
        ):
            QMessageBox.information(
                self, "Programar pausa",
                "Salve ou cancele a edição em andamento antes de iniciar a pausa."
            )
            return
        if self._pausa_relogio is not None:
            if self._pausa_relogio.expirou():
                if self._pausa_aviso is not None:
                    self._pausa_aviso.exibir_prioritario()
                return
            janela = GerenciarPausa(self._pausa_relogio.segundos_restantes(), self)
            janela.exec()
            if janela.escolha == "retomar":
                self.encerrar_pausa_programada(trazer_bateria=True)
            elif janela.escolha == "adiar":
                self.adiar_pausa_programada()
            return

        anterior = self._pausa_config
        dialogo = ConfiguracaoPausa(
            minutos=anterior["minutos"], minimizar=anterior["minimizar"],
            som=anterior["som"], simulado=self.modo_simulado, parent=self,
        )
        if dialogo.exec() != QDialog.Accepted:
            return
        minutos = dialogo.duracao.value()
        minimizar = dialogo.minimizar.isChecked()
        som = dialogo.som.isChecked()
        self._pausa_config = {"minutos": minutos, "minimizar": minimizar, "som": som}
        self.iniciar_pausa_programada(minutos, minimizar=minimizar)

    def iniciar_pausa_programada(self, minutos, minimizar=False):
        self._b26_parar_navegacao()
        self._t01_evento('pausa_inicio')
        if self.finalizada or self._pausa_relogio is not None:
            return
        self._b22_parar_animacao()
        self._pausa_relogio = RelogioPausa(minutos)
        self._b21_iniciar_registro_pausa(minutos)
        self._pausa_minimizou = bool(minimizar)
        self.pausar_cronometro_questao()
        # Suspende o Modo Foco somente se estava em execução. Se já estava
        # pausado pelo usuário, não deve ser retomado por este recurso.
        self._pausa_foco_iniciada = None
        foco = self._janela_foco_ativa()
        if foco is not None:
            try:
                if foco.sessao_ativa and not foco.pausada:
                    foco.alternar_pausa()
                    self._pausa_foco_iniciada = foco
            except RuntimeError:
                pass
        # Desativa a interceptação do mouse durante a pausa sem apagar rabiscos.
        self.definir_ferramenta_caneta(None)
        controles = (
            self.duvida, self.botao_opcoes, self.botao_foco_topo,
            self.faixa_caneta, self.botao_pular,
            self.botao_confirmar, self.botao_proxima,
            self.alternativas_container, self.feedback_explicacao_editar,
            self.botao_editar_alternativas,
            self.botao_questao_anterior, self.botao_mapa_questoes,
            self.botao_questao_posterior, self.botao_voltar_questao_atual,
        )
        self._pausa_botoes_anteriores = {
            widget: widget.isEnabled() for widget in controles
        }
        for widget in controles:
            widget.setEnabled(False)
        self._aplicar_visual_pausa_programada(True)
        self._atualizar_visual_pausa_programada()
        self._pausa_timer.start()
        self.verificar_pausa_programada()
        if minimizar:
            self.showMinimized()

    def verificar_pausa_programada(self):
        self._t01_evento('pausa_verificar_timer', gravar=False)
        relogio = self._pausa_relogio
        if relogio is None or self.finalizada:
            return
        restantes = relogio.segundos_restantes()
        self.botao_pausa.setText(
            "Pausa · " + texto_contagem(restantes) if restantes else "Pausa encerrada!"
        )
        self.botao_pausa.setToolTip("Clique para administrar a pausa em andamento.")
        self._atualizar_visual_pausa_programada()
        if restantes or self._pausa_aviso is not None:
            return
        # B21: manter o timer existente para atualizar a duração real
        # enquanto a pausa estiver ativa; _pausa_aviso evita aviso duplicado.
        self._t01_evento('pausa_aviso_criar')
        aviso = AvisoPausaFinalizada()
        self._pausa_aviso = aviso
        aviso.retornar.connect(lambda: self.encerrar_pausa_programada(trazer_bateria=True))
        aviso.adiar.connect(self.adiar_pausa_programada)
        aviso.exibir_prioritario()
        self._t01_evento('pausa_aviso_exibido')
        if self._pausa_config["som"]:
            QApplication.beep()

    def _fechar_aviso_pausa(self):
        aviso = self._pausa_aviso
        self._pausa_aviso = None
        if aviso is not None:
            aviso.hide()
            aviso.deleteLater()

    def adiar_pausa_programada(self):
        self._t01_evento('pausa_adiar_inicio')
        if self._pausa_relogio is None:
            return
        self._fechar_aviso_pausa()
        self._pausa_relogio.adiar(5)
        # Prorrogação é parte da mesma pausa, não uma pausa adicional.
        if self._b21_pausa_ativa is not None:
            self._b21_pausa_ativa["programado_segundos"] += 5 * 60
        self._pausa_timer.start()
        self._aplicar_visual_pausa_programada(True)
        self.verificar_pausa_programada()
        self._t01_evento('pausa_adiar_concluido')

    def encerrar_pausa_programada(self, trazer_bateria=False):
        self._t01_evento('pausa_retornar_inicio' if trazer_bateria else 'pausa_encerrar_inicio')
        if self._pausa_relogio is None:
            return
        self._b21_finalizar_registro_pausa()
        self._pausa_timer.stop()
        self._fechar_aviso_pausa()
        self._pausa_relogio = None
        for widget, habilitado in self._pausa_botoes_anteriores.items():
            try:
                widget.setEnabled(habilitado)
            except RuntimeError:
                pass
        self._pausa_botoes_anteriores.clear()
        foco = self._pausa_foco_iniciada
        self._pausa_foco_iniciada = None
        if foco is not None:
            try:
                if foco.sessao_ativa and foco.pausada:
                    foco.alternar_pausa()
            except RuntimeError:
                pass
        self.atualizar_painel_foco()
        self._aplicar_visual_pausa_programada(False)
        self.botao_pausa.setText("Pausa")
        self.botao_pausa.setToolTip("Programar um descanso e receber um aviso sobre as demais janelas.")
        self._pausa_minimizou = False
        if trazer_bateria:
            if self.isMinimized():
                self.showNormal()
            elif not self.isVisible():
                self.show()
            self.raise_()
            self.activateWindow()
        # A janela pode ainda estar minimizada pelo usuário. Nesse caso,
        # somente a restauração normal retomará a medição.
        if not self.isMinimized():
            self.retomar_cronometro_questao()
        self._t01_evento('pausa_encerrada')

    def pausar_cronometro_questao(self):
        """Pausa só o tempo da questão; simulados cronometrados continuam correndo."""
        if self.modo_simulado or self.inicio_questao is None:
            return
        if self._questao_pausa_iniciada is None:
            self._questao_pausa_iniciada = datetime.now()

    def retomar_cronometro_questao(self):
        if self._modo_revisao_historico or self._pausa_relogio is not None:
            return
        if self._questao_pausa_iniciada is None:
            return
        self._questao_tempo_pausado += max(
            0.0,
            (datetime.now() - self._questao_pausa_iniciada).total_seconds(),
        )
        self._questao_pausa_iniciada = None

    def changeEvent(self, event):
        super().changeEvent(event)
        if event.type() != QEvent.WindowStateChange:
            return
        if self.isMinimized():
            self.pausar_cronometro_questao()
        else:
            self.retomar_cronometro_questao()

    def _notificar_dados_pos_sessao(self):
        """Invalida caches após uma sessão que realmente gravou respostas."""
        if self.sem_impacto_inteligencia or self._dados_pos_sessao_notificados:
            return

        resumo = self.resumo_final or {}
        try:
            respondidas = int(resumo.get("respondidas", 0) or 0)
        except Exception:
            respondidas = 0

        if respondidas <= 0 and not self.resultados_integracao:
            return

        if _notificar_dados_alterados_raiz(self, "tentativas"):
            self._dados_pos_sessao_notificados = True

    def _localizar_controlador_foco(self):
        principal = self._localizar_janela_principal()
        if principal is not None:
            return principal

        app = QApplication.instance()
        if app is not None:
            for janela in app.topLevelWidgets():
                if callable(getattr(janela, "abrir_ou_trazer_modo_foco", None)):
                    return janela
        return None

    def _janela_foco_ativa(self):
        controlador = self._localizar_controlador_foco()
        if controlador is None:
            return None
        return controlador.obter_janela_modo_foco(apenas_ativa=True)

    def _atualizar_botao_foco_topo(self, estado):
        """Atualiza a indicação apenas quando muda o estado, sem repolir a
        interface a cada segundo do cronômetro.
        """
        botao = getattr(self, "botao_foco_topo", None)
        if botao is None or self._estado_botao_foco_topo == estado:
            return
        self._estado_botao_foco_topo = estado
        if estado == "ativo":
            botao.setText("Foco ativo")
            botao.setToolTip("Foco em execução. Clique para abrir o painel existente.")
            botao.setStyleSheet(
                "QPushButton#questionSessionFocusButton {"
                "background: #173B32; color: #DDFBEE;"
                "border: 1px solid #43C99A; border-radius: 8px;"
                "padding: 0 10px; font-weight: 600; }"
                "QPushButton#questionSessionFocusButton:hover {"
                "background: #205344; }"
            )
        elif estado == "pausado":
            botao.setText("Foco pausado")
            botao.setToolTip("O Modo Foco está pausado. Clique para abrir o painel existente.")
            botao.setStyleSheet(
                "QPushButton#questionSessionFocusButton {"
                "background: #493715; color: #FFE6AF;"
                "border: 1px solid #E4AE43; border-radius: 8px;"
                "padding: 0 10px; font-weight: 600; }"
                "QPushButton#questionSessionFocusButton:hover {"
                "background: #5C481E; }"
            )
        else:
            botao.setText("Modo Foco")
            botao.setToolTip("Abrir ou trazer o Modo Foco para frente.")
            botao.setStyleSheet("")

    def atualizar_painel_foco(self):
        janela = self._janela_foco_ativa()
        if janela is None:
            self.foco_painel.hide()
            self._atualizar_botao_foco_topo("inativo")
            return

        try:
            pausada = bool(janela.pausada)
            decorrido = janela.tempo_decorrido()
        except RuntimeError:
            self.foco_painel.hide()
            self._atualizar_botao_foco_topo("inativo")
            return

        estado = "FOCO PAUSADO" if pausada else "FOCO ATIVO"
        self.foco_estado.setText(
            f"{estado}  •  {formatar_tempo_foco_resumido(decorrido)}"
        )
        self.foco_pausar.setText("Retomar" if pausada else "Pausar")
        self.foco_painel.show()
        self._atualizar_botao_foco_topo("pausado" if pausada else "ativo")

    def abrir_foco_pelo_cabecalho(self):
        """Acessa a janela canônica do Foco, sem iniciar uma nova sessão.

        A janela é criada só se não existir; sessões ativas são reutilizadas.
        """
        if self.finalizada or self._pausa_relogio is not None:
            return
        controlador = self._localizar_controlador_foco()
        if controlador is None:
            QMessageBox.information(
                self, "Modo Foco", "Não foi possível localizar o painel do Modo Foco."
            )
            return
        controlador.abrir_ou_trazer_modo_foco()
        self.atualizar_painel_foco()

    def alternar_foco_resolvedor(self):
        controlador = self._localizar_controlador_foco()
        if controlador is None:
            return
        controlador.alternar_pausa_modo_foco()
        self.atualizar_painel_foco()

    def abrir_foco_resolvedor(self):
        controlador = self._localizar_controlador_foco()
        if controlador is None:
            return
        # Só restaura a sessão existente; o painel nunca inicia outra.
        if controlador.obter_janela_modo_foco(apenas_ativa=True) is not None:
            controlador.abrir_ou_trazer_modo_foco()
        self.atualizar_painel_foco()

    def _b12_posicionar_hud(self, largura):
        """Realoca o MESMO card de indicadores sem cópias nem nova telemetria.

        Em desktop ele divide a linha do cabeçalho com a marca e as ações.
        Em janelas menores / simulados, usa a reserva abaixo para não cortar
        Pausa, Entregar simulado ou o cronômetro.
        """
        if not hasattr(self, "_b12_layout_hud_reserva"):
            return
        no_topo = largura >= (1470 if self.modo_simulado else 1200)
        if self._b12_hud_no_cabecalho == no_topo:
            return
        # Estado é registrado antes da mudança, evitando reentrada em resize.
        estava_no_topo = self._b12_hud_no_cabecalho
        self._b12_hud_no_cabecalho = no_topo
        if estava_no_topo:
            self._b12_layout_cabecalho.removeWidget(self.sessao_overview)
        else:
            self._b12_layout_hud_reserva.removeWidget(self.sessao_overview)
        destino = self.cabecalho_sessao if no_topo else self.faixa_estudo_superior
        self.sessao_overview.setParent(destino)
        if no_topo:
            # 0 = marca/perfil; 1 = indicador; 2 = espaço flexível; ações à direita.
            self._b12_layout_cabecalho.insertWidget(
                1, self.sessao_overview, 0, Qt.AlignVCenter
            )
        else:
            self._b12_layout_hud_reserva.insertWidget(
                0, self.sessao_overview, 0, Qt.AlignLeft | Qt.AlignVCenter
            )
        self.sessao_overview.show()
        self.cabecalho_sessao.updateGeometry()
        self.faixa_estudo_superior.updateGeometry()

    def _ajustar_layout_progresso_caneta(self, largura):
        """HUD responsivo sem alterar indicadores, caneta ou progresso real."""
        if not hasattr(self, "sessao_resumo_layout"):
            return
        self._b12_posicionar_hud(largura)
        empilhar = largura < 950
        if self._sessao_resumo_empilhado != empilhar:
            self._sessao_resumo_empilhado = empilhar
            self.sessao_resumo_layout.setDirection(
                QBoxLayout.TopToBottom if empilhar else QBoxLayout.LeftToRight
            )
            self.sessao_resumo_layout.setAlignment(
                self.sessao_status_widget, Qt.AlignLeft | Qt.AlignVCenter
            )
            self.sessao_resumo_layout.setSpacing(3 if empilhar else 9)
            self.sessao_resumo_layout.setStretch(1, 0)
        # Em 820 px o HUD fica na linha inferior e rótulos abreviados
        # poupam largura. Os nomes integrais permanecem no tooltip.
        abreviacoes = {"Respondidas": "Resp.", "Acertos": "Acertos",
                        "Erros": "Erros", "Puladas": "Puladas"}
        for rotulo, texto in getattr(self, "_b12_rotulos_metricas", ()):
            abreviado = abreviacoes.get(texto, texto) if largura < 950 else texto
            if rotulo.text() != abreviado:
                rotulo.setText(abreviado)

    def _ajustar_ergonomia_bateria(self, largura, altura):
        """B05: preserva a área de leitura em janelas compactas.

        Só modifica margens e espaçamentos dos QLayouts já existentes.
        A área de rolagem, o rodapé e os widgets da caneta não são movidos.
        """
        if not hasattr(self, "_b05_layout_alternativas"):
            return
        compacto = largura < 980 or altura < 690
        # A visibilidade do perfil tem limiar próprio; deve mudar mesmo
        # quando a janela continua no mesmo modo de margens compactas.
        self.sessao_perfil_ativo.setVisible(largura >= 930)
        if getattr(self, "_b05_compacto_ativo", None) == compacto:
            return
        self._b05_compacto_ativo = compacto
        if hasattr(self, "_b12_respiro_cenario"):
            self._b12_respiro_cenario.changeSize(
                0, 34 if compacto else 61, QSizePolicy.Minimum, QSizePolicy.Fixed
            )
            self._b05_layout_raiz.invalidate()
        if compacto:
            self._b05_layout_raiz.setContentsMargins(14, 9, 14, 10)
        else:
            self._b05_layout_raiz.setContentsMargins(18, 14, 18, 16)
        self._b05_layout_raiz.setSpacing(5 if compacto else 7)
        self._b05_layout_conteudo.setSpacing(6 if compacto else 8)
        self._b05_layout_alternativas.setSpacing(5 if compacto else 7)
        if compacto:
            self._b05_layout_enunciado.setContentsMargins(13, 8, 13, 10)
        else:
            self._b05_layout_enunciado.setContentsMargins(17, 11, 17, 14)
    def _b05_repor_inicio_leitura(self, indice_esperado):
        """Reposiciona novas questões; não interrompe revisão do histórico."""
        if (not self.finalizada and not self._modo_revisao_historico
                and self.indice == indice_esperado):
            scroll = getattr(self, "scroll_questao", None)
            if scroll is not None:
                scroll.verticalScrollBar().setValue(0)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        camada = getattr(self, "_b22_overlay", None)
        if camada is not None:
            camada.setGeometry(self.rect())
        nav = getattr(self, "_b26_nav_overlay", None)
        if nav is not None:
            nav.setGeometry(self.rect())
        self._ajustar_layout_progresso_caneta(event.size().width())
        self._ajustar_ergonomia_bateria(event.size().width(), event.size().height())
        fundo = getattr(self, "_fundo_justica_resolvedor", None)
        if fundo is not None:
            fundo.setGeometry(self.rect())
            fundo.lower()
        self._atualizar_geometria_overlay_pausa()
        self._b26_solicitar_layout_constelacao()

    def _construir_overlay_pausa_visual(self):
        """Camada visual da pausa: escurece a área de estudo e
        exibe um resumo central sem bloquear o botão de Pausa no topo.
        """
        if self._pausa_overlay is not None:
            return
        overlay = QFrame(self)
        overlay.setObjectName("questionPauseVisualOverlay")
        overlay.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        overlay.hide()
        overlay.setStyleSheet(
            """
            QFrame#questionPauseVisualOverlay {
                background: rgba(10, 12, 15, 176);
            }
            QFrame#questionPauseVisualCard {
                background: rgba(30, 36, 44, 242);
                border: 1px solid rgba(255, 188, 120, 0.55);
                border-radius: 16px;
            }
            QLabel#questionPauseVisualTitle {
                color: #F4F7FA;
                font-size: 18px;
                font-weight: 700;
            }
            QLabel#questionPauseVisualTime {
                color: #FFCC7A;
                font-size: 28px;
                font-weight: 800;
            }
            QLabel#questionPauseVisualInfo {
                color: #B6C3D1;
                font-size: 12px;
            }
            QLabel#questionPauseVisualStatsB21 {
                color: #A6E7EE;
                font-size: 12px;
                font-weight: 600;
            }
            QLabel#questionPauseVisualHistoryB21 {
                color: #CDD6E3;
                font-size: 11px;
            }
            """
        )
        base = QVBoxLayout(overlay)
        base.setContentsMargins(24, 18, 24, 22)
        base.addStretch(1)
        linha = QHBoxLayout()
        linha.addStretch(1)
        card = QFrame(overlay)
        card.setObjectName("questionPauseVisualCard")
        card.setMinimumWidth(380)
        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(20, 18, 20, 18)
        card_layout.setSpacing(6)
        titulo = QLabel("Pausa em andamento", card)
        titulo.setObjectName("questionPauseVisualTitle")
        tempo = QLabel("10:00", card)
        tempo.setObjectName("questionPauseVisualTime")
        info = QLabel(
            "A bateria está temporariamente suspensa. Use o botão Pausa no topo para retomar, adiar ou administrar o descanso.",
            card,
        )
        info.setObjectName("questionPauseVisualInfo")
        info.setWordWrap(True)
        stats = QLabel("Pausa 1 • Tempo real: 00:00", card)
        stats.setObjectName("questionPauseVisualStatsB21")
        stats.setWordWrap(True)
        historico = QLabel("", card)
        historico.setObjectName("questionPauseVisualHistoryB21")
        historico.setWordWrap(True)
        card_layout.addWidget(titulo, 0, Qt.AlignHCenter)
        card_layout.addWidget(tempo, 0, Qt.AlignHCenter)
        card_layout.addWidget(stats, 0, Qt.AlignHCenter)
        card_layout.addWidget(historico)
        card_layout.addWidget(info, 0, Qt.AlignHCenter)
        linha.addWidget(card, 0, Qt.AlignHCenter)
        linha.addStretch(1)
        base.addLayout(linha)
        base.addStretch(1)
        self._pausa_overlay = overlay
        self._pausa_overlay_titulo = titulo
        self._pausa_overlay_tempo = tempo
        self._pausa_overlay_info = info
        self._pausa_overlay_estatisticas = stats
        self._pausa_overlay_historico = historico
        self._atualizar_geometria_overlay_pausa()

    def _atualizar_geometria_overlay_pausa(self):
        overlay = self._pausa_overlay
        if overlay is None:
            return
        topo = 0
        if hasattr(self, "cabecalho_sessao"):
            try:
                # B12: o HUD migra para o cabeçalho, mas Pausa deve cobrir
                # somente o estudo, nunca o botão Pausa/Entregar simulado.
                topo = max(0, self.cabecalho_sessao.geometry().bottom() + 1)
            except RuntimeError:
                topo = 0
        overlay.setGeometry(0, topo, self.width(), max(0, self.height() - topo))
        if overlay.isVisible():
            overlay.raise_()

    def _atualizar_visual_pausa_programada(self):
        if self._pausa_overlay is None or self._pausa_relogio is None:
            return
        restantes = self._pausa_relogio.segundos_restantes()
        encerrada = restantes <= 0
        self._pausa_overlay_titulo.setText(
            "Pausa encerrada" if encerrada else "Pausa em andamento"
        )
        self._pausa_overlay_tempo.setText(
            "Tempo encerrado" if encerrada else texto_contagem(restantes)
        )
        self._pausa_overlay_info.setText(
            "O descanso terminou. Use o botão Pausa no topo para voltar agora ou adiar alguns minutos."
            if encerrada
            else "A bateria está temporariamente suspensa. Use o botão Pausa no topo para retomar, adiar ou administrar o descanso."
        )
        # Reaproveita o timer existente de 1s: nenhum timer novo.
        pausas = self._b21_fotografia_pausas()
        if pausas and self._pausa_overlay_estatisticas is not None:
            atual = pausas[-1]
            total = sum(p["duracao_segundos"] for p in pausas)
            self._pausa_overlay_estatisticas.setText(
                f"Pausa {len(pausas)} · tempo real: "
                f"{_b21_texto_duracao_pausa(atual['duracao_segundos'])}"
                f" · acumulado: {_b21_texto_duracao_pausa(total)}"
            )
            ultimas = pausas[:-1][-4:]
            self._pausa_overlay_historico.setText(
                "Pausas anteriores:\n" + "\n".join(
                    f"{p['numero']}ª · {p['horario_inicio']} · "
                    f"{_b21_texto_duracao_pausa(p['duracao_segundos'])}"
                    for p in ultimas
                ) if ultimas else "Nenhuma pausa anterior nesta sessão."
            )

    def _aplicar_visual_pausa_programada(self, ativo):
        self._pausa_visual_ativa = bool(ativo)
        if self._pausa_overlay is None:
            self._construir_overlay_pausa_visual()
        if self._pausa_overlay is not None:
            self._atualizar_geometria_overlay_pausa()
            self._pausa_overlay.setVisible(bool(ativo))
            if ativo:
                self._pausa_overlay.raise_()
        if bool(ativo):
            self.botao_pausa.setStyleSheet(
                """
                QPushButton#questionSessionPauseButton {
                    background: #8E3218;
                    color: #FFF8F0;
                    border: 1px solid #FFBF87;
                    border-radius: 10px;
                    padding: 0 14px;
                    font-weight: 700;
                }
                QPushButton#questionSessionPauseButton:hover { background: #A93D1D; }
                QPushButton#questionSessionPauseButton:pressed { background: #7A2A13; }
                """
            )
        else:
            self.botao_pausa.setStyleSheet("")

    def exec_nao_modal(self):
        """Exibe a sessão sem bloquear as demais janelas do aplicativo."""
        ciclo = QEventLoop()
        encerrada = False

        def encerrar_ciclo(*_args):
            nonlocal encerrada
            encerrada = True
            if ciclo.isRunning():
                ciclo.quit()

        self.finished.connect(
            encerrar_ciclo
        )

        self.setWindowModality(
            Qt.NonModal
        )
        self.show()
        self.raise_()
        self.activateWindow()

        if not encerrada:
            ciclo.exec()

        try:
            self.finished.disconnect(
                encerrar_ciclo
            )
        except (RuntimeError, TypeError):
            pass

        return self.result()

    def atualizar_rotulo_duvida(
        self,
        marcada
    ):
        texto = (
            "✓  Marcada como dúvida"
            if marcada
            else "Marcar como dúvida"
        )

        self.duvida.setText(
            texto
        )
        self.duvida.setAccessibleName(
            texto
        )

    def _inicializar_faixa_caneta_estudo(self):
        """A paleta é visual; o controlador de rabiscos permanece independente."""
        self.caneta_estudo.ao_alterar = self._atualizar_botao_caneta_estudo
        self._atualizar_botao_caneta_estudo()

    def _atualizar_botao_caneta_estudo(self):
        if not hasattr(self, "caneta_estudo"):
            return
        self.faixa_caneta.atualizar(
            modo=self.caneta_estudo.modo,
            cor=self.caneta_estudo.cor,
            espessura=self.caneta_estudo.espessura,
            pode_desfazer=bool(self.caneta_estudo.historico),
            ha_tracos=bool(self.caneta_estudo.tracos),
        )

    def definir_ferramenta_caneta(self, modo):
        if modo is not None and (
            self.finalizada or self._pausa_relogio is not None
            or self._editando_alternativas or self._editando_explicacao
        ):
            self._atualizar_botao_caneta_estudo()
            return
        self.caneta_estudo.definir_modo(modo)
        self._atualizar_botao_caneta_estudo()

    def _definir_cor_caneta(self, cor):
        self.caneta_estudo.definir_cor(cor)
        if self.caneta_estudo.modo is None:
            self.definir_ferramenta_caneta("caneta")
        self._atualizar_botao_caneta_estudo()

    def _definir_espessura_caneta(self, espessura):
        self.caneta_estudo.definir_espessura(espessura)
        if self.caneta_estudo.modo is None:
            self.definir_ferramenta_caneta("caneta")
        self._atualizar_botao_caneta_estudo()

    def desfazer_caneta_estudo(self):
        self.caneta_estudo.desfazer()
        self._atualizar_botao_caneta_estudo()

    def limpar_caneta_estudo(self):
        self.caneta_estudo.limpar_marcacoes()
        self._atualizar_botao_caneta_estudo()

    def atualizar_rotulo_analise_pendente(
        self,
        marcada
    ):
        texto = (
            "✓  Separada para análise"
            if marcada
            else "Analisar depois"
        )

        self.analise_pendente.setText(
            texto
        )
        self.analise_pendente.setAccessibleName(
            texto
        )
        self.atualizar_menu_opcoes_topo()

    def atualizar_menu_opcoes_topo(self):
        acao_analise = getattr(self, "acao_menu_analise_pendente", None)
        if acao_analise is not None:
            acao_analise.blockSignals(True)
            acao_analise.setChecked(self.analise_pendente.isChecked())
            acao_analise.setEnabled(
                self.analise_pendente.isEnabled() and not self._modo_revisao_historico
            )
            acao_analise.blockSignals(False)

        acao_editar = getattr(self, "acao_menu_editar_alternativas", None)
        if acao_editar is not None:
            tipo_questao = _questao_tipo(self.questao_atual) if self.questao_atual else None
            acao_editar.setEnabled(
                tipo_questao == "MULTIPLA_ESCOLHA"
                and not self._editando_alternativas
                and not self._editando_explicacao
                and not self._modo_revisao_historico
            )

    def _alternar_analise_pendente_pelo_menu(self, marcada):
        self.analise_pendente.setChecked(marcada)

    def alternar_analise_pendente(
        self,
        marcada
    ):
        if self._modo_revisao_historico:
            return
        if self.questao_atual is None:
            return

        sucesso = False

        try:
            sucesso = definir_questao_analise_pendente(
                self.questao_atual[
                    "id"
                ],
                marcada
            )
        except Exception:
            sucesso = False

        if not sucesso:
            self.analise_pendente.blockSignals(
                True
            )
            self.analise_pendente.setChecked(
                not marcada
            )
            self.analise_pendente.blockSignals(
                False
            )
            self.atualizar_rotulo_analise_pendente(
                not marcada
            )
            QMessageBox.warning(
                self,
                "Analisar depois",
                "Não foi possível salvar a marcação desta questão."
            )
            return

        self.questao_atual[
            "analise_pendente"
        ] = bool(
            marcada
        )
        self.atualizar_rotulo_analise_pendente(
            marcada
        )

    def atualizar_relogio_simulado(self):
        if not self.modo_simulado:
            return

        if self.inicio_simulado is None:
            return

        decorrido = max(
            0,
            int(
                (
                    datetime.now()
                    - self.inicio_simulado
                ).total_seconds()
            )
        )

        if self.tempo_limite_minutos <= 0:
            horas = decorrido // 3600
            minutos = (
                decorrido % 3600
            ) // 60
            segundos = (
                decorrido % 60
            )

            self.simulado_relogio.setText(
                (
                    f"⏱ {horas:02d}:"
                    f"{minutos:02d}:"
                    f"{segundos:02d}"
                )
            )
            return

        limite = (
            self.tempo_limite_minutos
            * 60
        )

        restante = max(
            0,
            limite
            - decorrido
        )

        horas = restante // 3600
        minutos = (
            restante % 3600
        ) // 60
        segundos = (
            restante % 60
        )

        self.simulado_relogio.setText(
            (
                f"⏱ {horas:02d}:"
                f"{minutos:02d}:"
                f"{segundos:02d}"
            )
        )

        if (
            restante <= 0
            and not self.finalizada
        ):
            if self.timer_simulado is not None:
                self.timer_simulado.stop()

            self.finalizar(
                True,
                "Tempo esgotado"
            )

    def limpar_alternativas(self):
        self._b22_parar_animacao()
        while self.alternativas_layout.count():
            item = self.alternativas_layout.takeAt(
                0
            )

            widget = item.widget()

            if widget is not None:
                # O frame removido ainda permanece vivo até o próximo ciclo
                # do event loop por causa de deleteLater(). Escondê-lo antes
                # evita que filhos antigos (principalmente o botão ✂) sejam
                # repintados isoladamente durante a troca de questão.
                widget.hide()
                widget.deleteLater()

        self.grupo_alternativas = QButtonGroup(
            self
        )
        self.grupo_alternativas.setExclusive(
            True
        )
        self.radio_por_letra = {}
        self.frame_por_letra = {}
        self.texto_por_letra = {}
        self.botao_eliminar_por_letra = {}
        self._letra_por_widget_alternativa = {}
        self._alternativa_foco_teclado = None

    def _letra_alternativa_do_widget(self, widget):
        """Retorna a alternativa que contém ``widget``, quando houver."""
        atual = widget
        visitados = set()

        while atual is not None and id(atual) not in visitados:
            visitados.add(id(atual))
            letra = getattr(self, "_letra_por_widget_alternativa", {}).get(atual)
            if letra is not None:
                return letra
            if atual is self:
                break
            try:
                atual = atual.parentWidget()
            except (RuntimeError, AttributeError):
                break

        return None

    def definir_texto_label_explicacao(self, valor):
        if explicacao_eh_rica(valor):
            self.feedback_explicacao.setTextFormat(Qt.RichText)
            self.feedback_explicacao.setText(explicacao_html(valor))
        else:
            self.feedback_explicacao.setTextFormat(Qt.PlainText)
            self.feedback_explicacao.setText(
                str(valor or "").strip() or "Esta questão não possui explicação cadastrada."
            )

    def atualizar_texto_feedback_explicacao(self):
        self.definir_texto_label_explicacao(
            (self.questao_atual or {}).get("explicacao") or ""
        )

    def sincronizar_botoes_formato_explicacao(self, formato):
        # Captura também os atalhos nativos Ctrl+B/I/U do QTextEdit.
        if self._editando_explicacao and getattr(self, "_explicacao_carregada", False):
            self._explicacao_formato_usado = True
        controles = (
            (self.explicacao_negrito, formato.fontWeight() >= QFont.Bold),
            (self.explicacao_italico, formato.fontItalic()),
            (self.explicacao_sublinhado, formato.fontUnderline()),
        )
        for botao, estado in controles:
            botao.blockSignals(True)
            botao.setChecked(estado)
            botao.blockSignals(False)

    def aplicar_formato_explicacao(self, formato):
        if not self._editando_explicacao or self.explicacao_previa_botao.isChecked():
            return
        self.feedback_explicacao_editor.mergeCurrentCharFormat(formato)
        self._explicacao_formato_usado = True
        self.feedback_explicacao_editor.setFocus(Qt.OtherFocusReason)

    def formatar_explicacao_caracter(self, tipo):
        editor = self.feedback_explicacao_editor
        atual = editor.currentCharFormat()
        formato = QTextCharFormat()
        if tipo == "negrito":
            formato.setFontWeight(QFont.Normal if atual.fontWeight() >= QFont.Bold else QFont.Bold)
        elif tipo == "italico":
            formato.setFontItalic(not atual.fontItalic())
        elif tipo == "sublinhado":
            formato.setFontUnderline(not atual.fontUnderline())
        self.aplicar_formato_explicacao(formato)

    def colorir_explicacao(self, cor, *, fundo):
        if not self._editando_explicacao or self.explicacao_previa_botao.isChecked():
            return
        fmt = QTextCharFormat()
        if fundo:
            if cor:
                fmt.setBackground(QColor(cor))
            else:
                fmt.clearBackground()
        elif cor:
            fmt.setForeground(QColor(cor))
        else:
            fmt.clearForeground()
        self.aplicar_formato_explicacao(fmt)

    def lista_explicacao(self):
        if not self._editando_explicacao or self.explicacao_previa_botao.isChecked():
            return
        cursor = self.feedback_explicacao_editor.textCursor()
        fmt = QTextListFormat()
        fmt.setStyle(QTextListFormat.ListDisc)
        cursor.createList(fmt)
        self._explicacao_formato_usado = True
        self.feedback_explicacao_editor.setFocus(Qt.OtherFocusReason)

    def limpar_formato_explicacao(self):
        if not self._editando_explicacao or self.explicacao_previa_botao.isChecked():
            return
        editor = self.feedback_explicacao_editor
        cursor = editor.textCursor()
        if cursor.hasSelection():
            cursor.setCharFormat(QTextCharFormat())
            editor.setTextCursor(cursor)
        else:
            editor.setCurrentCharFormat(QTextCharFormat())
        self._explicacao_formato_usado = True
        editor.setFocus(Qt.OtherFocusReason)

    def alternar_previa_explicacao(self):
        if not self._editando_explicacao:
            return
        previa = self.explicacao_previa_botao.isChecked()
        self.explicacao_previa_botao.setText("Voltar à edição" if previa else "Visualizar")
        self.feedback_explicacao_editor.setVisible(not previa)
        for item in self.feedback_explicacao_barra.findChildren(QToolButton):
            if item is not self.explicacao_previa_botao:
                item.setEnabled(not previa)
        if previa:
            valor = explicacao_serializada(
                self.feedback_explicacao_editor,
                formatada=self._explicacao_original_rica or self._explicacao_formato_usado,
            )
            self.definir_texto_label_explicacao(valor)
            self.feedback_explicacao.show()
        else:
            self.feedback_explicacao.hide()
            self.feedback_explicacao_editor.setFocus(Qt.OtherFocusReason)

    def iniciar_edicao_explicacao(self):
        if (
            self._editando_alternativas
            or not self.resposta_confirmada
            or not self.questao_atual
            or not self.feedback.isVisible()
        ):
            return

        self.definir_ferramenta_caneta(None)
        self._editando_explicacao = True
        self._explicacao_formato_usado = False
        self._explicacao_carregada = False
        valor = str(self.questao_atual.get("explicacao") or "")
        self._explicacao_original_rica = explicacao_eh_rica(valor)
        if self._explicacao_original_rica:
            self.feedback_explicacao_editor.setHtml(explicacao_html(valor))
        else:
            self.feedback_explicacao_editor.setPlainText(valor)
        self._explicacao_formato_usado = False
        self._explicacao_carregada = True
        self.explicacao_previa_botao.setChecked(False)
        self.explicacao_previa_botao.setText("Visualizar")
        self.feedback_explicacao.setVisible(False)
        self.feedback_explicacao_editar.setVisible(False)
        self.feedback_explicacao_editor.setVisible(True)
        self.feedback_explicacao_barra.setVisible(True)
        self.feedback_explicacao_acoes.setVisible(True)
        self.botao_proxima.setEnabled(False)
        self.feedback_explicacao_editor.setFocus(Qt.MouseFocusReason)

    def finalizar_edicao_explicacao(self):
        self._editando_explicacao = False
        self._explicacao_carregada = False
        self.explicacao_previa_botao.setChecked(False)
        self.explicacao_previa_botao.setText("Visualizar")
        self.feedback_explicacao_editor.setVisible(False)
        self.feedback_explicacao_barra.setVisible(False)
        self.feedback_explicacao_acoes.setVisible(False)
        self.feedback_explicacao.setVisible(True)
        self.feedback_explicacao_editar.setVisible(
            bool(self.resposta_confirmada and self.feedback.isVisible())
        )
        self.botao_proxima.setEnabled(True)
        if self.botao_proxima.isVisible():
            self.botao_proxima.setFocus(Qt.OtherFocusReason)

    def cancelar_edicao_explicacao(self):
        if not self._editando_explicacao:
            return
        self.atualizar_texto_feedback_explicacao()
        self.finalizar_edicao_explicacao()

    def salvar_edicao_explicacao(self):
        if not self._editando_explicacao or not self.questao_atual:
            return

        nova_explicacao = explicacao_serializada(
            self.feedback_explicacao_editor,
            formatada=self._explicacao_original_rica or self._explicacao_formato_usado,
        )
        try:
            atualizada = atualizar_explicacao_questao(
                self.questao_atual["id"], nova_explicacao,
            )
        except Exception as erro:
            QMessageBox.critical(
                self, "Editar explicação",
                "Não foi possível salvar a explicação.\n\n" + str(erro),
            )
            return
        if not atualizada:
            QMessageBox.warning(
                self, "Editar explicação",
                "A questão não está mais disponível para edição.",
            )
            return
        self.questao_atual["explicacao"] = nova_explicacao
        self.atualizar_texto_feedback_explicacao()
        self.finalizar_edicao_explicacao()
        try:
            _notificar_dados_alterados_raiz(self, "questoes")
        except Exception:
            pass

    def iniciar_edicao_alternativas(self):
        if (
            self.questao_atual is None
            or self._editando_alternativas
            or self._editando_explicacao
            or _questao_tipo(self.questao_atual) != "MULTIPLA_ESCOLHA"
        ):
            return

        alternativas = self.questao_atual.get("alternativas", [])
        letras_atuais = {item["letra"] for item in alternativas}
        for letra, (rotulo, campo) in self.campos_edicao_alternativas.items():
            existente = letra in letras_atuais
            rotulo.setVisible(existente)
            campo.setVisible(existente)
            if existente:
                texto = next(
                    item["texto"] for item in alternativas if item["letra"] == letra
                )
                campo.setPlainText(str(texto or ""))

        self.definir_ferramenta_caneta(None)
        self._editando_alternativas = True
        self.botao_editar_alternativas.setEnabled(False)
        self.botao_pular.setEnabled(False)
        self.botao_confirmar.setEnabled(False)
        self.botao_proxima.setEnabled(False)
        self.painel_edicao_alternativas.show()
        self.atualizar_menu_opcoes_topo()
        self.scroll_questao.ensureWidgetVisible(self.painel_edicao_alternativas, 0, 12)
        for letra in "ABCDE":
            if letra in letras_atuais:
                self.campos_edicao_alternativas[letra][1].setFocus(Qt.MouseFocusReason)
                break

    def finalizar_edicao_alternativas(self):
        self._editando_alternativas = False
        self.painel_edicao_alternativas.hide()
        self.botao_editar_alternativas.setEnabled(
            _questao_tipo(self.questao_atual) == "MULTIPLA_ESCOLHA"
        )
        self.botao_pular.setEnabled(not self.resposta_confirmada)
        self.botao_confirmar.setEnabled(not self.resposta_confirmada)
        self.botao_proxima.setEnabled(self.resposta_confirmada)
        self.atualizar_menu_opcoes_topo()
        self.botao_opcoes.setFocus(Qt.OtherFocusReason)

    def cancelar_edicao_alternativas(self):
        if not self._editando_alternativas:
            return
        self.finalizar_edicao_alternativas()

    def salvar_edicao_alternativas(self):
        if not self._editando_alternativas or not self.questao_atual:
            return
        textos = {
            item["letra"]: self.campos_edicao_alternativas[item["letra"]][1]
            .toPlainText().strip()
            for item in self.questao_atual.get("alternativas", [])
        }
        vazias = [letra for letra, texto in textos.items() if not texto]
        if vazias:
            QMessageBox.warning(
                self, "Editar alternativas",
                "Preencha o texto das alternativas: " + ", ".join(vazias) + "."
            )
            self.campos_edicao_alternativas[vazias[0]][1].setFocus()
            return

        try:
            atualizada = atualizar_textos_alternativas_questao(
                self.questao_atual["id"], textos
            )
        except Exception as erro:
            QMessageBox.critical(
                self, "Editar alternativas",
                "Não foi possível salvar as alternativas.\n\n" + str(erro)
            )
            return
        if not atualizada:
            QMessageBox.warning(
                self, "Editar alternativas",
                "A questão não está mais disponível para edição."
            )
            return

        # Atualiza os textos sem reconstruir a questão, trocar o gabarito,
        # perder a seleção ou reiniciar o cronômetro e as métricas da bateria.
        for item in self.questao_atual["alternativas"]:
            letra = item["letra"]
            item["texto"] = textos[letra]
            rotulo = self.texto_por_letra.get(letra)
            if rotulo is not None:
                rotulo.setText(textos[letra])
        self.finalizar_edicao_alternativas()
        # A Central e os relatórios devem ler a nova versão quando reabertos.
        try:
            _notificar_dados_alterados_raiz(self, "questoes")
        except Exception:
            # A invalidação de telas não pode desfazer a gravação já concluída.
            pass

    def confirmar_saida_com_edicao_alternativas(self):
        if self._editando_explicacao and self.questao_atual:
            atual = explicacao_serializada(
                self.feedback_explicacao_editor,
                formatada=self._explicacao_original_rica or self._explicacao_formato_usado,
            )
            anterior = str(self.questao_atual.get("explicacao") or "")
            # HTML Qt pode ser normalizado ao carregar; compare texto e estado de edição.
            if (self.feedback_explicacao_editor.toPlainText().strip() !=
                    explicacao_texto_simples(anterior).strip() or
                    (self._explicacao_formato_usado and atual != anterior)):
                if QMessageBox.question(
                    self, "Explicação não salva",
                    "Existem mudanças não salvas na explicação.\n\n"
                    "Deseja sair da bateria e descartar as alterações?",
                    QMessageBox.Yes | QMessageBox.No, QMessageBox.No,
                ) != QMessageBox.Yes:
                    return False
        if not self._editando_alternativas or not self.questao_atual:
            return True
        originais = {
            item["letra"]: str(item.get("texto") or "").strip()
            for item in self.questao_atual.get("alternativas", [])
        }
        editados = {
            letra: self.campos_edicao_alternativas[letra][1].toPlainText().strip()
            for letra in originais
        }
        if originais == editados:
            return True
        return QMessageBox.question(
            self,
            "Alternativas não salvas",
            "Existem alterações não salvas nas alternativas.\n\n"
            "Deseja sair da bateria e descartar essas alterações?",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No,
        ) == QMessageBox.Yes

    def definir_foco_teclado_alternativa(self, letra, mover_foco_qt=True):
        if self.resposta_confirmada or letra not in self.frame_por_letra:
            return False

        self._alternativa_foco_teclado = letra
        for alternativa_letra, frame in self.frame_por_letra.items():
            frame.setProperty(
                "keyboardFocus",
                alternativa_letra == letra
            )
            frame.style().unpolish(frame)
            frame.style().polish(frame)

        frame = self.frame_por_letra.get(letra)
        if mover_foco_qt and frame is not None:
            frame.setFocus(Qt.OtherFocusReason)

        return True

    def mover_foco_teclado_alternativa(self, passo):
        if self.resposta_confirmada:
            return False

        letras = [
            letra
            for letra, frame in self.frame_por_letra.items()
            if frame is not None and frame.isEnabled()
        ]
        if not letras:
            return False

        atual = self._alternativa_foco_teclado
        if atual not in letras:
            indice = 0 if passo >= 0 else len(letras) - 1
        else:
            indice = (letras.index(atual) + passo) % len(letras)

        destino = letras[indice]
        mudou = destino != atual
        sucesso = self.definir_foco_teclado_alternativa(destino)
        if sucesso and mudou:
            # B27: o mesmo destino das setas governa borda e Leitura Neural.
            self._b16_sincronizar_foco_teclado(destino)
            # O Qt pode rolar o viewport após a mudança de foco.
            QTimer.singleShot(
                0, lambda alvo=destino: self._b16_sincronizar_foco_teclado(alvo))
            self._b26_animar_foco_setas(destino, passo, letra_anterior=atual)
            self._b26r2_tocar_som("seta_baixo" if passo > 0 else "seta_cima")
        return sucesso

    def alternar_eliminacao_foco_teclado(self):
        letra = self._alternativa_foco_teclado
        if letra is None or self.resposta_confirmada:
            return False

        botao = self.botao_eliminar_por_letra.get(letra)
        if botao is None or not botao.isEnabled():
            return False

        botao.setChecked(not botao.isChecked())
        # O botão pode receber atualização visual sem roubar o foco de navegação.
        self.definir_foco_teclado_alternativa(letra)
        return True

    def acionar_enter_foco_teclado(self):
        letra = self._alternativa_foco_teclado
        if letra is None or self.resposta_confirmada:
            return False

        # Primeiro Enter equivale ao clique esquerdo: seleciona a opção focada.
        # Se ela já está selecionada, o Enter seguinte confirma a resposta.
        if self.alternativa_selecionada() != letra:
            self.selecionar_alternativa_por_letra(letra)
            self.definir_foco_teclado_alternativa(letra)
        else:
            self.confirmar_resposta()
        return True

    def selecionar_alternativa_por_letra(self, letra):
        if self.resposta_confirmada:
            return

        radio = self.radio_por_letra.get(letra)
        if radio is None or not radio.isEnabled():
            return

        # Se a alternativa havia sido eliminada pela tesoura, clicar no card
        # restaura visualmente a opção antes de selecioná-la. Isso evita a
        # combinação contraditória de "eliminada" e "marcada" ao mesmo tempo.
        botao = self.botao_eliminar_por_letra.get(letra)
        if botao is not None and botao.isChecked():
            botao.setChecked(False)

        radio.setChecked(True)
        radio.setFocus()

    def eventFilter(self, objeto, evento):
        # B16R3: aguardar o fim do mouseReleaseEvent do rabisco antes de
        # reposicionar os guias. Um único singleShot(0), sem timer periódico;
        # evita perder o realce quando a caneta solta o mouse sem movê-lo.
        if (evento.type() == QEvent.MouseButtonRelease and
                isinstance(objeto, QWidget) and
                objeto.objectName() == "questionStudyInkLocalCanvas"):
            QTimer.singleShot(0, self._b16_revalidar_guias_apos_soltar)
        # B16R1: efeitos opcionais nunca podem interromper eventos da UI.
        # O processamento da caneta, do menu e dos atalhos permanece abaixo.
        try:
            self._b16_evento_linha(objeto, evento)
            self._b15_evento_cursor(objeto, evento)
        except (AttributeError, RuntimeError, TypeError, ValueError):
            self._b16_ocultar_linha()
            self._b15_ocultar_halo()
        if self._pausa_relogio is not None:
            return super().eventFilter(objeto, evento)
        if (
            evento.type() == QEvent.KeyPress
            and self.isActiveWindow()
        ):
            tecla = evento.key()

            # Enquanto a explicação está sendo editada, o QTextEdit e os
            # botões Salvar/Cancelar recebem o teclado normalmente. Isso evita
            # que Enter avance a bateria ou que as setas mudem de alternativa.
            if self._editando_explicacao or self._editando_alternativas:
                return super().eventFilter(objeto, evento)

            # Um Enter mantido pressionado não pode atravessar várias etapas
            # (selecionar -> confirmar -> avançar) por repetição automática.
            if (
                tecla in (Qt.Key_Return, Qt.Key_Enter)
                and evento.isAutoRepeat()
            ):
                evento.accept()
                return True

            # Depois da confirmação, o Enter seguinte equivale ao botão
            # "Próxima questão". Na última questão, ``proxima`` conclui a
            # sessão normalmente. O evento é consumido aqui para impedir que
            # o QPushButton focado execute a mesma ação uma segunda vez.
            if (
                self.resposta_confirmada
                and tecla in (Qt.Key_Return, Qt.Key_Enter)
            ):
                self.proxima()
                evento.accept()
                return True

            if self.resposta_confirmada:
                return super().eventFilter(objeto, evento)

            if tecla in (Qt.Key_Up, Qt.Key_Left):
                if self.mover_foco_teclado_alternativa(-1):
                    evento.accept()
                    return True

            if tecla in (Qt.Key_Down, Qt.Key_Right):
                if self.mover_foco_teclado_alternativa(1):
                    evento.accept()
                    return True

            # Espaço e Enter só assumem o comando quando o foco Qt está dentro
            # de uma alternativa. Assim, Espaço continua funcionando normalmente
            # em "Marcar como dúvida" e nos demais controles da sessão.
            letra_widget = self._letra_alternativa_do_widget(objeto)
            if letra_widget is not None:
                if letra_widget != self._alternativa_foco_teclado:
                    self.definir_foco_teclado_alternativa(
                        letra_widget,
                        mover_foco_qt=False
                    )

                if tecla == Qt.Key_Space:
                    if self.alternar_eliminacao_foco_teclado():
                        evento.accept()
                        return True

                if tecla in (Qt.Key_Return, Qt.Key_Enter):
                    if self.acionar_enter_foco_teclado():
                        evento.accept()
                        return True

        letra = getattr(self, "_letra_por_widget_alternativa", {}).get(objeto)
        if letra is not None and not self.resposta_confirmada:
            if evento.type() == QEvent.MouseButtonRelease and evento.button() == Qt.LeftButton:
                # No texto, preserve seleção por arraste: só converte um clique
                # simples em seleção da alternativa quando não há trecho marcado.
                if isinstance(objeto, QLabel):
                    try:
                        if objeto.selectedText():
                            return super().eventFilter(objeto, evento)
                    except Exception:
                        pass
                self.selecionar_alternativa_por_letra(letra)
                self.definir_foco_teclado_alternativa(letra)
                return True

        return super().eventFilter(objeto, evento)

    def alternar_eliminacao_alternativa(
        self,
        letra,
        eliminada
    ):
        texto = self.texto_por_letra.get(
            letra
        )
        botao = self.botao_eliminar_por_letra.get(
            letra
        )
        frame = self.frame_por_letra.get(
            letra
        )
        radio = self.radio_por_letra.get(
            letra
        )

        if (
            texto is None
            or botao is None
            or frame is None
            or radio is None
            or self.resposta_confirmada
        ):
            return

        eliminada = bool(
            eliminada
        )

        for widget in (frame, texto, radio):
            widget.setProperty(
                "eliminated",
                eliminada
            )
            widget.style().unpolish(widget)
            widget.style().polish(widget)

        # Eliminar uma opção que estava marcada também remove a marcação.
        if eliminada and radio.isChecked():
            self.grupo_alternativas.setExclusive(False)
            radio.setChecked(False)
            self.grupo_alternativas.setExclusive(True)
            self.atualizar_selecao_visual_alternativas()

        # A repolida aplica primeiro a cor do estado; o tachado precisa
        # ser definido depois para não ser sobrescrito pelo stylesheet.
        fonte = texto.font()
        fonte.setStrikeOut(
            eliminada
        )
        texto.setFont(
            fonte
        )

        botao.setToolTip(
            (
                f"Restaurar alternativa {letra}"
                if eliminada
                else f"Eliminar alternativa {letra}"
            )
        )
        botao.setAccessibleName(
            botao.toolTip()
        )

    def _indices_questoes_revisaveis(self):
        """Revisar apenas respostas da sessão, não pulos nem a fila futura."""
        return sorted({
            registro["indice_fila"]
            for registro in self.registros
            if isinstance(registro.get("indice_fila"), int)
            and 0 <= registro["indice_fila"] < (
                self.indice + (1 if self.resposta_confirmada else 0)
            )
            and registro.get("status") in ("Correta", "Errada")
            and registro.get("marcada") is not None
        })

    def _obter_registro_revisao(self, indice_fila):
        for registro in reversed(self.registros):
            if registro.get("indice_fila") == indice_fila and registro.get("marcada") is not None:
                return registro
        return None

    def atualizar_navegacao_revisao_questoes(self):
        revisaveis = self._indices_questoes_revisaveis()
        em_revisao = self._modo_revisao_historico
        bloqueada = bool(
            self.finalizada or self._pausa_relogio is not None
            or self._editando_alternativas or self._editando_explicacao
        )
        if em_revisao:
            try:
                posicao = revisaveis.index(self._indice_revisao_historico)
            except ValueError:
                posicao = -1
            anterior = posicao > 0
            posterior = posicao >= 0
        else:
            anterior = bool(revisaveis)
            posterior = False

        self.botao_questao_anterior.setEnabled(not bloqueada and anterior)
        self.botao_mapa_questoes.setEnabled(not bloqueada)
        self.botao_questao_posterior.setEnabled(not bloqueada and posterior)
        self.botao_voltar_questao_atual.setVisible(em_revisao)
        self.botao_voltar_questao_atual.setEnabled(not bloqueada and em_revisao)

        if em_revisao:
            self.botao_questao_anterior.setToolTip("Questão respondida anterior")
            self.botao_questao_posterior.setToolTip(
                "Próxima resposta revisável; na última, volta à questão atual"
            )
        else:
            self.botao_questao_anterior.setToolTip(
                "Rever a última questão respondida" if revisaveis
                else "Nenhuma questão respondida nesta bateria ainda"
            )
            self.botao_questao_posterior.setToolTip("Disponível durante a revisão")
        self.botao_mapa_questoes.setToolTip(
            "Mapa das questões respondidas" if revisaveis
            else "Nenhuma questão respondida ainda — clique para verificar"
        )

    def navegar_revisao_questoes(self, direcao):
        if self.finalizada or self._pausa_relogio is not None or self._editando_alternativas or self._editando_explicacao:
            return
        indices = self._indices_questoes_revisaveis()
        if not indices:
            return
        if not self._modo_revisao_historico:
            if direcao < 0:
                self.abrir_revisao_questao(indices[-1])
            return
        try:
            pos = indices.index(self._indice_revisao_historico)
        except ValueError:
            self.sair_revisao_questoes()
            return
        novo = pos + direcao
        if 0 <= novo < len(indices):
            self.abrir_revisao_questao(indices[novo])
        elif novo >= len(indices):
            self.sair_revisao_questoes()

    def abrir_mapa_questoes_respondidas(self):
        if self.finalizada or self._pausa_relogio is not None or self._editando_alternativas or self._editando_explicacao:
            return
        indices = self._indices_questoes_revisaveis()
        if not indices:
            QMessageBox.information(
                self, "Mapa da bateria",
                "Ainda não há questões respondidas nesta bateria. Responda a primeira questão para iniciar o histórico."
            )
            return
        dialogo = QDialog(self)
        dialogo.setWindowTitle("Mapa da bateria — questões respondidas")
        dialogo.setMinimumSize(540, 380)
        layout = QVBoxLayout(dialogo)
        layout.setContentsMargins(14, 14, 14, 14)
        layout.setSpacing(9)
        titulo = QLabel("Histórico da bateria")
        titulo.setObjectName("pageTitle")
        layout.addWidget(titulo)
        subtitulo = QLabel(
            "Escolha uma questão respondida para consultar. A resolução atual permanece preservada."
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        layout.addWidget(subtitulo)
        arvore = QTreeWidget(dialogo)
        arvore.setObjectName("questionReviewMap")
        arvore.setHeaderLabels(["Questão", "Resultado", "Tópico"])
        arvore.setRootIsDecorated(False)
        arvore.setSelectionBehavior(QAbstractItemView.SelectRows)
        arvore.setSelectionMode(QAbstractItemView.SingleSelection)
        arvore.header().setSectionResizeMode(0, QHeaderView.ResizeToContents)
        arvore.header().setSectionResizeMode(1, QHeaderView.ResizeToContents)
        arvore.header().setSectionResizeMode(2, QHeaderView.Stretch)
        for indice in indices:
            registro = self._obter_registro_revisao(indice)
            if registro is None:
                continue
            status = "Respondida" if self.modo_simulado and not self.feedback_imediato else registro["status"]
            item = QTreeWidgetItem([
                f"Questão {indice + 1}", status,
                str(registro.get("topico") or registro.get("disciplina") or "")
            ])
            item.setData(0, Qt.UserRole, indice)
            arvore.addTopLevelItem(item)
            if self._modo_revisao_historico and indice == self._indice_revisao_historico:
                arvore.setCurrentItem(item)
        layout.addWidget(arvore, 1)
        botoes = QDialogButtonBox(QDialogButtonBox.Open | QDialogButtonBox.Cancel, parent=dialogo)
        botoes.button(QDialogButtonBox.Open).setText("Abrir revisão")
        botoes.accepted.connect(dialogo.accept)
        botoes.rejected.connect(dialogo.reject)
        layout.addWidget(botoes)
        if arvore.currentItem() is None and arvore.topLevelItemCount():
            arvore.setCurrentItem(arvore.topLevelItem(0))
        arvore.itemDoubleClicked.connect(lambda *_: dialogo.accept())
        if dialogo.exec() == QDialog.Accepted and arvore.currentItem() is not None:
            self.abrir_revisao_questao(arvore.currentItem().data(0, Qt.UserRole))

    def _limpar_alternativas_revisao(self):
        while self.revisao_alternativas_layout.count():
            item = self.revisao_alternativas_layout.takeAt(0)
            widget = item.widget()
            if widget is not None:
                widget.hide()
                widget.deleteLater()

    def abrir_revisao_questao(self, indice_fila):
        if self.finalizada or self._pausa_relogio is not None or self._editando_alternativas or self._editando_explicacao:
            return
        self._b22_parar_animacao()
        if indice_fila not in self._indices_questoes_revisaveis():
            return
        registro = self._obter_registro_revisao(indice_fila)
        if registro is None or indice_fila >= len(self.fila):
            return
        dados = obter_questao(self.fila[indice_fila]["id"])
        if not dados:
            QMessageBox.warning(self, "Histórico", "Não foi possível carregar a questão para revisão.")
            return

        if not self._modo_revisao_historico:
            self._estado_visual_pendente_revisao = {
                "indice": self.questao_indice.text(),
                "disciplina": self.questao_disciplina.text(),
                "meta": self.questao_meta.text(),
                "enunciado": self.questao_enunciado.text(),
                "tooltip_disciplina": self.questao_disciplina.toolTip(),
                "tooltip_meta": self.questao_meta.toolTip(),
                "feedback_visivel": self.feedback.isVisible(),
                "footer_visivel": self.painel_acoes_bateria.isVisible(),
                "posicao_rolagem": self.scroll_questao.verticalScrollBar().value(),
            }
            self._frames_pendentes_revisao = self.frame_por_letra
            self.pausar_cronometro_questao()
        self._modo_revisao_historico = True
        self._indice_revisao_historico = indice_fila
        self.caneta_estudo.limpar()
        self._atualizar_botao_caneta_estudo()
        self.questao_indice.setText(f"QUESTÃO {indice_fila + 1}  •  REVISÃO")
        self.questao_disciplina.setText(str(dados.get("disciplina") or "Disciplina").upper())
        self.questao_meta.setText(str(dados.get("topico") or "Tópico não informado"))
        self.questao_enunciado.setText(str(dados.get("enunciado") or ""))
        self.questao_disciplina.setToolTip("Questão anterior • somente leitura")
        self.questao_meta.setToolTip("Questão anterior • somente leitura")
        self.alternativas_container.hide()
        self.feedback.hide()
        self.painel_acoes_bateria.hide()
        self._limpar_alternativas_revisao()
        nova_frames = {}
        simulado_sem_gabarito = self.modo_simulado and not self.feedback_imediato
        marcada = registro.get("marcada")
        gabarito = registro.get("gabarito")
        for alternativa in dados.get("alternativas") or []:
            letra = alternativa.get("letra")
            frame = QFrame(self.revisao_container)
            frame.setObjectName("questionSolverAlternative")
            frame.setProperty("selectionState", "normal")
            frame.setProperty("eliminated", False)
            if simulado_sem_gabarito:
                estado = "normal"
            elif letra == gabarito:
                estado = "correta"
            elif letra == marcada and letra != gabarito:
                estado = "errada"
            else:
                estado = "normal"
            frame.setProperty("answerState", estado)
            linha = QHBoxLayout(frame)
            linha.setContentsMargins(11, 9, 11, 9)
            linha.setSpacing(8)
            rotulo = QLabel(f"{letra}", frame)
            rotulo.setObjectName("questionSolverRadio")
            rotulo.setFixedWidth(28)
            texto = QLabel(str(alternativa.get("texto") or ""), frame)
            texto.setObjectName("questionSolverAlternativeText")
            texto.setWordWrap(True)
            texto.setTextInteractionFlags(Qt.TextSelectableByMouse)
            linha.addWidget(rotulo, 0, Qt.AlignTop)
            linha.addWidget(texto, 1)
            self.revisao_alternativas_layout.addWidget(frame)
            nova_frames[letra] = frame
        self.frame_por_letra = nova_frames
        self.caneta_estudo.atualizar_alvos()
        if simulado_sem_gabarito:
            self.revisao_resultado.setText(
                f"Resposta registrada: {marcada}. O gabarito e a explicação serão exibidos após a entrega do simulado."
            )
            self.revisao_feedback.setProperty("resultState", "normal")
            self.revisao_explicacao.hide()
        else:
            status = str(registro.get("status") or "Respondida")
            self.revisao_resultado.setText(
                f"{status} • Sua resposta: {marcada} • Gabarito: {gabarito}"
            )
            self.revisao_feedback.setProperty(
                "resultState", "correta" if status == "Correta" else "errada"
            )
            explicacao = dados.get("explicacao") or ""
            html = explicacao_html(explicacao)
            self.revisao_explicacao.setTextFormat(Qt.RichText if html is not None else Qt.PlainText)
            self.revisao_explicacao.setText(html if html is not None else (str(explicacao) or "Sem explicação cadastrada."))
            self.revisao_explicacao.show()
        self.revisao_feedback.style().unpolish(self.revisao_feedback)
        self.revisao_feedback.style().polish(self.revisao_feedback)
        self.revisao_container.show()
        self.atualizar_navegacao_revisao_questoes()
        self.atualizar_menu_opcoes_topo()
        self.scroll_questao.verticalScrollBar().setValue(0)

    def sair_revisao_questoes(self):
        if not self._modo_revisao_historico:
            return
        estado = self._estado_visual_pendente_revisao or {}
        self._modo_revisao_historico = False
        self._indice_revisao_historico = None
        self.revisao_container.hide()
        self._limpar_alternativas_revisao()
        if self._frames_pendentes_revisao is not None:
            self.frame_por_letra = self._frames_pendentes_revisao
        self._frames_pendentes_revisao = None
        self.questao_indice.setText(estado.get("indice", self.questao_indice.text()))
        self.questao_disciplina.setText(estado.get("disciplina", self.questao_disciplina.text()))
        self.questao_meta.setText(estado.get("meta", self.questao_meta.text()))
        self.questao_enunciado.setText(estado.get("enunciado", self.questao_enunciado.text()))
        self.questao_disciplina.setToolTip(estado.get("tooltip_disciplina", ""))
        self.questao_meta.setToolTip(estado.get("tooltip_meta", ""))
        self.alternativas_container.show()
        self.feedback.setVisible(bool(estado.get("feedback_visivel", False)))
        self.painel_acoes_bateria.setVisible(bool(estado.get("footer_visivel", True)))
        self._estado_visual_pendente_revisao = None
        self.caneta_estudo.limpar()
        self.caneta_estudo.atualizar_alvos()
        self._atualizar_botao_caneta_estudo()
        self.retomar_cronometro_questao()
        self.atualizar_navegacao_revisao_questoes()
        self.atualizar_menu_opcoes_topo()
        self.scroll_questao.verticalScrollBar().setValue(
            int(estado.get("posicao_rolagem", 0))
        )

    def carregar_atual(self):
        self._b26_parar_navegacao()
        self._b22_parar_animacao()
        self._b16_ocultar_linha()
        self._b16_cache_metricas = None
        self._t01_evento('questao_carregar', gravar=False)
        self._modo_revisao_historico = False
        self._indice_revisao_historico = None
        if self.indice >= len(
            self.fila
        ):
            self.finalizar(
                True,
                "Objetivo concluído"
            )
            return

        resumo_item = self.fila[
            self.indice
        ]

        dados = obter_questao(
            resumo_item[
                "id"
            ]
        )

        if (
            dados is None
            or (
                self.modo_banco_erros
                and (
                    not dados.get("ativa", False)
                    or dados.get("excluida", False)
                )
            )
        ):
            self.indice += 1
            self.carregar_atual()
            return

        # Cada questão começa sem rabiscos ou histórico de desfazer, mas
        # conserva a ferramenta, a cor e a espessura escolhidas na paleta.
        # O modo leitura só é ativado quando o usuário escolhe o olho.
        self.caneta_estudo.limpar()
        self._atualizar_botao_caneta_estudo()
        self.questao_atual = {
            **resumo_item,
            **dados,
        }
        if self.sem_impacto_inteligencia:
            self.item_sessao_atual_id = None
        else:
            self.item_sessao_atual_id = marcar_item_sessao_apresentado(
                self.sessao_id,
                self.indice + 1,
                self.questao_atual["id"],
            )
        self.resposta_confirmada = False
        self._editando_explicacao = False
        self._editando_alternativas = False
        self.painel_edicao_alternativas.hide()
        self.feedback_explicacao_editor.setVisible(False)
        self.feedback_explicacao_barra.setVisible(False)
        self.feedback_explicacao_acoes.setVisible(False)
        self.explicacao_previa_botao.setChecked(False)
        self.explicacao_previa_botao.setText("Visualizar")
        self.feedback_explicacao.setVisible(True)
        self.feedback_explicacao_editar.setVisible(False)
        self.inicio_questao = datetime.now()
        self._questao_pausa_iniciada = None
        self._questao_tempo_pausado = 0.0

        # O total pode crescer quando uma questão pulada é reagendada para
        # o fim. A barra acompanha a fila real exibida, sem alterar o objetivo
        # acadêmico original da sessão salvo no banco.
        self.sessao_progresso.setMaximum(
            max(1, len(self.fila))
        )
        retorno_pulo = bool(
            resumo_item.get("retorno_pulo")
            or self.pulos_por_questao.get(
                int(self.questao_atual["id"]),
                0
            ) >= 1
        )
        ciclo_progresso_rotulo = ""
        if self.ciclo_questoes_id is not None:
            try:
                estado_ciclo = obter_estado_ciclo_questoes(
                    self.ciclo_questoes_id
                )
                self.estado_ciclo_questoes = estado_ciclo
                if estado_ciclo:
                    ciclo_progresso_rotulo = (
                        f"Ciclo {int(estado_ciclo.get('respondidas') or 0)}/"
                        f"{int(estado_ciclo.get('total') or 0)}"
                        f"  •  {int(estado_ciclo.get('pendentes') or 0)} pendentes"
                    )
            except Exception:
                ciclo_progresso_rotulo = ""

        self.sessao_progresso_texto.setText(
            f"Questão {self.indice + 1} de {len(self.fila)}"
            + ("  •  retorno" if retorno_pulo else "")
        )
        self.sessao_ciclo_texto.setText(ciclo_progresso_rotulo)
        self.sessao_ciclo_texto.setVisible(bool(ciclo_progresso_rotulo))
        self.questao_indice.setText(
            f"QUESTÃO {self.indice + 1}"
            + ("  •  RETORNO" if retorno_pulo else "")
        )
        self.sessao_progresso.setValue(
            self.indice
        )
        self.botao_pular.setText(
            "Pular novamente"
            if retorno_pulo
            else "Pular questão"
        )
        self.botao_pular.setToolTip(
            (
                "Pular mantém a questão pendente no Banco de Erros."
                if self.modo_banco_erros
                else (
                    "Segundo pulo: esta questão será registrada como erro para "
                    "a inteligência e passará a contar como coberta."
                    if retorno_pulo
                    else (
                        "Primeiro pulo: a questão volta ao final da bateria. "
                        "Se for pulada novamente, será tratada como erro pela inteligência."
                    )
                )
            )
        )

        estado_historico = (
            "Banco de Erros • treino livre"
            if self.modo_banco_erros
            else "Reforço sem impacto"
            if self.sem_impacto_inteligencia
            else (
                "Inédita"
                if resumo_item["inedita"]
                else f"Já respondida {resumo_item['tentativas_anteriores']}x"
            )
        )

        self.questao_disciplina.setText(
            str(dados.get("disciplina") or "Disciplina").upper()
        )
        self.questao_meta.setText(
            str(dados.get("topico") or "Tópico não informado")
        )

        detalhes_metadata = [estado_historico]
        categoria_smart = resumo_item.get("categoria_rotulo")
        if categoria_smart:
            detalhes_metadata.append(str(categoria_smart))

        if resumo_item.get("sessao_adaptativa"):
            detalhes_metadata.append(
                "Prioridade adaptativa "
                f"{resumo_item.get('prioridade_topico', 0):.0f}"
            )

        if dados.get("banca"):
            detalhes_metadata.append(str(dados["banca"]))
        if dados.get("ano"):
            detalhes_metadata.append(str(dados["ano"]))
        if dados.get("dificuldade"):
            detalhes_metadata.append(str(dados["dificuldade"]))

        tipo_questao = _questao_tipo(dados)
        if tipo_questao == "CERTO_ERRADO":
            detalhes_metadata.append("Certo / Errado")

        # Remove repetições como "Inédita • Inédita" sem ocultar informação
        # real: os detalhes continuam disponíveis no tooltip do contexto.
        detalhes_unicos = []
        chaves_metadata = set()
        for detalhe in detalhes_metadata:
            chave = str(detalhe).strip().casefold()
            if chave and chave not in chaves_metadata:
                chaves_metadata.add(chave)
                detalhes_unicos.append(str(detalhe).strip())

        motivo_smart = resumo_item.get("motivo_inteligente", "")
        motivo_adaptativo = resumo_item.get("motivo_adaptativo", "")
        tooltip_partes = []
        if detalhes_unicos:
            tooltip_partes.append(" • ".join(detalhes_unicos))
        tooltip_partes.extend(
            texto
            for texto in (motivo_adaptativo, motivo_smart)
            if texto
        )
        tooltip_contexto = "\n".join(tooltip_partes)
        self.questao_disciplina.setToolTip(tooltip_contexto)
        self.questao_meta.setToolTip(tooltip_contexto)

        self.questao_enunciado.setText(
            dados[
                "enunciado"
            ]
        )

        # A lista de alternativas é reconstruída como uma atualização atômica.
        # Sem isso, o Windows pode receber um repaint entre a remoção dos
        # widgets antigos e a inserção dos novos, produzindo um pequeno
        # "flash" do QToolButton de eliminação no meio da janela.
        self.alternativas_container.setUpdatesEnabled(False)
        try:
            self.limpar_alternativas()

            for alternativa in dados[
                "alternativas"
            ]:
                letra = alternativa[
                    "letra"
                ]

                # Pais explícitos impedem que qualquer controle da alternativa
                # exista, ainda que por um instante, como janela top-level.
                frame = QFrame(self.alternativas_container)
                frame.setObjectName(
                    "questionSolverAlternative"
                )
                frame.setProperty(
                    "answerState",
                    "normal"
                )
                frame.setProperty(
                    "selectionState",
                    "normal"
                )
                frame.setProperty(
                    "eliminated",
                    False
                )
                frame.setProperty(
                    "keyboardFocus",
                    False
                )
                frame.setFocusPolicy(Qt.StrongFocus)
                frame.setAttribute(Qt.WA_Hover, True)
                frame.setCursor(Qt.PointingHandCursor)
                frame.setMinimumHeight(45)

                linha = QHBoxLayout(
                    frame
                )
                linha.setContentsMargins(12, 8, 12, 8)
                linha.setSpacing(8)

                eliminar = QToolButton(frame)
                eliminar.setObjectName(
                    "questionSolverEliminateButton"
                )
                eliminar.setText(
                    "✂"
                )
                eliminar.setCheckable(
                    True
                )
                eliminar.setAutoRaise(
                    True
                )
                eliminar.setFixedSize(
                    24,
                    24
                )
                eliminar.setToolTip(
                    f"Eliminar alternativa {letra}"
                )
                eliminar.setVisible(
                    tipo_questao != "CERTO_ERRADO"
                )
                eliminar.setAccessibleName(
                    eliminar.toolTip()
                )

                radio = QRadioButton(
                    _rotulo_resposta_questao(
                        letra,
                        tipo_questao
                    ),
                    frame
                )
                radio.setObjectName(
                    "questionSolverRadio"
                )
                radio.setProperty(
                    "letra",
                    letra
                )
                radio.setProperty(
                    "eliminated",
                    False
                )
                radio.setFixedWidth(106 if tipo_questao == "CERTO_ERRADO" else 30)
                radio.setMinimumHeight(24)

                texto = QLabel(
                    alternativa[
                        "texto"
                    ],
                    frame
                )
                texto.setObjectName(
                    "questionSolverAlternativeText"
                )
                texto.setProperty(
                    "eliminated",
                    False
                )
                texto.setWordWrap(
                    True
                )
                texto.setTextInteractionFlags(
                    Qt.TextSelectableByMouse
                )
                texto.setMouseTracking(True)  # B15: so os textos de leitura

                linha.addWidget(
                    eliminar,
                    0,
                    Qt.AlignTop
                )
                linha.addWidget(
                    radio,
                    0,
                    Qt.AlignTop
                )
                linha.addWidget(
                    texto,
                    1
                )

                self.grupo_alternativas.addButton(
                    radio
                )
                self.radio_por_letra[
                    letra
                ] = radio
                self.frame_por_letra[
                    letra
                ] = frame
                self.texto_por_letra[
                    letra
                ] = texto
                self.botao_eliminar_por_letra[
                    letra
                ] = eliminar

                # O card inteiro é clicável. O botão da tesoura fica de fora
                # deste mapa para continuar sendo uma ação independente.
                self._letra_por_widget_alternativa[frame] = letra
                self._letra_por_widget_alternativa[texto] = letra
                frame.installEventFilter(self)
                texto.installEventFilter(self)

                eliminar.toggled.connect(
                    lambda eliminada, alternativa_letra=letra:
                        self.alternar_eliminacao_alternativa(
                            alternativa_letra,
                            eliminada
                        )
                )
                radio.toggled.connect(
                    self.atualizar_selecao_visual_alternativas
                )

                self.alternativas_layout.addWidget(
                    frame
                )
        finally:
            self.alternativas_container.setUpdatesEnabled(True)
            self.alternativas_container.update()

        # As superfícies locais acompanham os novos cartões; nenhuma camada
        # cobre o menu Rabiscar nem os controles fora das alternativas.
        self.caneta_estudo.atualizar_alvos()

        self.duvida.setChecked(
            False
        )
        self.duvida.setEnabled(
            True
        )
        analise_pendente = bool(
            dados.get(
                "analise_pendente",
                False
            )
        )
        self.analise_pendente.blockSignals(
            True
        )
        self.analise_pendente.setChecked(
            analise_pendente
        )
        self.analise_pendente.blockSignals(
            False
        )
        self.analise_pendente.setEnabled(
            not self.sem_impacto_inteligencia
        )
        self.botao_editar_alternativas.setEnabled(
            tipo_questao == "MULTIPLA_ESCOLHA"
        )
        self.botao_editar_alternativas.setToolTip(
            "Edite os textos A–E sem sair da bateria."
            if tipo_questao == "MULTIPLA_ESCOLHA"
            else "Os rótulos Certo/Errado são fixos; esta edição é apenas para múltipla escolha."
        )
        self.atualizar_menu_opcoes_topo()
        self.atualizar_rotulo_analise_pendente(
            analise_pendente
        )
        self.feedback.setVisible(
            False
        )
        self.feedback_fila.setVisible(False)
        self.botao_pular.setVisible(True)
        self.botao_pular.setEnabled(
            True
        )
        self.botao_confirmar.setVisible(
            True
        )
        self.botao_confirmar.setEnabled(
            True
        )
        self.botao_proxima.setVisible(
            False
        )
        self.atualizar_navegacao_revisao_questoes()
        # B05: a questão seguinte começa do enunciado, não da posição
        # abandonada na explicação anterior. O guard protege o histórico.
        QTimer.singleShot(
            0, lambda indice=self.indice: self._b05_repor_inicio_leitura(indice)
        )

    def atualizar_selecao_visual_alternativas(self, *_args):
        if self.resposta_confirmada:
            return

        for letra, frame in self.frame_por_letra.items():
            radio = self.radio_por_letra.get(letra)
            selecionada = bool(radio is not None and radio.isChecked())
            frame.setProperty(
                "selectionState",
                "selected" if selecionada else "normal"
            )
            frame.style().unpolish(frame)
            frame.style().polish(frame)

    def alternativa_selecionada(self):
        for letra, radio in self.radio_por_letra.items():
            if radio.isChecked():
                return letra

        return None

    def tempo_atual_segundos(self):
        if self.inicio_questao is None:
            return None

        agora = datetime.now()
        pausado = float(self._questao_tempo_pausado or 0.0)
        if self._questao_pausa_iniciada is not None:
            pausado += max(
                0.0,
                (agora - self._questao_pausa_iniciada).total_seconds(),
            )

        return max(
            0,
            int((agora - self.inicio_questao).total_seconds() - pausado),
        )

    def atualizar_metricas(self):
        respondidas = sum(
            1
            for item in self.registros
            if item[
                "status"
            ] in (
                "Correta",
                "Errada"
            )
        )
        acertos = sum(
            1
            for item in self.registros
            if item[
                "status"
            ] == "Correta"
        )
        erros = sum(
            1
            for item in self.registros
            if item[
                "status"
            ] == "Errada"
        )
        puladas = sum(
            1
            for item in self.registros
            if item[
                "status"
            ] == "Pulada"
        )

        self.stat_respondidas.setText(
            str(
                respondidas
            )
        )
        if self.modo_simulado:
            self.stat_acertos.setText(
                "—"
            )
            self.stat_erros.setText(
                "—"
            )
        else:
            self.stat_acertos.setText(
                str(
                    acertos
                )
            )
            self.stat_erros.setText(
                str(
                    erros
                )
            )
        self.stat_puladas.setText(
            str(
                puladas
            )
        )

    def confirmar_resposta(self):
        self._b26_parar_navegacao()
        self._t01_evento('questao_confirmar_resposta', gravar=False)
        if self._modo_revisao_historico:
            return
        if self._pausa_relogio is not None or self.resposta_confirmada or self._editando_alternativas:
            return

        marcada = (
            self.alternativa_selecionada()
        )

        if marcada is None:
            QMessageBox.information(
                self,
                "Resolver questões",
                "Marque uma alternativa antes de confirmar."
            )
            return

        if self.sem_impacto_inteligencia:
            gabarito_local = next(
                (
                    alternativa.get("letra")
                    for alternativa in self.questao_atual.get("alternativas", [])
                    if alternativa.get("correta")
                ),
                None,
            )
            resultado = {
                "correta": bool(gabarito_local and marcada == gabarito_local),
                "gabarito": gabarito_local,
                "alternativa_marcada": marcada,
            }
            if self.modo_banco_erros:
                try:
                    resultado_fila = processar_resposta_banco_erros(
                        self.configuracao["concurso_id"],
                        self.questao_atual["id"],
                        resultado["correta"],
                    )
                except Exception as erro:
                    QMessageBox.critical(
                        self,
                        "Banco de Erros",
                        "Não foi possível atualizar a pendência.\n\n" + str(erro),
                    )
                    return
                resultado["resultado_banco_erros"] = resultado_fila
                if resultado_fila.get("removida"):
                    self.banco_erros_removidas.add(
                        int(self.questao_atual["id"])
                    )
        else:
            try:
                resultado = registrar_tentativa_questao(
                    self.sessao_id,
                    self.questao_atual[
                        "id"
                    ],
                    self.configuracao[
                        "concurso_id"
                    ],
                    alternativa_marcada=marcada,
                    marcada_duvida=self.duvida.isChecked(),
                    tempo_segundos=self.tempo_atual_segundos(),
                    item_sessao_id=self.item_sessao_atual_id,
                )
            except Exception as erro:
                QMessageBox.critical(
                    self,
                    "Resolver questões",
                    (
                        "Não foi possível registrar a resposta.\n\n"
                        f"{erro}"
                    )
                )
                return

        # MÉRITO M13 — somente após registrar_tentativa_questao retornar com sucesso.
        if not self.sem_impacto_inteligencia:
            self._m13_evento_tentativa_confirmada(resultado)

        if (
            self.ciclo_questoes_id is not None
            and not self.sem_impacto_inteligencia
            and resultado.get("correta") is not None
        ):
            try:
                self.estado_ciclo_questoes = marcar_questao_ciclo_respondida(
                    self.ciclo_questoes_id,
                    self.questao_atual["id"],
                    tentativa_id=resultado.get("tentativa_id"),
                )
            except Exception:
                # A tentativa acadêmica já foi salva. Uma falha de telemetria
                # do ciclo não deve impedir a continuidade da sessão.
                self.estado_ciclo_questoes = None

        self.resposta_confirmada = True

        correta = bool(
            resultado[
                "correta"
            ]
        )
        gabarito = resultado[
            "gabarito"
        ]

        status = (
            "Correta"
            if correta
            else "Errada"
        )

        self.registros.append({
            "questao_id": self.questao_atual[
                "id"
            ],
            "disciplina": self.questao_atual[
                "disciplina"
            ],
            "topico": self.questao_atual[
                "topico"
            ],
            "topico_id": self.questao_atual.get(
                "topico_id"
            ),
            "dificuldade": self.questao_atual.get(
                "dificuldade"
            ) or "Não informada",
            "tipo_questao": _questao_tipo(self.questao_atual),
            "status": status,
            "duvida": self.duvida.isChecked(),
            "inedita": self.questao_atual[
                "inedita"
            ],
            "indice_fila": self.indice,
            "marcada": marcada,
            "gabarito": gabarito,
            "removida_banco_erros": bool(
                resultado.get("resultado_banco_erros", {}).get("removida")
            ),
        })
        # Atualiza a sequência funcional apenas com resultado revelado;
        # simulados sem feedback imediato ficam visualmente isolados.
        self._b26_registrar_resultado_combo(status)
        # Libera o histórico imediatamente após confirmar, inclusive em
        # simulados sem feedback imediato (sem revelar o gabarito).
        self.atualizar_navegacao_revisao_questoes()

        for botao in self.botao_eliminar_por_letra.values():
            botao.setEnabled(
                False
            )

        if (
            self.modo_simulado
            and not self.feedback_imediato
        ):
            for radio in self.radio_por_letra.values():
                radio.setEnabled(
                    False
                )

            self.duvida.setEnabled(
                False
            )
            self.botao_pular.setEnabled(
                False
            )
            self.botao_confirmar.setVisible(
                False
            )
            self.botao_proxima.setVisible(
                True
            )
            self.botao_proxima.setFocus(Qt.OtherFocusReason)
            self.feedback.setVisible(
                False
            )

            self.atualizar_metricas()

            if (
                self.indice
                == len(
                    self.fila
                )
                - 1
            ):
                self.botao_proxima.setText(
                    "Entregar simulado"
                )
            else:
                self.botao_proxima.setText(
                    "Próxima questão"
                )

            return

        for letra, radio in self.radio_por_letra.items():
            radio.setEnabled(
                False
            )

            frame = self.frame_por_letra[
                letra
            ]
            frame.setProperty(
                "selectionState",
                "normal"
            )

            if letra == gabarito:
                estado = "correta"
            elif (
                letra == marcada
                and letra != gabarito
            ):
                estado = "errada"
            else:
                estado = "normal"

            frame.setProperty(
                "answerState",
                estado
            )
            frame.style().unpolish(
                frame
            )
            frame.style().polish(
                frame
            )

        self.duvida.setEnabled(
            False
        )
        self.botao_pular.setEnabled(
            False
        )
        self.botao_confirmar.setVisible(
            False
        )
        self.botao_proxima.setVisible(
            True
        )
        self.botao_proxima.setFocus(Qt.OtherFocusReason)

        if correta:
            self.feedback.setProperty(
                "resultState",
                "correta"
            )
            self.feedback_titulo.setText(
                "✓ Resposta correta"
            )
        else:
            self.feedback.setProperty(
                "resultState",
                "errada"
            )
            self.feedback_titulo.setText(
                (
                    f"✕ Resposta incorreta "
                    f"• Gabarito: {_rotulo_resposta_questao(gabarito, _questao_tipo(self.questao_atual))}"
                )
            )

        self.atualizar_texto_feedback_explicacao()
        self.feedback_explicacao_editar.setVisible(True)

        if self.modo_banco_erros:
            self.feedback_fila.setText(
                "Questão removida do Banco de Erros"
                if correta
                else "Questão permanece no Banco de Erros"
            )
            self.feedback_fila.setVisible(True)

        self.feedback.style().unpolish(
            self.feedback
        )
        self.feedback.style().polish(
            self.feedback
        )
        self.feedback.setVisible(
            True
        )

        self.atualizar_metricas()
        self.atualizar_navegacao_revisao_questoes()
        if correta:
            self._b26r2_tocar_som("acerto")
            self._b22_iniciar_acerto(gabarito)

        if (
            self.indice
            == len(
                self.fila
            )
            - 1
        ):
            self.botao_proxima.setText(
                "Concluir sessão"
            )
        else:
            self.botao_proxima.setText(
                "Próxima questão"
            )

    def pular(self):
        if self._modo_revisao_historico:
            return
        if self._pausa_relogio is not None or self.resposta_confirmada or self._editando_alternativas:
            return

        questao_id = int(self.questao_atual["id"])
        pulos_anteriores = int(
            self.pulos_por_questao.get(questao_id, 0)
        )
        segundo_pulo = pulos_anteriores >= 1

        # No segundo pulo a omissão passa a valer como erro efetivo. Assim a
        # questão entra na evidência da inteligência, conta para a cobertura
        # da revisão e volta a ser priorizada como uma resposta incorreta.
        tratar_como_erro = bool(
            segundo_pulo
            and not self.sem_impacto_inteligencia
        )

        if not self.sem_impacto_inteligencia:
            try:
                resultado_pulo = registrar_tentativa_questao(
                    self.sessao_id,
                    questao_id,
                    self.configuracao["concurso_id"],
                    alternativa_marcada=None,
                    marcada_duvida=self.duvida.isChecked(),
                    tempo_segundos=self.tempo_atual_segundos(),
                    item_sessao_id=self.item_sessao_atual_id,
                    tratar_pulo_como_erro=tratar_como_erro,
                )
            except Exception as erro:
                QMessageBox.critical(
                    self,
                    "Resolver questões",
                    (
                        "Não foi possível registrar a questão pulada.\n\n"
                        f"{erro}"
                    )
                )
                return
        else:
            resultado_pulo = {
                "pulo_convertido_erro": False,
            }

        # MÉRITO M13 — o pulo só entra após persistência acadêmica confirmada.
        if not self.sem_impacto_inteligencia:
            self._m13_evento_tentativa_confirmada(resultado_pulo)

        if (
            self.ciclo_questoes_id is not None
            and not self.sem_impacto_inteligencia
            and bool(resultado_pulo.get("pulo_convertido_erro"))
        ):
            try:
                self.estado_ciclo_questoes = marcar_questao_ciclo_respondida(
                    self.ciclo_questoes_id,
                    questao_id,
                    tentativa_id=resultado_pulo.get("tentativa_id"),
                )
            except Exception:
                self.estado_ciclo_questoes = None

        self.pulos_por_questao[questao_id] = pulos_anteriores + 1

        gabarito_pulada = next(
            (
                alternativa["letra"]
                for alternativa in self.questao_atual["alternativas"]
                if alternativa.get("correta")
            ),
            None
        )

        status_registro = (
            "Errada"
            if tratar_como_erro
            else "Pulada"
        )

        self.registros.append({
            "questao_id": questao_id,
            "disciplina": self.questao_atual["disciplina"],
            "topico": self.questao_atual["topico"],
            "topico_id": self.questao_atual.get("topico_id"),
            "dificuldade": self.questao_atual.get("dificuldade") or "Não informada",
            "tipo_questao": _questao_tipo(self.questao_atual),
            "status": status_registro,
            "duvida": self.duvida.isChecked(),
            "inedita": self.questao_atual["inedita"],
            "indice_fila": self.indice,
            "marcada": None,
            "gabarito": gabarito_pulada,
            "pulo": True,
            "pulo_convertido_erro": tratar_como_erro,
        })
        self._b26_registrar_resultado_combo(status_registro)

        # Primeiro pulo: devolve a mesma questão ao final da bateria. Criamos
        # também um novo item de telemetria no banco para que a segunda
        # apresentação fique corretamente ligada à sessão.
        if not segundo_pulo:
            item_retorno = dict(self.fila[self.indice])
            item_retorno["retorno_pulo"] = True
            item_retorno["motivo_inteligente"] = (
                "Questão pulada anteriormente: segunda oportunidade nesta bateria."
            )

            pode_reagendar = True
            if not self.sem_impacto_inteligencia:
                try:
                    reagendar_questao_pulada_no_fim_sessao(
                        self.sessao_id,
                        questao_id,
                    )
                except Exception as erro:
                    pode_reagendar = False
                    QMessageBox.warning(
                        self,
                        "Questão pulada",
                        (
                            "A questão foi registrada como pulada, mas não foi "
                            "possível colocá-la novamente no fim da bateria.\n\n"
                            f"{erro}"
                        )
                    )

            if pode_reagendar:
                self.fila.append(item_retorno)
                self.sessao_progresso.setMaximum(
                    max(1, len(self.fila))
                )

        self.atualizar_metricas()
        self.atualizar_navegacao_revisao_questoes()
        self.indice += 1
        self.sessao_progresso.setValue(self.indice)

        if self.indice >= len(self.fila):
            self.finalizar(
                True,
                "Objetivo concluído"
            )
        else:
            self.carregar_atual()

    def proxima(self):
        self._t01_evento('questao_proxima', gravar=False)
        if self._modo_revisao_historico:
            return
        if (self.finalizada or self._pausa_relogio is not None
                or self._editando_alternativas):
            return
        self.indice += 1
        self.sessao_progresso.setValue(
            self.indice
        )

        if self.indice >= len(
            self.fila
        ):
            self.finalizar(
                True,
                "Objetivo concluído"
            )
        else:
            # B26 R5: acionamento UNICO aqui, seja pelo último Enter ou
            # pelo botão inferior. O som só toca quando outra questão é aberta;
            # a última questão conclui a sessão sem sinal de transição.
            self.carregar_atual()
            if not self.finalizada:
                self._b26r2_tocar_som("proxima_questao")

    def encerrar_manual(self):
        if self.finalizada:
            return
        if not self.confirmar_saida_com_edicao_alternativas():
            return

        resposta = QMessageBox.question(
            self,
            (
                "Entregar simulado"
                if self.modo_simulado
                else "Encerrar sessão"
            ),
            (
                (
                    "Deseja entregar o simulado agora?\n\n"
                    "Questões ainda não processadas ficarão sem resposta "
                    "e a correção será exibida para as questões já registradas."
                )
                if self.modo_simulado
                else (
                    (
                        (
                            "Deseja encerrar o Banco de Erros agora?\n\n"
                            "Questões não respondidas ou erradas permanecerão pendentes."
                        )
                        if self.modo_banco_erros
                        else (
                            "Deseja encerrar o reforço imediato agora?\n\n"
                            "As respostas desta rodada não são gravadas no histórico do Vighna."
                        )
                    )
                    if self.sem_impacto_inteligencia
                    else (
                        "Deseja encerrar a sessão agora?\n\n"
                        "As respostas já registradas serão preservadas."
                    )
                )
            ),
            QMessageBox.Yes
            | QMessageBox.No,
            QMessageBox.No
        )

        if resposta != QMessageBox.Yes:
            return

        self.finalizar(
            False,
            "Encerrada manualmente"
        )

    def finalizar(
        self,
        concluida,
        motivo
    ):
        self._t01_evento('sessao_finalizar_inicio')
        if self.finalizada:
            return

        self._b22_parar_animacao()
        self._b26_resetar_combo()
        self.encerrar_pausa_programada(trazer_bateria=False)
        self.finalizada = True

        if self.timer_simulado is not None:
            self.timer_simulado.stop()

        if self.sem_impacto_inteligencia:
            respondidas = sum(
                1 for item in self.registros
                if item.get("status") in ("Correta", "Errada")
            )
            acertos = sum(
                1 for item in self.registros
                if item.get("status") == "Correta"
            )
            erros = sum(
                1 for item in self.registros
                if item.get("status") == "Errada"
            )
            puladas = sum(
                1 for item in self.registros
                if item.get("status") == "Pulada"
            )
            duvidas = sum(
                1 for item in self.registros
                if item.get("duvida")
            )
            desempenho = (100.0 * acertos / respondidas) if respondidas else None
            resumo = {
                "sessao_id": None,
                "concurso_id": self.configuracao.get("concurso_id"),
                "concurso": self.configuracao.get("concurso_nome", "VighnaStudy"),
                "modo": self.configuracao.get("modo", "Reforço imediato"),
                "objetivo": self.quantidade_planejada_inicial,
                "concluida": bool(concluida),
                "origem": (
                    "banco_erros"
                    if self.modo_banco_erros
                    else "reforco_pos_bateria"
                ),
                "versao_motor": "sem_registro",
                "planejadas": self.quantidade_planejada_inicial,
                "apresentadas": min(len(self.fila), len(self.registros)),
                "nao_respondidas": 0,
                "nao_alcancadas": max(
                    0,
                    self.quantidade_planejada_inicial
                    - len({item.get("questao_id") for item in self.registros}),
                ),
                "processadas": len(self.registros),
                "respondidas": respondidas,
                "acertos": acertos,
                "erros": erros,
                "puladas": puladas,
                "duvidas": duvidas,
                "desempenho": desempenho,
                "praticadas": respondidas,
                "removidas_fila": len(self.banco_erros_removidas),
                "ainda_pendentes": max(
                    0,
                    self.quantidade_planejada_inicial
                    - len(self.banco_erros_removidas),
                ),
            }
            self.resumo_final = resumo
            JanelaResumoResolucaoQuestoes(
                resumo,
                self.registros,
                motivo,
                [],
                self,
                estrategia=None,
                efetividade=None,
                simulado=None,
                fila_original=self.fila,
                configuracao_original=self.configuracao,
                permitir_acoes_pos_bateria=False,
                pausas_sessao=self._b21_fotografia_pausas(),
            ).exec()
            self.accept()
            return

        _m13_encerramento_confirmado = False
        try:
            encerrar_sessao_questoes(
                self.sessao_id,
                concluida=concluida
            )
            _m13_encerramento_confirmado = True
        except Exception:
            pass
        # MÉRITO M13 — simulado não concluído continua retido no leitor M09.
        if self.modo_simulado and bool(concluida) and _m13_encerramento_confirmado:
            self._m13_evento_simulado_entregue()

        if self.integrar_revisoes:
            try:
                self.resultados_integracao = (
                    integrar_sessao_questoes_com_revisoes(
                        self.sessao_id
                    )
                )
            except Exception as erro:
                self.resultados_integracao = []

                QMessageBox.warning(
                    self,
                    "Integração com revisões",
                    (
                        "As respostas foram salvas, mas não foi possível "
                        "consolidar automaticamente as revisões.\n\n"
                        f"{erro}"
                    )
                )
        else:
            self.resultados_integracao = []

        try:
            self.efetividade_final = (
                finalizar_medicao_efetividade_sessao(
                    self.sessao_id
                )
            )
        except Exception:
            self.efetividade_final = None

        self.analise_simulado_v2 = None
        if self.modo_simulado:
            try:
                self.analise_simulado_v2 = analisar_resultado_simulado_v2(
                    self.sessao_id,
                    self.configuracao["concurso_id"],
                    self.configuracao.get("dominio_antes_simulado", {}),
                )
                registrar_analise_simulado_v2(
                    self.sessao_id,
                    self.analise_simulado_v2,
                )
            except Exception:
                self.analise_simulado_v2 = None

        resumo = obter_resumo_sessao_questoes(
            self.sessao_id
        )
        self.resumo_final = resumo

        if resumo is not None:
            janela_resumo = JanelaResumoResolucaoQuestoes(
                resumo,
                self.registros,
                motivo,
                self.resultados_integracao,
                self,
                estrategia=self.configuracao.get(
                    "estrategia_adaptativa"
                ),
                efetividade=self.efetividade_final,
                simulado=(
                    {
                        **self.configuracao,
                        "analise_v2": self.analise_simulado_v2,
                    }
                    if self.modo_simulado
                    else None
                ),
                fila_original=self.fila,
                configuracao_original=self.configuracao,
                permitir_acoes_pos_bateria=True,
                pausas_sessao=self._b21_fotografia_pausas(),
            )
            janela_resumo.exec()
            self.proxima_acao_final = janela_resumo.proxima_acao

        # A sessão pode ter alterado revisão, percentual, próxima data e
        # estatísticas. Invalide os caches ANTES de devolver o controle para
        # telas já pré-carregadas (como a lista da disciplina).
        self._notificar_dados_pos_sessao()
        self.accept()

    def done(self, resultado):
        self._b26r2_audio.parar()
        self._b26_parar_navegacao()
        self._b22_parar_animacao()
        self._b16_ocultar_linha()
        self._b15_ocultar_halo()
        self._t01_evento('sessao_fechar')
        self._t01_encerrar()
        self.caneta_estudo.definir_modo(None)
        self.caneta_estudo.limpar()
        self.encerrar_pausa_programada(trazer_bateria=False)
        if self._filtro_teclado_aplicacao_instalado:
            app = QApplication.instance()
            if app is not None:
                try:
                    app.removeEventFilter(self)
                except RuntimeError:
                    pass
            self._filtro_teclado_aplicacao_instalado = False
        super().done(resultado)

    def closeEvent(
        self,
        event
    ):
        if self.finalizada:
            self._b26r2_audio.parar()
            self._b22_parar_animacao()
            self._t01_encerrar()
            event.accept()
            return
        if not self.confirmar_saida_com_edicao_alternativas():
            event.ignore()
            return

        resposta = QMessageBox.question(
            self,
            (
                "Entregar simulado"
                if self.modo_simulado
                else "Encerrar sessão"
            ),
            (
                (
                    "Fechar esta janela entregará o simulado com as respostas "
                    "já registradas. A correção será exibida em seguida.\n\n"
                    "Deseja continuar?"
                )
                if self.modo_simulado
                else (
                    (
                        (
                            "Fechar esta janela encerrará o Banco de Erros.\n\n"
                            "Questões não respondidas ou erradas permanecerão pendentes. "
                            "Deseja continuar?"
                        )
                        if self.modo_banco_erros
                        else (
                            "Fechar esta janela encerrará o reforço imediato.\n\n"
                            "As respostas desta rodada não são gravadas no histórico. "
                            "Deseja continuar?"
                        )
                    )
                    if self.sem_impacto_inteligencia
                    else (
                        "Fechar esta janela encerrará a sessão atual.\n\n"
                        "As respostas já registradas serão preservadas. "
                        "Deseja continuar?"
                    )
                )
            ),
            QMessageBox.Yes
            | QMessageBox.No,
            QMessageBox.No
        )

        if resposta != QMessageBox.Yes:
            event.ignore()
            return

        if self.sem_impacto_inteligencia:
            event.ignore()
            if self.modo_banco_erros:
                self.finalizar(
                    False,
                    "Encerrado ao fechar"
                )
            else:
                self.finalizada = True
                self.reject()
            return

        if self.modo_simulado:
            event.ignore()
            self.finalizar(
                False,
                "Encerrado ao fechar"
            )
            return

        self.finalizada = True

        try:
            encerrar_sessao_questoes(
                self.sessao_id,
                concluida=False
            )
        except Exception:
            pass

        if self.integrar_revisoes:
            try:
                self.resultados_integracao = (
                    integrar_sessao_questoes_com_revisoes(
                        self.sessao_id
                    )
                )
            except Exception:
                self.resultados_integracao = []
        else:
            self.resultados_integracao = []

        try:
            self.efetividade_final = (
                finalizar_medicao_efetividade_sessao(
                    self.sessao_id
                )
            )
        except Exception:
            self.efetividade_final = None

        self.resumo_final = (
            obter_resumo_sessao_questoes(
                self.sessao_id
            )
        )

        # Mesmo em encerramento pela janela, as respostas preservadas podem
        # alterar a revisão consolidada do tópico. Limpe os caches antes de
        # retornar para a tela anterior.
        self._notificar_dados_pos_sessao()

        # ``reject`` também emite ``finished`` e libera o ciclo local usado
        # pela abertura não modal. As respostas registradas já foram salvas.
        event.ignore()
        self.reject()


def abrir_resolvedor_topico(
    topico_id,
    nome_topico,
    parent=None,
    quantidade_padrao=10,
    quantidade_exata=None,
    modo_nome=None,
    origem_sessao=None
):
    concurso = obter_concurso_ativo()
    topico_solicitado_nome = nome_topico
    aviso_topico_equivalente = ""

    disponiveis = listar_questoes_resolucao(
        concurso[0],
        topico_id=topico_id,
        somente_ineditas=False,
        aleatorio=False
    )

    if not disponiveis:
        equivalentes = (
            listar_topicos_equivalentes_com_questoes(
                concurso[0],
                topico_id
            )
        )

        equivalente = None

        if len(
            equivalentes
        ) == 1:
            equivalente = equivalentes[0]
        elif equivalentes:
            opcoes = [
                (
                    f"{item['nome']} "
                    f"({item['quantidade']} questões)"
                )
                for item in equivalentes
            ]
            escolha, ok = QInputDialog.getItem(
                parent,
                "Escolher tópico equivalente",
                (
                    "As questões deste conteúdo estão vinculadas a "
                    "mais de um tópico equivalente. Escolha qual deseja "
                    "resolver:"
                ),
                opcoes,
                0,
                False
            )

            if not ok:
                return None

            equivalente = equivalentes[
                opcoes.index(
                    escolha
                )
            ]

        if equivalente is not None:
            topico_id = equivalente[
                "topico_id"
            ]
            nome_topico = equivalente[
                "nome"
            ]
            disponiveis = listar_questoes_resolucao(
                concurso[0],
                topico_id=topico_id,
                somente_ineditas=False,
                aleatorio=False
            )
            aviso_topico_equivalente = (
                "\n\nAs questões de "
                f"{topico_solicitado_nome} estão cadastradas no tópico "
                f"equivalente “{nome_topico}”. Esta sessão e seu histórico "
                "serão registrados nesse vínculo."
            )

    if not disponiveis:
        QMessageBox.information(
            parent,
            "Resolver questões",
            (
                "Este tópico ainda não possui questões internas "
                "disponíveis no perfil ativo.\\n\\n"
                "Use Registrar revisão manual para estudos realizados "
                "fora do VighnaStudy ou alimente o Banco de Questões."
            )
        )
        return None

    maximo = len(
        disponiveis
    )

    modo_chave = unicodedata.normalize(
        "NFKD", str(modo_nome or "")
    ).encode("ascii", "ignore").decode("ascii").lower()
    origem_chave = str(origem_sessao or "").strip().lower()
    modo_revisao_cobertura = (
        "revisao" in modo_chave
        or origem_chave in {"revisao_inteligente", "topico_revisao"}
    )
    cobertura_revisao = None
    if modo_revisao_cobertura:
        try:
            cobertura_revisao = obter_estado_cobertura_revisao(
                topico_id, concurso[0]
            )
        except Exception:
            cobertura_revisao = None
        if (
            cobertura_revisao
            and cobertura_revisao.get("ativa")
            and int(cobertura_revisao.get("restantes") or 0) > 0
        ):
            # Uma revisão não repete questões já cobertas enquanto ainda há
            # itens pendentes. A bateria é limitada ao saldo da rodada.
            maximo = int(cobertura_revisao["restantes"])

    minimo_registro = max(
        1,
        obter_configuracao_int(
            "questoes_revisao_min_registro",
            5
        )
    )

    minimo_agendamento = max(
        minimo_registro,
        obter_configuracao_int(
            "questoes_revisao_min_agendamento",
            10
        )
    )

    resumo_topico = obter_resumo_topico(
        topico_id
    )

    primeiro_contato = (
        int(
            resumo_topico.get(
                "revisoes_totais",
                0
            )
            or 0
        ) == 0
    )

    if (
        cobertura_revisao
        and cobertura_revisao.get("ativa")
        and int(cobertura_revisao.get("total") or 0) > 0
        and int(cobertura_revisao.get("restantes") or 0) > 0
    ):
        mensagem = (
            f"{cobertura_revisao['total']} questão(ões) compõem a rodada desta revisão.\n\n"
            f"Cobertura atual: {cobertura_revisao['cobertas']}/{cobertura_revisao['total']} "
            f"({cobertura_revisao['percentual']:.0f}%).\n"
            f"Restam {cobertura_revisao['restantes']} questão(ões).\n\n"
            "Enquanto houver questões pendentes, elas serão priorizadas sem repetição. "
            "A próxima data de revisão só será calculada após a cobertura completa."
            f"{aviso_topico_equivalente}"
        )
    elif primeiro_contato:
        mensagem = (
            f"{maximo} questão(ões) disponível(is) para {nome_topico}.\n\n"
            "Primeiro contato com este tópico: ao finalizar a resolução, "
            "o VighnaStudy registrará automaticamente a primeira revisão "
            "e calculará a próxima data conforme o desempenho."
            f"{aviso_topico_equivalente}"
        )
    else:
        mensagem = (
            f"{maximo} questão(ões) disponível(is) para {nome_topico}.\n\n"
            f"{minimo_registro} questões: começa a gerar revisão automática.\n"
            f"{minimo_agendamento} questões: passa a recalcular a próxima revisão."
            f"{aviso_topico_equivalente}"
        )

    if quantidade_exata is not None:
        quantidade = max(1, min(int(quantidade_exata or 1), maximo))
    else:
        quantidade, ok = QInputDialog.getInt(
            parent,
            "Resolver questões do tópico",
            mensagem,
            min(
                quantidade_padrao,
                maximo
            ),
            1,
            maximo,
            1
        )

        if not ok:
            return None

    if (
        cobertura_revisao
        and cobertura_revisao.get("ativa")
        and int(cobertura_revisao.get("restantes") or 0) > 0
        and modo_revisao_cobertura
    ):
        selecao = selecionar_questoes_revisao_cobertura(
            concurso[0],
            topico_id=topico_id,
            quantidade=quantidade,
        )
    else:
        selecao = selecionar_questoes_inteligentes(
            concurso[0],
            topico_id=topico_id,
            quantidade=quantidade
        )

    fila = selecao[
        "fila"
    ]

    if not fila:
        return None

    configuracao = {
        "concurso_id": concurso[0],
        "concurso_nome": concurso[1],
        "disciplina_id": fila[0][
            "disciplina_id"
        ],
        "disciplina_nome": fila[0][
            "disciplina"
        ],
        "topico_id": topico_id,
        "topico_nome": nome_topico,
        "modo": str(modo_nome or "Sessão inteligente"),
        "quantidade": len(
            fila
        ),
        "fila": fila,
        "composicao_inteligente": selecao.get(
            "composicao",
            {}
        ),
        "perfil_inteligente": selecao.get(
            "perfil_rotulo",
            ""
        ),
        "cobertura_revisao": selecao.get(
            "cobertura_revisao"
        ),
    }
    if origem_sessao:
        configuracao["origem_sessao"] = str(origem_sessao)

    janela = JanelaResolverQuestoes(
        configuracao,
        parent
    )
    janela.exec_nao_modal()

    resultado = {
        "resumo": janela.resumo_final,
        "integracao": janela.resultados_integracao,
        "efetividade": janela.efetividade_final,
        "sessao_id": getattr(janela, "sessao_id", None),
        "proxima_acao": getattr(janela, "proxima_acao_final", None),
    }
    try:
        resumo_atual = obter_resumo_topico(topico_id)
        resultado["proxima_revisao"] = resumo_atual.get("proxima_revisao")
        resultado["revisoes_totais"] = resumo_atual.get("revisoes_totais")
    except Exception:
        pass
    return resultado



class JanelaHistoricoQuestoes(QDialog):
    def __init__(
        self,
        parent=None
    ):
        super().__init__(
            parent
        )

        self.janela_principal = parent
        self.concurso = obter_concurso_ativo()
        self.concurso_id = self.concurso[0]
        self.dados_historico = []
        self.dados_caderno = []
        self.historico_filtrado = []
        self.caderno_filtrado = []

        self.setWindowTitle(
            "Histórico e Caderno de Erros"
        )
        self.resize(
            1120,
            760
        )
        self.setMinimumSize(
            900,
            640
        )

        layout = QVBoxLayout(
            self
        )
        layout.setContentsMargins(
            18,
            16,
            18,
            16
        )
        layout.setSpacing(
            9
        )

        cabecalho = QHBoxLayout()

        titulos = QVBoxLayout()
        titulos.setSpacing(
            1
        )

        titulo = QLabel(
            "Histórico e Caderno de Erros"
        )
        titulo.setObjectName(
            "pageTitle"
        )

        subtitulo = QLabel(
            (
                "Acompanhe cada tentativa e identifique as questões "
                "que ainda exigem atenção."
            )
        )
        subtitulo.setObjectName(
            "pageSubtitle"
        )
        subtitulo.setWordWrap(
            True
        )

        titulos.addWidget(
            titulo
        )
        titulos.addWidget(
            subtitulo
        )

        perfil = QLabel(
            f"Perfil: {self.concurso[1]}"
        )
        perfil.setObjectName(
            "profileBadge"
        )

        cabecalho.addLayout(
            titulos
        )
        cabecalho.addStretch()
        cabecalho.addWidget(
            perfil,
            0,
            Qt.AlignVCenter
        )

        layout.addLayout(
            cabecalho
        )

        # Resumo global.
        resumo = QGridLayout()
        resumo.setHorizontalSpacing(
            8
        )

        for coluna in range(
            5
        ):
            resumo.setColumnStretch(
                coluna,
                1
            )

        def criar_card(
            titulo_texto
        ):
            card = QFrame()
            card.setObjectName(
                "questionHistoryStat"
            )

            card_layout = QVBoxLayout(
                card
            )
            card_layout.setContentsMargins(
                11,
                8,
                11,
                8
            )
            card_layout.setSpacing(
                2
            )

            rotulo = QLabel(
                titulo_texto
            )
            rotulo.setObjectName(
                "miniStatLabel"
            )

            valor = QLabel(
                "—"
            )
            valor.setObjectName(
                "miniStatValue"
            )

            card_layout.addWidget(
                rotulo
            )
            card_layout.addWidget(
                valor
            )

            return (
                card,
                valor
            )

        (
            card,
            self.hist_stat_tentativas
        ) = criar_card(
            "Tentativas"
        )
        resumo.addWidget(
            card,
            0,
            0
        )

        (
            card,
            self.hist_stat_questoes
        ) = criar_card(
            "Questões respondidas"
        )
        resumo.addWidget(
            card,
            0,
            1
        )

        (
            card,
            self.hist_stat_desempenho
        ) = criar_card(
            "Desempenho"
        )
        resumo.addWidget(
            card,
            0,
            2
        )

        (
            card,
            self.hist_stat_erros
        ) = criar_card(
            "Erros"
        )
        resumo.addWidget(
            card,
            0,
            3
        )

        (
            card,
            self.hist_stat_criticas
        ) = criar_card(
            "Questões críticas"
        )
        resumo.addWidget(
            card,
            0,
            4
        )

        layout.addLayout(
            resumo
        )

        self.abas = QTabWidget()
        self.abas.setObjectName(
            "questionHistoryTabs"
        )

        self.aba_historico = QWidget()
        self.aba_caderno = QWidget()

        self.abas.addTab(
            self.aba_historico,
            "Histórico"
        )
        self.abas.addTab(
            self.aba_caderno,
            "Caderno de erros"
        )

        layout.addWidget(
            self.abas,
            1
        )

        self.montar_aba_historico()
        self.montar_aba_caderno()

        fechar = QDialogButtonBox(
            QDialogButtonBox.Close
        )
        fechar.button(
            QDialogButtonBox.Close
        ).setText(
            "Fechar"
        )
        fechar.rejected.connect(
            self.reject
        )
        fechar.clicked.connect(
            self.accept
        )

        layout.addWidget(
            fechar
        )

        self.atualizar_dados()

