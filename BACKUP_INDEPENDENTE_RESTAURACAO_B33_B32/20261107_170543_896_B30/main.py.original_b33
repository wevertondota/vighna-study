    def copiar_protocolo_vpq(self):
        QApplication.clipboard().setText(
            VPQ_1_1_PROMPT
        )

        self.vpq_status.setText(
            "VPQ 1.1 copiado para a área de transferência"
        )

    def duplicar_protocolo_vpq(self):
        try:
            novo_id = criar_prompt_ia(
                "VPQ 1.1 — cópia personalizada",
                VPQ_1_1_PROMPT,
                "Protocolo Vighna"
            )
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Duplicar protocolo",
                (
                    "Não foi possível criar a cópia personalizada.\n\n"
                    f"{erro}"
                )
            )
            return

        # Garante que a cópia recém-criada fique visível.
        self.prompt_busca.clear()

        if (
            self.prompt_filtro_categoria.findText(
                "Todas as categorias"
            ) >= 0
        ):
            self.prompt_filtro_categoria.setCurrentText(
                "Todas as categorias"
            )

        self.prompt_tabs.setCurrentWidget(
            self.prompt_tab_meus
        )

        self.carregar_prompts(
            selecionar_id=novo_id
        )

        self.prompt_status.setText(
            "Cópia personalizada criada"
        )

    def normalizar_busca(
        self,
        texto
    ):
        texto = str(
            texto
            or ""
        ).lower().strip()

        texto = unicodedata.normalize(
            "NFD",
            texto
        )

        texto = "".join(
            caractere
            for caractere in texto
            if unicodedata.category(
                caractere
            ) != "Mn"
        )

        return " ".join(
            texto.split()
        )

    def marcar_prompt_alterado(self, *_):
        """Marca o editor como alterado e agenda persistência segura.

        Prompts já existentes são salvos automaticamente após uma pequena
        pausa na digitação. Prompts novos continuam exigindo uma confirmação
        explícita no primeiro salvamento para evitar registros acidentais.
        """
        if self.carregando_editor:
            return

        self.prompt_editor_sujo = True

        if self.prompt_id_atual is None:
            self.prompt_status.setText(
                "Novo prompt • alterações ainda não salvas"
            )
            return

        self.prompt_status.setText(
            "Alterações pendentes…"
        )
        self.prompt_autosave_timer.start()

    def _dados_editor_prompt(self):
        return (
            self.prompt_nome.text().strip(),
            self.prompt_categoria.text().strip(),
            self.prompt_texto.toPlainText().strip(),
        )

    def _atualizar_cache_prompt_atual(self, nome, categoria, texto):
        """Mantém lista e linha visível coerentes sem recarregar o editor."""
        if self.prompt_id_atual is None:
            return

        for item in self.prompts:
            if item.get("id") == self.prompt_id_atual:
                item["nome"] = nome
                item["categoria"] = categoria
                item["texto"] = texto
                break

        linha = self.prompt_tabela.currentRow()
        if linha >= 0:
            item_nome = self.prompt_tabela.item(linha, 0)
            if (
                item_nome is not None
                and item_nome.data(Qt.UserRole) == self.prompt_id_atual
            ):
                item_nome.setText(nome)
                item_categoria = self.prompt_tabela.item(linha, 1)
                if item_categoria is not None:
                    item_categoria.setText(categoria or "—")

        self.prompt_editor_titulo.setText(nome)

    def _salvar_prompt_existente_pendente(self, mostrar_erro=False):
        """Persiste o prompt atual sem reconstruir a lista nem mover o cursor."""
        if not self.prompt_editor_sujo:
            return True

        if self.prompt_id_atual is None:
            return False

        nome, categoria, texto = self._dados_editor_prompt()

        if not nome or not texto:
            if mostrar_erro:
                QMessageBox.warning(
                    self,
                    "Alterações não salvas",
                    (
                        "O prompt possui alterações pendentes, mas não pode "
                        "ser salvo porque o nome ou o texto está vazio."
                    )
                )
            self.prompt_status.setText(
                "Alterações pendentes • nome e texto são obrigatórios"
            )
            return False

        try:
            atualizado = atualizar_prompt_ia(
                self.prompt_id_atual,
                nome,
                texto,
                categoria
            )
            if not atualizado:
                raise RuntimeError(
                    "O registro do prompt não foi localizado no banco."
                )
        except Exception as erro:
            self.prompt_status.setText(
                "Falha ao salvar alterações"
            )
            if mostrar_erro:
                QMessageBox.critical(
                    self,
                    "Salvar prompt",
                    (
                        "Não foi possível salvar as alterações do prompt.\n\n"
                        f"{erro}"
                    )
                )
            return False

        self.prompt_editor_sujo = False
        self.prompt_autosave_timer.stop()
        self._atualizar_cache_prompt_atual(
            nome,
            categoria,
            texto
        )
        self.prompt_status.setText(
            "Salvo automaticamente"
        )
        return True

    def salvar_prompt_automaticamente(self):
        if self.carregando_editor or self._fechando_biblioteca_prompts:
            return
        self._salvar_prompt_existente_pendente(
            mostrar_erro=False
        )

    def _selecionar_prompt_por_id(self, prompt_id):
        if prompt_id is None:
            return
        for linha in range(self.prompt_tabela.rowCount()):
            item = self.prompt_tabela.item(linha, 0)
            if item is not None and item.data(Qt.UserRole) == prompt_id:
                self.prompt_tabela.blockSignals(True)
                self.prompt_tabela.selectRow(linha)
                self.prompt_tabela.blockSignals(False)
                return

    def _confirmar_descartar_prompt_novo(self):
        """Protege texto de um novo prompt ainda não salvo."""
        if self.prompt_id_atual is not None or not self.prompt_editor_sujo:
            return True

        nome, categoria, texto = self._dados_editor_prompt()
        if not nome and not categoria and not texto:
            self.prompt_editor_sujo = False
            return True

        resposta = QMessageBox.question(
            self,
            "Prompt ainda não salvo",
            (
                "Há conteúdo de um novo prompt que ainda não foi salvo.\n\n"
                "Deseja salvá-lo antes de continuar?"
            ),
            QMessageBox.Yes | QMessageBox.No | QMessageBox.Cancel,
            QMessageBox.Yes
        )

        if resposta == QMessageBox.Cancel:
            return False
        if resposta == QMessageBox.No:
            self.prompt_editor_sujo = False
            return True

        self.salvar_prompt()
        return not self.prompt_editor_sujo and self.prompt_id_atual is not None

    def carregar_prompts(
        self,
        selecionar_id=None
    ):
        self.prompts = (
            listar_prompts_ia()
        )

        categorias = sorted({
            item[
                "categoria"
            ]
            for item in self.prompts
            if item[
                "categoria"
            ].strip()
        }, key=str.lower)

        categoria_atual = (
            self.prompt_filtro_categoria.currentText()
        )

        self.prompt_filtro_categoria.blockSignals(
            True
        )
        self.prompt_filtro_categoria.clear()
        self.prompt_filtro_categoria.addItem(
            "Todas as categorias"
        )
        self.prompt_filtro_categoria.addItems(
            categorias
        )

        if categoria_atual in (
            ["Todas as categorias"]
            + categorias
        ):
            self.prompt_filtro_categoria.setCurrentText(
                categoria_atual
            )

        self.prompt_filtro_categoria.blockSignals(
            False
        )

        self.prompts_total.setText(
            (
                "1 prompt"
                if len(
                    self.prompts
                ) == 1
                else f"{len(self.prompts)} prompts"
            )
        )

        self.filtrar_prompts(
            selecionar_id=selecionar_id
        )

    def filtrar_prompts(
        self,
        *_,
        selecionar_id=None
    ):
        busca = self.normalizar_busca(
            self.prompt_busca.text()
        )

        categoria = (
            self.prompt_filtro_categoria.currentText()
        )

        filtrados = []

        for item in self.prompts:
            if (
                categoria
                and categoria != "Todas as categorias"
                and item[
                    "categoria"
                ] != categoria
            ):
                continue

            if busca:
                alvo = self.normalizar_busca(
                    (
                        f"{item['nome']} "
                        f"{item['categoria']} "
                        f"{item['texto']}"
                    )
                )

                termos = [
                    termo
                    for termo in busca.split(
                        " "
                    )
                    if termo
                ]

                if not all(
                    termo in alvo
                    for termo in termos
                ):
                    continue

            filtrados.append(
                item
            )

        self.prompts_filtrados = (
            filtrados
        )

        self.prompt_tabela.blockSignals(
            True
        )
        self.prompt_tabela.setRowCount(
            len(
                filtrados
            )
        )

        linha_selecionar = None

        for linha, item in enumerate(
            filtrados
        ):
            nome = QTableWidgetItem(
                item[
                    "nome"
                ]
            )
            nome.setData(
                Qt.UserRole,
                item[
                    "id"
                ]
            )
            nome.setToolTip(
                item[
                    "nome"
                ]
            )

            categoria_item = QTableWidgetItem(
                item[
                    "categoria"
                ]
                or "—"
            )
            categoria_item.setToolTip(
                item[
                    "categoria"
                ]
                or "Sem categoria"
            )

            self.prompt_tabela.setItem(
                linha,
                0,
                nome
            )
            self.prompt_tabela.setItem(
                linha,
                1,
                categoria_item
            )
            self.prompt_tabela.setRowHeight(
                linha,
                31
            )

            if (
                selecionar_id is not None
                and item[
                    "id"
                ] == selecionar_id
            ):
                linha_selecionar = (
                    linha
                )

        self.prompt_tabela.blockSignals(
            False
        )

        if linha_selecionar is not None:
            self.prompt_tabela.selectRow(
                linha_selecionar
            )
            self.carregar_prompt_selecionado()

        elif (
            self.prompt_id_atual is not None
        ):
            encontrado = next(
                (
                    indice
                    for indice, item
                    in enumerate(
                        filtrados
                    )
                    if item[
                        "id"
                    ] == self.prompt_id_atual
                ),
                None
            )

            if encontrado is not None:
                self.prompt_tabela.selectRow(
                    encontrado
                )

        elif filtrados:
            self.prompt_tabela.selectRow(
                0
            )
            self.carregar_prompt_selecionado()

        else:
            self.novo_prompt(
                limpar_selecao=False
            )

    def prompt_selecionado_id(
        self
    ):
        linha = (
            self.prompt_tabela.currentRow()
        )

        if linha < 0:
            return None

        item = self.prompt_tabela.item(
            linha,
            0
        )

        if item is None:
            return None

        return item.data(
            Qt.UserRole
        )

    def carregar_prompt_selecionado(
        self
    ):
        if self.carregando_editor:
            return

        prompt_id = (
            self.prompt_selecionado_id()
        )

        if prompt_id is None:
            return

        # Trocar de linha era o principal caminho de perda silenciosa: a
        # seleção nova recarregava o editor antes de persistir o prompt antigo.
        if (
            self.prompt_id_atual is not None
            and self.prompt_editor_sujo
        ):
            prompt_anterior = self.prompt_id_atual
            if not self._salvar_prompt_existente_pendente(
                mostrar_erro=True
            ):
                self._selecionar_prompt_por_id(prompt_anterior)
                return

        elif (
            self.prompt_id_atual is None
            and self.prompt_editor_sujo
        ):
            if not self._confirmar_descartar_prompt_novo():
                return

        prompt = obter_prompt_ia(
            prompt_id
        )

        if prompt is None:
            return

        self.carregando_editor = True

        self.prompt_id_atual = (
            prompt[
                "id"
            ]
        )
        self.prompt_nome.setText(
            prompt[
                "nome"
            ]
        )
        self.prompt_categoria.setText(
            prompt[
                "categoria"
            ]
        )
        self.prompt_texto.setPlainText(
            prompt[
                "texto"
            ]
        )
        self.prompt_editor_titulo.setText(
            prompt[
                "nome"
            ]
        )

        atualizado = str(
            prompt[
                "atualizado_em"
            ]
            or ""
        )

        if len(
            atualizado
        ) >= 16:
            atualizado = (
                f"{atualizado[8:10]}/"
                f"{atualizado[5:7]}/"
                f"{atualizado[0:4]} "
                f"{atualizado[11:16]}"
            )

        self.prompt_status.setText(
            (
                f"Atualizado: {atualizado}"
                if atualizado
                else ""
            )
        )

        self.prompt_editor_sujo = False
        self.prompt_autosave_timer.stop()
        self.carregando_editor = False

    def novo_prompt(
        self,
        *_,
        limpar_selecao=True
    ):
        if self.prompt_id_atual is not None and self.prompt_editor_sujo:
            if not self._salvar_prompt_existente_pendente(
                mostrar_erro=True
            ):
                return
        elif self.prompt_id_atual is None and self.prompt_editor_sujo:
            if not self._confirmar_descartar_prompt_novo():
                return

        self.carregando_editor = True
        self.prompt_autosave_timer.stop()

        if limpar_selecao:
            self.prompt_tabela.blockSignals(True)
            self.prompt_tabela.clearSelection()
            self.prompt_tabela.blockSignals(False)

        self.prompt_id_atual = None
        self.prompt_nome.clear()
        self.prompt_categoria.clear()
        self.prompt_texto.clear()
        self.prompt_editor_titulo.setText(
            "Novo prompt"
        )
        self.prompt_status.setText(
            "Ainda não salvo"
        )
        self.prompt_editor_sujo = False
        self.carregando_editor = False
        self.prompt_nome.setFocus()

    def salvar_prompt(self):
        self.prompt_autosave_timer.stop()
        nome, categoria, texto = self._dados_editor_prompt()

        if not nome:
            QMessageBox.warning(
                self,
                "Salvar prompt",
                "Informe um nome para o prompt."
            )
            self.prompt_nome.setFocus()
            return

        if not texto:
            QMessageBox.warning(
                self,
                "Salvar prompt",
                "O texto do prompt não pode ficar vazio."
            )
            self.prompt_texto.setFocus()
            return

        try:
            if self.prompt_id_atual is None:
                prompt_id = criar_prompt_ia(
                    nome,
                    texto,
                    categoria
                )
            else:
                atualizado = atualizar_prompt_ia(
                    self.prompt_id_atual,
                    nome,
                    texto,
                    categoria
                )
                if not atualizado:
                    raise RuntimeError(
                        "O registro do prompt não foi localizado no banco."
                    )
                prompt_id = self.prompt_id_atual

        except Exception as erro:
            self.prompt_editor_sujo = True
            QMessageBox.critical(
                self,
                "Salvar prompt",
                (
                    "Não foi possível salvar o prompt.\n\n"
                    f"{erro}"
                )
            )
            return

        self.prompt_id_atual = prompt_id
        self.prompt_editor_sujo = False
        self.carregar_prompts(
            selecionar_id=prompt_id
        )
        self.prompt_status.setText(
            "Salvo"
        )

    def copiar_prompt(
        self
    ):
        texto = (
            self.prompt_texto.toPlainText()
            .strip()
        )

        if not texto:
            QMessageBox.information(
                self,
                "Copiar prompt",
                "Não há texto para copiar."
            )
            return

        QApplication.clipboard().setText(
            texto
        )

        self.prompt_status.setText(
            "Copiado para a área de transferência"
        )

    def duplicar_prompt(
        self
    ):
        if (
            self.prompt_id_atual is not None
            and self.prompt_editor_sujo
            and not self._salvar_prompt_existente_pendente(
                mostrar_erro=True
            )
        ):
            return

        prompt_id = (
            self.prompt_selecionado_id()
        )

        if prompt_id is None:
            QMessageBox.information(
                self,
                "Duplicar prompt",
                "Selecione um prompt salvo."
            )
            return

        try:
            novo_id = duplicar_prompt_ia(
                prompt_id
            )
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Duplicar prompt",
                str(
                    erro
                )
            )
            return

        self.carregar_prompts(
            selecionar_id=novo_id
        )

    def excluir_prompt(
        self
    ):
        if (
            self.prompt_id_atual is not None
            and self.prompt_editor_sujo
            and not self._salvar_prompt_existente_pendente(
                mostrar_erro=True
            )
        ):
            return

        prompt_id = (
            self.prompt_selecionado_id()
        )

        if prompt_id is None:
            QMessageBox.information(
                self,
                "Excluir prompt",
                "Selecione um prompt salvo."
            )
            return

        prompt = obter_prompt_ia(
            prompt_id
        )

        if prompt is None:
            return

        resposta = QMessageBox.question(
            self,
            "Excluir prompt",
            (
                f"Excluir o prompt:\n\n"
                f"{prompt['nome']}?\n\n"
                "Esta ação não pode ser desfeita."
            ),
            QMessageBox.Yes
            | QMessageBox.No,
            QMessageBox.No
        )

        if resposta != QMessageBox.Yes:
            return

        try:
            fazer_backup(
                "antes_excluir_prompt_ia"
            )
        except Exception as erro:
            QMessageBox.critical(
                self,
                "Backup",
                (
                    "A exclusão foi cancelada porque o backup "
                    "não pôde ser criado.\n\n"
                    f"{erro}"
                )
            )
            return

        if excluir_prompt_ia(
            prompt_id
        ):
            self.prompt_id_atual = None
            self.carregar_prompts()
        else:
            QMessageBox.warning(
                self,
                "Excluir prompt",
                "O prompt não pôde ser excluído."
            )


    def done(self, resultado):
        """Garante persistência ao fechar a Biblioteca de Prompts."""
        if self._fechando_biblioteca_prompts:
            super().done(resultado)
            return

        self._fechando_biblioteca_prompts = True
        self.prompt_autosave_timer.stop()

        try:
            if self.prompt_id_atual is not None and self.prompt_editor_sujo:
                if not self._salvar_prompt_existente_pendente(
                    mostrar_erro=True
                ):
                    self._fechando_biblioteca_prompts = False
                    return
            elif self.prompt_id_atual is None and self.prompt_editor_sujo:
                if not self._confirmar_descartar_prompt_novo():
                    self._fechando_biblioteca_prompts = False
                    return
        finally:
            # Se o fechamento for cancelado por validação, o editor volta a
            # aceitar autosave normalmente.
            if self.isVisible():
                self._fechando_biblioteca_prompts = False

        super().done(resultado)



class JanelaTextoExtraidoPDF(QDialog):

    def __init__(
        self,
        texto,
        parent=None,
        origem_tipo="pdf"
    ):
        super().__init__(
            parent
        )

        origem_tipo = str(origem_tipo or "pdf").strip().lower()
        eh_texto_colado = origem_tipo == "texto"
        eh_txt = origem_tipo == "txt"
        self.setWindowTitle(
            (
                "Texto colado"
                if eh_texto_colado
                else ("Conteúdo do arquivo TXT" if eh_txt else "Texto extraído do PDF")
            )
        )
        self.resize(
            900,
            650
        )

        layout = QVBoxLayout(
            self
        )
        layout.setContentsMargins(
            14,
            12,
            14,
            12
        )

        aviso = QLabel(
            (
                "Este é o texto que será interpretado pelo VighnaStudy. Use esta visualização para conferir a formatação antes da importação."
                if eh_texto_colado
                else (
                    "Este é o conteúdo do arquivo TXT que será interpretado pelo VighnaStudy. "
                    "Use esta visualização para conferir a formatação antes da importação."
                    if eh_txt
                    else (
                        "Esta é a camada de texto que o VighnaStudy conseguiu "
                        "ler do PDF. Use esta visualização para conferir PDFs "
                        "com formatação incomum."
                    )
                )
            )
        )
        aviso.setObjectName(
            "pdfImportHint"
        )
        aviso.setWordWrap(
            True
        )

        texto_edit = QTextEdit()
        texto_edit.setReadOnly(
            True
        )
        texto_edit.setPlainText(
            texto
        )
        texto_edit.setObjectName(
            "pdfExtractedText"
        )

        botoes = QDialogButtonBox(
            QDialogButtonBox.Close
        )
        botoes.button(
            QDialogButtonBox.Close
        ).setText(
            "Fechar"
        )
        botoes.rejected.connect(
            self.reject
        )
        botoes.clicked.connect(
            self.accept
        )

        layout.addWidget(
            aviso
        )
        layout.addWidget(
            texto_edit,
            1
        )
        layout.addWidget(
            botoes
        )


class JanelaCentralImportacaoQuestoes(QDialog):
    """Hub único de entrada para as formas de importação de questões."""

    def __init__(self, parent=None, topico_id_padrao=None):
        super().__init__(parent)
        self.origem_escolhida = None
        self.topico_id_padrao = (
            int(topico_id_padrao)
            if topico_id_padrao is not None
            else None
        )
        self.contexto_topico = (
            obter_contexto_topico(self.topico_id_padrao)
            if self.topico_id_padrao is not None
            else None
        )
        self.setWindowTitle("Central de importação")
        self.resize(940, 660)
        self.setMinimumSize(780, 600)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(18, 16, 18, 16)
        layout.setSpacing(12)

        titulo = QLabel("Central de importação de questões")
        titulo.setObjectName("pageTitle")
        subtitulo = QLabel(
            "Escolha a origem. O Vighna analisa e valida o conteúdo antes de gravar qualquer questão no banco."
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        layout.addWidget(titulo)
        layout.addWidget(subtitulo)

        if self.contexto_topico:
            destino = QFrame()
            destino.setObjectName("pdfImportSummary")
            destino_layout = QHBoxLayout(destino)
            destino_layout.setContentsMargins(12, 8, 12, 8)
            destino_layout.setSpacing(8)
            destino_rotulo = QLabel("Destino inicial")
            destino_rotulo.setObjectName("pdfImportMeta")
            destino_valor = QLabel(
                f"{self.contexto_topico.get('disciplina_nome', '')} › "
                f"{self.contexto_topico.get('topico_nome', '')}"
            )
            destino_valor.setObjectName("sectionTitle")
            destino_valor.setWordWrap(True)
            destino_layout.addWidget(destino_rotulo)
            destino_layout.addWidget(destino_valor, 1)
            layout.addWidget(destino)

        fluxo = QFrame()
        fluxo.setObjectName("pdfImportSummary")
        fluxo_layout = QHBoxLayout(fluxo)
        fluxo_layout.setContentsMargins(12, 9, 12, 9)
        fluxo_layout.setSpacing(8)
        for indice, texto_etapa in enumerate((
            "1  Origem",
            "2  Análise",
            "3  Conferência",
            "4  Importação",
        )):
            etapa = QLabel(texto_etapa)
            etapa.setObjectName("pdfImportMeta")
            fluxo_layout.addWidget(etapa)
            if indice < 3:
                seta = QLabel("→")
                seta.setObjectName("pdfImportMeta")
                fluxo_layout.addWidget(seta)
        fluxo_layout.addStretch(1)
        layout.addWidget(fluxo)

        cards = QGridLayout()
        cards.setHorizontalSpacing(10)
        cards.setVerticalSpacing(10)
        cards.setColumnStretch(0, 1)
        cards.setColumnStretch(1, 1)

        def criar_card(simbolo, nome, descricao, detalhes, botao_texto, origem, destaque=False):
            card = QFrame()
            card.setObjectName("questionEditorCard")
            card.setMinimumHeight(220)
            card.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
            card_layout = QVBoxLayout(card)
            card_layout.setContentsMargins(14, 14, 14, 14)
            card_layout.setSpacing(8)

            topo = QHBoxLayout()
            icone = QLabel(simbolo)
            icone.setObjectName("studyNowIcon")
            icone.setAlignment(Qt.AlignCenter)
            icone.setFixedSize(36, 36)
            nome_label = QLabel(nome)
            nome_label.setObjectName("studyActionTitle")
            topo.addWidget(icone)
            topo.addWidget(nome_label, 1, Qt.AlignVCenter)
            card_layout.addLayout(topo)

            descricao_label = QLabel(descricao)
            descricao_label.setObjectName("studyActionDescription")
            descricao_label.setWordWrap(True)
            card_layout.addWidget(descricao_label)

            detalhe_label = QLabel(detalhes)
            detalhe_label.setObjectName("pdfImportHint")
            detalhe_label.setWordWrap(True)
            card_layout.addWidget(detalhe_label)
            card_layout.addStretch(1)

            botao = QPushButton(botao_texto)
            botao.setObjectName("primaryButton")
            botao.setMinimumHeight(40)
            botao.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
            botao.clicked.connect(lambda: self.selecionar_origem(origem))
            card_layout.addWidget(botao)
            return card

        cards.addWidget(criar_card(
            "▣",
            "PDF",
            "Importe questões de um PDF com texto selecionável.",
            "O Vighna extrai o texto, detecta questões e abre a conferência de gabarito, título, capítulo e duplicidade.",
            "Selecionar PDF",
            "pdf",
        ), 0, 0)
        cards.addWidget(criar_card(
            "TXT",
            "Arquivo TXT",
            "Importe questões diretamente de um arquivo de texto (.txt).",
            "Ideal para VPQ 1.1 salvo como texto. O Vighna detecta UTF-8, UTF-16 e arquivos ANSI comuns do Windows antes da conferência.",
            "Selecionar TXT",
            "txt",
        ), 0, 1)
        cards.addWidget(criar_card(
            "≡",
            "Texto colado",
            "Cole questões diretamente da área de transferência.",
            "Ideal para VPQ 1.1 e textos produzidos no ChatGPT. Nenhuma questão é gravada antes da conferência.",
            "Colar e analisar",
            "texto",
            destaque=True,
        ), 1, 0)
        cards.addWidget(criar_card(
            "▦",
            "CSV",
            "Importe lotes organizados em planilha/CSV.",
            "O arquivo é validado antes da gravação e o Vighna mostra questões prontas, duplicadas e linhas com erro.",
            "Selecionar CSV",
            "csv",
        ), 1, 1)
        layout.addLayout(cards, 1)

        nota = QLabel(
            "Importações sempre passam por validação. Antes da gravação definitiva, o Vighna cria um backup de segurança."
        )
        nota.setObjectName("pdfImportHint")
        nota.setWordWrap(True)
        layout.addWidget(nota)

        botoes = QDialogButtonBox(QDialogButtonBox.Close)
        botoes.button(QDialogButtonBox.Close).setText("Fechar")
        botoes.rejected.connect(self.reject)
        layout.addWidget(botoes)

    def selecionar_origem(self, origem):
        self.origem_escolhida = str(origem or "").strip().lower()
        self.accept()


class JanelaValidacaoCSVQuestoes(QDialog):
    """Pré-visualização segura do CSV antes da gravação no banco."""

    def __init__(
        self,
        nome_arquivo,
        linhas_validas,
        erros,
        duplicadas_linhas,
        parent=None,
    ):
        super().__init__(parent)
        self.linhas_validas = list(linhas_validas or [])
        self.erros = list(erros or [])
        self.duplicadas_linhas = list(duplicadas_linhas or [])
        self.confirmado = False

        self.setWindowTitle("Conferir importação CSV")
        self.resize(1040, 680)
        self.setMinimumSize(820, 560)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(18, 15, 18, 15)
        layout.setSpacing(10)

        titulo = QLabel("Conferência da importação CSV")
        titulo.setObjectName("pageTitle")
        subtitulo = QLabel(
            "Revise o resultado da validação. Apenas as questões marcadas como prontas serão gravadas."
        )
        subtitulo.setObjectName("pageSubtitle")
        subtitulo.setWordWrap(True)
        layout.addWidget(titulo)
        layout.addWidget(subtitulo)

        resumo = QFrame()
        resumo.setObjectName("pdfImportSummary")
        resumo_layout = QHBoxLayout(resumo)
        resumo_layout.setContentsMargins(11, 8, 11, 8)
        resumo_layout.setSpacing(14)

        arquivo = QLabel(str(nome_arquivo or "CSV"))
        arquivo.setObjectName("pdfImportFile")
        prontas = QLabel(f"Prontas: {len(self.linhas_validas)}")
        prontas.setObjectName("pdfImportMeta")
        duplicadas = QLabel(f"Duplicadas: {len(self.duplicadas_linhas)}")
        duplicadas.setObjectName("pdfImportMeta")
        erros_label = QLabel(f"Com erro: {len(self.erros)}")
        erros_label.setObjectName("pdfImportMeta")
        resumo_layout.addWidget(arquivo)
        resumo_layout.addStretch(1)
        resumo_layout.addWidget(prontas)
        resumo_layout.addWidget(duplicadas)
        resumo_layout.addWidget(erros_label)
        layout.addWidget(resumo)

        tabela = QTableWidget()
        tabela.setObjectName("pdfImportTable")
        tabela.setColumnCount(5)
        tabela.setHorizontalHeaderLabels([
            "Linha", "Questão", "Gabarito", "Classificação", "Status"
        ])
        tabela.setRowCount(len(self.linhas_validas))
        tabela.setEditTriggers(QAbstractItemView.NoEditTriggers)
        tabela.setSelectionBehavior(QAbstractItemView.SelectRows)
        tabela.verticalHeader().setVisible(False)
        tabela.setShowGrid(False)
        tabela.setTextElideMode(Qt.ElideRight)

        header = tabela.horizontalHeader()
        header.setSectionResizeMode(0, QHeaderView.Fixed)
        tabela.setColumnWidth(0, 58)
        header.setSectionResizeMode(1, QHeaderView.Stretch)
        header.setSectionResizeMode(2, QHeaderView.Fixed)
        tabela.setColumnWidth(2, 80)
        header.setSectionResizeMode(3, QHeaderView.Fixed)
        tabela.setColumnWidth(3, 290)
        header.setSectionResizeMode(4, QHeaderView.Fixed)
        tabela.setColumnWidth(4, 90)

        for indice, item in enumerate(self.linhas_validas):
            linha_item = QTableWidgetItem(str(item.get("linha", "—")))
            linha_item.setTextAlignment(Qt.AlignCenter)
            enunciado = " ".join(str(item.get("enunciado", "")).split())
            if len(enunciado) > 180:
                enunciado = enunciado[:177] + "..."
            enunciado_item = QTableWidgetItem(enunciado)
            enunciado_item.setToolTip(str(item.get("enunciado", "")))
            gabarito_item = QTableWidgetItem(str(item.get("gabarito", "—")))
            gabarito_item.setTextAlignment(Qt.AlignCenter)
            classificacao_item = QTableWidgetItem(str(item.get("classificacao", "—")))
            status_item = QTableWidgetItem("Pronta")
            status_item.setTextAlignment(Qt.AlignCenter)
            aplicar_destaque_tabela(status_item, "sucesso", True)
            for coluna, valor in enumerate((
                linha_item,
                enunciado_item,
                gabarito_item,
                classificacao_item,
                status_item,
            )):
                tabela.setItem(indice, coluna, valor)
            tabela.setRowHeight(indice, 34)

        layout.addWidget(tabela, 1)

        if self.erros or self.duplicadas_linhas:
            detalhes = []
            if self.erros:
                detalhes.append(
                    "Linhas com erro:\n" + "\n".join(
                        f"• Linha {numero}: {motivo}"
                        for numero, motivo in self.erros[:8]
                    )
                )
                if len(self.erros) > 8:
                    detalhes.append(f"• ... e mais {len(self.erros) - 8} erro(s).")
            if self.duplicadas_linhas:
                linhas = ", ".join(str(numero) for numero, _ in self.duplicadas_linhas[:12])
                sufixo = "" if len(self.duplicadas_linhas) <= 12 else "…"
                detalhes.append(f"Duplicadas ignoradas nas linhas: {linhas}{sufixo}")
            aviso = QLabel("\n\n".join(detalhes))
            aviso.setObjectName("pdfImportHint")
            aviso.setWordWrap(True)
            layout.addWidget(aviso)

        rodape = QDialogButtonBox(QDialogButtonBox.Cancel)
        importar = rodape.addButton(
            f"Importar {len(self.linhas_validas)} questão(ões)",
            QDialogButtonBox.AcceptRole,
        )
        importar.setObjectName("primaryButton")
        importar.setEnabled(bool(self.linhas_validas))
        importar.setDefault(True)
        rodape.accepted.connect(self.confirmar)
        rodape.rejected.connect(self.reject)
        rodape.button(QDialogButtonBox.Cancel).setText("Cancelar")
        layout.addWidget(rodape)

    def confirmar(self):
        self.confirmado = True
        self.accept()


