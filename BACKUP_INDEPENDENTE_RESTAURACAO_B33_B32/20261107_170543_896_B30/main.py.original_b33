        )
        self.botao_editar_alternativas.setMinimumHeight(32)
        self.botao_editar_alternativas.setToolTip(
            "Corrigir os textos A–E nesta bateria, sem sair da questão."
        )
        self.botao_editar_alternativas.clicked.connect(
            self.iniciar_edicao_alternativas
        )

        self.menu_opcoes_topo = QMenu(self)
        self.menu_opcoes_topo.setObjectName("questionSessionOptionsMenu")
        self.acao_menu_dashboard = self.menu_opcoes_topo.addAction("Dashboard")
        self.acao_menu_dashboard.triggered.connect(self.ir_ao_dashboard)
        self.acao_menu_editar_alternativas = self.menu_opcoes_topo.addAction(
            "Editar alternativas"
        )
        self.acao_menu_editar_alternativas.triggered.connect(
            self.iniciar_edicao_alternativas
        )
        self.menu_opcoes_topo.addSeparator()
        # B14: preferência somente desta sessão, não altera tema global.
        self.acao_menu_leitura_pb = self.menu_opcoes_topo.addAction(
            "Modo Leitura Neural — preto e branco"
        )
        self.acao_menu_leitura_pb.setCheckable(True)
        self.acao_menu_leitura_pb.setChecked(False)
        self.acao_menu_leitura_pb.setToolTip(
            "Tornar a bateria monocromática; clique novamente para restaurar."
        )
        self.acao_menu_leitura_pb.toggled.connect(self._b14_alternar_leitura_pb)
        self.acao_menu_leitura_pb.toggled.connect(
            lambda marcado: self._b17_salvar_ativacao("preto_branco", marcado))
        # B18: recolorir APENAS os fundos dos cartoes A-E durante o modo PB.
        self.acao_menu_cor_alternativas_b18 = self.menu_opcoes_topo.addAction(
            "Cor suave nas alternativas (no P&B)")
        self.acao_menu_cor_alternativas_b18.setCheckable(True)
        self.acao_menu_cor_alternativas_b18.setChecked(False)
        self.acao_menu_cor_alternativas_b18.setToolTip(
            "Adiciona um tom azul discreto somente aos cartoes de resposta "
            "quando o modo preto e branco estiver ativo.")
        self.acao_menu_cor_alternativas_b18.toggled.connect(
            self._b18_alternar_cor_alternativas)
        self.acao_menu_cor_alternativas_b18.toggled.connect(
            lambda marcado: self._b17_salvar_ativacao(
                "alternativas_cor_ativa", marcado))
        # B16R1: tres opcoes realmente independentes.
        # marcada e inoperante; cada efeito depende do seu proprio QAction.
        self.acao_menu_halo_b15 = self.menu_opcoes_topo.addAction(
            "Ponteiro de leitura — halo suave"
        )
        self.acao_menu_halo_b15.setCheckable(True)
        self.acao_menu_halo_b15.setChecked(False)
        self.acao_menu_halo_b15.setEnabled(True)
        self.acao_menu_halo_b15.setToolTip(
            "Ativa ou desativa o guia do cursor, com ou sem preto e branco."
        )
        self.acao_menu_halo_b15.toggled.connect(self._b15_alternar_halo)
        self.acao_menu_halo_b15.toggled.connect(
            lambda marcado: self._b17_salvar_ativacao("halo_ativo", marcado))
        # B16: destaque de linha independente do halo; sem timer ou QSS global.
        self.acao_menu_linha_b16 = self.menu_opcoes_topo.addAction(
            "Leitura Neural — destacar linha sob o mouse"
        )
        self.acao_menu_linha_b16.setCheckable(True)
        self.acao_menu_linha_b16.setChecked(False)
        self.acao_menu_linha_b16.setEnabled(True)
        self.acao_menu_linha_b16.setToolTip(
            "Ativa ou desativa a linha guiada, com ou sem preto e branco."
        )
        self.acao_menu_linha_b16.toggled.connect(self._b16_alternar_linha)
        self.acao_menu_linha_b16.toggled.connect(
            lambda marcado: self._b17_salvar_ativacao("linha_ativa", marcado))
        self.acao_menu_ajustes_b17 = self.menu_opcoes_topo.addAction(
            "Ajustar Leitura Neural…")
        self.acao_menu_ajustes_b17.triggered.connect(self._b17_abrir_ajustes)
        self.menu_opcoes_topo.addSeparator()
        self.acao_menu_efeito_acerto_b22 = self.menu_opcoes_topo.addAction(
            "Transferência neural ao acertar")
        self.acao_menu_efeito_acerto_b22.setCheckable(True)
        self.acao_menu_efeito_acerto_b22.setChecked(True)
        self.acao_menu_efeito_acerto_b22.setToolTip(
            "Três filamentos com microcircuitos saem da alternativa correta "
            "diretamente até a Constelação Sináptica; sem passar por Acertos.")
        self.acao_menu_efeito_acerto_b22.toggled.connect(self._b22_alternar_efeito)
        self.acao_menu_efeito_acerto_b22.toggled.connect(
            lambda ativo: self._b17_salvar_ativacao("acerto_efeito_ativo", ativo))
        self.acao_menu_navegacao_b26 = self.menu_opcoes_topo.addAction(
            "Efeito suave ao navegar com setas")
        self.acao_menu_navegacao_b26.setCheckable(True)
        self.acao_menu_navegacao_b26.setChecked(True)
        self.acao_menu_navegacao_b26.setToolTip(
            "Um filamento percorre a margem entre cartões adjacentes e "
            "ilumina a alternativa de destino; a borda de foco permanece visível.")
        self.acao_menu_navegacao_b26.toggled.connect(self._b26_alternar_navegacao)
        self.acao_menu_navegacao_b26.toggled.connect(
            lambda ativo: self._b17_salvar_ativacao("navegacao_efeito_ativo", ativo))
        self.acao_menu_constelacao_b26 = self.menu_opcoes_topo.addAction(
            "Constelação Sináptica de combo")
        self.acao_menu_constelacao_b26.setCheckable(True)
        self.acao_menu_constelacao_b26.setChecked(True)
        self.acao_menu_constelacao_b26.setToolTip(
            "Cinco cristais energizados progressivamente; no quinto acerto "
            "a estrutura completa recebe uma coroação luminosa dourada.")
        self.acao_menu_constelacao_b26.toggled.connect(
            self._b26_alternar_constelacao)
        self.acao_menu_constelacao_b26.toggled.connect(
            lambda ativo: self._b17_salvar_ativacao("combo_constelacao_ativa", ativo))
        # M32: emissões permanentes ao redor do brasão, sem pulsos e sem
        # alteração no motor de mérito ou no combo da Constelação.
        self.acao_menu_energia_m32 = self.menu_opcoes_topo.addAction(
            "Brasão — energia etérea contínua")
        self.acao_menu_energia_m32.setCheckable(True)
        self.acao_menu_energia_m32.setChecked(self._m32_energia_ativa)
        self.acao_menu_energia_m32.setToolTip(
            "Filamentos gasosos contínuos atrás do brasão. Pode ser desativado.")
        self.acao_menu_energia_m32.toggled.connect(self._m32_alternar_energia)
        self._m32_menu_intensidades = self.menu_opcoes_topo.addMenu(
            "Brasão — intensidade da energia")
        self._m32_acoes_intensidade = {}
        for nivel, descricao in ((25, "Discreta"), (52, "Equilibrada"), (78, "Marcante")):
            acao = self._m32_menu_intensidades.addAction(descricao)
            acao.setCheckable(True)
            acao.setChecked(self._m32_energia_intensidade == nivel)
            acao.triggered.connect(
                lambda _=False, valor=nivel: self._m32_ajustar_intensidade(valor))
            self._m32_acoes_intensidade[nivel] = acao
        # R8 R5: as chamas da Constelação são uma propriedade permanente
        # dos marcos ×10+, portanto não possuem opção de ativação/desativação.
        self.menu_opcoes_topo.addSeparator()
        self.acao_menu_sons_b26r2 = self.menu_opcoes_topo.addAction(
            "Sons neurais — Xeno-Arquitetura V3")
        self.acao_menu_sons_b26r2.setCheckable(True)
        self.acao_menu_sons_b26r2.setChecked(True)
        self.acao_menu_sons_b26r2.setToolTip(
            "Ativa os sons originais de setas, acerto, constelação e combo ×5.")
        self.acao_menu_sons_b26r2.toggled.connect(self._b26r2_alternar_sons)
        self.acao_menu_sons_b26r2.toggled.connect(
            lambda ativo: self._b17_salvar_ativacao("audio_v3_ativo", ativo))
        self.acao_menu_som_setas_b26r2 = self.menu_opcoes_topo.addAction(
            "Som ao navegar pelas alternativas")
        self.acao_menu_som_setas_b26r2.setCheckable(True)
        self.acao_menu_som_setas_b26r2.setChecked(True)
        self.acao_menu_som_setas_b26r2.toggled.connect(self._b26r2_alternar_som_setas)
        self.acao_menu_som_setas_b26r2.toggled.connect(
            lambda ativo: self._b17_salvar_ativacao("audio_v3_setas", ativo))
        self.acao_menu_som_recompensas_b26r2 = self.menu_opcoes_topo.addAction(
            "Sons de acerto e constelação")
        self.acao_menu_som_recompensas_b26r2.setCheckable(True)
        self.acao_menu_som_recompensas_b26r2.setChecked(True)
        self.acao_menu_som_recompensas_b26r2.toggled.connect(
            self._b26r2_alternar_som_recompensas)
        self.acao_menu_som_recompensas_b26r2.toggled.connect(
            lambda ativo: self._b17_salvar_ativacao("audio_v3_recompensas", ativo))
        self.acao_menu_som_transicao_b26r5 = self.menu_opcoes_topo.addAction(
            "Som ao avançar para outra questão")
        self.acao_menu_som_transicao_b26r5.setCheckable(True)
        self.acao_menu_som_transicao_b26r5.setChecked(True)
        self.acao_menu_som_transicao_b26r5.setToolTip(
            "Toca uma passagem dimensional ao avançar pelo Enter ou pelo botão inferior.")
        self.acao_menu_som_transicao_b26r5.toggled.connect(
            self._b26r5_alternar_som_transicao)
        self.acao_menu_som_transicao_b26r5.toggled.connect(
            lambda ativo: self._b17_salvar_ativacao("audio_v3_transicao", ativo))
        self.acao_menu_ajustar_som_b26r2 = self.menu_opcoes_topo.addAction(
            "Ajustar volumes e testar sons…")
        self.acao_menu_ajustar_som_b26r2.triggered.connect(self._b26r2_abrir_ajustes_som)
        self.menu_opcoes_topo.addSeparator()
        self.acao_menu_analise_pendente = self.menu_opcoes_topo.addAction(
            "Analisar depois"
        )
        self.acao_menu_analise_pendente.setCheckable(True)
        self.acao_menu_analise_pendente.toggled.connect(
            self._alternar_analise_pendente_pelo_menu
        )
        self.menu_opcoes_topo.aboutToShow.connect(self.atualizar_menu_opcoes_topo)
        self.botao_opcoes.setMenu(self.menu_opcoes_topo)

        acoes.addStretch()

        self.feedback = QFrame()
        self.feedback.setObjectName(
            "questionSolverFeedback"
        )
        self.feedback.setVisible(
            False
        )

        feedback_layout = QVBoxLayout(
            self.feedback
        )
        feedback_layout.setContentsMargins(
            13,
            10,
            13,
            10
        )
        feedback_layout.setSpacing(
            4
        )

        self.feedback_titulo = QLabel(
            ""
        )
        self.feedback_titulo.setObjectName(
            "questionSolverFeedbackTitle"
        )

        explicacao_cabecalho = QHBoxLayout()
        explicacao_cabecalho.setContentsMargins(0, 2, 0, 0)
        explicacao_cabecalho.setSpacing(6)

        self.feedback_explicacao_rotulo = QLabel("Explicação")
        self.feedback_explicacao_rotulo.setObjectName(
            "questionSolverExplanationTitle"
        )

        self.feedback_explicacao_editar = QToolButton(self.feedback)
        self.feedback_explicacao_editar.setObjectName(
            "questionSolverExplanationEditButton"
        )
        self.feedback_explicacao_editar.setText("✎")
        self.feedback_explicacao_editar.setFixedSize(28, 28)
        self.feedback_explicacao_editar.setToolTip(
            "Editar explicação desta questão"
        )
        self.feedback_explicacao_editar.setAccessibleName(
            "Editar explicação"
        )
        self.feedback_explicacao_editar.setVisible(False)
        self.feedback_explicacao_editar.clicked.connect(
            self.iniciar_edicao_explicacao
        )

        explicacao_cabecalho.addWidget(
            self.feedback_explicacao_rotulo,
            0,
            Qt.AlignVCenter
        )
        explicacao_cabecalho.addStretch()
        explicacao_cabecalho.addWidget(
            self.feedback_explicacao_editar,
            0,
            Qt.AlignVCenter
        )

        self.feedback_explicacao = QLabel(
            ""
        )
        self.feedback_explicacao.setObjectName(
            "questionSolverExplanation"
        )
        self.feedback_explicacao.setWordWrap(
            True
        )
        self.feedback_explicacao.setTextInteractionFlags(
            Qt.TextSelectableByMouse
        )
        self.feedback_explicacao.setMouseTracking(True)

        self.feedback_explicacao_editor = QTextEdit(self.feedback)
        self.feedback_explicacao_editor.setObjectName(
            "questionSolverExplanationEditor"
        )
        # O conteúdo rico é produzido somente por comandos do editor.
        # HTML colado de fora é inserido como texto, sem links/imagens externas.
        self.feedback_explicacao_editor.setAcceptRichText(False)
        self.feedback_explicacao_editor.setTabChangesFocus(True)
        self.feedback_explicacao_editor.setMinimumHeight(110)
        self.feedback_explicacao_editor.setPlaceholderText(
            "Corrija a explicação ou acrescente uma anotação."
        )
        self.feedback_explicacao_editor.setVisible(False)

        # Barra compacta só aparece ao editar a explicação da bateria.
        self.feedback_explicacao_barra = QWidget(self.feedback)
        self.feedback_explicacao_barra.setObjectName("questionExplanationFormatToolbar")
        formato_layout = QHBoxLayout(self.feedback_explicacao_barra)
        formato_layout.setContentsMargins(5, 4, 5, 4)
        formato_layout.setSpacing(3)

        def ferramenta(rotulo, ajuda, acao, *, alternavel=False):
            botao = QToolButton(self.feedback_explicacao_barra)
            botao.setObjectName("questionExplanationFormatButton")
            botao.setText(rotulo)
            botao.setToolTip(ajuda)
            botao.setAccessibleName(ajuda)
            botao.setCheckable(alternavel)
            botao.setMinimumHeight(28)
            botao.clicked.connect(acao)
            formato_layout.addWidget(botao)
            return botao

        self.explicacao_negrito = ferramenta(
            "B", "Negrito (Ctrl+B)", lambda: self.formatar_explicacao_caracter("negrito"),
            alternavel=True,
        )
        self.explicacao_negrito.setStyleSheet("font-weight: bold;")
        self.explicacao_italico = ferramenta(
            "I", "Itálico (Ctrl+I)", lambda: self.formatar_explicacao_caracter("italico"),
            alternavel=True,
        )
        self.explicacao_italico.setStyleSheet("font-style: italic;")
        self.explicacao_sublinhado = ferramenta(
            "U̲", "Sublinhado (Ctrl+U)", lambda: self.formatar_explicacao_caracter("sublinhado"),
            alternavel=True,
        )

        def menu_cores(rotulo, objeto, ajuda, cores, funcao):
            botao = QToolButton(self.feedback_explicacao_barra)
            botao.setObjectName(objeto)
            botao.setText(rotulo)
            botao.setToolTip(ajuda)
            botao.setAccessibleName(ajuda)
            botao.setPopupMode(QToolButton.InstantPopup)
            botao.setMinimumHeight(28)
            menu = QMenu(botao)
            for nome, hexa in cores:
                menu.addAction(nome).triggered.connect(
                    lambda _checked=False, cor=hexa: funcao(cor)
                )
            botao.setMenu(menu)
            formato_layout.addWidget(botao)
            return botao

        paleta_texto = [
            ("Padrão", None), ("Vermelho", "#DC3545"),
            ("Verde", "#16845B"), ("Azul", "#3284D6"),
            ("Laranja", "#D17B18"), ("Roxo", "#9864C5"),
        ]
        paleta_destaque = [
            ("Sem destaque", None), ("Amarelo", "#FFF0A6"),
            ("Verde claro", "#BDF0D2"), ("Azul claro", "#BFDFFF"),
            ("Rosa", "#FFD4E2"), ("Lilás", "#E4D6FF"),
        ]
        menu_cores("Cor ▾", "questionExplanationColorButton", "Cor do texto selecionado",
                   paleta_texto, lambda cor: self.colorir_explicacao(cor, fundo=False))
        menu_cores("Destaque ▾", "questionExplanationHighlightButton", "Marca-texto",
                   paleta_destaque, lambda cor: self.colorir_explicacao(cor, fundo=True))
        ferramenta("• Lista", "Criar lista com marcadores", self.lista_explicacao)
        self.explicacao_desfazer = ferramenta("↶", "Desfazer (Ctrl+Z)",
                                              self.feedback_explicacao_editor.undo)
        self.explicacao_refazer = ferramenta("↷", "Refazer (Ctrl+Y)",
                                            self.feedback_explicacao_editor.redo)
        ferramenta("Limpar", "Remover formatação do trecho selecionado",
                   self.limpar_formato_explicacao)
        formato_layout.addStretch(1)
        self.explicacao_previa_botao = ferramenta(
            "Visualizar", "Alternar pré-visualização da explicação",
            self.alternar_previa_explicacao, alternavel=True,
        )
        self.feedback_explicacao_barra.hide()
        self.feedback_explicacao_editor.currentCharFormatChanged.connect(
            self.sincronizar_botoes_formato_explicacao
        )
        self.feedback_explicacao_editor.undoAvailable.connect(
            self.explicacao_desfazer.setEnabled
        )
        self.feedback_explicacao_editor.redoAvailable.connect(
            self.explicacao_refazer.setEnabled
        )
        self.explicacao_desfazer.setEnabled(False)
        self.explicacao_refazer.setEnabled(False)
        self._explicacao_original_rica = False
        self._explicacao_formato_usado = False

        self.feedback_explicacao_acoes = QWidget(self.feedback)
        self.feedback_explicacao_acoes.setObjectName(
            "questionSolverExplanationActions"
        )
        explicacao_acoes_layout = QHBoxLayout(
            self.feedback_explicacao_acoes
        )
        explicacao_acoes_layout.setContentsMargins(0, 2, 0, 0)
        explicacao_acoes_layout.setSpacing(7)
        explicacao_acoes_layout.addStretch()

        self.feedback_explicacao_cancelar = QPushButton("Cancelar")
        self.feedback_explicacao_cancelar.setObjectName(
            "questionSolverExplanationCancelButton"
        )
        self.feedback_explicacao_cancelar.clicked.connect(
            self.cancelar_edicao_explicacao
        )

        self.feedback_explicacao_salvar = QPushButton("Salvar")
        self.feedback_explicacao_salvar.setObjectName(
            "questionSolverExplanationSaveButton"
        )
        self.feedback_explicacao_salvar.clicked.connect(
            self.salvar_edicao_explicacao
        )

        explicacao_acoes_layout.addWidget(
            self.feedback_explicacao_cancelar
        )
        explicacao_acoes_layout.addWidget(
            self.feedback_explicacao_salvar
        )
        self.feedback_explicacao_acoes.setVisible(False)

        self.feedback_fila = QLabel("")
        self.feedback_fila.setObjectName("questionSessionSummaryDetail")
        self.feedback_fila.setWordWrap(True)
        self.feedback_fila.setVisible(False)

        feedback_layout.addWidget(
            self.feedback_titulo
        )
        feedback_layout.addLayout(
            explicacao_cabecalho
        )
        feedback_layout.addWidget(
            self.feedback_explicacao
        )
        feedback_layout.addWidget(self.feedback_explicacao_barra)
        feedback_layout.addWidget(
            self.feedback_explicacao_editor
        )
        feedback_layout.addWidget(
            self.feedback_explicacao_acoes
        )
        feedback_layout.addWidget(
            self.feedback_fila
        )

        conteudo_layout.addWidget(
            self.feedback
        )
        conteudo_layout.addStretch()

        scroll.setWidget(
            conteudo
        )
        self.scroll_questao = scroll
        self.caneta_estudo = CanetaEstudo(
            scroll,
            self.questao_enunciado,
            lambda: dict(getattr(self, "frame_por_letra", {})),
        )
        self._inicializar_faixa_caneta_estudo()

        # B10: o scroll ocupa o mesmo bloco que a aba fixa da caneta,
        # com espacamento zero: a barra encosta na borda do enunciado.
        self.b10_leitura_layout.addWidget(scroll, 1)
        layout.addLayout(self.b10_leitura_layout, 1)

        self.botao_pular = QPushButton(
            "Pular questão"
        )
        self.botao_pular.setObjectName(
            "questionSessionSkipButton"
        )
        self.botao_pular.setFixedHeight(
            40
        )
        self.botao_pular.setMinimumWidth(
            110
        )
        self.botao_pular.clicked.connect(
            self.pular
        )
        self.botao_pular.setToolTip(
            (
                "Pular mantém a questão pendente no Banco de Erros."
                if self.modo_banco_erros
                else "Primeiro pulo: a questão volta ao final da bateria. "
                "Se for pulada novamente, será tratada como erro pela inteligência."
            )
        )

        self.botao_confirmar = QPushButton(
            "Confirmar resposta"
        )
        self.botao_confirmar.setObjectName(
            "primaryButton"
        )
        self.botao_confirmar.setFixedHeight(
            40
        )
        self.botao_confirmar.setMinimumWidth(
            165
        )
        self.botao_confirmar.clicked.connect(
            self.confirmar_resposta
        )

        self.botao_proxima = QPushButton(
            "Próxima questão"
        )
        self.botao_proxima.setObjectName(
            "primaryButton"
        )
        self.botao_proxima.setFixedHeight(
            40
        )
        self.botao_proxima.setMinimumWidth(
            150
        )
        self.botao_proxima.setVisible(
            False
        )
        self.botao_proxima.clicked.connect(
