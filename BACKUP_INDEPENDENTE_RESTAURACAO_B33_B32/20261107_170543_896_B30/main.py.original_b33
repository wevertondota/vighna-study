        divisor.setFixedHeight(1)
        ritmo_layout.addWidget(divisor)

        ritmo_corpo = QHBoxLayout()
        ritmo_corpo.setSpacing(16)

        principal = QVBoxLayout()
        principal.setSpacing(1)
        self.status_total_dashboard = QLabel(
            "0 min"
        )
        self.status_total_dashboard.setObjectName(
            "dashboardRhythmMainValue"
        )
        self.status_subtitulo_dashboard = QLabel(
            "foco efetivo hoje"
        )
        self.status_subtitulo_dashboard.setObjectName(
            "dashboardRhythmCaption"
        )
        principal.addStretch()
        principal.addWidget(
            self.status_total_dashboard
        )
        principal.addWidget(
            self.status_subtitulo_dashboard
        )
        principal.addStretch()

        separador_vertical = QFrame()
        separador_vertical.setObjectName(
            "dashboardOverviewVerticalDivider"
        )
        separador_vertical.setFixedWidth(1)

        detalhes = QVBoxLayout()
        detalhes.setSpacing(5)

        def criar_linha_foco(titulo_texto, role):
            frame = QFrame()
            frame.setObjectName(
                "dashboardRhythmLine"
            )
            frame.setProperty(
                "metricRole",
                role
            )
            linha = QHBoxLayout(frame)
            linha.setContentsMargins(3, 4, 3, 4)
            linha.setSpacing(7)
            ponto = QLabel("●")
            ponto.setObjectName(
                "dashboardRhythmDot"
            )
            rotulo = QLabel(titulo_texto)
            rotulo.setObjectName(
                "dashboardRhythmLineLabel"
            )
            valor = QLabel("0")
            valor.setObjectName(
                "dashboardRhythmLineValue"
            )
            valor.setAlignment(
                Qt.AlignRight | Qt.AlignVCenter
            )
            linha.addWidget(ponto)
            linha.addWidget(rotulo)
            linha.addStretch()
            linha.addWidget(valor)
            return frame, valor

        semana_linha, self.ritmo_semana_dashboard = criar_linha_foco(
            "Semana",
            "today"
        )
        sessoes_linha, self.ritmo_sessoes_dashboard = criar_linha_foco(
            "Sessões",
            "late"
        )
        detalhes.addStretch()
        detalhes.addWidget(semana_linha)
        detalhes.addWidget(sessoes_linha)
        detalhes.addStretch()

        ritmo_corpo.addLayout(principal, 3)
        ritmo_corpo.addWidget(separador_vertical)
        ritmo_corpo.addLayout(detalhes, 2)
        ritmo_layout.addLayout(ritmo_corpo)

        # Meta semanal de foco. Quando desativada, esta área vira uma
        # leitura de média por sessão e dias com foco.
        self.ritmo_meta_texto = QLabel(
            ""
        )
        self.ritmo_meta_texto.setObjectName(
            "dashboardFocusSummary"
        )
        self.ritmo_meta_texto.setWordWrap(True)
        ritmo_layout.addWidget(
