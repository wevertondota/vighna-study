        QFrame#dashboardTopBar QComboBox#topProfileCombo {
            background-color: %(perfil)s; color: %(texto)s;
            border: none; border-radius: 5px;
            padding: 0px 4px 0px 0px;
            font-size: 10pt; font-weight: 700;
        }
