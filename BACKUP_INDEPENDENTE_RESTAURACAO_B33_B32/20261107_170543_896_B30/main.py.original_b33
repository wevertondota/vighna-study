        )
        self.calibracao_texto.setWordWrap(
            True
        )

        self.calibracao_pesos = QLabel(
            ""
        )
        self.calibracao_pesos.setObjectName(
            "effectivenessWeights"
        )
        self.calibracao_pesos.setWordWrap(
            True
        )

        self.calibracao_observacoes = QLabel(
            ""
        )
        self.calibracao_observacoes.setObjectName(
            "effectivenessObservations"
        )
        self.calibracao_observacoes.setWordWrap(
            True
        )

        calibracao_layout.addLayout(
            calibracao_header
        )
        calibracao_layout.addWidget(
            self.calibracao_texto
        )
        calibracao_layout.addWidget(
            self.calibracao_pesos
        )
        calibracao_layout.addWidget(
            self.calibracao_observacoes
        )

        layout.addWidget(
            self.calibracao_card
        )

        # ----------------------------------------------------
        # ABAS
        # ----------------------------------------------------

        self.abas = QTabWidget()
        self.abas.setObjectName(
            "effectivenessTabs"
        )

        # Aba motivos
        aba_motivos = QWidget()
        motivos_layout = QVBoxLayout(
            aba_motivos
        )
        motivos_layout.setContentsMargins(
            8,
            8,
            8,
            8
        )
        motivos_layout.setSpacing(
            6
        )

        motivos_desc = QLabel(
            (
                "Compara os motivos usados pelo Treino Adaptativo. "
                "Os números são observacionais e não alteram os pesos automaticamente. "
                "Em Δ Recorrentes, valor positivo significa redução de erros recorrentes."
            )
        )
        motivos_desc.setObjectName(
