            )
            valor.setWordWrap(
                True
            )

            detalhe = QLabel(
                "—"
            )
            detalhe.setObjectName(
                "myEvolutionInsightDetail"
            )
            detalhe.setWordWrap(
                True
            )

            frame_layout.addWidget(
                titulo_label
            )
            frame_layout.addWidget(
                valor
            )
            frame_layout.addWidget(
                detalhe
            )

            return frame, valor, detalhe

        frame, self.minha_ganho, self.minha_ganho_detalhe = criar_insight(
            "Maior evolução",
            "positive"
        )
        insights_grade.addWidget(frame, 0, 0)

        frame, self.minha_atencao, self.minha_atencao_detalhe = criar_insight(
            "Ponto de atenção",
            "attention"
        )
        insights_grade.addWidget(frame, 0, 1)

        frame, self.minha_recuperacao, self.minha_recuperacao_detalhe = criar_insight(
            "Recuperação de erros",
            "recovery"
        )
        insights_grade.addWidget(frame, 0, 2)

        insights_layout.addLayout(
            insights_grade
        )
        minha_layout.addWidget(
            insights_card
        )
        insights_card.setVisible(False)

        # Evolução por disciplina.
        disciplina_card = QFrame()
        disciplina_card.setObjectName(
            "myEvolutionPanel"
        )

        disciplina_layout = QVBoxLayout(
            disciplina_card
        )
        disciplina_layout.setContentsMargins(
            14,
            10,
            14,
            12
        )
        disciplina_layout.setSpacing(
            7
        )

        disciplina_header = QHBoxLayout()
        disciplina_titulo = QLabel(
            "Evolução por disciplina"
        )
        disciplina_titulo.setObjectName(
            "myEvolutionSectionTitle"
        )
        self.minha_contagem_disciplinas = QLabel(
            "0 disciplinas"
        )
        self.minha_contagem_disciplinas.setObjectName(
            "filterCount"
        )
        disciplina_header.addWidget(
            disciplina_titulo
        )
        disciplina_header.addStretch()
        disciplina_header.addWidget(
            self.minha_contagem_disciplinas
        )
        disciplina_layout.addLayout(
            disciplina_header
        )

        self.tabela_minha_evolucao = QTableWidget()
        self.tabela_minha_evolucao.setObjectName(
            "myEvolutionTable"
        )
        self.tabela_minha_evolucao.setColumnCount(
            6
        )
        self.tabela_minha_evolucao.setHorizontalHeaderLabels([
            "Disciplina",
            "Domínio",
            "Nível",
            "Desempenho",
            "Variação",
            "Questões"
        ])
        self.tabela_minha_evolucao.setEditTriggers(
            QAbstractItemView.NoEditTriggers
        )
        self.tabela_minha_evolucao.setSelectionBehavior(
            QAbstractItemView.SelectRows
        )
        self.tabela_minha_evolucao.setSelectionMode(
            QAbstractItemView.SingleSelection
        )
        self.tabela_minha_evolucao.setAlternatingRowColors(
            True
        )
        self.tabela_minha_evolucao.setShowGrid(
            False
        )
        self.tabela_minha_evolucao.verticalHeader().setVisible(
            False
        )
        self.tabela_minha_evolucao.setMinimumHeight(
            210
        )
        minha_header = self.tabela_minha_evolucao.horizontalHeader()
        minha_header.setSectionResizeMode(
            0,
            QHeaderView.Stretch
        )
        for coluna in range(1, 6):
            minha_header.setSectionResizeMode(
                coluna,
                QHeaderView.ResizeToContents
            )

        disciplina_layout.addWidget(
            self.tabela_minha_evolucao
        )
        minha_layout.addWidget(
            disciplina_card
        )
        disciplina_card.setVisible(False)

        # Tópicos que mais mudaram no período.
        topicos_card = QFrame()
        topicos_card.setObjectName(
            "myEvolutionPanel"
        )
        topicos_layout = QVBoxLayout(
            topicos_card
        )
        topicos_layout.setContentsMargins(
            14, 10, 14, 12
        )
        topicos_layout.setSpacing(7)

        topicos_header = QHBoxLayout()
        topicos_titulo = QLabel(
            "Tópicos em movimento"
        )
        topicos_titulo.setObjectName(
            "myEvolutionSectionTitle"
        )
        topicos_desc = QLabel(
            "Compara o desempenho com o período anterior quando há amostra suficiente."
        )
        topicos_desc.setObjectName(
