        def criar_card_progresso(
            titulo_texto
        ):
            card = QFrame()
            card.setObjectName(
                "syllabusStat"
            )

            card_layout = QVBoxLayout(
                card
            )
            card_layout.setContentsMargins(
                12,
                9,
                12,
                9
            )
            card_layout.setSpacing(
                2
            )

            rotulo = QLabel(
                titulo_texto
            )
            rotulo.setObjectName(
                "miniStatLabel"
            )

            valor = QLabel(
                "—"
            )
            valor.setObjectName(
                "miniStatValue"
            )

            detalhe = QLabel(
                "—"
            )
            detalhe.setObjectName(
                "syllabusStatHint"
            )

            card_layout.addWidget(
                rotulo
            )
            card_layout.addWidget(
                valor
            )
            card_layout.addWidget(
                detalhe
            )

            return (
                card,
                valor,
                detalhe
            )

        (
            card,
            self.progresso_card_trabalhado,
            self.progresso_card_trabalhado_hint
        ) = criar_card_progresso(
            "Cobertura do edital"
        )
        resumo_progresso.addWidget(
            card,
            0,
            0
        )

        (
            card,
            self.progresso_card_consolidado,
            self.progresso_card_consolidado_hint
        ) = criar_card_progresso(
