            "pageTitle"
        )

        subtitulo = QLabel(
            (
                "Mede o efeito das sessões sobre domínio, cobertura e erros "
                "e verifica se a estratégia adaptativa está produzindo "
                "evidência útil."
            )
        )
        subtitulo.setObjectName(
            "pageSubtitle"
        )
        subtitulo.setWordWrap(
            True
        )

        titulos.addWidget(
