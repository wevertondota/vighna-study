        self.sessao_progresso_texto.setObjectName(
            "questionSessionProgressText"
        )

        self.botao_opcoes = QPushButton("Opções")
        self.botao_opcoes.setObjectName("subtleButton")
        self.botao_opcoes.setProperty("sessionNavigation", True)
        self.botao_opcoes.setFixedHeight(34)
        self.botao_opcoes.setToolTip(
            "Abrir ações rápidas da bateria: Dashboard, editar alternativas e analisar depois."
        )

        # Acesso direto ao Modo Foco existente, sem criar cronômetro paralelo.
        self.botao_foco_topo = QPushButton("Modo Foco")
        self.botao_foco_topo.setObjectName("questionSessionFocusButton")
        self.botao_foco_topo.setFixedHeight(34)
        self.botao_foco_topo.setMinimumWidth(94)
        self.botao_foco_topo.setToolTip(
            "Abrir ou trazer o Modo Foco para frente (Ctrl+Shift+F para restaurar)."
        )
        self.botao_foco_topo.clicked.connect(self.abrir_foco_pelo_cabecalho)
        self._estado_botao_foco_topo = None

        self.botao_pausa = QPushButton("Pausa")
        self.botao_pausa.setObjectName("questionSessionPauseButton")
        self.botao_pausa.setFixedHeight(34)
        self.botao_pausa.setToolTip("Programar um descanso e receber um aviso sobre as demais janelas.")
        self.botao_pausa.clicked.connect(self.abrir_pausa_programada)

        encerrar = QPushButton(
            (
                "Entregar simulado"
                if self.modo_simulado
                else "Encerrar sessão"
            )
        )
        encerrar.setObjectName(
            "questionSessionEndButton"
        )
        encerrar.setFixedHeight(
            34
        )
        encerrar.clicked.connect(
            self.encerrar_manual
        )

        cabecalho.addLayout(
            titulos
        )
        cabecalho.addStretch()
        self.simulado_relogio = QLabel(
            ""
        )
        self.simulado_relogio.setObjectName(
            "mockExamTimer"
        )
        self.simulado_relogio.setVisible(
            self.modo_simulado
        )

        cabecalho.addWidget(
            self.simulado_relogio,
            0,
            Qt.AlignVCenter
        )
        cabecalho.addWidget(
            self.botao_opcoes,
            0,
            Qt.AlignVCenter
        )
        cabecalho.addWidget(
            self.botao_foco_topo,
            0,
            Qt.AlignVCenter
        )
        cabecalho.addWidget(
            self.botao_pausa,
            0,
            Qt.AlignVCenter
        )
        cabecalho.addWidget(
            encerrar,
            0,
            Qt.AlignVCenter
        )

        layout.addWidget(self.cabecalho_sessao)

        # B09: contadores + questão atual/total no mesmo HUD compacto esquerdo.
        # Sem barra horizontal de largura total sobre o ET e sem movimentar
        # os controles da caneta. A paleta permanece na linha seguinte.
        self.faixa_estudo_superior = QWidget(self)
        # B07: a faixa que hospeda a caneta não deve pintar um retângulo
        # opaco sobre o cenário. Só os controles interativos pintam seus cards.
        self.faixa_estudo_superior.setObjectName("questionSessionToolbarCanvasB07")
        self.faixa_estudo_superior.setAutoFillBackground(False)
        self.faixa_estudo_superior.setAttribute(Qt.WA_TranslucentBackground, True)
        faixa_superior_layout = QVBoxLayout(self.faixa_estudo_superior)
        faixa_superior_layout.setContentsMargins(0, 0, 0, 0)
        faixa_superior_layout.setSpacing(2)

        self.sessao_overview = QFrame(self.faixa_estudo_superior)
        self.sessao_overview.setObjectName("questionSessionOverviewCard")
        overview_layout = QVBoxLayout(self.sessao_overview)
        overview_layout.setContentsMargins(12, 6, 12, 7)
        overview_layout.setSpacing(5)

        self.sessao_resumo_layout = QBoxLayout(QBoxLayout.LeftToRight)
        self.sessao_resumo_layout.setSpacing(12)
        self._sessao_resumo_empilhado = None

        self.sessao_indicadores = QWidget(self.sessao_overview)
        metricas = QHBoxLayout(self.sessao_indicadores)
        self._b12_rotulos_metricas = []
        metricas.setContentsMargins(0, 0, 0, 0)
        metricas.setSpacing(6)

        def metrica(titulo_texto, papel="neutral"):
            frame = QFrame(self.sessao_indicadores)
            frame.setObjectName("questionSessionMiniStat")
            frame_layout = QHBoxLayout(frame)
            frame_layout.setContentsMargins(5, 2, 5, 2)
            frame_layout.setSpacing(4)
            rotulo = QLabel(titulo_texto)
            rotulo.setObjectName("questionSessionMiniLabel")
            rotulo.setToolTip(titulo_texto)
            self._b12_rotulos_metricas.append((rotulo, titulo_texto))
            valor = QLabel("0")
            valor.setObjectName("questionSessionMiniValue")
            valor.setProperty("metricRole", papel)
            frame_layout.addWidget(rotulo)
            frame_layout.addWidget(valor)
            return frame, valor

        frame, self.stat_respondidas = metrica("Respondidas")
        metricas.addWidget(frame)
        frame, self.stat_acertos = metrica("Acertos", "success")
        metricas.addWidget(frame)
        frame, self.stat_erros = metrica("Erros", "danger")
        metricas.addWidget(frame)
        frame, self.stat_puladas = metrica("Puladas", "warning")
        metricas.addWidget(frame)

        if self.modo_simulado:
            self.stat_acertos.setText("—")
            self.stat_erros.setText("—")

        self.sessao_status_widget = QWidget(self.sessao_overview)
        status_layout = QHBoxLayout(self.sessao_status_widget)
        status_layout.setContentsMargins(0, 0, 0, 0)
        status_layout.setSpacing(10)
        self.sessao_progresso_texto.setToolTip("Progresso da sessão de questões")
        status_layout.addWidget(self.sessao_progresso_texto)
        self.sessao_ciclo_texto = QLabel("")
        self.sessao_ciclo_texto.setObjectName("questionSessionCycleText")
        self.sessao_ciclo_texto.hide()
        status_layout.addWidget(self.sessao_ciclo_texto)

        # B09: indicadores e contador passam a formar um único HUD compacto
        # à esquerda. O restante da faixa fica realmente transparente para
        # deixar a arquitetura e o ET visíveis; nada é desenhado à direita.
        self.sessao_resumo_layout.addWidget(self.sessao_indicadores)
        self.sessao_resumo_layout.addWidget(self.sessao_status_widget)
        overview_layout.addLayout(self.sessao_resumo_layout)
        overview_layout.setContentsMargins(6, 4, 8, 4)
        overview_layout.setSpacing(0)
        self.sessao_overview.setSizePolicy(QSizePolicy.Maximum, QSizePolicy.Fixed)
        self.sessao_overview.setMaximumWidth(900)

        # A lógica de progresso continua intacta. Apenas a barra visual de
        # largura total é retirada; a contagem atual/total permanece visível
        # no HUD esquerdo e continua atualizada em carregar_atual().
        self.sessao_progresso = QProgressBar(self.sessao_overview)
        self.sessao_progresso.setObjectName("questionSessionProgress")
        self.sessao_progresso.setRange(0, len(self.fila))
        self.sessao_progresso.setValue(0)
        self.sessao_progresso.setTextVisible(False)
        self.sessao_progresso.hide()
        linha_resumo_compacto = QHBoxLayout()
        linha_resumo_compacto.setContentsMargins(0, 0, 0, 0)
        linha_resumo_compacto.setSpacing(0)
        linha_resumo_compacto.addWidget(self.sessao_overview, 0, Qt.AlignLeft | Qt.AlignVCenter)
        linha_resumo_compacto.addStretch(1)
        self._b12_layout_hud_reserva = linha_resumo_compacto
        self._b12_hud_no_cabecalho = False
        faixa_superior_layout.addLayout(linha_resumo_compacto)

        # B10: a caneta continua ligada ao enunciado; o B12 move SOMENTE
        # o mesmo widget de indicadores para a primeira linha quando couber.
        # A caneta vai para a aba da borda superior do enunciado,
        # preservada fora do scroll para continuar acessível.
        layout.addWidget(self.faixa_estudo_superior)
        self._ajustar_layout_progresso_caneta(self.width())

        self._construir_overlay_pausa_visual()

        # Faixa contextual do Modo Foco: baixa altura e baixa saliência para
        # não disputar atenção com a questão.
        self.foco_painel = QFrame()
        self.foco_painel.setObjectName("questionSessionFocusBar")
        foco_layout = QHBoxLayout(self.foco_painel)
        foco_layout.setContentsMargins(11, 5, 8, 5)
        foco_layout.setSpacing(7)

        self.foco_estado = QLabel("")
        self.foco_estado.setObjectName("questionSessionFocusState")
        self.foco_estado.setAccessibleName("Estado do Modo Foco")

        self.foco_pausar = QPushButton("Pausar")
        self.foco_pausar.setObjectName("subtleButton")
        self.foco_pausar.setFixedHeight(30)
        self.foco_pausar.setToolTip("Pausar ou retomar a sessão de foco atual (F8)")
        self.foco_pausar.clicked.connect(self.alternar_foco_resolvedor)

        self.foco_abrir = QPushButton("Abrir foco")
        self.foco_abrir.setObjectName("subtleButton")
        self.foco_abrir.setFixedHeight(30)
        self.foco_abrir.setToolTip(
            "Mostrar, restaurar e trazer a janela do Modo Foco para frente (Ctrl+Shift+F)"
        )
        self.foco_abrir.clicked.connect(self.abrir_foco_resolvedor)

        foco_layout.addWidget(self.foco_estado)
        foco_layout.addStretch()
        foco_layout.addWidget(self.foco_pausar)
        foco_layout.addWidget(self.foco_abrir)
        self.foco_painel.hide()
        layout.addWidget(self.foco_painel)

        self.atalho_pausa_foco = QShortcut(QKeySequence("F8"), self)
        self.atalho_pausa_foco.setContext(Qt.WindowShortcut)
        self.atalho_pausa_foco.activated.connect(self.alternar_foco_resolvedor)

        self.atalho_abrir_foco = QShortcut(QKeySequence("Ctrl+Shift+F"), self)
        self.atalho_abrir_foco.setContext(Qt.WindowShortcut)
        self.atalho_abrir_foco.activated.connect(self.abrir_foco_resolvedor)

        self._timer_interface_foco = QTimer(self)
        self._timer_interface_foco.setInterval(1000)
        self._timer_interface_foco.timeout.connect(self.atualizar_painel_foco)
        self._timer_interface_foco.start()

        controlador_foco = self._localizar_controlador_foco()
        sinal_estado_foco = getattr(controlador_foco, "estado_foco_alterado", None)
        if sinal_estado_foco is not None:
            sinal_estado_foco.connect(self.atualizar_painel_foco)

        # Área da questão com scroll vertical e sem scroll horizontal.
        scroll = QScrollArea()
        scroll.setObjectName(
            "questionSolverScroll"
        )
        scroll.setWidgetResizable(
            True
        )
        scroll.setFrameShape(
            QFrame.NoFrame
        )
        scroll.setHorizontalScrollBarPolicy(
            Qt.ScrollBarAlwaysOff
        )
        # B05: textos extensos crescem verticalmente, sem corte horizontal.
        # O ajuste de roda não interfere no modo caneta, nem no filtro de teclas.
        scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        scroll.verticalScrollBar().setSingleStep(30)
        # A imagem fica atrás da área rolável; viewport não deve ocultá-la.
        scroll.setAutoFillBackground(False)
        scroll.viewport().setAutoFillBackground(False)
        scroll.viewport().setAttribute(Qt.WA_TranslucentBackground, True)

        conteudo = QWidget()
        conteudo.setObjectName(
            "questionSolverContent"
        )
        conteudo.setAutoFillBackground(False)
        conteudo.setAttribute(Qt.WA_TranslucentBackground, True)

        conteudo_layout = QVBoxLayout(
            conteudo
        )
        self._b05_layout_conteudo = conteudo_layout
        conteudo_layout.setContentsMargins(
            0,
            0,
            8,
            0
        )
        conteudo_layout.setSpacing(8)

        # B12: preserva uma janela cenográfica para o ET no topo, mesmo quando
        # os indicadores passam à mesma linha da marca. O espaçador é reduzido
        # apenas em telas pequenas; não muda a imagem de fundo.
        self._b12_respiro_cenario = QSpacerItem(0, 61, QSizePolicy.Minimum, QSizePolicy.Fixed)
        layout.addItem(self._b12_respiro_cenario)

        # Aba Qt real, conectada visualmente à borda superior do enunciado.
        # Sem novos controles e sem cliques fora do retângulo da paleta.
        self.b10_leitura_layout = QVBoxLayout()
        self.b10_leitura_layout.setContentsMargins(0, 0, 0, 0)
        self.b10_leitura_layout.setSpacing(0)
        self.b10_aba_caneta = QWidget(self)
        self.b10_aba_caneta.setObjectName("questionSolverInkDockB10")
        self.b10_aba_caneta.setAutoFillBackground(False)
        self.b10_aba_caneta.setAttribute(Qt.WA_TranslucentBackground, True)
        aba_layout = QHBoxLayout(self.b10_aba_caneta)
        # O recuo direito acompanha os 8 px do conteudo rolável.
        aba_layout.setContentsMargins(0, 0, 8, 0)
        aba_layout.setSpacing(0)
        self.b10_linha_esquerda = QFrame(self.b10_aba_caneta)
        self.b10_linha_esquerda.setObjectName("questionSolverInkDockEdgeB10")
        self.b10_linha_esquerda.setFixedHeight(1)
        self.b10_linha_esquerda.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        aba_layout.addWidget(self.b10_linha_esquerda, 1, Qt.AlignBottom)
        self.faixa_caneta = FaixaCanetaEstudo(
            on_modo=self.definir_ferramenta_caneta,
            on_cor=self._definir_cor_caneta,
            on_espessura=self._definir_espessura_caneta,
            on_desfazer=self.desfazer_caneta_estudo,
            on_limpar=self.limpar_caneta_estudo,
            parent=self.b10_aba_caneta,
        )
        self.faixa_caneta.setMinimumWidth(0)
        self.faixa_caneta.setMaximumWidth(540)
        self.faixa_caneta.setSizePolicy(QSizePolicy.Preferred, QSizePolicy.Fixed)
        self.botao_caneta = self.faixa_caneta.botao_recolher
        aba_layout.addWidget(self.faixa_caneta, 0, Qt.AlignVCenter)
        self.b10_linha_direita = QFrame(self.b10_aba_caneta)
        self.b10_linha_direita.setObjectName("questionSolverInkDockEdgeB10")
        self.b10_linha_direita.setFixedHeight(1)
        # B26 R8 R7: a faixa de ferramentas ocupa a extrema direita do dock.
        # Somente a linha da esquerda absorve o espaço excedente; a da
        # direita não compete mais na distribuição horizontal do QHBoxLayout.
        # Preserva os controles, as dimensões internas e a margem de 8 px.
        self.b10_linha_direita.setFixedWidth(0)
        self.b10_linha_direita.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Fixed)
        aba_layout.addWidget(self.b10_linha_direita, 0, Qt.AlignBottom)
        self.b10_leitura_layout.addWidget(self.b10_aba_caneta)

        enunciado_card = QFrame()
        self._caneta_enunciado_card = enunciado_card
        enunciado_card.setObjectName(
            "questionSolverStatementCard"
        )

        enunciado_layout = QVBoxLayout(
            enunciado_card
        )
        self._b05_layout_enunciado = enunciado_layout
        enunciado_layout.setContentsMargins(17, 11, 17, 14)
        enunciado_layout.setSpacing(6)

        self.questao_indice = QLabel("QUESTÃO 1")
        self.questao_indice.setObjectName("questionSolverQuestionIndex")

        self.cabecalho_questao = QWidget(enunciado_card)
        self.cabecalho_questao.setObjectName("questionSolverQuestionHeader")
        self.cabecalho_questao.setAttribute(Qt.WA_StyledBackground, True)
        # Navegação recebe o tema unificado do resolvedor.
        cabecalho_questao_layout = QHBoxLayout(self.cabecalho_questao)
        cabecalho_questao_layout.setContentsMargins(0, 0, 0, 0)
        cabecalho_questao_layout.setSpacing(5)
        cabecalho_questao_layout.addWidget(self.questao_indice, 0, Qt.AlignVCenter)

        # B11: divisor discreto + disciplina/topico dentro da mesma moldura.
        # Sao os MESMOS campos alimentados por carregar_atual() e pelo
        # histórico, não uma cópia estática ou um segundo estado.
        self.b11_divisor_contexto = QFrame(self.cabecalho_questao)
        self.b11_divisor_contexto.setObjectName("questionSolverContextDividerB11")
        self.b11_divisor_contexto.setFixedSize(1, 24)
        cabecalho_questao_layout.addSpacing(7)
        cabecalho_questao_layout.addWidget(self.b11_divisor_contexto, 0, Qt.AlignVCenter)
        cabecalho_questao_layout.addSpacing(7)
        self.b11_contexto_topico = QWidget(self.cabecalho_questao)
        self.b11_contexto_topico.setObjectName("questionSolverContextBlockB11")
        self.b11_contexto_topico.setMinimumWidth(0)
        self.b11_contexto_topico.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        b11_layout = QVBoxLayout(self.b11_contexto_topico)
        b11_layout.setContentsMargins(0, 0, 0, 0)
        b11_layout.setSpacing(1)
        self.questao_disciplina = _RotuloContextoB11("", self.b11_contexto_topico)
        self.questao_disciplina.setObjectName("questionSolverDiscipline")
        self.questao_meta = _RotuloContextoB11("", self.b11_contexto_topico)
        self.questao_meta.setObjectName("questionSolverMeta")
        b11_layout.addWidget(self.questao_disciplina)
        b11_layout.addWidget(self.questao_meta)
        cabecalho_questao_layout.addWidget(self.b11_contexto_topico, 1, Qt.AlignVCenter)

        self.botao_voltar_questao_atual = QPushButton("Voltar à atual", self.cabecalho_questao)
        self.botao_voltar_questao_atual.setObjectName("questionSolverReturnCurrentButton")
        self.botao_voltar_questao_atual.setFixedHeight(27)
        self.botao_voltar_questao_atual.setVisible(False)
        self.botao_voltar_questao_atual.clicked.connect(self.sair_revisao_questoes)
        cabecalho_questao_layout.addWidget(self.botao_voltar_questao_atual)

        def _icone_nav_questao(tipo):
            # Vetores pintados pelo Qt: independem dos glifos da fonte Windows.
            pixmap = QPixmap(18, 18)
            pixmap.fill(Qt.transparent)
            painter = QPainter(pixmap)
            painter.setRenderHint(QPainter.Antialiasing)
            painter.setPen(QPen(QColor("#C4E4F7"), 1.8, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin))
            if tipo == "anterior":
                painter.drawLine(11, 4, 6, 9)
                painter.drawLine(6, 9, 11, 14)
            elif tipo == "posterior":
                painter.drawLine(7, 4, 12, 9)
                painter.drawLine(12, 9, 7, 14)
            else:
                for xx in (3, 10):
                    for yy in (3, 10):
                        painter.drawRoundedRect(QRectF(xx, yy, 5, 5), 1, 1)
            painter.end()
            return QIcon(pixmap)

        def _criar_botao_nav_questao(tipo, dica, nome):
            botao = QToolButton(self.cabecalho_questao)
            botao.setObjectName(nome)
            botao.setIcon(_icone_nav_questao(tipo))
            botao.setIconSize(QSize(18, 18))
            botao.setAutoRaise(False)
            botao.setFixedSize(29, 28)
            botao.setToolTip(dica)
            botao.setAccessibleName(dica)
            botao.setFocusPolicy(Qt.TabFocus)
            return botao

        self.botao_questao_anterior = _criar_botao_nav_questao(
            "anterior", "Voltar para uma questão já respondida", "questionSolverHistoryPrevButton"
        )
        self.botao_mapa_questoes = _criar_botao_nav_questao(
            "mapa", "Abrir mapa das questões já respondidas", "questionSolverHistoryMapButton"
        )
        self.botao_questao_posterior = _criar_botao_nav_questao(
            "posterior", "Avançar na revisão ou voltar à questão atual", "questionSolverHistoryNextButton"
        )
        self.botao_questao_anterior.clicked.connect(
            lambda: self.navegar_revisao_questoes(-1)
        )
        self.botao_mapa_questoes.clicked.connect(self.abrir_mapa_questoes_respondidas)
        self.botao_questao_posterior.clicked.connect(
            lambda: self.navegar_revisao_questoes(1)
        )
        cabecalho_questao_layout.addWidget(self.botao_questao_anterior)
        cabecalho_questao_layout.addWidget(self.botao_mapa_questoes)
        cabecalho_questao_layout.addWidget(self.botao_questao_posterior)

        # A paleta permanece fixa abaixo do progresso da sessão.
        enunciado_layout.addWidget(self.cabecalho_questao)

        self.questao_enunciado = QLabel(
