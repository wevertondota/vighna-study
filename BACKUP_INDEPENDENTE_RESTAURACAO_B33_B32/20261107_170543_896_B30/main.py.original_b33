    def __init__(self, parent):
        super().__init__(parent)
        self.setObjectName("questionSynapseConstellationB26")
        self.setAttribute(Qt.WA_TransparentForMouseEvents, False)
        self.setAttribute(Qt.WA_TranslucentBackground, True)
        self.setAttribute(Qt.WA_NoSystemBackground, True)
        self.setFocusPolicy(Qt.NoFocus)
        self.setCursor(Qt.PointingHandCursor)
        self.setToolTip("Catálogo: acerto +1, erro −6; conquistas globais e formas lendárias")
        self.setAutoFillBackground(False)
        # R8 R11: o bloco informativo não possui superfície fosca própria.
        # O tema global não deve aplicar plano de fundo nem borda ao HUD.
        self.setStyleSheet(
            "QWidget#questionSynapseConstellationB26 { "
            "background-color: transparent; background: transparent; border: none; }"
        )
        self._combo = 0
        self._monocromatico = False
        self._intensidade = 78
        self._b26_animacao_vibracao = None
        self._b26_fase_vibracao = 1.0
        self._b26_vibracao_dourada = False
        self._b26_marco_ativo = False
        # B26 R8 R3: plasma orbital original, desenhado por QPainter em tempo
        # real, sem trocar PNG, alterar o receptor ou modificar a contagem.
        # Só há quadros periódicos quando o combo >= 10 e o widget é visível.
        # R8 R5: chama permanente em combos ×10+, sem opção ou preferência.
        self._b26r9_fase_chama = 0.0
        self._b26r9_timer_chama = QTimer(self)
        self._b26r9_timer_chama.setInterval(55)  # ~18 fps, baixo custo
        self._b26r9_timer_chama.timeout.connect(self._b26r9_animar_chama)
        self.setAccessibleName("Constelacao Sinaptica, combo 0")
        self.hide()

    def definir_intensidade(self, valor):
        valor = max(0, min(100, int(valor)))
        if self._intensidade != valor:
            self._intensidade = valor
            self.update()

    def definir_combo(self, valor):
        try:
            numero = max(0, min(9999, int(valor)))
        except (TypeError, ValueError, OverflowError):
            numero = 0
        if numero == self._combo:
            return
        if numero == 0:
            self.parar_vibracao()
        self._combo = numero
        self.setAccessibleName(f"Constelacao Sinaptica, combo {numero}")
        self._b26r9_sincronizar_chama()
        self.update()

    def _b26r9_sincronizar_chama(self):
        timer = getattr(self, "_b26r9_timer_chama", None)
        if timer is None:
            return
        deve_animar = (self._combo >= 10 and self.isVisible()
                       and self.width() >= 138 and self.height() >= 68)
        if deve_animar:
            if not timer.isActive():
                timer.start()
        elif timer.isActive():
            timer.stop()

    def _b26r9_animar_chama(self):
        """Quadro real: altera a geometria do plasma, não apenas a opacidade."""
        if self._combo < 10 or not self.isVisible():
            self._b26r9_timer_chama.stop()
            return
        self._b26r9_fase_chama = (self._b26r9_fase_chama + 0.115) % (2 * math.pi * 100)
        self.update()

    def showEvent(self, evento):
        super().showEvent(evento)
        self._b26r9_sincronizar_chama()

    def hideEvent(self, evento):
        self._b26r9_timer_chama.stop()
        super().hideEvent(evento)

    @classmethod
    def _b26r9_dados_chamas(cls, combo, fase):
        """Coordenadas polares determinísticas, próprias para teste e desenho.

        O campo energético permanece dentro do semicírculo de 50 unidades,
        afastado do texto SEQUÊNCIA que começa em x=122.
        """
        nivel = min(8, cls._b26r8_perfil(combo) // 10)
        if nivel == 0:
            return []
        total = min(26, 8 + nivel * 2)
        dados = []
        for indice in range(total):
            base = 2.0 * math.pi * indice / total - math.pi / 2.0
            angulo = base + 0.055 * math.sin(0.78 * fase + 1.27 * indice)
            cintura = 35.0 + 1.2 * math.sin(fase * 0.83 + indice * 0.91)
            ponta = (41.5 + 0.8 * nivel
                     + 2.5 * math.sin(fase * 1.16 + indice * 1.93)
                     + 1.1 * math.cos(fase * 0.61 + indice * 0.73))
            ponta = max(cintura + 2.0, min(48.6, ponta))
            balanco = 0.13 * math.sin(fase * 1.34 + indice * 1.81)
            brilho = 0.70 + 0.30 * math.sin(fase * 1.37 + indice * 1.59)**2
            dados.append((angulo, cintura, ponta, balanco, brilho))
        return dados

    @classmethod
    def _b26r9_pintar_chamas(cls, pintor, combo, monocromatico, intensidade, fase):
        """Plasma sutil atrás do emblema: posição/forma mudam a cada quadro.

        O efeito é recortado à área esquerda; não toca textos, controles,
        imagem de fundo, receptor de energia ou lógica de pontuação.
        """
        perfil = cls._b26r8_perfil(combo)
        if perfil < 10:
            return
        etapa = min(8, perfil // 10)
        cor_marco = cls.info_marco_combo(combo)["atual"]
        primaria = (206, 215, 226) if monocromatico else cor_marco["principal"]
        clara = (247, 247, 247) if monocromatico else cor_marco["clara"]
        secundaria = (222, 222, 222) if monocromatico else cor_marco["acento"]
        # R8 R5: plasma ligeiramente mais evidente sem saturar o cristal.
        # Preserva o controle geral de brilho (não adiciona novos controles).
        escala = 0.48 + 0.52 * max(0, min(100, int(intensidade))) / 100.0
        if monocromatico:
            escala *= 0.68

        def cor(rgb, alfa):
            return QColor(*rgb, max(0, min(255, round(alfa * escala))))

        centro = QPointF(58.0, 51.0)
        def polar(raio, ang):
            return QPointF(centro.x() + raio * math.cos(ang),
                           centro.y() + raio * math.sin(ang))

        pintor.save()
        pintor.setRenderHint(QPainter.Antialiasing, True)
        pintor.setClipRect(QRectF(5.0, 2.0, 108.0, 99.0))

        # Pequenas chamas translúcidas: a ponta e a curvatura se movimentam.
        # A quantidade e o alcance crescem suavemente de ×10 a ×50.
        for i, (angulo, cintura, ponta, balanco, brilho) in enumerate(
                cls._b26r9_dados_chamas(combo, fase)):
            p_esq = polar(cintura, angulo - 0.12)
            p_dir = polar(cintura, angulo + 0.12)
            p_ponta = polar(ponta, angulo + balanco)
            forma = QPainterPath(p_esq)
            forma.cubicTo(polar(cintura+3.5, angulo-0.105),
                          polar(ponta-2.4, angulo+balanco-0.068), p_ponta)
            forma.cubicTo(polar(ponta-2.2, angulo+balanco+0.064),
                          polar(cintura+3.3, angulo+0.11), p_dir)
            forma.closeSubpath()
            matiz = secundaria if etapa == 5 and i % 3 == 0 else primaria
            luminancia = min(162, (78 + etapa*10) * brilho)
            gradiente = QLinearGradient(polar(cintura-1.5, angulo), p_ponta)
            gradiente.setColorAt(0.0, cor(matiz, 22))
            gradiente.setColorAt(0.32, cor(matiz, luminancia))
            gradiente.setColorAt(0.72, cor(clara, luminancia*0.68))
            gradiente.setColorAt(1.0, cor(clara, 0))
            pintor.setPen(Qt.NoPen)
            pintor.setBrush(QBrush(gradiente))
            pintor.drawPath(forma)
            # Pequeno filete vivo em chamas alternadas, sem ampliar o campo.
            if i % 3 == 0:
                veia = QPainterPath(polar(cintura+1.0, angulo))
                veia.quadTo(polar((cintura+ponta)/2, angulo+balanco*0.45),
                           polar(ponta-1.8, angulo+balanco))
                pintor.setBrush(Qt.NoBrush)
                pintor.setPen(QPen(cor(clara, (60+6*etapa)*brilho), 0.7,
                                    Qt.SolidLine, Qt.RoundCap))
                pintor.drawPath(veia)

        # Três arcos de fluxo independentes mudam de curvatura e de posição.
        # Dois traçados por arco (halo e núcleo) criam vibração energética
        # sem formar uma chama opaca que concorra com a leitura das questões.
        for faixa in range(3):
            inicio = -math.pi / 2 + faixa * 2.0*math.pi/3 + fase * (0.13+faixa*0.025)
            raio = 38.0 + faixa * 2.2
            percurso = QPainterPath()
            for k in range(10):
                theta = inicio + (k/9.0) * (0.57 + etapa * 0.014)
                ondulacao = 1.3 * math.sin(fase*1.12 + faixa*2.6 + k*0.75)
                ponto = polar(raio+ondulacao, theta)
                if not k:
                    percurso.moveTo(ponto)
                else:
                    percurso.lineTo(ponto)
            matiz = secundaria if faixa == 1 else primaria
            pintor.setBrush(Qt.NoBrush)
            pintor.setPen(QPen(cor(matiz, 49+7*etapa), 3.25,
                              Qt.SolidLine, Qt.RoundCap))
            pintor.drawPath(percurso)
            pintor.setPen(QPen(cor(clara, 100+8*etapa), 0.9,
                              Qt.SolidLine, Qt.RoundCap))
            pintor.drawPath(percurso)
        pintor.restore()

    @classmethod
    def info_marco_combo(cls, combo):
        try:
            numero = max(0, int(combo))
        except (TypeError, ValueError, OverflowError):
            numero = 0
        atual = None
        for item in cls._MARCOS_CROMATICOS:
            if numero >= item["alvo"]:
                atual = item
        proximo = None
        for item in cls._MARCOS_CROMATICOS:
            if numero < item["alvo"]:
                proximo = item
                break
        if atual is None:
            atual = {
                "alvo": 0,
                "titulo": "Formação inicial",
                "subtitulo": "pentagrama completo no ×5; forma premium no ×10",
                "principal": (71, 224, 247),
                "clara": (208, 250, 255),
                "acento": (250, 202, 103),
                "acento_claro": (255, 242, 193),
                "base": (92, 148, 174),
            }
        return {"combo": numero, "atual": atual, "proximo": proximo}

    def mousePressEvent(self, evento):
        if evento.button() == Qt.LeftButton:
            self.clicked.emit()
            evento.accept()
            return
        super().mousePressEvent(evento)

    def _b26_mudar_fase_vibracao(self, valor):
        self._b26_fase_vibracao = max(0.0, min(1.0, float(valor)))
        if self.isVisible():
            self.update()

    def _b26_finalizar_vibracao(self, animacao):
        if self._b26_animacao_vibracao is animacao:
            self.parar_vibracao()

    def parar_vibracao(self):
        animacao = self._b26_animacao_vibracao
        self._b26_animacao_vibracao = None
        if animacao is not None:
            animacao.stop()
            animacao.deleteLater()
        self._b26_fase_vibracao = 1.0
        self._b26_vibracao_dourada = False
        self._b26_marco_ativo = False
        self.update()

    @staticmethod
    def _b26r1_duracao_recebimento(combo):
        """Cerimônia curta nos marcos, mantendo o pulso normal discreto."""
        duracoes = {5:760, 10:670, 20:720, 30:760, 40:790, 50:840,
                    65:870, 85:890, 110:940, 140:980, 180:1030, 230:1100}
        return duracoes.get(int(combo), 240+20*min(4,max(0,int(combo))))

    def vibrar_recebimento(self, dourado=False):
        self.parar_vibracao()
        if not self.isVisible() or self._combo <= 0:
            return
        self._b26_vibracao_dourada = bool(dourado)
        self._b26_marco_ativo = self._combo in _HistoricoMarcosConstelacao.MARCOS
        animacao = QVariantAnimation(self)
        animacao.setStartValue(0.0)
        animacao.setEndValue(1.0)
        animacao.setDuration(self._b26r1_duracao_recebimento(self._combo))
        animacao.setEasingCurve(QEasingCurve.Linear)
        animacao.valueChanged.connect(self._b26_mudar_fase_vibracao)
        animacao.finished.connect(
            lambda atual=animacao: self._b26_finalizar_vibracao(atual))
        self._b26_animacao_vibracao = animacao
        self._b26_fase_vibracao = 0.0
        animacao.start()

    @staticmethod
    def _b26_pulso_escala(progresso, especial=False):
        t = max(0.0, min(1.0, float(progresso)))
        incremento = 0.105 if especial else 0.065
        pontos = ((0.0, 1.0), (0.26, 1.0+incremento),
                  (0.70, 0.985), (1.0, 1.0))
        for (t0,v0),(t1,v1) in zip(pontos,pontos[1:]):
            if t <= t1:
                u = (t-t0)/(t1-t0)
                u = u*u*(3.0-2.0*u)
                return v0+(v1-v0)*u
        return 1.0

    def definir_monocromatico(self, ativo):
        """R8 R5: emblema premium permanece colorido mesmo em leitura P&B."""
        if self._monocromatico:
            self._monocromatico = False
            self.update()

    @staticmethod
    def arestas_ativas(combo):
        try:
            nivel = max(0, min(5, int(combo)))
        except (TypeError, ValueError, OverflowError):
            nivel = 0
        return _ConstelacaoSinapticaB26._ARESTAS[:_ConstelacaoSinapticaB26._ARESTAS_POR_COMBO[nivel]]

    def ponto_receptor(self):
        """Destino geométrico preservado: o feixe mira o centro real da estrela.
        R8 R8: atualiza somente a escala horizontal (265 unidades)."""
        return QPoint(round(self.width()*58.0/265.0),
                      round(self.height()*51.0/112.0))

    @staticmethod
    def _b26r8_perfil(combo):
        """Retorna o maior marco visual atingido; ×5 é a estrela completa."""
        try:
            n = max(0, int(combo))
        except (TypeError, ValueError, OverflowError):
            n = 0
        return max((item["alvo"] for item in _ConstelacaoSinapticaB26._MARCOS_CROMATICOS
                    if item["alvo"] <= n and item["alvo"] >= 10), default=0)

    @staticmethod
    def _b26r8_path(pontos):
        caminho = QPainterPath()
        for i, (x, y) in enumerate(pontos):
            if i == 0:
                caminho.moveTo(float(x), float(y))
            else:
                caminho.lineTo(float(x), float(y))
        caminho.closeSubpath()
        return caminho

    @classmethod
    def _b26_pintar_forma_lendaria(cls, p, marco, q, c, principal, clara,
                                   acento, acento_claro, impacto, marco_ativo):
        """Seis silhuetas pós-×50: geometria própria, não só nova cor.

        Tudo permanece dentro de 116×104, no mesmo receptor em (58,51).
        Não há temporizador adicional, leitura do banco nem recurso externo.
        """
        def ponto(raio, angulo):
            return QPointF(58.0 + raio * math.cos(angulo),
                           51.0 + raio * math.sin(angulo))

        def poligono(lados, raio, fase=-math.pi/2, y_scale=0.94):
            return cls._b26r8_path(tuple(
                (58.0 + raio * math.cos(fase+2*math.pi*j/lados),
                 51.0 + raio*y_scale*math.sin(fase+2*math.pi*j/lados))
                for j in range(lados)))

        # Rede externa varia em cada tipo lendário.
        aura = QRadialGradient(c, 47)
        aura.setColorAt(0.0, q(principal, 116 + 28 * impacto))
        aura.setColorAt(0.56, q(principal, 43))
        aura.setColorAt(1.0, q(principal, 0))
        p.setPen(Qt.NoPen)
        p.setBrush(QBrush(aura))
        p.drawEllipse(c, 46, 46)
        p.setBrush(Qt.NoBrush)

        if marco == 65:  # Safira: duas órbitas opostas + 6 satélites
            for rot, rx, ry in ((-33,45,27),(33,45,27)):
                p.save(); p.translate(c); p.rotate(rot)
                p.setPen(QPen(q(acento, 168), 1.35))
                p.drawEllipse(QRectF(-rx,-ry,2*rx,2*ry))
                p.restore()
            p.setPen(QPen(q(clara, 100), 0.9))
            p.drawEllipse(c, 38, 38)
            for j in range(6):
                th = j*math.pi/3
                x = ponto(44, th)
                p.setPen(QPen(q(clara, 209), 1.0))
                p.setBrush(q(principal, 153))
                p.drawEllipse(x, 2.4, 2.4)
        elif marco == 85:  # Ametista: coroa de 9 runas, duas guias cruzadas
            p.setPen(QPen(q(acento, 200), 1.55))
            p.drawPath(poligono(9, 45, -math.pi/2))
            for rot in (-28,28):
                p.save(); p.translate(c); p.rotate(rot)
                p.setPen(QPen(q(clara, 119), 0.9))
                p.drawEllipse(QRectF(-37,-23,74,46))
                p.restore()
            for j in range(9):
                th=-math.pi/2+j*2*math.pi/9
                x=ponto(45,th)
                p.setPen(Qt.NoPen)
                p.setBrush(q(acento_claro, 195))
                p.drawEllipse(x, 1.5 if j%2 else 2.4, 1.5 if j%2 else 2.4)
        elif marco == 110:  # Solaris: coroa solar de 12 raios alternados
            for j in range(12):
                th = j*math.pi/6
                largo = 0.052 if j%2 else 0.08
                forma = cls._b26r8_path(((ponto(33,th-largo).x(), ponto(33,th-largo).y()),
                                          (ponto(48 if j%2==0 else 44,th).x(), ponto(48 if j%2==0 else 44,th).y()),
                                          (ponto(33,th+largo).x(), ponto(33,th+largo).y())))
                p.setPen(QPen(q(acento_claro, 161), 0.65))
                p.setBrush(q(acento if j%2 else principal, 143))
                p.drawPath(forma)
            p.setBrush(Qt.NoBrush)
            p.setPen(QPen(q(clara, 175), 1.3))
            p.drawEllipse(c, 31, 31)
        elif marco == 140:  # Imperial: três polígonos facetados e vértices reais
            for lados, r, alfa, cor in ((8,31,142,principal),(12,40,177,acento),
                                       (16,47,112,clara)):
                p.setPen(QPen(q(cor, alfa), 1.25))
                p.drawPath(poligono(lados,r))
            for j in range(12):
                th=j*math.pi/6
                p.setPen(QPen(q(acento_claro, 96), 0.65))
                p.drawLine(ponto(40,th), ponto(46,th+0.045))
        elif marco == 180:  # Singularidade: lente gravitacional + horizonte
            p.setPen(QPen(q(acento, 187), 1.2))
            p.drawEllipse(c, 45, 33)
            for rot in (-53,53):
                p.save(); p.translate(c); p.rotate(rot)
                p.setPen(QPen(q(principal, 174), 1.15))
                p.drawEllipse(QRectF(-42,-18,84,36))
                p.restore()
            for j in range(8):
                th = j*math.pi/4
                p.setPen(QPen(q(clara, 102), 1.0))
                p.drawLine(ponto(43,th-0.07),ponto(33,th))
            p.setPen(QPen(q(acento_claro, 205), 1.5))
            p.drawEllipse(c, 28, 28)
        else:  # 230: Apoteose — coroa total + 12 prismas convergentes
            for lados,r,alfa in ((12,46,203),(8,37,168),(5,31,133)):
                p.setPen(QPen(q(acento if lados!=8 else clara, alfa), 1.5))
                p.drawPath(poligono(lados,r))
            for j in range(12):
                th=-math.pi/2+j*math.pi/6
                p.setPen(QPen(q(acento_claro, 159), 0.85))
                p.drawLine(ponto(34,th),ponto(47,th))
                estrela = ponto(46,th)
                p.setPen(Qt.NoPen)
                p.setBrush(q(clara, 220 if j%3==0 else 123))
                p.drawEllipse(estrela,2.0 if j%3==0 else 1.2,
                             2.0 if j%3==0 else 1.2)

        # Núcleo independente por forma. O pentagrama original permanece atrás.
        silhuetas = {
            65: ((58,8),(65,19),(73,39),(69,65),(58,93),(47,65),(43,39),(51,19)),
            85: ((58,7),(67,17),(79,35),(74,58),(63,78),(58,94),
                 (53,78),(42,58),(37,35),(49,17)),
            110: ((58,7),(72,26),(81,45),(70,75),(58,94),
                  (46,75),(35,45),(44,26)),
            140: ((58,7),(69,17),(79,39),(76,64),(65,84),(58,94),
                  (51,84),(40,64),(37,39),(47,17)),
            180: ((58,5),(70,24),(76,42),(71,73),(58,95),
                  (45,73),(40,42),(46,24)),
            230: ((58,5),(67,15),(80,32),(79,57),(67,80),(58,95),
                  (49,80),(37,57),(36,32),(49,15)),
        }
        contorno=silhuetas[marco]
        grad=QLinearGradient(38,12,76,91)
        grad.setColorAt(0.0,q(clara,251))
        grad.setColorAt(0.23,q(principal,235))
        grad.setColorAt(0.66,q(principal,180))
        grad.setColorAt(1.0,q(acento,158))
        p.setPen(QPen(q(acento_claro,244),1.7,Qt.SolidLine,Qt.RoundCap,Qt.RoundJoin))
        p.setBrush(QBrush(grad))
        p.drawPath(cls._b26r8_path(contorno))
        top_y=contorno[0][1]
        bottom_y=max(point[1] for point in contorno)
        # Prisma central e duas facetas de brilho. Sem opacidade chapada.
        p.setPen(Qt.NoPen)
        p.setBrush(q(clara,151))
        p.drawPath(cls._b26r8_path(((58,top_y+3),(48,39),(53,69),(58,bottom_y-4))))
        p.setBrush(q(acento,95))
        p.drawPath(cls._b26r8_path(((58,top_y+3),(69,37),(67,69),(58,bottom_y-4))))
        p.setPen(QPen(q(acento_claro,225),0.95))
        p.drawLine(QPointF(58,top_y+4),QPointF(58,bottom_y-4))
        p.setPen(QPen(q(clara,143),0.70))
        p.drawLine(QPointF(47,39),QPointF(69,39))
        p.drawLine(QPointF(52,68),QPointF(67,68))
        # Assinaturas adicionais fortes — distinguíveis em miniatura.
        if marco == 85:
            coroa=cls._b26r8_path(((43,26),(44,12),(53,22),(58,9),
                                    (63,22),(72,12),(73,26),(58,33)))
            p.setPen(QPen(q(clara,214),1.1))
            p.setBrush(q(acento,86))
            p.drawPath(coroa)
        elif marco == 110:
            p.setPen(QPen(q(acento_claro,189),1.1))
            p.setBrush(Qt.NoBrush)
            p.drawEllipse(c,21,21)
        elif marco == 140:
            for lado in (-1,1):
                x=58+lado*26
                gema=cls._b26r8_path(((x,35),(x+lado*6,51),(x,66),
                                       (x-lado*4,51)))
                p.setPen(QPen(q(acento_claro,190),0.9))
                p.setBrush(q(principal,112))
                p.drawPath(gema)
        elif marco == 180:
            p.setPen(QPen(q(acento,210),1.2))
            p.setBrush(Qt.NoBrush)
            p.drawEllipse(c,17,19)
        elif marco == 230:
            coroa=cls._b26r8_path(((40,26),(43,11),(52,20),(58,7),
                                    (64,20),(73,11),(76,26),(58,31)))
            p.setPen(QPen(q(acento_claro,223),1.25))
            p.setBrush(q(acento,100))
            p.drawPath(coroa)

        if marco_ativo and impacto > 0:
            raio=34+10*impacto
            p.setBrush(Qt.NoBrush)
            p.setPen(QPen(q(acento_claro,222*impacto),1.6))
            p.drawEllipse(c,raio,raio)
            for j in range(12 if marco>=180 else 8):
                th=j*2*math.pi/(12 if marco>=180 else 8)
                p.drawLine(ponto(raio+1,th),ponto(raio+4+impacto,th))

    @classmethod
    def _b26r8_pintar_simbolo(cls, p, combo, cinza=False, intensidade=78,
                              impacto=0.0, marco_ativo=False):
        """Mesma geometria no widget principal e nas prévias do painel.

        Coordenadas locais fixas 116 × 104. Sem dados, banco, temporizador ou
        dependência de imagens externas. Centro do feixe permanece em 58,51.
        """
        marco = cls._b26r8_perfil(combo)
        info = cls.info_marco_combo(combo)
        cor = info["atual"]
        if cinza:
            principal = (214, 221, 228)
            clara = (253, 253, 253)
            acento = (223, 223, 223)
            acento_claro = (255, 255, 255)
            base = (124, 134, 145)
        else:
            principal, clara = cor["principal"], cor["clara"]
            acento, acento_claro = cor["acento"], cor["acento_claro"]
            base = cor["base"]
        controle = 0.34 + 0.66 * (max(0, min(100, int(intensidade))) / 100.0)
        ganho = controle * (0.62 + 0.38 * min(1.0, max(0, combo) / 6.0))
        def a(v):
            return max(0, min(255, int(round(v * ganho))))
        def q(rgb, alpha):
            return QColor(rgb[0], rgb[1], rgb[2], a(alpha))
        c = QPointF(58.0, 51.0)
        p.setRenderHint(QPainter.Antialiasing, True)

        # Neblina energética confinada à área do emblema.
        if combo:
            r = 39.0 if marco < 10 else (46.0 if marco < 40 else 48.0)
            nebulosa = QRadialGradient(c, r)
            nebulosa.setColorAt(0.0, q(principal, 53 if marco else 23))
            nebulosa.setColorAt(0.55, q(principal, 23))
            nebulosa.setColorAt(1.0, q(principal, 0))
            p.setPen(Qt.NoPen)
            p.setBrush(QBrush(nebulosa))
            p.drawEllipse(c, r, r)

        # Pentagrama correto: cinco traços, um por acerto, fechando no ×5.
        # A ordem cruza o pentágono em vez de desenhar seu contorno externo.
        for indice, (u, v) in enumerate(cls._ARESTAS):
            x1, y1 = cls._NOS[u]
            x2, y2 = cls._NOS[v]
            ativo = indice < min(5, max(0, int(combo)))
            p.setBrush(Qt.NoBrush)
            if not ativo:
                p.setPen(QPen(q(base, 67), 0.90, Qt.SolidLine, Qt.RoundCap))
                p.drawLine(QPointF(x1, y1), QPointF(x2, y2))
                continue
            estrela_cor = acento if marco == 0 and combo >= 5 else principal
            p.setPen(QPen(q(estrela_cor, 88 + 45*impacto), 6.4,
                          Qt.SolidLine, Qt.RoundCap))
            p.drawLine(QPointF(x1, y1), QPointF(x2, y2))
            p.setPen(QPen(q(estrela_cor, 208), 1.8,
                          Qt.SolidLine, Qt.RoundCap))
            p.drawLine(QPointF(x1, y1), QPointF(x2, y2))
            p.setPen(QPen(q(clara if marco else acento_claro, 153), 0.77,
                          Qt.SolidLine, Qt.RoundCap))
            p.drawLine(QPointF(x1, y1), QPointF(x2, y2))

        for i, (x, y) in enumerate(cls._NOS):
            ativo = combo > i
            core = principal if marco else (acento if combo >= 5 else principal)
            if ativo:
                halo = QRadialGradient(QPointF(x, y), 12.0)
                halo.setColorAt(0.0, q(clara, 195))
                halo.setColorAt(0.35, q(core, 90))
                halo.setColorAt(1.0, q(core, 0))
                p.setBrush(QBrush(halo))
                p.setPen(Qt.NoPen)
                p.drawEllipse(QPointF(x,y), 12.0,12.0)
            diamond = cls._b26r8_path(((x,y-6.0),(x+5.6,y),(x,y+6.0),(x-5.6,y)))
            p.setPen(QPen(q(clara if ativo else base, 225 if ativo else 75),1.25))
            p.setBrush(q(core, 135) if ativo else q(base, 35))
            p.drawPath(diamond)
            if ativo:
                p.setPen(Qt.NoPen)
                p.setBrush(q(clara, 225))
                p.drawEllipse(QPointF(x, y), 1.7, 1.7)

        if combo < 3:
            return

        # Núcleo embrionário para x3-x4. Em ×5 a estrela fecha, ganha dois
        # anéis de conclusão e permanece assim até a transformação em ×10.
        if not marco:
            p.setBrush(Qt.NoBrush)
            p.setPen(QPen(q(principal, 115), 1.15))
            p.drawEllipse(c, 13.0, 13.0)
            nucleo = QRadialGradient(c, 13.0)
            nucleo.setColorAt(0.0, q(clara, 213))
            nucleo.setColorAt(0.50, q(principal, 72))
            nucleo.setColorAt(1.0, q(principal, 0))
            p.setBrush(QBrush(nucleo))
            p.setPen(Qt.NoPen)
            p.drawEllipse(c, 13.0, 13.0)
            if combo >= 5:
                p.setBrush(Qt.NoBrush)
                p.setPen(QPen(q(acento, 172 + 38*impacto), 1.55))
                p.drawEllipse(c, 25.0, 25.0)
                p.setPen(QPen(q(acento_claro, 113), 0.85))
                p.drawEllipse(c, 33.0, 33.0)
                for j in range(5):
                    th = 2*math.pi*j/5.0-math.pi/2.0
                    pt = QPointF(58+34*math.cos(th),51+34*math.sin(th))
                    p.setPen(Qt.NoPen)
                    p.setBrush(q(acento_claro, 163))
                    p.drawEllipse(pt,1.6,1.6)
            if combo >= 7:
                p.setBrush(Qt.NoBrush)
                p.setPen(QPen(q(acento, 95+45*(combo-6)/3.0), 0.9))
                p.drawEllipse(c, 38.0, 38.0)
            return

        if marco >= 65:
            cls._b26_pintar_forma_lendaria(
                p, marco, q, c, principal, clara, acento, acento_claro,
                impacto, marco_ativo)
            return

        # Formas clássicas ×10–×50 mantêm geometria homologada.
        # À medida que um marco chega, a forma é redesenhada do zero.
        energia = (1.0 + (0.22 if marco == 50 else 0.10) * impacto)
        aura = QRadialGradient(c, 40.0)
        aura.setColorAt(0.0, q(principal, (72+50*impacto)*energia))
        aura.setColorAt(0.60, q(principal, 31*energia))
        aura.setColorAt(1.0, q(principal, 0))
        p.setPen(Qt.NoPen)
        p.setBrush(QBrush(aura))
        p.drawEllipse(c, 39.0, 39.0)

        # Anéis externos distintos por estágio: não são apenas outra cor.
        p.setBrush(Qt.NoBrush)
        if marco == 10:
            for raio, opacity, esp in ((33.0,166,1.15),(42.0,111,0.85)):
                p.setPen(QPen(q(acento,opacity+22*impacto),esp))
                p.drawEllipse(c,raio,raio)
            for j in range(5):
                th=j*2*math.pi/5.0
                p.setPen(Qt.NoPen)
                p.setBrush(q(acento_claro,190))
                p.drawEllipse(QPointF(58+42*math.cos(th),51+42*math.sin(th)),1.4,1.4)
        elif marco == 20:
            p.setPen(QPen(q(principal,201+24*impacto),1.75))
            p.drawEllipse(c,38.0,41.0)
            p.setPen(QPen(q(acento_claro,135),0.9))
            p.drawEllipse(c,44.0,38.0)
            for j in range(5):
                th=2*math.pi*j/5.0
                x=58+43*math.cos(th)
                y=51+39*math.sin(th)
                p.setPen(QPen(q(clara,190),1.0))
                p.setBrush(q(principal,132))
                p.drawEllipse(QPointF(x,y),2.2,3.2)
            for side in (-1,1):
                caminho=QPainterPath(QPointF(58+side*24,36))
                caminho.cubicTo(58+side*43,30,58+side*49,56,58+side*33,72)
                p.setPen(QPen(q(acento,143),1.15))
                p.setBrush(Qt.NoBrush)
                p.drawPath(caminho)
        elif marco == 30:
            for angulo,rx,ry in ((-32,45,27),(32,45,27)):
                p.save()
                p.translate(c)
                p.rotate(angulo)
                p.setPen(QPen(q(principal,145),1.3))
                p.drawEllipse(QRectF(-rx,-ry,2*rx,2*ry))
                p.restore()
            p.setPen(QPen(q(acento_claro,153),0.95))
            p.drawEllipse(c,43.0,43.0)
            for j in range(8):
                th=j*math.pi/4.0
                x=58+45*math.cos(th)
                y=51+40*math.sin(th)
                p.setPen(Qt.NoPen)
                p.setBrush(q(clara,215 if j%2 == 0 else 116))
                p.drawEllipse(QPointF(x,y),1.6 if j%2 else 2.4,1.6 if j%2 else 2.4)
        elif marco == 40:
            escudo=[]
            for j in range(8):
                th=2*math.pi*j/8.0-math.pi/8.0
                escudo.append((58+43*math.cos(th),51+43*math.sin(th)))
            p.setPen(QPen(q(acento,185+33*impacto),1.65))
            p.setBrush(Qt.NoBrush)
            p.drawPath(cls._b26r8_path(escudo))
            p.setPen(QPen(q(principal,122),0.95))
            p.drawEllipse(c,32.0,32.0)
            for j in range(8):
                th=j*math.pi/4.0
                p1=QPointF(58+43*math.cos(th),51+43*math.sin(th))
                p2=QPointF(58+47*math.cos(th),51+47*math.sin(th))
                p.setPen(QPen(q(acento_claro,175),1.2,Qt.SolidLine,Qt.RoundCap))
                p.drawLine(p1,p2)
        else:  # marco 50: prisma de elite com dupla coroa facetada.
            for rx,ry,opacity in ((31,34,198),(43,44,166)):
                octa=[]
                for j in range(8):
                    th=j*math.pi/4.0-math.pi/8.0
                    octa.append((58+rx*math.cos(th),51+ry*math.sin(th)))
                p.setPen(QPen(q(acento if rx<40 else principal,opacity),1.55))
                p.setBrush(Qt.NoBrush)
                p.drawPath(cls._b26r8_path(octa))
            p.setPen(QPen(q(clara,196),0.8))
            p.drawEllipse(c,46.0,46.0)
            for j in range(8):
                th=j*math.pi/4.0
                x,y=58+45*math.cos(th),51+45*math.sin(th)
                prisma=cls._b26r8_path(((x,y-3.4),(x+3.2,y),
                                         (x,y+3.4),(x-3.2,y)))
                p.setPen(QPen(q(clara,227),0.95))
                p.setBrush(q(principal if j%2 else acento,175))
                p.drawPath(prisma)

        # Cristal dominante: cinco SILHUETAS, com facetas e cortes distintos.
        cristais = {
            10: ((58,13),(69,37),(68,62),(58,87),(48,62),(47,37)),
            20: ((58,9),(67,29),(75,43),(65,74),(58,91),(48,74),(41,43),(49,29)),
            30: ((58,8),(72,33),(76,54),(66,79),(58,91),(50,79),(40,54),(44,33)),
            40: ((58,9),(72,23),(82,51),(71,76),(58,91),(45,76),(34,51),(44,23)),
            50: ((58,7),(70,22),(79,40),(76,63),(66,78),(58,92),
                 (50,78),(40,63),(37,40),(46,22)),
        }
        forma = cristais[marco]
        # Facetado com lado esquerdo frio e lado direito mais profundo.
        corpo = cls._b26r8_path(forma)
        degrad = QLinearGradient(39.0,18.0,79.0,88.0)
        degrad.setColorAt(0.0,q(clara,242))
        degrad.setColorAt(0.24,q(principal,220))
        degrad.setColorAt(0.64,q(principal,173))
        degrad.setColorAt(1.0,q(acento,152))
        p.setBrush(QBrush(degrad))
        p.setPen(QPen(q(acento_claro if marco in (10,50) else clara,228),1.6,
                      Qt.SolidLine,Qt.RoundCap,Qt.RoundJoin))
        p.drawPath(corpo)

        # Reflexo longitudinal e faces internas: brilho cristalino real.
        topo=forma[0]
        fundo=forma[len(forma)//2]
        face_esquerda=cls._b26r8_path(((58,topo[1]+3),
                                      (48,40),(54,65),(58,fundo[1]-3)))
        p.setPen(Qt.NoPen)
        p.setBrush(q(clara,142 if marco!=40 else 86))
        p.drawPath(face_esquerda)
        face_direita=cls._b26r8_path(((58,topo[1]+3),
                                     (70,39),(67,65),(58,fundo[1]-3)))
        p.setBrush(q(acento,68 if marco<40 else 101))
        p.drawPath(face_direita)
        p.setPen(QPen(q(acento_claro,206),0.9))
        p.drawLine(QPointF(58,topo[1]+4),QPointF(58,fundo[1]-4))
        p.setPen(QPen(q(clara,171),0.75))
        p.drawLine(QPointF(48,40),QPointF(68,40))
        p.drawLine(QPointF(54,65),QPointF(65,65))

        if marco == 20:
            # Cristais-satélite botânicos: diferenciadores do estágio verde.
            for lado in (-1,1):
                x=58+lado*30
                folha=cls._b26r8_path(((x,32),(x+lado*7,49),
                                       (x,66),(x-lado*2,46)))
                p.setPen(QPen(q(clara,181),0.75))
                p.setBrush(q(principal,122))
                p.drawPath(folha)
        elif marco == 30:
            # Três feixes curvos de uma estrutura cósmica dimensional.
            for sx in (-1,0,1):
                arco=QPainterPath(QPointF(58+sx*19,18))
                arco.cubicTo(58+sx*28,32,58+sx*27,74,58+sx*16,82)
                p.setPen(QPen(q(principal,88),1.0))
                p.setBrush(Qt.NoBrush)
                p.drawPath(arco)
        elif marco == 40:
            # Lanças rúnicas laterais e triângulos de potência.
            for lado in (-1,1):
                x=58+lado*33
                runa=cls._b26r8_path(((x,37),(x+lado*8,50),(x,63),
                                      (x-lado*3,50)))
                p.setPen(QPen(q(acento_claro,170),0.85))
                p.setBrush(q(principal,128))
                p.drawPath(runa)
        elif marco == 50:
            # Coroa prismática com gemas brancas superiores.
            coroa=cls._b26r8_path(((43,25),(44,14),(52,23),(58,12),
                                   (64,23),(72,14),(73,25),(58,33)))
            p.setPen(QPen(q(clara,218),1.05))
            p.setBrush(q(acento_claro,98))
            p.drawPath(coroa)
            for lado in (-1,1):
                x=58+lado*27
                gema=cls._b26r8_path(((x,43),(x+lado*4,50),
                                      (x,57),(x-lado*4,50)))
                p.setBrush(q(clara,202))
                p.drawPath(gema)

        # Sinal breve de transformação, limitado à chegada de energia.
        if marco_ativo and impacto > 0:
            raio = 32.0 + 11.0 * impacto
            p.setBrush(Qt.NoBrush)
            p.setPen(QPen(q(acento_claro,215*impacto),1.5,
                          Qt.SolidLine,Qt.RoundCap))
            p.drawEllipse(c,raio,raio)
            for j in range(6 if marco < 40 else 8):
                th=2*math.pi*j/(6 if marco < 40 else 8)
                r1,r2=raio+2,raio+6+2*impacto
                p.drawLine(QPointF(58+r1*math.cos(th),51+r1*math.sin(th)),
                           QPointF(58+r2*math.cos(th),51+r2*math.sin(th)))

    def paintEvent(self, evento):
        if self.width() < 138 or self.height() < 68:
            return
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing, True)
        painter.setRenderHint(QPainter.TextAntialiasing, True)
        painter.scale(self.width()/265.0, self.height()/112.0)
        nivel = min(5, max(0,self._combo))
        info = self.info_marco_combo(self._combo)
        mon = self._monocromatico
        if mon:
            cor = (229,229,229)
            clara = (252,252,252)
            base = (150,164,174)
        else:
            cor = info["atual"]["principal"]
            clara = info["atual"]["clara"]
            base = info["atual"]["base"]
        brilho = 0.42+0.58*(self._intensidade/100.0)
        def a(v):
            return max(0,min(255,round(v*brilho)))
        t = self._b26_fase_vibracao
        impacto = math.sin(math.pi*t)**2 if t < 1.0 else 0.0
        envoltoria = max(0.0,1-t)*min(1.0,t*11.0) if t < 1.0 else 0.0

        # B26 R8 R10: fundo realmente transparente na Constelação.
        # A vinheta semitransparente anterior desenhava uma caixa escura
        # 265×112 sobre a paisagem. O widget já possui os atributos Qt
        # WA_TranslucentBackground/WA_NoSystemBackground; nenhum preenchimento
        # é necessário. Os cristais, chamas e textos continuam desenhados.

        # B26 R8 R3: chama ORBITAL EM MOVIMENTO, atrás do cristal/estrela.
        # Sem renderização/PNG estático, não afeta o contador à direita.
        if self._combo >= 10:
            self._b26r9_pintar_chamas(
                painter, self._combo, mon, self._intensidade,
                self._b26r9_fase_chama)

        painter.save()
        painter.translate(1.25*math.sin(t*5*math.pi)*envoltoria,
                          0.65*math.sin(t*4*math.pi)*envoltoria)
        self._b26r8_pintar_simbolo(painter,self._combo,mon,
                                   self._intensidade,impacto,
                                   self._b26_marco_ativo)
        # Reação de recepção existente, sem realocar destino do feixe.
        if impacto and nivel:
            rgb = (232,232,232) if mon else (
                (247,202,112) if self._b26_vibracao_dourada else cor)
            painter.setPen(QPen(QColor(*rgb,a(156*impacto)),1.15))
            painter.setBrush(Qt.NoBrush)
            painter.drawEllipse(QPointF(58,51),15.5+12*t,15.5+12*t)
        painter.restore()

        # R8 R8: HUD com coluna informativa desacoplada do emblema.
        # Campo de 265 x 112 preserva a estrela de 116 x 104 e dá respiro
        # ao texto SEQUÊNCIA, combo, subtítulo e cinco indicadores.
        font = QFont("Bahnschrift",9,QFont.DemiBold)
        font.setLetterSpacing(QFont.AbsoluteSpacing,1.0)
        painter.setFont(font)
        painter.setPen(QColor(213,231,241,225) if not mon
                       else QColor(232,232,232,218))
        painter.drawText(QRectF(150,19,115,21),
                         Qt.AlignLeft|Qt.AlignVCenter,"COMBO")
        font=QFont("Bahnschrift",25,QFont.DemiBold)
        painter.setFont(font)
        painter.setPen(QColor(*cor,a(247) if nivel else 174))
        painter.save()
        fator=self._b26_pulso_escala(t,self._b26_marco_ativo)
        painter.translate(181.0,62.0)
        painter.scale(fator,fator)
        painter.translate(-181.0,-62.0)
        painter.drawText(QRectF(149,40,116,42),
                         Qt.AlignLeft|Qt.AlignVCenter,f"×{self._combo}")
        painter.restore()

        # Exatamente cinco segmentos para os cinco traços do pentagrama.
        for i in range(5):
            x=150+i*18.0
            ativo=i<nivel
            painter.setPen(Qt.NoPen)
            painter.setBrush(QColor(*cor,a(216)) if ativo
                             else QColor(*base,68))
            painter.drawRoundedRect(QRectF(x,93,14.0,3.0),1.5,1.5)
            if ativo:
                painter.setBrush(QColor(*clara,a(108)))
                painter.drawRoundedRect(QRectF(x,93,14,1),0.5,0.5)

        font_sub=QFont("Bahnschrift",7,QFont.DemiBold)
        font_sub.setLetterSpacing(QFont.AbsoluteSpacing,0.4)
        painter.setFont(font_sub)
        perfil=self._b26r8_perfil(self._combo)
        subtitulos={0:"FORMAÇÃO" if self._combo<5 else "ESTRELA COMPLETA",
                    10:"BASE PREMIUM",20:"ESMERALDA",30:"CÓSMICA",
                    40:"RUBI",50:"FORMA SUPREMA",65:"SAFIRA ASTRAL",
                    85:"AMETISTA",110:"SOLARIS RUBRA",140:"PRISMA IMPERIAL",
                    180:"SINGULARIDADE",230:"APOTEOSE VIGHNA"}
        painter.setPen(QColor(*clara,a(190) if nivel else 115))
        painter.drawText(QRectF(149,77,116,12),
                         Qt.AlignLeft|Qt.AlignVCenter,subtitulos[perfil])
        painter.end()

class _HistoricoMarcosConstelacao:
    """Conquistas globais entre baterias; independentes do banco de estudo.

    Cada marco e incrementado exclusivamente quando uma resposta confirmada
    faz a sequencia atingir exatamente o alvo. A UI nunca altera contadores.
    A primeira contagem comeca nesta atualizacao; nao inventa historico antigo.
    """

    MARCOS = (5, 10, 20, 30, 40, 50, 65, 85, 110, 140, 180, 230)
    ORGANIZACAO = "VighnaStudy"
    APLICACAO = "ConstelacaoSinaptica"

    @classmethod
    def _config(cls):
        return QSettings(cls.ORGANIZACAO, cls.APLICACAO)

    @staticmethod
    def _numero(valor):
        try:
            return max(0, int(valor))
        except (TypeError, ValueError, OverflowError):
            return 0

    @classmethod
    def consultar(cls):
        config = cls._config()
        config.sync()
        return {marco: cls._numero(config.value(f"marco_{marco}", 0))
                for marco in cls.MARCOS}

    @classmethod
    def consultar_recorde(cls):
        try:
            config = cls._config()
            config.sync()
            return cls._numero(config.value("combo_recorde_v2", 0))
        except Exception:
            return 0

    @classmethod
    def registrar_recorde(cls, combo):
        """Só aumenta o recorde desde a ativação da progressão expandida."""
        try:
            valor = cls._numero(combo)
            config = cls._config()
            config.sync()
            anterior = cls._numero(config.value("combo_recorde_v2", 0))
            if valor > anterior:
                config.setValue("combo_recorde_v2", valor)
                config.sync()
                return True
        except Exception as erro:
            print(f"Constelação Sináptica: falha ao gravar recorde: {erro}")
        return False

    @classmethod
    def registrar_marco(cls, combo, status):
        """Uma gravação no momento exato do marco, nunca ao renderizar.

        Nao registra respostas incorretas, pulos, nem combos intermediarios.
        Se houver falha no armazenamento, a bateria permanece utilizavel.
        """
        if status != "Correta":
            return False
        try:
            alvo = int(combo)
        except (TypeError, ValueError, OverflowError):
            return False
        if alvo not in cls.MARCOS:
            return False
        try:
            config = cls._config()
            config.sync()
            chave = f"marco_{alvo}"
            acumulado = cls._numero(config.value(chave, 0))
            config.setValue(chave, acumulado + 1)
            config.sync()
            return True
        except Exception as erro:
            print(f"Constelação Sináptica: falha ao gravar marco ×{alvo}: {erro}")
            return False


class _DialogoProgressaoConstelacaoB26R4(QDialog):
    """Catálogo dividido em seis clássicas e seis lendárias.

    Abas mantêm miniaturas em tamanho legível a 1366×768; os contadores
    permanentes são consultados uma única vez e nunca alterados por desenho.
    """

    def __init__(self, combo_atual, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Progressão da Constelação Sináptica")
        self.setModal(True)
        self.resize(1030, 650)
        self.setMinimumSize(780, 560)
        self.setStyleSheet("""
            QDialog { background-color: #06101F; color: #E8F7FF; }
            QScrollArea { background: transparent; border: none; }
            QFrame#b26r8MarcoCard { background: #0B2032;
                border: 1px solid rgba(88,148,185,0.56); border-radius: 11px; }
            QTabWidget::pane { background: #07182A;
                border: 1px solid #27506D; border-radius: 10px; }
            QTabBar::tab { background: #0B2539; color: #AECBDD;
                padding: 8px 18px; margin-right: 4px;
                border: 1px solid #2D5A76; border-radius: 7px; }
            QTabBar::tab:selected { background: #114160; color: #F2FCFF;
                border-color: #43C6E9; font-weight: bold; }
            QTabBar::tab:focus { border-color: #F2C574; }
            QLabel { color: #E8F7FF; }
        """)

        info = _ConstelacaoSinapticaB26.info_marco_combo(combo_atual)
        combo = info["combo"]
        atual = info["atual"]
        proximo = info["proximo"]
        layout = QVBoxLayout(self)
        layout.setContentsMargins(18, 16, 18, 16)
        layout.setSpacing(10)

        titulo = QLabel("Constelação Sináptica — Doze Formas")
        titulo.setStyleSheet("font-size: 18px; font-weight: 700; color: #E9F9FF;")
        layout.addWidget(titulo)
        if combo < 5:
            resumo_fase = f"Formação: {combo}/5 traços do pentagrama."
        elif combo < 10:
            resumo_fase = "Estrela Completa formada; premium ativa no ×10."
        else:
            resumo_fase = (f"Forma ativa: <b>{atual['titulo']}</b> "
                           f"— {atual['subtitulo']}.")
        if proximo is None:
            proximo_texto = "Forma final ×230 alcançada: Apoteose Vighna."
        else:
            faltam = max(0, proximo["alvo"]-combo)
            proximo_texto = (f"Próximo: <b>×{proximo['alvo']}</b> "
                             f"— {proximo['titulo']} (faltam {faltam} pontos de combo).")
        try:
            totais = _HistoricoMarcosConstelacao.consultar()
            recorde = _HistoricoMarcosConstelacao.consultar_recorde()
        except Exception as erro:
            print(f"Constelação Sináptica: contadores indisponíveis: {erro}")
            totais = {}
            recorde = 0

        resumo = QLabel(
            f"<b>Combo atual: ×{combo}</b>  ·  Recorde desde R2: "
            f"<b>×{recorde}</b><br>{resumo_fase}<br>{proximo_texto}")
        resumo.setWordWrap(True)
        resumo.setTextFormat(Qt.RichText)
        resumo.setStyleSheet(
            "QLabel {background: #0B2032; border: 1px solid #316081;"
            " border-radius: 10px; padding: 11px; font-size: 13px;}")
        layout.addWidget(resumo)

        chamada = QLabel(
            "Clássicas ×5–×50 · Lendárias ×65–×230. "
            "Cada contador acumula as vezes em que o marco foi atingido, "
            "em todas as baterias desde sua ativação.")
        chamada.setWordWrap(True)
        chamada.setStyleSheet("color: #9FCDE3; font-size: 12px;")
        layout.addWidget(chamada)

        abas = QTabWidget()
        abas.setDocumentMode(True)
        abas.setAccessibleName("Catálogo de formas da Constelação Sináptica")
        self.abas_formas = abas
        todos = _ConstelacaoSinapticaB26._MARCOS_CROMATICOS
        for rotulo, itens in (("Clássicas · 6 formas", todos[:6]),
                              ("Lendárias · 6 formas", todos[6:])):
            faixa = QScrollArea()
            faixa.setWidgetResizable(False)
            faixa.setHorizontalScrollBarPolicy(Qt.ScrollBarAsNeeded)
            faixa.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
            faixa.setMinimumHeight(260)
            conteudo = QWidget()
            linha = QHBoxLayout(conteudo)
            linha.setContentsMargins(3, 3, 3, 3)
            linha.setSpacing(7)
            for item in itens:
                marco = item["alvo"]
                ativo = combo >= marco
                historico = int(totais.get(marco, 0))
                atual_flag = atual.get("alvo") == marco and ativo
                quadro = QFrame()
                quadro.setObjectName("b26r8MarcoCard")
                quadro.setFixedSize(154, 240)
                if atual_flag:
                    quadro.setStyleSheet(
                        "QFrame#b26r8MarcoCard {background: #10334A; "
                        "border: 2px solid #4CD5EE; border-radius: 11px;}")
                bloco = QVBoxLayout(quadro)
                bloco.setContentsMargins(6, 8, 6, 8)
                bloco.setSpacing(4)
                titulo_marco = QLabel(f"COMBO ×{marco}")
                titulo_marco.setAlignment(Qt.AlignCenter)
                titulo_marco.setStyleSheet(
                    "font-weight: bold; font-size: 14px; color: #EBC67A;")
                bloco.addWidget(titulo_marco)
                visao = QLabel()
                visao.setAlignment(Qt.AlignCenter)
                visao.setFixedHeight(120)
                pixmap = QPixmap(142, 120)
                pixmap.fill(Qt.transparent)
                pintor = QPainter(pixmap)
                pintor.setRenderHint(QPainter.Antialiasing, True)
                pintor.translate(71.0-58.0*1.08,60.0-51.0*1.08)
                pintor.scale(1.08,1.08)
                _ConstelacaoSinapticaB26._b26r8_pintar_simbolo(
                    pintor,marco,False,100,0.0,False)
                pintor.end()
                visao.setPixmap(pixmap)
                bloco.addWidget(visao)
                nome = QLabel(item["titulo"].upper())
                nome.setAlignment(Qt.AlignCenter)
                nome.setWordWrap(True)
                nome.setFixedHeight(30)
                nome.setStyleSheet(
                    "font-size: 10px; font-weight: bold; color: #DCEEF7;")
                bloco.addWidget(nome)
                contador = QLabel(f"ATINGIDA {historico} " +
                                 ("VEZ" if historico == 1 else "VEZES"))
                contador.setAlignment(Qt.AlignCenter)
                contador.setToolTip(
                    "Total permanente entre todas as baterias desde a ativação "
                    "deste marco; reatingir após uma penalização conta novamente")
                contador.setStyleSheet(
                    "font-size: 10px; font-weight: 700; color: #EBC67A;")
                bloco.addWidget(contador)
                estado = QLabel("ATUAL" if atual_flag else
                               ("NESTA BATERIA" if ativo else
                                ("JÁ ATINGIDA" if historico else "A CONQUISTAR")))
                estado.setAlignment(Qt.AlignCenter)
                estado.setStyleSheet(
                    "font-size: 9px; color: " +
                    ("#F7CD7B" if atual_flag else
                     ("#89E3B8" if ativo else "#8FA5B5")) + ";")
                bloco.addWidget(estado)
                linha.addWidget(quadro)
            conteudo.setFixedSize(6*154+5*7+8, 248)
            faixa.setWidget(conteudo)
            abas.addTab(faixa,rotulo)
        abas.setCurrentIndex(1 if combo >= 65 else 0)
        layout.addWidget(abas, 1)

        regras = QLabel(
            "Acerto: +1 · Erro: −6 (mínimo 0) · Questão pulada: zera o combo. "
            "Pausa e consulta do catálogo não alteram pontos. "
            "Os marcos são registrados ao serem alcançados; "
            "simulados sem feedback imediato não contam.")
        regras.setWordWrap(True)
        regras.setStyleSheet("font-size: 11px; color: #BBD6E4; padding: 5px;")
        layout.addWidget(regras)
        botoes = QDialogButtonBox(QDialogButtonBox.Close)
        botoes.rejected.connect(self.reject)
        botoes.accepted.connect(self.accept)
        layout.addWidget(botoes)


class _PulsoSinapticoB22(QWidget):
    """B26-D: transferencia neural direta da alternativa para a constelacao.

    Preserva os microcircuitos, cinco fragmentos e tres filamentos da B25 R1,
    e o mapeamento global corrigido na B23. Nao toca no contador Acertos.
    Camada Qt passiva, sem timers permanentes ou captura de eventos.
    """

    def __init__(self, parent):
        super().__init__(parent)
        self.setObjectName("questionSynapseOverlayB22")
        self.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        self.setAttribute(Qt.WA_TranslucentBackground, True)
        self.setAttribute(Qt.WA_NoSystemBackground, True)
        self.setFocusPolicy(Qt.NoFocus)
        self._origem = None
        self._destino = None
        self._progresso = 0.0
        self._intensidade = 0
        self._dourado = False
        self._monocromatico = False
        self.hide()

    def _mapear_widget_rect(self, widget):
        if widget is None:
            return QRectF()
        topo = self.mapFromGlobal(widget.mapToGlobal(QPoint(0, 0)))
        final = self.mapFromGlobal(widget.mapToGlobal(
            QPoint(max(0, widget.width()-1), max(0, widget.height()-1))))
        return QRectF(float(topo.x()), float(topo.y()),
                      float(final.x()-topo.x()+1), float(final.y()-topo.y()+1))

    def _mapear_widget_centro(self, widget):
        ponto = self.mapFromGlobal(widget.mapToGlobal(
            QPoint(widget.width()//2, widget.height()//2)))
        return QPointF(float(ponto.x()), float(ponto.y()))

    @staticmethod
    def _b25r1_janela(t, inicio, subida, descida, fim):
        """Janela suave, sem cintilacao ou pulsos periodicos."""
        if t <= inicio or t >= fim:
            return 0.0
        if t < subida:
            f = max(0.0, min(1.0, (t-inicio) / max(0.001, subida-inicio)))
            return f*f*(3.0-2.0*f)
        if t <= descida:
            return 1.0
        f = max(0.0, min(1.0, (fim-t) / max(0.001, fim-descida)))
        return f*f*(3.0-2.0*f)

    def _b26_receptor_constelacao(self):
        """Mapeia o receptor REAL da constelacao ao overlay da bateria.

        Qt.mapToGlobal/mapFromGlobal preserva o alinhamento validado na B23,
        mesmo com redimensionamento, diferentes DPI ou posicao da janela.
        """
        destino = self._destino
        if destino is None or not destino.isVisible():
            return None
        ponto_local = destino.ponto_receptor()
        global_ponto = destino.mapToGlobal(ponto_local)
        local = self.mapFromGlobal(global_ponto)
        return QPointF(float(local.x()), float(local.y()))

    def definir_monocromatico(self, ativo):
        self._monocromatico = bool(ativo)
        if self.isVisible():
            self.update()

    @staticmethod
    def _b25r1_caminho(origem, destino, trilho_x, desvio=0.0):
        """Desloca a energia pela margem esquerda, fora das frases.

        Tres canais divergem na origem e convergem no ponto receptor
        da Constelacao Sinaptica, independentemente da janela.
        """
        ox, oy = origem.x(), origem.y()
        tx, ty = destino.x(), destino.y()
        # A rota sempre comeca dentro da zona A-E e foge para a esquerda.
        y_teto = ty + 34.0
        raio_entrada = min(24.0, max(10.0, (oy-y_teto)*0.13))
        caminho = QPainterPath(origem)
        caminho.cubicTo(QPointF(ox-24, oy-3+desvio),
                        QPointF(trilho_x+10, oy-9+desvio),
                        QPointF(trilho_x, oy-raio_entrada))
        caminho.cubicTo(QPointF(trilho_x-3+desvio*0.3, oy-70),
                        QPointF(trilho_x+3+desvio*0.2, y_teto+85),
                        QPointF(trilho_x, y_teto))
        caminho.cubicTo(QPointF(trilho_x+34, ty+10+desvio*0.3),
                        QPointF(tx-70, ty+19+desvio*0.2),
                        destino)
        return caminho

    def configurar(self, origem, destino, intensidade, dourado=False,
                   monocromatico=False):
        self._origem = origem
        self._destino = destino  # _ConstelacaoSinapticaB26, jamais stat_acertos
        self._intensidade = max(0, min(100, int(intensidade)))
        self._dourado = bool(dourado)
        self._monocromatico = bool(monocromatico)
        self._progresso = 0.0
        self.setGeometry(self.parentWidget().rect())
        if self._intensidade and origem is not None and destino is not None:
            self.raise_()
            self.show()
            self.update()
        else:
            self.hide()

    def progresso(self, valor):
        self._progresso = max(0.0, min(1.0, float(valor)))
        if self.isVisible():
            self.update()

    def limpar(self):
        self.hide()
        self._origem = None
        self._destino = None
        self._progresso = 0.0

    def paintEvent(self, evento):
        if self._origem is None or self._destino is None or self._intensidade <= 0:
            return
        try:
            if not self._origem.isVisible() or not self._destino.isVisible():
                return
            ret = self._mapear_widget_rect(self._origem)
            alvo_ret = self._mapear_widget_rect(self._destino)
            alvo_centro = self._b26_receptor_constelacao()
        except (RuntimeError, AttributeError):
            return
        if (ret.width() < 85 or ret.height() < 25 or alvo_ret.isNull()
                or alvo_centro is None
                or not ret.intersects(QRectF(self.rect()))
                or not alvo_ret.intersects(QRectF(self.rect()))):
            return

        t = self._progresso
        escala = 0.26 + 0.74*(self._intensidade/100.0)
        ciano = (192, 208, 216) if self._monocromatico else (84, 219, 239)
        ciano_claro = (242, 245, 247) if self._monocromatico else (185, 249, 255)
        ouro = (215, 215, 215) if self._monocromatico else (247, 202, 112)
        ouro_claro = (242, 242, 242) if self._monocromatico else (255, 234, 180)
        acento = ouro if self._dourado else ciano
        # Tons da fonte e dos filamentos passam juntos ao dourado no combo >= 5.
        fonte_cor = acento if self._dourado else ciano
        trilha_clara = ouro_claro if self._dourado else ciano_claro
        inicio = self._b25r1_janela(t, 0.0, 0.09, 0.30, 0.46)
        fragmentos = self._b25r1_janela(t, 0.12, 0.20, 0.31, 0.43)
        voo = self._b25r1_janela(t, 0.33, 0.39, 0.76, 0.85)
        absorcao = self._b25r1_janela(t, 0.76, 0.82, 0.91, 1.0)
        if not any((inicio, fragmentos, voo, absorcao)):
            return

        r = ret.adjusted(2.2, 2.2, -2.2, -2.2)
        fonte = QPointF(r.left()+min(59.0, max(43.0, r.width()*0.12)),
                        r.center().y())
        destino = alvo_centro  # centro geometrico da constelacao, nao do widget
        trilho = max(7.0, r.left()-8.0)
        pintor = QPainter(self)
        pintor.setRenderHint(QPainter.Antialiasing, True)
        recorte = QPainterPath()
        recorte.addRoundedRect(r, 8.0, 8.0)

        # 1. Ativacao do cartao, com quatro microcircuitos concentrados na
        # faixa da letra; nenhuma linha atravessa o texto das alternativas.
        potencia = max(inicio, fragmentos*0.80, voo*0.28)
        if potencia:
            pintor.save()
            pintor.setClipPath(recorte)
            degrad = QLinearGradient(r.left(), r.top(), r.left()+130.0, r.top())
            degrad.setColorAt(0.0, QColor(*fonte_cor, round(50*escala*potencia)))
            degrad.setColorAt(0.60, QColor(*fonte_cor, round(16*escala*potencia)))
            degrad.setColorAt(1.0, QColor(*fonte_cor, 0))
            pintor.setPen(Qt.NoPen)
            pintor.setBrush(QBrush(degrad))
            pintor.drawPath(recorte)
            pintor.restore()
            pintor.setPen(QPen(QColor(*fonte_cor, round(188*escala*potencia)),
                                1.5 + escala*0.85))
            pintor.setBrush(Qt.NoBrush)
            pintor.drawRoundedRect(r, 8.0, 8.0)
            pintor.save()
            pintor.setClipPath(recorte)
            # Quatro circuitos curtos, apenas na regiao da letra A-E.
            for k, sinal in enumerate((-1, 1, -1, 1)):
                y = fonte.y() + sinal*(4.0 + (k//2)*4.3)
                ponto_a = QPointF(r.left()+7.5+(k%2)*4.5, y)
                ponto_b = QPointF(fonte.x()-18.0, y)
                ponto_c = QPointF(fonte.x()-10.0, fonte.y()+sinal*3.0)
                trilha_curta = QPainterPath(ponto_a)
                trilha_curta.lineTo(ponto_b)
                trilha_curta.lineTo(ponto_c)
                cor = (ouro_claro if k == 3 else ouro) if self._dourado else (ouro if k == 3 else ciano)
                pintor.setPen(QPen(QColor(*cor, round(145*escala*potencia)), 1.05))
                pintor.setBrush(Qt.NoBrush)
                pintor.drawPath(trilha_curta)
                pintor.setPen(Qt.NoPen)
                pintor.setBrush(QColor(*cor, round(178*escala*potencia)))
                pintor.drawEllipse(ponto_a, 1.55, 1.55)
            pintor.restore()
            halo = QRadialGradient(fonte, 22.0)
            halo.setColorAt(0.0, QColor(*acento, round(134*escala*potencia)))
            halo.setColorAt(0.50, QColor(*acento, round(36*escala*potencia)))
            halo.setColorAt(1.0, QColor(*acento, 0))
            pintor.setPen(Qt.NoPen)
            pintor.setBrush(QBrush(halo))
            pintor.drawEllipse(fonte, 22.0, 22.0)
            pintor.setBrush(Qt.NoBrush)
            pintor.setPen(QPen(QColor(*acento, round(172*escala*potencia)), 1.35))
            pintor.drawEllipse(fonte, 10.0, 10.0)

        # 2. Cinco fragmentos deterministas sao atraidos para o mesmo
        # nucleo. Permanecem perto da letra, com luminosidade moderada.
        if fragmentos:
            avancar = max(0.0, min(1.0, (t-0.12)/0.31))
            avancar = avancar*avancar*(3.0-2.0*avancar)
            deslocamentos = ((-25., -12.), (-19., 11.), (-9., -16.),
                             (18., -10.), (25., 12.))
            pintor.setPen(Qt.NoPen)
            for k, (dx,dy) in enumerate(deslocamentos):
                pos = QPointF(fonte.x()+dx*(1.0-avancar),
                              fonte.y()+dy*(1.0-avancar))
                cor = (ouro if k in (1,4) else ouro_claro) if self._dourado else (ouro if k in (1,4) else ciano_claro)
                alpha = round((82 if k in (1,4) else 120)*escala*fragmentos)
                pintor.setBrush(QColor(*cor, alpha))
                raio = (1.4 if k in (1,4) else 1.75)*(1.0-0.30*avancar)
                pintor.drawEllipse(pos, raio, raio)

        # 3. Tres filamentos convergem diretamente no receptor da constelacao;
        # rota pela margem da questao, sem cruzar o texto das alternativas.
        if voo:
            canais = (
                (-5.0, -0.035, fonte_cor, 0.48, 1.30),
                (0.0, 0.0, trilha_clara, 0.94, 2.05),
                (5.0, 0.025, ouro if self._dourado else (109, 191, 211), 0.43, 1.15),
            )
            for deslocamento, atraso, cor, ganho, espessura in canais:
                comeco = QPointF(fonte.x(), fonte.y()+deslocamento)
                rota = self._b25r1_caminho(comeco, destino,
                                           trilho+deslocamento*0.38,
                                           deslocamento)
                fracao = max(0.0, min(1.0, (t-0.34+atraso)/0.48))
                fracao = fracao*fracao*(3.0-2.0*fracao)
                cauda = max(0.0, fracao-(0.13 if ganho<0.7 else 0.19))
                segmento = QPainterPath()
                for i in range(25):
                    ponto = rota.pointAtPercent(cauda+(fracao-cauda)*(i/24))
                    if i==0:
                        segmento.moveTo(ponto)
                    else:
                        segmento.lineTo(ponto)
                pintor.setBrush(Qt.NoBrush)
                pintor.setPen(QPen(QColor(*cor, round(50*escala*voo*ganho)),
                                    espessura*2.7, Qt.SolidLine,
                                    Qt.RoundCap, Qt.RoundJoin))
                pintor.drawPath(segmento)
                pintor.setPen(QPen(QColor(*cor, round(198*escala*voo*ganho)),
                                    espessura, Qt.SolidLine,
                                    Qt.RoundCap, Qt.RoundJoin))
                pintor.drawPath(segmento)
                # Cabeca com eco: o filamento nao deixa um rastro permanente.
                pintor.setPen(Qt.NoPen)
                for recuo, raio, alpha_base in ((0.060, 1.5, 58),
                                                (0.026, 2.6, 110),
                                                (0.0, 3.7, 210)):
                    ponto = rota.pointAtPercent(max(0.0, fracao-recuo))
                    pintor.setBrush(QColor(*cor, round(alpha_base*escala*voo*ganho)))
                    pintor.drawEllipse(ponto, raio, raio)

        # 4. Absorcao no NUCLEO da constelacao: impacto radial contido,
        # sem borda no HUD Acertos. A vibracao e a contagem ficam para B26-E.
        if absorcao:
            pintor.save()
            raio_luz = 24.0
            glow = QRadialGradient(alvo_centro, raio_luz)
            glow.setColorAt(0.0, QColor(*trilha_clara, round(125*escala*absorcao)))
            glow.setColorAt(0.32, QColor(*acento, round(64*escala*absorcao)))
            glow.setColorAt(1.0, QColor(*acento, 0))
            pintor.setPen(Qt.NoPen)
            pintor.setBrush(QBrush(glow))
            pintor.drawEllipse(alvo_centro, raio_luz, raio_luz)

            fase = max(0.0, min(1.0, (t-0.76)/0.24))
            fase = fase*fase*(3.0-2.0*fase)
            raio_onda = 7.0 + 18.0*fase
            pintor.setBrush(Qt.NoBrush)
            pintor.setPen(QPen(QColor(*acento, round(174*escala*absorcao*(1.0-0.32*fase))), 1.5))
            pintor.drawEllipse(alvo_centro, raio_onda, raio_onda)
            pintor.setPen(QPen(QColor(*ciano_claro, round(100*escala*absorcao)), 0.9))
            pintor.drawEllipse(alvo_centro, 5.0+5.0*fase, 5.0+5.0*fase)

            # Tres micro-ramificacoes recebem a chegada no nucleo central.
            pintor.setPen(QPen(QColor(*acento, round(104*escala*absorcao)), 1.0))
            for desloc_x, desloc_y in ((-24.0, 0.0), (18.0, -13.0), (13.0, 18.0)):
                ponta = QPointF(alvo_centro.x()+desloc_x*(0.54+0.46*fase),
                                alvo_centro.y()+desloc_y*(0.54+0.46*fase))
                base = QPointF(alvo_centro.x()+desloc_x*0.35,
                               alvo_centro.y()+desloc_y*0.35)
                pintor.drawLine(base, ponta)
            pintor.setPen(Qt.NoPen)
            pintor.setBrush(QColor(*ciano_claro, round(150*escala*absorcao)))
            pintor.drawEllipse(alvo_centro, 2.8, 2.8)
            pintor.restore()
        pintor.end()


