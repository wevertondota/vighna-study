        )
        visao_principal.setHorizontalSpacing(12)
        visao_principal.setVerticalSpacing(0)
        visao_principal.setColumnStretch(0, 1)
        visao_principal.setColumnStretch(1, 1)
        visao_principal.setColumnStretch(2, 2)

        # ====================================================
