        )
        self.minha_contagem_topicos.setObjectName(
            "filterCount"
        )
        topicos_textos = QVBoxLayout()
        topicos_textos.setSpacing(1)
        topicos_textos.addWidget(topicos_titulo)
        topicos_textos.addWidget(topicos_desc)
        topicos_header.addLayout(topicos_textos)
        topicos_header.addStretch()
        topicos_header.addWidget(self.minha_contagem_topicos)
        topicos_layout.addLayout(topicos_header)

        self.tabela_minha_evolucao_topicos = QTableWidget()
        self.tabela_minha_evolucao_topicos.setObjectName(
            "myEvolutionTable"
        )
        self.tabela_minha_evolucao_topicos.setColumnCount(6)
        self.tabela_minha_evolucao_topicos.setHorizontalHeaderLabels([
            "Disciplina",
            "Tópico",
            "Domínio",
            "Desempenho",
            "Variação",
