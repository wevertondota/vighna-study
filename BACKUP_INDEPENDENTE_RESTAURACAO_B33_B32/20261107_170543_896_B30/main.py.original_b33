        )
        painel_acoes.setMinimumHeight(54)
        self.painel_acoes_bateria = painel_acoes
        layout.addWidget(painel_acoes)
        # B05: inicializar o modo compacto apenas com a árvore Qt completa.
        self._b05_compacto_ativo = None
        self._ajustar_ergonomia_bateria(self.width(), self.height())

        if self.modo_simulado:
            self.atualizar_relogio_simulado()

            if self.tempo_limite_minutos > 0:
                self.timer_simulado = QTimer(
                    self
                )
                self.timer_simulado.setInterval(
                    1000
                )
                self.timer_simulado.timeout.connect(
                    self.atualizar_relogio_simulado
                )
                self.timer_simulado.start()

        self._aplicar_visual_moderno_resolvedor()
        # Fundo decorativo exclusivo da bateria; nao afeta sessao/questoes.
        self._fundo_justica_resolvedor = None
        try:
            from ui.resolver_justica_background import aplicar_fundo_justica
            if normalizar_tema(obter_configuracao_texto("tema_interface", "claro")) == "futurista":
                self._fundo_justica_resolvedor = aplicar_fundo_justica(self)
        except Exception as erro:
            # Falha de imagem nunca impede responder questoes.
            print("Fundo do resolvedor indisponivel:", erro, file=sys.stderr)
        # B15: filho pequeno, transparente e sem captura de eventos. A camada
        # so e mostrada sobre textos quando o modo Leitura Neural esta ativo.
        self._b15_halo_cursor = _HaloCursorLeituraNeuralB15(self)
        self._b16_faixa_linha = _FaixaLeituraNeuralB16(self)
        # Reancora o realce ao texto quando o scroll reposiciona o cartao.
        self.scroll_questao.verticalScrollBar().valueChanged.connect(
            self._b16_reposicionar_linha_teclado)
        self._b17_aplicar_ajustes_widgets()
        self._b22_overlay = _PulsoSinapticoB22(self)
        self._b26_nav_overlay = _NavegacaoNeuralB26(self)
        # B26 R7: somente arte de fundo integral; Constelação intocada.
        self._b26_nicho_fundo = _FundoIntegralBateriaB26R7(self)
        self._b26_nicho_fundo.definir_monocromatico(self._b14_modo_pb)
        self._b26_constelacao = _ConstelacaoSinapticaB26(self)
        self._b26_constelacao.clicked.connect(self._b26r4_abrir_dialogo_constelacao)
        self._b26_constelacao.definir_intensidade(self._b26_constelacao_intensidade)
        self._b26_constelacao.definir_combo(self._b26_combo)
        # M32: camada etérea independente, desenhada atrás do PNG do brasão.
        # Não consome eventos nem lê estado acadêmico; visível só com brasão.
        from ui.merito.energia_eterea_m32 import EnergiaEtereaBrasaoM32
        self._m32_energia = EnergiaEtereaBrasaoM32(
            self, intensidade=self._m32_energia_intensidade)
        self._m32_energia.definir_ativo(self._m32_energia_ativa)
        # MÉRITO M07: imagem da conquista, independente da constelação,
        # do wallpaper e dos controles. Sem apuração global: fica oculta.
        self._m07_marco_brasao = None
        self._m07_cache_brasoes = {}
        self._m07_brasao = QLabel(self)
        self._m07_brasao.setObjectName("meritoBateriaBrasaoM07")
        self._m07_brasao.setAlignment(Qt.AlignCenter)
        self._m07_brasao.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        self._m07_brasao.setAttribute(Qt.WA_TranslucentBackground, True)
        self._m07_brasao.setStyleSheet(
            "QLabel#meritoBateriaBrasaoM07 { background: transparent; border: none; }"
        )
        self._m07_brasao.setAccessibleName("Insígnia de mérito do candidato")
        self._m07_brasao.hide()
        self._m07_sincronizar_perfil_auditado()
        self._b26_solicitar_layout_constelacao()
        self.carregar_atual()
        self._b17_restaurar_ativacoes()
        # Pre-carregamento nao bloqueante da interface inicial.
        if self._b26r2_sons_ativos:
            QTimer.singleShot(350, self._b26r2_preparar_sons)
        self.atualizar_painel_foco()
        self._registrar_no_controlador_principal()

        # O filtro na aplicação recebe a tecla antes do controle focado
        # (inclusive QRadioButton). Isso impede que as setas marquem opções
        # automaticamente e preserva a semântica: navegar -> selecionar -> confirmar.
        app = QApplication.instance()
        if app is not None:
            app.installEventFilter(self)
            self._filtro_teclado_aplicacao_instalado = True

        # T01: observador isolado da bateria. O QTimer roda SOMENTE na GUI;
        # a thread de diagnóstico não consulta Qt nem banco de dados.
        self._t01_monitor = None
        self._t01_pulso_timer = None
        try:
            from ui.diagnostico_bateria_t01 import MonitorTravamentoBateria
            self._t01_monitor = MonitorTravamentoBateria()
            self._t01_pulso_timer = QTimer(self)
            self._t01_pulso_timer.setInterval(350)
            self._t01_pulso_timer.timeout.connect(self._t01_pulso)
            self._t01_pulso_timer.start()
        except Exception:
            # Instrumentação não pode impedir a abertura da bateria.
            self._t01_monitor = None

    def _t01_pulso(self):
        monitor = getattr(self, '_t01_monitor', None)
        if monitor is not None:
            monitor.pulso()

    def _t01_evento(self, etiqueta, *, gravar=True):
        monitor = getattr(self, '_t01_monitor', None)
        if monitor is not None:
            if gravar:
                monitor.registrar(etiqueta)
            else:
                monitor.marcar(etiqueta)

    def _t01_encerrar(self):
        timer = getattr(self, '_t01_pulso_timer', None)
        if timer is not None:
            timer.stop()
            self._t01_pulso_timer = None
        monitor = getattr(self, '_t01_monitor', None)
        if monitor is not None:
            monitor.parar()
            self._t01_monitor = None

    @staticmethod
    def _b14_converter_qss_para_pb(estilo):
        """Converte apenas tokens de cor CSS. Preserva geometria e seletores Qt.

        Uma só conversão por clique (não por quadro). A luminosidade percebida
        mantém contraste relativo entre as cores originais.
        """
        def cinza(r, g, b):
            # Luma aproximada em sRGB; canais RGB inteiros.
            return max(0, min(255, round(0.2126*r + 0.7152*g + 0.0722*b)))

        def trocar_rgba(match):
            r, g, b = (int(match.group(i)) for i in (1, 2, 3))
            nivel = cinza(r, g, b)
            if match.group(4) is None:
                return f"rgb({nivel}, {nivel}, {nivel})"
            return f"rgba({nivel}, {nivel}, {nivel}, {match.group(4)})"

        estilo = re.sub(
            r"rgba?\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})\s*"
            r"(?:,\s*([\d.]+)\s*)?\)",
            trocar_rgba, estilo,
            flags=re.IGNORECASE,
        )
        def trocar_hex(match):
            valor = match.group(1)
            if len(valor) == 3:
                r, g, b = [int(c*2, 16) for c in valor]
            elif len(valor) == 6:
                r, g, b = [int(valor[i:i+2], 16) for i in (0, 2, 4)]
            else:
                return match.group(0)
            n = cinza(r, g, b)
            return f"#{n:02X}{n:02X}{n:02X}"
        return re.sub(r"#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{3})(?![0-9A-Fa-f])",
                      trocar_hex, estilo)

    def _b14_alternar_leitura_pb(self, ativo):
        """Alterna modo de conforto visual sem interferir na lógica de estudo."""
        self._b14_modo_pb = bool(ativo)
        acao = getattr(self, "acao_menu_leitura_pb", None)
        if acao is not None and acao.isChecked() != self._b14_modo_pb:
            acao.blockSignals(True)
            acao.setChecked(self._b14_modo_pb)
            acao.blockSignals(False)
        fundo = getattr(self, "_fundo_justica_resolvedor", None)
        if fundo is not None and hasattr(fundo, "alternar_monocromatico"):
            fundo.alternar_monocromatico(self._b14_modo_pb)
        marca = getattr(self, "_b14_logo_label", None)
        pixmap_original = getattr(self, "_b14_logo_original", QPixmap())
        if marca is not None and not pixmap_original.isNull():
            if self._b14_modo_pb:
                # Preservar canal alfa da marca (Grayscale8 retiraria transparência).
                imagem_logo = pixmap_original.toImage().convertToFormat(QImage.Format_ARGB32)
                for y in range(imagem_logo.height()):
                    for x in range(imagem_logo.width()):
                        cor = imagem_logo.pixelColor(x, y)
                        n = round(0.2126 * cor.red() + 0.7152 * cor.green() + 0.0722 * cor.blue())
                        imagem_logo.setPixelColor(x, y, QColor(n, n, n, cor.alpha()))
                marca.setPixmap(QPixmap.fromImage(imagem_logo))
            else:
                marca.setPixmap(pixmap_original)
        # R8 R5: a Constelação permanece colorida mesmo na Leitura Neural P&B.
        # O nicho/fundo, a navegação e o feixe continuam respeitando o P&B.
        constelacao = getattr(self, "_b26_constelacao", None)
        if constelacao is not None:
            constelacao.definir_monocromatico(False)
        nicho = getattr(self, "_b26_nicho_fundo", None)
        if nicho is not None:
            nicho.definir_monocromatico(self._b14_modo_pb)
        navegacao = getattr(self, "_b26_nav_overlay", None)
        if navegacao is not None:
            navegacao.definir_monocromatico(self._b14_modo_pb)
        transferencia = getattr(self, "_b22_overlay", None)
        if transferencia is not None:
            transferencia.definir_monocromatico(self._b14_modo_pb)
        # Somente o tema Qt desta janela; não muda temas de outras janelas.
        self._aplicar_visual_moderno_resolvedor()
        # B16R1: PB altera somente as cores. O halo e a faixa sao estados
        # independentes: QAction marcado = efeito ativo (nunca desabilitado).

    def _b17_ler_numero(self, chave, padrao, minimo, maximo):
        """QSettings pode conter strings ou tipos antigos; limitar valores."""
        try:
            valor = int(self._b17_preferencias.value(chave, padrao))
        except (ValueError, TypeError, OverflowError):
            valor = padrao
        return max(minimo, min(maximo, valor))

    def _b17_salvar_ativacao(self, chave, marcado):
        """So escreve quando o usuario alterna a opcao; nao durante hover."""
        self._b17_preferencias.setValue(chave, bool(marcado))
        self._b17_preferencias.sync()

    def _b17_restaurar_ativacoes(self):
        """Reabre no estado escolhido, preservando controles independentes."""
        pares = (
            ("preto_branco", self.acao_menu_leitura_pb),
            ("alternativas_cor_ativa", self.acao_menu_cor_alternativas_b18),
            ("halo_ativo", self.acao_menu_halo_b15),
            ("linha_ativa", self.acao_menu_linha_b16),
        )
        for chave, acao in pares:
            try:
                marcado = self._b17_preferencias.value(chave, False, type=bool)
            except (ValueError, TypeError):
                marcado = False
            if acao.isChecked() != bool(marcado):
                acao.setChecked(bool(marcado))
        # B22 separado dos quatro ajustes existentes; primeiro uso habilitado.
        for chave, acao, padrao in (
            ("acerto_efeito_ativo", self.acao_menu_efeito_acerto_b22, True),
            ("navegacao_efeito_ativo", self.acao_menu_navegacao_b26, True),
            ("combo_constelacao_ativa", self.acao_menu_constelacao_b26, True),
            ("audio_v3_ativo", self.acao_menu_sons_b26r2, True),
            ("audio_v3_setas", self.acao_menu_som_setas_b26r2, True),
            ("audio_v3_recompensas", self.acao_menu_som_recompensas_b26r2, True),
            ("audio_v3_transicao", self.acao_menu_som_transicao_b26r5, True),
        ):
            try:
                marcado = self._b17_preferencias.value(chave, padrao, type=bool)
            except (ValueError, TypeError):
                marcado = padrao
            if acao.isChecked() != bool(marcado):
                acao.setChecked(bool(marcado))

    def _b17_aplicar_ajustes_widgets(self):
        """Apenas muda propriedades dos overlays, nunca o QSS global."""
        halo = getattr(self, "_b15_halo_cursor", None)
        if halo is not None:
            halo.configurar_b17(self._b17_tamanho_halo,
                               self._b17_intensidade_halo)
        faixa = getattr(self, "_b16_faixa_linha", None)
        if faixa is not None:
            faixa.configurar_b17(self._b17_intensidade_linha)

    def _b17_ajustar_valor(self, chave, valor):
        referencias = {
            "halo_intensidade": ("_b17_intensidade_halo", 25, 150),
            "halo_tamanho": ("_b17_tamanho_halo", 32, 96),
            "linha_intensidade": ("_b17_intensidade_linha", 25, 175),
            "alternativas_cor_intensidade": ("_b18_cor_intensidade", 0, 100),
            "acerto_efeito_intensidade": ("_b22_intensidade", 0, 100),
            "navegacao_efeito_intensidade": ("_b26_nav_intensidade", 0, 100),
            "combo_constelacao_intensidade": ("_b26_constelacao_intensidade", 0, 100),
        }
        atributo, minimo, maximo = referencias[chave]
        valor = max(minimo, min(maximo, int(valor)))
        if getattr(self, atributo) != valor:
            setattr(self, atributo, valor)
            if chave == "alternativas_cor_intensidade":
                self._b18_reaplicar_tinta_se_necessario()
            elif chave == "combo_constelacao_intensidade":
                widget = getattr(self, "_b26_constelacao", None)
                if widget is not None:
                    widget.definir_intensidade(valor)
            else:
                self._b17_aplicar_ajustes_widgets()

    def _b17_salvar_ajustes(self):
        # Ao fechar a janela (nao a cada pixel arrastado no QSlider).
        self._b17_preferencias.setValue(
            "halo_intensidade", self._b17_intensidade_halo)
        self._b17_preferencias.setValue(
            "halo_tamanho", self._b17_tamanho_halo)
        self._b17_preferencias.setValue(
            "linha_intensidade", self._b17_intensidade_linha)
        self._b17_preferencias.setValue(
            "alternativas_cor_intensidade", self._b18_cor_intensidade)
        self._b17_preferencias.setValue(
            "acerto_efeito_intensidade", self._b22_intensidade)
        self._b17_preferencias.setValue(
            "navegacao_efeito_intensidade", self._b26_nav_intensidade)
        self._b17_preferencias.setValue(
            "combo_constelacao_intensidade", self._b26_constelacao_intensidade)
        self._b17_preferencias.sync()

    def _b17_abrir_ajustes(self):
        """Dialogo local PySide6: slider acessivel, sem mudar fluxo de questoes."""
        dialogo = QDialog(self)
        dialogo.setObjectName("questionReadingSettingsB17")
        dialogo.setWindowTitle("Ajustes — Leitura Neural")
        dialogo.setMinimumWidth(390)
        dialogo.setModal(True)
        dialogo.setStyleSheet(
            "QDialog#questionReadingSettingsB17 {background:#0C1723;color:#E9F4FB;}"
            "QLabel {color:#D9EAF5;font-size:12px;}"
            "QPushButton {background:#193146;color:#E9F4FB;border:1px solid #42607A;"
            "border-radius:6px;padding:7px 12px;}"
            "QPushButton:hover {background:#26485F;}"
            "QSlider::groove:horizontal {height:5px;background:#36536B;border-radius:2px;}"
            "QSlider::handle:horizontal {background:#90D5ED;width:14px;margin:-5px 0;"
            "border-radius:7px;}"
        )
        corpo = QVBoxLayout(dialogo)
        corpo.setContentsMargins(18, 16, 18, 16)
        corpo.setSpacing(12)
        descricao = QLabel(
            "Ajuste os guias de leitura, a cor dos cartões e os efeitos visuais "
            "de acerto e navegação. A cor dos cartões exige modo preto e branco "
            "+ cor nas alternativas. Os efeitos de acerto e setas são "
            "independentes; intensidade 0% desativa cada animação.")
        descricao.setWordWrap(True)
        corpo.addWidget(descricao)
        controles = {}
        definicoes = (
            ("halo_intensidade", "Intensidade do halo", 25, 150,
             self._b17_intensidade_halo, "%"),
            ("halo_tamanho", "Diâmetro do halo", 32, 96,
             self._b17_tamanho_halo, " px"),
            ("linha_intensidade", "Contraste do destaque de linha", 25, 175,
             self._b17_intensidade_linha, "%"),
            ("alternativas_cor_intensidade", "Cor dos cartões A–E (no P&B)", 0, 100,
             self._b18_cor_intensidade, "%"),
            ("acerto_efeito_intensidade", "Intensidade da transferência neural", 0, 100,
             self._b22_intensidade, "%"),
            ("navegacao_efeito_intensidade", "Luz ao navegar pelas alternativas", 0, 100,
             self._b26_nav_intensidade, "%"),
            ("combo_constelacao_intensidade", "Brilho da Constelação Sináptica", 0, 100,
             self._b26_constelacao_intensidade, "%"),
        )
        for chave, nome, minimo, maximo, atual, unidade in definicoes:
            linha = QVBoxLayout()
            informacoes = QHBoxLayout()
            texto = QLabel(nome)
            numero = QLabel(f"{atual}{unidade}")
            numero.setMinimumWidth(54)
            numero.setAlignment(Qt.AlignRight | Qt.AlignVCenter)
            informacoes.addWidget(texto)
            informacoes.addStretch(1)
            informacoes.addWidget(numero)
            linha.addLayout(informacoes)
            slider = QSlider(Qt.Horizontal, dialogo)
            slider.setAccessibleName(nome)
            slider.setRange(minimo, maximo)
            slider.setSingleStep(1)
            slider.setPageStep(5)
            if chave in ("alternativas_cor_intensidade", "acerto_efeito_intensidade", "navegacao_efeito_intensidade", "combo_constelacao_intensidade"):
                # Evita trabalho redundante durante o arraste.
                slider.setTracking(False)
            slider.setValue(atual)
            def mudar(valor, k=chave, rotulo=numero, suf=unidade):
                rotulo.setText(f"{valor}{suf}")
                self._b17_ajustar_valor(k, valor)
            slider.valueChanged.connect(mudar)
            linha.addWidget(slider)
            corpo.addLayout(linha)
            controles[chave] = slider
        botoes = QHBoxLayout()
        restaurar = QPushButton("Restaurar padrão")
        restaurar.setToolTip(
            "Padrões B17 para leitura, 35% nas alternativas e 45% no pulso")
        restaurar.clicked.connect(lambda: (
            controles["halo_intensidade"].setValue(100),
            controles["halo_tamanho"].setValue(58),
            controles["linha_intensidade"].setValue(100),
            controles["alternativas_cor_intensidade"].setValue(35),
            controles["acerto_efeito_intensidade"].setValue(45),
            controles["navegacao_efeito_intensidade"].setValue(65),
            controles["combo_constelacao_intensidade"].setValue(78),
        ))
        concluir = QPushButton("Concluir")
        concluir.clicked.connect(dialogo.accept)
        botoes.addWidget(restaurar)
        botoes.addStretch(1)
        botoes.addWidget(concluir)
        corpo.addLayout(botoes)
        # Aceitar, cancelar pelo X ou Esc: manter os valores ajustados.
        dialogo.exec()
        self._b17_salvar_ajustes()

    @staticmethod
    def _b26_calcular_area_constelacao(largura, topo, fundo, inicio_caneta):
        """R8 R8 — Constelação centralizada sobre a plataforma da nova arte.

        Usamos coordenadas relativas à largura para conservar proporções e
        impedir que o HUD da Constelação invada o dock da caneta à direita.
        As dimensões reais são calculadas antes do posicionamento; o receptor
        da energia é mapeado pelo próprio widget via mapToGlobal/mapFromGlobal.
        """
        largura=int(largura)
        topo, fundo=int(topo),int(fundo)
        inicio_caneta=int(inicio_caneta)
        disponivel_h=max(0,fundo-topo-8)
        if disponivel_h < 70:
            return None
        # A referência 1366 x 768 usa widget 265 x 112 à esquerda do dock.
        largura_referencia=265 if largura >= 1250 else (240 if largura>=1000 else 198)
        h=min(112, disponivel_h)
        w=min(largura_referencia,round(h*(265/112)))
        h=min(h,round(w*(112/265)))
        if w<138 or h<68:
            return None
        # O símbolo deve flutuar sobre o palco central da arte aprovada.
        # Para 1366px a posição do widget começa perto de x=535px.
        desejado=round(largura*0.392)
        dock_inicio=inicio_caneta if inicio_caneta>0 else largura-8
        margem_dock=20
        # Larguras reduzidas: prioriza não invadir os controles.
        x=min(desejado,dock_inicio-w-margem_dock)
        if x<18:
            x=18
        if x+w+8>dock_inicio and largura>=800:
            # Em telas estreitas, a Constelação pode encolher sem invadir a caneta.
            w=min(w,max(0,dock_inicio-x-12))
            h=min(h,round(w*(112/265)))
        if w<138 or h<68:
            return None
        centro_y=topo+max(0,(fundo-topo-h)//2)
        # Pé da estrela próximo da plataforma, com respiro ao cabeçalho.
        y=max(topo-2,centro_y-4) if largura>=1000 else centro_y
        return int(x),int(y),int(w),int(h)

    def _b26_solicitar_layout_constelacao(self):
        """Recalcula apos o Qt ajustar o layout; agendamento unico, nao periodico."""
        if getattr(self, "_b26_layout_constelacao_pendente", False):
            return
        self._b26_layout_constelacao_pendente = True
        QTimer.singleShot(0, self._b26_posicionar_constelacao)

    def _b26r7_posicionar_fundo_integral(self):
        """Atualiza somente a camada cenográfica, atrás de toda a interface."""
        arte = getattr(self, "_b26_nicho_fundo", None)
        original = getattr(self, "_fundo_justica_resolvedor", None)
        if arte is None:
            return
        if original is None:
            arte.hide()  # Outro tema não usa o cenário extraterrestre.
            return
        arte.setGeometry(self.rect())
        arte.show()
        # A ordem é deliberada: a arte fica acima do fundo original, mas
        # abaixo do cabeçalho, caneta, cartões, Constelação e demais controles.
        arte.lower()
        try:
            if isinstance(original, QWidget) and original.parentWidget() is self:
                original.lower()
        except RuntimeError:
            pass

    # MÉRITO M13 — sem I/O, sem timer e sem cálculo dentro da Bateria.
    def _m13_evento_tentativa_confirmada(self, resultado):
        if self.sem_impacto_inteligencia:
            return
        principal = None
        try:
            principal = self._localizar_janela_principal()
            ponte = getattr(principal, "_m13_ponte_qt", None)
            if ponte is not None:
                principal._m13_registrar_tentativa_academica(
                    resultado.get("tentativa_id"), simulado_aberto=self.modo_simulado)
        except Exception:
            # A tentativa já foi gravada; jamais bloquear a navegação.
            try:
                if principal is not None:
                    principal._m13_revogar_em_falha("Falha no gatilho da tentativa")
            except Exception:
                pass

    def _m13_evento_simulado_entregue(self):
        if not self.modo_simulado or self.sem_impacto_inteligencia:
            return
        principal = None
        try:
            principal = self._localizar_janela_principal()
            if getattr(principal, "_m13_ponte_qt", None) is not None:
                principal._m13_simulado_entregue()
        except Exception:
            try:
                if principal is not None:
                    principal._m13_revogar_em_falha("Falha no evento de entrega do simulado")
            except Exception:
                pass

    # MÉRITO M07 — insígnia isolada, somente a partir de mérito global auditado.
    # Sem contador, titulo, moldura ou temporizador adicional.
    @staticmethod
    def _m07_area_brasao(largura, topo, fundo, area_constelacao):
        """Retorna uma área segura, sempre à esquerda da Constelação.

        Dimensões relativas ao espaço livre real, não ao wallpaper. Em tela
        estreita oculta apenas a insígnia; a leitura continua intocada.
        """
        if area_constelacao is None or int(largura) < 900:
            return None
        x_const, y_const, w_const, h_const = map(int, area_constelacao)
        topo, fundo = int(topo), int(fundo)
        disponivel = fundo - topo - 12
        if disponivel < 82:
            return None
        lado = min(120, disponivel, h_const + 8)
        afastamento = min(152, max(56, round(int(largura) * 0.108)))
        x = x_const - lado - afastamento
        y = y_const + (h_const - lado) // 2
        y = max(topo + 3, min(y, fundo - lado - 4))
        if x < 22 or x + lado + 24 >= x_const:
            return None
        if y < topo or y + lado > fundo:
            return None
        return (int(x), int(y), int(lado), int(lado))

    def _m07_sincronizar_perfil_auditado(self):
        """Consulta apenas o estado central M08, sem consultar banco ou placar.

        É chamada pelo layout existente; nunca cria timer ou calcula mérito.
        """
        controlador = self._localizar_janela_principal()
        obter = getattr(controlador, "_m08_estado_atual", None)
        if not callable(obter):
            # Sem origem auditada, não reutilizar insígnia de sessão anterior.
            self._m07_marco_brasao = None
            return
        self._m08_receber_estado_sincronizado(obter(), agendar_layout=False)

    def _m08_receber_estado_sincronizado(self, estado, *, agendar_layout=True):
        """Atualiza a bateria na revisão central, inclusive revogações.

        Nunca concede mérito isoladamente. O estado vem do controlador e não
        de cálculos por combo, resposta selecionada ou concurso da sessão.
        """
        from ui.merito.sincronizacao_merito_m08 import EstadoSincronizadoM08
        from ui.merito.visao_merito_m05 import VisaoCatalogo
        if type(estado) is not EstadoSincronizadoM08:
            raise TypeError("Estado central de mérito M08 obrigatório")
        if type(estado.visao) is not VisaoCatalogo:
            raise TypeError("Projeção de catálogo inválida")
        anterior = getattr(self, "_m08_ultima_revisao", -1)
        if estado.revisao < anterior:
            return False  # Mensagem antiga: não restaurar brasão já revogado.
        if estado.revisao == anterior:
            return False
        visao = estado.visao
        marco = visao.brasao_atual
        conquistados = [c for c in visao.cartoes
                        if c.marco == marco and c.estado == "conquistado"
                        and c.destaque_atual]
        self._m07_marco_brasao = (
            marco if visao.apurado and visao.fonte
            and marco in _PERFIL_BRASOES_M04 and len(conquistados) == 1 else None
        )
        self._m08_ultima_revisao = estado.revisao
        if self._m07_marco_brasao is None:
            icone = getattr(self, "_m07_brasao", None)
            if icone is not None:
                icone.hide()
            energia = getattr(self, "_m32_energia", None)
            if energia is not None:
                energia.hide()
        if agendar_layout:
            self._b26_solicitar_layout_constelacao()
        return True

    def _m07_receber_resultado_global_auditado(self, resultado):
        """Compatibilidade M07: delega publicação ao controlador M08.

        Não existe mais estado local independente da versão do Perfil.
        """
        from ui.merito.visao_merito_m05 import projetar_resultado_auditado
        projetar_resultado_auditado(resultado)  # Validação antes de delegar.
        controlador = self._localizar_janela_principal()
        publicar = getattr(controlador, "_m08_publicar_integracao_auditada", None)
        if not callable(publicar):
            raise RuntimeError("Controlador central M08 indisponível")
        return publicar(resultado)

    def _m07_pixmap_brasao(self, marco, lado):
        chave = (int(marco), int(lado))
        cache = self._m07_cache_brasoes
        if chave not in cache:
            # Reutiliza exatamente os PNG RGBA de 160px já incorporados ao
            # catálogo M04, evitando duplicação e caminhos de arquivo externos.
            png = base64.b64decode(_PERFIL_BRASOES_M04[chave[0]])
            imagem = QPixmap()
            if not imagem.loadFromData(png, "PNG"):
                return QPixmap()
            # Recorta somente o espaço transparente, não as asas e brilhos.
            ret = _M07_RECORTES_TRANSPARENTES[chave[0]]
            imagem = imagem.copy(QRect(*ret))
            cache[chave] = imagem.scaled(
                chave[1], chave[1], Qt.KeepAspectRatio,
                Qt.SmoothTransformation)
        return cache[chave]

    def _m32_alternar_energia(self, ativo):
        """Preferência visual; nunca manipula saldo, respostas ou histórico."""
        self._m32_energia_ativa = bool(ativo)
        self._b17_salvar_ativacao("energia_eterea_m32_ativa", ativo)
        energia = getattr(self, "_m32_energia", None)
        if energia is not None:
            energia.definir_ativo(ativo)
        self._b26_solicitar_layout_constelacao()

    def _m32_ajustar_intensidade(self, intensidade):
        self._m32_energia_intensidade = max(0, min(100, int(intensidade)))
        self._b17_preferencias.setValue(
            "energia_eterea_m32_intensidade", self._m32_energia_intensidade)
        self._b17_preferencias.sync()
        for valor, acao in self._m32_acoes_intensidade.items():
            acao.setChecked(valor == self._m32_energia_intensidade)
        energia = getattr(self, "_m32_energia", None)
        if energia is not None:
            energia.definir_intensidade(self._m32_energia_intensidade)
        self._b26_solicitar_layout_constelacao()

    def _m07_posicionar_brasao(self, area_constelacao, topo, fundo):
        icone = getattr(self, "_m07_brasao", None)
        if icone is None:
            return
        self._m07_sincronizar_perfil_auditado()
        marco = getattr(self, "_m07_marco_brasao", None)
        area = self._m07_area_brasao(self.width(), topo, fundo, area_constelacao)
        if marco not in _PERFIL_BRASOES_M04 or area is None:
            icone.hide()
            energia = getattr(self, "_m32_energia", None)
            if energia is not None:
                energia.hide()
            return
        # Insígnia colorida também na Leitura Neural P&B, como a Constelação.
        pixmap = self._m07_pixmap_brasao(marco, area[2])
        if pixmap.isNull():
            icone.hide()
            energia = getattr(self, "_m32_energia", None)
            if energia is not None:
                energia.hide()
            return
        # Filamentos em torno de toda a figura, dentro da faixa livre,
        # sem invadir a Constelação ou a barra de caneta.
        energia = getattr(self, "_m32_energia", None)
        if energia is not None:
            if self._m32_energia_ativa and self._m32_energia_intensidade > 0:
                limite_direito = int(area_constelacao[0]) - 14
                ex = max(0, area[0] - 24)
                ey = max(int(topo), area[1] - 15)
                edireita = min(limite_direito, area[0] + area[2] + 24)
                ebaixo = min(int(fundo) - 3, area[1] + area[3] + 15)
                if edireita - ex >= 80 and ebaixo - ey >= 70:
                    energia.setGeometry(ex, ey, edireita - ex, ebaixo - ey)
                    energia.show()
                    energia.raise_()  # Atrás da insígnia, acima do wallpaper.
                else:
                    energia.hide()
            else:
                energia.hide()
        icone.setGeometry(*area)
        icone.setPixmap(pixmap)
        icone.show()
        icone.raise_()
        pausa = getattr(self, "_pausa_overlay", None)
        if pausa is not None and pausa.isVisible():
            pausa.raise_()

    def _b26_posicionar_constelacao(self):
        self._b26_layout_constelacao_pendente = False
        self._b26r7_posicionar_fundo_integral()
        widget = getattr(self, "_b26_constelacao", None)
        if widget is None:
            return
        try:
            topo = self.cabecalho_sessao.geometry().bottom() + 5
            fundo = self.scroll_questao.mapTo(self, QPoint(0, 0)).y()
            inicio_caneta = self.faixa_caneta.mapTo(self, QPoint(0, 0)).x()
        except RuntimeError:
            widget.hide()
            brasao = getattr(self, "_m07_brasao", None)
            if brasao is not None:
                brasao.hide()
            energia = getattr(self, "_m32_energia", None)
            if energia is not None:
                energia.hide()
            return
        area = self._b26_calcular_area_constelacao(
            self.width(), topo, fundo, inicio_caneta)
        # A conquista global é independente do combo e do feedback de simulado.
        self._m07_posicionar_brasao(area, topo, fundo)
        sem_feedback = self.modo_simulado and not self.feedback_imediato
        if not self._b26_constelacao_ativa or area is None or sem_feedback:
            if widget.isVisible():
                self._b22_parar_animacao()
                widget.parar_vibracao()
            widget.hide()
            return
        widget.definir_combo(self._b26_combo if self._b26_combo_pendente is None
                             else widget._combo)
        # B31 R2: desce SOMENTE o HUD da Constelação em até 5 px.
        # Não deslocar `area` antes de posicionar a insígnia: ambos usam
        # a mesma referência, mas o brasão deve permanecer exatamente onde está.
        # Deixar 3 px de respiro antes do painel de enunciado em janelas menores.
        delta_y_constelacao = min(
            5, max(0, int(fundo) - (int(area[1]) + int(area[3])) - 3))
        widget.setGeometry(
            int(area[0]), int(area[1]) + delta_y_constelacao,
            int(area[2]), int(area[3]))
        widget.show()
        widget.raise_()
        # O painel de descanso deve continuar acima dos elementos cenograficos.
        pausa = getattr(self, "_pausa_overlay", None)
        if pausa is not None and pausa.isVisible():
            pausa.raise_()

    def _b26r4_abrir_dialogo_constelacao(self):
        constelacao = getattr(self, "_b26_constelacao", None)
        if constelacao is None:
            return
        try:
            combo = int(getattr(self, "_b26_combo", 0))
        except (TypeError, ValueError, OverflowError):
            combo = 0
        dialogo = _DialogoProgressaoConstelacaoB26R4(combo, self)
        dialogo.exec()

    def _b26_alternar_constelacao(self, ativo):
        self._b26_constelacao_ativa = bool(ativo)
        if not ativo:
            # Um destino oculto nao deve continuar recebendo energia.
            self._b22_parar_animacao()
            widget = getattr(self, "_b26_constelacao", None)
            if widget is not None:
                widget.parar_vibracao()
        self._b26_solicitar_layout_constelacao()

    def _b26_alternar_navegacao(self, ativo):
        self._b26_nav_ativa = bool(ativo)
        if not ativo:
            self._b26_parar_navegacao()

    # B26 R2 — Audio Xeno-Arquitetura V3: independente dos efeitos visuais.
    def _b26r2_preparar_sons(self):
        if self._b26r2_sons_ativos and getattr(self, "_b26r2_audio", None):
            self._b26r2_audio.preparar()

    def _b26r2_alternar_sons(self, ativo):
        self._b26r2_sons_ativos = bool(ativo)
        if not ativo:
            self._b26r2_audio.parar()
        else:
            self._b26r2_preparar_sons()

    def _b26r2_alternar_som_setas(self, ativo):
        self._b26r2_som_setas = bool(ativo)

    def _b26r2_alternar_som_recompensas(self, ativo):
        self._b26r2_som_recompensas = bool(ativo)

    def _b26r5_alternar_som_transicao(self, ativo):
        self._b26r5_som_transicao = bool(ativo)

    def _b26r2_tocar_som(self, nome, teste=False):
        if not self._b26r2_sons_ativos and not teste:
            return
        if nome.startswith("seta_"):
            if not teste and not self._b26r2_som_setas:
                return
        elif nome == "proxima_questao":
            if not teste and not self._b26r5_som_transicao:
                return
        elif not teste and not self._b26r2_som_recompensas:
            return
        som = getattr(self, "_b26r2_audio", None)
        if som is not None:
            som.tocar(nome)

    def _b26r2_ajustar_volume(self, tipo, valor):
        valor = max(0, min(100, int(valor)))
        if tipo == "setas":
            self._b26r2_volume_setas = valor
        elif tipo == "transicao":
            self._b26r5_volume_transicao = valor
        else:
            self._b26r2_volume_recompensa = valor
        self._b26r2_audio.ajustar_volumes(
            self._b26r2_volume_setas, self._b26r2_volume_recompensa,
            self._b26r5_volume_transicao)

    def _b26r2_salvar_volumes(self):
        for chave, valor in (("audio_v3_volume_setas", self._b26r2_volume_setas),
                             ("audio_v3_volume_recompensa", self._b26r2_volume_recompensa),
                             ("audio_v3_volume_transicao", self._b26r5_volume_transicao)):
            self._b17_preferencias.setValue(chave, valor)
        self._b17_preferencias.sync()

    def _b26r2_abrir_ajustes_som(self):
        dialogo = QDialog(self)
        dialogo.setWindowTitle("Sons neurais — Xeno-Arquitetura V3")
        dialogo.setMinimumWidth(390)
        corpo = QVBoxLayout(dialogo)
        descricao = QLabel(
            "Sons originais da navegação e das recompensas. "
            "Ajuste cada categoria; volume 0% silencia. "
            "A prévia toca o som escolhido sem alterar a sequência de acertos.")
        descricao.setWordWrap(True)
        corpo.addWidget(descricao)
        for tipo, nome, atual in (
            ("setas", "Volume das setas", self._b26r2_volume_setas),
            ("recompensa", "Volume de acerto e constelação", self._b26r2_volume_recompensa),
            ("transicao", "Volume da transição entre questões", self._b26r5_volume_transicao),
        ):
            linha = QVBoxLayout()
            topo = QHBoxLayout()
            rotulo = QLabel(nome)
            valor = QLabel(f"{atual}%")
            topo.addWidget(rotulo)
            topo.addStretch()
            topo.addWidget(valor)
            linha.addLayout(topo)
            slider = QSlider(Qt.Horizontal, dialogo)
            slider.setRange(0, 100)
            slider.setValue(atual)
            slider.setTracking(False)
            slider.valueChanged.connect(
                lambda v, k=tipo, texto=valor: (
                    texto.setText(f"{v}%"), self._b26r2_ajustar_volume(k, v)))
            linha.addWidget(slider)
            corpo.addLayout(linha)
        for titulo, chave in (
            ("Testar seta ↑", "seta_cima"),
            ("Testar seta ↓", "seta_baixo"),
            ("Testar acerto", "acerto"),
            ("Testar chegada à constelação", "constelacao"),
            ("Testar Combo ×5", "combo5"),
            ("Testar próxima questão", "proxima_questao"),
        ):
            botao = QPushButton(titulo, dialogo)
            botao.clicked.connect(
                lambda marcado=False, nome=chave: self._b26r2_tocar_som(nome, teste=True))
            corpo.addWidget(botao)
        concluir = QPushButton("Concluir", dialogo)
        concluir.clicked.connect(dialogo.accept)
        corpo.addWidget(concluir)
        dialogo.exec()
        self._b26r2_salvar_volumes()

    def _b26_parar_navegacao(self):
        animacao = getattr(self, "_b26_nav_animacao", None)
        self._b26_nav_animacao = None
        if animacao is not None:
            animacao.stop()
            animacao.deleteLater()
        camada = getattr(self, "_b26_nav_overlay", None)
        if camada is not None:
            camada.limpar()

    def _b26_terminar_navegacao(self, animacao):
        if self._b26_nav_animacao is animacao:
            self._b26_parar_navegacao()

    def _b26_animar_foco_setas(self, letra, passo, letra_anterior=None):
        """Dispara apenas para mudança real via ↑/↓/←/→, não via Enter/mouse."""
        if (not self._b26_nav_ativa or self._b26_nav_intensidade <= 0
                or self.resposta_confirmada or self._pausa_relogio is not None
                or self._editando_alternativas or self._editando_explicacao):
            return
        frame = self.frame_por_letra.get(letra)
        camada = getattr(self, "_b26_nav_overlay", None)
        if frame is None or camada is None:
            return
        self._b26_parar_navegacao()
        anterior = getattr(self, "frame_por_letra", {}).get(letra_anterior)
        camada.configurar(frame, passo, self._b26_nav_intensidade, anterior=anterior)
        animacao = QVariantAnimation(self)
        animacao.setStartValue(0.0)
        animacao.setEndValue(1.0)
        animacao.setDuration(235)
        animacao.setEasingCurve(QEasingCurve.Linear)
        animacao.valueChanged.connect(camada.progresso)
        animacao.finished.connect(
            lambda atual=animacao: self._b26_terminar_navegacao(atual))
        self._b26_nav_animacao = animacao
        animacao.start()

    @staticmethod
    def _b26_calcular_combo_registros(registros):
        """Combo por bateria: acerto +1; erro −6; pulo reinicia a zero.

        Recalcular da lista confirmada torna a função determinística e evita
        diferenças entre a tela, o registro local e a transição de questões.
        """
        combo = 0
        for registro in registros:
            status = registro.get("status")
            if status == "Correta":
                combo = min(9999, combo + 1)
            elif status == "Errada":
                combo = max(0, combo - 6)
            elif status == "Pulada":
                combo = 0
        return combo

    def _b26_registrar_resultado_combo(self, status):
        """Apenas feedback revelado: nunca vaza resultado de simulado oculto."""
        if self.modo_simulado and not self.feedback_imediato:
            self._b26_combo = 0
            self._b26_combo_pendente = None
            return
        self._b26_combo = self._b26_calcular_combo_registros(self.registros)
        # Identifica evento confirmado pela posição do registro na bateria;
        # re-renderizar ou repetir este callback não soma conquistas.
        indice_evento = len(self.registros)
        if (status == "Correta" and
                indice_evento != getattr(self, "_b26_ultimo_evento_contado", -1)):
            if self._b26_combo in _HistoricoMarcosConstelacao.MARCOS:
                _HistoricoMarcosConstelacao.registrar_marco(self._b26_combo, status)
            _HistoricoMarcosConstelacao.registrar_recorde(self._b26_combo)
            self._b26_ultimo_evento_contado = indice_evento
        if status != "Correta":
            # Erro retrocede seis casas, sem apagar o combo inteiro.
            # Pulo conserva a regra anterior: reiniciar a formação.
            self._b22_parar_animacao()
            self._b26_combo_pendente = None
            widget = getattr(self, "_b26_constelacao", None)
            if widget is not None:
                widget.definir_combo(self._b26_combo)
        # Acerto: o receptor espera a chegada do feixe como anteriormente.

    def _b26_confirmar_combo_pendente(self, vibrar=False):
        combo = self._b26_combo_pendente
        if combo is None:
            return
        self._b26_combo_pendente = None
        widget = getattr(self, "_b26_constelacao", None)
        if widget is None:
            return
        widget.definir_combo(combo)
        if vibrar and widget.isVisible() and combo:
            # B26 R3: dourado e parte da progressao natural a partir de x5.
            widget.vibrar_recebimento(combo >= 5)
            marco = combo in _HistoricoMarcosConstelacao.MARCOS
            self._b26r2_tocar_som("combo5" if marco else "constelacao")

    def _b26_animar_transferencia_valor(self, valor):
        """Atualiza o feixe e revela o combo ao receber os tres filamentos (>=84%)."""
        camada = getattr(self, "_b22_overlay", None)
        if camada is not None:
            camada.progresso(valor)
        if float(valor) >= 0.84:
            self._b26_confirmar_combo_pendente(vibrar=True)

    def _b26_resetar_combo(self):
        self._b26_combo_pendente = None
        self._b26_combo = 0
        widget = getattr(self, "_b26_constelacao", None)
        if widget is not None:
            widget.definir_combo(0)
            widget.parar_vibracao()

    def _b22_alternar_efeito(self, ativo):
        self._b22_efeito_ativo = bool(ativo)
        if not ativo:
            self._b22_parar_animacao()

    def _b22_parar_animacao(self):
        animacao = getattr(self, "_b22_animacao", None)
        self._b22_animacao = None
        if animacao is not None:
            animacao.stop()
            animacao.deleteLater()
        camada = getattr(self, "_b22_overlay", None)
        if camada is not None:
            camada.limpar()
        # Avancar, pausar, ocultar ou desativar antes da chegada nao perde
        # o acerto: atualiza o combo sem animar retroativamente.
        self._b26_confirmar_combo_pendente(vibrar=False)

    def _b22_concluir_animacao(self, animacao):
        # Não encerra uma animação nova se outra começou antes do finished.
        if self._b22_animacao is animacao:
            self._b22_parar_animacao()

    def _b22_iniciar_acerto(self, letra):
        """Acerto confirmado com feedback: energia direta ate a constelacao."""
        # Nunca resta animacao anterior ao iniciar outra. Se a anterior foi
        # interrompida, seu combo pendente e confirmado sem vibracao tardia.
        self._b22_parar_animacao()
        if (not self._b22_efeito_ativo or self._b22_intensidade <= 0
                or self.finalizada or self._pausa_relogio is not None
                or (self.modo_simulado and not self.feedback_imediato)):
            self._b26_combo_pendente = self._b26_combo
            self._b26_confirmar_combo_pendente()
            return
        origem = getattr(self, "frame_por_letra", {}).get(letra)
        destino = getattr(self, "_b26_constelacao", None)
        camada = getattr(self, "_b22_overlay", None)
        if (origem is None or camada is None or destino is None
                or not self._b26_constelacao_ativa or not destino.isVisible()):
            self._b26_combo_pendente = self._b26_combo
            self._b26_confirmar_combo_pendente()
            return
        combo = self._b26_combo
        # B26 R3: a energia JA SAI dourada no quinto acerto confirmado;
        # QSettings antigos nao podem antecipar nem desativar o marco x5.
        dourado = combo >= 5
        camada.configurar(
            origem, destino, self._b22_intensidade, dourado,
            monocromatico=self._b14_modo_pb)
        self._b26_combo_pendente = combo
        animacao = QVariantAnimation(self)
        animacao.setStartValue(0.0)
        animacao.setEndValue(1.0)
        animacao.setDuration(1100)
        animacao.setEasingCurve(QEasingCurve.Linear)
        animacao.valueChanged.connect(self._b26_animar_transferencia_valor)
        animacao.finished.connect(
            lambda atual=animacao: self._b22_concluir_animacao(atual))
        self._b22_animacao = animacao
        animacao.start()

    def _b18_alternar_cor_alternativas(self, ativo):
        """Alterna cor SOMENTE nos fundos A-E, sem tocar dados ou caneta."""
        self._b18_cor_alternativas_ativa = bool(ativo)
        self._b18_reaplicar_tinta_se_necessario()

    def _b18_reaplicar_tinta_se_necessario(self):
        """Nao repolir a janela quando o efeito e invisivel (P&B desligado)."""
        if getattr(self, "_b14_modo_pb", False):
            self._aplicar_visual_moderno_resolvedor()

    @staticmethod
    def _b18_css_tinta_alternativas(tema, cores, intensidade):
        """CSS local: B14 dessatura tudo; B18 recupera so fundos A-E.

        Preserva alpha, bordas, textos, estados corretos/errados, tema e
        interacoes. '100%' ainda e uma tonalidade de baixo croma, nao neon.
        """
        try:
            intensidade = max(0, min(100, int(intensidade)))
        except (TypeError, ValueError, OverflowError):
            intensidade = 0
        if intensidade == 0:
            return ""
        razao = intensidade / 100.0
        metas = {
            "futurista": ((30, 75, 98), (49, 98, 121), (76, 134, 171)),
            "escuro": ((35, 76, 97), (52, 101, 124), (70, 135, 166)),
            "claro": ((207, 229, 241), (194, 220, 233), (194, 223, 238)),
        }
        meta = metas.get(tema, metas["claro"])

        def rgb_original(texto):
            texto = str(texto).strip()
            if texto.startswith("#"):
                cor = QColor(texto)
                if cor.isValid():
                    return cor.red(), cor.green(), cor.blue(), cor.alpha()
            achado = re.fullmatch(
                r"rgba?\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,"
                r"\s*(\d{1,3})(?:\s*,\s*([\d.]+))?\s*\)",
                texto, flags=re.IGNORECASE)
            if achado:
                r, g, b = [min(255, int(achado.group(i))) for i in (1, 2, 3)]
                alpha_texto = achado.group(4)
                if alpha_texto is None:
                    a = 255
                else:
                    valor = float(alpha_texto)
                    a = round(valor * 255) if valor <= 1 else round(valor)
                return r, g, b, max(0, min(255, a))
            raise ValueError("Cor Qt inesperada nos cartoes de alternativa")

        def misturar(texto, destino):
            r, g, b, a = rgb_original(texto)
            cinza = round(0.2126 * r + 0.7152 * g + 0.0722 * b)
            canais = tuple(max(0, min(255, round(cinza * (1-razao) + v*razao)))
                           for v in destino)
            return f"rgba({canais[0]}, {canais[1]}, {canais[2]}, {a})"

        normal = misturar(cores["surface_alternative"], meta[0])
        hover = misturar(cores["alternative_hover"], meta[1])
        # B19: realce de escolha via Enter / clique, distinto do foco das
        # setas. A intensidade segue a regua existente do B18 (sem novo
        # controle). Em 0%, o retorno anterior ja preserva PB integral.
        # Um ganho sublinear de croma torna 35% perceptivel sem neon.
        ganho = razao ** 0.5
        metas_estado = {
            "futurista": ((27, 126, 149), (82, 183, 204), (54, 169, 187)),
            "escuro": ((36, 121, 144), (82, 177, 195), (54, 166, 180)),
            "claro": ((142, 201, 219), (59, 154, 180), (42, 144, 165)),
        }
        alvo_marcada, alvo_foco, alvo_lateral = metas_estado.get(
            tema, metas_estado["claro"])

        def misturar_estado(texto, destino, proporcao, alpha_extra=0):
            r, g, b, a = rgb_original(texto)
            cinza = round(0.2126 * r + 0.7152 * g + 0.0722 * b)
            canais = [max(0, min(255, round(cinza * (1-proporcao) + v*proporcao)))
                      for v in destino]
            return (f"rgba({canais[0]}, {canais[1]}, {canais[2]}, "
                    f"{min(255, a + alpha_extra)})")

        # Aumentar apenas a opacidade da alternativa MARCADA; cartas
        # normais e hover conservam o alpha original da B18.
        selecionada = misturar_estado(
            cores["accent_soft"], alvo_marcada, ganho,
            round(110 * ganho) if tema == "futurista" else 0)
        foco_borda = misturar_estado(cores["accent"], alvo_foco, ganho)
        marcada_borda = misturar_estado(cores["accent"], alvo_lateral, ganho)
        return f"""
        /* B19: apenas cartoes de respostas, quando B18 esta ativo no PB.
           Se gabarito for revelado, estados correta/errada nao sao alterados. */
        QFrame#questionSolverAlternative[answerState="normal"][selectionState="normal"] {{
            background-color: {normal};
        }}
        QFrame#questionSolverAlternative[answerState="normal"][selectionState="normal"]:hover {{
            background-color: {hover};
        }}
        /* Primeiro Enter: marca escolha sem confirmar (ou clique do mouse). */
        QFrame#questionSolverAlternative[answerState="normal"][selectionState="selected"] {{
            background-color: {selecionada};
            border: 1px solid {marcada_borda};
            border-left: 4px solid {marcada_borda};
        }}
        /* Setas: apenas a alternativa em foco recebe contorno ciano. */
        QFrame#questionSolverAlternative[answerState="normal"][keyboardFocus="true"] {{
            border: 2px solid {foco_borda};
        }}
        /* Enter e foco na mesma alternativa: composicao explicita. */
        QFrame#questionSolverAlternative[answerState="normal"][selectionState="selected"][keyboardFocus="true"] {{
            background-color: {selecionada};
            border: 2px solid {foco_borda};
            border-left: 4px solid {marcada_borda};
        }}
        """

    def _b16_alternar_linha(self, ativo):
        """Opcional e independente da cor do tema e do halo."""
        if not ativo:
            self._b16_ocultar_linha()
        elif self._alternativa_foco_teclado is not None:
            QTimer.singleShot(
                0, lambda: self._b16_sincronizar_foco_teclado(
                    self._alternativa_foco_teclado))

    def _b16_ocultar_linha(self):
        self._b16_origem_teclado = False
        faixa = getattr(self, "_b16_faixa_linha", None)
        if faixa is not None and faixa.isVisible():
            faixa.hide()

    def _b16_sincronizar_foco_teclado(self, letra):
        """Faz a faixa B16 acompanhar a borda azul das setas, sem mouse sintético enviado ao Qt.

        Reutiliza a geometria original da Leitura Neural, forçando somente a
        primeira linha do texto da alternativa em foco. Não seleciona a resposta,
        não aciona rádio, não interfere com caneta, halo nem animações da B26.
        """
        if (letra is None or letra != self._alternativa_foco_teclado
                or self.resposta_confirmada):
            return
        acao = getattr(self, "acao_menu_linha_b16", None)
        if acao is None or not acao.isChecked():
            self._b16_ocultar_linha()
            return
        rotulo = self.texto_por_letra.get(letra)
        faixa = getattr(self, "_b16_faixa_linha", None)
        if not isinstance(rotulo, QLabel) or faixa is None or not rotulo.isVisible():
            self._b16_ocultar_linha()
            return
        # Chamada direta: o evento NÃO é postado nem entregue a controles Qt.
        # Apenas os cálculos de geometria do realce já existente são usados.
        local = QPointF(max(0, rotulo.width() // 2),
                        max(0, rotulo.height() // 2))
        movimento = QMouseEvent(QEvent.MouseMove, local,
                                Qt.NoButton, Qt.NoButton, Qt.NoModifier)
        self._b16_evento_linha(rotulo, movimento, indice_forcado=0)
        self._b16_origem_teclado = bool(faixa.isVisible())

    def _b16_reposicionar_linha_teclado(self, _valor=None):
        """Mantém o realce alinhado se o QScrollArea rolar o cartão focado."""
        if self._b16_origem_teclado:
            self._b16_sincronizar_foco_teclado(self._alternativa_foco_teclado)

    def _b16_alvo_guia_leitura(self, objeto, evento):
        """Resolve the text under the pointer, including active ink canvases.

        Ink canvases intercept hover and drag when a pen is selected.  They are
        temporary children of the statement QLabel or the alternative card;
        the guide must use their cursor coordinates without changing the ink
        callbacks or swallowing mouse events.
        """
        nomes = {
            "questionSolverStatement", "questionSolverAlternativeText",
            "questionSolverExplanation",
        }
        if isinstance(objeto, QLabel) and objeto.objectName() in nomes:
            return objeto, evento.position().toPoint()
        if not isinstance(objeto, QWidget) or objeto.objectName() != "questionStudyInkLocalCanvas":
            return None
        caneta = getattr(self, "caneta_estudo", None)
        if caneta is None or caneta.modo not in ("caneta", "marcador", "borracha"):
            return None
        chave = getattr(objeto, "chave", None)
        if chave == "enunciado":
            rotulo = getattr(self, "questao_enunciado", None)
        else:
            rotulo = getattr(self, "texto_por_letra", {}).get(chave)
        if not isinstance(rotulo, QLabel) or rotulo.objectName() not in nomes:
            return None
        try:
            local = rotulo.mapFromGlobal(objeto.mapToGlobal(evento.position().toPoint()))
            return rotulo, local
        except (AttributeError, RuntimeError, TypeError, ValueError):
            return None

    def _b16_alvo_posicao_global(self):
        """Localiza texto realmente sob o mouse, mesmo apos soltar a caneta.

        O Qt pode disparar Leave na superficie rabiscavel ao encerrar o drag;
        nao devemos interpretar esse evento como saida da area de leitura.
        Nao usa timer de varredura, nao captura clique e valida o viewport.
        """
        try:
            ponto = QCursor.pos()
            viewport = self.scroll_questao.viewport()
            if (not viewport.isVisible() or
                    not viewport.rect().contains(viewport.mapFromGlobal(ponto))):
                return None
            rotulos = [getattr(self, "questao_enunciado", None)]
            rotulos.extend(getattr(self, "texto_por_letra", {}).values())
            rotulos.extend((getattr(self, "feedback_explicacao", None),
                            getattr(self, "revisao_explicacao", None)))
            nomes = {"questionSolverStatement", "questionSolverAlternativeText",
                     "questionSolverExplanation"}
            for rotulo in rotulos:
                if (not isinstance(rotulo, QLabel) or not rotulo.isVisible() or
                        rotulo.objectName() not in nomes):
                    continue
                local = rotulo.mapFromGlobal(ponto)
                if rotulo.rect().contains(local):
                    return rotulo, local
        except (AttributeError, RuntimeError, TypeError, ValueError):
            return None
        return None

    def _b16_revalidar_guias_apos_soltar(self):
        """Recompõe o halo e a faixa apos o fim do gesto, com cursor parado.

        Executado uma vez no proximo ciclo do Qt, depois do mouseReleaseEvent
        da caneta; o evento local nao e enviado a controles ou ao desenho.
        """
        alvo = self._b16_alvo_posicao_global()
        if alvo is None:
            self._b16_ocultar_linha()
            self._b15_ocultar_halo()
            return
        rotulo, local = alvo
        evento = QMouseEvent(QEvent.MouseMove, QPointF(local),
                             Qt.NoButton, Qt.NoButton, Qt.NoModifier)
        self._b16_evento_linha(rotulo, evento)
        self._b15_evento_cursor(rotulo, evento)

    def _b16_evento_linha(self, objeto, evento, indice_forcado=None):
        """Destaca a linha do texto enquanto o cursor se move.

        A faixa e um filho do dialogo com WA_TransparentForMouseEvents.
        Continua sem consumir o evento e sem mudar cursor, scroll ou caneta.
        """
        tipo = evento.type()
        if tipo == QEvent.WindowDeactivate and objeto is self:
            self._b16_ocultar_linha()
            return
        if tipo not in (QEvent.MouseMove, QEvent.Leave):
            return
        acao = getattr(self, "acao_menu_linha_b16", None)
        if not (acao is not None and acao.isChecked()
                and self.isVisible() and self.isActiveWindow()
                and self._pausa_relogio is None
                and not (self._editando_explicacao or self._editando_alternativas)):
            self._b16_ocultar_linha()
            return
        if tipo == QEvent.Leave:
            # Deixar o widget com o mouse parado não apaga o guia das setas.
            if self._b16_origem_teclado:
                return
            if self._b16_alvo_posicao_global() is None:
                self._b16_ocultar_linha()
            return
        if indice_forcado is None:
            # Um movimento real do mouse devolve a ele o controle do realce.
            self._b16_origem_teclado = False
        alvo = self._b16_alvo_guia_leitura(objeto, evento)
        if alvo is None:
            alvo = self._b16_alvo_posicao_global()
        if alvo is None:
            self._b16_ocultar_linha()
            return
        rotulo, local = alvo
        faixa = getattr(self, "_b16_faixa_linha", None)
        if faixa is None:
            return
        try:
            if not rotulo.rect().contains(local):
                self._b16_ocultar_linha()
                return
            viewport = self.scroll_questao.viewport()
            visivel = QRect(viewport.mapTo(self, QPoint(0, 0)), viewport.size())
            visivel = visivel.intersected(self.rect())
            pos_original = rotulo.mapTo(self, QPoint(0, 0))
            area_texto = QRect(pos_original, rotulo.size()).intersected(visivel)
            cursor_janela = rotulo.mapTo(self, local)
            if area_texto.isEmpty() or not area_texto.contains(cursor_janela):
                self._b16_ocultar_linha()
                return
            # A fonte e a largura so mudam em nova questao/redimensionamento.
            # Evitar medir o texto inteiro a cada pixel de movimento do mouse.
            chave = (rotulo, rotulo.width(), rotulo.text(), rotulo.font().toString())
            if self._b16_cache_metricas is None or self._b16_cache_metricas[0] != chave:
                fm = rotulo.fontMetrics()
                passo = max(16, fm.lineSpacing())
                texto = rotulo.text()
                if "<" in texto and ">" in texto:
                    # Explicacoes podem conter HTML; somente para estimar
                    # altura, sem modificar o conteudo do QLabel.
                    texto = re.sub(r"<[^>]*>", "", texto)
                altura = fm.boundingRect(
                    QRect(0, 0, max(1, rotulo.width()), 200000),
                    Qt.TextWordWrap, texto
                ).height()
                n_linhas = max(1, (max(1, altura) + passo - 1) // passo)
                topo = max(0, (rotulo.height() - n_linhas * passo) // 2)
                self._b16_cache_metricas = (chave, passo, topo, n_linhas)
            _, passo, topo, n_linhas = self._b16_cache_metricas
            indice = (max(0, min(n_linhas - 1, int(indice_forcado)))
                      if indice_forcado is not None else
                      max(0, min(n_linhas - 1, (local.y() - topo) // passo)))
            faixa_local = QRect(2, topo + indice * passo - 2,
                                max(1, rotulo.width() - 4), passo + 4)
            faixa_janela = faixa_local.translated(pos_original).intersected(area_texto)
            if faixa_janela.isEmpty():
                self._b16_ocultar_linha()
                return
            if faixa.geometry() != faixa_janela:
                faixa.setGeometry(faixa_janela)
            if not faixa.isVisible():
                faixa.show()
            faixa.raise_()
            # O halo de B15 volta ao primeiro plano no processamento seguinte.
        except (AttributeError, RuntimeError, TypeError, ValueError):
            self._b16_ocultar_linha()

    def _b15_alternar_halo(self, ativo):
        """Ativa guia do ponteiro em qualquer paleta, sem bloquear cliques."""
        if not ativo:
            self._b15_ocultar_halo()

    def _b15_ocultar_halo(self):
        halo = getattr(self, "_b15_halo_cursor", None)
        if halo is not None and halo.isVisible():
            halo.hide()

    def _b15_evento_cursor(self, objeto, evento):
        """Processa apenas eventos reais de mouse, sem QTimer nem automacao.

        Reutiliza o eventFilter global existente e nunca consome o evento.
        O guia funciona sobre texto e sobre as superficies da caneta, sem
        consumir ou alterar os eventos que desenham os tracos.
        """
        tipo = evento.type()
        if tipo == QEvent.WindowDeactivate and objeto is self:
            self._b15_ocultar_halo()
            return
        if tipo not in (QEvent.MouseMove, QEvent.Leave):
            return
        if not (getattr(self, "acao_menu_halo_b15", None) is not None
                and self.acao_menu_halo_b15.isChecked()
                and self.isVisible() and self.isActiveWindow()
                and self._pausa_relogio is None
                and not (self._editando_explicacao or self._editando_alternativas)):
            self._b15_ocultar_halo()
            return
        if tipo == QEvent.Leave:
            if self._b16_alvo_posicao_global() is None:
                self._b15_ocultar_halo()
            return
        alvo = self._b16_alvo_guia_leitura(objeto, evento)
        if alvo is None:
            alvo = self._b16_alvo_posicao_global()
        if alvo is None:
            self._b15_ocultar_halo()
            return
        rotulo, local = alvo
        halo = getattr(self, "_b15_halo_cursor", None)
        if halo is None:
            return
        try:
            pos = rotulo.mapTo(self, local)
        except (AttributeError, RuntimeError):
            self._b15_ocultar_halo()
            return
        if self.rect().contains(pos):
            halo.seguir(pos)
        else:
            self._b15_ocultar_halo()

    def _aplicar_visual_moderno_resolvedor(self):
        """Aparência moderna, restrita à janela da bateria e aos três temas.

        Não altera índices, timers, avaliação, persistência ou navegação.
        Aplicada uma vez após construir os widgets para evitar repolimentos
        globais custosos a cada questão.
        """
        tema = normalizar_tema(obter_configuracao_texto("tema_interface", "claro"))
        cores_por_tema = {
            "futurista": {
                "canvas": "#070F19", "surface": "#111E2E", "surface2": "#16283A",
                "hover": "#1C3347", "border": "#304A60", "muted": "#9BB2C5",
                "text": "#E9F4FB", "accent": "#27C8EF", "accent_soft": "#1D4559",
                "badge": "#21364B", "success": "#6DE4B3", "danger": "#F48A9A",
                "correct": "#164238", "correct_border": "#2FAD7B",
                "incorrect": "#4A2432", "incorrect_border": "#CE6478",
                "track": "#294357", "action": "#087FA4", "action_hover": "#0D9FCB",
            },
            "escuro": {
                "canvas": "#0D141D", "surface": "#1A2531", "surface2": "#223241",
                "hover": "#294052", "border": "#455B6A", "muted": "#B0BFCC",
                "text": "#F0F5F8", "accent": "#5BC1E9", "accent_soft": "#285369",
                "badge": "#2E4354", "success": "#8CE2AB", "danger": "#F49CA2",
                "correct": "#22503D", "correct_border": "#53B284",
                "incorrect": "#532D39", "incorrect_border": "#DB7A8F",
                "track": "#405361", "action": "#246F96", "action_hover": "#2E87B3",
            },
            "claro": {
                "canvas": "#F5F8FC", "surface": "#FFFFFF", "surface2": "#EAF1F7",
                "hover": "#E1EDF6", "border": "#C4D5E4", "muted": "#5A7087",
                "text": "#1C2F42", "accent": "#0879A7", "accent_soft": "#CFEBF4",
                "badge": "#DCE9F4", "success": "#197E59", "danger": "#B33D51",
                "correct": "#D6F3E4", "correct_border": "#3E9874",
                "incorrect": "#FDE3E7", "incorrect_border": "#C46274",
                "track": "#D8E6F1", "action": "#0879A7", "action_hover": "#0B96BE",
            },
        }
        c = dict(cores_por_tema.get(tema, cores_por_tema["claro"]))
        # B03: componentes reais Qt recebem superfícies diferentes. Todos os
        # modos de resposta/seleção permanecem definidos pelas regras existentes.
        # Nos temas Claro e Escuro, o comportamento visual anterior é idêntico.
        c["surface_overview"] = c["surface"]
        c["surface_statement"] = c["surface"]
        c["surface_alternative"] = c["surface2"]
        c["surface_feedback"] = c["surface"]
        c["alternative_hover"] = c["hover"]
        if tema == "futurista":
            # Guia Cromático VighnaStudy v1.0: azul noturno / petróleo e ciano.
            # A translucidez não é reduzida a ponto de comprometer a leitura
            # sobre o cenário arquitetônico do B02, mesmo em áreas brilhantes.
            c.update({
                "canvas": "#040911", "text": "#E4F2FA",
                "muted": "#B5C0C3", "accent": "#4FB2E5",
                "surface": "rgba(14, 25, 38, 235)",
                "surface2": "rgba(20, 40, 62, 240)",
                "surface_overview": "rgba(14, 25, 38, 234)",
                "surface_statement": "rgba(14, 25, 38, 240)",
                "surface_alternative": "rgba(20, 40, 62, 244)",
                "surface_feedback": "rgba(14, 25, 38, 247)",
                "alternative_hover": "rgba(38, 65, 89, 246)",
                "border": "#41556F", "hover": "#24435B",
                "accent_soft": "rgba(49, 121, 191, 100)",
                "badge": "#24394F", "track": "#294357",
                "action": "#3179BF", "action_hover": "#3B8ACD",
            })
        # B04: cores de ação e estados, sem interferir no significado das
        # quatro tintas da caneta, nem nas cores semânticas de acerto e erro.
        c["action_pressed"] = c["action"]
        c["action_disabled"] = c["badge"]
        c["button_text_disabled"] = c["muted"]
        c["button_focus"] = c["accent"]
        c["end_surface"] = c["surface2"]
        c["end_border"] = c["border"]
        c["end_text"] = c["text"]
        c["end_hover"] = c["hover"]
        if tema == "futurista":
            c.update({
                "action_pressed": "#275F91",
                "action_disabled": "#2E3746",
                "button_text_disabled": "#B5C0C3",
                "button_focus": "#B49269",
                "end_surface": "rgba(20, 40, 62, 242)",
                "end_border": "#B49269",
                "end_text": "#E4F2FA",
                "end_hover": "rgba(46, 55, 70, 250)",
            })
        qss = r"""
        QDialog#questionSolverDialog { background-color: __canvas__; color: __text__; }
        QScrollArea#questionSolverScroll { background: transparent; border: 0px; }
        /* B07: a régua horizontal da paleta não é um painel preenchido. */
        QWidget#questionSessionToolbarCanvasB07 {
            background: transparent; border: none;
        }
        /* B10: a paleta forma uma aba unida ao contorno do enunciado.
           O destaque lateral e puramente decorativo; a caneta e Qt nativo. */
        QWidget#questionSolverInkDockB10 { background: transparent; border: none; }
        QFrame#questionSolverInkDockEdgeB10 {
            background-color: __border__; border: none;
        }
        QWidget#questionSolverContent { background: transparent; border: 0px; }
        QFrame#questionSessionModernHeader {
            background-color: transparent; border: 0;
            border-bottom: 1px solid __border__;
        }
        /* B13: marca PNG original, sem o antigo fundo da estrela. */
        QLabel#questionSessionLogoImageB13 {
            background: transparent; border: none; padding: 0;
            color: __accent__; font-weight: 800;
        }
        QLabel#questionSessionBrandTitle {
            color: __text__; font-size: 20px; font-weight: 800;
        }
        QLabel#questionSessionProfilePill {
            color: __muted__; background-color: __badge__;
            border: 1px solid __border__; border-radius: 6px;
            padding: 4px 7px; font-size: 11px;
        }
        QLabel#pageSubtitle { color: __muted__; font-size: 11px; }
        QFrame#questionSessionOverviewCard {
            background-color: __surface_overview__; border: 1px solid __border__;
            border-radius: 12px;
        }
        QFrame#questionSessionMiniStat {
            background-color: transparent; border: 0; border-radius: 0;
        }
        QLabel#questionSessionMiniLabel { color: __muted__; font-size: 11px; }
        QLabel#questionSessionMiniValue { color: __text__; font-size: 12px; font-weight: 800; }
        QLabel#questionSessionMiniValue[metricRole="success"] { color: __success__; }
        QLabel#questionSessionMiniValue[metricRole="danger"] { color: __danger__; }
        QLabel#questionSessionMiniValue[metricRole="warning"] { color: __muted__; }
        QLabel#questionSessionProgressText { color: __text__; font-size: 11px; font-weight: 800; }
        QLabel#questionSessionCycleText { color: __muted__; font-size: 10px; }
        QProgressBar#questionSessionProgress {
            background-color: __track__; border: 0; border-radius: 1px;
            min-height: 3px; max-height: 3px;
        }
        QProgressBar#questionSessionProgress::chunk {
            background-color: __accent__; border-radius: 1px;
        }
        QLabel#questionSolverDiscipline { color: __accent__; font-size: 10px; font-weight: 800; }
        QLabel#questionSolverMeta { color: __muted__; font-size: 11px; }
        QFrame#questionSolverStatementCard {
            background-color: __surface_statement__; border: 1px solid __border__;
            border-radius: 13px;
        }
        QWidget#questionSolverQuestionHeader { background: transparent; border: 0; }
        /* B11: integracao compacta do tema no cabecalho da propria questao. */
        QWidget#questionSolverContextBlockB11 { background: transparent; border: 0; }
        QFrame#questionSolverContextDividerB11 {
            background-color: __border__; border: none;
