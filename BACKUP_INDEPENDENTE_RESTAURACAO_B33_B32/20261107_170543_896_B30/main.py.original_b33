    def salvar_estado_sessao(self):
        if not getattr(
            self,
            "sessao_ativa",
            False
        ):
            definir_configuracao_texto(
                "sessao_estudo_estado",
                ""
            )
            return

        estado = {
            "ativa": True,
            "modo": self.sessao_modo,
            "meta_topicos": self.sessao_meta_topicos,
            "meta_questoes": self.sessao_meta_questoes,
            "concluidas": self.sessao_concluidas,
            "questoes": self.sessao_questoes,
            "acertos": self.sessao_acertos,
            "total_inicial": self.sessao_total_inicial,
            "concurso_id": self.sessao_concurso_id,
            "concurso_nome": self.sessao_concurso_nome,
            "pulados_ids": list(
                self.sessao_pulados_ids
            ),
            "concluidos_ids": list(
                self.sessao_concluidos_ids
            ),
            "registros": self.sessao_registros,
        }

        definir_configuracao_texto(
            "sessao_estudo_estado",
            json.dumps(
                estado,
                ensure_ascii=False
            )
        )

    def restaurar_estado_sessao(self):
        texto = obter_configuracao_texto(
            "sessao_estudo_estado",
            ""
        ).strip()

        if not texto:
            return

        try:
            estado = json.loads(
                texto
            )

            if not estado.get(
                "ativa",
                False
            ):
                definir_configuracao_texto(
                    "sessao_estudo_estado",
                    ""
                )
                return

            concurso_id = estado.get(
                "concurso_id"
            )

            concursos_validos = {
                item[0]
                for item in listar_concursos()
            }

            if concurso_id not in concursos_validos:
                definir_configuracao_texto(
                    "sessao_estudo_estado",
                    ""
                )
                return

            self.sessao_ativa = True
            self.sessao_pausada = True
            self.sessao_modo = estado.get(
                "modo",
                "pendencias"
            )
            self.sessao_meta_topicos = int(
                estado.get(
                    "meta_topicos",
                    0
                )
                or 0
            )
            self.sessao_meta_questoes = int(
                estado.get(
                    "meta_questoes",
                    0
                )
                or 0
            )
            self.sessao_concluidas = int(
                estado.get(
                    "concluidas",
                    0
                )
                or 0
            )
            self.sessao_questoes = int(
                estado.get(
                    "questoes",
                    0
                )
                or 0
            )
            self.sessao_acertos = int(
                estado.get(
                    "acertos",
                    0
                )
                or 0
            )
            self.sessao_total_inicial = int(
                estado.get(
                    "total_inicial",
                    0
                )
                or 0
            )
            self.sessao_concurso_id = concurso_id
            self.sessao_concurso_nome = estado.get(
                "concurso_nome",
                ""
            )
            self.sessao_pulados_ids = set(
                int(valor)
                for valor in estado.get(
                    "pulados_ids",
                    []
                )
            )
            self.sessao_concluidos_ids = set(
                int(valor)
                for valor in estado.get(
                    "concluidos_ids",
                    []
                )
            )
            self.sessao_registros = list(
                estado.get(
                    "registros",
                    []
                )
            )

        except Exception:
            definir_configuracao_texto(
                "sessao_estudo_estado",
                ""
            )
            self.sessao_ativa = False
            self.sessao_pausada = False

    def descricao_objetivo_sessao(self):
        if self.sessao_modo == "topicos":
            return (
                f"Concluir {self.sessao_meta_topicos} tópico(s)"
            )

        if self.sessao_modo == "questoes":
            return (
                f"Alcançar {self.sessao_meta_questoes} questões"
            )

        return "Concluir as pendências disponíveis"

    def abrir_sessao_estudo(self):
        self._garantir_tela_sessao_estudo()
        if (
            getattr(
                self,
                "sessao_ativa",
                False
            )
            and getattr(
                self,
                "sessao_pausada",
                False
            )
        ):
            self.sessao_pausada = False
            self.salvar_estado_sessao()
            self.atualizar_sessao_estudo()

            self.telas.setCurrentWidget(
                self.tela_sessao_estudo
            )
            return

        if getattr(
            self,
            "sessao_ativa",
            False
        ):
            self.atualizar_sessao_estudo()
            self.telas.setCurrentWidget(
                self.tela_sessao_estudo
            )
            return

        if self._dashboard_sujo:
            self.atualizar_dashboard()

        fila_dashboard = getattr(
            self,
            "fila_prioridade",
            []
        )

        if not fila_dashboard:
            QMessageBox.information(
                self,
                "Revisões em dia",
                (
                    "Não há revisões vencidas ou previstas "
                    "para hoje."
                )
            )
            return

        concurso = obter_concurso_ativo()
        hoje = QDate.currentDate().toString(
            "yyyy-MM-dd"
        )

        relatorio_hoje = obter_relatorio_periodo(
            hoje,
            hoje,
            concurso[0]
        )

        questoes_hoje = int(
            relatorio_hoje.get(
                "questoes",
                0
            )
            or 0
        )

        meta_diaria = max(
            0,
            obter_configuracao_int(
                "meta_questoes_diaria",
                60
            )
        )

        janela = JanelaInicioSessao(
            len(
                fila_dashboard
            ),
            meta_diaria,
            questoes_hoje,
            self
        )

        if janela.exec() != QDialog.Accepted:
            return

        self.sessao_ativa = True
        self.sessao_pausada = False
        self.sessao_modo = janela.modo
        self.sessao_meta_topicos = janela.meta_topicos
        self.sessao_meta_questoes = janela.meta_questoes
        self.sessao_concluidas = 0
        self.sessao_questoes = 0
        self.sessao_acertos = 0
        self.sessao_total_inicial = len(
            fila_dashboard
        )
        self.sessao_concurso_id = concurso[0]
        self.sessao_concurso_nome = concurso[1]
        self.sessao_pulados_ids = set()
        self.sessao_concluidos_ids = set()
        self.sessao_registros = []

        self.salvar_estado_sessao()
        self.atualizar_sessao_estudo()

        self.telas.setCurrentWidget(
            self.tela_sessao_estudo
        )

    def pausar_sessao_estudo(self):
        if not getattr(
            self,
            "sessao_ativa",
            False
        ):
            self.voltar_inicio()
            return

        self.sessao_pausada = True
        self.salvar_estado_sessao()
        self._marcar_dashboard_sujo()
        self.telas.setCurrentWidget(self.tela_inicial)
        self._agendar_atualizacao_dashboard()

    def encerrar_sessao_estudo(self):
        if not getattr(
            self,
            "sessao_ativa",
            False
        ):
            return

        resposta = QMessageBox.question(
            self,
            "Encerrar sessão",
            (
                "Deseja encerrar esta sessão agora?\n\n"
                f"Concluídos: {self.sessao_concluidas}\n"
                f"Questões: {self.sessao_questoes}\n"
                f"Pulados: {len(self.sessao_pulados_ids)}"
            ),
            QMessageBox.Yes
            | QMessageBox.No,
            QMessageBox.No
        )

        if resposta != QMessageBox.Yes:
            return

        self.finalizar_sessao_estudo(
            "Sessão encerrada pelo usuário."
        )

    def finalizar_sessao_estudo(
        self,
        motivo
    ):
        if not getattr(
            self,
            "sessao_ativa",
            False
        ):
            return

        restantes = len(
            getattr(
                self,
                "sessao_fila",
                []
            )
        )

        percentual = (
            (
                self.sessao_acertos
                / self.sessao_questoes
            )
            * 100.0
            if self.sessao_questoes > 0
            else None
        )

        resumo = {
            "motivo": motivo,
            "objetivo": self.descricao_objetivo_sessao(),
            "concluidas": self.sessao_concluidas,
            "pulados": len(
                self.sessao_pulados_ids
            ),
            "restantes": restantes,
            "questoes": self.sessao_questoes,
            "acertos": self.sessao_acertos,
            "percentual": percentual,
        }

        registros = list(
            self.sessao_registros
        )

        self.sessao_ativa = False
        self.sessao_pausada = False
        self.sessao_fila = []

        self.salvar_estado_sessao()
        self._marcar_dashboard_sujo()
        self.telas.setCurrentWidget(self.tela_inicial)
        self._agendar_atualizacao_dashboard()

        janela = JanelaResumoSessao(
            resumo,
            registros,
            self
        )
        janela.exec()

    def limpar_layout_sessao(
        self,
        layout
    ):
        while layout.count():
            item = layout.takeAt(
                0
            )

            widget = item.widget()

            if widget is not None:
                widget.deleteLater()

    def montar_fila_sessao(self):
        if not getattr(
            self,
            "sessao_ativa",
            False
        ):
            return []

        hoje = QDate.currentDate().toString(
            "yyyy-MM-dd"
        )

        pendencias = listar_pendencias(
            hoje,
            self.sessao_concurso_id
        )

        usar_importancia = obter_configuracao_bool(
            "usar_importancia_fila",
            True
        )

        fila = []

        ignorados = (
            self.sessao_pulados_ids
            | self.sessao_concluidos_ids
        )

        for dado in pendencias:
            if dado[0] in ignorados:
                continue

            score, nivel, motivo = calcular_prioridade(
                dado[4],
                dado[5],
                dado[3],
                dado[6],
                usar_importancia
            )

            fila.append({
                "topico_id": dado[0],
                "disciplina": dado[1],
                "topico": dado[2],
                "revisoes": dado[3],
                "proxima": dado[4],
                "percentual": dado[5],
                "importancia": dado[6],
                "score": score,
                "nivel": nivel,
                "motivo": motivo,
            })

        fila.sort(
            key=lambda item: (
                -item["score"],
                item["proxima"],
                item["disciplina"].lower(),
                item["topico"].lower()
            )
        )

        if self.sessao_modo == "topicos":
            faltam = max(
                0,
                self.sessao_meta_topicos
                - self.sessao_concluidas
            )
            fila = fila[
                :faltam
            ]

        return fila

    def atualizar_sessao_estudo(self):
        if not getattr(
            self,
            "sessao_ativa",
            False
        ):
            return

        self.perfil_sessao.setText(
            f"Perfil: {self.sessao_concurso_nome}"
        )

        fila = self.montar_fila_sessao()
        self.sessao_fila = fila

        # ----------------------------------------------------
        # INDICADORES
        # ----------------------------------------------------

        self.sessao_card_concluidas.setText(
            str(
                self.sessao_concluidas
            )
        )

        if self.sessao_modo == "topicos":
            progresso = (
                f"{self.sessao_concluidas}/"
                f"{self.sessao_meta_topicos} tópicos"
            )
        elif self.sessao_modo == "questoes":
            progresso = (
                f"{self.sessao_questoes}/"
                f"{self.sessao_meta_questoes} questões"
            )
        else:
            total_relevante = max(
                self.sessao_total_inicial,
                (
                    self.sessao_concluidas
                    + len(
                        self.sessao_pulados_ids
                    )
                    + len(
                        fila
                    )
                )
            )
            progresso = (
                f"{self.sessao_concluidas}/"
                f"{total_relevante} tópicos"
            )

        self.sessao_card_restantes.setText(
            progresso
        )

        self.sessao_card_questoes.setText(
            str(
                self.sessao_questoes
            )
        )

        self.sessao_card_meta.setText(
            str(
                len(
                    self.sessao_pulados_ids
                )
            )
        )

        # ----------------------------------------------------
        # PRÓXIMA REVISÃO
        # ----------------------------------------------------

        self.limpar_layout_sessao(
            self.sessao_prioridade_layout
        )
        self.limpar_layout_sessao(
            self.sessao_importancia_layout
        )

        if fila:
            atual = fila[0]

            if self.sessao_modo == "topicos":
                self.sessao_posicao.setText(
                    (
                        f"{self.sessao_concluidas + 1} "
                        f"de {self.sessao_meta_topicos}"
                    )
                )
            elif self.sessao_modo == "questoes":
                self.sessao_posicao.setText(
                    (
                        f"{self.sessao_questoes}/"
                        f"{self.sessao_meta_questoes} questões"
                    )
                )
            else:
                self.sessao_posicao.setText(
                    (
                        f"{self.sessao_concluidas + 1}ª "
                        "revisão da sessão"
                    )
                )

            self.sessao_disciplina_atual.setText(
                atual["disciplina"]
            )
            self.sessao_topico_atual.setText(
                atual["topico"]
            )

            self.sessao_desempenho.setText(
                formatar_percentual(
                    atual["percentual"]
                )
            )

            self.sessao_motivo.setText(
                atual["motivo"]
            )

            chamas = IndicadorChamasPrioridade(
                atual["nivel"]
            )
            self.sessao_prioridade_layout.addWidget(
                chamas
            )
            self.sessao_prioridade_layout.addStretch()

            estrelas = IndicadorEstrelasFila(
                atual["importancia"]
            )
            self.sessao_importancia_layout.addWidget(
                estrelas
            )
            self.sessao_importancia_layout.addStretch()

            self.sessao_atualizar_revisao.setEnabled(
                True
            )
            self.sessao_abrir_topico.setEnabled(
                True
            )
            self.sessao_pular_topico.setEnabled(
                True
            )

            questoes_internas = (
                listar_questoes_resolucao(
                    self.sessao_concurso_id,
                    topico_id=atual[
                        "topico_id"
                    ],
                    somente_ineditas=False,
                    limite=1,
                    aleatorio=False
                )
            )

            self.sessao_resolver_questoes.setEnabled(
                bool(
                    questoes_internas
                )
            )
            self.sessao_resolver_questoes.setToolTip(
                (
                    "Resolver questões internas deste tópico."
                    if questoes_internas
                    else (
                        "Este tópico ainda não possui questões internas. "
                        "Use o registro manual."
                    )
                )
            )

        else:
            self.sessao_posicao.setText(
                "Sem itens disponíveis"
            )
            self.sessao_disciplina_atual.setText(
                "Sessão sem tópicos disponíveis"
            )
            self.sessao_topico_atual.setText(
                (
                    "Não há outro tópico disponível para continuar "
                    "esta sessão neste momento."
                )
            )
            self.sessao_desempenho.setText(
                "—"
            )
            self.sessao_motivo.setText(
                "Fila concluída ou pulada"
            )

            self.sessao_prioridade_layout.addWidget(
                QLabel(
                    "—"
                )
            )
            self.sessao_prioridade_layout.addStretch()

            self.sessao_importancia_layout.addWidget(
                QLabel(
                    "—"
                )
            )
            self.sessao_importancia_layout.addStretch()

            self.sessao_atualizar_revisao.setEnabled(
                False
            )
            self.sessao_abrir_topico.setEnabled(
                False
            )
            self.sessao_pular_topico.setEnabled(
                False
            )
            self.sessao_resolver_questoes.setEnabled(
                False
            )

        # ----------------------------------------------------
        # FILA VISUAL
        # ----------------------------------------------------

        self.tabela_sessao.setRowCount(
            len(
                fila
            )
        )

        quantidade = len(
            fila
        )

        if quantidade == 1:
            self.sessao_fila_contagem.setText(
                "• 1 tópico disponível"
            )
        else:
            self.sessao_fila_contagem.setText(
                f"• {quantidade} tópicos disponíveis"
            )

        for linha, item_fila in enumerate(
            fila
        ):
            ordem = QTableWidgetItem(
                str(
                    linha + 1
                )
            )
            ordem.setTextAlignment(
                Qt.AlignCenter
            )

            disciplina = QTableWidgetItem(
                item_fila["disciplina"]
            )

            topico = QTableWidgetItem(
                item_fila["topico"]
            )
            topico.setData(
                Qt.UserRole,
                item_fila["topico_id"]
            )

            proxima = QTableWidgetItem(
                formatar_data(
                    item_fila["proxima"]
                )
            )
            proxima.setTextAlignment(
                Qt.AlignCenter
            )

            percentual = QTableWidgetItem(
                formatar_percentual(
                    item_fila["percentual"]
                )
            )
            percentual.setTextAlignment(
                Qt.AlignCenter
            )

            motivo = QTableWidgetItem(
                item_fila["motivo"]
            )

            self.tabela_sessao.setItem(
                linha,
                0,
                ordem
            )
            self.tabela_sessao.setItem(
                linha,
                1,
                disciplina
            )
            self.tabela_sessao.setItem(
                linha,
                2,
                topico
            )

            chamas = IndicadorChamasPrioridade(
                item_fila["nivel"]
            )
            self.tabela_sessao.setCellWidget(
                linha,
                3,
                chamas
            )

            self.tabela_sessao.setItem(
                linha,
                4,
                proxima
            )
            self.tabela_sessao.setItem(
                linha,
                5,
                percentual
            )
            self.tabela_sessao.setItem(
                linha,
                6,
                motivo
            )

            self.tabela_sessao.setRowHeight(
                linha,
                32
            )

        if fila:
            self.tabela_sessao.selectRow(
                0
            )

    def obter_item_sessao_atual(self):
        if not getattr(
            self,
            "sessao_fila",
            []
        ):
            return None

        return self.sessao_fila[0]

    def verificar_conclusao_sessao(self):
        if not getattr(
            self,
            "sessao_ativa",
            False
        ):
            return True

        if (
            self.sessao_modo == "topicos"
            and self.sessao_concluidas
            >= self.sessao_meta_topicos
        ):
            self.finalizar_sessao_estudo(
                "Meta de tópicos da sessão atingida."
            )
            return True

        if (
            self.sessao_modo == "questoes"
            and self.sessao_questoes
            >= self.sessao_meta_questoes
        ):
            self.finalizar_sessao_estudo(
                "Meta de questões da sessão atingida."
            )
            return True

        if not self.sessao_fila:
            if self.sessao_pulados_ids:
                motivo = (
                    "Não há mais tópicos disponíveis nesta sessão. "
                    "Os tópicos pulados mantiveram seus agendamentos."
                )
            else:
                motivo = (
                    "Todas as revisões disponíveis da sessão foram concluídas."
                )

            self.finalizar_sessao_estudo(
                motivo
            )
            return True

        return False

    def resolver_questoes_sessao(self):
        atual = (
            self.obter_item_sessao_atual()
        )

        if atual is None:
            return

        resultado = abrir_resolvedor_topico(
            atual[
                "topico_id"
            ],
            atual[
                "topico"
            ],
            self
        )

        if not resultado:
            return

        resumo = resultado.get(
            "resumo"
        )
        integracao = resultado.get(
            "integracao",
            []
        )

        if resumo is None:
            return

        questoes = int(
            resumo.get(
                "respondidas",
                0
            )
            or 0
        )
        acertos = int(
            resumo.get(
                "acertos",
                0
            )
            or 0
        )

        if questoes <= 0:
            self.atualizar_dashboard()
            self.atualizar_sessao_estudo()
            return

        percentual = (
            100.0
            * acertos
            / questoes
        )

        revisao_gerada = any(
            item.get(
                "topico_id"
            )
            == atual[
                "topico_id"
            ]
            and item.get(
                "revisao_registrada"
            )
            for item in integracao
        )

        self.sessao_questoes += questoes
        self.sessao_acertos += acertos

        if revisao_gerada:
            self.sessao_concluidas += 1
            self.sessao_concluidos_ids.add(
                atual[
                    "topico_id"
                ]
            )
            status = (
                "Concluído • questões internas"
            )
        else:
            status = (
                "Atividade • sem revisão automática"
            )

        self.sessao_registros.append({
            "status": status,
            "disciplina": atual[
                "disciplina"
            ],
            "topico": atual[
                "topico"
            ],
            "topico_id": atual[
                "topico_id"
            ],
            "questoes": questoes,
            "acertos": acertos,
            "percentual": percentual,
        })

        self.salvar_estado_sessao()
        self.atualizar_dashboard()
        self.atualizar_sessao_estudo()
        self.verificar_conclusao_sessao()

    def atualizar_revisao_sessao(self):
        atual = (
            self.obter_item_sessao_atual()
        )

        if atual is None:
            return

        janela = JanelaRevisao(
            atual["topico_id"],
            atual["topico"],
            self
        )

        if janela.exec() == QDialog.Accepted:
            questoes = int(
                janela.questoes.value()
            )
            acertos = int(
                janela.acertos.value()
            )

            percentual = (
                (
                    acertos
                    / questoes
                )
                * 100.0
                if questoes > 0
                else None
            )

            self.sessao_concluidas += 1
            self.sessao_questoes += questoes
            self.sessao_acertos += acertos
            self.sessao_concluidos_ids.add(
                atual["topico_id"]
            )

            self.sessao_registros.append({
                "status": "Concluído",
                "disciplina": atual["disciplina"],
                "topico": atual["topico"],
                "topico_id": atual["topico_id"],
                "questoes": questoes,
                "acertos": acertos,
                "percentual": percentual,
            })

            self.salvar_estado_sessao()
            self.atualizar_dashboard()
            self.atualizar_sessao_estudo()
            self.verificar_conclusao_sessao()

    def pular_topico_sessao(self):
        atual = (
            self.obter_item_sessao_atual()
        )

        if atual is None:
            return

        self.sessao_pulados_ids.add(
            atual["topico_id"]
        )

        self.sessao_registros.append({
            "status": "Pulado",
            "disciplina": atual["disciplina"],
            "topico": atual["topico"],
            "topico_id": atual["topico_id"],
            "questoes": None,
            "acertos": None,
            "percentual": None,
        })

        self.salvar_estado_sessao()
        self.atualizar_sessao_estudo()
        self.verificar_conclusao_sessao()

    def abrir_topico_sessao(self):
        atual = (
            self.obter_item_sessao_atual()
        )

        if atual is None:
            return

        janela = JanelaTopico(
            atual["topico_id"],
            atual["topico"],
            self
        )

        janela.exec()

        self.atualizar_dashboard()
        self.atualizar_sessao_estudo()

    def abrir_topico_fila_sessao(
        self,
        linha,
        coluna
    ):
        item = self.tabela_sessao.item(
            linha,
            2
        )

        if item is None:
            return

        janela = JanelaTopico(
            item.data(
                Qt.UserRole
            ),
            item.text(),
            self
        )

        janela.exec()

        self.atualizar_dashboard()
        self.atualizar_sessao_estudo()

    def criar_tela_calendario(self):
        tela = QWidget()

        layout = QVBoxLayout(
            tela
        )

        layout.setContentsMargins(
            28,
            20,
            28,
            24
        )

        layout.setSpacing(
            12
        )

        # ====================================================
        # CABEÇALHO
        # ====================================================

        cabecalho = QHBoxLayout()
        cabecalho.setSpacing(
            10
        )

        voltar = QPushButton(
            "← Voltar"
        )
        voltar.setObjectName(
            "subtleButton"
        )
        voltar.setProperty(
            "navigationBack",
            True
        )
        voltar.setFixedWidth(
            88
        )
        voltar.clicked.connect(
            self.voltar_inicio
        )

        cabecalho.addWidget(
            voltar
        )

        bloco_titulo = QVBoxLayout()
        bloco_titulo.setSpacing(
            1
        )

        titulo = QLabel(
            "Calendário de Estudos"
        )
        titulo.setObjectName(
            "pageTitle"
        )

        subtitulo = QLabel(
            "Acompanhe as revisões agendadas e a previsão dos próximos tópicos de estudo."
        )
        subtitulo.setObjectName(
            "pageSubtitle"
        )

        bloco_titulo.addWidget(
            titulo
        )
        bloco_titulo.addWidget(
            subtitulo
        )

        cabecalho.addLayout(
            bloco_titulo
        )
        cabecalho.addStretch()

        self.perfil_calendario = QLabel(
            "Perfil: —"
        )
        self.perfil_calendario.setObjectName(
            "profileBadge"
        )
        self.perfil_calendario.setFixedHeight(
            34
        )
        self.perfil_calendario.setAlignment(
            Qt.AlignCenter
        )

        cabecalho.addWidget(
            self.perfil_calendario,
            0,
            Qt.AlignVCenter
        )

        layout.addLayout(
            cabecalho
        )

        # ====================================================
        # VISUALIZAÇÃO — MÊS / SEMANA PREVISTA
        # ====================================================

        barra_visualizacao = QHBoxLayout()
        barra_visualizacao.setSpacing(6)

        self.calendario_btn_mes = QPushButton("Mês")
        self.calendario_btn_mes.setObjectName("calendarViewToggle")
        self.calendario_btn_mes.setCheckable(True)
        self.calendario_btn_mes.setChecked(True)
        self.calendario_btn_mes.setMinimumWidth(86)

        self.calendario_btn_semana = QPushButton("Semana prevista")
        self.calendario_btn_semana.setObjectName("calendarViewToggle")
        self.calendario_btn_semana.setCheckable(True)
        self.calendario_btn_semana.setMinimumWidth(138)

        self.calendario_grupo_visualizacao = QButtonGroup(self)
        self.calendario_grupo_visualizacao.setExclusive(True)
        self.calendario_grupo_visualizacao.addButton(self.calendario_btn_mes, 0)
        self.calendario_grupo_visualizacao.addButton(self.calendario_btn_semana, 1)

        self.calendario_btn_mes.clicked.connect(
            lambda: self.alternar_visualizacao_calendario(0)
        )
        self.calendario_btn_semana.clicked.connect(
            lambda: self.alternar_visualizacao_calendario(1)
        )

        barra_visualizacao.addWidget(self.calendario_btn_mes)
        barra_visualizacao.addWidget(self.calendario_btn_semana)
        barra_visualizacao.addStretch()

        self.calendario_aviso_previsao = QLabel(
            "A previsão se recalcula conforme você estuda."
        )
        self.calendario_aviso_previsao.setObjectName("calendarForecastHeaderHint")
        self.calendario_aviso_previsao.setVisible(False)
        barra_visualizacao.addWidget(self.calendario_aviso_previsao)

        layout.addLayout(barra_visualizacao)

